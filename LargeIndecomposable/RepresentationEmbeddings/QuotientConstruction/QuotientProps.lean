module

public import LargeIndecomposable.RepresentationEmbeddings.QuotientConstruction.Quotient
public import Mathlib.LinearAlgebra.TensorProduct.RightExactness
public import Mathlib.RingTheory.Flat.Basic
public import Mathlib.LinearAlgebra.Basis.VectorSpace
public import Mathlib.Algebra.Algebra.RestrictScalars

/-!
# Properties of the quotient construction `F₁`

For the functor `F₁ = Q.functor` of Construction 3.3:

* `relMap_injective`: `v ↦ s ⊗ a(v) + t ⊗ b(v)` is injective on `D`;
* `mem_relSub_iff`: the relation submodule is the `k`-range of `relMap`
  (the remark after Construction 3.3);
* `map_injective_of_shortExact`, `map_surjective_of_shortExact`,
  `range_eq_ker_of_shortExact`: `F₁` is exact on `D`;
* `finite_obj`: `F₁` preserves finite dimension;
* `topQ`, `topQ_eq_zero_iff`, `topEquiv`: the top `F₁(T)/J F₁(T)` is `W`;
* `map_injective`: `F₁` is faithful on `D` (Lemma 3.11(1)).

Two hypotheses on the idempotents are used where needed, both in the form
`TopOneDim k e : Λ e ⊆ k e + J`. They hold for primitive idempotents of a
basic algebra over an algebraically closed field (Setting 3.2): then
`Λ e / J e` is the simple module `S_e`, which is one-dimensional, spanned by
the image of `e`.

`radPow M i` is the additive subgroup `J^i M` generated by products
`j₁ ⋯ jᵢ • m` with all `j_l ∈ J`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits Statement WalkingParallelPair TensorProduct

universe u

variable {k : Type u} [Field k] {Λ : Type u} [Ring Λ] [Algebra k Λ]

variable (k) in
/-- `Λ e ⊆ k e + J`: the top `Λ e / J e` is spanned by the image of `e`. This
holds for a primitive idempotent of a basic algebra over an algebraically
closed field. -/
def TopOneDim (e : Λ) : Prop := ∀ r : Λ, ∃ c : k, r * e - c • e ∈ Ring.jacobson Λ

lemma jacobson_smul_mem {c : k} {x : Λ} (h : x ∈ Ring.jacobson Λ) :
    c • x ∈ Ring.jacobson Λ :=
  Submodule.smul_of_tower_mem _ c h

/-! ### Radical powers of a module -/

section radPow

variable (M : Type u) [AddCommGroup M] [Module Λ M]

variable (Λ) in
/-- `J^i M`: the additive subgroup generated by `j₁ ⋯ jᵢ • m` with
`j_l ∈ J = rad Λ`. -/
def radPow (i : ℕ) : AddSubgroup M :=
  AddSubgroup.closure
    {x | ∃ l : List Λ, l.length = i ∧ (∀ j ∈ l, j ∈ Ring.jacobson Λ) ∧ ∃ m : M, l.prod • m = x}

variable {M}

lemma smul_mem_radPow_of_mem {i : ℕ} {l : List Λ} (hl : l.length = i)
    (hJ : ∀ j ∈ l, j ∈ Ring.jacobson Λ) (m : M) : l.prod • m ∈ radPow Λ M i :=
  AddSubgroup.subset_closure ⟨l, hl, hJ, m, rfl⟩

lemma list_prod_smul_mem_radPow {l : List Λ} (hl : ∀ j ∈ l, j ∈ Ring.jacobson Λ) {i : ℕ}
    {x : M} (hx : x ∈ radPow Λ M i) : l.prod • x ∈ radPow Λ M (l.length + i) := by
  induction hx using AddSubgroup.closure_induction with
  | mem x hx =>
    obtain ⟨l', hl', hJ, m, rfl⟩ := hx
    rw [← mul_smul, ← List.prod_append]
    refine smul_mem_radPow_of_mem (by simp [hl']) (fun j hj ↦ ?_) m
    rcases List.mem_append.1 hj with h | h
    exacts [hl j h, hJ j h]
  | zero => simp
  | add x y _ _ hx hy => rw [smul_add]; exact add_mem hx hy
  | neg x _ hx => rw [smul_neg]; exact neg_mem hx

lemma smul_mem_radPow (r : Λ) {i : ℕ} {x : M} (hx : x ∈ radPow Λ M i) :
    r • x ∈ radPow Λ M i := by
  induction hx using AddSubgroup.closure_induction with
  | mem x hx =>
    obtain ⟨l, hl, hJ, m, rfl⟩ := hx
    rcases l with _ | ⟨j, l⟩
    · simpa using smul_mem_radPow_of_mem (l := []) hl (by simp) (r • m)
    · rw [← mul_smul, List.prod_cons, ← mul_assoc]
      refine smul_mem_radPow_of_mem (l := (r * j) :: l) (by simpa using hl) ?_ m
      simp only [List.mem_cons, forall_eq_or_imp] at hJ ⊢
      exact ⟨Ideal.mul_mem_left _ r hJ.1, hJ.2⟩
  | zero => simp
  | add x y _ _ hx hy => rw [smul_add]; exact add_mem hx hy
  | neg x _ hx => rw [smul_neg]; exact neg_mem hx

lemma map_mem_radPow {N : Type u} [AddCommGroup N] [Module Λ N] (f : M →ₗ[Λ] N) {i : ℕ}
    {x : M} (hx : x ∈ radPow Λ M i) : f x ∈ radPow Λ N i := by
  induction hx using AddSubgroup.closure_induction with
  | mem x hx =>
    obtain ⟨l, hl, hJ, m, rfl⟩ := hx
    rw [map_smul]
    exact smul_mem_radPow_of_mem hl hJ _
  | zero => simp
  | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
  | neg x _ hx => rw [map_neg]; exact neg_mem hx

lemma eq_zero_of_mem_radPow {n : ℕ}
    (hn : ∀ l : List Λ, l.length = n → (∀ j ∈ l, j ∈ Ring.jacobson Λ) → l.prod = 0) {x : M}
    (hx : x ∈ radPow Λ M n) : x = 0 := by
  induction hx using AddSubgroup.closure_induction with
  | mem x hx =>
    obtain ⟨l, hl, hJ, m, rfl⟩ := hx
    rw [hn l hl hJ, zero_smul]
  | zero => rfl
  | add x y _ _ hx hy => rw [hx, hy, add_zero]
  | neg x _ hx => rw [hx, neg_zero]

end radPow

/-- Into a module of `D`, a morphism is determined by its component at the
target vertex. -/
lemma Kron.ext_of_app_one {X Y : Kron k} (hY : InD Y) {f f' : X ⟶ Y}
    (h : f.app one = f'.app one) : f = f' := by
  refine Kron.hom_ext ?_ h
  ext v
  rw [← sub_eq_zero]
  refine (inD_iff Y).1 hY _ ?_ ?_
  · rw [map_sub, ← Kron.a_apply, ← Kron.a_apply, h, sub_self]
  · rw [map_sub, ← Kron.b_apply, ← Kron.b_apply, h, sub_self]

namespace QuotientData

variable (Q : QuotientData k Λ)

/-! ### Elementary facts on `s`, `t`, `e_y` -/

lemma s_ne_zero : Q.s ≠ 0 := by
  simpa using Q.linearIndependent.ne_zero 0

lemma s_mul_ey : Q.s * Q.ey = Q.s := by
  nth_rewrite 1 [← Q.s_mem.2]
  rw [mul_assoc (Q.ex * Q.s), Q.ey_idem.eq, Q.s_mem.2]

lemma ex_mul_s : Q.ex * Q.s = Q.s := by
  nth_rewrite 1 [← Q.s_mem.2]
  rw [← mul_assoc, ← mul_assoc, Q.ex_idem.eq, Q.s_mem.2]

lemma ex_mul_t : Q.ex * Q.t = Q.t := by
  nth_rewrite 1 [← Q.t_mem.2]
  rw [← mul_assoc, ← mul_assoc, Q.ex_idem.eq, Q.t_mem.2]

lemma ey_not_mem : Q.ey ∉ Ring.jacobson Λ := fun h ↦
  Q.s_ne_zero (by rw [← Q.s_mul_ey, Q.s_mul_J _ h])

/-- `e_y` as an element of `Λ e_y`. -/
def eyP : Q.P := ⟨Q.ey, Submodule.mem_span_singleton_self _⟩

lemma coe_mul_ey (p : Q.P) : (p : Λ) * Q.ey = p := by
  obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.1 p.2
  rw [← ha, smul_eq_mul, mul_assoc, Q.ey_idem.eq]

lemma smul_eyP (p : Q.P) : (p : Λ) • Q.eyP = p :=
  Subtype.ext (by simp [eyP, Q.coe_mul_ey])

@[simp]
lemma coe_eyP : (Q.eyP : Λ) = Q.ey := rfl

@[simp]
lemma coe_smul_eyP (r : Λ) : ((r • Q.eyP : Q.P) : Λ) = r * Q.ey := rfl

/-- `Λ/J` acts on `s` and `t` by scalars, through the coordinate at `x`. -/
lemma exists_smul_s_t (hx : TopOneDim k Q.ex) (r : Λ) :
    ∃ c : k, r * Q.s = c • Q.s ∧ r * Q.t = c • Q.t := by
  obtain ⟨c, hc⟩ := hx r
  refine ⟨c, ?_, ?_⟩
  · have := Q.J_mul_s _ hc
    rw [sub_mul, mul_assoc, Q.ex_mul_s, smul_mul_assoc, Q.ex_mul_s, sub_eq_zero] at this
    exact this
  · have := Q.J_mul_t _ hc
    rw [sub_mul, mul_assoc, Q.ex_mul_t, smul_mul_assoc, Q.ex_mul_t, sub_eq_zero] at this
    exact this

/-! ### The coefficient of `e_y` in `Λ e_y ⊆ k e_y ⊕ J e_y` -/

section top

variable {Q} (hy : TopOneDim k Q.ey)

include hy in
lemma exists_topCoeff (p : Q.P) : ∃ c : k, (p : Λ) - c • Q.ey ∈ Ring.jacobson Λ := by
  obtain ⟨c, hc⟩ := hy p
  rw [Q.coe_mul_ey] at hc
  exact ⟨c, hc⟩

lemma topCoeff_unique {c c' : k} (h : c • Q.ey - c' • Q.ey ∈ Ring.jacobson Λ) : c = c' := by
  by_contra hne
  rw [← sub_smul] at h
  have := jacobson_smul_mem (c := (c - c')⁻¹) h
  rw [inv_smul_smul₀ (sub_ne_zero.2 hne)] at this
  exact Q.ey_not_mem this

/-- The coefficient of `e_y`: the `k`-linear map `Λ e_y → k` with kernel
`J e_y` and `e_y ↦ 1`. -/
def topCoeff : Q.P →ₗ[k] k where
  toFun p := Classical.choose (exists_topCoeff hy p)
  map_add' p q := by
    have h₁ := Classical.choose_spec (exists_topCoeff hy p)
    have h₂ := Classical.choose_spec (exists_topCoeff hy q)
    have h₃ := Classical.choose_spec (exists_topCoeff hy (p + q))
    refine topCoeff_unique (Q := Q) ?_
    have := sub_mem (add_mem h₁ h₂) h₃
    convert this using 1
    simp only [Submodule.coe_add, add_smul]
    abel
  map_smul' c p := by
    have h₁ := Classical.choose_spec (exists_topCoeff hy p)
    have h₃ := Classical.choose_spec (exists_topCoeff hy (c • p))
    refine topCoeff_unique (Q := Q) ?_
    have := sub_mem (jacobson_smul_mem (c := c) h₁) h₃
    convert this using 1
    simp only [Submodule.coe_smul_of_tower, smul_sub, smul_eq_mul, RingHom.id_apply, mul_smul]
    abel

lemma topCoeff_spec (p : Q.P) : (p : Λ) - topCoeff hy p • Q.ey ∈ Ring.jacobson Λ :=
  Classical.choose_spec (exists_topCoeff hy p)

lemma topCoeff_eq {p : Q.P} {c : k} (h : (p : Λ) - c • Q.ey ∈ Ring.jacobson Λ) :
    topCoeff hy p = c := by
  refine (topCoeff_unique (Q := Q) ?_).symm
  have := sub_mem (topCoeff_spec hy p) h
  convert this using 1
  abel

@[simp]
lemma topCoeff_eyP : topCoeff hy Q.eyP = 1 :=
  topCoeff_eq hy (by simp [eyP])

lemma topCoeff_of_mem {p : Q.P} (h : (p : Λ) ∈ Ring.jacobson Λ) : topCoeff hy p = 0 :=
  topCoeff_eq hy (by simpa using h)

@[simp]
lemma topCoeff_sP : topCoeff hy Q.sP = 0 := topCoeff_of_mem hy Q.s_mem.1

@[simp]
lemma topCoeff_tP : topCoeff hy Q.tP = 0 := topCoeff_of_mem hy Q.t_mem.1

lemma topCoeff_smul (r : Λ) (p : Q.P) :
    topCoeff hy (r • p) = topCoeff hy (r • Q.eyP) * topCoeff hy p := by
  refine topCoeff_eq hy ?_
  have h₁ := Ideal.mul_mem_left _ r (topCoeff_spec hy p)
  have h₂ := jacobson_smul_mem (c := topCoeff hy p) (topCoeff_spec hy (r • Q.eyP))
  have := add_mem h₁ h₂
  convert this using 1
  simp only [Submodule.coe_smul, smul_eq_mul, coe_eyP, mul_sub, mul_smul_comm, smul_sub,
    mul_comm (topCoeff hy (r • Q.eyP)), mul_smul]
  abel

lemma topCoeff_smul_of_mem {j : Λ} (hj : j ∈ Ring.jacobson Λ) (p : Q.P) :
    topCoeff hy (j • p) = 0 := by
  rw [topCoeff_smul, topCoeff_of_mem hy (p := j • Q.eyP) (by
    simpa using Ideal.mul_mem_right _ _ hj), zero_mul]

end top

/-! ### The quotient map and the generators `e_y ⊗ w` -/

lemma relMap_apply (X : Kron k) (v : X.V) :
    Q.relMap X v = Q.sP ⊗ₜ X.a.hom v + Q.tP ⊗ₜ X.b.hom v := rfl

/-- The quotient map `Λ e_y ⊗ W → F₁(X)`. -/
abbrev π (X : Kron k) : Q.P ⊗[k] X.W →ₗ[Λ] Q.P ⊗[k] X.W ⧸ Q.relSub X := (Q.relSub X).mkQ

/-- The generator `e_y ⊗ w` of `F₁(X)`, `k`-linear in `w`. -/
def gen (X : Kron k) : X.W →ₗ[k] Q.P ⊗[k] X.W ⧸ Q.relSub X :=
  (Submodule.Quotient.restrictScalarsEquiv k (Q.relSub X)).toLinearMap ∘ₗ
    ((Q.relSub X).restrictScalars k).mkQ ∘ₗ TensorProduct.mk k Q.P X.W Q.eyP

lemma gen_apply (X : Kron k) (w : X.W) : Q.gen X w = Q.π X (Q.eyP ⊗ₜ w) := rfl

lemma π_tmul (X : Kron k) (p : Q.P) (w : X.W) : Q.π X (p ⊗ₜ w) = (p : Λ) • Q.gen X w := by
  rw [gen_apply, ← map_smul, TensorProduct.smul_tmul', Q.smul_eyP]

lemma π_relMap (X : Kron k) (v : X.V) : Q.π X (Q.relMap X v) = 0 :=
  (Submodule.Quotient.mk_eq_zero _).2 (Submodule.subset_span ⟨v, rfl⟩)

lemma functor_map_π {X Y : Kron k} (f : X ⟶ Y) (x : Q.P ⊗[k] X.W) :
    (Q.functor.map f).hom (Q.π X x) = Q.π Y (Q.tensorMap (f.app one) x) := rfl

lemma functor_map_gen {X Y : Kron k} (f : X ⟶ Y) (w : X.W) :
    (Q.functor.map f).hom (Q.gen X w) = Q.gen Y ((f.app one).hom w) := rfl

lemma tensorMap_apply {W W' : ModuleCat.{u} k} (h : W ⟶ W') (x : Q.P ⊗[k] W) :
    Q.tensorMap h x = LinearMap.lTensor Q.P h.hom x := by
  induction x using TensorProduct.inductionOn with
  | tmul p w => rfl
  | add x y hx hy => rw [map_add, map_add, hx, hy]

lemma tensorMap_relMap {X Y : Kron k} (f : X ⟶ Y) (v : X.V) :
    Q.tensorMap (f.app one) (Q.relMap X v) = Q.relMap Y ((f.app zero).hom v) := by
  simp [relMap_apply, tensorMap_tmul]

/-! ### Separating `s ⊗ w₁ + t ⊗ w₂` -/

/-- The inclusion `Λ e_y → Λ` as a `k`-linear map. -/
def valₗ : Q.P →ₗ[k] Λ where
  toFun := Subtype.val
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

lemma linearIndependent_sP_tP : LinearIndependent k ![Q.sP, Q.tP] := by
  refine LinearIndependent.of_comp Q.valₗ ?_
  convert Q.linearIndependent using 1
  ext i; fin_cases i <;> rfl

lemma exists_dual (i : Fin 2) :
    ∃ φ : Q.P →ₗ[k] k, ∀ j, φ (![Q.sP, Q.tP] j) = if i = j then 1 else 0 := by
  let b := Module.Basis.span Q.linearIndependent_sP_tP
  obtain ⟨φ, hφ⟩ := LinearMap.exists_extend (b.coord i)
  refine ⟨φ, fun j ↦ ?_⟩
  have h1 : ![Q.sP, Q.tP] j = (Submodule.span k (Set.range ![Q.sP, Q.tP])).subtype (b j) := by
    simp [b, Module.Basis.span_apply]
  rw [h1, ← LinearMap.comp_apply, hφ, Module.Basis.coord_apply, Module.Basis.repr_self,
    Finsupp.single_apply]
  rcases eq_or_ne i j with rfl | hij
  · simp
  · simp [hij, Ne.symm hij]

lemma eq_zero_of_tmul (W : Type u) [AddCommGroup W] [Module k W] {w₁ w₂ : W}
    (h : Q.sP ⊗ₜ[k] w₁ + Q.tP ⊗ₜ[k] w₂ = 0) : w₁ = 0 ∧ w₂ = 0 := by
  obtain ⟨φ, hφ⟩ := Q.exists_dual 0
  obtain ⟨ψ, hψ⟩ := Q.exists_dual 1
  have e₁ := congrArg ((TensorProduct.lid k W).toLinearMap ∘ₗ LinearMap.rTensor W φ) h
  have e₂ := congrArg ((TensorProduct.lid k W).toLinearMap ∘ₗ LinearMap.rTensor W ψ) h
  have a₁ := hφ 0; have a₂ := hφ 1; have a₃ := hψ 0; have a₄ := hψ 1
  simp at a₁ a₂ a₃ a₄
  simp [a₁, a₂, a₃, a₄] at e₁ e₂
  exact ⟨e₁, e₂⟩

lemma tmul_eq_tmul (W : Type u) [AddCommGroup W] [Module k W] {w₁ w₂ w₁' w₂' : W}
    (h : Q.sP ⊗ₜ[k] w₁ + Q.tP ⊗ₜ[k] w₂ = Q.sP ⊗ₜ[k] w₁' + Q.tP ⊗ₜ[k] w₂') :
    w₁ = w₁' ∧ w₂ = w₂' := by
  have := Q.eq_zero_of_tmul W (w₁ := w₁ - w₁') (w₂ := w₂ - w₂') (by
    rw [TensorProduct.tmul_sub, TensorProduct.tmul_sub, sub_add_sub_comm, h, sub_self])
  exact ⟨sub_eq_zero.1 this.1, sub_eq_zero.1 this.2⟩

/-- (a) The relation map `v ↦ s ⊗ a(v) + t ⊗ b(v)` is injective on `D`. -/
lemma relMap_injective {X : Kron k} (hX : InD X) : Function.Injective (Q.relMap X) := by
  rw [← LinearMap.ker_eq_bot, eq_bot_iff]
  intro v hv
  obtain ⟨ha, hb⟩ := Q.eq_zero_of_tmul X.W hv
  exact (inD_iff X).1 hX v ha hb

/-- (b) The relation submodule is the `k`-range of `relMap`: it is
annihilated by `J`, and `Λ/J` acts on `s, t` by scalars. -/
lemma mem_relSub_iff (hx : TopOneDim k Q.ex) {X : Kron k} {x : Q.P ⊗[k] X.W} :
    x ∈ Q.relSub X ↔ ∃ v, Q.relMap X v = x := by
  refine ⟨fun h ↦ ?_, fun ⟨v, hv⟩ ↦ hv ▸ Submodule.subset_span ⟨v, rfl⟩⟩
  induction h using Submodule.span_induction with
  | mem x hx' => exact hx'
  | zero => exact ⟨0, map_zero _⟩
  | add x y _ _ h₁ h₂ =>
    obtain ⟨v, rfl⟩ := h₁; obtain ⟨v', rfl⟩ := h₂; exact ⟨v + v', map_add _ _ _⟩
  | smul r x _ h =>
    obtain ⟨v, rfl⟩ := h
    obtain ⟨c, hs, ht⟩ := Q.exists_smul_s_t hx r
    refine ⟨c • v, ?_⟩
    have hs' : r • Q.sP = c • Q.sP := Subtype.ext hs
    have ht' : r • Q.tP = c • Q.tP := Subtype.ext ht
    rw [map_smul, relMap_apply, smul_add, smul_add, TensorProduct.smul_tmul',
      TensorProduct.smul_tmul', TensorProduct.smul_tmul', TensorProduct.smul_tmul', hs', ht']

lemma relSub_restrictScalars (hx : TopOneDim k Q.ex) (X : Kron k) :
    (Q.relSub X).restrictScalars k = LinearMap.range (Q.relMap X) := by
  ext x
  simp [Q.mem_relSub_iff hx]

/-! ### (c) Exactness -/

section exact

variable (hx : TopOneDim k Q.ex) {X Y Z : Kron k} {f : X ⟶ Y} {g : Y ⟶ Z}
  (h : Kron.IsShortExact f g)

include h in
lemma comp_apply_eq_zero (j : WalkingParallelPair) (w : X.obj j) :
    (g.app j).hom ((f.app j).hom w) = 0 :=
  (LinearMap.mem_ker).1 ((h j).2.2 ▸ LinearMap.mem_range_self _ w)

include h in
lemma tensorMap_comp_eq_zero (x : Q.P ⊗[k] X.W) :
    Q.tensorMap (g.app one) (Q.tensorMap (f.app one) x) = 0 := by
  rw [tensorMap_apply, tensorMap_apply, ← LinearMap.comp_apply, ← LinearMap.lTensor_comp]
  have : (g.app one).hom ∘ₗ (f.app one).hom = 0 :=
    LinearMap.ext fun w ↦ comp_apply_eq_zero h one w
  rw [this, LinearMap.lTensor_zero, LinearMap.zero_apply]

include hx h in
/-- (c) `F₁(f)` is injective for a short exact sequence with `Z ∈ D`. -/
lemma map_injective_of_shortExact (hZ : InD Z) : Function.Injective (Q.functor.map f).hom := by
  rw [injective_iff_map_eq_zero]
  intro m hm
  obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ m
  change Q.π Y (Q.tensorMap (f.app one) x) = 0 at hm
  rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero, Q.mem_relSub_iff hx] at hm
  obtain ⟨v, hv⟩ := hm
  have h₁ : Q.relMap Z ((g.app zero).hom v) = 0 := by
    rw [← tensorMap_relMap, hv, Q.tensorMap_comp_eq_zero h]
  have h₂ : (g.app zero).hom v = 0 := Q.relMap_injective hZ (by rw [h₁, map_zero])
  obtain ⟨u, rfl⟩ : v ∈ LinearMap.range (f.app zero).hom := (h zero).2.2 ▸ h₂
  rw [← tensorMap_relMap, tensorMap_apply, tensorMap_apply] at hv
  have := Module.Flat.lTensor_preserves_injective_linearMap (M := Q.P) _ (h one).1 hv
  change Q.π X x = 0
  rw [← this, π_relMap]

include h in
/-- (c) `F₁(g)` is surjective for a short exact sequence. -/
lemma map_surjective_of_shortExact : Function.Surjective (Q.functor.map g).hom := by
  intro m
  obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ m
  obtain ⟨x, rfl⟩ := LinearMap.lTensor_surjective Q.P (h one).2.1 y
  exact ⟨Q.π Y x, by rw [functor_map_π, tensorMap_apply]; rfl⟩

include hx h in
/-- (c) `range F₁(f) = ker F₁(g)` for a short exact sequence. -/
lemma range_eq_ker_of_shortExact :
    LinearMap.range (Q.functor.map f).hom = LinearMap.ker (Q.functor.map g).hom := by
  ext m
  constructor
  · rintro ⟨m', rfl⟩
    obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ m'
    change Q.π Z (Q.tensorMap (g.app one) (Q.tensorMap (f.app one) x)) = 0
    rw [Q.tensorMap_comp_eq_zero h, map_zero]
  · obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ m
    intro hm
    change Q.π Z (Q.tensorMap (g.app one) y) = 0 at hm
    rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero, Q.mem_relSub_iff hx] at hm
    obtain ⟨w, hw⟩ := hm
    obtain ⟨v, rfl⟩ := (h zero).2.1 w
    have hex : Function.Exact (LinearMap.lTensor Q.P (f.app one).hom)
        (LinearMap.lTensor Q.P (g.app one).hom) :=
      lTensor_exact Q.P (LinearMap.exact_iff.2 (h one).2.2.symm) (h one).2.1
    obtain ⟨x, hx'⟩ := (hex (y - Q.relMap Y v)).1 (by
      rw [map_sub, ← tensorMap_apply, ← tensorMap_apply, tensorMap_relMap, hw, sub_self])
    refine ⟨Q.π X x, ?_⟩
    change Q.π Y (Q.tensorMap (f.app one) x) = Q.π Y y
    rw [tensorMap_apply, hx', map_sub, π_relMap, sub_zero]

end exact

/-! ### (d) Finite dimension -/

lemma finite_P [FiniteDimensional k Λ] : Module.Finite k Q.P :=
  Module.Finite.of_injective Q.valₗ Subtype.val_injective

/-- (d) `F₁` sends finite-dimensional modules to finite-dimensional modules. -/
lemma finite_obj [FiniteDimensional k Λ] (X : Kron k) [Module.Finite k X.W] :
    Module.Finite k (Q.P ⊗[k] X.W ⧸ Q.relSub X) := by
  have := Q.finite_P
  infer_instance

/-- (d), in the form used in `Statement.TheoremA`. -/
lemma finite_restrictScalars [FiniteDimensional k Λ] (X : Kron k) [Module.Finite k X.W] :
    Module.Finite k (RestrictScalars k Λ (Q.functor.obj X)) := by
  have := Q.finite_obj X
  let e : (Q.P ⊗[k] X.W ⧸ Q.relSub X) ≃ₗ[k] RestrictScalars k Λ (Q.functor.obj X) :=
    { (RestrictScalars.addEquiv k Λ (Q.functor.obj X)).symm with
      map_smul' := fun c m ↦ by
        change (RestrictScalars.addEquiv k Λ _).symm (c • m) = _
        rw [← algebraMap_smul Λ c m, RestrictScalars.addEquiv_symm_map_algebraMap_smul]
        rfl }
  exact Module.Finite.equiv e

/-! ### (e) The top of `F₁(X)` -/

section topMap

variable {Q} (hy : TopOneDim k Q.ey)

/-- `Λ e_y ⊗ W → W`, `p ⊗ w ↦ (coefficient of e_y in p) w`. -/
def topT (X : Kron k) : Q.P ⊗[k] X.W →ₗ[k] X.W :=
  (TensorProduct.lid k X.W).toLinearMap ∘ₗ LinearMap.rTensor X.W (topCoeff hy)

@[simp]
lemma topT_tmul (X : Kron k) (p : Q.P) (w : X.W) :
    topT hy X (p ⊗ₜ w) = topCoeff hy p • w := by
  simp [topT]

lemma topT_smul (X : Kron k) (r : Λ) (x : Q.P ⊗[k] X.W) :
    topT hy X (r • x) = topCoeff hy (r • Q.eyP) • topT hy X x := by
  induction x using TensorProduct.inductionOn with
  | tmul p w => rw [TensorProduct.smul_tmul', topT_tmul, topT_tmul, topCoeff_smul, mul_smul]
  | add x y h₁ h₂ => rw [smul_add, map_add, map_add, h₁, h₂, smul_add]

lemma topT_relSub (X : Kron k) {x : Q.P ⊗[k] X.W} (hx : x ∈ Q.relSub X) : topT hy X x = 0 := by
  induction hx using Submodule.span_induction with
  | mem x hx => obtain ⟨v, rfl⟩ := hx; simp [relMap_apply]
  | zero => simp
  | add x y _ _ h₁ h₂ => rw [map_add, h₁, h₂, add_zero]
  | smul r x _ h => rw [topT_smul, h, smul_zero]

/-- The map `F₁(X) → W` on the top: `F₁(X) / J F₁(X) ≅ W` (`topEquiv`). -/
def topQ (X : Kron k) : (Q.P ⊗[k] X.W ⧸ Q.relSub X) →ₗ[k] X.W :=
  ((Q.relSub X).restrictScalars k).liftQ (topT hy X)
      (fun _ hx ↦ LinearMap.mem_ker.2 (topT_relSub hy X hx)) ∘ₗ
    (Submodule.Quotient.restrictScalarsEquiv k (Q.relSub X)).symm.toLinearMap

lemma topQ_π (X : Kron k) (x : Q.P ⊗[k] X.W) : topQ hy X (Q.π X x) = topT hy X x := rfl

@[simp]
lemma topQ_gen (X : Kron k) (w : X.W) : topQ hy X (Q.gen X w) = w := by
  rw [gen_apply, topQ_π, topT_tmul, topCoeff_eyP, one_smul]

lemma topQ_surjective (X : Kron k) : Function.Surjective (topQ hy X) :=
  fun w ↦ ⟨Q.gen X w, topQ_gen hy X w⟩

lemma topQ_radPow (X : Kron k) {m : Q.P ⊗[k] X.W ⧸ Q.relSub X} (hm : m ∈ radPow Λ _ 1) :
    topQ hy X m = 0 := by
  induction hm using AddSubgroup.closure_induction with
  | mem m hm =>
    obtain ⟨l, hl, hJ, m, rfl⟩ := hm
    obtain ⟨j, rfl⟩ := List.length_eq_one_iff.1 hl
    obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ m
    rw [List.prod_singleton, ← Submodule.mkQ_apply, ← map_smul, topQ_π, topT_smul,
      topCoeff_of_mem hy (p := j • Q.eyP) (by
        simpa using Ideal.mul_mem_right _ _ (hJ j (by simp))), zero_smul]
  | zero => simp
  | add x y _ _ h₁ h₂ => rw [map_add, h₁, h₂, add_zero]
  | neg x _ h => rw [map_neg, h, neg_zero]

/-- Every element of `F₁(X)` is `e_y ⊗ (its top)` modulo `J F₁(X)`. -/
lemma π_sub_gen_mem (X : Kron k) (x : Q.P ⊗[k] X.W) :
    Q.π X x - Q.gen X (topT hy X x) ∈ radPow Λ _ 1 := by
  induction x using TensorProduct.inductionOn with
  | tmul p w =>
    have hj := topCoeff_spec hy p
    have e₁ : Q.ey • Q.gen X w = Q.gen X w := by
      rw [gen_apply, ← map_smul, TensorProduct.smul_tmul']
      exact congrArg (fun q ↦ Q.π X (q ⊗ₜ w)) (Q.smul_eyP Q.eyP)
    have : Q.π X (p ⊗ₜ w) - Q.gen X (topT hy X (p ⊗ₜ w)) =
        [(p : Λ) - topCoeff hy p • Q.ey].prod • Q.gen X w := by
      rw [π_tmul, topT_tmul, map_smul, List.prod_singleton, sub_smul, smul_assoc, e₁]
    rw [this]
    exact smul_mem_radPow_of_mem (l := [(p : Λ) - topCoeff hy p • Q.ey]) rfl (by simpa using hj) _
  | add x y h₁ h₂ =>
    rw [map_add, map_add, map_add, add_sub_add_comm]
    exact add_mem h₁ h₂

/-- (e) `ker (F₁(X) → W) = J F₁(X)`. -/
lemma topQ_eq_zero_iff (X : Kron k) (m : Q.P ⊗[k] X.W ⧸ Q.relSub X) :
    topQ hy X m = 0 ↔ m ∈ radPow Λ _ 1 := by
  refine ⟨fun h ↦ ?_, topQ_radPow hy X⟩
  obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ m
  have h' : topQ hy X (Q.π X x) = 0 := h
  have := π_sub_gen_mem hy X x
  rwa [← topQ_π, h', map_zero, sub_zero] at this

/-- (e) The top of `F₁(X)`: `F₁(X) / J F₁(X) ≅ W`. -/
def topEquiv (X : Kron k) :
    ((Q.P ⊗[k] X.W ⧸ Q.relSub X) ⧸ LinearMap.ker (topQ hy X)) ≃ₗ[k] X.W :=
  (topQ hy X).quotKerEquivOfSurjective (topQ_surjective hy X)

/-! ### (f) Faithfulness (Lemma 3.11(1)) -/

lemma topQ_functor_map_gen {X Y : Kron k} (f : X ⟶ Y) (w : X.W) :
    topQ hy Y ((Q.functor.map f).hom (Q.gen X w)) = (f.app one).hom w := by
  rw [functor_map_gen, topQ_gen]

include hy in
/-- (f) Lemma 3.11(1): `F₁` is faithful on morphisms into `D`. -/
lemma functor_map_injective {X Y : Kron k} (hY : InD Y) {f f' : X ⟶ Y}
    (h : Q.functor.map f = Q.functor.map f') : f = f' := by
  refine Kron.ext_of_app_one hY ?_
  ext w
  rw [← topQ_functor_map_gen hy, h, topQ_functor_map_gen hy]

end topMap

end QuotientData

end LargeIndecomposable
