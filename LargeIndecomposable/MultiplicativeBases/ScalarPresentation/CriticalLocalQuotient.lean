module

public import LargeIndecomposable.RayCategories.Distributive.ProperQuotientCorners
public import LargeIndecomposable.MultiplicativeBases.ScalarPresentation.CriticalFigure14
public import LargeIndecomposable.MultiplicativeBases.ScalarPresentation.CriticalFigure15
public import LargeIndecomposable.MultiplicativeBases.ScalarPresentation.CriticalTransitPropagation
public import LargeIndecomposable.RayCategories.Distributive.RayIrreducibleRadicalLayer
public import LargeIndecomposable.Modules.SplitBasic.SplitBasicCorner
public import LargeIndecomposable.RepresentationType.Basic.RepresentationFiniteIdeals

@[expose] public section

/-!
# Local selected-corner quotients for BGRS Figures 14--15

BGRS 4.3 takes its Figure-14/15 quotients inside a finite full subcategory of
primitive projectives.  A finite selection of the chosen primitive
idempotents is now represented by its split-basic corner, so these local
quotients no longer need to be strengthened to global quotients of the whole
algebra.

This file packages that exact local algebra plumbing.  The remaining callback
is still the source-specific construction of the displayed diagram and its
Hom-bifunctor retraction.
-/

set_option autoImplicit false
noncomputable section

open CategoryTheory

namespace LargeIndecomposable.BGRSCriticalPathSpine

universe u₀ v₀ x₀

variable {k₀ : Type u₀} [Field k₀]
variable {A₀ : Type v₀} [Ring A₀] [Algebra k₀ A₀]
variable {ι₀ : Type x₀} [Fintype ι₀] [DecidableEq ι₀]

variable (S₀ : LargeIndecomposable.SplitBasicIdempotents
  (k := k₀) (A := A₀) (ι := ι₀))

variable [Module.Finite k₀ A₀]
variable [LargeIndecomposable.HasBGRSDistributiveHomStructure
  k₀ S₀.ProjectiveCategory]

/-- The nonzero ordinary composite packaged by a critical spine lies in the
ambient Jacobson radical. -/
theorem lift_pathMap_mem_jacobson
    {i j : LargeIndecomposable.RayVertex S₀.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p) :
    (spine.lift.pathMap p).1 ∈ Ring.jacobson A₀ :=
  LargeIndecomposable.SplitBasicIdempotents.rayArrowLift_pathMap_mem_jacobson
    S₀ spine.lift p
    (by
      have hthree := spine.three_le_length
      omega)

/-- The ambient two-sided relation ideal generated by the nonzero ordinary
composite witnessing a critical spine. -/
def ambientRelationIdeal
    {i j : LargeIndecomposable.RayVertex S₀.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p) :
    TwoSidedIdeal A₀ :=
  TwoSidedIdeal.span ({(spine.lift.pathMap p).1} : Set A₀)

/-- The critical-spine relation ideal is nonzero. -/
theorem ambientRelationIdeal_ne_bot
    {i j : LargeIndecomposable.RayVertex S₀.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p) :
    spine.ambientRelationIdeal S₀ ≠ ⊥ := by
  intro hbot
  have hmem : (spine.lift.pathMap p).1 ∈ spine.ambientRelationIdeal S₀ :=
    TwoSidedIdeal.subset_span (Set.mem_singleton _)
  rw [hbot] at hmem
  exact spine.lift_path_ne_zero (Subtype.ext (by simpa using hmem))

/-- The relation generated by a critical spine of length at least three is
contained in the cube of the ambient Jacobson radical. -/
theorem ambientRelationIdeal_le_jacobson_pow_three
    {i j : LargeIndecomposable.RayVertex S₀.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p) :
    (spine.ambientRelationIdeal S₀).asIdeal ≤
      (Ring.jacobson A₀) ^ 3 := by
  have hgenerator : (spine.lift.pathMap p).1 ∈
      (Ring.jacobson A₀) ^ 3 :=
    Ideal.pow_le_pow_right spine.three_le_length
      (LargeIndecomposable.SplitBasicIdempotents.rayArrowLift_pathMap_mem_jacobson_pow
        S₀ spine.lift p)
  have hle : spine.ambientRelationIdeal S₀ ≤
      ((Ring.jacobson A₀) ^ 3).toTwoSided := by
    apply TwoSidedIdeal.span_le.2
    intro a ha
    rw [Set.mem_singleton_iff] at ha
    subst a
    exact Ideal.mem_toTwoSided.2 hgenerator
  intro a ha
  exact Ideal.mem_toTwoSided.1 (hle ha)

/-- The critical-spine relation ideal is contained in the ambient Jacobson
radical, so quotienting by it preserves the chosen split-basic vertices. -/
theorem ambientRelationIdeal_le_jacobson
    {i j : LargeIndecomposable.RayVertex S₀.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p) :
    (spine.ambientRelationIdeal S₀).asIdeal ≤ Ring.jacobson A₀ := by
  intro a ha
  simpa only [Submodule.pow_one] using
    Ideal.pow_le_pow_right (by omega : 1 ≤ 3)
      (spine.ambientRelationIdeal_le_jacobson_pow_three S₀ ha)

/-- The first lifted irreducible arrow of a critical spine does not belong to
the relation ideal generated by the full critical composite. -/
theorem lift_first_not_mem_ambientRelationIdeal
    {i j : LargeIndecomposable.RayVertex S₀.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p) :
    (spine.lift.representative spine.first).1 ∉
      (spine.ambientRelationIdeal S₀).asIdeal := by
  intro hmem
  apply LargeIndecomposable.SplitBasicIdempotents.rayArrowLift_representative_not_mem_jacobson_sq
    S₀ spine.lift spine.first
  have hpow := Ideal.pow_le_pow_right (by omega : 2 ≤ 3)
    (spine.ambientRelationIdeal_le_jacobson_pow_three S₀ hmem)
  rw [show (2 : ℕ) = 1 + 1 by omega,
    Ideal.IsTwoSided.pow_add, Submodule.pow_one] at hpow
  exact hpow

/-- The last lifted irreducible arrow of a critical spine does not belong to
the relation ideal generated by the full critical composite. -/
theorem lift_last_not_mem_ambientRelationIdeal
    {i j : LargeIndecomposable.RayVertex S₀.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p) :
    (spine.lift.representative spine.last).1 ∉
      (spine.ambientRelationIdeal S₀).asIdeal := by
  intro hmem
  apply LargeIndecomposable.SplitBasicIdempotents.rayArrowLift_representative_not_mem_jacobson_sq
    S₀ spine.lift spine.last
  have hpow := Ideal.pow_le_pow_right (by omega : 2 ≤ 3)
    (spine.ambientRelationIdeal_le_jacobson_pow_three S₀ hmem)
  rw [show (2 : ℕ) = 1 + 1 by omega,
    Ideal.IsTwoSided.pow_add, Submodule.pow_one] at hpow
  exact hpow

/-- The split-basic quotient by the critical-spine relation ideal kills the
full ordinary composite witnessing the spine. -/
theorem projectiveQuotientFunctor_map_lift_pathMap_eq_zero
    {i j : LargeIndecomposable.RayVertex S₀.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p) :
    (S₀.projectiveQuotientFunctor (spine.ambientRelationIdeal S₀)
      (spine.ambientRelationIdeal_le_jacobson S₀)).map
        (spine.lift.pathMap p) = 0 := by
  rw [S₀.projectiveQuotientFunctor_map_eq_zero_iff]
  exact TwoSidedIdeal.subset_span (Set.mem_singleton _)

/-- In the critical-spine quotient, the displayed last--middle--first
threefold composite is literally zero. -/
theorem projectiveQuotientFunctor_map_lift_last_middle_first_eq_zero
    {i j : LargeIndecomposable.RayVertex S₀.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p) :
    (S₀.projectiveQuotientFunctor (spine.ambientRelationIdeal S₀)
        (spine.ambientRelationIdeal_le_jacobson S₀)).map
          (spine.lift.representative spine.last) ≫
      (S₀.projectiveQuotientFunctor (spine.ambientRelationIdeal S₀)
        (spine.ambientRelationIdeal_le_jacobson S₀)).map
          (spine.lift.pathMap spine.middle) ≫
      (S₀.projectiveQuotientFunctor (spine.ambientRelationIdeal S₀)
        (spine.ambientRelationIdeal_le_jacobson S₀)).map
          (spine.lift.representative spine.first) = 0 := by
  have hzero := spine.projectiveQuotientFunctor_map_lift_pathMap_eq_zero S₀
  rw [spine.lift_pathMap_eq_last_middle_first] at hzero
  simpa only [Functor.map_comp] using hzero

/-- The first lifted irreducible arrow survives the critical-spine radical
quotient. -/
theorem projectiveQuotientFunctor_map_lift_first_ne_zero
    {i j : LargeIndecomposable.RayVertex S₀.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p) :
    (S₀.projectiveQuotientFunctor (spine.ambientRelationIdeal S₀)
      (spine.ambientRelationIdeal_le_jacobson S₀)).map
        (spine.lift.representative spine.first) ≠ 0 := by
  intro hzero
  exact spine.lift_first_not_mem_ambientRelationIdeal S₀
    ((S₀.projectiveQuotientFunctor_map_eq_zero_iff
      (spine.ambientRelationIdeal S₀)
      (spine.ambientRelationIdeal_le_jacobson S₀)
      (spine.lift.representative spine.first)).1 hzero)

/-- The last lifted irreducible arrow survives the critical-spine radical
quotient. -/
theorem projectiveQuotientFunctor_map_lift_last_ne_zero
    {i j : LargeIndecomposable.RayVertex S₀.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p) :
    (S₀.projectiveQuotientFunctor (spine.ambientRelationIdeal S₀)
      (spine.ambientRelationIdeal_le_jacobson S₀)).map
        (spine.lift.representative spine.last) ≠ 0 := by
  intro hzero
  exact spine.lift_last_not_mem_ambientRelationIdeal S₀
    ((S₀.projectiveQuotientFunctor_map_eq_zero_iff
      (spine.ambientRelationIdeal S₀)
      (spine.ambientRelationIdeal_le_jacobson S₀)
      (spine.lift.representative spine.last)).1 hzero)

end LargeIndecomposable.BGRSCriticalPathSpine

namespace LargeIndecomposable.CriticalSingularLocalQuotientExtraction

open LargeIndecomposable.ClosedZigzagCrossUniverse

universe u uA x

variable {k : Type u} [Field k]
variable {A : Type uA} [Ring A] [Algebra k A] [Module.Finite k A]
variable {ι : Type x} [Fintype ι] [DecidableEq ι]
variable (S : LargeIndecomposable.SplitBasicIdempotents
  (k := k) (A := A) (ι := ι))

/-- A Figure-14 diagram in a finite selected primitive corner, together with
the local radical quotient in which its cleaving realization lives. -/
structure Figure14LocalQuotientCandidate where
  rank : ℕ
  r : Fin rank ↪ ι
  I : TwoSidedIdeal (S.SelectedCorner r)
  le_jacobson : I.asIdeal ≤ Ring.jacobson (S.SelectedCorner r)
  ambient : LargeIndecomposable.CriticalSingularFigure14.DiagramData
    (C := (LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.splitBasic
      S r).ProjectiveCategory)

namespace Figure14LocalQuotientCandidate

/-- The chosen split-basic presentation of the candidate's selected corner. -/
abbrev cornerSplitBasic (G : Figure14LocalQuotientCandidate S) :=
  LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.splitBasic S G.r

/-- Map the five local Figure-14 arrows through the selected-corner quotient
functor. -/
def quotientDiagram (G : Figure14LocalQuotientCandidate S) :
    LargeIndecomposable.CriticalSingularFigure14.DiagramData
      (C := ((cornerSplitBasic S G).quotient_of_le_jacobson
        G.I G.le_jacobson).ProjectiveCategory) where
  c := ((cornerSplitBasic S G).projectiveQuotientFunctor
    G.I G.le_jacobson).obj G.ambient.c
  d := ((cornerSplitBasic S G).projectiveQuotientFunctor
    G.I G.le_jacobson).obj G.ambient.d
  b := ((cornerSplitBasic S G).projectiveQuotientFunctor
    G.I G.le_jacobson).obj G.ambient.b
  cUpper :=
    ((cornerSplitBasic S G).projectiveQuotientFunctor
      G.I G.le_jacobson).obj G.ambient.cUpper
  dLower :=
    ((cornerSplitBasic S G).projectiveQuotientFunctor
      G.I G.le_jacobson).obj G.ambient.dLower
  a := ((cornerSplitBasic S G).projectiveQuotientFunctor
    G.I G.le_jacobson).obj G.ambient.a
  lambda :=
    ((cornerSplitBasic S G).projectiveQuotientFunctor
      G.I G.le_jacobson).map G.ambient.lambda
  alphaLeft :=
    ((cornerSplitBasic S G).projectiveQuotientFunctor
      G.I G.le_jacobson).map G.ambient.alphaLeft
  deltaUpper :=
    ((cornerSplitBasic S G).projectiveQuotientFunctor
      G.I G.le_jacobson).map G.ambient.deltaUpper
  deltaLower :=
    ((cornerSplitBasic S G).projectiveQuotientFunctor
      G.I G.le_jacobson).map G.ambient.deltaLower
  alphaRight :=
    ((cornerSplitBasic S G).projectiveQuotientFunctor
      G.I G.le_jacobson).map G.ambient.alphaRight

/-- The lower twofold Figure-14 path survives precisely when its ambient
corner element is outside the local relation ideal. -/
theorem quotientDiagram_alphaLeft_deltaLower_ne_zero_iff
    (G : Figure14LocalQuotientCandidate S) :
    G.quotientDiagram.alphaLeft ≫ G.quotientDiagram.deltaLower ≠ 0 ↔
      (G.ambient.alphaLeft ≫ G.ambient.deltaLower).1 ∉ G.I.asIdeal := by
  unfold quotientDiagram
  rw [← Functor.map_comp]
  exact not_congr
    ((cornerSplitBasic S G).projectiveQuotientFunctor_map_eq_zero_iff
      G.I G.le_jacobson (G.ambient.alphaLeft ≫ G.ambient.deltaLower))

/-- The left-center twofold Figure-14 path survives precisely when its
ambient corner element is outside the local relation ideal. -/
theorem quotientDiagram_alphaLeft_lambda_ne_zero_iff
    (G : Figure14LocalQuotientCandidate S) :
    G.quotientDiagram.alphaLeft ≫ G.quotientDiagram.lambda ≠ 0 ↔
      (G.ambient.alphaLeft ≫ G.ambient.lambda).1 ∉ G.I.asIdeal := by
  unfold quotientDiagram
  rw [← Functor.map_comp]
  exact not_congr
    ((cornerSplitBasic S G).projectiveQuotientFunctor_map_eq_zero_iff
      G.I G.le_jacobson (G.ambient.alphaLeft ≫ G.ambient.lambda))

/-- The center-right twofold Figure-14 path survives precisely when its
ambient corner element is outside the local relation ideal. -/
theorem quotientDiagram_lambda_alphaRight_ne_zero_iff
    (G : Figure14LocalQuotientCandidate S) :
    G.quotientDiagram.lambda ≫ G.quotientDiagram.alphaRight ≠ 0 ↔
      (G.ambient.lambda ≫ G.ambient.alphaRight).1 ∉ G.I.asIdeal := by
  unfold quotientDiagram
  rw [← Functor.map_comp]
  exact not_congr
    ((cornerSplitBasic S G).projectiveQuotientFunctor_map_eq_zero_iff
      G.I G.le_jacobson (G.ambient.lambda ≫ G.ambient.alphaRight))

/-- The upper twofold Figure-14 path survives precisely when its ambient
corner element is outside the local relation ideal. -/
theorem quotientDiagram_deltaUpper_alphaRight_ne_zero_iff
    (G : Figure14LocalQuotientCandidate S) :
    G.quotientDiagram.deltaUpper ≫ G.quotientDiagram.alphaRight ≠ 0 ↔
      (G.ambient.deltaUpper ≫ G.ambient.alphaRight).1 ∉ G.I.asIdeal := by
  unfold quotientDiagram
  rw [← Functor.map_comp]
  exact not_congr
    ((cornerSplitBasic S G).projectiveQuotientFunctor_map_eq_zero_iff
      G.I G.le_jacobson (G.ambient.deltaUpper ≫ G.ambient.alphaRight))

/-- The central threefold Figure-14 path survives precisely when its ambient
corner element is outside the local relation ideal. -/
theorem quotientDiagram_threefold_ne_zero_iff
    (G : Figure14LocalQuotientCandidate S) :
    G.quotientDiagram.alphaLeft ≫ G.quotientDiagram.lambda ≫
        G.quotientDiagram.alphaRight ≠ 0 ↔
      (G.ambient.alphaLeft ≫ G.ambient.lambda ≫
        G.ambient.alphaRight).1 ∉ G.I.asIdeal := by
  unfold quotientDiagram
  rw [← Functor.map_comp, ← Functor.map_comp]
  exact not_congr
    ((cornerSplitBasic S G).projectiveQuotientFunctor_map_eq_zero_iff
      G.I G.le_jacobson
        (G.ambient.alphaLeft ≫ G.ambient.lambda ≫ G.ambient.alphaRight))

/-- Exact residual cleavage assertion for a local Figure-14 quotient. -/
def IsCleaving (G : Figure14LocalQuotientCandidate S) : Prop :=
  Nonempty (HomBifunctorRetraction (k := k)
    (G.quotientDiagram.functor (k := k)))

end Figure14LocalQuotientCandidate

/-- Ambient Figure-15 arrows in a finite selected primitive corner. -/
structure Figure15LocalAmbientDiagram (rank : ℕ) (r : Fin rank ↪ ι) where
  object : LargeIndecomposable.CriticalSingularFigure15.Vertex →
    (LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.splitBasic
      S r).ProjectiveCategory
  arrow : ∀ {a b : LargeIndecomposable.CriticalSingularFigure15.Vertex},
    (a ⟶ b) → (object a ⟶ object b)

namespace Figure15LocalAmbientDiagram

/-- The threefold composite displayed as zero in Figure 15, before taking the
local quotient. -/
def mainComposite {rank : ℕ} {r : Fin rank ↪ ι}
    (G : Figure15LocalAmbientDiagram S rank r) :
    G.object .leftEndpoint ⟶ G.object .rightEndpoint :=
  G.arrow LargeIndecomposable.CriticalSingularFigure15.Arrow.alphaLeft ≫
    G.arrow LargeIndecomposable.CriticalSingularFigure15.Arrow.delta ≫
      G.arrow LargeIndecomposable.CriticalSingularFigure15.Arrow.alphaRight

end Figure15LocalAmbientDiagram

/-- A Figure-15 configuration in a finite selected primitive corner, together
with a local radical quotient killing its displayed threefold composite. -/
structure Figure15LocalQuotientCandidate where
  rank : ℕ
  r : Fin rank ↪ ι
  I : TwoSidedIdeal (S.SelectedCorner r)
  le_jacobson : I.asIdeal ≤ Ring.jacobson (S.SelectedCorner r)
  ambient : Figure15LocalAmbientDiagram S rank r
  main_mem : ambient.mainComposite.1 ∈ I.asIdeal

namespace Figure15LocalQuotientCandidate

/-- The chosen split-basic presentation of the candidate's selected corner. -/
abbrev cornerSplitBasic (G : Figure15LocalQuotientCandidate S) :=
  LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.splitBasic S G.r

/-- The local quotient functor supplies the literal Figure-15 bound relation
from membership of the ambient threefold composite in the corner ideal. -/
def quotientDiagram (G : Figure15LocalQuotientCandidate S) :
    LargeIndecomposable.CriticalSingularFigure15.DiagramData
      (C := ((cornerSplitBasic S G).quotient_of_le_jacobson
        G.I G.le_jacobson).ProjectiveCategory) where
  object a :=
    ((cornerSplitBasic S G).projectiveQuotientFunctor
      G.I G.le_jacobson).obj (G.ambient.object a)
  arrow e :=
    ((cornerSplitBasic S G).projectiveQuotientFunctor
      G.I G.le_jacobson).map (G.ambient.arrow e)
  main_zero := by
    let Q := (cornerSplitBasic S G).projectiveQuotientFunctor
      G.I G.le_jacobson
    have hzero : Q.map G.ambient.mainComposite = 0 :=
      ((cornerSplitBasic S G).projectiveQuotientFunctor_map_eq_zero_iff
        G.I G.le_jacobson G.ambient.mainComposite).2 G.main_mem
    simpa only [Figure15LocalAmbientDiagram.mainComposite,
      Functor.map_comp] using hzero

/-- Exact residual cleavage assertion for a local Figure-15 quotient. -/
def IsCleaving (G : Figure15LocalQuotientCandidate S) : Prop :=
  Nonempty (HomBifunctorRetraction (k := k)
    (G.quotientDiagram.functor (k := k)))

end Figure15LocalQuotientCandidate

/-- Source-faithful local-quotient extraction boundary for the BGRS 4.3
Figures 14 and 15. -/
def HasCriticalLongPathLocalQuotientFigureExtraction
    [HasWellDefinedBGRSRayProduct S.ProjectiveCategory] : Prop :=
  ∀ {i j : RayVertex (BGRSRayCategory S.ProjectiveCategory)}
      (p : Quiver.Path i j),
    IsCriticalBGRSLiftSingularPath p → 3 ≤ p.length →
      (∃ G : Figure14LocalQuotientCandidate S, G.IsCleaving) ∨
        (∃ G : Figure15LocalQuotientCandidate S, G.IsCleaving)

/-- A cleaving Figure-14 diagram in a quotient of a selected primitive corner
contradicts representation-finiteness of the original algebra. -/
theorem not_isRepresentationFinite_of_figure14LocalQuotient
    [Infinite k] (G : Figure14LocalQuotientCandidate S)
    (hG : G.IsCleaving) :
    ¬LargeIndecomposable.IsRepresentationFinite k A := by
  intro hfinite
  rcases hG with ⟨hcleaving⟩
  have hcorner :=
    LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.isRepresentationFinite
      S G.r hfinite
  have hquotient := hcorner.quotient G.I
  letI : Module.Finite k (S.SelectedCorner G.r ⧸ G.I.asIdeal) :=
    Module.Finite.quotient k G.I.asIdeal
  exact
    (LargeIndecomposable.CriticalSingularFigure14.not_isRepresentationFinite_of_figure14Data
      ((LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.splitBasic
        S G.r).quotient_of_le_jacobson G.I G.le_jacobson)
      G.quotientDiagram hcleaving) hquotient

/-- Figure-15 local selected-corner quotient counterpart. -/
theorem not_isRepresentationFinite_of_figure15LocalQuotient
    [Infinite k] (G : Figure15LocalQuotientCandidate S)
    (hG : G.IsCleaving) :
    ¬LargeIndecomposable.IsRepresentationFinite k A := by
  intro hfinite
  rcases hG with ⟨hcleaving⟩
  have hcorner :=
    LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.isRepresentationFinite
      S G.r hfinite
  have hquotient := hcorner.quotient G.I
  letI : Module.Finite k (S.SelectedCorner G.r ⧸ G.I.asIdeal) :=
    Module.Finite.quotient k G.I.asIdeal
  exact
    (LargeIndecomposable.CriticalSingularFigure15.not_isRepresentationFinite_of_figure15Data
      ((LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.splitBasic
        S G.r).quotient_of_le_jacobson G.I G.le_jacobson)
      G.quotientDiagram hcleaving) hquotient

/-- Mild version: a cleaving Figure-14 diagram in a quotient of a selected
corner by a nonzero ideal contradicts mildness. -/
theorem false_of_figure14LocalQuotient_mild
    [Infinite k] (G : Figure14LocalQuotientCandidate S)
    (hG : G.IsCleaving) (hmild : LargeIndecomposable.MildAlg k A) (hI : G.I ≠ ⊥) : False := by
  rcases hG with ⟨hcleaving⟩
  have hquotient := LargeIndecomposable.isRepresentationFinite_corner_quotient
    (S.selectedIdempotent_isIdempotentElem G.r) hmild G.I hI
  letI : Module.Finite k (S.SelectedCorner G.r ⧸ G.I.asIdeal) :=
    Module.Finite.quotient k G.I.asIdeal
  exact
    (LargeIndecomposable.CriticalSingularFigure14.not_isRepresentationFinite_of_figure14Data
      ((LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.splitBasic
        S G.r).quotient_of_le_jacobson G.I G.le_jacobson)
      G.quotientDiagram hcleaving) hquotient

/-- Mild version: a cleaving Figure-15 diagram in a quotient of a selected
corner by a nonzero ideal contradicts mildness. -/
theorem false_of_figure15LocalQuotient_mild
    [Infinite k] (G : Figure15LocalQuotientCandidate S)
    (hG : G.IsCleaving) (hmild : LargeIndecomposable.MildAlg k A) (hI : G.I ≠ ⊥) : False := by
  rcases hG with ⟨hcleaving⟩
  have hquotient := LargeIndecomposable.isRepresentationFinite_corner_quotient
    (S.selectedIdempotent_isIdempotentElem G.r) hmild G.I hI
  letI : Module.Finite k (S.SelectedCorner G.r ⧸ G.I.asIdeal) :=
    Module.Finite.quotient k G.I.asIdeal
  exact
    (LargeIndecomposable.CriticalSingularFigure15.not_isRepresentationFinite_of_figure15Data
      ((LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.splitBasic
        S G.r).quotient_of_le_jacobson G.I G.le_jacobson)
      G.quotientDiagram hcleaving) hquotient

/-- Local selected-corner Figure extraction excludes critical singular paths
of length at least three. -/
theorem no_long_critical_of_localQuotientFigureExtraction
    [Infinite k]
    [HasWellDefinedBGRSRayProduct S.ProjectiveCategory]
    (hextract : HasCriticalLongPathLocalQuotientFigureExtraction S)
    (hfinite : LargeIndecomposable.IsRepresentationFinite k A) :
    ∀ {i j : RayVertex (BGRSRayCategory S.ProjectiveCategory)}
      (p : Quiver.Path i j),
      IsCriticalBGRSLiftSingularPath p → ¬3 ≤ p.length := by
  intro i j p hp hlength
  rcases hextract p hp hlength with h14 | h15
  · rcases h14 with ⟨G, hG⟩
    exact (not_isRepresentationFinite_of_figure14LocalQuotient S G hG)
      hfinite
  · rcases h15 with ⟨G, hG⟩
    exact (not_isRepresentationFinite_of_figure15LocalQuotient S G hG)
      hfinite

/-- The local selected-corner quotient boundary supplies the singular-pair
factorization required by the normalized-lift construction. -/
theorem hasBGRSSingularPairFactorization_of_localQuotientFigureExtraction
    [Infinite k]
    [HasWellDefinedBGRSRayProduct S.ProjectiveCategory]
    [IsFiniteRayCategory (BGRSRayCategory S.ProjectiveCategory)]
    (hextract : HasCriticalLongPathLocalQuotientFigureExtraction S)
    (hfinite : LargeIndecomposable.IsRepresentationFinite k A) :
    HasBGRSSingularPairFactorization S.ProjectiveCategory := by
  apply hasBGRSSingularPairFactorization_of_no_long_critical
  exact no_long_critical_of_localQuotientFigureExtraction S hextract hfinite

end LargeIndecomposable.CriticalSingularLocalQuotientExtraction
