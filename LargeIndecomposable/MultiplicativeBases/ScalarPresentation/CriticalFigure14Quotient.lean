      (k := k) spine.leftInner.obj.as)
    (lambda : spine.leftInner.obj.as ⟶ spine.rightInner.obj.as)
    (hfactor : P.tau.asHom =
      lambda ≫ spine.lift.pathMap spine.middle) :
    (selectedMiddle S spine ≫ selectedLambda S spine lambda ≫
        selectedMiddle S spine).1 ∉
      (selectedRelationIdeal S spine P
        (spine.middleCompReverseRadicalPowerParameter
          S hfinite P lambda hfactor)).asIdeal := by
  let Q := spine.middleCompReverseRadicalPowerParameter
    S hfinite P lambda hfactor
  intro hmem
  apply factorBranch_threefold_not_mem_relationIdeal
    S hfinite spine P lambda hfactor
  have hval := val_mem_relationIdeal_of_mem_selectedRelationIdeal
    S spine P Q hmem
  change ((selectedMiddle S spine).1.1 *
      (selectedLambda S spine lambda).1.1 *
        (selectedMiddle S spine).1.1) ∈
      (relationIdeal S spine P Q).asIdeal at hval
  dsimp only [Q] at hval ⊢
  simpa only [comp_val,
    LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.finsetProjectiveHom_val_val]
    using hval

