/-- Elementwise form of the local-to-global ideal containment. -/
theorem val_mem_relationIdeal_of_mem_selectedRelationIdeal
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (P : OrientedRadicalPowerParameter
      (k := k) spine.leftInner.obj.as)
    (Q : OrientedRadicalPowerParameter
      (k := k) spine.rightInner.obj.as)
    {z : selectedCorner S spine}
    (hz : z ∈ (selectedRelationIdeal S spine P Q).asIdeal) :
    z.1 ∈ (relationIdeal S spine P Q).asIdeal := by
  have hz' := selectedRelationIdeal_le_comap_relationIdeal
    S spine P Q hz
  exact (TwoSidedIdeal.mem_comap
    (LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.valNonUnitalRingHom
      S (selectedEmbedding S spine))).1 hz'

