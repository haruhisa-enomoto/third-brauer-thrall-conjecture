          (spine.middleCompReverseRadicalPowerParameter
            S hfinite P lambda hfactor))
        (selectedLast S spine ≫ selectedMiddle S spine)).1 hzero)

/-- Every raw Figure-14 source path survives in the exact selected-corner
quotient in the first factor branch of BGRS 4.3(b). -/
theorem factorBranch_localQuotientDiagram_functor_map_pathHom_ne_zero
    (hfinite : LargeIndecomposable.MildAlg k A)
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (P : OrientedRadicalPowerParameter
      (k := k) spine.leftInner.obj.as)
    (lambda : spine.leftInner.obj.as ⟶ spine.rightInner.obj.as)
    (hfactor : P.tau.asHom =
      lambda ≫ spine.lift.pathMap spine.middle)
    {X Y : LargeIndecomposable.CriticalSingularFigure14.LinearSource k}
    (r : Quiver.Path (LinearPathCategory.vertex Y)
      (LinearPathCategory.vertex X)) :
    (((localQuotientCandidate S spine P
      (spine.middleCompReverseRadicalPowerParameter
        S hfinite P lambda hfactor) lambda).quotientDiagram).functor
          (k := k)).map (LinearPathCategory.pathHom r) ≠ 0 := by
  apply LargeIndecomposable.CriticalSingularFigure14.DiagramData.functor_map_pathHom_ne_zero_of_five_composites
    ((localQuotientCandidate S spine P
      (spine.middleCompReverseRadicalPowerParameter
        S hfinite P lambda hfactor) lambda).quotientDiagram)
  ·
    apply (LargeIndecomposable.CriticalSingularLocalQuotientExtraction.Figure14LocalQuotientCandidate.quotientDiagram_alphaLeft_deltaLower_ne_zero_iff
      S (localQuotientCandidate S spine P
        (spine.middleCompReverseRadicalPowerParameter
          S hfinite P lambda hfactor) lambda)).2
    intro hmem
    change ((selectedAmbientDiagram S spine lambda).alphaLeft ≫
        (selectedAmbientDiagram S spine lambda).deltaLower).1 ∈
      (selectedRelationIdeal S spine P
        (spine.middleCompReverseRadicalPowerParameter
          S hfinite P lambda hfactor)).asIdeal at hmem
    apply factorBranch_selectedPrefix_not_mem_selectedRelationIdeal
      S hfinite spine P lambda hfactor
    have heq :
        ((selectedAmbientDiagram S spine lambda).alphaLeft ≫
          (selectedAmbientDiagram S spine lambda).deltaLower).1 =
          (selectedMiddle S spine ≫ selectedFirst S spine).1 := by
      unfold selectedAmbientDiagram
      rw [comp_val]
    rw [← heq]
    exact hmem
  · apply (LargeIndecomposable.CriticalSingularLocalQuotientExtraction.Figure14LocalQuotientCandidate.quotientDiagram_alphaLeft_lambda_ne_zero_iff
      S (localQuotientCandidate S spine P
        (spine.middleCompReverseRadicalPowerParameter
          S hfinite P lambda hfactor) lambda)).2
    intro hmem
    change ((selectedAmbientDiagram S spine lambda).alphaLeft ≫
        (selectedAmbientDiagram S spine lambda).lambda).1 ∈
      (selectedRelationIdeal S spine P
        (spine.middleCompReverseRadicalPowerParameter
          S hfinite P lambda hfactor)).asIdeal at hmem
    apply factorBranch_selectedRightTau_not_mem_selectedRelationIdeal
      S hfinite spine P lambda hfactor
    rw [← factorBranch_selected_right_cycle
      S hfinite spine P lambda hfactor]
    have heq :
        ((selectedAmbientDiagram S spine lambda).alphaLeft ≫
          (selectedAmbientDiagram S spine lambda).lambda).1 =
          (selectedMiddle S spine ≫ selectedLambda S spine lambda).1 := by
      unfold selectedAmbientDiagram
      rw [comp_val]
    rw [← heq]
    exact hmem
  · apply (LargeIndecomposable.CriticalSingularLocalQuotientExtraction.Figure14LocalQuotientCandidate.quotientDiagram_lambda_alphaRight_ne_zero_iff
      S (localQuotientCandidate S spine P
        (spine.middleCompReverseRadicalPowerParameter
          S hfinite P lambda hfactor) lambda)).2
    intro hmem
    change ((selectedAmbientDiagram S spine lambda).lambda ≫
        (selectedAmbientDiagram S spine lambda).alphaRight).1 ∈
      (selectedRelationIdeal S spine P
        (spine.middleCompReverseRadicalPowerParameter
          S hfinite P lambda hfactor)).asIdeal at hmem
    apply factorBranch_selectedLeftTau_not_mem_selectedRelationIdeal
      S hfinite spine P lambda hfactor
    rw [← factorBranch_selected_left_cycle S spine P lambda hfactor]
    have heq :
        ((selectedAmbientDiagram S spine lambda).lambda ≫
          (selectedAmbientDiagram S spine lambda).alphaRight).1 =
          (selectedLambda S spine lambda ≫ selectedMiddle S spine).1 := by
      unfold selectedAmbientDiagram
      rw [comp_val]
    rw [← heq]
    exact hmem
  · apply (LargeIndecomposable.CriticalSingularLocalQuotientExtraction.Figure14LocalQuotientCandidate.quotientDiagram_deltaUpper_alphaRight_ne_zero_iff
      S (localQuotientCandidate S spine P
        (spine.middleCompReverseRadicalPowerParameter
          S hfinite P lambda hfactor) lambda)).2
    intro hmem
    change ((selectedAmbientDiagram S spine lambda).deltaUpper ≫
        (selectedAmbientDiagram S spine lambda).alphaRight).1 ∈
      (selectedRelationIdeal S spine P
        (spine.middleCompReverseRadicalPowerParameter
          S hfinite P lambda hfactor)).asIdeal at hmem
    apply factorBranch_selectedSuffix_not_mem_selectedRelationIdeal
      S hfinite spine P lambda hfactor
    have heq :
        ((selectedAmbientDiagram S spine lambda).deltaUpper ≫
          (selectedAmbientDiagram S spine lambda).alphaRight).1 =
          (selectedLast S spine ≫ selectedMiddle S spine).1 := by
      unfold selectedAmbientDiagram
      rw [comp_val]
    rw [← heq]
    exact hmem
  · apply (LargeIndecomposable.CriticalSingularLocalQuotientExtraction.Figure14LocalQuotientCandidate.quotientDiagram_threefold_ne_zero_iff
      S (localQuotientCandidate S spine P
        (spine.middleCompReverseRadicalPowerParameter
          S hfinite P lambda hfactor) lambda)).2
    intro hmem
    change ((selectedAmbientDiagram S spine lambda).alphaLeft ≫
        (selectedAmbientDiagram S spine lambda).lambda ≫
          (selectedAmbientDiagram S spine lambda).alphaRight).1 ∈
      (selectedRelationIdeal S spine P
        (spine.middleCompReverseRadicalPowerParameter
          S hfinite P lambda hfactor)).asIdeal at hmem
    apply factorBranch_selectedThreefold_not_mem_selectedRelationIdeal
      S hfinite spine P lambda hfactor
    have heq :
        ((selectedAmbientDiagram S spine lambda).alphaLeft ≫
          (selectedAmbientDiagram S spine lambda).lambda ≫
            (selectedAmbientDiagram S spine lambda).alphaRight).1 =
          (selectedMiddle S spine ≫ selectedLambda S spine lambda ≫
            selectedMiddle S spine).1 := by
      unfold selectedAmbientDiagram
      simp only [comp_val]
    rw [← heq]
    exact hmem

end SelectedCorner

