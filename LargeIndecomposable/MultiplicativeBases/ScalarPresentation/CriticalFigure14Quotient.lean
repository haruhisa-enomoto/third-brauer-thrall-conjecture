/-- The exact local quotient kills the initial Figure-14 relation. -/
theorem selectedQuotientFunctor_map_initial_relation_eq_zero
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
