/-- The left central path in the selected corner is the lifted parameter
`sigma`. -/
theorem factorBranch_selected_left_cycle
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (P : OrientedRadicalPowerParameter
      (k := k) spine.leftInner.obj.as)
    (lambda : spine.leftInner.obj.as ⟶ spine.rightInner.obj.as)
    (hfactor : P.tau.asHom =
      lambda ≫ spine.lift.pathMap spine.middle) :
    selectedLambda S spine lambda ≫ selectedMiddle S spine =
      selectedLeftTau S spine P := by
  apply Subtype.ext
  simp only [comp_val]
  apply Subtype.ext
  change (selectedMiddle S spine).1.1 *
    (selectedLambda S spine lambda).1.1 =
      (selectedLeftTau S spine P).1.1
  rw [LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.finsetProjectiveHom_val_val,
    LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.finsetProjectiveHom_val_val,
    LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.finsetProjectiveHom_val_val]
  simpa only [comp_val] using congrArg Subtype.val hfactor.symm

/-- The right central path is the lifted opposite-cycle parameter `rho`. -/
theorem factorBranch_selected_right_cycle
    (hfinite : LargeIndecomposable.MildAlg k A)
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (P : OrientedRadicalPowerParameter
      (k := k) spine.leftInner.obj.as)
    (lambda : spine.leftInner.obj.as ⟶ spine.rightInner.obj.as)
    (hfactor : P.tau.asHom =
      lambda ≫ spine.lift.pathMap spine.middle) :
    selectedMiddle S spine ≫ selectedLambda S spine lambda =
      selectedRightTau S spine
        (spine.middleCompReverseRadicalPowerParameter
          S hfinite P lambda hfactor) := by
  apply Subtype.ext
  simp only [comp_val]
  apply Subtype.ext
  change (selectedLambda S spine lambda).1.1 *
    (selectedMiddle S spine).1.1 =
      (selectedRightTau S spine
        (spine.middleCompReverseRadicalPowerParameter
          S hfinite P lambda hfactor)).1.1
  have hQ := spine.middleCompReverseRadicalPowerParameter_tau
    S hfinite P lambda hfactor
  rw [LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.finsetProjectiveHom_val_val,
    LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.finsetProjectiveHom_val_val,
    LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.finsetProjectiveHom_val_val]
  simpa only [comp_val] using congrArg Subtype.val hQ.symm

/-- The selected lift of the unique length-three Figure-14 path is not in
the exact local relation ideal.  This follows from the stronger global
corner estimate after forgetting the selected corner. -/
theorem factorBranch_selectedThreefold_not_mem_selectedRelationIdeal
    (hfinite : LargeIndecomposable.MildAlg k A)
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
