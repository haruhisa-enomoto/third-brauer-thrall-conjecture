    (Q : OrientedRadicalPowerParameter
      (k := k) spine.rightInner.obj.as) :
    (selectedQuotientFunctor S spine P Q).map
      (selectedLeftTau S spine P ≫ selectedFirst S spine) = 0 := by
  rw [(selectedSplitBasic S spine).projectiveQuotientFunctor_map_eq_zero_iff]
  exact TwoSidedIdeal.subset_span (by simp)

