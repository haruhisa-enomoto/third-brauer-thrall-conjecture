@[expose] public section

/-!
# Global auxiliary and exact local BGRS Figure 14 quotients

In the primitive-projective (opposite) convention, the Figure-14 relation
ideal is generated by

* `sigma ≫ alpha₁`, represented by `P.tau.asHom ≫ first`, and
* `alphaₙ ≫ rho`, represented by `last ≫ Q.tau.asHom`.

The six source vertices deliberately have repeated ambient images.  The two
central cycles are `lambda ≫ delta = sigma` and
`delta ≫ lambda = rho`.

The first construction below forms the same two-generator ideal in all of
`A`.  This stronger global quotient is useful for robust cycle-survival
estimates, but BGRS 4.3(b) takes the quotient only after restricting to the
full corner on the four displayed primitive vertices.  The selected-corner
construction at the end of the file is the source-exact quotient.
-/

set_option autoImplicit false
noncomputable section

open CategoryTheory

namespace LargeIndecomposable.CriticalFigure14Quotient

open LargeIndecomposable.ClosedZigzagTransfer
open LargeIndecomposable.SplitBasicIdempotents.ProjectiveCategory

universe u v x

variable {k : Type u} [Field k] [IsAlgClosed k]
variable {A : Type v} [Ring A] [Algebra k A] [Module.Finite k A]
variable {ι : Type x} [Fintype ι] [DecidableEq ι]

variable (S : LargeIndecomposable.SplitBasicIdempotents
  (k := k) (A := A) (ι := ι))

variable [LargeIndecomposable.HasBGRSDistributiveHomStructure
  k S.ProjectiveCategory]

private theorem eq_zero_of_eq_source_jacobson_action
    {C : Type u} [Category.{v} C] [Preadditive C]
    {X Y : C} [IsArtinianRing (End X)]
    (f : X ⟶ Y) (a : End X) (ha : a ∈ Ring.jacobson (End X))
    (hfix : f = a.asHom ≫ f) : f = 0 := by
  obtain ⟨n, hnil⟩ :=
    IsArtinianRing.isNilpotent_jacobson_bot (R := End X)
  rw [Ideal.jacobson_bot] at hnil
  have haPow : a ^ n ∈ (Ring.jacobson (End X)) ^ n :=
    Ideal.pow_mem_pow ha n
  rw [hnil] at haPow
  have haNil : IsNilpotent a := ⟨n, haPow⟩
  have hu : IsUnit (1 - a) := haNil.isUnit_one_sub
  letI : IsIso ((1 - a).asHom) := (isUnit_iff_isIso _).1 hu
  have hzero : (1 - a).asHom ≫ f = 0 := by
    change ((𝟙 X) - a.asHom) ≫ f = 0
    rw [Preadditive.sub_comp, Category.id_comp]
    exact sub_eq_zero.mpr hfix
  apply (cancel_epi ((1 - a).asHom)).1
  simpa using hzero

private theorem eq_zero_of_eq_target_jacobson_action
    {C : Type u} [Category.{v} C] [Preadditive C]
    {X Y : C} [IsArtinianRing (End Y)]
    (f : X ⟶ Y) (b : End Y) (hb : b ∈ Ring.jacobson (End Y))
    (hfix : f = f ≫ b.asHom) : f = 0 := by
  obtain ⟨n, hnil⟩ :=
    IsArtinianRing.isNilpotent_jacobson_bot (R := End Y)
  rw [Ideal.jacobson_bot] at hnil
  have hbPow : b ^ n ∈ (Ring.jacobson (End Y)) ^ n :=
    Ideal.pow_mem_pow hb n
  rw [hnil] at hbPow
  have hbNil : IsNilpotent b := ⟨n, hbPow⟩
  have hu : IsUnit (1 - b) := hbNil.isUnit_one_sub
  letI : IsIso ((1 - b).asHom) := (isUnit_iff_isIso _).1 hu
  have hzero : f ≫ (1 - b).asHom = 0 := by
    change f ≫ ((𝟙 Y) - b.asHom) = 0
    rw [Preadditive.comp_sub, Category.comp_id]
    exact sub_eq_zero.mpr hfix
  apply (cancel_mono ((1 - b).asHom)).1
  simpa using hzero

/-- The global auxiliary two-generator relation ideal corresponding to the
relations immediately before BGRS Figure 14. -/
def relationIdeal
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (P : OrientedRadicalPowerParameter
      (k := k) spine.leftInner.obj.as)
    (Q : OrientedRadicalPowerParameter
      (k := k) spine.rightInner.obj.as) :
    TwoSidedIdeal A :=
  TwoSidedIdeal.span
    ({(P.tau.asHom ≫ spine.lift.representative spine.first).1,
      (spine.lift.representative spine.last ≫ Q.tau.asHom).1} : Set A)

omit [IsAlgClosed k] in
/-- The two Figure-14 relations are products of two ambient-radical
morphisms.  Consequently their full two-sided ideal lies in `Jac(A)²`. -/
theorem relationIdeal_le_jacobson_sq
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (P : OrientedRadicalPowerParameter
      (k := k) spine.leftInner.obj.as)
    (Q : OrientedRadicalPowerParameter
      (k := k) spine.rightInner.obj.as) :
    (relationIdeal S spine P Q).asIdeal ≤ (Ring.jacobson A) ^ 2 := by
  have hP : P.tau.1 ∈ Ring.jacobson A :=
    (S.projectiveEnd_mem_jacobson_iff_val_mem_jacobson
      spine.leftInner.obj.as P.tau).1 P.mem_jacobson
  have hQ : Q.tau.1 ∈ Ring.jacobson A :=
    (S.projectiveEnd_mem_jacobson_iff_val_mem_jacobson
      spine.rightInner.obj.as Q.tau).1 Q.mem_jacobson
  have hfirst : (spine.lift.representative spine.first).1 ∈
      Ring.jacobson A :=
    S.rayArrowLift_representative_mem_jacobson spine.lift spine.first
  have hlast : (spine.lift.representative spine.last).1 ∈
      Ring.jacobson A :=
    S.rayArrowLift_representative_mem_jacobson spine.lift spine.last
  have hle : relationIdeal S spine P Q ≤
      ((Ring.jacobson A) ^ 2).toTwoSided := by
    apply TwoSidedIdeal.span_le.2
    intro a ha
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha
    rcases ha with rfl | rfl
    · apply Ideal.mem_toTwoSided.2
      rw [show (2 : ℕ) = 1 + 1 by omega,
        Ideal.IsTwoSided.pow_add, Submodule.pow_one]
      simpa only [comp_val] using Ideal.mul_mem_mul hfirst hP
    · apply Ideal.mem_toTwoSided.2
      rw [show (2 : ℕ) = 1 + 1 by omega,
        Ideal.IsTwoSided.pow_add, Submodule.pow_one]
      simpa only [comp_val] using Ideal.mul_mem_mul hQ hlast
  intro a ha
  exact Ideal.mem_toTwoSided.1 (hle ha)

omit [IsAlgClosed k] in
/-- Both Figure-14 generators are radical, so the quotient preserves the
chosen primitive vertices and remains split basic. -/
theorem relationIdeal_le_jacobson
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (P : OrientedRadicalPowerParameter
      (k := k) spine.leftInner.obj.as)
    (Q : OrientedRadicalPowerParameter
      (k := k) spine.rightInner.obj.as) :
    (relationIdeal S spine P Q).asIdeal ≤ Ring.jacobson A := by
  intro a ha
  exact Ideal.pow_le_self (by omega)
    (relationIdeal_le_jacobson_sq S spine P Q ha)

omit [IsAlgClosed k] in
/-- The initial Figure-14 relation belongs to the generated ideal. -/
theorem initial_relation_mem
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (P : OrientedRadicalPowerParameter
      (k := k) spine.leftInner.obj.as)
    (Q : OrientedRadicalPowerParameter
      (k := k) spine.rightInner.obj.as) :
    (P.tau.asHom ≫ spine.lift.representative spine.first).1 ∈
      (relationIdeal S spine P Q).asIdeal := by
  exact TwoSidedIdeal.subset_span (by simp)

omit [IsAlgClosed k] in
/-- The terminal Figure-14 relation belongs to the generated ideal. -/
theorem terminal_relation_mem
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (P : OrientedRadicalPowerParameter
      (k := k) spine.leftInner.obj.as)
    (Q : OrientedRadicalPowerParameter
      (k := k) spine.rightInner.obj.as) :
    (spine.lift.representative spine.last ≫ Q.tau.asHom).1 ∈
      (relationIdeal S spine P Q).asIdeal := by
  exact TwoSidedIdeal.subset_span (by simp)

/-- The stronger global split-basic auxiliary quotient. -/
abbrev quotientSplitBasic
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (P : OrientedRadicalPowerParameter
      (k := k) spine.leftInner.obj.as)
    (Q : OrientedRadicalPowerParameter
      (k := k) spine.rightInner.obj.as) :=
  S.quotient_of_le_jacobson (relationIdeal S spine P Q)
    (relationIdeal_le_jacobson S spine P Q)

/-- The quotient functor on primitive projectives. -/
abbrev quotientFunctor
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (P : OrientedRadicalPowerParameter
      (k := k) spine.leftInner.obj.as)
    (Q : OrientedRadicalPowerParameter
      (k := k) spine.rightInner.obj.as) :=
  S.projectiveQuotientFunctor (relationIdeal S spine P Q)
    (relationIdeal_le_jacobson S spine P Q)

/-- The repeated-object realization of the six Figure-14 vertices before
quotienting. -/
def ambientDiagram
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (lambda : spine.leftInner.obj.as ⟶ spine.rightInner.obj.as) :
    LargeIndecomposable.CriticalSingularFigure14.DiagramData
      (C := S.ProjectiveCategory) where
  c := spine.leftInner.obj.as
  d := spine.rightInner.obj.as
  b := spine.rightInner.obj.as
  cUpper := j.obj.as
  dLower := i.obj.as
  a := spine.leftInner.obj.as
  lambda := lambda
  alphaLeft := spine.lift.pathMap spine.middle
  deltaUpper := spine.lift.representative spine.last
  deltaLower := spine.lift.representative spine.first
  alphaRight := spine.lift.pathMap spine.middle

/-- The Figure-14 diagram in the stronger global auxiliary quotient. -/
def quotientDiagram
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (P : OrientedRadicalPowerParameter
      (k := k) spine.leftInner.obj.as)
    (Q : OrientedRadicalPowerParameter
      (k := k) spine.rightInner.obj.as)
    (lambda : spine.leftInner.obj.as ⟶ spine.rightInner.obj.as) :
    LargeIndecomposable.CriticalSingularFigure14.DiagramData
      (C := (quotientSplitBasic S spine P Q).ProjectiveCategory) where
  c := (quotientFunctor S spine P Q).obj spine.leftInner.obj.as
  d := (quotientFunctor S spine P Q).obj spine.rightInner.obj.as
  b := (quotientFunctor S spine P Q).obj spine.rightInner.obj.as
  cUpper := (quotientFunctor S spine P Q).obj j.obj.as
  dLower := (quotientFunctor S spine P Q).obj i.obj.as
  a := (quotientFunctor S spine P Q).obj spine.leftInner.obj.as
  lambda := (quotientFunctor S spine P Q).map lambda
  alphaLeft :=
    (quotientFunctor S spine P Q).map (spine.lift.pathMap spine.middle)
  deltaUpper :=
    (quotientFunctor S spine P Q).map
      (spine.lift.representative spine.last)
  deltaLower :=
    (quotientFunctor S spine P Q).map
      (spine.lift.representative spine.first)
  alphaRight :=
    (quotientFunctor S spine P Q).map (spine.lift.pathMap spine.middle)

omit [IsAlgClosed k] in
/-- The quotient kills the initial cross-relation. -/
theorem quotientFunctor_map_initial_relation_eq_zero
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (P : OrientedRadicalPowerParameter
      (k := k) spine.leftInner.obj.as)
    (Q : OrientedRadicalPowerParameter
      (k := k) spine.rightInner.obj.as) :
    (quotientFunctor S spine P Q).map
        (P.tau.asHom ≫ spine.lift.representative spine.first) = 0 := by
  rw [S.projectiveQuotientFunctor_map_eq_zero_iff]
  exact initial_relation_mem S spine P Q

omit [IsAlgClosed k] in
/-- The quotient kills the terminal cross-relation. -/
theorem quotientFunctor_map_terminal_relation_eq_zero
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (P : OrientedRadicalPowerParameter
      (k := k) spine.leftInner.obj.as)
    (Q : OrientedRadicalPowerParameter
      (k := k) spine.rightInner.obj.as) :
    (quotientFunctor S spine P Q).map
        (spine.lift.representative spine.last ≫ Q.tau.asHom) = 0 := by
  rw [S.projectiveQuotientFunctor_map_eq_zero_iff]
  exact terminal_relation_mem S spine P Q

/-- In the factor branch of BGRS 4.3(b), the terminal parameter is the
opposite cycle `delta ≫ lambda`; hence both Figure-14 cycles are built into
the quotient diagram from the critical-spine data alone. -/
def factorBranchQuotientDiagram
    (hfinite : LargeIndecomposable.MildAlg k A)
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (P : OrientedRadicalPowerParameter
      (k := k) spine.leftInner.obj.as)
    (lambda : spine.leftInner.obj.as ⟶ spine.rightInner.obj.as)
    (hfactor : P.tau.asHom =
      lambda ≫ spine.lift.pathMap spine.middle) :=
  quotientDiagram S spine P
    (spine.middleCompReverseRadicalPowerParameter
      S hfinite P lambda hfactor) lambda

/-- In the factor branch, the left-inner corner of the complete Figure-14
relation ideal lies in the square of the left-inner endomorphism radical.
The first generator contributes `sigma` times a radical cycle through the
initial vertex.  For the second generator, fullness and transit factor both
outer terms through `lambda` and `delta`; commutativity moves `rho` next to
`lambda`, again exposing a product of two left-inner radical elements. -/
theorem factorBranch_relationIdeal_leftInner_le_jacobson_sq
    (hfinite : LargeIndecomposable.MildAlg k A)
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (P : OrientedRadicalPowerParameter
      (k := k) spine.leftInner.obj.as)
    (lambda : spine.leftInner.obj.as ⟶ spine.rightInner.obj.as)
    (hfactor : P.tau.asHom =
      lambda ≫ spine.lift.pathMap spine.middle) :
    finiteIdealCorner S
        (relationIdeal S spine P
          (spine.middleCompReverseRadicalPowerParameter
            S hfinite P lambda hfactor))
        spine.leftInner.obj.as spine.leftInner.obj.as ≤
      ((Ring.jacobson (End spine.leftInner.obj.as)) ^ 2).restrictScalars k := by
  let delta := spine.lift.pathMap spine.middle
  let firstMap := spine.lift.representative spine.first
  let lastMap := spine.lift.representative spine.last
  let Q := spine.middleCompReverseRadicalPowerParameter
    S hfinite P lambda hfactor
  have hfactorDelta : P.tau.asHom = lambda ≫ delta := by
    simpa only [delta] using hfactor
  have hQtau : Q.tau.asHom = delta ≫ lambda := by
    dsimp only [Q, delta]
    rw [spine.middleCompReverseRadicalPowerParameter_tau
      S hfinite P lambda hfactor]
  have hfirstJ : firstMap.1 ∈ Ring.jacobson A :=
    S.rayArrowLift_representative_mem_jacobson spine.lift spine.first
  have hdeltaJ : delta.1 ∈ Ring.jacobson A :=
    S.rayArrowLift_pathMap_mem_jacobson spine.lift spine.middle
      spine.middle_length_pos
  have hlambdaSpan :
      LargeIndecomposable.twoSidedEndomorphismSpan k lambda = ⊤ :=
    spine.reverse_full_span_of_sigma_eq_reverse_comp_middle
      S hfinite P lambda hfactor
  have hlambdaT : LargeIndecomposable.AllowsTransit lambda :=
    spine.reverse_allowsTransit_of_sigma_eq_reverse_comp_middle
      S P lambda hfactor
  have hdeltaSpan :
      LargeIndecomposable.twoSidedEndomorphismSpan k delta = ⊤ := by
    simpa only [delta] using spine.middle_full_span S hfinite
  have hdeltaT : LargeIndecomposable.AllowsTransit delta := by
    exact (spine.middle_allowsBitransit S hfinite).1
  rw [relationIdeal, finiteIdealCorner_span_pair_eq]
  apply sup_le
  · apply Submodule.span_le.2
    rintro h ⟨a, b, rfl⟩
    let c : End spine.leftInner.obj.as := End.of (firstMap ≫ b)
    have hcJ : c ∈ Ring.jacobson (End spine.leftInner.obj.as) := by
      rw [S.projectiveEnd_mem_jacobson_iff_val_mem_jacobson]
      change (firstMap ≫ b).1 ∈ Ring.jacobson A
      simp only [comp_val]
      exact (Ring.jacobson A).mul_mem_left b.1 hfirstJ
    have hcP : c * P.tau ∈
        (Ring.jacobson (End spine.leftInner.obj.as)) ^ 2 := by
      rw [show (2 : ℕ) = 1 + 1 by omega,
        Ideal.IsTwoSided.pow_add, Submodule.pow_one]
      exact Ideal.mul_mem_mul hcJ P.mem_jacobson
    have hprod : (c * P.tau) * End.of a ∈
        (Ring.jacobson (End spine.leftInner.obj.as)) ^ 2 :=
      (Ring.jacobson (End spine.leftInner.obj.as) ^ 2).mul_mem_right
        (End.of a) hcP
    change End.of ((a ≫ (P.tau.asHom ≫ firstMap)) ≫ b) ∈
      (Ring.jacobson (End spine.leftInner.obj.as)) ^ 2
    rw [show End.of ((a ≫ (P.tau.asHom ≫ firstMap)) ≫ b) =
        (c * P.tau) * End.of a by
      apply End.ext
      simp only [c, End.mul_def, Category.assoc]]
    exact hprod
  · apply Submodule.span_le.2
    rintro h ⟨a, b, rfl⟩
    have hxmem : a ≫ lastMap ∈
        LargeIndecomposable.twoSidedEndomorphismSpan k lambda := by
      rw [hlambdaSpan]
      exact Submodule.mem_top
    obtain ⟨eR, hx⟩ :=
      LargeIndecomposable.exists_comp_of_mem_span_of_allowsTransit
        hlambdaT hxmem
    have hbmem : b ∈
        LargeIndecomposable.twoSidedEndomorphismSpan k delta := by
      rw [hdeltaSpan]
      exact Submodule.mem_top
    obtain ⟨eL, hb⟩ :=
      LargeIndecomposable.exists_comp_of_mem_span_of_allowsTransit
        hdeltaT hbmem
    let c : End spine.leftInner.obj.as :=
      End.of (lambda ≫ eR.asHom ≫ delta)
    have hcJ : c ∈ Ring.jacobson (End spine.leftInner.obj.as) := by
      rw [S.projectiveEnd_mem_jacobson_iff_val_mem_jacobson]
      change (lambda ≫ eR.asHom ≫ delta).1 ∈ Ring.jacobson A
      simp only [comp_val]
      exact (Ring.jacobson A).mul_mem_right lambda.1
        ((Ring.jacobson A).mul_mem_right eR.1 hdeltaJ)
    have hcP : c * P.tau ∈
        (Ring.jacobson (End spine.leftInner.obj.as)) ^ 2 := by
      rw [show (2 : ℕ) = 1 + 1 by omega,
        Ideal.IsTwoSided.pow_add, Submodule.pow_one]
      exact Ideal.mul_mem_mul hcJ P.mem_jacobson
    have hprod : eL * (c * P.tau) ∈
        (Ring.jacobson (End spine.leftInner.obj.as)) ^ 2 :=
      (Ring.jacobson (End spine.leftInner.obj.as) ^ 2).mul_mem_left
        eL hcP
    have hcomm : eR * Q.tau = Q.tau * eR :=
      LargeIndecomposable.SplitBasicIdempotents.ProjectiveCategory.end_mul_comm
        S spine.rightInner.obj.as eR Q.tau
    change End.of ((a ≫ (lastMap ≫ Q.tau.asHom)) ≫ b) ∈
      (Ring.jacobson (End spine.leftInner.obj.as)) ^ 2
    rw [show End.of ((a ≫ (lastMap ≫ Q.tau.asHom)) ≫ b) =
        eL * (c * P.tau) by
      apply End.ext
      change (a ≫ (lastMap ≫ Q.tau.asHom)) ≫ b =
        (eL * (c * P.tau)).asHom
      rw [show a ≫ (lastMap ≫ Q.tau.asHom) =
          (a ≫ lastMap) ≫ Q.tau.asHom by simp only [Category.assoc]]
      rw [hx, hb]
      have hcommHom : eR.asHom ≫ Q.tau.asHom =
          Q.tau.asHom ≫ eR.asHom := by
        simpa only [End.mul_def] using congrArg End.asHom hcomm.symm
      rw [Category.assoc lambda, hcommHom]
      rw [hQtau]
      simp only [c, End.mul_def, Category.assoc, hfactorDelta]]
    exact hprod

/-- The source-dual right-inner corner estimate.  The initial relation
acquires a second right-inner radical factor after factoring its outer term
through `delta`; the terminal relation already contains `rho` multiplied by
the radical cycle through the terminal vertex. -/
theorem factorBranch_relationIdeal_rightInner_le_jacobson_sq
    (hfinite : LargeIndecomposable.MildAlg k A)
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (P : OrientedRadicalPowerParameter
      (k := k) spine.leftInner.obj.as)
    (lambda : spine.leftInner.obj.as ⟶ spine.rightInner.obj.as)
    (hfactor : P.tau.asHom =
      lambda ≫ spine.lift.pathMap spine.middle) :
    finiteIdealCorner S
        (relationIdeal S spine P
          (spine.middleCompReverseRadicalPowerParameter
            S hfinite P lambda hfactor))
        spine.rightInner.obj.as spine.rightInner.obj.as ≤
      ((Ring.jacobson (End spine.rightInner.obj.as)) ^ 2).restrictScalars k := by
  let delta := spine.lift.pathMap spine.middle
  let firstMap := spine.lift.representative spine.first
  let lastMap := spine.lift.representative spine.last
  let Q := spine.middleCompReverseRadicalPowerParameter
    S hfinite P lambda hfactor
  have hfactorDelta : P.tau.asHom = lambda ≫ delta := by
    simpa only [delta] using hfactor
  have hQtau : Q.tau.asHom = delta ≫ lambda := by
    dsimp only [Q, delta]
    rw [spine.middleCompReverseRadicalPowerParameter_tau
      S hfinite P lambda hfactor]
  have hfirstJ : firstMap.1 ∈ Ring.jacobson A :=
    S.rayArrowLift_representative_mem_jacobson spine.lift spine.first
  have hlastJ : lastMap.1 ∈ Ring.jacobson A :=
    S.rayArrowLift_representative_mem_jacobson spine.lift spine.last
  have hdeltaSpan :
      LargeIndecomposable.twoSidedEndomorphismSpan k delta = ⊤ := by
    simpa only [delta] using spine.middle_full_span S hfinite
  have hdeltaT : LargeIndecomposable.AllowsTransit delta :=
    (spine.middle_allowsBitransit S hfinite).1
  rw [relationIdeal, finiteIdealCorner_span_pair_eq]
  apply sup_le
  · apply Submodule.span_le.2
    rintro h ⟨a, b, rfl⟩
    have hamem : a ∈
        LargeIndecomposable.twoSidedEndomorphismSpan k delta := by
      rw [hdeltaSpan]
      exact Submodule.mem_top
    obtain ⟨eL, ha⟩ :=
      LargeIndecomposable.exists_comp_of_mem_span_of_allowsTransit
        hdeltaT hamem
    let c : End spine.rightInner.obj.as :=
      End.of (delta ≫ eL.asHom ≫ firstMap ≫ b)
    have hcJ : c ∈ Ring.jacobson (End spine.rightInner.obj.as) := by
      rw [S.projectiveEnd_mem_jacobson_iff_val_mem_jacobson]
      change (delta ≫ eL.asHom ≫ firstMap ≫ b).1 ∈ Ring.jacobson A
      simp only [comp_val]
      exact (Ring.jacobson A).mul_mem_right delta.1
        ((Ring.jacobson A).mul_mem_right eL.1
          ((Ring.jacobson A).mul_mem_left b.1 hfirstJ))
    have hcQ : c * Q.tau ∈
        (Ring.jacobson (End spine.rightInner.obj.as)) ^ 2 := by
      rw [show (2 : ℕ) = 1 + 1 by omega,
        Ideal.IsTwoSided.pow_add, Submodule.pow_one]
      exact Ideal.mul_mem_mul hcJ Q.mem_jacobson
    have hcomm : eL * P.tau = P.tau * eL :=
      LargeIndecomposable.SplitBasicIdempotents.ProjectiveCategory.end_mul_comm
        S spine.leftInner.obj.as eL P.tau
    have hcommHom : eL.asHom ≫ P.tau.asHom =
        P.tau.asHom ≫ eL.asHom := by
      simpa only [End.mul_def] using congrArg End.asHom hcomm.symm
    change End.of ((a ≫ (P.tau.asHom ≫ firstMap)) ≫ b) ∈
      (Ring.jacobson (End spine.rightInner.obj.as)) ^ 2
    rw [show End.of ((a ≫ (P.tau.asHom ≫ firstMap)) ≫ b) =
        c * Q.tau by
      apply End.ext
      change (a ≫ (P.tau.asHom ≫ firstMap)) ≫ b =
        (c * Q.tau).asHom
      rw [show a ≫ (P.tau.asHom ≫ firstMap) =
          (a ≫ P.tau.asHom) ≫ firstMap by simp only [Category.assoc]]
      rw [ha]
      rw [Category.assoc delta, hcommHom]
      simp only [c, End.mul_def, Category.assoc, hfactorDelta, hQtau]]
    exact hcQ
  · apply Submodule.span_le.2
    rintro h ⟨a, b, rfl⟩
    let c : End spine.rightInner.obj.as := End.of (a ≫ lastMap)
    have hcJ : c ∈ Ring.jacobson (End spine.rightInner.obj.as) := by
      rw [S.projectiveEnd_mem_jacobson_iff_val_mem_jacobson]
      change (a ≫ lastMap).1 ∈ Ring.jacobson A
      simp only [comp_val]
      exact (Ring.jacobson A).mul_mem_right a.1 hlastJ
    have hQc : Q.tau * c ∈
        (Ring.jacobson (End spine.rightInner.obj.as)) ^ 2 := by
      rw [show (2 : ℕ) = 1 + 1 by omega,
        Ideal.IsTwoSided.pow_add, Submodule.pow_one]
      exact Ideal.mul_mem_mul Q.mem_jacobson hcJ
    have hprod : End.of b * (Q.tau * c) ∈
        (Ring.jacobson (End spine.rightInner.obj.as)) ^ 2 :=
      (Ring.jacobson (End spine.rightInner.obj.as) ^ 2).mul_mem_left
        (End.of b) hQc
    change End.of ((a ≫ (lastMap ≫ Q.tau.asHom)) ≫ b) ∈
      (Ring.jacobson (End spine.rightInner.obj.as)) ^ 2
    rw [show End.of ((a ≫ (lastMap ≫ Q.tau.asHom)) ≫ b) =
        End.of b * (Q.tau * c) by
      apply End.ext
      simp only [c, End.mul_def, Category.assoc]]
    exact hprod

/-- The left central cycle `sigma` survives the complete two-generator
Figure-14 quotient. -/
theorem factorBranch_left_cycle_not_mem_relationIdeal
    (hfinite : LargeIndecomposable.MildAlg k A)
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (P : OrientedRadicalPowerParameter
      (k := k) spine.leftInner.obj.as)
    (lambda : spine.leftInner.obj.as ⟶ spine.rightInner.obj.as)
    (hfactor : P.tau.asHom =
      lambda ≫ spine.lift.pathMap spine.middle) :
    P.tau.1 ∉
      (relationIdeal S spine P
        (spine.middleCompReverseRadicalPowerParameter
          S hfinite P lambda hfactor)).asIdeal := by
  intro hmem
  apply P.tau_not_mem_jacobson_sq
  exact factorBranch_relationIdeal_leftInner_le_jacobson_sq
    S hfinite spine P lambda hfactor hmem

/-- The right central cycle `rho = delta lambda` likewise survives. -/
theorem factorBranch_right_cycle_not_mem_relationIdeal
    (hfinite : LargeIndecomposable.MildAlg k A)
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (P : OrientedRadicalPowerParameter
      (k := k) spine.leftInner.obj.as)
    (lambda : spine.leftInner.obj.as ⟶ spine.rightInner.obj.as)
    (hfactor : P.tau.asHom =
      lambda ≫ spine.lift.pathMap spine.middle) :
    (spine.middleCompReverseRadicalPowerParameter
        S hfinite P lambda hfactor).tau.1 ∉
      (relationIdeal S spine P
        (spine.middleCompReverseRadicalPowerParameter
          S hfinite P lambda hfactor)).asIdeal := by
  let Q := spine.middleCompReverseRadicalPowerParameter
    S hfinite P lambda hfactor
  intro hmem
  apply Q.tau_not_mem_jacobson_sq
  exact factorBranch_relationIdeal_rightInner_le_jacobson_sq
    S hfinite spine P lambda hfactor hmem

/-- The unique length-three Figure-14 path survives even in the stronger
global auxiliary quotient.  In its `rightInner`-to-`leftInner` corner, every
contribution from the initial relation is a right-radical multiple of the
threefold path.  Every contribution from the terminal relation is first a
left-radical multiple; transit across the nonzero threefold path moves this
to another right-radical multiple.  Membership would therefore fix the path
under a nilpotent endomorphism. -/
theorem factorBranch_threefold_not_mem_relationIdeal
    (hfinite : LargeIndecomposable.MildAlg k A)
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (P : OrientedRadicalPowerParameter
      (k := k) spine.leftInner.obj.as)
    (lambda : spine.leftInner.obj.as ⟶ spine.rightInner.obj.as)
    (hfactor : P.tau.asHom =
      lambda ≫ spine.lift.pathMap spine.middle) :
    (spine.lift.pathMap spine.middle ≫ lambda ≫
        spine.lift.pathMap spine.middle).1 ∉
      (relationIdeal S spine P
        (spine.middleCompReverseRadicalPowerParameter
          S hfinite P lambda hfactor)).asIdeal := by
  let delta := spine.lift.pathMap spine.middle
  let firstMap := spine.lift.representative spine.first
  let lastMap := spine.lift.representative spine.last
  let Q := spine.middleCompReverseRadicalPowerParameter
    S hfinite P lambda hfactor
  let t : spine.rightInner.obj.as ⟶ spine.leftInner.obj.as :=
    delta ≫ lambda ≫ delta
  let postAction : End spine.leftInner.obj.as →ₗ[k]
      (spine.rightInner.obj.as ⟶ spine.leftInner.obj.as) :=
    { toFun := fun c ↦ t ≫ c.asHom
      map_add' := by
        intro a b
        change t ≫ (a.asHom + b.asHom) = _
        rw [Preadditive.comp_add]
      map_smul' := by
        intro c a
        change t ≫ (c • a.asHom) = c • (t ≫ a.asHom)
        rw [Linear.comp_smul] }
  let rightRadicalAction : Submodule k
      (spine.rightInner.obj.as ⟶ spine.leftInner.obj.as) :=
    ((Ring.jacobson (End spine.leftInner.obj.as)).restrictScalars k).map
      postAction
  have hQtau : Q.tau.asHom = delta ≫ lambda := by
    dsimp only [Q, delta]
    rw [spine.middleCompReverseRadicalPowerParameter_tau
      S hfinite P lambda hfactor]
  have hdeltaSpan :
      LargeIndecomposable.twoSidedEndomorphismSpan k delta = ⊤ := by
    simpa only [delta] using spine.middle_full_span S hfinite
  have hdeltaT : LargeIndecomposable.AllowsTransit delta :=
    (spine.middle_allowsBitransit S hfinite).1
  have hdeltaC : LargeIndecomposable.AllowsCotransit delta :=
    (spine.middle_allowsBitransit S hfinite).2
  have hlambdaT : LargeIndecomposable.AllowsTransit lambda :=
    spine.reverse_allowsTransit_of_sigma_eq_reverse_comp_middle
      S P lambda hfactor
  have htT : LargeIndecomposable.AllowsTransit t := by
    simpa only [t, Category.assoc] using
      (hdeltaT.comp hlambdaT).comp hdeltaT
  have hfirstJ : firstMap.1 ∈ Ring.jacobson A :=
    S.rayArrowLift_representative_mem_jacobson spine.lift spine.first
  have hlastJ : lastMap.1 ∈ Ring.jacobson A :=
    S.rayArrowLift_representative_mem_jacobson spine.lift spine.last
  have hthree : t ≠ 0 := by
    intro ht
    apply spine.initial_parameter_sandwich_ne_zero S hfinite P
    have hsuffix :
        spine.lift.pathMap (spine.middle.comp spine.last.toPath) =
          lastMap ≫ delta := by
      simp only [lastMap, delta, BGRSRayArrowLift.pathMap,
        LinearPathCategory.pathMap_comp, Quiver.Hom.toPath,
        LinearPathCategory.pathMap_cons,
        LinearPathCategory.pathMap_nil, Category.comp_id]
    rw [hsuffix, hfactor]
    calc
      ((lastMap ≫ delta) ≫ (lambda ≫ delta)) ≫ firstMap =
          lastMap ≫ t ≫ firstMap := by
            simp only [t, Category.assoc]
      _ = 0 := by rw [ht]; simp
  have hcornerLe :
      finiteIdealCorner S
          (relationIdeal S spine P Q)
          spine.rightInner.obj.as spine.leftInner.obj.as ≤
        rightRadicalAction := by
    rw [relationIdeal, finiteIdealCorner_span_pair_eq]
    apply sup_le
    · apply Submodule.span_le.2
      rintro h ⟨a, b, rfl⟩
      have hamem : a ∈
          LargeIndecomposable.twoSidedEndomorphismSpan k delta := by
        rw [hdeltaSpan]
        exact Submodule.mem_top
      obtain ⟨e, ha⟩ :=
        LargeIndecomposable.exists_comp_of_mem_span_of_allowsTransit
          hdeltaT hamem
      let c : End spine.leftInner.obj.as :=
        End.of (e.asHom ≫ firstMap ≫ b)
      have hcJ : c ∈ Ring.jacobson (End spine.leftInner.obj.as) := by
        rw [S.projectiveEnd_mem_jacobson_iff_val_mem_jacobson]
        change (e.asHom ≫ firstMap ≫ b).1 ∈ Ring.jacobson A
        simp only [comp_val]
        exact (Ring.jacobson A).mul_mem_right e.1
          ((Ring.jacobson A).mul_mem_left b.1 hfirstJ)
      apply Submodule.mem_map.2
      refine ⟨c, hcJ, ?_⟩
      have hcomm : e * P.tau = P.tau * e :=
        LargeIndecomposable.SplitBasicIdempotents.ProjectiveCategory.end_mul_comm
          S spine.leftInner.obj.as e P.tau
      have hcommHom : e.asHom ≫ P.tau.asHom =
          P.tau.asHom ≫ e.asHom := by
        simpa only [End.mul_def] using congrArg End.asHom hcomm.symm
      change t ≫ c.asHom =
        (a ≫ (P.tau.asHom ≫ firstMap)) ≫ b
      rw [ha]
      calc
        t ≫ c.asHom =
            (delta ≫ P.tau.asHom) ≫
              (e.asHom ≫ firstMap ≫ b) := by
                rw [hfactor]
        _ = ((delta ≫ e.asHom) ≫
              (P.tau.asHom ≫ firstMap)) ≫ b := by
                calc
                  (delta ≫ P.tau.asHom) ≫
                        (e.asHom ≫ firstMap ≫ b) =
                      (delta ≫ (P.tau.asHom ≫ e.asHom) ≫
                        firstMap) ≫ b := by
                          simp only [Category.assoc]
                  _ = (delta ≫ (e.asHom ≫ P.tau.asHom) ≫
                        firstMap) ≫ b := by rw [hcommHom]
                  _ = ((delta ≫ e.asHom) ≫
                        (P.tau.asHom ≫ firstMap)) ≫ b := by
                          simp only [Category.assoc]
    · apply Submodule.span_le.2
      rintro h ⟨a, b, rfl⟩
      have hbmem : b ∈
          LargeIndecomposable.twoSidedEndomorphismSpan k delta := by
        rw [hdeltaSpan]
        exact Submodule.mem_top
      obtain ⟨e, hb⟩ :=
        LargeIndecomposable.exists_comp_of_mem_span_of_allowsCotransit
          hdeltaC hbmem
      let c : End spine.rightInner.obj.as := End.of (a ≫ lastMap)
      have hcJ : c ∈ Ring.jacobson (End spine.rightInner.obj.as) := by
        rw [S.projectiveEnd_mem_jacobson_iff_val_mem_jacobson]
        change (a ≫ lastMap).1 ∈ Ring.jacobson A
        simp only [comp_val]
        exact (Ring.jacobson A).mul_mem_right a.1 hlastJ
      let d : End spine.rightInner.obj.as := e * c
      have hdJ : d ∈ Ring.jacobson (End spine.rightInner.obj.as) :=
        (Ring.jacobson (End spine.rightInner.obj.as)).mul_mem_left e hcJ
      obtain ⟨q, hdq⟩ := htT d
      have hdNotUnit : ¬ IsUnit d :=
        (LargeIndecomposable.mem_ringJacobson_iff_not_isUnit
          (End spine.rightInner.obj.as) d).1 hdJ
      have hqNotUnit : ¬ IsUnit q :=
        LargeIndecomposable.not_isUnit_right_of_transfer
          hthree d q hdNotUnit hdq
      have hqJ : q ∈ Ring.jacobson (End spine.leftInner.obj.as) :=
        (LargeIndecomposable.mem_ringJacobson_iff_not_isUnit
          (End spine.leftInner.obj.as) q).2 hqNotUnit
      have hcomm : e * Q.tau = Q.tau * e :=
        LargeIndecomposable.SplitBasicIdempotents.ProjectiveCategory.end_mul_comm
          S spine.rightInner.obj.as e Q.tau
      have hcommHom : e.asHom ≫ Q.tau.asHom =
          Q.tau.asHom ≫ e.asHom := by
        simpa only [End.mul_def] using congrArg End.asHom hcomm.symm
      have hcontribution :
          (a ≫ (lastMap ≫ Q.tau.asHom)) ≫ b = d.asHom ≫ t := by
        rw [hb]
        calc
          (a ≫ (lastMap ≫ Q.tau.asHom)) ≫
                (e.asHom ≫ delta) =
              ((a ≫ lastMap) ≫
                (Q.tau.asHom ≫ e.asHom)) ≫ delta := by
                  simp only [Category.assoc]
          _ = ((a ≫ lastMap) ≫
                (e.asHom ≫ Q.tau.asHom)) ≫ delta := by
                  rw [hcommHom]
          _ = d.asHom ≫ t := by
                  rw [hQtau]
                  simp only [d, c, End.mul_def, t, Category.assoc]
      apply Submodule.mem_map.2
      refine ⟨q, hqJ, ?_⟩
      change t ≫ q.asHom =
        (a ≫ (lastMap ≫ Q.tau.asHom)) ≫ b
      rw [← hdq]
      exact hcontribution.symm
  intro hmem
  have htCorner : t ∈ finiteIdealCorner S
      (relationIdeal S spine P Q)
      spine.rightInner.obj.as spine.leftInner.obj.as := by
    exact hmem
  have htRad := hcornerLe htCorner
  rcases htRad with ⟨q, hqJ, hqt⟩
  have hfix : t = t ≫ q.asHom := hqt.symm
  obtain ⟨n, hnil⟩ :=
    IsArtinianRing.isNilpotent_jacobson_bot
      (R := End spine.leftInner.obj.as)
  rw [Ideal.jacobson_bot] at hnil
  have hqPow : q ^ n ∈
      (Ring.jacobson (End spine.leftInner.obj.as)) ^ n :=
    Ideal.pow_mem_pow hqJ n
  rw [hnil] at hqPow
  have hn : q ^ n = 0 := hqPow
  have hpower : ∀ m : ℕ, t = t ≫ (q ^ m).asHom := by
    intro m
    induction m with
    | zero => simp
    | succ m hm =>
        calc
          t = t ≫ (q ^ m).asHom := hm
          _ = (t ≫ q.asHom) ≫ (q ^ m).asHom := by rw [← hfix]
          _ = t ≫ (q ^ (m + 1)).asHom := by
            rw [pow_succ, End.mul_def]
            simp only [Category.assoc]
  apply hthree
  have hnHom : (q ^ n).asHom = 0 := congrArg End.asHom hn
  calc
    t = t ≫ (q ^ n).asHom := hpower n
    _ = 0 := by rw [hnHom]; exact Limits.comp_zero

/-- The outer prefix `delta ≫ first` survives even in the stronger global
auxiliary quotient.  The prefix is a full Hom generator and, because it
prohibits transit, allows cotransit.  Both relation generators therefore
contribute only source-Jacobson multiples of the prefix. -/
theorem factorBranch_prefix_not_mem_relationIdeal
    (hfinite : LargeIndecomposable.MildAlg k A)
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (P : OrientedRadicalPowerParameter
      (k := k) spine.leftInner.obj.as)
    (lambda : spine.leftInner.obj.as ⟶ spine.rightInner.obj.as)
    (hfactor : P.tau.asHom =
      lambda ≫ spine.lift.pathMap spine.middle) :
    (spine.lift.pathMap spine.middle ≫
        spine.lift.representative spine.first).1 ∉
      (relationIdeal S spine P
        (spine.middleCompReverseRadicalPowerParameter
          S hfinite P lambda hfactor)).asIdeal := by
  let delta := spine.lift.pathMap spine.middle
  let firstMap := spine.lift.representative spine.first
  let lastMap := spine.lift.representative spine.last
  let Q := spine.middleCompReverseRadicalPowerParameter
    S hfinite P lambda hfactor
  let prefixMap : spine.rightInner.obj.as ⟶ i.obj.as := delta ≫ firstMap
  let sourceAction : End spine.rightInner.obj.as →ₗ[k]
      (spine.rightInner.obj.as ⟶ i.obj.as) :=
    { toFun := fun c ↦ c.asHom ≫ prefixMap
      map_add' := by
        intro a b
        change (a.asHom + b.asHom) ≫ prefixMap = _
        rw [Preadditive.add_comp]
      map_smul' := by
        intro c a
        change (c • a.asHom) ≫ prefixMap = c • (a.asHom ≫ prefixMap)
        rw [Linear.smul_comp] }
  let sourceRadicalAction : Submodule k
      (spine.rightInner.obj.as ⟶ i.obj.as) :=
    ((Ring.jacobson (End spine.rightInner.obj.as)).restrictScalars k).map
      sourceAction
  have hQtau : Q.tau.asHom = delta ≫ lambda := by
    dsimp only [Q, delta]
    rw [spine.middleCompReverseRadicalPowerParameter_tau
      S hfinite P lambda hfactor]
  have hdeltaSpan :
      LargeIndecomposable.twoSidedEndomorphismSpan k delta = ⊤ := by
    simpa only [delta] using spine.middle_full_span S hfinite
  have hdeltaT : LargeIndecomposable.AllowsTransit delta :=
    (spine.middle_allowsBitransit S hfinite).1
  have hprefixEq :
      spine.lift.pathMap (spine.first.toPath.comp spine.middle) =
        prefixMap := by
    simp only [prefixMap, delta, firstMap, BGRSRayArrowLift.pathMap,
      LinearPathCategory.pathMap_comp, Quiver.Hom.toPath,
      LinearPathCategory.pathMap_cons,
      LinearPathCategory.pathMap_nil, Category.comp_id]
  have hprefixSpan :
      LargeIndecomposable.twoSidedEndomorphismSpan k prefixMap = ⊤ := by
    rw [← hprefixEq]
    exact (spine.long_outer_composites_full_spans S hfinite).2
  have hprefixNotT : ¬ LargeIndecomposable.AllowsTransit prefixMap := by
    rw [← hprefixEq]
    exact spine.prefix_not_allowsTransit S
  have hprefixC : LargeIndecomposable.AllowsCotransit prefixMap :=
    (LargeIndecomposable.HasBGRSDistributiveHomStructure.transit_or_cotransit
      (k := k) (C := S.ProjectiveCategory) prefixMap).resolve_left hprefixNotT
  have hprefix0 : prefixMap ≠ 0 := by
    rw [← hprefixEq]
    exact spine.lift_prefix_pathMap_ne_zero
  have hlastJ : lastMap.1 ∈ Ring.jacobson A :=
    S.rayArrowLift_representative_mem_jacobson spine.lift spine.last
  have hcornerLe :
      finiteIdealCorner S (relationIdeal S spine P Q)
          spine.rightInner.obj.as i.obj.as ≤ sourceRadicalAction := by
    rw [relationIdeal, finiteIdealCorner_span_pair_eq]
    apply sup_le
    · apply Submodule.span_le.2
      rintro h ⟨a, b, rfl⟩
      have hamem : a ∈
          LargeIndecomposable.twoSidedEndomorphismSpan k delta := by
        rw [hdeltaSpan]
        exact Submodule.mem_top
      obtain ⟨e, ha⟩ :=
        LargeIndecomposable.exists_comp_of_mem_span_of_allowsTransit
          hdeltaT hamem
      let base : spine.rightInner.obj.as ⟶ i.obj.as :=
        delta ≫ e.asHom ≫ firstMap ≫ b
      have hbaseMem : base ∈
          LargeIndecomposable.twoSidedEndomorphismSpan k prefixMap := by
        rw [hprefixSpan]
        exact Submodule.mem_top
      obtain ⟨d, hbase⟩ :=
        exists_comp_left_of_mem_twoSidedSpan_of_allowsCotransit
          hprefixC hbaseMem
      let c : End spine.rightInner.obj.as := d * Q.tau
      have hcJ : c ∈ Ring.jacobson (End spine.rightInner.obj.as) :=
        (Ring.jacobson (End spine.rightInner.obj.as)).mul_mem_left d
          Q.mem_jacobson
      have hcomm : e * P.tau = P.tau * e :=
        LargeIndecomposable.SplitBasicIdempotents.ProjectiveCategory.end_mul_comm
          S spine.leftInner.obj.as e P.tau
      have hcommHom : e.asHom ≫ P.tau.asHom =
          P.tau.asHom ≫ e.asHom := by
        simpa only [End.mul_def] using congrArg End.asHom hcomm.symm
      apply Submodule.mem_map.2
      refine ⟨c, hcJ, ?_⟩
      change c.asHom ≫ prefixMap =
        (a ≫ (P.tau.asHom ≫ firstMap)) ≫ b
      rw [ha]
      calc
        c.asHom ≫ prefixMap = Q.tau.asHom ≫ base := by
          rw [hbase]
          simp only [c, End.mul_def, Category.assoc]
        _ = (delta ≫ P.tau.asHom) ≫
              (e.asHom ≫ firstMap ≫ b) := by
          rw [hQtau, hfactor]
          simp only [base, delta, Category.assoc]
        _ = ((delta ≫ e.asHom) ≫
              (P.tau.asHom ≫ firstMap)) ≫ b := by
          calc
            (delta ≫ P.tau.asHom) ≫
                  (e.asHom ≫ firstMap ≫ b) =
                (delta ≫ (P.tau.asHom ≫ e.asHom) ≫
                  firstMap) ≫ b := by simp only [Category.assoc]
            _ = (delta ≫ (e.asHom ≫ P.tau.asHom) ≫
                  firstMap) ≫ b := by rw [hcommHom]
            _ = ((delta ≫ e.asHom) ≫
                  (P.tau.asHom ≫ firstMap)) ≫ b := by
                    simp only [Category.assoc]
    · apply Submodule.span_le.2
      rintro h ⟨a, b, rfl⟩
      have hbmem : b ∈
          LargeIndecomposable.twoSidedEndomorphismSpan k prefixMap := by
        rw [hprefixSpan]
        exact Submodule.mem_top
      obtain ⟨d, hb⟩ :=
        exists_comp_left_of_mem_twoSidedSpan_of_allowsCotransit
          hprefixC hbmem
      let e : End spine.rightInner.obj.as := End.of (a ≫ lastMap)
      have heJ : e ∈ Ring.jacobson (End spine.rightInner.obj.as) := by
        rw [S.projectiveEnd_mem_jacobson_iff_val_mem_jacobson]
        change (a ≫ lastMap).1 ∈ Ring.jacobson A
        simp only [comp_val]
        exact (Ring.jacobson A).mul_mem_right a.1 hlastJ
      let c : End spine.rightInner.obj.as := d * (Q.tau * e)
      have hcJ : c ∈ Ring.jacobson (End spine.rightInner.obj.as) :=
        (Ring.jacobson (End spine.rightInner.obj.as)).mul_mem_left d
          ((Ring.jacobson (End spine.rightInner.obj.as)).mul_mem_left
            Q.tau heJ)
      apply Submodule.mem_map.2
      refine ⟨c, hcJ, ?_⟩
      change c.asHom ≫ prefixMap =
        (a ≫ (lastMap ≫ Q.tau.asHom)) ≫ b
      rw [hb]
      simp only [c, e, End.mul_def, Category.assoc]
  intro hmem
  have hcorner : prefixMap ∈ finiteIdealCorner S
      (relationIdeal S spine P Q) spine.rightInner.obj.as i.obj.as := hmem
  rcases hcornerLe hcorner with ⟨c, hcJ, hcprefix⟩
  have hfix : prefixMap = c.asHom ≫ prefixMap := hcprefix.symm
  exact hprefix0
    (eq_zero_of_eq_source_jacobson_action prefixMap c hcJ hfix)

/-- Source-dually, the outer suffix `last ≫ delta` survives the stronger
global auxiliary quotient.  Its full span and prohibited cotransit direction
make it allow transit, and both relation generators contribute only
target-Jacobson multiples. -/
theorem factorBranch_suffix_not_mem_relationIdeal
    (hfinite : LargeIndecomposable.MildAlg k A)
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (P : OrientedRadicalPowerParameter
      (k := k) spine.leftInner.obj.as)
    (lambda : spine.leftInner.obj.as ⟶ spine.rightInner.obj.as)
    (hfactor : P.tau.asHom =
      lambda ≫ spine.lift.pathMap spine.middle) :
    (spine.lift.representative spine.last ≫
        spine.lift.pathMap spine.middle).1 ∉
      (relationIdeal S spine P
        (spine.middleCompReverseRadicalPowerParameter
          S hfinite P lambda hfactor)).asIdeal := by
  let delta := spine.lift.pathMap spine.middle
  let firstMap := spine.lift.representative spine.first
  let lastMap := spine.lift.representative spine.last
  let Q := spine.middleCompReverseRadicalPowerParameter
    S hfinite P lambda hfactor
  let suffixMap : j.obj.as ⟶ spine.leftInner.obj.as := lastMap ≫ delta
  let targetAction : End spine.leftInner.obj.as →ₗ[k]
      (j.obj.as ⟶ spine.leftInner.obj.as) :=
    { toFun := fun c ↦ suffixMap ≫ c.asHom
      map_add' := by
        intro a b
        change suffixMap ≫ (a.asHom + b.asHom) = _
        rw [Preadditive.comp_add]
      map_smul' := by
        intro c a
        change suffixMap ≫ (c • a.asHom) = c • (suffixMap ≫ a.asHom)
        rw [Linear.comp_smul] }
  let targetRadicalAction : Submodule k
      (j.obj.as ⟶ spine.leftInner.obj.as) :=
    ((Ring.jacobson (End spine.leftInner.obj.as)).restrictScalars k).map
      targetAction
  have hQtau : Q.tau.asHom = delta ≫ lambda := by
    dsimp only [Q, delta]
    rw [spine.middleCompReverseRadicalPowerParameter_tau
      S hfinite P lambda hfactor]
  have hdeltaSpan :
      LargeIndecomposable.twoSidedEndomorphismSpan k delta = ⊤ := by
    simpa only [delta] using spine.middle_full_span S hfinite
  have hdeltaT : LargeIndecomposable.AllowsTransit delta :=
    (spine.middle_allowsBitransit S hfinite).1
  have hsuffixEq :
      spine.lift.pathMap (spine.middle.comp spine.last.toPath) =
        suffixMap := by
    simp only [suffixMap, delta, lastMap, BGRSRayArrowLift.pathMap,
      LinearPathCategory.pathMap_comp, Quiver.Hom.toPath,
      LinearPathCategory.pathMap_cons,
      LinearPathCategory.pathMap_nil, Category.comp_id]
  have hsuffixSpan :
      LargeIndecomposable.twoSidedEndomorphismSpan k suffixMap = ⊤ := by
    rw [← hsuffixEq]
    exact (spine.long_outer_composites_full_spans S hfinite).1
  have hsuffixNotC : ¬ LargeIndecomposable.AllowsCotransit suffixMap := by
    rw [← hsuffixEq]
    exact spine.suffix_not_allowsCotransit S
  have hsuffixT : LargeIndecomposable.AllowsTransit suffixMap :=
    (LargeIndecomposable.HasBGRSDistributiveHomStructure.transit_or_cotransit
      (k := k) (C := S.ProjectiveCategory) suffixMap).resolve_right hsuffixNotC
  have hsuffix0 : suffixMap ≠ 0 := by
    rw [← hsuffixEq]
    exact spine.lift_suffix_pathMap_ne_zero
  have hfirstJ : firstMap.1 ∈ Ring.jacobson A :=
    S.rayArrowLift_representative_mem_jacobson spine.lift spine.first
  have hcornerLe :
      finiteIdealCorner S (relationIdeal S spine P Q)
          j.obj.as spine.leftInner.obj.as ≤ targetRadicalAction := by
    rw [relationIdeal, finiteIdealCorner_span_pair_eq]
    apply sup_le
    · apply Submodule.span_le.2
      rintro h ⟨a, b, rfl⟩
      have hamem : a ∈
          LargeIndecomposable.twoSidedEndomorphismSpan k suffixMap := by
        rw [hsuffixSpan]
        exact Submodule.mem_top
      obtain ⟨d, ha⟩ :=
        exists_comp_right_of_mem_twoSidedSpan_of_allowsTransit
          hsuffixT hamem
      let e : End spine.leftInner.obj.as := End.of (firstMap ≫ b)
      have heJ : e ∈ Ring.jacobson (End spine.leftInner.obj.as) := by
        rw [S.projectiveEnd_mem_jacobson_iff_val_mem_jacobson]
        change (firstMap ≫ b).1 ∈ Ring.jacobson A
        simp only [comp_val]
        exact (Ring.jacobson A).mul_mem_left b.1 hfirstJ
      let c : End spine.leftInner.obj.as := e * (P.tau * d)
      have hcJ : c ∈ Ring.jacobson (End spine.leftInner.obj.as) :=
        (Ring.jacobson (End spine.leftInner.obj.as)).mul_mem_right
          (P.tau * d) heJ
      apply Submodule.mem_map.2
      refine ⟨c, hcJ, ?_⟩
      change suffixMap ≫ c.asHom =
        (a ≫ (P.tau.asHom ≫ firstMap)) ≫ b
      rw [ha]
      simp only [c, e, End.mul_def, Category.assoc]
    · apply Submodule.span_le.2
      rintro h ⟨a, b, rfl⟩
      have hbmem : b ∈
          LargeIndecomposable.twoSidedEndomorphismSpan k delta := by
        rw [hdeltaSpan]
        exact Submodule.mem_top
      obtain ⟨e, hb⟩ :=
        LargeIndecomposable.exists_comp_of_mem_span_of_allowsTransit
          hdeltaT hbmem
      obtain ⟨d, ha⟩ := hsuffixT (End.of a)
      let c : End spine.leftInner.obj.as := e * (P.tau * d)
      have hPdJ : P.tau * d ∈
          Ring.jacobson (End spine.leftInner.obj.as) :=
        (Ring.jacobson (End spine.leftInner.obj.as)).mul_mem_right d
          P.mem_jacobson
      have hcJ : c ∈ Ring.jacobson (End spine.leftInner.obj.as) :=
        (Ring.jacobson (End spine.leftInner.obj.as)).mul_mem_left e hPdJ
      apply Submodule.mem_map.2
      refine ⟨c, hcJ, ?_⟩
      change suffixMap ≫ c.asHom =
        (a ≫ (lastMap ≫ Q.tau.asHom)) ≫ b
      rw [hb]
      calc
        suffixMap ≫ c.asHom =
            (a ≫ suffixMap) ≫ (P.tau.asHom ≫ e.asHom) := by
              rw [ha]
              simp only [c, End.mul_def, Category.assoc]
        _ = (a ≫ lastMap ≫ Q.tau.asHom) ≫
              (delta ≫ e.asHom) := by
              rw [hQtau, hfactor]
              simp only [suffixMap, delta, Category.assoc]
  intro hmem
  have hcorner : suffixMap ∈ finiteIdealCorner S
      (relationIdeal S spine P Q) j.obj.as spine.leftInner.obj.as := hmem
  rcases hcornerLe hcorner with ⟨c, hcJ, hcsuffix⟩
  have hfix : suffixMap = suffixMap ≫ c.asHom := hcsuffix.symm
  exact hsuffix0
    (eq_zero_of_eq_target_jacobson_action suffixMap c hcJ hfix)

/-- Quotient-functor form of left-cycle survival. -/
theorem factorBranch_quotientFunctor_map_left_cycle_ne_zero
    (hfinite : LargeIndecomposable.MildAlg k A)
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (P : OrientedRadicalPowerParameter
      (k := k) spine.leftInner.obj.as)
    (lambda : spine.leftInner.obj.as ⟶ spine.rightInner.obj.as)
    (hfactor : P.tau.asHom =
      lambda ≫ spine.lift.pathMap spine.middle) :
    (quotientFunctor S spine P
      (spine.middleCompReverseRadicalPowerParameter
        S hfinite P lambda hfactor)).map P.tau.asHom ≠ 0 := by
  intro hzero
  exact factorBranch_left_cycle_not_mem_relationIdeal
    S hfinite spine P lambda hfactor
      ((S.projectiveQuotientFunctor_map_eq_zero_iff
        (relationIdeal S spine P
          (spine.middleCompReverseRadicalPowerParameter
            S hfinite P lambda hfactor))
        (relationIdeal_le_jacobson S spine P
          (spine.middleCompReverseRadicalPowerParameter
            S hfinite P lambda hfactor)) P.tau.asHom).1 hzero)

/-- Quotient-functor form of right-cycle survival. -/
theorem factorBranch_quotientFunctor_map_right_cycle_ne_zero
    (hfinite : LargeIndecomposable.MildAlg k A)
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (P : OrientedRadicalPowerParameter
      (k := k) spine.leftInner.obj.as)
    (lambda : spine.leftInner.obj.as ⟶ spine.rightInner.obj.as)
    (hfactor : P.tau.asHom =
      lambda ≫ spine.lift.pathMap spine.middle) :
    (quotientFunctor S spine P
      (spine.middleCompReverseRadicalPowerParameter
        S hfinite P lambda hfactor)).map
        (spine.middleCompReverseRadicalPowerParameter
          S hfinite P lambda hfactor).tau.asHom ≠ 0 := by
  let Q := spine.middleCompReverseRadicalPowerParameter
    S hfinite P lambda hfactor
  intro hzero
  exact factorBranch_right_cycle_not_mem_relationIdeal
    S hfinite spine P lambda hfactor
      ((S.projectiveQuotientFunctor_map_eq_zero_iff
        (relationIdeal S spine P Q)
        (relationIdeal_le_jacobson S spine P Q) Q.tau.asHom).1 hzero)

/-- In the factor-branch diagram, the left central cycle is exactly the
image of the chosen parameter `sigma`. -/
theorem factorBranchQuotientDiagram_left_cycle
    (hfinite : LargeIndecomposable.MildAlg k A)
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (P : OrientedRadicalPowerParameter
      (k := k) spine.leftInner.obj.as)
    (lambda : spine.leftInner.obj.as ⟶ spine.rightInner.obj.as)
    (hfactor : P.tau.asHom =
      lambda ≫ spine.lift.pathMap spine.middle) :
    (quotientFunctor S spine P
        (spine.middleCompReverseRadicalPowerParameter
          S hfinite P lambda hfactor)).map lambda ≫
      (quotientFunctor S spine P
        (spine.middleCompReverseRadicalPowerParameter
          S hfinite P lambda hfactor)).map
        (spine.lift.pathMap spine.middle) =
    (quotientFunctor S spine P
      (spine.middleCompReverseRadicalPowerParameter
        S hfinite P lambda hfactor)).map P.tau.asHom := by
  rw [← Functor.map_comp, ← hfactor]

/-- The right central cycle is exactly the image of the opposite-cycle
parameter `rho`. -/
theorem factorBranchQuotientDiagram_right_cycle
    (hfinite : LargeIndecomposable.MildAlg k A)
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (P : OrientedRadicalPowerParameter
      (k := k) spine.leftInner.obj.as)
    (lambda : spine.leftInner.obj.as ⟶ spine.rightInner.obj.as)
    (hfactor : P.tau.asHom =
      lambda ≫ spine.lift.pathMap spine.middle) :
    (quotientFunctor S spine P
        (spine.middleCompReverseRadicalPowerParameter
          S hfinite P lambda hfactor)).map
        (spine.lift.pathMap spine.middle) ≫
      (quotientFunctor S spine P
        (spine.middleCompReverseRadicalPowerParameter
          S hfinite P lambda hfactor)).map lambda =
    (quotientFunctor S spine P
        (spine.middleCompReverseRadicalPowerParameter
          S hfinite P lambda hfactor)).map
        (spine.middleCompReverseRadicalPowerParameter
          S hfinite P lambda hfactor).tau.asHom := by
  rw [← Functor.map_comp]
  congr 1

/-- The initial cross-relation is literally zero in the factor-branch
Figure-14 quotient. -/
theorem factorBranchQuotientDiagram_initial_cross_zero
    (hfinite : LargeIndecomposable.MildAlg k A)
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (P : OrientedRadicalPowerParameter
      (k := k) spine.leftInner.obj.as)
    (lambda : spine.leftInner.obj.as ⟶ spine.rightInner.obj.as)
    (hfactor : P.tau.asHom =
      lambda ≫ spine.lift.pathMap spine.middle) :
    (quotientFunctor S spine P
        (spine.middleCompReverseRadicalPowerParameter
          S hfinite P lambda hfactor)).map P.tau.asHom ≫
      (quotientFunctor S spine P
        (spine.middleCompReverseRadicalPowerParameter
          S hfinite P lambda hfactor)).map
        (spine.lift.representative spine.first) = 0 := by
  rw [← Functor.map_comp]
  exact quotientFunctor_map_initial_relation_eq_zero S spine P _

/-- The terminal cross-relation is literally zero in the factor-branch
Figure-14 quotient. -/
theorem factorBranchQuotientDiagram_terminal_cross_zero
    (hfinite : LargeIndecomposable.MildAlg k A)
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (P : OrientedRadicalPowerParameter
      (k := k) spine.leftInner.obj.as)
    (lambda : spine.leftInner.obj.as ⟶ spine.rightInner.obj.as)
    (hfactor : P.tau.asHom =
      lambda ≫ spine.lift.pathMap spine.middle) :
    (quotientFunctor S spine P
        (spine.middleCompReverseRadicalPowerParameter
          S hfinite P lambda hfactor)).map
        (spine.lift.representative spine.last) ≫
      (quotientFunctor S spine P
        (spine.middleCompReverseRadicalPowerParameter
          S hfinite P lambda hfactor)).map
        (spine.middleCompReverseRadicalPowerParameter
          S hfinite P lambda hfactor).tau.asHom = 0 := by
  rw [← Functor.map_comp]
  exact quotientFunctor_map_terminal_relation_eq_zero S spine P _

section SelectedCorner

open LargeIndecomposable.SplitBasicIdempotents

/-- The duplicate-free set of primitive vertices in BGRS's full subcategory
`A{b,c,d,a}` for Figure 14. -/
def selectedVertices
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p) : Finset ι :=
  {S.projectiveVertex i.obj.as,
    S.projectiveVertex spine.leftInner.obj.as,
    S.projectiveVertex spine.rightInner.obj.as,
    S.projectiveVertex j.obj.as}

omit [IsAlgClosed k] in
@[simp]
theorem initial_mem_selectedVertices
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p) :
    S.projectiveVertex i.obj.as ∈ selectedVertices S spine := by
  simp [selectedVertices]

omit [IsAlgClosed k] in
@[simp]
theorem leftInner_mem_selectedVertices
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p) :
    S.projectiveVertex spine.leftInner.obj.as ∈
      selectedVertices S spine := by
  simp [selectedVertices]

omit [IsAlgClosed k] in
@[simp]
theorem rightInner_mem_selectedVertices
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p) :
    S.projectiveVertex spine.rightInner.obj.as ∈
      selectedVertices S spine := by
  simp [selectedVertices]

omit [IsAlgClosed k] in
@[simp]
theorem terminal_mem_selectedVertices
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p) :
    S.projectiveVertex j.obj.as ∈ selectedVertices S spine := by
  simp [selectedVertices]

/-- Canonical duplicate-free enumeration of the four displayed primitive
vertices. -/
abbrev selectedEmbedding
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p) :=
  finsetPrimitiveEmbedding (selectedVertices S spine)

/-- The exact full selected corner `A{b,c,d,a}` of BGRS 4.3(b). -/
abbrev selectedCorner
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p) :=
  S.SelectedCorner (selectedEmbedding S spine)

/-- Its chosen split-basic presentation. -/
abbrev selectedSplitBasic
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p) :=
  LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.splitBasic
    S (selectedEmbedding S spine)

abbrev selectedInitialObj
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p) :=
  LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.finsetProjectiveObj
    S (selectedVertices S spine) i.obj.as
      (initial_mem_selectedVertices S spine)

abbrev selectedLeftInnerObj
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p) :=
  LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.finsetProjectiveObj
    S (selectedVertices S spine) spine.leftInner.obj.as
      (leftInner_mem_selectedVertices S spine)

abbrev selectedRightInnerObj
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p) :=
  LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.finsetProjectiveObj
    S (selectedVertices S spine) spine.rightInner.obj.as
      (rightInner_mem_selectedVertices S spine)

abbrev selectedTerminalObj
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p) :=
  LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.finsetProjectiveObj
    S (selectedVertices S spine) j.obj.as
      (terminal_mem_selectedVertices S spine)

abbrev selectedFirst
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p) :=
  LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.finsetProjectiveHom
    S (selectedVertices S spine)
      (leftInner_mem_selectedVertices S spine)
      (initial_mem_selectedVertices S spine)
      (spine.lift.representative spine.first)

abbrev selectedMiddle
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p) :=
  LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.finsetProjectiveHom
    S (selectedVertices S spine)
      (rightInner_mem_selectedVertices S spine)
      (leftInner_mem_selectedVertices S spine)
      (spine.lift.pathMap spine.middle)

abbrev selectedLast
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p) :=
  LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.finsetProjectiveHom
    S (selectedVertices S spine)
      (terminal_mem_selectedVertices S spine)
      (rightInner_mem_selectedVertices S spine)
      (spine.lift.representative spine.last)

abbrev selectedLambda
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (lambda : spine.leftInner.obj.as ⟶ spine.rightInner.obj.as) :=
  LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.finsetProjectiveHom
    S (selectedVertices S spine)
      (leftInner_mem_selectedVertices S spine)
      (rightInner_mem_selectedVertices S spine) lambda

abbrev selectedLeftTau
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (P : OrientedRadicalPowerParameter
      (k := k) spine.leftInner.obj.as) :=
  LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.finsetProjectiveHom
    S (selectedVertices S spine)
      (leftInner_mem_selectedVertices S spine)
      (leftInner_mem_selectedVertices S spine) P.tau.asHom

abbrev selectedRightTau
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (Q : OrientedRadicalPowerParameter
      (k := k) spine.rightInner.obj.as) :=
  LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.finsetProjectiveHom
    S (selectedVertices S spine)
      (rightInner_mem_selectedVertices S spine)
      (rightInner_mem_selectedVertices S spine) Q.tau.asHom

/-- The two-generator relation ideal formed inside the exact selected corner,
as in `M/{alpha₁ sigma, rho alphaₙ}` in BGRS 4.3(b). -/
def selectedRelationIdeal
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (P : OrientedRadicalPowerParameter
      (k := k) spine.leftInner.obj.as)
    (Q : OrientedRadicalPowerParameter
      (k := k) spine.rightInner.obj.as) :
    TwoSidedIdeal (selectedCorner S spine) :=
  TwoSidedIdeal.span
    ({(selectedLeftTau S spine P ≫ selectedFirst S spine).1,
      (selectedLast S spine ≫ selectedRightTau S spine Q).1} :
      Set (selectedCorner S spine))

/-- The Figure-14 relation ideal is nonzero: `σ α₁ ≠ 0` is a factor of the
nonzero initial sandwich (condition `P_1` of BGRS 4.2). -/
theorem selectedRelationIdeal_ne_bot
    (hfinite : LargeIndecomposable.MildAlg k A)
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (P : OrientedRadicalPowerParameter
      (k := k) spine.leftInner.obj.as)
    (Q : OrientedRadicalPowerParameter
      (k := k) spine.rightInner.obj.as) :
    selectedRelationIdeal S spine P Q ≠ ⊥ := by
  intro hbot
  have hmem : (selectedLeftTau S spine P ≫ selectedFirst S spine).1 ∈
      selectedRelationIdeal S spine P Q :=
    TwoSidedIdeal.subset_span (Set.mem_insert _ _)
  rw [hbot] at hmem
  apply spine.initial_parameter_sandwich_ne_zero S hfinite P
  have h1 : (selectedLeftTau S spine P ≫ selectedFirst S spine).1 = 0 := hmem
  have h2 : P.tau.asHom ≫ spine.lift.representative spine.first = 0 := by
    apply Subtype.ext
    have h3 : ((selectedLeftTau S spine P ≫ selectedFirst S spine).1).1 = 0 := by
      rw [h1]; rfl
    rw [LargeIndecomposable.SplitBasicIdempotents.ProjectiveCategory.comp_val] at h3
    change (selectedFirst S spine).1.1 * (selectedLeftTau S spine P).1.1 = 0 at h3
    rw [LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.finsetProjectiveHom_val_val,
      LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.finsetProjectiveHom_val_val] at h3
    rw [LargeIndecomposable.SplitBasicIdempotents.ProjectiveCategory.comp_val]
    exact h3
  rw [Category.assoc, h2, Limits.comp_zero]

omit [IsAlgClosed k] in
/-- Restricting the global auxiliary ideal to the selected corner contains
the exact local ideal.  Thus every local ideal element remains a member of
the global ideal after forgetting the corner. -/
theorem selectedRelationIdeal_le_comap_relationIdeal
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (P : OrientedRadicalPowerParameter
      (k := k) spine.leftInner.obj.as)
    (Q : OrientedRadicalPowerParameter
      (k := k) spine.rightInner.obj.as) :
    selectedRelationIdeal S spine P Q ≤
      (relationIdeal S spine P Q).comap
        (LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.valNonUnitalRingHom
          S (selectedEmbedding S spine)) := by
  apply TwoSidedIdeal.span_le.2
  intro a ha
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha
  rcases ha with rfl | rfl
  · apply (TwoSidedIdeal.mem_comap
      (LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.valNonUnitalRingHom
        S (selectedEmbedding S spine))).2
    change (selectedFirst S spine).1.1 *
      (selectedLeftTau S spine P).1.1 ∈
        (relationIdeal S spine P Q).asIdeal
    rw [LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.finsetProjectiveHom_val_val,
      LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.finsetProjectiveHom_val_val]
    simpa only [comp_val] using initial_relation_mem S spine P Q
  · apply (TwoSidedIdeal.mem_comap
      (LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.valNonUnitalRingHom
        S (selectedEmbedding S spine))).2
    change (selectedRightTau S spine Q).1.1 *
      (selectedLast S spine).1.1 ∈
        (relationIdeal S spine P Q).asIdeal
    rw [LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.finsetProjectiveHom_val_val,
      LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.finsetProjectiveHom_val_val]
    simpa only [comp_val] using terminal_relation_mem S spine P Q

