/-- The stronger global estimate implies that the lifted left parameter
survives the exact local quotient. -/
theorem factorBranch_selectedLeftTau_not_mem_selectedRelationIdeal
    (hfinite : LargeIndecomposable.MildAlg k A)
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (P : OrientedRadicalPowerParameter
      (k := k) spine.leftInner.obj.as)
    (lambda : spine.leftInner.obj.as ⟶ spine.rightInner.obj.as)
    (hfactor : P.tau.asHom =
      lambda ≫ spine.lift.pathMap spine.middle) :
    (selectedLeftTau S spine P).1 ∉
      (selectedRelationIdeal S spine P
        (spine.middleCompReverseRadicalPowerParameter
          S hfinite P lambda hfactor)).asIdeal := by
  intro hmem
  apply factorBranch_left_cycle_not_mem_relationIdeal
    S hfinite spine P lambda hfactor
  have hval := val_mem_relationIdeal_of_mem_selectedRelationIdeal
    S spine P
      (spine.middleCompReverseRadicalPowerParameter
        S hfinite P lambda hfactor) hmem
  simpa only [LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.finsetProjectiveHom_val_val]
    using hval

