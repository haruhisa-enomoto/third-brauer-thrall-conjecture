/-- The exact selected-corner Figure-14 relation ideal is radical. -/
theorem selectedRelationIdeal_le_jacobson
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (P : OrientedRadicalPowerParameter
      (k := k) spine.leftInner.obj.as)
    (Q : OrientedRadicalPowerParameter
      (k := k) spine.rightInner.obj.as) :
    (selectedRelationIdeal S spine P Q).asIdeal ≤
      Ring.jacobson (selectedCorner S spine) := by
  have hP : (selectedLeftTau S spine P).1 ∈
      Ring.jacobson (selectedCorner S spine) :=
    LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.finsetProjectiveHom_val_mem_jacobson
      S (selectedVertices S spine)
        (leftInner_mem_selectedVertices S spine)
        (leftInner_mem_selectedVertices S spine) P.tau.asHom
        ((S.projectiveEnd_mem_jacobson_iff_val_mem_jacobson
          spine.leftInner.obj.as P.tau).1 P.mem_jacobson)
  have hQ : (selectedRightTau S spine Q).1 ∈
      Ring.jacobson (selectedCorner S spine) :=
    LargeIndecomposable.SplitBasicIdempotents.SelectedCorner.finsetProjectiveHom_val_mem_jacobson
      S (selectedVertices S spine)
        (rightInner_mem_selectedVertices S spine)
        (rightInner_mem_selectedVertices S spine) Q.tau.asHom
        ((S.projectiveEnd_mem_jacobson_iff_val_mem_jacobson
          spine.rightInner.obj.as Q.tau).1 Q.mem_jacobson)
  have hle : selectedRelationIdeal S spine P Q ≤
      (Ring.jacobson (selectedCorner S spine)).toTwoSided := by
    apply TwoSidedIdeal.span_le.2
    intro a ha
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha
    rcases ha with rfl | rfl
    · apply Ideal.mem_toTwoSided.2
      simpa only [comp_val] using
        (Ring.jacobson (selectedCorner S spine)).mul_mem_left
          (selectedFirst S spine).1 hP
    · apply Ideal.mem_toTwoSided.2
      simpa only [comp_val] using
        (Ring.jacobson (selectedCorner S spine)).mul_mem_right
          (selectedLast S spine).1 hQ
  intro a ha
  exact Ideal.mem_toTwoSided.1 (hle ha)

/-- The literal Figure-14 diagram before quotienting, now inside BGRS's exact
four-vertex selected corner. -/
def selectedAmbientDiagram
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (lambda : spine.leftInner.obj.as ⟶ spine.rightInner.obj.as) :
    LargeIndecomposable.CriticalSingularFigure14.DiagramData
      (C := (selectedSplitBasic S spine).ProjectiveCategory) where
  c := selectedLeftInnerObj S spine
  d := selectedRightInnerObj S spine
  b := selectedRightInnerObj S spine
  cUpper := selectedTerminalObj S spine
  dLower := selectedInitialObj S spine
  a := selectedLeftInnerObj S spine
  lambda := selectedLambda S spine lambda
  alphaLeft := selectedMiddle S spine
  deltaUpper := selectedLast S spine
  deltaLower := selectedFirst S spine
  alphaRight := selectedMiddle S spine

/-- The exact selected-corner quotient candidate required by the local BGRS
Figure-14 reduction boundary. -/
def localQuotientCandidate
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (P : OrientedRadicalPowerParameter
      (k := k) spine.leftInner.obj.as)
    (Q : OrientedRadicalPowerParameter
      (k := k) spine.rightInner.obj.as)
    (lambda : spine.leftInner.obj.as ⟶ spine.rightInner.obj.as) :
    LargeIndecomposable.CriticalSingularLocalQuotientExtraction.Figure14LocalQuotientCandidate
      S where
  rank := Fintype.card ↑(selectedVertices S spine)
  r := selectedEmbedding S spine
  I := selectedRelationIdeal S spine P Q
  le_jacobson := selectedRelationIdeal_le_jacobson S spine P Q
  ambient := selectedAmbientDiagram S spine lambda

/-- The exact quotient functor on primitive projectives of the selected
corner. -/
abbrev selectedQuotientFunctor
    {i j : LargeIndecomposable.RayVertex S.RayCategory}
    {p : Quiver.Path i j}
    (spine : LargeIndecomposable.BGRSCriticalPathSpine p)
    (P : OrientedRadicalPowerParameter
      (k := k) spine.leftInner.obj.as)
    (Q : OrientedRadicalPowerParameter
      (k := k) spine.rightInner.obj.as) :=
  (selectedSplitBasic S spine).projectiveQuotientFunctor
    (selectedRelationIdeal S spine P Q)
    (selectedRelationIdeal_le_jacobson S spine P Q)

