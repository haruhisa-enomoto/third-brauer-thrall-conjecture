/-- A nonexceptional outer composite cannot belong to the Figure-13 relation
ideal.  Membership would express `f g` as `f q g` for
`q ∈ Jac(End Y)^2`, which is exactly a BGRS exceptional-zero witness. -/
theorem cross_not_mem_relationIdeal_of_not_special
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (hfspan : twoSidedEndomorphismSpan k f = ⊤)
    (hgspan : twoSidedEndomorphismSpan k g = ⊤)
    (hfT : AllowsTransit f) (hgC : AllowsCotransit g)
    (hns : ¬ LargeIndecomposable.IsBGRSSpecialZero f g) :
    (f ≫ g).1 ∉ (relationIdeal S f g P).asIdeal := by
  intro hmem
  have hcorner : f ≫ g ∈
      finiteIdealCorner S (relationIdeal S f g P) X Z := hmem
  have hsq := relationIdeal_corner_cross_le
    S f g P hfspan hgspan hfT hgC hcorner
  rcases hsq with ⟨q, hq, hqeq⟩
  apply hns
  refine ⟨⟨q, ?_⟩, ?_⟩
  · exact Ideal.pow_le_self (by omega) hq
  · exact hqeq.symm

omit [LargeIndecomposable.HasBGRSDistributiveHomStructure
  k S.ProjectiveCategory] in
/-- Distinct neighboring vertices force the middle path `tau^2` to survive
the full two-generator relation ideal. -/
theorem middle_square_not_mem_relationIdeal
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (hXY : X ≠ Y) (hYZ : Y ≠ Z)
    (hleft : f ≫ (P.tau ^ 2).asHom ≠ 0) :
    (P.tau ^ 2).1 ∉ (relationIdeal S f g P).asIdeal := by
  letI : Module.Finite k (End Y) := by
    change Module.Finite k (Y ⟶ Y)
    infer_instance
  have htauSq : P.tau ^ 2 ≠ 0 := by
    intro hzero
    apply hleft
    rw [hzero]
    change f ≫ (0 : Y ⟶ Y) = 0
    simp
  intro hmem
  have hcorner : (P.tau ^ 2).asHom ∈
      finiteIdealCorner S (relationIdeal S f g P) Y Y := hmem
  have hrel := relationIdeal_corner_middle_le S f g P hXY hYZ hcorner
  have hle := twoSidedEndomorphismSpan_le_of_mem hrel
  exact (P.power_succ_span_lt 2 htauSq).2 hle

abbrev quotientSplitBasic
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : LargeIndecomposable.ClosedZigzagTransfer.OrientedRadicalPowerParameter
      (k := k) Y) :=
  S.quotient_of_le_jacobson (relationIdeal S f g P)
    (relationIdeal_le_jacobson S f g P)

abbrev quotientFunctor
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : LargeIndecomposable.ClosedZigzagTransfer.OrientedRadicalPowerParameter
      (k := k) Y) :=
  S.projectiveQuotientFunctor (relationIdeal S f g P)
    (relationIdeal_le_jacobson S f g P)

