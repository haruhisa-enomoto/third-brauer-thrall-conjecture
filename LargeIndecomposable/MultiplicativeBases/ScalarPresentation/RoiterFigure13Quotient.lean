    [LargeIndecomposable.HasBGRSDistributiveHomStructure
      k S.ProjectiveCategory] in
/-- Cotransit passes through the full Figure-13 quotient functor. -/
theorem quotientFunctor_map_allowsCotransit
    {X Y Z U V : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (a : U ⟶ V) (ha : AllowsCotransit a) :
    AllowsCotransit ((quotientFunctor S f g P).map a) := by
  intro d
  obtain ⟨d₀, hd₀⟩ :=
    (quotientFunctor S f g P).map_surjective d.asHom
  obtain ⟨c₀, hc₀⟩ := ha (End.of d₀)
  refine ⟨End.of ((quotientFunctor S f g P).map c₀.asHom), ?_⟩
  change (quotientFunctor S f g P).map a ≫ d.asHom =
    (quotientFunctor S f g P).map c₀.asHom ≫
      (quotientFunctor S f g P).map a
  rw [← hd₀, ← Functor.map_comp, hc₀, Functor.map_comp]

