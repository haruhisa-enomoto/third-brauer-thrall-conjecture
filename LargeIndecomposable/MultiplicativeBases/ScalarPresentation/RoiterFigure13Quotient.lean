private theorem quotientFunctor_map_mem_twoSidedEndomorphismSpan
    {X Y Z U V : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    {a generator : U ⟶ V}
    (ha : a ∈ twoSidedEndomorphismSpan k generator) :
    (quotientFunctor S f g P).map a ∈
      twoSidedEndomorphismSpan k
        ((quotientFunctor S f g P).map generator) := by
  induction ha using Submodule.span_induction with
  | mem a ha =>
      rcases ha with ⟨c, d, rfl⟩
      apply Submodule.subset_span
      refine ⟨End.of ((quotientFunctor S f g P).map c.asHom),
        End.of ((quotientFunctor S f g P).map d.asHom), ?_⟩
      simp only [Functor.map_comp]
  | zero => simp
  | add a b _ _ ha hb =>
      rw [(quotientFunctor S f g P).map_add]
      exact (twoSidedEndomorphismSpan k
        ((quotientFunctor S f g P).map generator)).add_mem ha hb
  | smul c a _ ha =>
      rw [(quotientFunctor S f g P).map_smul]
      exact (twoSidedEndomorphismSpan k
        ((quotientFunctor S f g P).map generator)).smul_mem c ha

