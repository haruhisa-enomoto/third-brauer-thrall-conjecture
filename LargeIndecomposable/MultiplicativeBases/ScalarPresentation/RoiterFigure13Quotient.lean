@[expose] public section

/-!
# The radical quotient used in BGRS Figure 13

If both halves of Roiter's square alternative fail, the preceding parameter
reduction supplies one middle radical generator `tau` with both `f tau^2` and
`tau^2 g` nonzero.  BGRS Section 4.1 quotients by the two-sided ideal generated
by those two elements and realizes Figure 13D by sending its two central
occurrences, and its two vertical arrows, to the same quotient object and the
same image of `tau`.

This file formalizes that quotient and the exact representation-finiteness
obstruction.  It also proves that the two paths adjacent to the killed
relations and the middle `tau^2` path survive the full two-generator ideal.
In the hard transit/cotransit branch, nonexceptionality of the outer composite
`f g` makes the fourth path survive as well.  Thus the remaining source
boundary is the finite supplement calculation showing that nonexceptionality
supplies both strict-span families and hence a forbidden cleavage.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section

open CategoryTheory

namespace LargeIndecomposable.RoiterFigure13Quotient

open LargeIndecomposable.ClosedZigzagCrossUniverse
open LargeIndecomposable.ClosedZigzagTransfer
open LargeIndecomposable.SplitBasicIdempotents.ProjectiveCategory

universe u v x

variable {k : Type u} [Field k] [IsAlgClosed k]
variable {A : Type v} [Ring A] [Algebra k A] [Module.Finite k A]
variable {ι : Type x} [Fintype ι] [DecidableEq ι]

variable (S : LargeIndecomposable.SplitBasicIdempotents
  (k := k) (A := A) (ι := ι))

variable [LargeIndecomposable.HasBGRSDistributiveHomStructure
  k S.ProjectiveCategory]

/-- The two-sided ideal generated by the two relations killed immediately
before Figure 13 in BGRS Section 4.1. -/
def relationIdeal
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : LargeIndecomposable.ClosedZigzagTransfer.OrientedRadicalPowerParameter
      (k := k) Y) :
    TwoSidedIdeal A :=
  TwoSidedIdeal.span
    ({(f ≫ (P.tau ^ 2).asHom).1,
      ((P.tau ^ 2).asHom ≫ g).1} : Set A)

omit [IsAlgClosed k] [Module.Finite k A]
    [LargeIndecomposable.HasBGRSDistributiveHomStructure
      k S.ProjectiveCategory] in
/-- The Figure-13 relation ideal is nonzero as soon as `f π² ≠ 0`. -/
theorem relationIdeal_ne_bot_of_left
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : LargeIndecomposable.ClosedZigzagTransfer.OrientedRadicalPowerParameter
      (k := k) Y)
    (hleft : f ≫ (P.tau ^ 2).asHom ≠ 0) : relationIdeal S f g P ≠ ⊥ := by
  intro hbot
  apply hleft
  apply Subtype.ext
  have hmem : (f ≫ (P.tau ^ 2).asHom).1 ∈ relationIdeal S f g P :=
    TwoSidedIdeal.subset_span (Set.mem_insert _ _)
  rw [hbot] at hmem
  exact hmem

omit [IsAlgClosed k] [Module.Finite k A]
    [LargeIndecomposable.HasBGRSDistributiveHomStructure
      k S.ProjectiveCategory] in
/-- The left square relation belongs to the generated ideal. -/
theorem left_relation_mem
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : LargeIndecomposable.ClosedZigzagTransfer.OrientedRadicalPowerParameter
      (k := k) Y) :
    (f ≫ (P.tau ^ 2).asHom).1 ∈ (relationIdeal S f g P).asIdeal := by
  exact TwoSidedIdeal.subset_span (by simp)

omit [IsAlgClosed k] [Module.Finite k A]
    [LargeIndecomposable.HasBGRSDistributiveHomStructure
      k S.ProjectiveCategory] in
/-- The right square relation belongs to the generated ideal. -/
theorem right_relation_mem
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : LargeIndecomposable.ClosedZigzagTransfer.OrientedRadicalPowerParameter
      (k := k) Y) :
    ((P.tau ^ 2).asHom ≫ g).1 ∈ (relationIdeal S f g P).asIdeal := by
  exact TwoSidedIdeal.subset_span (by simp)

omit [IsAlgClosed k]
    [LargeIndecomposable.HasBGRSDistributiveHomStructure
      k S.ProjectiveCategory] in
/-- The Figure-13 relation ideal is contained in the square of the ambient
Jacobson radical.  Only the middle parameter needs to be radical: the
two-sidedness of `Jac(A)^2` absorbs the outer factors. -/
theorem relationIdeal_le_jacobson_sq
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : LargeIndecomposable.ClosedZigzagTransfer.OrientedRadicalPowerParameter
      (k := k) Y) :
    (relationIdeal S f g P).asIdeal ≤ (Ring.jacobson A) ^ 2 := by
  have htauJ : P.tau.1 ∈ Ring.jacobson A :=
    (S.projectiveEnd_mem_jacobson_iff_val_mem_jacobson Y P.tau).1
      P.mem_jacobson
  have htauSq : ((P.tau ^ 2).asHom).1 ∈ (Ring.jacobson A) ^ 2 := by
    simpa only [pow_two, End.mul_def,
      LargeIndecomposable.SplitBasicIdempotents.ProjectiveCategory.comp_val]
      using Ideal.pow_mem_pow htauJ 2
  have hle : relationIdeal S f g P ≤
      ((Ring.jacobson A) ^ 2).toTwoSided := by
    apply TwoSidedIdeal.span_le.2
    intro a ha
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha
    rcases ha with rfl | rfl
    · apply Ideal.mem_toTwoSided.2
      simpa only [LargeIndecomposable.SplitBasicIdempotents.ProjectiveCategory.comp_val]
        using (Ring.jacobson A ^ 2).mul_mem_right f.1 htauSq
    · apply Ideal.mem_toTwoSided.2
      simpa only [LargeIndecomposable.SplitBasicIdempotents.ProjectiveCategory.comp_val]
        using (Ring.jacobson A ^ 2).mul_mem_left g.1 htauSq
  intro a ha
  exact Ideal.mem_toTwoSided.1 (hle ha)

omit [IsAlgClosed k]
    [LargeIndecomposable.HasBGRSDistributiveHomStructure
      k S.ProjectiveCategory] in
/-- If the two outer arrows are ambient-radical, the two displayed
length-three relations generate an ideal contained in `Jac(A)^3`. -/
theorem relationIdeal_le_jacobson_cube
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : LargeIndecomposable.ClosedZigzagTransfer.OrientedRadicalPowerParameter
      (k := k) Y)
    (hfJ : f.1 ∈ Ring.jacobson A)
    (hgJ : g.1 ∈ Ring.jacobson A) :
    (relationIdeal S f g P).asIdeal ≤ (Ring.jacobson A) ^ 3 := by
  have htauJ : P.tau.1 ∈ Ring.jacobson A :=
    (S.projectiveEnd_mem_jacobson_iff_val_mem_jacobson Y P.tau).1
      P.mem_jacobson
  have htauSq : ((P.tau ^ 2).asHom).1 ∈ (Ring.jacobson A) ^ 2 := by
    simpa only [pow_two, End.mul_def,
      LargeIndecomposable.SplitBasicIdempotents.ProjectiveCategory.comp_val]
      using Ideal.pow_mem_pow htauJ 2
  have hle : relationIdeal S f g P ≤
      ((Ring.jacobson A) ^ 3).toTwoSided := by
    apply TwoSidedIdeal.span_le.2
    intro a ha
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha
    rcases ha with rfl | rfl
    · apply Ideal.mem_toTwoSided.2
      have hmul : ((P.tau ^ 2).asHom).1 * f.1 ∈
          (Ring.jacobson A) ^ 2 * Ring.jacobson A :=
        Ideal.mul_mem_mul htauSq hfJ
      simpa only [LargeIndecomposable.SplitBasicIdempotents.ProjectiveCategory.comp_val,
        ← Submodule.pow_succ] using hmul
    · apply Ideal.mem_toTwoSided.2
      have hmul : g.1 * ((P.tau ^ 2).asHom).1 ∈
          Ring.jacobson A * (Ring.jacobson A) ^ 2 :=
        Ideal.mul_mem_mul hgJ htauSq
      rw [show (3 : ℕ) = 1 + 2 by omega,
        Ideal.IsTwoSided.pow_add, Submodule.pow_one]
      simpa only [LargeIndecomposable.SplitBasicIdempotents.ProjectiveCategory.comp_val]
        using hmul
  intro a ha
  exact Ideal.mem_toTwoSided.1 (hle ha)

omit [IsAlgClosed k]
    [LargeIndecomposable.HasBGRSDistributiveHomStructure
      k S.ProjectiveCategory] in
/-- In particular the relation ideal is a radical ideal, so its quotient
retains the chosen split-basic primitive vertices. -/
theorem relationIdeal_le_jacobson
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : LargeIndecomposable.ClosedZigzagTransfer.OrientedRadicalPowerParameter
      (k := k) Y) :
    (relationIdeal S f g P).asIdeal ≤ Ring.jacobson A := by
  intro a ha
  exact Ideal.pow_le_self (by omega)
    (relationIdeal_le_jacobson_sq S f g P ha)

omit [IsAlgClosed k] [Module.Finite k A]
    [LargeIndecomposable.HasBGRSDistributiveHomStructure
      k S.ProjectiveCategory] in
/-- Either nonzero displayed generator certifies that the relation ideal is
nonzero. -/
theorem relationIdeal_ne_bot_of_left_ne_zero
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : LargeIndecomposable.ClosedZigzagTransfer.OrientedRadicalPowerParameter
      (k := k) Y)
    (hleft : f ≫ (P.tau ^ 2).asHom ≠ 0) :
    relationIdeal S f g P ≠ ⊥ := by
  intro hbot
  have hmem := left_relation_mem S f g P
  rw [hbot] at hmem
  apply hleft
  apply Subtype.ext
  change (f ≫ (P.tau ^ 2).asHom).1 = (0 : A)
  simpa using hmem

/-- The left relation killed before Figure 13 has strictly smaller principal
two-sided span than the adjacent surviving path.  This is the left
stable-composition supplement in BGRS 3.4(d). -/
theorem left_relation_span_lt_adjacent_path
    {X Y : S.ProjectiveCategory}
    (f : X ⟶ Y)
    (P : LargeIndecomposable.ClosedZigzagTransfer.OrientedRadicalPowerParameter
      (k := k) Y)
    (hleft : f ≫ (P.tau ^ 2).asHom ≠ 0) :
    LargeIndecomposable.twoSidedEndomorphismSpan k
        (f ≫ (P.tau ^ 2).asHom) <
      LargeIndecomposable.twoSidedEndomorphismSpan k
        (f ≫ P.tau.asHom) := by
  have hshort : f ≫ P.tau.asHom ≠ 0 := by
    intro hzero
    apply hleft
    calc
      f ≫ (P.tau ^ 2).asHom =
          (f ≫ P.tau.asHom) ≫ P.tau.asHom := by
            rw [pow_two, End.mul_def, Category.assoc]
      _ = 0 := by rw [hzero]; simp
  letI : ∀ T : S.ProjectiveCategory, Module.Finite k (End T) := fun T ↦ by
    change Module.Finite k (T ⟶ T)
    infer_instance
  have hshort' : f ≫ (P.tau ^ 1).asHom ≠ 0 := by
    simpa only [pow_one] using hshort
  simpa only [pow_one] using
    P.postcompose_power_succ_span_lt f 1 hleft hshort'

/-- The right relation killed before Figure 13 has strictly smaller principal
two-sided span than the adjacent surviving path.  This is the source-dual
stable-composition supplement in BGRS 3.4(d). -/
theorem right_relation_span_lt_adjacent_path
    {Y Z : S.ProjectiveCategory}
    (g : Y ⟶ Z)
    (P : LargeIndecomposable.ClosedZigzagTransfer.OrientedRadicalPowerParameter
      (k := k) Y)
    (hright : (P.tau ^ 2).asHom ≫ g ≠ 0) :
    LargeIndecomposable.twoSidedEndomorphismSpan k
        ((P.tau ^ 2).asHom ≫ g) <
      LargeIndecomposable.twoSidedEndomorphismSpan k
        (P.tau.asHom ≫ g) := by
  have hshort : P.tau.asHom ≫ g ≠ 0 := by
    intro hzero
    apply hright
    calc
      (P.tau ^ 2).asHom ≫ g =
          P.tau.asHom ≫ (P.tau.asHom ≫ g) := by
            rw [pow_two, End.mul_def, Category.assoc]
      _ = 0 := by rw [hzero]; simp
  letI : ∀ T : S.ProjectiveCategory, Module.Finite k (End T) := fun T ↦ by
    change Module.Finite k (T ⟶ T)
    infer_instance
  have hshort' : (P.tau ^ 1).asHom ≫ g ≠ 0 := by
    simpa only [pow_one] using hshort
  simpa only [pow_one] using
    P.precompose_power_succ_span_lt g 1 hright hshort'

omit [LargeIndecomposable.HasBGRSDistributiveHomStructure
  k S.ProjectiveCategory] in
private theorem postcompose_power_mem_span_of_mem
    {X Y : S.ProjectiveCategory}
    (f p : X ⟶ Y)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (hp : p ∈ twoSidedEndomorphismSpan k f) (n : ℕ) :
    p ≫ (P.tau ^ n).asHom ∈
      twoSidedEndomorphismSpan k (f ≫ (P.tau ^ n).asHom) := by
  induction hp using Submodule.span_induction with
  | mem p hp =>
      rcases hp with ⟨a, b, rfl⟩
      letI : Module.Finite k (End Y) := by
        change Module.Finite k (Y ⟶ Y)
        infer_instance
      apply Submodule.subset_span
      refine ⟨a, b, ?_⟩
      have hcomm := congrArg End.asHom (P.mul_comm b (P.tau ^ n))
      change ((a.asHom ≫ f) ≫ b.asHom) ≫
          (P.tau ^ n).asHom =
        (a.asHom ≫ (f ≫ (P.tau ^ n).asHom)) ≫ b.asHom
      simpa only [End.mul_def, Category.assoc] using
        congrArg (fun q : Y ⟶ Y ↦ a.asHom ≫ (f ≫ q)) hcomm.symm
  | zero => simp
  | add p q _ _ hp hq =>
      simpa [Preadditive.add_comp] using
        (twoSidedEndomorphismSpan k
          (f ≫ (P.tau ^ n).asHom)).add_mem hp hq
  | smul c p _ hp =>
      simpa using (twoSidedEndomorphismSpan k
        (f ≫ (P.tau ^ n).asHom)).smul_mem c hp

omit [LargeIndecomposable.HasBGRSDistributiveHomStructure
  k S.ProjectiveCategory] in
private theorem precompose_power_mem_span_of_mem
    {Y Z : S.ProjectiveCategory}
    (g q : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (hq : q ∈ twoSidedEndomorphismSpan k g) (n : ℕ) :
    (P.tau ^ n).asHom ≫ q ∈
      twoSidedEndomorphismSpan k ((P.tau ^ n).asHom ≫ g) := by
  induction hq using Submodule.span_induction with
  | mem q hq =>
      rcases hq with ⟨a, b, rfl⟩
      letI : Module.Finite k (End Y) := by
        change Module.Finite k (Y ⟶ Y)
        infer_instance
      apply Submodule.subset_span
      refine ⟨a, b, ?_⟩
      have hcomm := congrArg End.asHom (P.mul_comm a (P.tau ^ n))
      change (P.tau ^ n).asHom ≫ ((a.asHom ≫ g) ≫ b.asHom) =
        (a.asHom ≫ ((P.tau ^ n).asHom ≫ g)) ≫ b.asHom
      simpa only [End.mul_def, Category.assoc] using
        congrArg (fun q : Y ⟶ Y ↦ (q ≫ g) ≫ b.asHom) hcomm
  | zero => simp
  | add p q _ _ hp hq =>
      simpa [Preadditive.comp_add] using
        (twoSidedEndomorphismSpan k
          ((P.tau ^ n).asHom ≫ g)).add_mem hp hq
  | smul c p _ hp =>
      simpa using (twoSidedEndomorphismSpan k
        ((P.tau ^ n).asHom ≫ g)).smul_mem c hp

omit [LargeIndecomposable.HasBGRSDistributiveHomStructure
  k S.ProjectiveCategory] in
/-- If the outer Hom space is generated by `f`, the full two-generator
relation ideal contributes only the left relation span in the `X`-to-`Y`
corner. -/
theorem relationIdeal_corner_left_le
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (hfspan : twoSidedEndomorphismSpan k f = ⊤) :
    finiteIdealCorner S (relationIdeal S f g P) X Y ≤
      twoSidedEndomorphismSpan k (f ≫ (P.tau ^ 2).asHom) := by
  rw [relationIdeal, finiteIdealCorner_span_pair_eq]
  apply sup_le
  · rw [morphismFactorSpan_self]
  · apply Submodule.span_le.2
    rintro h ⟨a, b, rfl⟩
    have ha : a ∈ twoSidedEndomorphismSpan k f := by
      rw [hfspan]
      trivial
    have haPow := postcompose_power_mem_span_of_mem S f a P ha 2
    let c : End Y := End.of (g ≫ b)
    have hmem := (isHomSubbimodule_twoSidedEndomorphismSpan
      (f ≫ (P.tau ^ 2).asHom)).2 c haPow
    change (a ≫ (P.tau ^ 2).asHom) ≫ (g ≫ b) ∈ _ at hmem
    convert hmem using 1
    all_goals simp only [Category.assoc]; rfl

omit [LargeIndecomposable.HasBGRSDistributiveHomStructure
  k S.ProjectiveCategory] in
/-- Source-dually, if the right outer Hom space is generated by `g`, the
full relation ideal contributes only the right relation span in the
`Y`-to-`Z` corner. -/
theorem relationIdeal_corner_right_le
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (hgspan : twoSidedEndomorphismSpan k g = ⊤) :
    finiteIdealCorner S (relationIdeal S f g P) Y Z ≤
      twoSidedEndomorphismSpan k ((P.tau ^ 2).asHom ≫ g) := by
  rw [relationIdeal, finiteIdealCorner_span_pair_eq]
  apply sup_le
  · apply Submodule.span_le.2
    rintro h ⟨a, b, rfl⟩
    have hb : b ∈ twoSidedEndomorphismSpan k g := by
      rw [hgspan]
      trivial
    have hbPow := precompose_power_mem_span_of_mem S g b P hb 2
    let c : End Y := End.of (a ≫ f)
    have hmem := (isHomSubbimodule_twoSidedEndomorphismSpan
      ((P.tau ^ 2).asHom ≫ g)).1 c hbPow
    change (a ≫ f) ≫ ((P.tau ^ 2).asHom ≫ b) ∈ _ at hmem
    convert hmem using 1
    all_goals simp only [Category.assoc]; rfl
  · rw [morphismFactorSpan_self]

omit [IsAlgClosed k]
    [LargeIndecomposable.HasBGRSDistributiveHomStructure
      k S.ProjectiveCategory] in
private theorem postcycle_mem_jacobson
    {X Y : S.ProjectiveCategory} (hXY : X ≠ Y)
    (f : X ⟶ Y) (a : Y ⟶ X) :
    End.of (a ≫ f) ∈ Ring.jacobson (End Y) := by
  apply (S.projectiveEnd_mem_jacobson_iff_val_mem_jacobson
    Y (End.of (a ≫ f))).2
  change (a ≫ f).1 ∈ Ring.jacobson A
  rw [LargeIndecomposable.SplitBasicIdempotents.ProjectiveCategory.comp_val]
  exact (Ring.jacobson A).mul_mem_right a.1
    (LargeIndecomposable.SplitBasicIdempotents.ProjectiveCategory.offDiagonal_val_mem_jacobson
      S hXY f)

omit [IsAlgClosed k]
    [LargeIndecomposable.HasBGRSDistributiveHomStructure
      k S.ProjectiveCategory] in
private theorem precycle_mem_jacobson
    {Y Z : S.ProjectiveCategory} (hYZ : Y ≠ Z)
    (g : Y ⟶ Z) (b : Z ⟶ Y) :
    End.of (g ≫ b) ∈ Ring.jacobson (End Y) := by
  apply (S.projectiveEnd_mem_jacobson_iff_val_mem_jacobson
    Y (End.of (g ≫ b))).2
  change (g ≫ b).1 ∈ Ring.jacobson A
  rw [LargeIndecomposable.SplitBasicIdempotents.ProjectiveCategory.comp_val]
  exact (Ring.jacobson A).mul_mem_left b.1
    (LargeIndecomposable.SplitBasicIdempotents.ProjectiveCategory.offDiagonal_val_mem_jacobson
      S hYZ g)

omit [LargeIndecomposable.HasBGRSDistributiveHomStructure
  k S.ProjectiveCategory] in
/-- At the middle vertex, every contribution from the two outer relation
generators acquires one additional radical factor.  Thus the whole selected
corner lies in the principal span of `tau^3`. -/
theorem relationIdeal_corner_middle_le
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (hXY : X ≠ Y) (hYZ : Y ≠ Z) :
    finiteIdealCorner S (relationIdeal S f g P) Y Y ≤
      twoSidedEndomorphismSpan k (P.tau ^ 3).asHom := by
  letI : Module.Finite k (End Y) := by
    change Module.Finite k (Y ⟶ Y)
    infer_instance
  rw [relationIdeal, finiteIdealCorner_span_pair_eq]
  apply sup_le
  · apply Submodule.span_le.2
    rintro h ⟨a, b, rfl⟩
    let c : End Y := End.of (a ≫ f)
    have hcJ : c ∈ Ring.jacobson (End Y) :=
      postcycle_mem_jacobson S hXY f a
    have hcSpan : c.asHom ∈ twoSidedEndomorphismSpan k P.tau.asHom := by
      rw [show c.asHom = c by rfl, P.span_eq]
      exact hcJ
    have hcPow := postcompose_power_mem_span_of_mem
      S P.tau.asHom c.asHom P hcSpan 2
    have hpow : P.tau.asHom ≫ (P.tau ^ 2).asHom =
        (P.tau ^ 3).asHom := by
      rw [← End.mul_def, ← pow_succ]
    rw [hpow] at hcPow
    let d : End Y := End.of b
    have hmem := (isHomSubbimodule_twoSidedEndomorphismSpan
      (P.tau ^ 3).asHom).2 d hcPow
    change (c.asHom ≫ (P.tau ^ 2).asHom) ≫ b ∈ _ at hmem
    convert hmem using 1
    all_goals simp only [c, Category.assoc]; rfl

  · apply Submodule.span_le.2
    rintro h ⟨a, b, rfl⟩
    let c : End Y := End.of (g ≫ b)
    have hcJ : c ∈ Ring.jacobson (End Y) :=
      precycle_mem_jacobson S hYZ g b
    have hcSpan : c.asHom ∈ twoSidedEndomorphismSpan k P.tau.asHom := by
      rw [show c.asHom = c by rfl, P.span_eq]
      exact hcJ
    have hcPow := precompose_power_mem_span_of_mem
      S P.tau.asHom c.asHom P hcSpan 2
    have hpow : (P.tau ^ 2).asHom ≫ P.tau.asHom =
        (P.tau ^ 3).asHom := by
      rw [← End.mul_def, P.mul_comm, ← pow_succ]
    rw [hpow] at hcPow
    let d : End Y := End.of a
    have hmem := (isHomSubbimodule_twoSidedEndomorphismSpan
      (P.tau ^ 3).asHom).1 d hcPow
    change a ≫ ((P.tau ^ 2).asHom ≫ c.asHom) ∈ _ at hmem
    convert hmem using 1
    all_goals simp only [c, Category.assoc]; rfl

/-- The subspace of `X ⟶ Z` obtained by inserting the square of the middle
Jacobson radical between `f` and `g`. -/
def middleJacobsonSquareSandwichSubmodule
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z) : Submodule k (X ⟶ Z) :=
  ((Ring.jacobson (End Y)) ^ 2).restrictScalars k |>.map
    (LargeIndecomposable.middleEndomorphismSandwich (k := k) f g)

omit [IsAlgClosed k] [Module.Finite k A]
    [LargeIndecomposable.HasBGRSDistributiveHomStructure
      k S.ProjectiveCategory] in
/-- With the transit directions occurring in the hard branch of Roiter's
lemma, the outer corner of the relation ideal lies in the sandwiches with a
middle factor in `Jac(End Y)^2`. -/
theorem relationIdeal_corner_cross_le
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (hfspan : twoSidedEndomorphismSpan k f = ⊤)
    (hgspan : twoSidedEndomorphismSpan k g = ⊤)
    (hfT : AllowsTransit f) (hgC : AllowsCotransit g) :
    finiteIdealCorner S (relationIdeal S f g P) X Z ≤
      middleJacobsonSquareSandwichSubmodule S f g := by
  have htauSq : P.tau ^ 2 ∈ (Ring.jacobson (End Y)) ^ 2 :=
    Ideal.pow_mem_pow P.mem_jacobson 2
  rw [relationIdeal, finiteIdealCorner_span_pair_eq]
  apply sup_le
  · apply Submodule.span_le.2
    rintro h ⟨a, b, rfl⟩
    obtain ⟨d, had⟩ := hfT (End.of a)
    have hbSpan : b ∈ twoSidedEndomorphismSpan k g := by
      rw [hgspan]
      trivial
    obtain ⟨c, hbc⟩ :=
      exists_comp_left_of_mem_twoSidedSpan_of_allowsCotransit hgC hbSpan
    let q : End Y := (c * P.tau ^ 2) * d
    have hq : q ∈ (Ring.jacobson (End Y)) ^ 2 :=
      ((Ring.jacobson (End Y)) ^ 2).mul_mem_right d
        (((Ring.jacobson (End Y)) ^ 2).mul_mem_left c htauSq)
    apply Submodule.mem_map.2
    refine ⟨q, hq, ?_⟩
    dsimp [middleJacobsonSquareSandwichSubmodule]
    change a ≫ f = f ≫ d.asHom at had
    calc
      (f ≫ q.asHom) ≫ g =
          ((f ≫ d.asHom) ≫ (P.tau ^ 2).asHom) ≫
            (c.asHom ≫ g) := by
              dsimp [q]
              simp only [Category.assoc]
      _ = ((a ≫ f) ≫ (P.tau ^ 2).asHom) ≫ b := by
        rw [had, hbc]
      _ = (a ≫ (f ≫ (P.tau ^ 2).asHom)) ≫ b := by
        simp only [← Category.assoc]
  · apply Submodule.span_le.2
    rintro h ⟨a, b, rfl⟩
    have haSpan : a ∈ twoSidedEndomorphismSpan k f := by
      rw [hfspan]
      trivial
    obtain ⟨d, had⟩ :=
      exists_comp_right_of_mem_twoSidedSpan_of_allowsTransit hfT haSpan
    obtain ⟨c, hbc⟩ := hgC (End.of b)
    let q : End Y := (c * P.tau ^ 2) * d
    have hq : q ∈ (Ring.jacobson (End Y)) ^ 2 :=
      ((Ring.jacobson (End Y)) ^ 2).mul_mem_right d
        (((Ring.jacobson (End Y)) ^ 2).mul_mem_left c htauSq)
    apply Submodule.mem_map.2
    refine ⟨q, hq, ?_⟩
    dsimp [middleJacobsonSquareSandwichSubmodule]
    change g ≫ b = c.asHom ≫ g at hbc
    calc
      (f ≫ q.asHom) ≫ g =
          ((f ≫ d.asHom) ≫ (P.tau ^ 2).asHom) ≫
            (c.asHom ≫ g) := by
              dsimp [q]
              simp only [Category.assoc]
      _ = (a ≫ (P.tau ^ 2).asHom) ≫ (g ≫ b) := by
        rw [had, hbc]
      _ = (a ≫ ((P.tau ^ 2).asHom ≫ g)) ≫ b := by
        simp only [Category.assoc]

/-- The adjacent left path `f tau` is not killed by the full two-generator
relation ideal. -/
theorem left_adjacent_not_mem_relationIdeal
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (hfspan : twoSidedEndomorphismSpan k f = ⊤)
    (hleft : f ≫ (P.tau ^ 2).asHom ≠ 0) :
    (f ≫ P.tau.asHom).1 ∉ (relationIdeal S f g P).asIdeal := by
  intro hmem
  have hcorner : f ≫ P.tau.asHom ∈
      finiteIdealCorner S (relationIdeal S f g P) X Y := hmem
  have hrel := relationIdeal_corner_left_le S f g P hfspan hcorner
  have hle := twoSidedEndomorphismSpan_le_of_mem hrel
  exact (left_relation_span_lt_adjacent_path S f P hleft).2 hle

/-- The adjacent right path `tau g` is not killed by the full two-generator
relation ideal. -/
theorem right_adjacent_not_mem_relationIdeal
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (hgspan : twoSidedEndomorphismSpan k g = ⊤)
    (hright : (P.tau ^ 2).asHom ≫ g ≠ 0) :
    (P.tau.asHom ≫ g).1 ∉ (relationIdeal S f g P).asIdeal := by
  intro hmem
  have hcorner : P.tau.asHom ≫ g ∈
      finiteIdealCorner S (relationIdeal S f g P) Y Z := hmem
  have hrel := relationIdeal_corner_right_le S f g P hgspan hcorner
  have hle := twoSidedEndomorphismSpan_le_of_mem hrel
  exact (right_relation_span_lt_adjacent_path S g P hright).2 hle

