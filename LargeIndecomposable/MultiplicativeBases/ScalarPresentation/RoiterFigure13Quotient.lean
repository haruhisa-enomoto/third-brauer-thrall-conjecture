/-- A principal Hom generator remains a generator after the full Figure-13
quotient functor. -/
theorem quotientFunctor_map_span_eq_top
    {X Y Z U V : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (a : U ⟶ V) (ha : twoSidedEndomorphismSpan k a = ⊤) :
    twoSidedEndomorphismSpan k ((quotientFunctor S f g P).map a) = ⊤ := by
  apply top_unique
  intro b _
  obtain ⟨c, rfl⟩ := (quotientFunctor S f g P).map_surjective b
  apply quotientFunctor_map_mem_twoSidedEndomorphismSpan S f g P
  rw [ha]
  trivial

