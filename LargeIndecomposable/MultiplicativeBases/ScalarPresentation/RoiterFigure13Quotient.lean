/-- Transit passes through the full Figure-13 quotient functor. -/
theorem quotientFunctor_map_allowsTransit
    {X Y Z U V : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (a : U ⟶ V) (ha : AllowsTransit a) :
    AllowsTransit ((quotientFunctor S f g P).map a) := by
  intro c
  obtain ⟨c₀, hc₀⟩ :=
    (quotientFunctor S f g P).map_surjective c.asHom
  obtain ⟨d₀, hd₀⟩ := ha (End.of c₀)
  refine ⟨End.of ((quotientFunctor S f g P).map d₀.asHom), ?_⟩
  change c.asHom ≫ (quotientFunctor S f g P).map a =
    (quotientFunctor S f g P).map a ≫
      (quotientFunctor S f g P).map d₀.asHom
  rw [← hc₀, ← Functor.map_comp, hd₀, Functor.map_comp]

