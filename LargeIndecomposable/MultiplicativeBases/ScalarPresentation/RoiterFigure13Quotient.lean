/-- The right Figure-13 arrow still generates its whole quotient Hom space. -/
theorem quotientDiagram_beta_span_eq_top
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (hgspan : twoSidedEndomorphismSpan k g = ⊤) :
    twoSidedEndomorphismSpan k (quotientDiagram S f g P).beta = ⊤ := by
  exact quotientFunctor_map_span_eq_top S f g P g hgspan

omit [IsAlgClosed k]
    [LargeIndecomposable.HasBGRSDistributiveHomStructure
      k S.ProjectiveCategory] in
/-- Nonexceptionality of the hard outer composite descends to the Figure-13
quotient.  A quotient exceptional equation lifts modulo the relation ideal;
the selected outer-corner estimate absorbs that error into another middle
Jacobson-square sandwich and hence gives an ambient exceptional witness. -/
theorem quotientDiagram_not_special_of_not_special
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (hfspan : twoSidedEndomorphismSpan k f = ⊤)
    (hgspan : twoSidedEndomorphismSpan k g = ⊤)
    (hfT : AllowsTransit f) (hgC : AllowsCotransit g)
    (hns : ¬ LargeIndecomposable.IsBGRSSpecialZero f g) :
    ¬ LargeIndecomposable.IsBGRSSpecialZero
      (quotientDiagram S f g P).alpha
      (quotientDiagram S f g P).beta := by
  let F := quotientFunctor S f g P
  rintro ⟨rhoBar, hrhoBar⟩
  obtain ⟨rho₀, hrho₀⟩ := F.map_surjective rhoBar.1.asHom
  let rho : End Y := End.of rho₀
  have hrhoBarVal : rhoBar.1.1 ∈
      Ring.jacobson (A ⧸ (relationIdeal S f g P).asIdeal) :=
    ((quotientSplitBasic S f g P).projectiveEnd_mem_jacobson_iff_val_mem_jacobson
      (F.obj Y) rhoBar.1).1 rhoBar.2
  have hrho₀Quotient : Ideal.Quotient.mk
      (relationIdeal S f g P).asIdeal rho₀.1 ∈
        Ring.jacobson (A ⧸ (relationIdeal S f g P).asIdeal) := by
    rw [← S.projectiveQuotientFunctor_map_val]
    change (F.map rho₀).1 ∈ _
    rw [hrho₀]
    exact hrhoBarVal
  have hrhoVal : rho₀.1 ∈ Ring.jacobson A :=
    (LargeIndecomposable.TwoSidedIdeal.quotient_mk_mem_jacobson_iff
      (relationIdeal S f g P) (relationIdeal_le_jacobson S f g P) rho₀.1).1
        hrho₀Quotient
  have hrhoJ : rho ∈ Ring.jacobson (End Y) :=
    (S.projectiveEnd_mem_jacobson_iff_val_mem_jacobson Y rho).2 hrhoVal
  let d : X ⟶ Z := f ≫ g - (f ≫ rho.asHom) ≫ g
  have hdMap : F.map d = 0 := by
    dsimp [d]
    rw [F.map_sub, F.map_comp, F.map_comp, F.map_comp, hrho₀]
    change (quotientDiagram S f g P).alpha ≫
        (quotientDiagram S f g P).beta -
      ((quotientDiagram S f g P).alpha ≫ rhoBar.1.asHom) ≫
        (quotientDiagram S f g P).beta = 0
    exact sub_eq_zero.mpr hrhoBar
  have hdIdeal : d.1 ∈ (relationIdeal S f g P).asIdeal :=
    (S.projectiveQuotientFunctor_map_eq_zero_iff
      (relationIdeal S f g P) (relationIdeal_le_jacobson S f g P) d).1
        hdMap
  have hdCorner : d ∈ finiteIdealCorner S (relationIdeal S f g P) X Z :=
    hdIdeal
  have hdSquare := relationIdeal_corner_cross_le
    S f g P hfspan hgspan hfT hgC hdCorner
  rcases hdSquare with ⟨q, hq, hqeq⟩
  change (f ≫ q.asHom) ≫ g = d at hqeq
  have hqJ : q ∈ Ring.jacobson (End Y) :=
    Ideal.pow_le_self (by omega) hq
  apply hns
  refine ⟨⟨rho + q, (Ring.jacobson (End Y)).add_mem hrhoJ hqJ⟩, ?_⟩
  calc
    f ≫ g = (f ≫ rho.asHom) ≫ g + d := by
      dsimp [d]
      abel
    _ = (f ≫ rho.asHom) ≫ g + (f ≫ q.asHom) ≫ g := by
      rw [hqeq]
    _ = (f ≫ (rho + q).asHom) ≫ g := by
      change (f ≫ rho.asHom) ≫ g + (f ≫ q.asHom) ≫ g =
        (f ≫ (rho.asHom + q.asHom)) ≫ g
      rw [Preadditive.comp_add, Preadditive.add_comp]

omit [IsAlgClosed k] in
/-- Every middle-radical insertion strictly lowers the outer Figure-13 path
span in the quotient.  This is the hard stable-composition supplement after
nonexceptionality has been transported through the relation ideal. -/
theorem quotientDiagram_middleRadical_span_lt_cross_of_not_special
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (hfspan : twoSidedEndomorphismSpan k f = ⊤)
    (hgspan : twoSidedEndomorphismSpan k g = ⊤)
    (hfT : AllowsTransit f) (hgC : AllowsCotransit g)
    (hns : ¬ LargeIndecomposable.IsBGRSSpecialZero f g)
    (m : End (quotientDiagram S f g P).center)
    (hm : m ∈ Ring.jacobson
      (End (quotientDiagram S f g P).center)) :
    twoSidedEndomorphismSpan k
        (((quotientDiagram S f g P).alpha ≫ m.asHom) ≫
          (quotientDiagram S f g P).beta) <
      twoSidedEndomorphismSpan k
        ((quotientDiagram S f g P).alpha ≫
          (quotientDiagram S f g P).beta) := by
  exact middleRadical_span_lt_of_not_special
    (k := k)
    (quotientDiagram S f g P).alpha
    (quotientDiagram S f g P).beta
    (quotientFunctor_map_allowsTransit S f g P f hfT)
    (quotientFunctor_map_allowsCotransit S f g P g hgC)
    m hm
    (quotientDiagram_not_special_of_not_special
      S f g P hfspan hgspan hfT hgC hns)

/-- The left adjacent length-two Figure-13 path survives the quotient. -/
theorem quotientDiagram_left_adjacent_ne_zero
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (hfspan : twoSidedEndomorphismSpan k f = ⊤)
    (hleft : f ≫ (P.tau ^ 2).asHom ≠ 0) :
    (quotientDiagram S f g P).alpha ≫
      (quotientDiagram S f g P).tauLower ≠ 0 := by
  change (S.projectiveQuotientFunctor (relationIdeal S f g P)
      (relationIdeal_le_jacobson S f g P)).map f ≫
    (S.projectiveQuotientFunctor (relationIdeal S f g P)
      (relationIdeal_le_jacobson S f g P)).map P.tau.asHom ≠ 0
  rw [← Functor.map_comp]
  intro hzero
  exact (left_adjacent_not_mem_relationIdeal S f g P hfspan hleft)
    ((S.projectiveQuotientFunctor_map_eq_zero_iff
      (relationIdeal S f g P) (relationIdeal_le_jacobson S f g P)
      (f ≫ P.tau.asHom)).1 hzero)

omit [LargeIndecomposable.HasBGRSDistributiveHomStructure
  k S.ProjectiveCategory] in
/-- The middle length-two Figure-13 path, represented by `tau^2`, survives
the quotient when its neighboring vertices are distinct. -/
theorem quotientDiagram_middle_square_ne_zero
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (hXY : X ≠ Y) (hYZ : Y ≠ Z)
    (hleft : f ≫ (P.tau ^ 2).asHom ≠ 0) :
    (quotientDiagram S f g P).tauUpper ≫
      (quotientDiagram S f g P).tauLower ≠ 0 := by
  change (S.projectiveQuotientFunctor (relationIdeal S f g P)
      (relationIdeal_le_jacobson S f g P)).map P.tau.asHom ≫
    (S.projectiveQuotientFunctor (relationIdeal S f g P)
      (relationIdeal_le_jacobson S f g P)).map P.tau.asHom ≠ 0
  rw [← Functor.map_comp]
  intro hzero
  apply middle_square_not_mem_relationIdeal S f g P hXY hYZ hleft
  simpa only [← End.mul_def, ← pow_two] using
    (S.projectiveQuotientFunctor_map_eq_zero_iff
      (relationIdeal S f g P) (relationIdeal_le_jacobson S f g P)
      (P.tau.asHom ≫ P.tau.asHom)).1 hzero

/-- The middle loop remains an oriented radical-power parameter in the
Figure-13 quotient.  The selected-corner estimate shows its square survives;
fullness of the quotient and radical detection show that its image still
generates the entire local radical. -/
def quotientMiddlePowerParameter
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (hXY : X ≠ Y) (hYZ : Y ≠ Z)
    (hleft : f ≫ (P.tau ^ 2).asHom ≠ 0) :
    OrientedRadicalPowerParameter (k := k)
      ((quotientFunctor S f g P).obj Y) := by
  let tauBar : End ((quotientFunctor S f g P).obj Y) :=
    End.of ((quotientFunctor S f g P).map P.tau.asHom)
  have hspan : twoSidedEndomorphismSpan k tauBar =
      (Ring.jacobson
        (End ((quotientFunctor S f g P).obj Y))).restrictScalars k :=
    quotientFunctor_middle_span_eq_jacobson S f g P
  have htauJ : tauBar ∈
      Ring.jacobson (End ((quotientFunctor S f g P).obj Y)) := by
    have htauSpan := mem_twoSidedEndomorphismSpan k tauBar
    rw [hspan] at htauSpan
    exact htauSpan
  have htau0 : tauBar ≠ 0 := by
    have hsquare := quotientDiagram_middle_square_ne_zero
      S f g P hXY hYZ hleft
    change tauBar.asHom ≫ tauBar.asHom ≠ 0 at hsquare
    intro hzero
    apply hsquare
    have hzeroHom : tauBar.asHom = 0 := congrArg End.asHom hzero
    rw [hzeroHom]
    simp
  exact
    { tau := tauBar
      mem_jacobson := htauJ
      ne_zero := htau0
      span_eq := hspan
      power_factorization :=
        hasOrientedRadicalPowerFactorization_of_span_eq
          tauBar htauJ hspan
            (LargeIndecomposable.HasBGRSDistributiveHomStructure.transit_or_cotransit
              (k := k)
              (C := (quotientSplitBasic S f g P).ProjectiveCategory)
              tauBar) }

/-- The right adjacent length-two Figure-13 path survives the quotient. -/
theorem quotientDiagram_right_adjacent_ne_zero
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (hgspan : twoSidedEndomorphismSpan k g = ⊤)
    (hright : (P.tau ^ 2).asHom ≫ g ≠ 0) :
    (quotientDiagram S f g P).tauUpper ≫
      (quotientDiagram S f g P).beta ≠ 0 := by
  change (S.projectiveQuotientFunctor (relationIdeal S f g P)
      (relationIdeal_le_jacobson S f g P)).map P.tau.asHom ≫
    (S.projectiveQuotientFunctor (relationIdeal S f g P)
      (relationIdeal_le_jacobson S f g P)).map g ≠ 0
  rw [← Functor.map_comp]
  intro hzero
  exact (right_adjacent_not_mem_relationIdeal S f g P hgspan hright)
    ((S.projectiveQuotientFunctor_map_eq_zero_iff
      (relationIdeal S f g P) (relationIdeal_le_jacobson S f g P)
      (P.tau.asHom ≫ g)).1 hzero)

/-- The quotient middle parameter admits coherent scalar coefficients through
degrees zero, one, and two.  Multiplication by the surviving middle loop
shifts the degree-one coefficient to the residue and the degree-two
coefficient to the degree-one coefficient. -/
theorem quotientMiddle_radicalSquareCoefficientData
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (hXY : X ≠ Y) (hYZ : Y ≠ Z)
    (hleft : f ≫ (P.tau ^ 2).asHom ≠ 0) :
    let Pbar := quotientMiddlePowerParameter S f g P hXY hYZ hleft
    Nonempty (RadicalSquareCoefficientData
      ((quotientSplitBasic S f g P).projectiveEndResidue
        ((quotientFunctor S f g P).obj Y)) Pbar.tau) := by
  dsimp only
  let Q := quotientSplitBasic S f g P
  let F := quotientFunctor S f g P
  let Pbar := quotientMiddlePowerParameter S f g P hXY hYZ hleft
  let Ybar := F.obj Y
  letI : Module.Finite k (End Ybar) := by
    change Module.Finite k (Ybar ⟶ Ybar)
    infer_instance
  have htauSq0 : Pbar.tau * Pbar.tau ≠ 0 := by
    have hsquare := quotientDiagram_middle_square_ne_zero
      S f g P hXY hYZ hleft
    change Pbar.tau.asHom ≫ Pbar.tau.asHom ≠ 0 at hsquare
    intro hzero
    apply hsquare
    have hzeroHom := congrArg End.asHom hzero
    change Pbar.tau.asHom ≫ Pbar.tau.asHom = 0 at hzeroHom
    exact hzeroHom
  apply exists_radicalSquareCoefficientData
    (Q.projectiveEndResidue Ybar) Pbar.tau Pbar.ne_zero htauSq0
  · intro a
    exact Q.projectiveEnd_isUnit_iff_residue_ne_zero Ybar a
  · intro a ha
    have haJ : a ∈ Ring.jacobson (End Ybar) := by
      rw [Q.projectiveEnd_mem_jacobson_iff_val_mem_jacobson,
        ← Q.projectiveEndResidue_eq_zero_iff_val_mem_jacobson]
      exact ha
    rcases Pbar.power_factorization with hT | hC
    · obtain ⟨q, hq⟩ := hT.generates a haJ
      refine ⟨q, ?_⟩
      apply End.ext
      simpa only [End.mul_def] using hq
    · obtain ⟨q, hq⟩ := hC.generates a haJ
      refine ⟨q, ?_⟩
      rw [Pbar.mul_comm q Pbar.tau]
      apply End.ext
      simpa only [End.mul_def] using hq

/-- In the exact nonexceptional quotient branch, the coherent middle
coefficients extend simultaneously to both Figure-13 arms and to the outer
composite.  Thus the seven distinct coefficient maps governing all eight
nonidentity source paths are already compatible and normalized; only their
finite whiskering-table assembly
into a thin-path retraction remains. -/
theorem quotientDiagram_figure13CoefficientExtensionData
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (hfspan : twoSidedEndomorphismSpan k f = ⊤)
    (hgspan : twoSidedEndomorphismSpan k g = ⊤)
    (hXY : X ≠ Y) (hYZ : Y ≠ Z)
    (hfT : AllowsTransit f) (hgC : AllowsCotransit g)
    (hleft : f ≫ (P.tau ^ 2).asHom ≠ 0)
    (hright : (P.tau ^ 2).asHom ≫ g ≠ 0)
    (hns : ¬ IsBGRSSpecialZero f g) :
    let Pbar := quotientMiddlePowerParameter S f g P hXY hYZ hleft
    let middle := Classical.choice
      (quotientMiddle_radicalSquareCoefficientData
        S f g P hXY hYZ hleft)
    Nonempty (Figure13CoefficientExtensionData
      (quotientDiagram S f g P).alpha
      (quotientDiagram S f g P).beta
      ((quotientSplitBasic S f g P).projectiveEndResidue
        ((quotientFunctor S f g P).obj Y)) Pbar.tau middle) := by
  dsimp only
  let Q := quotientSplitBasic S f g P
  let F := quotientFunctor S f g P
  let Ybar := F.obj Y
  let Pbar := quotientMiddlePowerParameter S f g P hXY hYZ hleft
  let middle := Classical.choice
    (quotientMiddle_radicalSquareCoefficientData
      S f g P hXY hYZ hleft)
  letI : Module.Finite k (End Ybar) := by
    change Module.Finite k (Ybar ⟶ Ybar)
    infer_instance
  have hfactor : ∀ a : End Ybar,
      Q.projectiveEndResidue Ybar a = 0 →
        ∃ q : End Ybar, a = q * Pbar.tau := by
    intro a ha
    have haJ : a ∈ Ring.jacobson (End Ybar) := by
      rw [Q.projectiveEnd_mem_jacobson_iff_val_mem_jacobson,
        ← Q.projectiveEndResidue_eq_zero_iff_val_mem_jacobson]
      exact ha
    rcases Pbar.power_factorization with hT | hC
    · obtain ⟨q, hq⟩ := hT.generates a haJ
      refine ⟨q, ?_⟩
      apply End.ext
      simpa only [End.mul_def] using hq
    · obtain ⟨q, hq⟩ := hC.generates a haJ
      refine ⟨q, ?_⟩
      rw [Pbar.mul_comm q Pbar.tau]
      apply End.ext
      simpa only [End.mul_def] using hq
  have halphaTauNative := quotientDiagram_left_adjacent_ne_zero
    S f g P hfspan hleft
  have halpha : (quotientDiagram S f g P).alpha ≠ 0 := by
    intro hzero
    apply halphaTauNative
    rw [hzero]
    simp
  have halphaTau := halphaTauNative
  change (quotientDiagram S f g P).alpha ≫
    Pbar.tau.asHom ≠ 0 at halphaTau
  have htauBetaNative := quotientDiagram_right_adjacent_ne_zero
    S f g P hgspan hright
  have hbeta : (quotientDiagram S f g P).beta ≠ 0 := by
    intro hzero
    apply htauBetaNative
    rw [hzero]
    simp
  have htauBeta := htauBetaNative
  change Pbar.tau.asHom ≫
    (quotientDiagram S f g P).beta ≠ 0 at htauBeta
  apply exists_figure13CoefficientExtensionData
    (quotientDiagram S f g P).alpha
    (quotientDiagram S f g P).beta
    (Q.projectiveEndResidue Ybar) Pbar.tau middle
    (fun a ↦ Q.projectiveEnd_isUnit_iff_residue_ne_zero Ybar a)
    hfactor (fun a ↦ Pbar.mul_comm a Pbar.tau)
    halpha halphaTau hbeta htauBeta
  intro a haUnit
  exact Q.projective_middleUnitComposite_ne_zero_of_not_bgrsSpecial
    (quotientDiagram S f g P).alpha
    (quotientDiagram S f g P).beta a haUnit
    (quotientDiagram_not_special_of_not_special
      S f g P hfspan hgspan hfT hgC hns)

/-- The surviving middle square has strictly smaller span than the middle
arrow in the Figure-13 quotient. -/
theorem quotientDiagram_middle_square_span_lt_middle_arrow
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (hXY : X ≠ Y) (hYZ : Y ≠ Z)
    (hleft : f ≫ (P.tau ^ 2).asHom ≠ 0) :
    twoSidedEndomorphismSpan k
        ((quotientDiagram S f g P).tauUpper ≫
          (quotientDiagram S f g P).tauLower) <
      twoSidedEndomorphismSpan k
        (quotientDiagram S f g P).tauUpper := by
  let F := quotientFunctor S f g P
  change twoSidedEndomorphismSpan k (F.map P.tau.asHom ≫ F.map P.tau.asHom) <
    twoSidedEndomorphismSpan k (F.map P.tau.asHom)
  letI : ∀ T : (quotientSplitBasic S f g P).ProjectiveCategory,
      Module.Finite k (End T) := fun T ↦ by
    change Module.Finite k (T ⟶ T)
    infer_instance
  let Pbar := quotientMiddlePowerParameter S f g P hXY hYZ hleft
  have hlt := Pbar.power_succ_span_lt 1 (by simpa using Pbar.ne_zero)
  have hpowTwo : (Pbar.tau ^ (1 + 1)).asHom =
      F.map P.tau.asHom ≫ F.map P.tau.asHom := by
    rw [show 1 + 1 = 2 by omega, pow_two, End.mul_def]
    rfl
  have hpowOne : (Pbar.tau ^ 1).asHom = F.map P.tau.asHom := by
    rw [pow_one]
    rfl
  rw [hpowTwo, hpowOne] at hlt
  exact hlt

/-- The surviving left adjacent path has strictly smaller span than its
outer arrow in the Figure-13 quotient. -/
theorem quotientDiagram_left_adjacent_span_lt_alpha
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (hfspan : twoSidedEndomorphismSpan k f = ⊤)
    (hXY : X ≠ Y) (hYZ : Y ≠ Z)
    (hleft : f ≫ (P.tau ^ 2).asHom ≠ 0) :
    twoSidedEndomorphismSpan k
        ((quotientDiagram S f g P).alpha ≫
          (quotientDiagram S f g P).tauLower) <
      twoSidedEndomorphismSpan k
        (quotientDiagram S f g P).alpha := by
  let F := quotientFunctor S f g P
  change twoSidedEndomorphismSpan k (F.map f ≫ F.map P.tau.asHom) <
    twoSidedEndomorphismSpan k (F.map f)
  letI : ∀ T : (quotientSplitBasic S f g P).ProjectiveCategory,
      Module.Finite k (End T) := fun T ↦ by
    change Module.Finite k (T ⟶ T)
    infer_instance
  let Pbar := quotientMiddlePowerParameter S f g P hXY hYZ hleft
  have hlong := quotientDiagram_left_adjacent_ne_zero
    S f g P hfspan hleft
  change F.map f ≫ F.map P.tau.asHom ≠ 0 at hlong
  have hshort : F.map f ≠ 0 := by
    intro hzero
    apply hlong
    rw [hzero]
    simp
  have hpowOne : (Pbar.tau ^ 1).asHom = F.map P.tau.asHom := by
    rw [pow_one]
    rfl
  have hpowZero : (Pbar.tau ^ 0).asHom = 𝟙 (F.obj Y) := by
    rw [pow_zero]
    rfl
  have hshort' : F.map f ≫
      (Pbar.tau ^ 0).asHom ≠ 0 := by
    rw [hpowZero, Category.comp_id]
    exact hshort
  have hpowSucc : (Pbar.tau ^ (0 + 1)).asHom = F.map P.tau.asHom := by
    simpa only [Nat.zero_add] using hpowOne
  have hlongSucc : F.map f ≫ (Pbar.tau ^ (0 + 1)).asHom ≠ 0 := by
    rw [hpowSucc]
    exact hlong
  have hlt := Pbar.postcompose_power_succ_span_lt
    (F.map f) 0 hlongSucc hshort'
  rw [hpowSucc, hpowZero, Category.comp_id] at hlt
  exact hlt

/-- The surviving right adjacent path has strictly smaller span than its
outer arrow in the Figure-13 quotient. -/
theorem quotientDiagram_right_adjacent_span_lt_beta
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (hgspan : twoSidedEndomorphismSpan k g = ⊤)
    (hXY : X ≠ Y) (hYZ : Y ≠ Z)
    (hleft : f ≫ (P.tau ^ 2).asHom ≠ 0)
    (hright : (P.tau ^ 2).asHom ≫ g ≠ 0) :
    twoSidedEndomorphismSpan k
        ((quotientDiagram S f g P).tauUpper ≫
          (quotientDiagram S f g P).beta) <
      twoSidedEndomorphismSpan k
        (quotientDiagram S f g P).beta := by
  let F := quotientFunctor S f g P
  change twoSidedEndomorphismSpan k (F.map P.tau.asHom ≫ F.map g) <
    twoSidedEndomorphismSpan k (F.map g)
  letI : ∀ T : (quotientSplitBasic S f g P).ProjectiveCategory,
      Module.Finite k (End T) := fun T ↦ by
    change Module.Finite k (T ⟶ T)
    infer_instance
  let Pbar := quotientMiddlePowerParameter S f g P hXY hYZ hleft
  have hlong := quotientDiagram_right_adjacent_ne_zero
    S f g P hgspan hright
  change F.map P.tau.asHom ≫ F.map g ≠ 0 at hlong
  have hshort : F.map g ≠ 0 := by
    intro hzero
    apply hlong
    rw [hzero]
    simp
  have hpowOne : (Pbar.tau ^ 1).asHom = F.map P.tau.asHom := by
    rw [pow_one]
    rfl
  have hpowZero : (Pbar.tau ^ 0).asHom = 𝟙 (F.obj Y) := by
    rw [pow_zero]
    rfl
  have hshort' : (Pbar.tau ^ 0).asHom ≫
      F.map g ≠ 0 := by
    rw [hpowZero, Category.id_comp]
    exact hshort
  have hpowSucc : (Pbar.tau ^ (0 + 1)).asHom = F.map P.tau.asHom := by
    simpa only [Nat.zero_add] using hpowOne
  have hlongSucc : (Pbar.tau ^ (0 + 1)).asHom ≫ F.map g ≠ 0 := by
    rw [hpowSucc]
    exact hlong
  have hlt := Pbar.precompose_power_succ_span_lt
    (F.map g) 0 hlongSucc hshort'
  rw [hpowSucc, hpowZero, Category.id_comp] at hlt
  exact hlt

omit [IsAlgClosed k] in
/-- Inserting the middle Figure-13 arrow into the nonexceptional outer path
strictly lowers its quotient span. -/
theorem quotientDiagram_middle_arrow_cross_span_lt_cross_of_not_special
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (hfspan : twoSidedEndomorphismSpan k f = ⊤)
    (hgspan : twoSidedEndomorphismSpan k g = ⊤)
    (hfT : AllowsTransit f) (hgC : AllowsCotransit g)
    (hns : ¬ LargeIndecomposable.IsBGRSSpecialZero f g) :
    twoSidedEndomorphismSpan k
        (((quotientDiagram S f g P).alpha ≫
          (quotientDiagram S f g P).tauLower) ≫
            (quotientDiagram S f g P).beta) <
      twoSidedEndomorphismSpan k
        ((quotientDiagram S f g P).alpha ≫
          (quotientDiagram S f g P).beta) := by
  let tauBar : End (quotientDiagram S f g P).center :=
    End.of (quotientDiagram S f g P).tauLower
  have htauSpan := mem_twoSidedEndomorphismSpan k tauBar
  have htauJ : tauBar ∈ Ring.jacobson
      (End (quotientDiagram S f g P).center) := by
    have hspan := quotientFunctor_middle_span_eq_jacobson S f g P
    change twoSidedEndomorphismSpan k tauBar =
      (Ring.jacobson
        (End (quotientDiagram S f g P).center)).restrictScalars k at hspan
    rw [hspan] at htauSpan
    exact htauSpan
  exact quotientDiagram_middleRadical_span_lt_cross_of_not_special
    S f g P hfspan hgspan hfT hgC hns tauBar htauJ

/-- The generic strict whisker-deviation criterion is intentionally stronger
than the actual Figure-13 supplement equations and cannot hold for the
repeated middle occurrence.  Whisker the lower `tau` path on the left by the
upper `tau` and take the ambient middle endomorphism to be the identity.  The
resulting deviation is `tauBar - c * tauBar^2`, which has the same principal
span as `tauBar`, not a span below `tauBar^2`. -/
theorem quotientDiagram_not_whiskerDeviationSpanDrops
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (hXY : X ≠ Y) (hYZ : Y ≠ Z)
    (hleft : f ≫ (P.tau ^ 2).asHom ≠ 0)
    (map_path_ne_zero : ∀
      {U V : LargeIndecomposable.RoiterFigure13D.LinearSource k}
      (p : Quiver.Path (LinearPathCategory.vertex V)
        (LinearPathCategory.vertex U)),
      ((quotientDiagram S f g P).functor (k := k)).map
          (LinearPathCategory.pathHom p) ≠ 0) :
    ¬ LargeIndecomposable.ClosedZigzagTransfer.ThinPathWhiskerDeviationSpanDrops
      (k := k) (Q := LargeIndecomposable.RoiterFigure13D.Vertexᵒᵖ)
      (C := (quotientSplitBasic S f g P).ProjectiveCategory)
      ((quotientDiagram S f g P).functor (k := k))
        map_path_ne_zero := by
  intro hdrops
  let D := (quotientDiagram S f g P).functor (k := k)
  let U := LargeIndecomposable.RoiterFigure13D.vertexObj
    (k := k) LargeIndecomposable.RoiterFigure13D.Vertex.upperLeaf
  let C₀ := LargeIndecomposable.RoiterFigure13D.vertexObj
    (k := k) LargeIndecomposable.RoiterFigure13D.Vertex.center
  let L := LargeIndecomposable.RoiterFigure13D.vertexObj
    (k := k) LargeIndecomposable.RoiterFigure13D.Vertex.lowerLeaf
  let p : Quiver.Path (LinearPathCategory.vertex C₀)
      (LinearPathCategory.vertex U) :=
    Quiver.Hom.toPath
      (Quiver.Hom.op LargeIndecomposable.RoiterFigure13D.Arrow.tauUpper)
  let s : Quiver.Path (LinearPathCategory.vertex L)
      (LinearPathCategory.vertex C₀) :=
    Quiver.Hom.toPath
      (Quiver.Hom.op LargeIndecomposable.RoiterFigure13D.Arrow.tauLower)
  let q : Quiver.Path (LinearPathCategory.vertex L)
      (LinearPathCategory.vertex L) := Quiver.Path.nil
  let r : Quiver.Path (LinearPathCategory.vertex L)
      (LinearPathCategory.vertex U) := q.comp (s.comp p)
  let oneCL : D.obj C₀ ⟶ D.obj L := 𝟙 (D.obj C₀)
  have hdrop := hdrops (X' := U) (X := C₀) (Y := L) (Y' := L)
    p oneCL q r s (by simp [p, q])
  let base : D.obj U ⟶ D.obj L :=
    (D.map (LinearPathCategory.pathHom p) ≫ oneCL) ≫
      D.map (LinearPathCategory.pathHom q)
  let landing : D.obj U ⟶ D.obj L :=
    D.map (LinearPathCategory.pathHom r)
  have hpmap :
      D.map (LinearPathCategory.pathHom p) =
        (quotientDiagram S f g P).tauUpper := by
    change ((quotientDiagram S f g P).functor (k := k)).map
        (LargeIndecomposable.RoiterFigure13D.generatorHom
          (k := k) LargeIndecomposable.RoiterFigure13D.Arrow.tauUpper) = _
    exact
      LargeIndecomposable.RoiterFigure13D.DiagramData.functor_map_generator
        (k := k) (quotientDiagram S f g P)
          LargeIndecomposable.RoiterFigure13D.Arrow.tauUpper
  have hsmap :
      D.map (LinearPathCategory.pathHom s) =
        (quotientDiagram S f g P).tauLower := by
    change ((quotientDiagram S f g P).functor (k := k)).map
        (LargeIndecomposable.RoiterFigure13D.generatorHom
          (k := k) LargeIndecomposable.RoiterFigure13D.Arrow.tauLower) = _
    exact
      LargeIndecomposable.RoiterFigure13D.DiagramData.functor_map_generator
        (k := k) (quotientDiagram S f g P)
          LargeIndecomposable.RoiterFigure13D.Arrow.tauLower
  have hqmap :
      D.map (LinearPathCategory.pathHom q) = 𝟙 (D.obj L) := by
    simp [q]
  have hbaseMap : base = D.map (LinearPathCategory.pathHom p) := by
    dsimp [base, oneCL]
    rw [hqmap]
    calc
      (D.map (LinearPathCategory.pathHom p) ≫ 𝟙 (D.obj C₀)) ≫
          𝟙 (D.obj L) =
        D.map (LinearPathCategory.pathHom p) ≫ 𝟙 (D.obj C₀) :=
          Category.comp_id _
      _ = D.map (LinearPathCategory.pathHom p) := Category.comp_id _
  have hrmap :
      D.map (LinearPathCategory.pathHom r) =
        (quotientDiagram S f g P).tauUpper ≫
          (quotientDiagram S f g P).tauLower := by
    rw [show r = s.comp p by simp [r, q],
      ← LinearPathCategory.pathHom_comp, Functor.map_comp, hpmap, hsmap]
  have hsquare := quotientDiagram_middle_square_span_lt_middle_arrow
    S f g P hXY hYZ hleft
  have hbase :
      twoSidedEndomorphismSpan k landing <
        twoSidedEndomorphismSpan k base := by
    rw [hbaseMap]
    dsimp [landing]
    rw [hrmap, hpmap]
    exact hsquare
  have heq :=
    LargeIndecomposable.ClosedZigzagTransfer.twoSidedEndomorphismSpan_sub_smul_eq_of_lt
      (k := k) base landing
      (LargeIndecomposable.ClosedZigzagTransfer.normalizedThinPathCoefficient
        D map_path_ne_zero s oneCL) hbase
  have hdrop' : twoSidedEndomorphismSpan k
      (base -
        LargeIndecomposable.ClosedZigzagTransfer.normalizedThinPathCoefficient
            D map_path_ne_zero s oneCL • landing) <
    twoSidedEndomorphismSpan k landing := by
    simpa [base, landing, D] using hdrop
  rw [heq] at hdrop'
  exact (not_lt_of_ge hbase.le) hdrop'

omit [IsAlgClosed k]
    [LargeIndecomposable.HasBGRSDistributiveHomStructure
      k S.ProjectiveCategory] in
/-- A nonexceptional outer composite survives the Figure-13 quotient in the
transit/cotransit branch. -/
theorem quotientDiagram_cross_ne_zero_of_not_special
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (hfspan : twoSidedEndomorphismSpan k f = ⊤)
    (hgspan : twoSidedEndomorphismSpan k g = ⊤)
    (hfT : AllowsTransit f) (hgC : AllowsCotransit g)
    (hns : ¬ LargeIndecomposable.IsBGRSSpecialZero f g) :
    (quotientDiagram S f g P).alpha ≫
      (quotientDiagram S f g P).beta ≠ 0 := by
  change (S.projectiveQuotientFunctor (relationIdeal S f g P)
      (relationIdeal_le_jacobson S f g P)).map f ≫
    (S.projectiveQuotientFunctor (relationIdeal S f g P)
      (relationIdeal_le_jacobson S f g P)).map g ≠ 0
  rw [← Functor.map_comp]
  intro hzero
  exact (cross_not_mem_relationIdeal_of_not_special
    S f g P hfspan hgspan hfT hgC hns)
      ((S.projectiveQuotientFunctor_map_eq_zero_iff
        (relationIdeal S f g P) (relationIdeal_le_jacobson S f g P)
        (f ≫ g)).1 hzero)

/-- In the exact Section 4.1 branch, nonexceptionality of the outer
composition makes all four displayed length-two Figure-13 paths survive. -/
theorem quotientDiagram_four_composites_ne_zero_of_not_special
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (hfspan : twoSidedEndomorphismSpan k f = ⊤)
    (hgspan : twoSidedEndomorphismSpan k g = ⊤)
    (hXY : X ≠ Y) (hYZ : Y ≠ Z)
    (hfNotC : ¬AllowsCotransit f) (hgNotT : ¬AllowsTransit g)
    (hleft : f ≫ (P.tau ^ 2).asHom ≠ 0)
    (hright : (P.tau ^ 2).asHom ≫ g ≠ 0)
    (hns : ¬ LargeIndecomposable.IsBGRSSpecialZero f g) :
    (quotientDiagram S f g P).alpha ≫
        (quotientDiagram S f g P).tauLower ≠ 0 ∧
      (quotientDiagram S f g P).alpha ≫
        (quotientDiagram S f g P).beta ≠ 0 ∧
      (quotientDiagram S f g P).tauUpper ≫
        (quotientDiagram S f g P).tauLower ≠ 0 ∧
      (quotientDiagram S f g P).tauUpper ≫
        (quotientDiagram S f g P).beta ≠ 0 := by
  have hfT : AllowsTransit f :=
    (LargeIndecomposable.HasBGRSDistributiveHomStructure.transit_or_cotransit
      (k := k) (C := S.ProjectiveCategory) f).resolve_right hfNotC
  have hgC : AllowsCotransit g :=
    (LargeIndecomposable.HasBGRSDistributiveHomStructure.transit_or_cotransit
      (k := k) (C := S.ProjectiveCategory) g).resolve_left hgNotT
  exact ⟨quotientDiagram_left_adjacent_ne_zero S f g P hfspan hleft,
    quotientDiagram_cross_ne_zero_of_not_special
      S f g P hfspan hgspan hfT hgC hns,
    quotientDiagram_middle_square_ne_zero S f g P hXY hYZ hleft,
    quotientDiagram_right_adjacent_ne_zero S f g P hgspan hright⟩

/-- Nonexceptionality of the outer composition supplies every path-survival
hypothesis needed by the thin Figure-13D retraction compiler. -/
theorem quotientDiagram_path_images_ne_zero_of_not_special
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (hfspan : twoSidedEndomorphismSpan k f = ⊤)
    (hgspan : twoSidedEndomorphismSpan k g = ⊤)
    (hXY : X ≠ Y) (hYZ : Y ≠ Z)
    (hfNotC : ¬AllowsCotransit f) (hgNotT : ¬AllowsTransit g)
    (hleft : f ≫ (P.tau ^ 2).asHom ≠ 0)
    (hright : (P.tau ^ 2).asHom ≫ g ≠ 0)
    (hns : ¬ LargeIndecomposable.IsBGRSSpecialZero f g) :
    ∀ {U V : LargeIndecomposable.RoiterFigure13D.LinearSource k}
      (p : Quiver.Path (LinearPathCategory.vertex V)
        (LinearPathCategory.vertex U)),
      ((quotientDiagram S f g P).functor (k := k)).map
          (LinearPathCategory.pathHom p) ≠ 0 := by
  obtain ⟨hal, hab, hul, hub⟩ :=
    quotientDiagram_four_composites_ne_zero_of_not_special
      S f g P hfspan hgspan hXY hYZ hfNotC hgNotT
        hleft hright hns
  intro U V p
  exact
    LargeIndecomposable.RoiterFigure13D.DiagramData.functor_map_pathHom_ne_zero_of_four_composites
      (quotientDiagram S f g P) hal hab hul hub p

omit [IsAlgClosed k]
    [LargeIndecomposable.HasBGRSDistributiveHomStructure
      k S.ProjectiveCategory] in
/-- The left length-three ambient composite is zero in the Figure-13
quotient. -/
theorem quotientFunctor_map_left_relation_eq_zero
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : LargeIndecomposable.ClosedZigzagTransfer.OrientedRadicalPowerParameter
      (k := k) Y) :
    (quotientFunctor S f g P).map (f ≫ (P.tau ^ 2).asHom) = 0 := by
  rw [S.projectiveQuotientFunctor_map_eq_zero_iff]
  exact left_relation_mem S f g P

omit [IsAlgClosed k]
    [LargeIndecomposable.HasBGRSDistributiveHomStructure
      k S.ProjectiveCategory] in
/-- The right length-three ambient composite is zero in the Figure-13
quotient. -/
theorem quotientFunctor_map_right_relation_eq_zero
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : LargeIndecomposable.ClosedZigzagTransfer.OrientedRadicalPowerParameter
      (k := k) Y) :
    (quotientFunctor S f g P).map ((P.tau ^ 2).asHom ≫ g) = 0 := by
  rw [S.projectiveQuotientFunctor_map_eq_zero_iff]
  exact right_relation_mem S f g P

omit [IsAlgClosed k]
    [LargeIndecomposable.HasBGRSDistributiveHomStructure
      k S.ProjectiveCategory] in
/-- Every morphism outside the ambient radical square survives the Figure-13
quotient. -/
theorem quotientFunctor_map_ne_zero_of_not_mem_jacobson_sq
    {X Y Z U V : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : LargeIndecomposable.ClosedZigzagTransfer.OrientedRadicalPowerParameter
      (k := k) Y)
    (h : U ⟶ V) (hh : h.1 ∉ (Ring.jacobson A) ^ 2) :
    (quotientFunctor S f g P).map h ≠ 0 := by
  intro hzero
  apply hh
  apply relationIdeal_le_jacobson_sq S f g P
  exact (S.projectiveQuotientFunctor_map_eq_zero_iff
    (relationIdeal S f g P) (relationIdeal_le_jacobson S f g P) h).1 hzero

omit [IsAlgClosed k]
    [LargeIndecomposable.HasBGRSDistributiveHomStructure
      k S.ProjectiveCategory] in
/-- Under radicality of the two outer arrows, every morphism outside the
ambient radical cube survives the Figure-13 quotient. -/
theorem quotientFunctor_map_ne_zero_of_not_mem_jacobson_cube
    {X Y Z U V : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : LargeIndecomposable.ClosedZigzagTransfer.OrientedRadicalPowerParameter
      (k := k) Y)
    (hfJ : f.1 ∈ Ring.jacobson A)
    (hgJ : g.1 ∈ Ring.jacobson A)
    (h : U ⟶ V) (hh : h.1 ∉ (Ring.jacobson A) ^ 3) :
    (quotientFunctor S f g P).map h ≠ 0 := by
  intro hzero
  apply hh
  apply relationIdeal_le_jacobson_cube S f g P hfJ hgJ
  exact (S.projectiveQuotientFunctor_map_eq_zero_iff
    (relationIdeal S f g P) (relationIdeal_le_jacobson S f g P) h).1 hzero

omit [IsAlgClosed k]
    [LargeIndecomposable.HasBGRSDistributiveHomStructure
      k S.ProjectiveCategory] in
/-- Because representation-finiteness descends to the quotient, the literal
Figure 13D diagram constructed above has no Hom-bifunctor retraction.
This is the formal version of the sentence “the diagram `D` cannot be
cleaving.” -/
theorem quotientDiagram_not_homBifunctorRetraction
    [Infinite k]
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : LargeIndecomposable.ClosedZigzagTransfer.OrientedRadicalPowerParameter
      (k := k) Y)
    (hfinite : LargeIndecomposable.MildAlg k A)
    (hleft : f ≫ (P.tau ^ 2).asHom ≠ 0) :
    ¬ Nonempty (HomBifunctorRetraction (k := k)
      ((quotientDiagram S f g P).functor (k := k))) := by
  rintro ⟨hD⟩
  have hne := relationIdeal_ne_bot_of_left S f g P hleft
  exact
    (LargeIndecomposable.RoiterFigure13D.not_isRepresentationFinite_of_figure13DData
      (quotientSplitBasic S f g P) (quotientDiagram S f g P) hD)
      (hfinite _ hne)

omit [IsAlgClosed k] in
/-- Once all path images survive, the precise BGRS supplement obstruction is
now exposed: the forbidden-cross and whisker-deviation strict-span conditions
cannot both hold.  If they did, the generic thin-path strict-span compiler
would construct the forbidden Figure-13D Hom-bifunctor retraction. -/
theorem quotientDiagram_not_strictSpanDrops
    [Infinite k]
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : LargeIndecomposable.ClosedZigzagTransfer.OrientedRadicalPowerParameter
      (k := k) Y)
    (hfinite : LargeIndecomposable.MildAlg k A)
    (hleft : f ≫ (P.tau ^ 2).asHom ≠ 0)
    (map_path_ne_zero : ∀
      {U V : LargeIndecomposable.RoiterFigure13D.LinearSource k}
      (p : Quiver.Path (LinearPathCategory.vertex V)
        (LinearPathCategory.vertex U)),
      ((quotientDiagram S f g P).functor (k := k)).map
          (LinearPathCategory.pathHom p) ≠ 0) :
    ¬ (LargeIndecomposable.ClosedZigzagTransfer.ThinPathCrossSpanDrops
          (k := k) (Q := LargeIndecomposable.RoiterFigure13D.Vertexᵒᵖ)
          (C := (quotientSplitBasic S f g P).ProjectiveCategory)
          ((quotientDiagram S f g P).functor (k := k)) ∧
        LargeIndecomposable.ClosedZigzagTransfer.ThinPathWhiskerDeviationSpanDrops
          (k := k) (Q := LargeIndecomposable.RoiterFigure13D.Vertexᵒᵖ)
          (C := (quotientSplitBasic S f g P).ProjectiveCategory)
          ((quotientDiagram S f g P).functor (k := k))
            map_path_ne_zero) := by
  rintro ⟨hcross, hwhisker⟩
  apply quotientDiagram_not_homBifunctorRetraction S f g P hfinite hleft
  refine ⟨?_⟩
  exact
    LargeIndecomposable.ClosedZigzagTransfer.ThinPathStrictSpanData.homBifunctorRetractionOfPathImagesNonzeroAndStrictSpanDrops
      (k := k)
      (D := (quotientDiagram S f g P).functor (k := k))
      LargeIndecomposable.RoiterFigure13D.path_subsingleton
      map_path_ne_zero hcross hwhisker

/-- In the exact hard branch of Section 4.1, if the outer composition is
nonexceptional then the two strict supplement families cannot both hold.
All path-survival input is discharged internally. -/
theorem quotientDiagram_not_strictSpanDrops_of_not_special
    [Infinite k]
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (hfinite : LargeIndecomposable.MildAlg k A)
    (hfspan : twoSidedEndomorphismSpan k f = ⊤)
    (hgspan : twoSidedEndomorphismSpan k g = ⊤)
    (hXY : X ≠ Y) (hYZ : Y ≠ Z)
    (hfNotC : ¬AllowsCotransit f) (hgNotT : ¬AllowsTransit g)
    (hleft : f ≫ (P.tau ^ 2).asHom ≠ 0)
    (hright : (P.tau ^ 2).asHom ≫ g ≠ 0)
    (hns : ¬ LargeIndecomposable.IsBGRSSpecialZero f g) :
    ¬ (LargeIndecomposable.ClosedZigzagTransfer.ThinPathCrossSpanDrops
          (k := k) (Q := LargeIndecomposable.RoiterFigure13D.Vertexᵒᵖ)
          (C := (quotientSplitBasic S f g P).ProjectiveCategory)
          ((quotientDiagram S f g P).functor (k := k)) ∧
        LargeIndecomposable.ClosedZigzagTransfer.ThinPathWhiskerDeviationSpanDrops
          (k := k) (Q := LargeIndecomposable.RoiterFigure13D.Vertexᵒᵖ)
          (C := (quotientSplitBasic S f g P).ProjectiveCategory)
          ((quotientDiagram S f g P).functor (k := k))
            (quotientDiagram_path_images_ne_zero_of_not_special
              S f g P hfspan hgspan hXY hYZ hfNotC hgNotT
                hleft hright hns)) := by
  exact quotientDiagram_not_strictSpanDrops S f g P hfinite hleft
    (quotientDiagram_path_images_ne_zero_of_not_special
      S f g P hfspan hgspan hXY hYZ hfNotC hgNotT
        hleft hright hns)

omit [IsAlgClosed k] in
/-- For the literal quotient diagram, the abstract all-path survival input is
equivalent to the finite task of proving its four displayed length-two
composites nonzero. -/
theorem quotientDiagram_not_strictSpanDrops_of_four_composites
    [Infinite k]
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : LargeIndecomposable.ClosedZigzagTransfer.OrientedRadicalPowerParameter
      (k := k) Y)
    (hfinite : LargeIndecomposable.MildAlg k A)
    (hleft : f ≫ (P.tau ^ 2).asHom ≠ 0)
    (hal : (quotientDiagram S f g P).alpha ≫
      (quotientDiagram S f g P).tauLower ≠ 0)
    (hab : (quotientDiagram S f g P).alpha ≫
      (quotientDiagram S f g P).beta ≠ 0)
    (hul : (quotientDiagram S f g P).tauUpper ≫
      (quotientDiagram S f g P).tauLower ≠ 0)
    (hub : (quotientDiagram S f g P).tauUpper ≫
      (quotientDiagram S f g P).beta ≠ 0) :
    ¬ (LargeIndecomposable.ClosedZigzagTransfer.ThinPathCrossSpanDrops
          (k := k) (Q := LargeIndecomposable.RoiterFigure13D.Vertexᵒᵖ)
          (C := (quotientSplitBasic S f g P).ProjectiveCategory)
          ((quotientDiagram S f g P).functor (k := k)) ∧
        LargeIndecomposable.ClosedZigzagTransfer.ThinPathWhiskerDeviationSpanDrops
          (k := k) (Q := LargeIndecomposable.RoiterFigure13D.Vertexᵒᵖ)
          (C := (quotientSplitBasic S f g P).ProjectiveCategory)
          ((quotientDiagram S f g P).functor (k := k))
            (fun p ↦
              LargeIndecomposable.RoiterFigure13D.DiagramData.functor_map_pathHom_ne_zero_of_four_composites
                (quotientDiagram S f g P) hal hab hul hub p)) := by
  exact quotientDiagram_not_strictSpanDrops S f g P hfinite hleft
    (fun p ↦
      LargeIndecomposable.RoiterFigure13D.DiagramData.functor_map_pathHom_ne_zero_of_four_composites
        (quotientDiagram S f g P) hal hab hul hub p)

/-- Failure of both square-annihilation alternatives therefore produces one
specific Figure-13 radical quotient and a literal diagram which is not
cleaving.  No representation-infinite callback is present: the obstruction is
the explicit Hom-bifunctor retraction type. -/
theorem exists_parameter_with_noncleaving_quotientDiagram
    [Infinite k]
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (hleft : ¬ LargeIndecomposable.LeftJacobsonSquareAnnihilates f)
    (hright : ¬ LargeIndecomposable.RightJacobsonSquareAnnihilates g)
    (hfinite : LargeIndecomposable.MildAlg k A) :
    ∃ P : LargeIndecomposable.ClosedZigzagTransfer.OrientedRadicalPowerParameter
        (k := k) Y,
      f ≫ (P.tau ^ 2).asHom ≠ 0 ∧
      (P.tau ^ 2).asHom ≫ g ≠ 0 ∧
      ¬ Nonempty (HomBifunctorRetraction (k := k)
        ((quotientDiagram S f g P).functor (k := k))) := by
  obtain ⟨P, hleftP, hrightP⟩ :=
    LargeIndecomposable.SplitBasicIdempotents.ProjectiveCategory.exists_radicalPowerParameter_sq_nonzero_of_not_squareAlternative
      S f g hleft hright
  exact ⟨P, hleftP, hrightP,
    quotientDiagram_not_homBifunctorRetraction S f g P hfinite hleftP⟩

