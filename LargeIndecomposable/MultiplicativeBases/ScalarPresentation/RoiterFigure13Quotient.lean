    [LargeIndecomposable.HasBGRSDistributiveHomStructure
  k S.ProjectiveCategory] in
/-- The image of the chosen middle parameter still generates the entire
endomorphism radical after the Figure-13 quotient. -/
theorem quotientFunctor_middle_span_eq_jacobson
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y) :
    twoSidedEndomorphismSpan k
        (End.of ((quotientFunctor S f g P).map P.tau.asHom)) =
      (Ring.jacobson
        (End ((quotientFunctor S f g P).obj Y))).restrictScalars k := by
  let F := quotientFunctor S f g P
  let tauBar : End (F.obj Y) := End.of (F.map P.tau.asHom)
  have htauJ : tauBar ∈ Ring.jacobson (End (F.obj Y)) := by
    apply ((quotientSplitBasic S f g P).projectiveEnd_mem_jacobson_iff_val_mem_jacobson
      (F.obj Y) tauBar).2
    change Ideal.Quotient.mk (relationIdeal S f g P).asIdeal P.tau.1 ∈
      Ring.jacobson (A ⧸ (relationIdeal S f g P).asIdeal)
    rw [LargeIndecomposable.TwoSidedIdeal.quotient_mk_mem_jacobson_iff
      (relationIdeal S f g P) (relationIdeal_le_jacobson S f g P)]
    exact (S.projectiveEnd_mem_jacobson_iff_val_mem_jacobson Y P.tau).1
      P.mem_jacobson
  change twoSidedEndomorphismSpan k tauBar = _
  apply le_antisymm
  · apply Submodule.span_le.2
    rintro h ⟨a, b, rfl⟩
    have hring : b * tauBar * a ∈ Ring.jacobson (End (F.obj Y)) :=
      (Ring.jacobson (End (F.obj Y))).mul_mem_right a
        ((Ring.jacobson (End (F.obj Y))).mul_mem_left b htauJ)
    change End.of ((a.asHom ≫ tauBar.asHom) ≫ b.asHom) ∈
      Ring.jacobson (End (F.obj Y))
    rw [show End.of ((a.asHom ≫ tauBar.asHom) ≫ b.asHom) =
        b * tauBar * a by
      apply End.ext
      simp only [End.mul_def, Category.assoc]]
    exact hring
  · intro a ha
    obtain ⟨b, hb⟩ := F.map_surjective a
    have haVal : a.1 ∈
        Ring.jacobson (A ⧸ (relationIdeal S f g P).asIdeal) :=
      ((quotientSplitBasic S f g P).projectiveEnd_mem_jacobson_iff_val_mem_jacobson
        (F.obj Y) (End.of a)).1 ha
    have hbQuotient : Ideal.Quotient.mk
        (relationIdeal S f g P).asIdeal b.1 ∈
          Ring.jacobson (A ⧸ (relationIdeal S f g P).asIdeal) := by
      rw [← S.projectiveQuotientFunctor_map_val]
      change (F.map b).1 ∈ _
      rw [hb]
      exact haVal
    have hbVal : b.1 ∈ Ring.jacobson A :=
      (LargeIndecomposable.TwoSidedIdeal.quotient_mk_mem_jacobson_iff
        (relationIdeal S f g P) (relationIdeal_le_jacobson S f g P) b.1).1
          hbQuotient
    have hbJ : End.of b ∈ Ring.jacobson (End Y) :=
      (S.projectiveEnd_mem_jacobson_iff_val_mem_jacobson Y (End.of b)).2 hbVal
    have hbSpan : b ∈ twoSidedEndomorphismSpan k P.tau.asHom := by
      change End.of b ∈ twoSidedEndomorphismSpan k P.tau
      rw [P.span_eq]
      exact hbJ
    have hmap := quotientFunctor_map_mem_twoSidedEndomorphismSpan
      S f g P hbSpan
    change F.map b ∈ twoSidedEndomorphismSpan k tauBar at hmap
    simpa only [hb] using hmap

/-- The literal Figure 13D diagram in the BGRS radical quotient.  Both central
leaf occurrences map to the middle projective, and both vertical arrows map
to the same image of `tau`. -/
def quotientDiagram
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : LargeIndecomposable.ClosedZigzagTransfer.OrientedRadicalPowerParameter
      (k := k) Y) :
    LargeIndecomposable.RoiterFigure13D.DiagramData
      (C := (quotientSplitBasic S f g P).ProjectiveCategory) where
  center := (quotientFunctor S f g P).obj Y
  leftLeaf := (quotientFunctor S f g P).obj X
  upperLeaf := (quotientFunctor S f g P).obj Y
  lowerLeaf := (quotientFunctor S f g P).obj Y
  rightLeaf := (quotientFunctor S f g P).obj Z
  alpha := (quotientFunctor S f g P).map f
  tauUpper := (quotientFunctor S f g P).map P.tau.asHom
  tauLower := (quotientFunctor S f g P).map P.tau.asHom
  beta := (quotientFunctor S f g P).map g

