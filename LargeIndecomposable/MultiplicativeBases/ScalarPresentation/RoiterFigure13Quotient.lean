namespace LargeIndecomposable.RoiterFigure13Quotient

open LargeIndecomposable.ClosedZigzagCrossUniverse
open LargeIndecomposable.ClosedZigzagTransfer
open LargeIndecomposable.SplitBasicIdempotents
open LargeIndecomposable.SplitBasicIdempotents.ProjectiveCategory

universe u v x

variable {k : Type u} [Field k] [IsAlgClosed k]
variable {A : Type v} [Ring A] [Algebra k A] [Module.Finite k A]
variable {ι : Type x} [Fintype ι] [DecidableEq ι]
variable (S : LargeIndecomposable.SplitBasicIdempotents
  (k := k) (A := A) (ι := ι))
variable [LargeIndecomposable.HasBGRSDistributiveHomStructure
  k S.ProjectiveCategory]

omit [IsAlgClosed k]
    [LargeIndecomposable.HasBGRSDistributiveHomStructure
      k S.ProjectiveCategory] in
/-- The Figure-13 quotient functor carries the square of the original middle
local radical into the square of the quotient middle local radical. -/
theorem quotientFunctor_map_mem_middle_jacobson_sq
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (a : End Y) (haSq : a ∈ (Ring.jacobson (End Y)) ^ 2) :
    let F := S.projectiveQuotientFunctor (relationIdeal S f g P)
      (relationIdeal_le_jacobson S f g P)
    End.of (F.map a.asHom) ∈
      (Ring.jacobson (End (F.obj Y))) ^ 2 := by
  dsimp only
  let F := S.projectiveQuotientFunctor (relationIdeal S f g P)
    (relationIdeal_le_jacobson S f g P)
  let tauBar : End (F.obj Y) := End.of (F.map P.tau.asHom)
  have hmapJ : ∀ b : End Y, b ∈ Ring.jacobson (End Y) →
      End.of (F.map b.asHom) ∈ Ring.jacobson (End (F.obj Y)) := by
    intro b hb
    have hbSpan : b.asHom ∈ twoSidedEndomorphismSpan k P.tau.asHom := by
      rw [P.span_eq]
      exact hb
    have hmapSpan :=
      RoiterFigure13D.linearFunctor_map_mem_twoSidedEndomorphismSpan
        F hbSpan
    change End.of (F.map b.asHom) ∈ Ring.jacobson (End (F.obj Y))
    have hspan := quotientFunctor_middle_span_eq_jacobson S f g P
    change twoSidedEndomorphismSpan k tauBar =
      (Ring.jacobson (End (F.obj Y))).restrictScalars k at hspan
    rw [hspan] at hmapSpan
    exact hmapSpan
  rw [show (2 : ℕ) = 1 + 1 by rfl, Submodule.pow_succ,
    Submodule.pow_one] at haSq ⊢
  refine Submodule.mul_induction_on haSq ?_ ?_
  · intro b hb c hc
    have hbMap := hmapJ b hb
    have hcMap := hmapJ c hc
    have hmul : End.of (F.map (b * c).asHom) =
        End.of (F.map b.asHom) * End.of (F.map c.asHom) := by
      apply End.ext
      simp only [End.mul_def, Functor.map_comp]
    rw [hmul]
    exact Ideal.mul_mem_mul hbMap hcMap
  · intro b c hb hc
    have hadd : End.of (F.map (b + c).asHom) =
        End.of (F.map b.asHom) + End.of (F.map c.asHom) := by
      apply End.ext
      change F.map (b.asHom + c.asHom) = F.map b.asHom + F.map c.asHom
      exact F.map_add
    rw [hadd]
    exact (Ring.jacobson (End (F.obj Y)) *
      Ring.jacobson (End (F.obj Y))).add_mem hb hc

omit [LargeIndecomposable.HasBGRSDistributiveHomStructure
  k S.ProjectiveCategory] in
/-- If `f` prohibits cotransit, every reverse two-cycle through `f` lies in
the square of the target local radical. -/
theorem reverse_comp_mem_target_jacobson_sq_of_not_allowsCotransit
    {X Y : S.ProjectiveCategory}
    (f : X ⟶ Y) (P : OrientedRadicalPowerParameter (k := k) Y)
    (hXY : X ≠ Y) (hfNotC : ¬AllowsCotransit f)
    (l : Y ⟶ X) :
    End.of (l ≫ f) ∈ (Ring.jacobson (End Y)) ^ 2 := by
  letI : Module.Finite k (End Y) := by
    change Module.Finite k (Y ⟶ Y)
    infer_instance
  let a : End Y := End.of (l ≫ f)
  have hfJ : f.1 ∈ Ring.jacobson A :=
    ProjectiveCategory.offDiagonal_val_mem_jacobson S hXY f
  have haValJ : a.1 ∈ Ring.jacobson A := by
    change f.1 * l.1 ∈ Ring.jacobson A
    exact (Ring.jacobson A).mul_mem_right l.1 hfJ
  have haJ : a ∈ Ring.jacobson (End Y) := by
    rw [S.projectiveEnd_mem_jacobson_iff_val_mem_jacobson]
    exact haValJ
  change a ∈ (Ring.jacobson (End Y)) ^ 2
  by_cases ha0 : a = 0
  · rw [ha0]
    exact (Ring.jacobson (End Y) ^ 2).zero_mem
  obtain ⟨n, hn, e, he, hae⟩ := P.cotransitData.factors a haJ ha0
  let rho : End X := End.of (f ≫ l)
  have htransfer : rho.asHom ≫ f =
      f ≫ (P.tau ^ n * e).asHom := by
    change (f ≫ l) ≫ f = f ≫ (P.tau ^ n * e).asHom
    rw [Category.assoc]
    change f ≫ a.asHom = f ≫ (P.tau ^ n * e).asHom
    rw [hae]
    rfl
  have hn2 : 2 ≤ n :=
    two_le_exponent_of_transfer_of_not_allowsCotransit
      P f rho n hn e he htransfer hfNotC
  have haEq : a = P.tau ^ n * e := by
    apply End.ext
    simpa only [End.mul_def] using hae
  have hpow : P.tau ^ n ∈ (Ring.jacobson (End Y)) ^ 2 :=
    Ideal.pow_le_pow_right hn2 (Ideal.pow_mem_pow P.mem_jacobson n)
  rw [haEq]
  exact (Ring.jacobson (End Y) ^ 2).mul_mem_right e hpow

omit [LargeIndecomposable.HasBGRSDistributiveHomStructure
  k S.ProjectiveCategory] in
/-- If `g` prohibits transit, every reverse two-cycle through `g` lies in
the square of the source local radical. -/
theorem comp_reverse_mem_source_jacobson_sq_of_not_allowsTransit
    {Y Z : S.ProjectiveCategory}
    (g : Y ⟶ Z) (P : OrientedRadicalPowerParameter (k := k) Y)
    (hYZ : Y ≠ Z) (hgNotT : ¬AllowsTransit g)
    (r : Z ⟶ Y) :
    End.of (g ≫ r) ∈ (Ring.jacobson (End Y)) ^ 2 := by
  letI : Module.Finite k (End Y) := by
    change Module.Finite k (Y ⟶ Y)
    infer_instance
  let a : End Y := End.of (g ≫ r)
  have hgJ : g.1 ∈ Ring.jacobson A :=
    ProjectiveCategory.offDiagonal_val_mem_jacobson S hYZ g
  have haValJ : a.1 ∈ Ring.jacobson A := by
    change r.1 * g.1 ∈ Ring.jacobson A
    exact (Ring.jacobson A).mul_mem_left r.1 hgJ
  have haJ : a ∈ Ring.jacobson (End Y) := by
    rw [S.projectiveEnd_mem_jacobson_iff_val_mem_jacobson]
    exact haValJ
  change a ∈ (Ring.jacobson (End Y)) ^ 2
  by_cases ha0 : a = 0
  · rw [ha0]
    exact (Ring.jacobson (End Y) ^ 2).zero_mem
  obtain ⟨n, hn, e, he, hae⟩ := P.transitData.factors a haJ ha0
  let sigma : End Z := End.of (r ≫ g)
  have htransfer : (e * P.tau ^ n).asHom ≫ g =
      g ≫ sigma.asHom := by
    change (e * P.tau ^ n).asHom ≫ g = g ≫ (r ≫ g)
    rw [← Category.assoc]
    change (e * P.tau ^ n).asHom ≫ g = a.asHom ≫ g
    exact congrArg (fun h ↦ h ≫ g) hae.symm
  have hn2 : 2 ≤ n :=
    two_le_exponent_of_transfer_of_not_allowsTransit
      P g sigma n hn e he htransfer hgNotT
  have haEq : a = e * P.tau ^ n := by
    apply End.ext
    simpa only [End.mul_def] using hae
  have hpow : P.tau ^ n ∈ (Ring.jacobson (End Y)) ^ 2 :=
    Ideal.pow_le_pow_right hn2 (Ideal.pow_mem_pow P.mem_jacobson n)
  rw [haEq]
  exact (Ring.jacobson (End Y) ^ 2).mul_mem_left e hpow

omit [LargeIndecomposable.HasBGRSDistributiveHomStructure
  k S.ProjectiveCategory] in
/-- Reverse two-cycles through the left quotient arrow remain in the square
of the quotient middle local radical. -/
theorem quotientDiagram_left_reverse_comp_mem_middle_jacobson_sq
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (hXY : X ≠ Y) (hfNotC : ¬AllowsCotransit f)
    (l : (S.projectiveQuotientFunctor (relationIdeal S f g P)
        (relationIdeal_le_jacobson S f g P)).obj Y ⟶
      (S.projectiveQuotientFunctor (relationIdeal S f g P)
        (relationIdeal_le_jacobson S f g P)).obj X) :
    End.of (l ≫ (quotientDiagram S f g P).alpha) ∈
      (Ring.jacobson
        (End ((S.projectiveQuotientFunctor (relationIdeal S f g P)
          (relationIdeal_le_jacobson S f g P)).obj Y))) ^ 2 := by
  let F := S.projectiveQuotientFunctor (relationIdeal S f g P)
    (relationIdeal_le_jacobson S f g P)
  obtain ⟨l₀, hl₀⟩ := F.map_surjective l
  have hsq := reverse_comp_mem_target_jacobson_sq_of_not_allowsCotransit
    S f P hXY hfNotC l₀
  have hmap := quotientFunctor_map_mem_middle_jacobson_sq
    S f g P (End.of (l₀ ≫ f)) hsq
  change End.of (l ≫ F.map f) ∈
    (Ring.jacobson (End (F.obj Y))) ^ 2
  rw [← hl₀, ← Functor.map_comp]
  exact hmap

omit [LargeIndecomposable.HasBGRSDistributiveHomStructure
  k S.ProjectiveCategory] in
/-- Reverse two-cycles through the right quotient arrow remain in the square
of the quotient middle local radical. -/
theorem quotientDiagram_right_comp_reverse_mem_middle_jacobson_sq
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (hYZ : Y ≠ Z) (hgNotT : ¬AllowsTransit g)
    (r : (S.projectiveQuotientFunctor (relationIdeal S f g P)
        (relationIdeal_le_jacobson S f g P)).obj Z ⟶
      (S.projectiveQuotientFunctor (relationIdeal S f g P)
        (relationIdeal_le_jacobson S f g P)).obj Y) :
    End.of ((quotientDiagram S f g P).beta ≫ r) ∈
      (Ring.jacobson
        (End ((S.projectiveQuotientFunctor (relationIdeal S f g P)
          (relationIdeal_le_jacobson S f g P)).obj Y))) ^ 2 := by
  let F := S.projectiveQuotientFunctor (relationIdeal S f g P)
    (relationIdeal_le_jacobson S f g P)
  obtain ⟨r₀, hr₀⟩ := F.map_surjective r
  have hsq := comp_reverse_mem_source_jacobson_sq_of_not_allowsTransit
    S g P hYZ hgNotT r₀
  have hmap := quotientFunctor_map_mem_middle_jacobson_sq
    S f g P (End.of (g ≫ r₀)) hsq
  change End.of (F.map g ≫ r) ∈
    (Ring.jacobson (End (F.obj Y))) ^ 2
  rw [← hr₀, ← Functor.map_comp]
  exact hmap

/-- In the exact hard branch, the quotient Figure-13 diagram carries a
complete coherent thin-path coefficient system. -/
theorem quotientDiagram_thinPathCoefficientData
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (hfspan : twoSidedEndomorphismSpan k f = ⊤)
    (hgspan : twoSidedEndomorphismSpan k g = ⊤)
    (hXY : X ≠ Y) (hYZ : Y ≠ Z)
    (hfNotC : ¬AllowsCotransit f) (hgNotT : ¬AllowsTransit g)
    (hleft : f ≫ (P.tau ^ 2).asHom ≠ 0)
    (hright : (P.tau ^ 2).asHom ≫ g ≠ 0)
    (hns : ¬ IsBGRSSpecialZero f g) :
    Nonempty (ClosedZigzagCrossUniverse.ThinPathCoefficientData
      (k := k) ((quotientDiagram S f g P).functor (k := k))) := by
  let Q := S.quotient_of_le_jacobson (relationIdeal S f g P)
    (relationIdeal_le_jacobson S f g P)
  let F := S.projectiveQuotientFunctor (relationIdeal S f g P)
    (relationIdeal_le_jacobson S f g P)
  let Xbar := F.obj X
  let Ybar := F.obj Y
  let Zbar := F.obj Z
  let alpha : Xbar ⟶ Ybar := F.map f
  let beta : Ybar ⟶ Zbar := F.map g
  let Pbar : OrientedRadicalPowerParameter (k := k) Ybar :=
    quotientMiddlePowerParameter S f g P hXY hYZ hleft
  let residue := Q.projectiveEndResidue Ybar
  let middle : RadicalSquareCoefficientData residue Pbar.tau :=
    Classical.choice (quotientMiddle_radicalSquareCoefficientData
      S f g P hXY hYZ hleft)
  have hfT : AllowsTransit f :=
    (LargeIndecomposable.HasBGRSDistributiveHomStructure.transit_or_cotransit
      (k := k) f).resolve_right hfNotC
  have hgC : AllowsCotransit g :=
    (LargeIndecomposable.HasBGRSDistributiveHomStructure.transit_or_cotransit
      (k := k) g).resolve_left hgNotT
  let extension : Figure13CoefficientExtensionData
      alpha beta residue Pbar.tau middle :=
    Classical.choice (quotientDiagram_figure13CoefficientExtensionData
      S f g P hfspan hgspan hXY hYZ hfT hgC hleft hright hns)
  letI : Module.Finite k (End Ybar) := by
    change Module.Finite k (Ybar ⟶ Ybar)
    infer_instance
  letI : Module k (Xbar ⟶ Ybar) := inferInstance
  letI : Module k (Ybar ⟶ Zbar) := inferInstance
  have hresTau : residue Pbar.tau = 0 := by
    rw [Q.projectiveEndResidue_eq_zero_iff_val_mem_jacobson,
      ← Q.projectiveEnd_mem_jacobson_iff_val_mem_jacobson]
    exact Pbar.mem_jacobson
  have hAlphaFactor : ∀ h : Xbar ⟶ Ybar,
      ∃ a : End Ybar, h = alpha ≫ a.asHom := by
    intro h
    have hspan : twoSidedEndomorphismSpan k alpha = ⊤ :=
      quotientFunctor_map_span_eq_top S f g P f hfspan
    have hmem : h ∈ twoSidedEndomorphismSpan k alpha := by
      rw [hspan]
      exact (show h ∈ (⊤ : Submodule k (Xbar ⟶ Ybar)) from Submodule.mem_top)
    apply exists_comp_right_of_mem_twoSidedSpan_of_allowsTransit (k := k)
      (quotientFunctor_map_allowsTransit S f g P f hfT)
    exact hmem
  have hBetaFactor : ∀ h : Ybar ⟶ Zbar,
      ∃ a : End Ybar, h = a.asHom ≫ beta := by
    intro h
    have hspan : twoSidedEndomorphismSpan k beta = ⊤ :=
      quotientFunctor_map_span_eq_top S f g P g hgspan
    have hmem : h ∈ twoSidedEndomorphismSpan k beta := by
      rw [hspan]
      exact (show h ∈ (⊤ : Submodule k (Ybar ⟶ Zbar)) from Submodule.mem_top)
    apply exists_comp_left_of_mem_twoSidedSpan_of_allowsCotransit (k := k)
      (quotientFunctor_map_allowsCotransit S f g P g hgC)
    exact hmem
  have hXbarYbar : Xbar ≠ Ybar := by
    intro h
    apply hXY
    apply S.projectiveVertex_injective
    have hv := congrArg Q.projectiveVertex h
    dsimp only [Q, Xbar, Ybar, F] at hv
    simpa only [SplitBasicIdempotents.projectiveQuotientFunctor_obj_projectiveVertex]
      using hv
  have hYbarZbar : Ybar ≠ Zbar := by
    intro h
    apply hYZ
    apply S.projectiveVertex_injective
    have hv := congrArg Q.projectiveVertex h
    dsimp only [Q, Ybar, Zbar, F] at hv
    simpa only [SplitBasicIdempotents.projectiveQuotientFunctor_obj_projectiveVertex]
      using hv
  have hThroughXZero : ∀ (l : Ybar ⟶ Xbar) (r : Xbar ⟶ Ybar),
      residue (End.of (l ≫ r)) = 0 := by
    intro l r
    rw [Q.projectiveEndResidue_eq_zero_iff_val_mem_jacobson]
    change r.1 * l.1 ∈ Ring.jacobson _
    exact (Ring.jacobson _).mul_mem_left r.1
      (ProjectiveCategory.offDiagonal_val_mem_jacobson
        Q hXbarYbar.symm l)
  have hThroughXOne : ∀ (l : Ybar ⟶ Xbar) (r : Xbar ⟶ Ybar),
      middle.coefficientOne (End.of (l ≫ r)) = 0 := by
    intro l r
    obtain ⟨a, rfl⟩ := hAlphaFactor r
    have hbase := quotientDiagram_left_reverse_comp_mem_middle_jacobson_sq
      S f g P hXY hfNotC l
    change End.of (l ≫ alpha) ∈
      (Ring.jacobson (End Ybar)) ^ 2 at hbase
    have hsq : End.of
        (l ≫ alpha ≫ a.asHom) ∈
          (Ring.jacobson (End Ybar)) ^ 2 := by
      have heq : End.of
          (l ≫ alpha ≫ a.asHom) = a * End.of (l ≫ alpha) := by
        apply End.ext
        simp only [End.mul_def, Category.assoc]
      rw [heq]
      exact ((Ring.jacobson (End Ybar)) ^ 2).mul_mem_left a hbase
    exact RoiterFigure13D.RadicalSquareCoefficientData.coefficientOne_eq_zero_of_mem_jacobson_sq
      Pbar residue middle hresTau _ hsq
  have hThroughZZero : ∀ (l : Ybar ⟶ Zbar) (r : Zbar ⟶ Ybar),
      residue (End.of (l ≫ r)) = 0 := by
    intro l r
    rw [Q.projectiveEndResidue_eq_zero_iff_val_mem_jacobson]
    change r.1 * l.1 ∈ Ring.jacobson _
    exact (Ring.jacobson _).mul_mem_left r.1
      (ProjectiveCategory.offDiagonal_val_mem_jacobson
        Q hYbarZbar l)
  have hThroughZOne : ∀ (l : Ybar ⟶ Zbar) (r : Zbar ⟶ Ybar),
      middle.coefficientOne (End.of (l ≫ r)) = 0 := by
    intro l r
    obtain ⟨a, rfl⟩ := hBetaFactor l
    have hbase := quotientDiagram_right_comp_reverse_mem_middle_jacobson_sq
      S f g P hYZ hgNotT r
    change End.of (beta ≫ r) ∈
      (Ring.jacobson (End Ybar)) ^ 2 at hbase
    have hsq : End.of
        ((a.asHom ≫ beta) ≫ r) ∈
          (Ring.jacobson (End Ybar)) ^ 2 := by
      have heq : End.of
          ((a.asHom ≫ beta) ≫ r) = End.of (beta ≫ r) * a := by
        apply End.ext
        simp only [End.mul_def, Category.assoc]
      rw [heq]
      exact ((Ring.jacobson (End Ybar)) ^ 2).mul_mem_right a hbase
    exact RoiterFigure13D.RadicalSquareCoefficientData.coefficientOne_eq_zero_of_mem_jacobson_sq
      Pbar residue middle hresTau _ hsq
  refine ⟨?_⟩
  change ClosedZigzagCrossUniverse.ThinPathCoefficientData (k := k)
    ((RoiterFigure13D.repeatedMiddleDiagram
      alpha beta Pbar.tau).functor (k := k))
  exact RoiterFigure13D.repeatedMiddleThinPathCoefficientData
    alpha beta Pbar.tau residue middle extension
    hresTau (fun a ↦ Pbar.mul_comm a Pbar.tau)
    hAlphaFactor hBetaFactor hThroughXZero hThroughXOne
    hThroughZZero hThroughZOne

/-- Nonexceptionality in the exact hard branch constructs the forbidden
Figure-13 Hom-bifunctor retraction. -/
theorem quotientDiagram_homBifunctorRetraction_of_not_special
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (hfspan : twoSidedEndomorphismSpan k f = ⊤)
    (hgspan : twoSidedEndomorphismSpan k g = ⊤)
    (hXY : X ≠ Y) (hYZ : Y ≠ Z)
    (hfNotC : ¬AllowsCotransit f) (hgNotT : ¬AllowsTransit g)
    (hleft : f ≫ (P.tau ^ 2).asHom ≠ 0)
    (hright : (P.tau ^ 2).asHom ≫ g ≠ 0)
    (hns : ¬ IsBGRSSpecialZero f g) :
    Nonempty (HomBifunctorRetraction (k := k)
      ((quotientDiagram S f g P).functor (k := k))) := by
  obtain ⟨h⟩ := quotientDiagram_thinPathCoefficientData
    S f g P hfspan hgspan hXY hYZ hfNotC hgNotT hleft hright hns
  exact ⟨h.homBifunctorRetraction⟩

/-- Representation-finiteness rules out the nonexceptional exact hard
Figure-13 branch. -/
theorem isBGRSSpecialZero_of_exact_hard_branch
    [Infinite k]
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (hfinite : LargeIndecomposable.MildAlg k A)
    (hfspan : twoSidedEndomorphismSpan k f = ⊤)
    (hgspan : twoSidedEndomorphismSpan k g = ⊤)
    (hXY : X ≠ Y) (hYZ : Y ≠ Z)
    (hfNotC : ¬AllowsCotransit f) (hgNotT : ¬AllowsTransit g)
    (hleft : f ≫ (P.tau ^ 2).asHom ≠ 0)
    (hright : (P.tau ^ 2).asHom ≫ g ≠ 0) :
    IsBGRSSpecialZero f g := by
  by_contra hns
  exact quotientDiagram_not_homBifunctorRetraction S f g P hfinite hleft
    (quotientDiagram_homBifunctorRetraction_of_not_special
      S f g P hfspan hgspan hXY hYZ hfNotC hgNotT hleft hright hns)

end LargeIndecomposable.RoiterFigure13Quotient
