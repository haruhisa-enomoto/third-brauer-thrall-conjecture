/-- The left Figure-13 arrow still generates its whole quotient Hom space. -/
theorem quotientDiagram_alpha_span_eq_top
    {X Y Z : S.ProjectiveCategory}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (P : OrientedRadicalPowerParameter (k := k) Y)
    (hfspan : twoSidedEndomorphismSpan k f = ⊤) :
    twoSidedEndomorphismSpan k (quotientDiagram S f g P).alpha = ⊤ := by
  exact quotientFunctor_map_span_eq_top S f g P f hfspan

