module

public import LargeIndecomposable.MultiplicativeBases.Twisted.ArrowTwist
public import LargeIndecomposable.RayCategories.Distributive.OneSided
public import LargeIndecomposable.Cleaving.ClosedChains.RadicalPowerParameter
public import LargeIndecomposable.RayCategories.Distributive.BGRSRayArrowRadical

/-!
# Killing through an endomorphism ring generated by a loop

For a distributive split basic algebra, if every non-invertible endomorphism ray of
a vertex is a power of the ray of a loop `ℓ`, then the endomorphism ring of the
projective is generated by any representative `ℓ̂` (`adjoin_loop_eq_top`). Hence
`g ≫ u ≫ f = 0` for every endomorphism `u` once `g ≫ ℓ̂ⁿ ≫ f = 0` for all `n`
(`comp_end_comp_eq_zero`).
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

open CategoryTheory Limits LargeIndecomposable

namespace LargeIndecomposable.RadicalLoopKill

universe u v w

/-- The `n`-th power of a loop as a path. -/
def loopPath {V : Type*} [Quiver V] {j : V} (ℓ : j ⟶ j) : ℕ → Quiver.Path j j
  | 0 => .nil
  | n + 1 => (loopPath ℓ n).cons ℓ

lemma pathMap_loopPath {V : Type*} [Quiver V] {D : Type*} [Category D] (F₀ : V → D)
    (F₁ : ∀ {i j : V}, (i ⟶ j) → (F₀ j ⟶ F₀ i)) {j : V} (ℓ : j ⟶ j) :
    ∀ n, LinearPathCategory.pathMap F₀ F₁ (loopPath ℓ n) = (End.of (F₁ ℓ) ^ n).asHom
  | 0 => by simp [loopPath]
  | n + 1 => by
    rw [loopPath, LinearPathCategory.pathMap_cons, pathMap_loopPath F₀ F₁ ℓ n, pow_succ]
    rfl

variable {k : Type u} [Field k] [IsAlgClosed k] {A : Type v} [Ring A] [Algebra k A]
  [Module.Finite k A] {ι : Type w} [Fintype ι] [DecidableEq ι]
  (S : SplitBasicIdempotents (k := k) (A := A) (ι := ι))
  [HasBGRSDistributiveHomStructure k S.ProjectiveCategory]

/-- A radical endomorphism has a non-invertible ray. -/
lemma not_isIso_unitRay_of_mem_jacobson {X : S.ProjectiveCategory} (a : End X)
    (ha : a ∈ Ring.jacobson (End X)) :
    ¬IsIso (show (BGRSRayCategory.mk X) ⟶ (BGRSRayCategory.mk X) from unitRay a.asHom) := by
  intro h
  haveI : IsIso a.asHom :=
    BGRSRayCategory.representative_isIso_of_isIso
      (SplitBasicIdempotents.ProjectiveCategory.id_ne_zero S) a.asHom
  have hunit : IsUnit a := (isUnit_iff_isIso a).2 inferInstance
  exact (mem_ringJacobson_iff_not_isUnit (End X) a).1 ha hunit

/-- **The endomorphism ring is generated by the loop.** -/
theorem adjoin_loop_eq_top (L : BGRSRayArrowLift (C := S.ProjectiveCategory))
    {j : RayVertex S.RayCategory} (ℓ : j ⟶ j)
    (hEC : ∀ f : j.obj ⟶ j.obj, ¬IsIso f → ∃ n, 0 < n ∧ f = (End.of ℓ.1 ^ n).asHom) :
    Algebra.adjoin k ({End.of (L.representative ℓ)} : Set (End j.obj.as)) = ⊤ := by
  set X := j.obj.as
  set τ : End X := End.of (L.representative ℓ) with hτ
  letI : Module.Finite k (End X) := by
    change Module.Finite k (X ⟶ X)
    infer_instance
  have hτJ : τ ∈ Ring.jacobson (End X) :=
    (S.projectiveEnd_mem_jacobson_iff_val_mem_jacobson X τ).2
      (S.rayArrowLift_representative_mem_jacobson L ℓ)
  refine ClosedZigzagTransfer.algebra_adjoin_singleton_eq_top_of_left_radical_generator τ hτJ ?_
  intro x hx
  by_cases hx0 : x = 0
  · exact ⟨0, by rw [hx0, zero_mul]⟩
  obtain ⟨n, hn, hxn⟩ := hEC (unitRay x.asHom) (not_isIso_unitRay_of_mem_jacobson S x hx)
  have hray : rayPathMap (loopPath ℓ n) = (End.of ℓ.1 ^ n).asHom :=
    pathMap_loopPath RayVertex.obj rayArrowMorphism ℓ n
  have hne : rayPathMap (loopPath ℓ n) ≠ 0 := by
    rw [hray, ← hxn]
    intro h
    exact hx0 ((unitRay_eq_zero_iff x.asHom).1 h)
  have hu := L.unitRay_pathMap_eq_rayPathMap_of_ne_zero (loopPath ℓ n) hne
  have hLp : L.pathMap (loopPath ℓ n) = (τ ^ n).asHom :=
    pathMap_loopPath (fun v ↦ v.obj.as) L.representative ℓ n
  rw [hLp, hray, ← hxn] at hu
  obtain ⟨a, b, hab⟩ := (unitRay_eq_iff _ _).1 hu
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  refine ⟨End.of ((τ ^ m).asHom ≫ a.hom ≫ b.hom), ?_⟩
  have hc : a.hom ≫ (τ ^ (m + 1)).asHom = (τ ^ (m + 1)).asHom ≫ a.hom :=
    projEnd_comp_comm S (End.of a.hom) (τ ^ (m + 1))
  change x.asHom = τ.asHom ≫ (τ ^ m).asHom ≫ a.hom ≫ b.hom
  rw [hab, ← Category.assoc, hc, Category.assoc, pow_succ, End.mul_def]
  simp only [End.asHom, Category.assoc]

/-- **Killing through any endomorphism**: if `g ≫ ℓ̂ⁿ ≫ f = 0` for all `n`, then
`g ≫ u ≫ f = 0` for every endomorphism `u`. -/
theorem comp_end_comp_eq_zero (L : BGRSRayArrowLift (C := S.ProjectiveCategory))
    {j : RayVertex S.RayCategory} (ℓ : j ⟶ j)
    (hEC : ∀ f : j.obj ⟶ j.obj, ¬IsIso f → ∃ n, 0 < n ∧ f = (End.of ℓ.1 ^ n).asHom)
    {Y Z : S.ProjectiveCategory} (g : Z ⟶ j.obj.as) (f : j.obj.as ⟶ Y)
    (h : ∀ n, g ≫ (End.of (L.representative ℓ) ^ n).asHom ≫ f = 0)
    (u : j.obj.as ⟶ j.obj.as) : g ≫ u ≫ f = 0 := by
  have hu : (End.of u) ∈ Algebra.adjoin k ({End.of (L.representative ℓ)} : Set (End j.obj.as)) := by
    rw [adjoin_loop_eq_top S L ℓ hEC]; trivial
  have key : ∀ P : Polynomial k,
      g ≫ (Polynomial.aeval (End.of (L.representative ℓ)) P).asHom ≫ f = 0 := by
    intro P
    induction P using Polynomial.induction_on' with
    | add p q hp hq =>
      rw [map_add]
      change g ≫ ((Polynomial.aeval _ p : End _).asHom + (Polynomial.aeval _ q : End _).asHom) ≫
        f = 0
      rw [Preadditive.add_comp, Preadditive.comp_add, hp, hq, add_zero]
    | monomial n c =>
      rw [Polynomial.aeval_monomial, Algebra.algebraMap_eq_smul_one, smul_mul_assoc, one_mul]
      change g ≫ (c • (End.of (L.representative ℓ) ^ n).asHom) ≫ f = 0
      rw [Linear.smul_comp, Linear.comp_smul, h n, smul_zero]
  rw [Algebra.adjoin_singleton_eq_range_aeval] at hu
  obtain ⟨P, hP⟩ := hu
  have hP' : Polynomial.aeval (End.of (L.representative ℓ)) P = End.of u := hP
  have := key P
  rwa [hP'] at this

end LargeIndecomposable.RadicalLoopKill
