module

public import LargeIndecomposable.Coverings.GradedModules.RayGrading
public import LargeIndecomposable.RayCategories.Basic.MorphismDepth
public import LargeIndecomposable.RayCategories.RoiterVanishing.KeyLemma

/-!
# Rays act by zero on simple modules

A nonzero non-invertible morphism `f` of a finite ray category acts by zero on every
simple `k(P)`-module (`morElt_smul_simple`): otherwise `f s = f b f s` for some `b`, and
the composites `f ν f` have larger depth (downward induction on depth). Hence homogeneous
elements of nontrivial degree kill simple modules (`smul_simple_of_ne_one`), and every
graded-indecomposable projective has a graded maximal submodule (`rayGrRadHyp`).
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable.RayCat

open CategoryTheory Limits LargeIndecomposable.Graded RayQuiver Cover AR

universe u

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P]
variable (k : Type u) [Field k]

lemma depth_pos_of_not_isIso {x y : P} {f : x ⟶ y} (hf : f ≠ 0) (hni : ¬IsIso f) :
    0 < depth f := by
  obtain ⟨p, hp⟩ := RayCat.exists_path f hf
  have hpl : 0 < p.length := by
    cases p with
    | nil => exact absurd (hp ▸ IsIso.id _) hni
    | cons p e => simp
  exact lt_of_lt_of_le hpl (length_le_depth' p hp hf)

lemma not_isIso_of_depth_pos {x y : P} {f : x ⟶ y} (hf : f ≠ 0) (hd : 0 < depth f) :
    ¬IsIso f := by
  obtain ⟨p, hpl, hp⟩ := exists_path_depth hf
  rw [← hp]
  exact not_isIso_pathVal p (by omega)

/-- **Non-invertible rays act by zero on simple modules.** -/
theorem morElt_smul_simple {S : Type*} [AddCommGroup S] [Module (Linearization P k) S]
    [Module k S] [IsScalarTower k (Linearization P k) S]
    [hS : IsSimpleModule (Linearization P k) S] :
    ∀ {x y : P} (f : x ⟶ y), f ≠ 0 → ¬IsIso f → ∀ s : S, morElt k f • s = 0 := by
  classical
  -- downward induction on the depth
  let D := Finset.univ.sup fun μ : NZ P ↦ depth μ.2.2.1
  have hD : ∀ {x y : P} (f : x ⟶ y), f ≠ 0 → depth f ≤ D := by
    intro x y f hf
    exact Finset.le_sup (f := fun μ : NZ P ↦ depth μ.2.2.1) (Finset.mem_univ ⟨x, y, f, hf⟩)
  suffices H : ∀ m, ∀ {x y : P} (f : x ⟶ y), f ≠ 0 → ¬IsIso f → D - depth f = m →
      ∀ s : S, morElt k f • s = 0 from fun {x y} f hf hni s ↦ H _ f hf hni rfl s
  intro m
  induction m using Nat.strong_induction_on with
  | _ m ih =>
  intro x y f hf hni hm s
  by_contra hs
  -- `s` lies in the submodule generated by `f s`
  have htop : Submodule.span (Linearization P k) {morElt k f • s} = ⊤ :=
    (hS.toIsSimpleOrder.eq_bot_or_eq_top _).resolve_left (by
      rw [Submodule.span_singleton_eq_bot]; exact hs)
  obtain ⟨b, hb⟩ := Submodule.mem_span_singleton.1 (htop ▸ Submodule.mem_top : s ∈ _)
  -- `f s = (f b f) s` and every `f ν f` acts by zero
  have hfbf : (morElt k f * b * morElt k f) • s = 0 := by
    rw [← (linBasisR k P).sum_repr b, Finset.mul_sum, Finset.sum_mul, Finset.sum_smul]
    refine Finset.sum_eq_zero fun ν _ ↦ ?_
    rw [mul_smul_comm, smul_mul_assoc, smul_assoc, linBasisR_apply]
    obtain ⟨a', b', g, hg⟩ := ν
    by_cases hb' : b' = x
    · subst hb'
      rw [morElt_mul]
      by_cases ha' : a' = y
      · subst ha'
        rw [morElt_mul, ← Category.assoc]
        by_cases h0 : (f ≫ g) ≫ f = 0
        · rw [h0, morElt_zero, zero_smul, smul_zero]
        · have hlt : depth f < depth ((f ≫ g) ≫ f) := by
            have h1 := depth_le_comp_right f g (fun h ↦ h0 (by rw [h, zero_comp]))
            have h2 := depth_lt_comp_right (f ≫ g) f h0 hni
            omega
          have hdf := hD _ h0
          rw [ih (D - depth ((f ≫ g) ≫ f)) (by omega) _ h0
            (not_isIso_of_depth_pos h0 (by omega)) rfl s, smul_zero]
      · rw [morElt_mul_ne k f (g ≫ f) (Ne.symm ha'), zero_smul, smul_zero]
    · rw [morElt_mul_ne k g f hb', zero_mul, zero_smul, smul_zero]
  apply hs
  calc morElt k f • s = morElt k f • (b • (morElt k f • s)) := by rw [hb]
    _ = (morElt k f * b * morElt k f) • s := by rw [mul_smul, mul_smul]
    _ = 0 := hfbf

variable {x₀ : P} (ℓ : ∀ y : P, vtx x₀ ⟶ vtx y)

/-- **Homogeneous elements of nontrivial degree act by zero on simple modules.** -/
theorem smul_simple_of_ne_one {S : Type*} [AddCommGroup S] [Module (Linearization P k) S]
    [Module k S] [IsScalarTower k (Linearization P k) S]
    [IsSimpleModule (Linearization P k) S] {h : Pi1 x₀} (hh : h ≠ 1)
    {a : Linearization P k} (ha : (rayGrAlg ℓ k).Mem h a) (s : S) : a • s = 0 := by
  have ha' : a ∈ Submodule.span k (linBasisR k P '' {μ | rayDeg ℓ μ = h}) :=
    (rayGrading_mem_iff ℓ k h a).1 ha
  clear ha
  induction ha' using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨⟨x, y', f, hf⟩, hμ, rfl⟩ := hy
    rw [linBasisR_apply]
    refine morElt_smul_simple k f hf (fun hiso ↦ hh ?_) s
    obtain ⟨hxy, hfe⟩ := eq_eqToHom_of_isIso f
    subst hxy
    simp only [eqToHom_refl] at hfe
    subst hfe
    rw [← hμ]
    exact rayDeg_id ℓ x
  | zero => simp
  | add y z _ _ hy hz => rw [add_smul, hy, hz, add_zero]
  | smul c y _ hy => rw [smul_assoc, hy, smul_zero]

/-- **Graded maximal submodules of graded-indecomposable projectives** (indeed of every
nonzero graded module). -/
theorem rayGrRadHyp : GrRadHyp (rayGrAlg ℓ k) := by
  classical
  intro Z μ _ hZnt _
  have : IsNoetherian (Linearization P k) Z := isNoetherian_of_tower k inferInstance
  obtain ⟨U₀, hU₀, -⟩ := (eq_top_or_exists_le_coatom (⊥ : Submodule (Linearization P k) Z)).resolve_left
    bot_ne_top
  have : IsSimpleModule (Linearization P k) (Z ⧸ U₀) := isSimpleModule_iff_isCoatom.2 hU₀
  let π := U₀.mkQ
  -- some homogeneous component survives in the quotient
  obtain ⟨g, hg⟩ : ∃ g, ∃ z, π (μ.proj g z) ≠ 0 := by
    by_contra hall
    push Not at hall
    apply hU₀.1
    rw [eq_top_iff]
    intro z _
    have : π z = 0 := by
      rw [← μ.sum_eq z, map_sum]
      exact Finset.sum_eq_zero fun g _ ↦ hall g z
    exact (Submodule.Quotient.mk_eq_zero U₀).1 this
  let π' : Z →ₗ[Linearization P k] Z ⧸ U₀ :=
    { toFun z := π (μ.proj g z)
      map_add' z w := by simp
      map_smul' a z := by
        rw [RingHom.id_apply]
        conv_lhs => rw [← (rayGrAlg ℓ k).sum_eq a, Finset.sum_smul, map_sum, map_sum]
        conv_rhs => rw [← (rayGrAlg ℓ k).sum_eq a, Finset.sum_smul]
        refine Finset.sum_congr rfl fun x _ ↦ ?_
        have hx := (rayGrAlg ℓ k).mem_proj x a
        set b := (rayGrAlg ℓ k).proj x a
        by_cases h1 : x = 1
        · subst h1
          have := μ.proj_smul hx g z
          rw [one_mul] at this
          rw [this, map_smul]
        · have e := μ.proj_smul hx (x⁻¹ * g) z
          rw [mul_inv_cancel_left] at e
          rw [e, map_smul, smul_simple_of_ne_one k ℓ h1 hx, smul_simple_of_ne_one k ℓ h1 hx] }
  have hsurj : Function.Surjective π' := by
    have hne : LinearMap.range π' ≠ ⊥ := by
      obtain ⟨z, hz⟩ := hg
      intro h0
      exact hz (by
        have : π' z ∈ LinearMap.range π' := LinearMap.mem_range_self _ z
        rw [h0] at this; exact (Submodule.mem_bot _).1 this)
    exact LinearMap.range_eq_top.1 ((eq_bot_or_eq_top _).resolve_left hne)
  refine ⟨LinearMap.ker π', fun z hz h ↦ ?_, ?_⟩
  · rw [LinearMap.mem_ker] at hz ⊢
    change π (μ.proj g (μ.proj h z)) = 0
    by_cases hgh : g = h
    · subst hgh; rw [Grading.proj_proj]; exact hz
    · rw [μ.orth g h hgh, map_zero]
  · refine ⟨fun htop ↦ ?_, fun V hV ↦ ?_⟩
    · obtain ⟨z, hz⟩ := hg
      exact hz (LinearMap.mem_ker.1 (htop ▸ Submodule.mem_top : z ∈ LinearMap.ker π'))
    · obtain ⟨v, hvV, hvk⟩ := SetLike.exists_of_lt hV
      have hmap : V.map π' = ⊤ := by
        refine (eq_bot_or_eq_top _).resolve_left fun h0 ↦ hvk ?_
        have : π' v ∈ V.map π' := Submodule.mem_map_of_mem hvV
        rw [h0] at this
        exact LinearMap.mem_ker.2 ((Submodule.mem_bot _).1 this)
      rw [eq_top_iff]
      intro z _
      obtain ⟨w, hwV, hw⟩ : π' z ∈ V.map π' := hmap ▸ Submodule.mem_top
      have : z - w ∈ LinearMap.ker π' := by rw [LinearMap.mem_ker, map_sub, hw, sub_self]
      have := V.add_mem (hV.le this) hwV
      simpa using this

end LargeIndecomposable.RayCat
