module

public import LargeIndecomposable.AuslanderReiten.AlmostSplit.EndomorphismRadical

set_option backward.isDefEq.respectTransparency.types false

/-!
# Anti-exchange for quotient closure

This file formalizes the trace-and-radical proof of anti-exchange from
that paper.  The proof works on a chosen indecomposable skeleton and
assumes that each indecomposable endomorphism ring is Artinian.  That is
the exact ring-theoretic input used to make its Jacobson radical
nilpotent.

## References

* *Quotient-submodule equidistribution*, <https://github.com/haruhisa-enomoto/quotient-submodule-equidistribution>. Numbered statements cited here refer to it.
-/

@[expose] public section

noncomputable section

open Set
open CategoryTheory CategoryTheory.Limits

namespace LargeIndecomposable.IndecomposableSkeleton

variable {R : Type u} [Ring R] [IsNoetherianRing R]
  {ι : Type v} (σ : IndecomposableSkeleton.{u, v, w} R ι)

attribute [local instance]
  HasFiniteBiproducts.of_hasFiniteCoproducts

/-- The sum of the ranges of all maps from one indecomposable
representative. -/
def pointTrace (i : ι) (X : FGModuleCat.{w} R) :
    Submodule R X :=
  ⨆ f : σ.obj i ⟶ X, LinearMap.range f.hom.hom

omit [IsNoetherianRing R] in
private theorem fg_hom_sum_apply {J : Type*} [Fintype J]
    {X Y : FGModuleCat.{w} R} (f : J → (X ⟶ Y)) (x : X) :
    ((∑ j, f j).hom.hom) x =
      ∑ j, (f j).hom.hom x := by
  have h₁ :
      (∑ j, f j).hom = ∑ j, (f j).hom :=
    map_sum
      (InducedCategory.homAddEquiv :
        (X ⟶ Y) ≃+ (X.obj ⟶ Y.obj))
      f Finset.univ
  rw [h₁, ModuleCat.hom_sum]
  exact LinearMap.sum_apply _ _ x

/-- A singleton trace is already generated by maps from the single
indecomposable, rather than requiring maps from arbitrary finite sums of
its copies. -/
theorem trace_singleton_eq_pointTrace (i : ι)
    (X : FGModuleCat.{w} R) :
    σ.trace {i} X = σ.pointTrace i X := by
  apply le_antisymm
  · apply iSup_le
    intro f
    letI : Fintype f.index := FintypeCat.fintype
    rintro x ⟨y, rfl⟩
    have hmap :
        f.map =
          ∑ t : f.index,
            biproduct.π
                (fun t : f.index ↦ σ.obj (f.label t)) t ≫
              (biproduct.ι
                  (fun t : f.index ↦ σ.obj (f.label t)) t ≫
                f.map) := by
      calc
        f.map = 𝟙 _ ≫ f.map := (Category.id_comp _).symm
        _ =
            (∑ t : f.index,
              biproduct.π
                  (fun t : f.index ↦ σ.obj (f.label t)) t ≫
                biproduct.ι
                  (fun t : f.index ↦ σ.obj (f.label t)) t) ≫
              f.map := by rw [biproduct.total]
        _ = _ := by
          rw [Preadditive.sum_comp]
          simp only [Category.assoc]
    rw [hmap, fg_hom_sum_apply]
    apply Submodule.sum_mem
    intro t _
    have ht : f.label t = i := by
      simpa using f.mem t
    let ft : σ.obj (f.label t) ⟶ X :=
      biproduct.ι (fun t : f.index ↦ σ.obj (f.label t)) t ≫ f.map
    let ft' : σ.obj i ⟶ X :=
      eqToHom (congrArg σ.obj ht.symm) ≫ ft
    have hcat :
        eqToHom (congrArg σ.obj ht) ≫ ft' = ft := by
      dsimp only [ft']
      simp
    have hvalue :
        ft
            ((biproduct.π
              (fun t : f.index ↦ σ.obj (f.label t)) t) y) =
          ft'
            ((eqToHom (congrArg σ.obj ht))
              ((biproduct.π
                (fun t : f.index ↦ σ.obj (f.label t)) t) y)) := by
      exact
        (congrArg
          (fun q : σ.obj (f.label t) ⟶ X ↦
            q
              ((biproduct.π
                (fun t : f.index ↦ σ.obj (f.label t)) t) y))
          hcat).symm
    change
      ft
          ((biproduct.π
            (fun t : f.index ↦ σ.obj (f.label t)) t) y) ∈
        σ.pointTrace i X
    rw [hvalue]
    exact le_iSup
      (fun g : σ.obj i ⟶ X ↦ LinearMap.range g.hom.hom) ft'
      (LinearMap.mem_range_self ft'.hom.hom _)
  · apply iSup_le
    intro f
    exact range_le_trace_of_mem σ (Set.mem_singleton i) f

/-- The selected trace is fully invariant under every underlying
endomorphism, not just an endomorphism already presented categorically. -/
theorem trace_fullyInvariant_linear {S : Set ι}
    (X : FGModuleCat.{w} R) (f : Module.End R X) :
    Submodule.map f (σ.trace S X) ≤ σ.trace S X := by
  let F := forget₂ (FGModuleCat R) (ModuleCat R)
  let fc : X ⟶ X := F.preimage (ModuleCat.ofHom f)
  have hfc : fc.hom.hom = f := by
    have h := F.map_preimage (ModuleCat.ofHom f)
    exact congrArg ModuleCat.Hom.hom h
  rw [← hfc]
  exact trace_fullyInvariant σ X fc

/-- Postcomposition sends the point trace of `i` into the point trace
of `i`. -/
theorem map_pointTrace_le {i : ι}
    {X Y : FGModuleCat.{w} R} (f : X ⟶ Y) :
    Submodule.map f.hom.hom (σ.pointTrace i X) ≤
      σ.pointTrace i Y := by
  rw [pointTrace, Submodule.map_iSup]
  apply iSup_le
  intro g
  rw [← LinearMap.range_comp]
  exact le_iSup
    (fun h : σ.obj i ⟶ Y ↦ LinearMap.range h.hom.hom)
    (g ≫ f)

/-- If `x` and `y` index nonisomorphic representatives, every
endomorphism of `X` factoring through `Y` belongs to the Jacobson
radical of `End(X)`. -/
theorem comp_mem_end_jacobson {x y : ι} (hxy : x ≠ y)
    (f : σ.obj y ⟶ σ.obj x) (g : σ.obj x ⟶ σ.obj y) :
    f.hom.hom.comp g.hom.hom ∈
      Ring.jacobson (Module.End R (σ.obj x)) := by
  apply
    (LargeIndecomposable.mem_end_jacobson_iff_not_isUnit
      (σ.indecomposable x) (σ.finiteLength x)
      (f.hom.hom.comp g.hom.hom)).2
  intro hunit
  obtain ⟨e⟩ :=
    LargeIndecomposable.nonempty_linearEquiv_of_isUnit_comp
      (σ.indecomposable x) (σ.indecomposable y)
      f.hom.hom g.hom.hom hunit
  exact hxy (σ.eq_of_iso ⟨e.toFGModuleCatIso⟩)

/-- Substituting generation of `Y` by `C` and `X` into all maps
`Y → X` shows that the point trace of `Y` in `X` is generated by the
trace of `C` and the Jacobson radical of `End(X)`. -/
theorem pointTrace_le_trace_sup_jacobson
    (C : Set ι) {x y : ι} (hxy : x ≠ y)
    (hY :
      σ.trace C (σ.obj y) ⊔
        σ.pointTrace x (σ.obj y) = ⊤) :
    σ.pointTrace y (σ.obj x) ≤
      σ.trace C (σ.obj x) ⊔
        LargeIndecomposable.idealRange
          (Ring.jacobson (Module.End R (σ.obj x))) := by
  apply iSup_le
  intro f
  rw [← Submodule.map_top, ← hY, Submodule.map_sup]
  apply sup_le_sup
  · exact map_trace_le_trace σ f
  · rw [pointTrace, Submodule.map_iSup]
    apply iSup_le
    intro g
    rw [← LinearMap.range_comp]
    exact LargeIndecomposable.range_le_idealRange _
      (comp_mem_end_jacobson σ hxy f g)

end LargeIndecomposable.IndecomposableSkeleton
