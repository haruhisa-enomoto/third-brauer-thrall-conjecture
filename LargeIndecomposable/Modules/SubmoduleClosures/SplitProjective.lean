module

public import LargeIndecomposable.Modules.SubmoduleClosures.AntiExchange

set_option backward.isDefEq.respectTransparency.types false

/-!
# Extremality and relative split projectivity

For an indecomposable representative `x`, failure of `x` to be generated by
`C \ {x}` is equivalent to every epimorphism from an explicitly presented
object of `add C` to `x` splitting.

The difficult implication uses nilpotence of the Jacobson radical of
`End(x)`.  In the current skeleton this is supplied by the same Artinian
endomorphism-ring hypothesis used for anti-exchange.
-/

@[expose] public section

noncomputable section

open Set
open CategoryTheory CategoryTheory.Limits

namespace LargeIndecomposable.IndecomposableSkeleton

variable {R : Type u} [Ring R] [IsNoetherianRing R]
  {ι : Type v} (σ : IndecomposableSkeleton.{u, v, w} R ι)

attribute [local instance]
  HasFiniteBiproducts.of_hasFiniteCoproducts

/-- Relative split projectivity with respect to `add C`, expressed on the
explicit finite-sum skeleton: every epimorphic presentation from `add C`
admits a section. -/
def IsRelativeSplitProjective (C : Set ι) (x : ι) : Prop :=
  ∀ P : σ.FacPresentation C (σ.obj x), IsSplitEpi P.map

namespace FacPresentation

/-- The map from one summand of a quotient presentation to its target. -/
def component
    {S : Set ι} {X : FGModuleCat.{w} R}
    (P : σ.FacPresentation S X) (t : P.index) :
    σ.obj (P.label t) ⟶ X :=
  biproduct.ι (fun t : P.index ↦ σ.obj (P.label t)) t ≫ P.map

/-- A quotient presentation is pointwise the sum of its component maps. -/
theorem map_apply_eq_sum_components
    {S : Set ι} {X : FGModuleCat.{w} R}
    (P : σ.FacPresentation S X)
    [Fintype P.index]
    (z : σ.sumOver P.index P.label) :
    P.map.hom.hom z =
      ∑ t : P.index,
        (P.component σ t).hom.hom
          ((biproduct.π
            (fun t : P.index ↦ σ.obj (P.label t)) t).hom.hom z) := by
  have hcat :
      P.map =
        ∑ t : P.index,
          biproduct.π (fun t : P.index ↦ σ.obj (P.label t)) t ≫
            P.component σ t := by
    calc
      P.map = 𝟙 _ ≫ P.map := (Category.id_comp _).symm
      _ =
          (∑ t : P.index,
            biproduct.π (fun t : P.index ↦ σ.obj (P.label t)) t ≫
              biproduct.ι (fun t : P.index ↦ σ.obj (P.label t)) t) ≫
            P.map := by rw [biproduct.total]
      _ =
          ∑ t : P.index,
            biproduct.π (fun t : P.index ↦ σ.obj (P.label t)) t ≫
              P.component σ t := by
        simp only [Preadditive.sum_comp, component, Category.assoc]
  let q : P.index → (σ.sumOver P.index P.label ⟶ X) :=
    fun t ↦
      biproduct.π (fun t : P.index ↦ σ.obj (P.label t)) t ≫
        P.component σ t
  let underlying :
      (σ.sumOver P.index P.label ⟶ X) →+
        (σ.sumOver P.index P.label →ₗ[R] X) :=
    { toFun := fun f ↦ f.hom.hom
      map_zero' := rfl
      map_add' := fun _ _ ↦ rfl }
  have hmodule :
      (∑ t : P.index, q t).hom.hom =
        ∑ t : P.index, (q t).hom.hom := by
    change underlying (∑ t : P.index, q t) =
      ∑ t : P.index, underlying (q t)
    exact map_sum underlying q Finset.univ
  have hlinear := congrArg (fun q ↦ q.hom.hom) hcat
  change P.map.hom.hom = (∑ t : P.index, q t).hom.hom at hlinear
  rw [hmodule] at hlinear
  have happ := LinearMap.congr_fun hlinear z
  let eval :
      (σ.sumOver P.index P.label →ₗ[R] X) →+ X :=
    { toFun := fun f ↦ f z
      map_zero' := rfl
      map_add' := fun _ _ ↦ rfl }
  have heval :
      (∑ t : P.index, (q t).hom.hom) z =
        ∑ t : P.index, (q t).hom.hom z := by
    change eval (∑ t : P.index, (q t).hom.hom) =
      ∑ t : P.index, eval ((q t).hom.hom)
    exact map_sum eval (fun t : P.index ↦ (q t).hom.hom) Finset.univ
  rw [heval] at happ
  simpa only [q, FGModuleCat.hom_hom_comp, LinearMap.comp_apply] using happ

/-- If one component, transported to an endomorphism of the target
representative, is a unit, the whole presentation splits. -/
theorem isSplitEpi_of_isUnit_component
    {S : Set ι} {x : ι}
    (P : σ.FacPresentation S (σ.obj x)) (t : P.index)
    (ht : P.label t = x)
    (hunit :
      IsUnit
        ((eqToHom (congrArg σ.obj ht.symm) ≫
          P.component σ t).hom.hom)) :
    IsSplitEpi P.map := by
  let a : Module.End R (σ.obj x) :=
    (eqToHom (congrArg σ.obj ht.symm) ≫
      P.component σ t).hom.hom
  let e : σ.obj x ≃ₗ[R] σ.obj x :=
    { toLinearMap := a
      invFun := (Equiv.ofBijective a
        ((Module.End.isUnit_iff a).mp hunit)).invFun
      left_inv := (Equiv.ofBijective a
        ((Module.End.isUnit_iff a).mp hunit)).left_inv
      right_inv := (Equiv.ofBijective a
        ((Module.End.isUnit_iff a).mp hunit)).right_inv }
  let s : σ.obj x ⟶ σ.sumOver P.index P.label :=
    FGModuleCat.ofHom e.symm.toLinearMap ≫
      eqToHom (congrArg σ.obj ht.symm) ≫
        biproduct.ι (fun t : P.index ↦ σ.obj (P.label t)) t
  have hinv :
      FGModuleCat.ofHom e.symm.toLinearMap ≫
          (eqToHom (congrArg σ.obj ht.symm) ≫
            P.component σ t) =
        𝟙 (σ.obj x) := by
    apply FGModuleCat.hom_ext
    ext z
    change
      ((eqToHom (congrArg σ.obj ht.symm) ≫
        P.component σ t).hom.hom) (e.symm z) = z
    change a (e.symm z) = z
    change e (e.symm z) = z
    exact e.apply_symm_apply z
  apply IsSplitEpi.mk'
  refine { section_ := s, id := ?_ }
  calc
    s ≫ P.map =
        FGModuleCat.ofHom e.symm.toLinearMap ≫
          (eqToHom (congrArg σ.obj ht.symm) ≫
            P.component σ t) := by
      dsimp only [s, component]
      simp only [Category.assoc]
    _ = 𝟙 (σ.obj x) := hinv

/-- If a presentation does not split, every component labelled by the
target representative becomes a nonunit endomorphism after transport. -/
theorem not_isUnit_component_of_not_isSplitEpi
    {S : Set ι} {x : ι}
    (P : σ.FacPresentation S (σ.obj x))
    (hP : ¬ IsSplitEpi P.map)
    (t : P.index) (ht : P.label t = x) :
    ¬ IsUnit
      ((eqToHom (congrArg σ.obj ht.symm) ≫
        P.component σ t).hom.hom) :=
  fun hunit ↦ hP (P.isSplitEpi_of_isUnit_component σ t ht hunit)

/-- A nonsplit quotient presentation from `add C` has range contained in
the trace of `C \ {x}` plus the ranges of radical endomorphisms of `x`. -/
theorem range_le_trace_sdiff_sup_idealRange
    {C : Set ι} {x : ι}
    (P : σ.FacPresentation C (σ.obj x))
    (hP : ¬ IsSplitEpi P.map) :
    LinearMap.range P.map.hom.hom ≤
      σ.trace (C \ {x}) (σ.obj x) ⊔
        LargeIndecomposable.idealRange
          (Ring.jacobson (Module.End R (σ.obj x))) := by
  letI : Fintype P.index := FintypeCat.fintype
  rintro z ⟨a, rfl⟩
  rw [P.map_apply_eq_sum_components σ a]
  apply Submodule.sum_mem
  intro t _
  by_cases ht : P.label t = x
  · let f : σ.obj x ⟶ σ.obj x :=
      eqToHom (congrArg σ.obj ht.symm) ≫ P.component σ t
    have hfRad :
        f.hom.hom ∈
          Ring.jacobson (Module.End R (σ.obj x)) := by
      apply
        (LargeIndecomposable.mem_end_jacobson_iff_not_isUnit
          (σ.indecomposable x) (σ.finiteLength x) f.hom.hom).2
      exact P.not_isUnit_component_of_not_isSplitEpi σ hP t ht
    have hrange :
        LinearMap.range (P.component σ t).hom.hom ≤
          LinearMap.range f.hom.hom := by
      let e : σ.obj x ≅ σ.obj (P.label t) :=
        eqToIso (congrArg σ.obj ht.symm)
      have hfac : e.inv ≫ f = P.component σ t := by
        dsimp only [e, f]
        simp
      have hlinear := congrArg (fun q ↦ q.hom.hom) hfac
      rw [← hlinear]
      exact LinearMap.range_comp_le_range e.inv.hom.hom f.hom.hom
    exact
      (le_sup_of_le_right
        (hrange.trans
          (LargeIndecomposable.range_le_idealRange f.hom.hom hfRad)))
        ⟨_, rfl⟩
  · have hmem : P.label t ∈ C \ {x} := by
      exact ⟨P.mem t, by simpa using ht⟩
    exact le_sup_of_le_left
      (σ.range_le_trace_of_mem hmem (P.component σ t))
      ⟨_, rfl⟩

end FacPresentation

end LargeIndecomposable.IndecomposableSkeleton
