module

public import LargeIndecomposable.BongartzTheorem.ContourExclusion.NoContour

/-!
# The relations of a linearization, spanned by words of a closed set of paths

The kernel of the presentation `kQ_P → k(P)` is generated by the zero paths and by the
differences of two paths with the same value. Let `Z` be a set of nonempty directed paths of
`Q_P` which is closed under extension, contains the zero paths, and contains every path whose
value is also the value of a different path (`RelPaths`). The words of `Z` span a two-sided
ideal, so the kernel lies in their span (`ker_linPres_le_of`). `ker_linPres_le` is the case of
the zero paths of a ray category without contours.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits FinQuiver

namespace RayQuiver

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P]

/-- A set of nonempty directed paths of `Q_P`, closed under extension, containing the zero
paths and every path that shares its value with a different path. -/
structure RelPaths (Z : Set (List (quiver P).A)) : Prop where
  ne_nil : ∀ l ∈ Z, l ≠ []
  path : ∀ l ∈ Z, ∃ x y, PathFrom (D := quiver P) x l y
  ext_right : ∀ l ∈ Z, ∀ (l' : List (quiver P).A) (x z : P),
    PathFrom (D := quiver P) x (l ++ l') z → l ++ l' ∈ Z
  ext_left : ∀ l ∈ Z, ∀ (l' : List (quiver P).A) (x z : P),
    PathFrom (D := quiver P) x (l' ++ l) z → l' ++ l ∈ Z
  zero : ZeroPaths P ⊆ Z
  contour : ∀ (l l' : List (quiver P).A) (x y : P) (h : PathFrom (D := quiver P) x l y)
    (h' : PathFrom (D := quiver P) x l' y), pathMor l x y h = pathMor l' x y h' → l ≠ l' → l ∈ Z

variable {Z : Set (List (quiver P).A)} (hZ : RelPaths Z) (k : Type*) [Field k]

variable (Z) in
/-- The span of the words of `Z`. -/
def relSpan : Submodule k ((quiver P).PathAlgebra k) :=
  Submodule.span k (word k (quiver P) '' Z)

lemma word_mem_relSpan {l : List (quiver P).A} (hl : l ∈ Z) :
    word k (quiver P) l ∈ relSpan Z k :=
  Submodule.subset_span ⟨l, hl, rfl⟩

include hZ

lemma RelPaths.append_right {l : List (quiver P).A} (hl : l ∈ Z) (l' : List (quiver P).A) :
    word k (quiver P) (l ++ l') = 0 ∨ l ++ l' ∈ Z := by
  by_cases hp : ∃ x z, PathFrom (D := quiver P) x (l ++ l') z
  · obtain ⟨x, z, h⟩ := hp
    exact Or.inr (hZ.ext_right l hl l' x z h)
  · exact Or.inl (word_eq_zero_of_not_path k _ hp)

lemma RelPaths.append_left {l : List (quiver P).A} (hl : l ∈ Z) (l' : List (quiver P).A) :
    word k (quiver P) (l' ++ l) = 0 ∨ l' ++ l ∈ Z := by
  by_cases hp : ∃ x z, PathFrom (D := quiver P) x (l' ++ l) z
  · obtain ⟨x, z, h⟩ := hp
    exact Or.inr (hZ.ext_left l hl l' x z h)
  · exact Or.inl (word_eq_zero_of_not_path k _ hp)

lemma RelPaths.word_mul_mem (l' : List (quiver P).A) {z : (quiver P).PathAlgebra k}
    (hz : z ∈ relSpan Z k) : word k (quiver P) l' * z ∈ relSpan Z k := by
  induction hz using Submodule.span_induction with
  | mem a ha =>
    obtain ⟨l, hl, rfl⟩ := ha
    rw [← word_append]
    rcases hZ.append_right k hl l' with h | h
    · rw [h]; exact Submodule.zero_mem _
    · exact word_mem_relSpan k h
  | zero => rw [mul_zero]; exact Submodule.zero_mem _
  | add a b _ _ ha hb => rw [mul_add]; exact Submodule.add_mem _ ha hb
  | smul r a _ ha => rw [mul_smul_comm]; exact Submodule.smul_mem _ r ha

lemma RelPaths.mul_word_mem (l' : List (quiver P).A) {z : (quiver P).PathAlgebra k}
    (hz : z ∈ relSpan Z k) : z * word k (quiver P) l' ∈ relSpan Z k := by
  induction hz using Submodule.span_induction with
  | mem a ha =>
    obtain ⟨l, hl, rfl⟩ := ha
    rw [← word_append]
    rcases hZ.append_left k hl l' with h | h
    · rw [h]; exact Submodule.zero_mem _
    · exact word_mem_relSpan k h
  | zero => rw [zero_mul]; exact Submodule.zero_mem _
  | add a b _ _ ha hb => rw [add_mul]; exact Submodule.add_mem _ ha hb
  | smul r a _ ha => rw [smul_mul_assoc]; exact Submodule.smul_mem _ r ha

lemma RelPaths.vertex_mul_mem (v : P) {z : (quiver P).PathAlgebra k}
    (hz : z ∈ relSpan Z k) : vertex k (quiver P) v * z ∈ relSpan Z k := by
  induction hz using Submodule.span_induction with
  | mem a ha =>
    obtain ⟨l, hl, rfl⟩ := ha
    obtain ⟨x, y, h⟩ := hZ.path l hl
    rcases l with _ | ⟨c, l⟩
    · exact absurd rfl (hZ.ne_nil _ hl)
    · by_cases hv : v = y
      · subst hv
        rw [vertex_mul_word k c l x v h]
        exact word_mem_relSpan k hl
      · rw [← vertex_mul_word k c l x y h, ← mul_assoc, vertex_mul_vertex, if_neg hv, zero_mul]
        exact Submodule.zero_mem _
  | zero => rw [mul_zero]; exact Submodule.zero_mem _
  | add a b _ _ ha hb => rw [mul_add]; exact Submodule.add_mem _ ha hb
  | smul r a _ ha => rw [mul_smul_comm]; exact Submodule.smul_mem _ r ha

lemma RelPaths.mul_vertex_mem (v : P) {z : (quiver P).PathAlgebra k}
    (hz : z ∈ relSpan Z k) : z * vertex k (quiver P) v ∈ relSpan Z k := by
  induction hz using Submodule.span_induction with
  | mem a ha =>
    obtain ⟨l, hl, rfl⟩ := ha
    rcases l with _ | ⟨c, l⟩
    · exact absurd rfl (hZ.ne_nil _ hl)
    · by_cases hv : v = (quiver P).src c
      · subst hv
        rw [word_mul_vertex_src]
        exact word_mem_relSpan k hl
      · rw [← word_mul_vertex_src, mul_assoc, vertex_mul_vertex, if_neg (Ne.symm hv), mul_zero]
        exact Submodule.zero_mem _
  | zero => rw [zero_mul]; exact Submodule.zero_mem _
  | add a b _ _ ha hb => rw [add_mul]; exact Submodule.add_mem _ ha hb
  | smul r a _ ha => rw [smul_mul_assoc]; exact Submodule.smul_mem _ r ha

lemma RelPaths.mul_mem_left (a : (quiver P).PathAlgebra k) {z : (quiver P).PathAlgebra k}
    (hz : z ∈ relSpan Z k) : a * z ∈ relSpan Z k := by
  have ha : a ∈ vwSpan k (Q := quiver P) := by rw [vwSpan_eq_top]; trivial
  induction ha using Submodule.span_induction with
  | mem b hb =>
    rcases hb with ⟨v, rfl⟩ | ⟨l, rfl⟩
    · exact hZ.vertex_mul_mem k v hz
    · exact hZ.word_mul_mem k l hz
  | zero => rw [zero_mul]; exact Submodule.zero_mem _
  | add b c _ _ hb hc => rw [add_mul]; exact Submodule.add_mem _ hb hc
  | smul r b _ hb => rw [smul_mul_assoc]; exact Submodule.smul_mem _ r hb

lemma RelPaths.mul_mem_right (a : (quiver P).PathAlgebra k) {z : (quiver P).PathAlgebra k}
    (hz : z ∈ relSpan Z k) : z * a ∈ relSpan Z k := by
  have ha : a ∈ vwSpan k (Q := quiver P) := by rw [vwSpan_eq_top]; trivial
  induction ha using Submodule.span_induction with
  | mem b hb =>
    rcases hb with ⟨v, rfl⟩ | ⟨l, rfl⟩
    · exact hZ.mul_vertex_mem k v hz
    · exact hZ.mul_word_mem k l hz
  | zero => rw [mul_zero]; exact Submodule.zero_mem _
  | add b c _ _ hb hc => rw [mul_add]; exact Submodule.add_mem _ hb hc
  | smul r b _ hb => rw [mul_smul_comm]; exact Submodule.smul_mem _ r hb

/-- **The kernel of `kQ_P → k(P)` lies in the span of the words of `Z`.** -/
theorem RelPaths.ker_linPres_le_of (z : (quiver P).PathAlgebra k) (hz : linPres P k z = 0) :
    z ∈ relSpan Z k := by
  have hrel : ∀ a b, RingQuot.Rel (LinRel P k) a b → a - b ∈ relSpan Z k := by
    intro a b h
    induction h with
    | of h =>
      rcases h with ⟨l, x, y, h, h0⟩ | ⟨l, l', x, y, h, h', he⟩
      · rw [sub_zero]; exact word_mem_relSpan k (hZ.zero ⟨x, y, h, h0⟩)
      · by_cases hll : l = l'
        · rw [hll, sub_self]; exact Submodule.zero_mem _
        · exact Submodule.sub_mem _ (word_mem_relSpan k (hZ.contour l l' x y h h' he hll))
            (word_mem_relSpan k (hZ.contour l' l x y h' h he.symm (Ne.symm hll)))
    | add_left _ ih => rwa [add_sub_add_right_eq_sub]
    | mul_left _ ih => rw [← sub_mul]; exact hZ.mul_mem_right k _ ih
    | mul_right _ ih => rw [← mul_sub]; exact hZ.mul_mem_left k _ ih
  have heq : Relation.EqvGen (RingQuot.Rel (LinRel P k)) z 0 := by
    have h1 : linPres P k z = linPres P k 0 := by rw [hz, map_zero]
    simp only [linPres, RingQuot.mkAlgHom_def, RingQuot.mkRingHom_def] at h1
    exact Quot.eqvGen_exact (congrArg RingQuot.toQuot h1)
  have key : ∀ a b, Relation.EqvGen (RingQuot.Rel (LinRel P k)) a b → a - b ∈ relSpan Z k := by
    intro a b hab
    induction hab with
    | rel a b h => exact hrel a b h
    | refl a => rw [sub_self]; exact Submodule.zero_mem _
    | symm a b _ ih => rw [← neg_sub]; exact Submodule.neg_mem _ ih
    | trans a b c _ _ iab ibc => rw [← sub_add_sub_cancel a b c]; exact Submodule.add_mem _ iab ibc
  simpa using key z 0 heq

end RayQuiver

end LargeIndecomposable
