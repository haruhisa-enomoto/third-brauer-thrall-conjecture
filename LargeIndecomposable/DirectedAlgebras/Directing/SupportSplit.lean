module

public import LargeIndecomposable.DirectedAlgebras.EulerForm.EulerUnit

/-!
# Splitting the support of a module

Let `M` be a module over a directed algebra whose support is split into two disjoint sets `L`
and `R`, such that every corner `e_y A e_x` attached to an arrow from one set to the other acts
by zero on `e_x M`. Corners are generated by arrows (`DirData.gen`), so by induction along the
path order no corner from `L` to `R` acts on `M` (`corner_cross_zero`); hence the parts of `M`
over `L` and over `R` are submodules and `M` is their direct sum (`not_isIndecMod_of_split`).
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable.AR

open Module

universe u

variable {k A : Type u} [Field k] [Ring A] [Algebra k A] [FiniteDimensional k A]

namespace DirData

variable (D : DirData k A) (M : FDMod k A) (L R : Set D.ι)

/-- **No corner from `L` to `R` acts.** -/
theorem corner_cross_zero (hdisj : ∀ x, x ∈ L → x ∉ R)
    (hsupp : ∀ y, y ∉ L → y ∉ R → ∀ m : M, D.e y • m = 0)
    (hcross : ∀ x y, x ∈ L → y ∈ R → D.Arr x y → ∀ (c : A) (m : M), (D.e y * c * D.e x) • m = 0) :
    ∀ x, x ∈ L → ∀ y, y ∈ R → ∀ (c : A) (m : M), (D.e y * c * D.e x) • m = 0 := by
  classical
  obtain ⟨lo, hmono⟩ := exists_linOrder D
  letI := lo
  intro x
  induction x using WellFoundedGT.induction with
  | _ x ih =>
  intro hx y hy c m
  have hyx : y ≠ x := fun h ↦ hdisj x hx (h ▸ hy)
  have hgen := D.gen x c
  obtain ⟨n, f, g, hfg⟩ := Submodule.mem_span_set'.1 hgen
  have h0 : D.e y * D.e x = 0 := D.orth y x hyx
  have h1 : D.e y * c * D.e x = D.e y * ((1 - D.e x) * c * D.e x) := by
    have : D.e y * ((1 - D.e x) * c * D.e x) = D.e y * c * D.e x - (D.e y * D.e x) * c * D.e x := by
      noncomm_ring
    rw [this, h0, zero_mul, zero_mul, sub_zero]
  rw [h1, ← hfg, Finset.mul_sum, Finset.sum_smul]
  refine Finset.sum_eq_zero fun i _ ↦ ?_
  obtain ⟨y', b, hxy', hg⟩ := (g i).2
  rw [smul_eq_mul, hg]
  have hlt : x < y' := lt_of_le_of_ne (hmono x y' (Relation.ReflTransGen.single hxy'))
    (D.ne_of_arr hxy')
  have e1 : D.e y * (f i * (D.e y' * b * D.e x)) = (D.e y * f i * D.e y') * (D.e y' * b * D.e x) := by
    rw [show (D.e y * f i * D.e y') * (D.e y' * b * D.e x) =
      D.e y * f i * (D.e y' * D.e y') * b * D.e x by noncomm_ring, D.e_mul_e]
    noncomm_ring
  rw [e1, mul_smul]
  by_cases hy'L : y' ∈ L
  · exact ih y' hlt hy'L y hy (f i) _
  by_cases hy'R : y' ∈ R
  · have : (D.e y' * b * D.e x) • m = 0 := hcross x y' hx hy'R hxy' b m
    rw [this, smul_zero]
  · have : (D.e y' * b * D.e x) • m = 0 := by
      have h2 : D.e y' • ((D.e y' * b * D.e x) • m) = (D.e y' * b * D.e x) • m := by
        rw [← mul_smul, ← mul_assoc, ← mul_assoc, D.e_mul_e]
      rw [← h2]
      exact hsupp y' hy'L hy'R _
    rw [this, smul_zero]

/-- The part of `M` over `L`. -/
def partSub (hdisj : ∀ x, x ∈ L → x ∉ R) (hsupp : ∀ y, y ∉ L → y ∉ R → ∀ m : M, D.e y • m = 0)
    (hcross : ∀ x y, x ∈ L → y ∈ R → D.Arr x y → ∀ (c : A) (m : M),
      (D.e y * c * D.e x) • m = 0) : Submodule A M where
  carrier := {m | ∀ y, y ∉ L → D.e y • m = 0}
  add_mem' {m n} hm hn y hy := by rw [smul_add, hm y hy, hn y hy, add_zero]
  zero_mem' y _ := smul_zero _
  smul_mem' c m hm y hy := by
    classical
    have hsum : D.e y • c • m = ∑ x, (D.e y * c * D.e x) • m := by
      rw [← Finset.sum_smul, ← Finset.mul_sum, D.sum, mul_one, mul_smul]
    rw [hsum]
    refine Finset.sum_eq_zero fun x _ ↦ ?_
    by_cases hx : x ∈ L
    · by_cases hyR : y ∈ R
      · exact D.corner_cross_zero M L R hdisj hsupp hcross x hx y hyR c m
      · rw [mul_assoc, mul_smul]
        exact hsupp y hy hyR _
    · rw [mul_smul, hm x hx, smul_zero]

/-- **A module whose support splits along arrows acting by zero is decomposable.** -/
theorem not_isIndecMod_of_split (hdisj : ∀ x, x ∈ L → x ∉ R)
    (hsupp : ∀ y, y ∉ L → y ∉ R → ∀ m : M, D.e y • m = 0)
    (hLR : ∀ x y, x ∈ L → y ∈ R → D.Arr x y → ∀ (c : A) (m : M), (D.e y * c * D.e x) • m = 0)
    (hRL : ∀ x y, x ∈ R → y ∈ L → D.Arr x y → ∀ (c : A) (m : M), (D.e y * c * D.e x) • m = 0)
    (hL : ∃ x ∈ L, ∃ m : M, D.e x • m ≠ 0) (hR : ∃ y ∈ R, ∃ m : M, D.e y • m ≠ 0) :
    ¬ IsIndecMod A M := by
  classical
  have hdisj' : ∀ x, x ∈ R → x ∉ L := fun x hx hL' ↦ hdisj x hL' hx
  have hsupp' : ∀ y, y ∉ R → y ∉ L → ∀ m : M, D.e y • m = 0 := fun y h1 h2 ↦ hsupp y h2 h1
  set VL := D.partSub M L R hdisj hsupp hLR
  set VR := D.partSub M R L hdisj' hsupp' hRL
  have hdec : ∀ m : M, m = ∑ x, D.e x • m := fun m ↦ by rw [← Finset.sum_smul, D.sum, one_smul]
  have hcompl : IsCompl VL VR := by
    constructor
    · rw [Submodule.disjoint_def]
      intro m h1 h2
      rw [hdec m]
      refine Finset.sum_eq_zero fun y _ ↦ ?_
      by_cases hy : y ∈ L
      · exact h2 y (hdisj y hy)
      · exact h1 y hy
    · rw [codisjoint_iff, eq_top_iff]
      intro m _
      have hm : m = (∑ x ∈ Finset.univ.filter (· ∈ L), D.e x • m) +
          ∑ x ∈ Finset.univ.filter (· ∉ L), D.e x • m := by
        rw [Finset.sum_filter_add_sum_filter_not, ← hdec]
      rw [hm]
      refine Submodule.add_mem_sup ?_ ?_
      · intro y hy
        rw [Finset.smul_sum]
        refine Finset.sum_eq_zero fun x hx ↦ ?_
        have hxL : x ∈ L := (Finset.mem_filter.1 hx).2
        rw [← mul_smul, D.orth y x (fun h ↦ hy (h ▸ hxL)), zero_smul]
      · intro y hy
        rw [Finset.smul_sum]
        refine Finset.sum_eq_zero fun x hx ↦ ?_
        have hxL : x ∉ L := (Finset.mem_filter.1 hx).2
        by_cases hyx : y = x
        · subst hyx
          rw [← mul_smul, D.e_mul_e]
          exact hsupp y hxL hy m
        · rw [← mul_smul, D.orth y x hyx, zero_smul]
  intro hind
  rcases hind VL VR hcompl with h | h
  · obtain ⟨x, hx, m, hm⟩ := hL
    have hmem : D.e x • m ∈ VL := fun y hy ↦ by
      rw [← mul_smul, D.orth y x (fun h ↦ hy (h ▸ hx)), zero_smul]
    rw [h, Submodule.mem_bot] at hmem
    exact hm hmem
  · obtain ⟨x, hx, m, hm⟩ := hR
    have hmem : D.e x • m ∈ VR := fun y hy ↦ by
      rw [← mul_smul, D.orth y x (fun h ↦ hy (h ▸ hx)), zero_smul]
    rw [h, Submodule.mem_bot] at hmem
    exact hm hmem

end DirData

end LargeIndecomposable.AR
