module

public import LargeIndecomposable.AuslanderReiten.AlmostSplit.Unique

/-!
# Directed algebras with vertex idempotents

`DirData A` records a complete set of orthogonal idempotents `e x` (zero outside a set `T` of
live points), arrows `Arr` between live points without oriented cycles, the facts that
`e_x A e_x = k e_x` and that `e_y A e_x ≠ 0` only along paths `x ⇝ y`, and that the radical of
`A e_x` is generated by the arrows out of `x`. Piece algebras and their convex subpieces are of
this kind.

Each live point has a character `χ_x : A → k` with `e_x a e_x = χ_x(a) e_x` (`chi`), multiplicative
by directedness.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable.AR

open CategoryTheory Module

universe u

variable (k A : Type u) [Field k] [Ring A] [Algebra k A]

/-- A directed algebra with vertex idempotents and arrows. -/
structure DirData where
  ι : Type
  [fin : Fintype ι]
  [dec : DecidableEq ι]
  e : ι → A
  idem : ∀ x, IsIdempotentElem (e x)
  orth : ∀ x y, x ≠ y → e x * e y = 0
  sum : ∑ x, e x = 1
  T : Set ι
  zero : ∀ v, v ∉ T → e v = 0
  ne : ∀ x, x ∈ T → e x ≠ 0
  local_ : ∀ x (a : A), ∃ c : k, e x * a * e x = c • e x
  Arr : ι → ι → Prop
  arrT : ∀ x y, Arr x y → x ∈ T ∧ y ∈ T
  hom : ∀ x y (a : A), e y * a * e x ≠ 0 → Relation.ReflTransGen Arr x y
  acyc : ∀ x y, Relation.TransGen Arr x y → ¬Relation.ReflTransGen Arr y x
  gen : ∀ x (a : A), (1 - e x) * a * e x ∈
    Submodule.span A {r | ∃ y b, Arr x y ∧ r = e y * b * e x}
  arrNe : ∀ x y, Arr x y → ∃ a : A, e y * a * e x ≠ 0

attribute [instance] DirData.fin DirData.dec

namespace DirData

variable {k A} (D : DirData k A)

lemma ne_of_arr {x y : D.ι} (h : D.Arr x y) : x ≠ y := by
  rintro rfl
  exact D.acyc x x (Relation.TransGen.single h) Relation.ReflTransGen.refl

lemma transGen_of_ne {x y : D.ι} (h : Relation.ReflTransGen D.Arr x y) (hne : x ≠ y) :
    Relation.TransGen D.Arr x y := by
  rcases Relation.reflTransGen_iff_eq_or_transGen.1 h with h | h
  · exact absurd h.symm hne
  · exact h

/-- Products through another point vanish at a point. -/
lemma corner_cross {x y : D.ι} (hxy : x ≠ y) (a b : A) :
    (D.e x * a * D.e y) * (D.e y * b * D.e x) = 0 := by
  by_contra h
  have h1 : D.e x * a * D.e y ≠ 0 := fun h0 ↦ h (by rw [h0, zero_mul])
  have h2 : D.e y * b * D.e x ≠ 0 := fun h0 ↦ h (by rw [h0, mul_zero])
  have p1 := D.hom y x a h1
  have p2 := D.hom x y b h2
  exact D.acyc y x (D.transGen_of_ne p1 (Ne.symm hxy)) p2

lemma e_mul_e (x : D.ι) : D.e x * D.e x = D.e x := (D.idem x).eq

lemma corner_mul (x : D.ι) (a b : A) :
    D.e x * (a * b) * D.e x = (D.e x * a * D.e x) * (D.e x * b * D.e x) := by
  have h1 : a * b = a * (∑ y, D.e y) * b := by rw [D.sum, mul_one]
  rw [h1, Finset.mul_sum, Finset.sum_mul, Finset.mul_sum, Finset.sum_mul,
    Finset.sum_eq_single x]
  · have : (D.e x * a * D.e x) * (D.e x * b * D.e x) =
        D.e x * a * (D.e x * D.e x) * b * D.e x := by simp only [mul_assoc]
    rw [this, D.e_mul_e]
    simp only [mul_assoc]
  · intro y _ hy
    have := D.corner_cross (Ne.symm hy) a b
    have h2 : (D.e x * a * D.e y) * (D.e y * b * D.e x) =
        D.e x * a * (D.e y * D.e y) * b * D.e x := by simp only [mul_assoc]
    rw [D.e_mul_e] at h2
    rw [← this, h2]
    simp only [mul_assoc]
  · simp

/-- The coefficient `χ_x(a)` with `e_x a e_x = χ_x(a) e_x`. -/
def chiF (x : D.ι) (a : A) : k := Classical.choose (D.local_ x a)

lemma chiF_spec (x : D.ι) (a : A) : D.e x * a * D.e x = D.chiF x a • D.e x :=
  Classical.choose_spec (D.local_ x a)

lemma smul_e_inj {x : D.ι} (hx : x ∈ D.T) {c c' : k} (h : c • D.e x = c' • D.e x) : c = c' := by
  by_contra hne
  apply D.ne x hx
  have : (c - c') • D.e x = 0 := by rw [sub_smul, h, sub_self]
  rcases smul_eq_zero.1 this with h0 | h0
  · exact absurd (sub_eq_zero.1 h0) hne
  · exact h0

/-- **The character of a live point.** -/
def chi (x : D.ι) (hx : x ∈ D.T) : A →ₐ[k] k where
  toFun := D.chiF x
  map_one' := by
    apply D.smul_e_inj hx
    rw [← D.chiF_spec, mul_one, D.e_mul_e, one_smul]
  map_mul' a b := by
    apply D.smul_e_inj hx
    rw [← D.chiF_spec, D.corner_mul, D.chiF_spec, D.chiF_spec, smul_mul_smul, D.e_mul_e]
  map_zero' := by
    apply D.smul_e_inj hx
    rw [← D.chiF_spec, mul_zero, zero_mul, zero_smul]
  map_add' a b := by
    apply D.smul_e_inj hx
    rw [← D.chiF_spec, add_smul, ← D.chiF_spec, ← D.chiF_spec, mul_add, add_mul]
  commutes' c := by
    apply D.smul_e_inj hx
    rw [← D.chiF_spec, Algebra.algebraMap_eq_smul_one, mul_smul_comm, mul_one, smul_mul_assoc,
      D.e_mul_e]
    rfl

lemma chi_spec (x : D.ι) (hx : x ∈ D.T) (a : A) : D.e x * a * D.e x = D.chi x hx a • D.e x :=
  D.chiF_spec x a

lemma chi_e_self (x : D.ι) (hx : x ∈ D.T) : D.chi x hx (D.e x) = 1 := by
  apply D.smul_e_inj hx
  rw [← D.chi_spec, D.e_mul_e, D.e_mul_e, one_smul]

lemma chi_e_ne (x : D.ι) (hx : x ∈ D.T) {y : D.ι} (hy : y ≠ x) : D.chi x hx (D.e y) = 0 := by
  apply D.smul_e_inj hx
  rw [← D.chi_spec, D.orth x y (Ne.symm hy), zero_mul, zero_smul]

/-- A convex set of live points. -/
def ConvexSet (T' : Set D.ι) : Prop :=
  T' ⊆ D.T ∧ ∀ x y z, x ∈ T' → z ∈ T' → Relation.ReflTransGen D.Arr x y →
    Relation.ReflTransGen D.Arr y z → y ∈ T'

/-- The relations killing the idempotents outside `T'`. -/
def qRel (T' : Set D.ι) (a b : A) : Prop := (∃ v, v ∉ T' ∧ a = D.e v) ∧ b = 0

variable (T' : Set D.ι)

/-- The quotient algebra `A / ⟨e_v : v ∉ T'⟩`. -/
abbrev QAlg : Type u := RingQuot (D.qRel T')

/-- The quotient map. -/
abbrev qmap : A →ₐ[k] D.QAlg T' := RingQuot.mkAlgHom k (D.qRel T')

lemma qmap_surjective : Function.Surjective (D.qmap T') := RingQuot.mkAlgHom_surjective k _

lemma qmap_e_out {v : D.ι} (hv : v ∉ T') : D.qmap T' (D.e v) = 0 := by
  rw [← map_zero (D.qmap T')]
  exact RingQuot.mkAlgHom_rel k ⟨⟨v, hv, rfl⟩, rfl⟩

instance [FiniteDimensional k A] : FiniteDimensional k (D.QAlg T') :=
  Module.Finite.of_surjective (D.qmap T').toLinearMap (D.qmap_surjective T')

variable {T'}

/-- The character of a point of `T'` on the quotient. -/
def qchi (hT : D.ConvexSet T') (x : D.ι) (hx : x ∈ T') : D.QAlg T' →ₐ[k] k :=
  RingQuot.liftAlgHom k ⟨D.chi x (hT.1 hx), by
    rintro a b ⟨⟨v, hv, rfl⟩, rfl⟩
    rw [map_zero]
    exact D.chi_e_ne x (hT.1 hx) (fun h ↦ hv (h ▸ hx))⟩

lemma qchi_qmap (hT : D.ConvexSet T') (x : D.ι) (hx : x ∈ T') (a : A) :
    D.qchi hT x hx (D.qmap T' a) = D.chi x (hT.1 hx) a := by
  simp [qchi]

lemma restrict_path (hT : D.ConvexSet T') {x y : D.ι} (hx : x ∈ T') (hy : y ∈ T')
    (h : Relation.ReflTransGen D.Arr x y) :
    Relation.ReflTransGen (fun a b ↦ D.Arr a b ∧ a ∈ T' ∧ b ∈ T') x y := by
  revert hx
  induction h using Relation.ReflTransGen.head_induction_on with
  | refl => intro _; exact Relation.ReflTransGen.refl
  | head hab hbc ih =>
    rename_i a b
    intro ha
    have hb : b ∈ T' := hT.2 _ _ _ ha hy (Relation.ReflTransGen.single hab) hbc
    exact Relation.ReflTransGen.head ⟨hab, ha, hb⟩ (ih hb)

lemma tg_mono {α : Type*} {r s : α → α → Prop} (h : ∀ a b, r a b → s a b) {x y : α}
    (hxy : Relation.TransGen r x y) : Relation.TransGen s x y := by
  induction hxy with
  | single h1 => exact Relation.TransGen.single (h _ _ h1)
  | tail _ h2 ih => exact Relation.TransGen.tail ih (h _ _ h2)

lemma rtg_mono {α : Type*} {r s : α → α → Prop} (h : ∀ a b, r a b → s a b) {x y : α}
    (hxy : Relation.ReflTransGen r x y) : Relation.ReflTransGen s x y := by
  induction hxy with
  | refl => exact Relation.ReflTransGen.refl
  | tail _ h2 ih => exact Relation.ReflTransGen.tail ih (h _ _ h2)

/-- The image of the arrow span lies in the arrow span of the quotient. -/
lemma qmap_span_le (x : D.ι) {m : A}
    (hm : m ∈ Submodule.span A {r | ∃ y b, D.Arr x y ∧ r = D.e y * b * D.e x}) :
    D.qmap T' m ∈ Submodule.span (D.QAlg T') {r | ∃ y b, (D.Arr x y ∧ x ∈ T' ∧ y ∈ T') ∧
      r = D.qmap T' (D.e y) * b * D.qmap T' (D.e x)} := by
  classical
  induction hm using Submodule.span_induction with
  | mem r hr =>
    obtain ⟨y, b, hxy, rfl⟩ := hr
    by_cases hx : x ∈ T'
    · by_cases hy : y ∈ T'
      · exact Submodule.subset_span ⟨y, D.qmap T' b, ⟨hxy, hx, hy⟩, by simp⟩
      · rw [map_mul, map_mul, D.qmap_e_out T' hy, zero_mul, zero_mul]
        exact Submodule.zero_mem _
    · rw [map_mul, D.qmap_e_out T' hx, mul_zero]
      exact Submodule.zero_mem _
  | zero => rw [map_zero]; exact Submodule.zero_mem _
  | add a b _ _ ha hb => rw [map_add]; exact Submodule.add_mem _ ha hb
  | smul a b _ hb =>
    rw [smul_eq_mul, map_mul]
    exact Submodule.smul_mem _ (D.qmap T' a) hb

/-- The left ideal generated by the idempotents outside `T'`. -/
def outIdeal (T'' : Set D.ι) : Submodule A A :=
  Submodule.span A {r | ∃ v c, v ∉ T'' ∧ r = D.e v * c}

lemma corner_outIdeal (hT : D.ConvexSet T') {x : D.ι} (hx : x ∈ T') {n : A}
    (hn : n ∈ D.outIdeal T') : ∀ y, y ∈ T' → D.e y * n * D.e x = 0 := by
  induction hn using Submodule.span_induction with
  | mem r hr =>
    intro y hy
    obtain ⟨v, c, hv, rfl⟩ := hr
    have h1 : D.e y * (D.e v * c) * D.e x = (D.e y * 1 * D.e v) * (D.e v * c * D.e x) := by
      have : (D.e y * 1 * D.e v) * (D.e v * c * D.e x) = D.e y * (D.e v * D.e v) * c * D.e x := by
        simp only [mul_one, mul_assoc]
      rw [this, D.e_mul_e]; simp only [mul_assoc]
    rw [h1]
    by_contra h
    have h2 : D.e y * 1 * D.e v ≠ 0 := fun h0 ↦ h (by rw [h0, zero_mul])
    have h3 : D.e v * c * D.e x ≠ 0 := fun h0 ↦ h (by rw [h0, mul_zero])
    exact hv (hT.2 x v y hx hy (D.hom x v c h3) (D.hom v y 1 h2))
  | zero => intro y _; simp
  | add a b _ _ ha hb => intro y hy; rw [mul_add, add_mul, ha y hy, hb y hy, add_zero]
  | smul a b hb' hb =>
    intro y hy
    have h1 : D.e y * (a • b) * D.e x = ∑ z, (D.e y * a * D.e z) * (D.e z * b * D.e x) := by
      rw [smul_eq_mul]
      have : a * b = a * (∑ z, D.e z) * b := by rw [D.sum, mul_one]
      rw [this, Finset.mul_sum, Finset.sum_mul, Finset.mul_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl fun z _ ↦ ?_
      have : (D.e y * a * D.e z) * (D.e z * b * D.e x) = D.e y * a * (D.e z * D.e z) * b * D.e x := by
        simp only [mul_assoc]
      rw [this, D.e_mul_e]; simp only [mul_assoc]
    rw [h1]
    refine Finset.sum_eq_zero fun z _ ↦ ?_
    by_cases hz : z ∈ T'
    · rw [hb z hz, mul_zero]
    · by_contra h
      have h2 : D.e y * a * D.e z ≠ 0 := fun h0 ↦ h (by rw [h0, zero_mul])
      have h3 : D.e z * b * D.e x ≠ 0 := fun h0 ↦ h (by rw [h0, mul_zero])
      exact hz (hT.2 x z y hx hy (D.hom x z b h3) (D.hom z y a h2))

/-- **Corners between points of `T'` survive in the quotient.** -/
lemma qmap_corner_ne (hT : D.ConvexSet T') {x y : D.ι} (hx : x ∈ T') (hy : y ∈ T') {a : A}
    (ha : D.e y * a * D.e x ≠ 0) : D.qmap T' (D.e y * a * D.e x) ≠ 0 := by
  let N := D.outIdeal T'
  let ρ : A →ₐ[k] Module.End k (A ⧸ N) := Algebra.lsmul k k (A ⧸ N)
  have hρ : ∀ v, v ∉ T' → ρ (D.e v) = 0 := fun v hv ↦ by
    apply LinearMap.ext; intro m
    obtain ⟨m, rfl⟩ := Submodule.mkQ_surjective N m
    change D.e v • N.mkQ m = 0
    rw [← map_smul, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
    exact Submodule.subset_span ⟨v, m, hv, rfl⟩
  let ρ' : D.QAlg T' →ₐ[k] Module.End k (A ⧸ N) := RingQuot.liftAlgHom k ⟨ρ, by
    rintro _ _ ⟨⟨v, hv, rfl⟩, rfl⟩
    rw [hρ v hv, map_zero]⟩
  intro h0
  have h1 : ρ' (D.qmap T' (D.e y * a * D.e x)) = ρ (D.e y * a * D.e x) := by
    simp [ρ']
  rw [h0, map_zero] at h1
  have h2 := LinearMap.congr_fun h1 (N.mkQ (D.e x))
  change (0 : A ⧸ N) = (D.e y * a * D.e x) • N.mkQ (D.e x) at h2
  rw [← map_smul, smul_eq_mul, Submodule.mkQ_apply, eq_comm,
    Submodule.Quotient.mk_eq_zero] at h2
  have h3 := D.corner_outIdeal hT hx h2 y hy
  apply ha
  rw [← h3]
  calc D.e y * a * D.e x = (D.e y * D.e y) * a * (D.e x * D.e x * D.e x) := by
        rw [D.e_mul_e, D.e_mul_e, D.e_mul_e]
    _ = _ := by simp only [mul_assoc]

/-- **The quotient by the idempotents outside a convex set is again directed.** -/
def quot (hT : D.ConvexSet T') : DirData k (D.QAlg T') where
  ι := D.ι
  e x := D.qmap T' (D.e x)
  idem x := (D.idem x).map (D.qmap T')
  orth x y h := by rw [← map_mul, D.orth x y h, map_zero]
  sum := by rw [← map_sum, D.sum, map_one]
  T := T'
  zero v hv := D.qmap_e_out T' hv
  ne x hx h := by
    have := congrArg (D.qchi hT x hx) h
    rw [D.qchi_qmap, D.chi_e_self, map_zero] at this
    exact one_ne_zero this
  local_ x a := by
    obtain ⟨a, rfl⟩ := D.qmap_surjective T' a
    obtain ⟨c, hc⟩ := D.local_ x a
    exact ⟨c, by rw [← map_mul, ← map_mul, hc, map_smul]⟩
  Arr x y := D.Arr x y ∧ x ∈ T' ∧ y ∈ T'
  arrT x y h := ⟨h.2.1, h.2.2⟩
  hom x y a h := by
    obtain ⟨a, rfl⟩ := D.qmap_surjective T' a
    have hx : x ∈ T' := by
      by_contra hx; apply h; rw [D.qmap_e_out T' hx, mul_zero]
    have hy : y ∈ T' := by
      by_contra hy; apply h; rw [D.qmap_e_out T' hy, zero_mul, zero_mul]
    have h' : D.e y * a * D.e x ≠ 0 := fun h0 ↦ h (by rw [← map_mul, ← map_mul, h0, map_zero])
    exact D.restrict_path hT hx hy (D.hom x y a h')
  acyc x y h h' := D.acyc x y (tg_mono (fun _ _ h ↦ h.1) h) (rtg_mono (fun _ _ h ↦ h.1) h')
  gen x a := by
    obtain ⟨a, rfl⟩ := D.qmap_surjective T' a
    have := D.qmap_span_le (T' := T') x (D.gen x a)
    simpa [map_mul, map_sub] using this
  arrNe x y h := by
    obtain ⟨a, ha⟩ := D.arrNe x y h.1
    exact ⟨D.qmap T' a, by
      rw [← map_mul, ← map_mul]
      exact D.qmap_corner_ne hT h.2.1 h.2.2 ha⟩

lemma quot_e (hT : D.ConvexSet T') (x : (D.quot hT).ι) : (D.quot hT).e x = D.qmap T' (D.e x) := rfl

end DirData

end LargeIndecomposable.AR
