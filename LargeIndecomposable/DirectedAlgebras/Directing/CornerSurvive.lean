module

public import LargeIndecomposable.DirectedAlgebras.Directing.QuotAny

/-!
# Corners that survive a quotient

Let `x, y ∈ T'` and suppose every point on a path from `x` to `y` lies in `T'`. Then
`e_y a e_x` lies in the ideal generated by the idempotents outside `T'` only if it is zero
(`corner_outIdeal'`), so a nonzero corner `e_y a e_x` stays nonzero in `A / ⟨e_v : v ∉ T'⟩`
(`qmap_corner_ne'`). This is `qmap_corner_ne` with convexity required only between `x` and `y`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable.AR

universe u

variable {k A : Type u} [Field k] [Ring A] [Algebra k A]

namespace DirData

variable (D : DirData k A) {T' : Set D.ι}

lemma corner_outIdeal' {x y : D.ι} (hx : x ∈ T')
    (hmid : ∀ v, Relation.ReflTransGen D.Arr x v → Relation.ReflTransGen D.Arr v y → v ∈ T')
    {n : A} (hn : n ∈ D.outIdeal T') :
    ∀ y', y' ∈ T' → Relation.ReflTransGen D.Arr y' y → D.e y' * n * D.e x = 0 := by
  induction hn using Submodule.span_induction with
  | mem r hr =>
    intro y' hy' hy'y
    obtain ⟨v, c, hv, rfl⟩ := hr
    have h1 : D.e y' * (D.e v * c) * D.e x = (D.e y' * 1 * D.e v) * (D.e v * c * D.e x) := by
      have : (D.e y' * 1 * D.e v) * (D.e v * c * D.e x) =
          D.e y' * (D.e v * D.e v) * c * D.e x := by
        simp only [mul_one, mul_assoc]
      rw [this, D.e_mul_e]; simp only [mul_assoc]
    rw [h1]
    by_contra h
    have h2 : D.e y' * 1 * D.e v ≠ 0 := fun h0 ↦ h (by rw [h0, zero_mul])
    have h3 : D.e v * c * D.e x ≠ 0 := fun h0 ↦ h (by rw [h0, mul_zero])
    exact hv (hmid v (D.hom x v c h3) ((D.hom v y' 1 h2).trans hy'y))
  | zero => intro y' _ _; simp
  | add a b _ _ ha hb =>
    intro y' hy' hy'y; rw [mul_add, add_mul, ha y' hy' hy'y, hb y' hy' hy'y, add_zero]
  | smul a b hb' hb =>
    intro y' hy' hy'y
    have h1 : D.e y' * (a • b) * D.e x = ∑ z, (D.e y' * a * D.e z) * (D.e z * b * D.e x) := by
      rw [smul_eq_mul]
      have : a * b = a * (∑ z, D.e z) * b := by rw [D.sum, mul_one]
      rw [this, Finset.mul_sum, Finset.sum_mul, Finset.mul_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl fun z _ ↦ ?_
      have : (D.e y' * a * D.e z) * (D.e z * b * D.e x) =
          D.e y' * a * (D.e z * D.e z) * b * D.e x := by
        simp only [mul_assoc]
      rw [this, D.e_mul_e]; simp only [mul_assoc]
    rw [h1]
    refine Finset.sum_eq_zero fun z _ ↦ ?_
    by_cases hza : D.e y' * a * D.e z = 0
    · rw [hza, zero_mul]
    have hzy : Relation.ReflTransGen D.Arr z y := (D.hom z y' a hza).trans hy'y
    by_cases hz : z ∈ T'
    · rw [hb z hz hzy, mul_zero]
    · by_contra h
      have h3 : D.e z * b * D.e x ≠ 0 := fun h0 ↦ h (by rw [h0, mul_zero])
      exact hz (hmid z (D.hom x z b h3) hzy)

/-- **A corner whose interval lies in `T'` survives in the quotient.** -/
lemma qmap_corner_ne' {x y : D.ι} (hx : x ∈ T') (hy : y ∈ T')
    (hmid : ∀ v, Relation.ReflTransGen D.Arr x v → Relation.ReflTransGen D.Arr v y → v ∈ T')
    {a : A} (ha : D.e y * a * D.e x ≠ 0) : D.qmap T' (D.e y * a * D.e x) ≠ 0 := by
  let N := D.outIdeal T'
  let ρ : A →ₐ[k] Module.End k (A ⧸ N) := Algebra.lsmul k k (A ⧸ N)
  have hρ : ∀ v, v ∉ T' → ρ (D.e v) = 0 := fun v hv ↦ by
    apply LinearMap.ext; intro m
    obtain ⟨m, rfl⟩ := Submodule.mkQ_surjective N m
    change D.e v • N.mkQ m = 0
    rw [← map_smul, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
    exact Submodule.subset_span ⟨v, m, hv, rfl⟩
  let ρ' : D.QAlg T' →ₐ[k] Module.End k (A ⧸ N) := RingQuot.liftAlgHom k ⟨ρ, by
    rintro _ _ ⟨⟨v, hv, rfl⟩, rfl⟩
    rw [hρ v hv, map_zero]⟩
  intro h0
  have h1 : ρ' (D.qmap T' (D.e y * a * D.e x)) = ρ (D.e y * a * D.e x) := by
    simp [ρ']
  rw [h0, map_zero] at h1
  have h2 := LinearMap.congr_fun h1 (N.mkQ (D.e x))
  change (0 : A ⧸ N) = (D.e y * a * D.e x) • N.mkQ (D.e x) at h2
  rw [← map_smul, smul_eq_mul, Submodule.mkQ_apply, eq_comm,
    Submodule.Quotient.mk_eq_zero] at h2
  have h3 := D.corner_outIdeal' hx hmid h2 y hy Relation.ReflTransGen.refl
  apply ha
  rw [← h3]
  calc D.e y * a * D.e x = (D.e y * D.e y) * a * (D.e x * D.e x * D.e x) := by
        rw [D.e_mul_e, D.e_mul_e, D.e_mul_e]
    _ = _ := by simp only [mul_assoc]

end DirData

end LargeIndecomposable.AR
