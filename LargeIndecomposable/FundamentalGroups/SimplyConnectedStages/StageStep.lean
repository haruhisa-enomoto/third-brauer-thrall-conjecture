module

public import LargeIndecomposable.RayCategories.Basic.ArrSetIdeal
public import LargeIndecomposable.FundamentalGroups.Basic.CocycleExtend

/-!
# Adding arrows to a simply connected ray category

Let `B = A/⟨S⟩` be the quotient of a ray category by the ideal generated by a set `S` of arrows.
If every cocycle on `B` is a coboundary and every arrow `e` of `S` satisfies a nonzero relation
`e uₑ = u` with paths `uₑ, u` avoiding `S`, then every cocycle on `A` is a coboundary
(`isCoboundary_of_step`): a cocycle on `A` restricts to one on `B`, whose potential also fits the
arrows of `S` by the relations. This is the simple-connectivity step of the stages in
Fischbacher's Satz 5.1.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable.RayCat

open CategoryTheory Limits LargeIndecomposable

universe v u

variable {A : Type u} [Category.{v} A] [HasZeroMorphisms A] [IsRayCategory A]
  (S : ∀ {x y : RayVert A}, (x ⟶ y) → Prop)

/-- The restriction of a weight to the quotient. -/
def resW (c : ArrowWeight A) : ArrowWeight (CategoryTheory.Quotient (arrSetIdeal S).rel) :=
  fun e ↦ c (liftArrQ (arrSetIdeal_isProper S) e)

lemma pathWeight_resW (c : ArrowWeight A) {x : RayVert (CategoryTheory.Quotient (arrSetIdeal S).rel)} :
    ∀ {y : RayVert (CategoryTheory.Quotient (arrSetIdeal S).rel)} (p : Quiver.Path x y),
      pathWeight (resW S c) p = pathWeight c ((inclQ (arrSetIdeal_isProper S)).mapPath p)
  | _, .nil => rfl
  | _, .cons p e => by
    change pathWeight (resW S c) p + resW S c e = pathWeight c ((inclQ _).mapPath p) + c _
    rw [pathWeight_resW c p]
    rfl

lemma liftArrQ_qArrI {x y : RayVert A} (e : x ⟶ y) (he : ¬(arrSetIdeal S).mem e.1) :
    (liftArrQ (arrSetIdeal_isProper S) (qArrI (arrSetIdeal_isProper S) e he)).1 = e.1 := by
  have h : (qF (I := arrSetIdeal S)).map (liftArrQ (arrSetIdeal_isProper S)
      (qArrI (arrSetIdeal_isProper S) e he)).1 = (qF (I := arrSetIdeal S)).map e.1 :=
    Quot.out_eq _
  rcases (CategoryTheory.Quotient.functor_map_eq_iff _ _ _).1 h with h | h
  · exact h
  · exact absurd h.2 he

/-- The restriction of a cocycle is a cocycle. -/
lemma isCocycle_resW {c : ArrowWeight A} (hc : IsCocycle c) : IsCocycle (resW S c) := by
  intro x y p q hpq h0
  rw [pathWeight_resW, pathWeight_resW]
  have hp := pathVal_inclQ (arrSetIdeal_isProper S) p
  have hq := pathVal_inclQ (arrSetIdeal_isProper S) q
  have hm : ¬(arrSetIdeal S).mem (pathVal ((inclQ (arrSetIdeal_isProper S)).mapPath p)) := by
    rw [← (arrSetIdeal S).functor_map_ne_zero_iff, hp]; exact h0
  refine hc _ _ ?_ fun h ↦ hm (h ▸ (arrSetIdeal S).zero_mem _ _)
  have h1 : (qF (I := arrSetIdeal S)).map (pathVal ((inclQ (arrSetIdeal_isProper S)).mapPath p)) =
      (qF (I := arrSetIdeal S)).map (pathVal ((inclQ (arrSetIdeal_isProper S)).mapPath q)) := by
    rw [hp, hq, hpq]
  rcases (CategoryTheory.Quotient.functor_map_eq_iff _ _ _).1 h1 with h | h
  · exact h
  · exact absurd h.1 hm

lemma pathWeight_of_pot {B : Type*} [Category B] [HasZeroMorphisms B] {c : ArrowWeight B}
    {φ : RayVert B → ℤ} (hφ : ∀ {x y : RayVert B} (e : x ⟶ y), c e = φ y - φ x) {x : RayVert B} :
    ∀ {y : RayVert B} (p : Quiver.Path x y), pathWeight c p = φ y - φ x
  | _, .nil => by simp [pathWeight]
  | _, .cons p e => by
    change pathWeight c p + c e = _
    rw [pathWeight_of_pot hφ p, hφ e]; ring

lemma pathWeight_toQI (c : ArrowWeight A) {x : RayVert A} :
    ∀ {y : RayVert A} (p : Quiver.Path x y) (h : AvoidsI (arrSetIdeal S) p),
      pathWeight (resW S c) (toQI (arrSetIdeal_isProper S) p h) = pathWeight c p
  | _, .nil, _ => rfl
  | _, .cons p e, h => by
    change pathWeight (resW S c) (toQI _ p h.1) + resW S c (qArrI _ e h.2) = pathWeight c p + c e
    rw [pathWeight_toQI c p h.1]
    congr 1
    change c _ = c e
    congr 1
    exact Subtype.ext (liftArrQ_qArrI S e h.2)

lemma resW_qArrI (c : ArrowWeight A) {x y : RayVert A} (e : x ⟶ y)
    (he : ¬(arrSetIdeal S).mem e.1) :
    resW S c (qArrI (arrSetIdeal_isProper S) e he) = c e := by
  change c _ = c e
  congr 1
  exact Subtype.ext (liftArrQ_qArrI S e he)

/-- **Adding arrows with nonzero relations keeps simple connectivity.** -/
theorem isCoboundary_of_step
    (hold : ∀ c' : ArrowWeight (CategoryTheory.Quotient (arrSetIdeal S).rel), IsCocycle c' →
      IsCoboundary c')
    (hrel : ∀ {x y : RayVert A} (e : x ⟶ y), S e → ∃ (z : RayVert A) (ue : Quiver.Path y z)
      (u : Quiver.Path x z) (_ : AvoidsI (arrSetIdeal S) ue) (_ : AvoidsI (arrSetIdeal S) u),
        e.1 ≫ pathVal ue = pathVal u ∧ pathVal u ≠ 0)
    (c : ArrowWeight A) (hc : IsCocycle c) : IsCoboundary c := by
  obtain ⟨φ', hφ'⟩ := hold _ (isCocycle_resW S hc)
  refine ⟨fun x ↦ φ' (qVt (I := arrSetIdeal S) x), fun {x y} e ↦ ?_⟩
  by_cases hS : (arrSetIdeal S).mem e.1
  · obtain ⟨z, ue, u, h₁, h₂, hv, hne⟩ := hrel e (mem_of_irreducible S e hS)
    have h := hc (e.toPath.comp ue) u (by rw [pathVal_comp, pathVal_toPath]; exact hv)
      (by rw [pathVal_comp, pathVal_toPath, hv]; exact hne)
    rw [pathWeight_comp] at h
    have h1 := pathWeight_toQI S c ue h₁
    have h2 := pathWeight_toQI S c u h₂
    rw [pathWeight_of_pot hφ'] at h1 h2
    have h3 : pathWeight c e.toPath = c e := by
      change 0 + c e = c e
      rw [zero_add]
    rw [h3] at h
    change c e = φ' (qVt y) - φ' (qVt x)
    linarith
  · change c e = φ' (qVt y) - φ' (qVt x)
    rw [← resW_qArrI S c e hS]
    exact hφ' (qArrI (arrSetIdeal_isProper S) e hS)

end LargeIndecomposable.RayCat
