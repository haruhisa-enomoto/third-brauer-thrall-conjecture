module

public import LargeIndecomposable.RayCategories.Quotients.ResidueQuiver
public import LargeIndecomposable.RayCategories.Basic.Long
public import LargeIndecomposable.RayCategories.Contours.Interlaced
public import LargeIndecomposable.Coverings.UniversalCover.Cover
public import LargeIndecomposable.Foundations.Group.FreeGroupoidFree
public import Mathlib.CategoryTheory.IsConnected
/-!
# Fischbacher's reduction: killing arrows without changing the fundamental group

For arrows `αᵢ : b → dᵢ` of a finite ray category `P`, the quotient
`P' = P/⟨αᵢ⟩` annihilates every morphism factoring through some `αᵢ`
(`RayCat.arrowIdeal`). Fischbacher (*Zur Kombinatorik der Algebren mit endlich
vielen Idealen*, Crelle 370, 1986, Lemmas 2.1 and 2.2) chooses the `αᵢ` so that
`P` and `P'` have the same fundamental group; iterating this proves that the
fundamental group of a chain-finite ray category is free.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits

universe v u

namespace RayCat

variable {P : Type u} [Category.{v} P] [HasZeroMorphisms P]

variable {ι : Type*} {b : P} {d : ι → P}

/-- Morphisms factoring through one of the arrows `αᵢ`. -/
def FactorsThroughArrows (α : ∀ i, b ⟶ d i) {X Y : P} (f : X ⟶ Y) : Prop :=
  ∃ (i : ι) (a : X ⟶ b) (c : d i ⟶ Y), f = a ≫ α i ≫ c

/-- The zero ideal generated by the arrows `αᵢ`. -/
def arrowIdeal (α : ∀ i, b ⟶ d i) : LargeIndecomposable.ZeroHomIdeal P where
  mem f := f = 0 ∨ FactorsThroughArrows α f
  zero_mem _ _ := Or.inl rfl
  comp_mem_left f g hg := by
    rcases hg with rfl | ⟨i, a, c, rfl⟩
    · exact Or.inl comp_zero
    · exact Or.inr ⟨i, f ≫ a, c, by simp [Category.assoc]⟩
  comp_mem_right g hf := by
    rcases hf with rfl | ⟨i, a, c, rfl⟩
    · exact Or.inl zero_comp
    · exact Or.inr ⟨i, a, c ≫ g, by simp [Category.assoc]⟩

/-- The quotient `P/⟨αᵢ⟩`. -/
abbrev ArrowQuot (α : ∀ i, b ⟶ d i) := CategoryTheory.Quotient (arrowIdeal α).rel

/-- The quotient functor `P ⥤ P/⟨αᵢ⟩`. -/
abbrev arrowQuotF (α : ∀ i, b ⟶ d i) : P ⥤ ArrowQuot α := CategoryTheory.Quotient.functor (arrowIdeal α).rel

variable [LargeIndecomposable.IsFiniteRayCategory0 P]

lemma arrowIdeal_isProper (α : ∀ i, b ⟶ d i) (hα : ∀ i, ¬IsIso (α i)) : (arrowIdeal α).IsProper := by
  intro X hX
  rcases hX with h | ⟨i, a, c, hac⟩
  · exact LargeIndecomposable.IsFiniteRayCategory0.id_ne_zero X h
  · have : IsIso (a ≫ α i ≫ c) := by rw [← hac]; infer_instance
    have h1 : IsIso (α i ≫ c) := (LargeIndecomposable.ray_isIso_factors a (α i ≫ c)).2
    exact hα i (LargeIndecomposable.ray_isIso_factors (α i) c).1

variable (α : ∀ i, b ⟶ d i) (hα : ∀ i, ¬IsIso (α i))

/-- A lift of a morphism of `P/⟨αᵢ⟩`. -/
def liftQ {x y : P} (g : (arrowQuotF α).obj x ⟶ (arrowQuotF α).obj y) : x ⟶ y := Quot.out g

omit [LargeIndecomposable.IsFiniteRayCategory0 P] in
lemma quotF_liftQ {x y : P} (g : (arrowQuotF α).obj x ⟶ (arrowQuotF α).obj y) :
    (arrowQuotF α).map (liftQ α g) = g :=
  Quot.out_eq g

omit [LargeIndecomposable.IsFiniteRayCategory0 P] in
/-- Equal images of a morphism outside the ideal are equal. -/
lemma quotF_map_injective {x y : P} {f g : x ⟶ y} (hf : ¬(arrowIdeal α).mem f)
    (h : (arrowQuotF α).map f = (arrowQuotF α).map g) : f = g := by
  rcases (CategoryTheory.Quotient.functor_map_eq_iff _ f g).1 h with h | h
  · exact h
  · exact absurd h.1 hf

include hα in
lemma liftQ_irreducible {x y : P} {g : (arrowQuotF α).obj x ⟶ (arrowQuotF α).obj y}
    (hg : IsIrreducible g) : IsIrreducible (liftQ α g) := by
  rw [← quotF_liftQ α g] at hg
  exact (isIrreducible_iff_isIrreducibleRayMorphism _).2
    (((arrowIdeal α).functor_map_isIrreducible_iff (arrowIdeal_isProper α hα) _).1
      ((isIrreducible_iff_isIrreducibleRayMorphism _).1 hg)).1

include hα in
lemma liftQ_not_mem {x y : P} {g : (arrowQuotF α).obj x ⟶ (arrowQuotF α).obj y}
    (hg : IsIrreducible g) : ¬(arrowIdeal α).mem (liftQ α g) := by
  rw [← quotF_liftQ α g] at hg
  exact (((arrowIdeal α).functor_map_isIrreducible_iff (arrowIdeal_isProper α hα) _).1
      ((isIrreducible_iff_isIrreducibleRayMorphism _).1 hg)).2

/-- The inclusion of quivers `Q_{P/⟨αᵢ⟩} → Q_P`. -/
def inclQuiver : RayVert (ArrowQuot α) ⥤q RayVert P where
  obj x := RayVert.mk x.out.as
  map e := ⟨liftQ α e.1, liftQ_irreducible α hα e.2⟩

lemma pathVal_inclQuiver {x : RayVert (ArrowQuot α)} : ∀ {y : RayVert (ArrowQuot α)}
    (r : Quiver.Path x y),
    (arrowQuotF α).map (pathVal ((inclQuiver α hα).mapPath r)) = pathVal r
  | _, .nil => (arrowQuotF α).map_id _
  | _, .cons r e => by
    rw [Prefunctor.mapPath_cons]
    change (arrowQuotF α).map (pathVal ((inclQuiver α hα).mapPath r) ≫ liftQ α e.1) =
      pathVal r ≫ e.1
    rw [Functor.map_comp, pathVal_inclQuiver r]
    exact congrArg (fun t ↦ pathVal r ≫ t) (quotF_liftQ α e.1)

/-- The inclusion of free groupoids. -/
abbrev inclFG : Quiver.FreeGroupoid (RayVert (ArrowQuot α)) ⥤ Quiver.FreeGroupoid (RayVert P) :=
  Quiver.freeGroupoidFunctor (inclQuiver α hα)

/-- A homotopy of `P/⟨αᵢ⟩` is a homotopy of `P`. -/
lemma inclFG_homotopy {X Y : Quiver.FreeGroupoid (RayVert (ArrowQuot α))} {f g : X ⟶ Y}
    (h : homotopy f g) :
    (CategoryTheory.Quotient.functor (homotopy (P := P))).map ((inclFG α hα).map f) =
      (CategoryTheory.Quotient.functor homotopy).map ((inclFG α hα).map g) := by
  cases h with
  | path p q hpq h0 =>
    rw [freeGroupoidFunctor_pathFG, freeGroupoidFunctor_pathFG]
    refine CategoryTheory.Quotient.sound _ (homotopy.path _ _ ?_ ?_)
    · refine quotF_map_injective α (fun hm ↦ h0 ?_) ?_
      · rw [← pathVal_inclQuiver α hα p]
        exact (LargeIndecomposable.ZeroHomIdeal.functor_map_eq_zero_iff _ _).2 hm
      · rw [pathVal_inclQuiver, pathVal_inclQuiver, hpq]
    · intro h
      apply h0
      have := pathVal_inclQuiver α hα p
      rw [h, Functor.map_zero] at this
      exact this.symm

/-! ### Paths avoiding the killed arrows -/

/-- The vertex of `P/⟨αᵢ⟩` below a vertex of `P`. -/
abbrev qV (x : RayVert P) : RayVert (ArrowQuot α) := RayVert.mk ((arrowQuotF α).obj x.out)

/-- The image of an arrow outside the ideal. -/
def qArr {x y : RayVert P} (e : x ⟶ y) (he : ¬(arrowIdeal α).mem e.1) : qV α x ⟶ qV α y :=
  ⟨(arrowQuotF α).map e.1, (isIrreducible_iff_isIrreducibleRayMorphism _).2
    (((arrowIdeal α).functor_map_isIrreducible_iff (arrowIdeal_isProper α hα) _).2
      ⟨(isIrreducible_iff_isIrreducibleRayMorphism _).1 e.2, he⟩)⟩

/-- All arrows of a path lie outside the ideal. -/
def Avoids {x : RayVert P} : ∀ {y : RayVert P}, Quiver.Path x y → Prop
  | _, .nil => True
  | _, .cons p e => Avoids p ∧ ¬(arrowIdeal α).mem e.1

/-- The image in `P/⟨αᵢ⟩` of a path avoiding the ideal. -/
def toQ {x : RayVert P} : ∀ {y : RayVert P} (p : Quiver.Path x y), Avoids α p →
    Quiver.Path (qV α x) (qV α y)
  | _, .nil, _ => .nil
  | _, .cons p e, h => .cons (toQ p h.1) (qArr α hα e h.2)

lemma pathVal_toQ {x : RayVert P} : ∀ {y : RayVert P} (p : Quiver.Path x y) (h : Avoids α p),
    pathVal (toQ α hα p h) = (arrowQuotF α).map (pathVal p)
  | _, .nil, _ => ((arrowQuotF α).map_id _).symm
  | _, .cons p e, h => by
    change pathVal (toQ α hα p h.1) ≫ (arrowQuotF α).map e.1 = _
    rw [pathVal_toQ p h.1]
    exact ((arrowQuotF α).map_comp _ _).symm

omit [LargeIndecomposable.IsFiniteRayCategory0 P] in
/-- A path whose value lies outside the ideal avoids it. -/
lemma avoids_of_not_mem {x : RayVert P} : ∀ {y : RayVert P} (p : Quiver.Path x y),
    ¬(arrowIdeal α).mem (pathVal p) → Avoids α p
  | _, .nil, _ => trivial
  | _, .cons p e, h => by
    refine ⟨avoids_of_not_mem p fun hp ↦ h ?_, fun he ↦ h ?_⟩
    · exact (arrowIdeal α).comp_mem_right e.1 hp
    · exact (arrowIdeal α).comp_mem_left (pathVal p) he

lemma avoids_comp {x y : RayVert P} (p : Quiver.Path x y) : ∀ {z : RayVert P}
    (q : Quiver.Path y z), Avoids α (p.comp q) ↔ Avoids α p ∧ Avoids α q
  | _, .nil => by simp [Avoids]
  | _, .cons q e => by
    rw [Quiver.Path.comp_cons]
    change (Avoids α (p.comp q) ∧ _) ↔ Avoids α p ∧ (Avoids α q ∧ _)
    rw [avoids_comp p q, and_assoc]

/-! ### Irreducible morphisms in the ideal -/

section Finite

variable [Finite P]

attribute [local instance] isRayCategory_of_finiteRayCategory

include hα in
/-- An irreducible morphism killed in `P/⟨αᵢ⟩` is one of the `αᵢ`. -/
lemma eq_alpha_of_mem {X Y : P} {f : X ⟶ Y} (hf : IsIrreducible f) (hm : (arrowIdeal α).mem f) :
    ∃ (i : ι) (hx : X = b) (hy : Y = d i), f = eqToHom hx ≫ α i ≫ eqToHom hy.symm := by
  rcases hm with h0 | ⟨i, a, c, rfl⟩
  · exact absurd h0 hf.1
  have hnot : ∀ {Z : P} (g : d i ⟶ Z) {W : P} (a' : W ⟶ b), ¬IsIso (a' ≫ α i ≫ g) := by
    intro Z g W a' h
    have h1 : IsIso (α i ≫ g) := (LargeIndecomposable.ray_isIso_factors a' (α i ≫ g)).2
    exact hα i (LargeIndecomposable.ray_isIso_factors (α i) g).1
  rcases hf.2.2 _ a (α i ≫ c) rfl with ha | ha
  · rcases hf.2.2 _ (a ≫ α i) c (by simp [Category.assoc]) with hc | hc
    · exact absurd (by simpa [Category.assoc] using hc) (hnot (𝟙 _) a)
    · obtain ⟨hx, rfl⟩ := eq_eqToHom_of_isIso a
      obtain ⟨hy, rfl⟩ := eq_eqToHom_of_isIso c
      exact ⟨i, hx, hy.symm, rfl⟩
  · exact absurd (by simpa using ha) (hnot c (𝟙 b))

/-- The measure drops at an interlacing step. -/
lemma below_lt_of_step {x a c y : RayVert P} (p : Quiver.Path x a) (v : Quiver.Path a c)
    (q : Quiver.Path c y) (h0 : pathVal ((p.comp v).comp q) ≠ 0)
    (hlen : 0 < p.length ∨ 0 < q.length) :
    (IsRayCategory.below (⟨a.out, c.out, pathVal v⟩ : RayMor P)).ncard <
      (IsRayCategory.below (⟨x.out, y.out, pathVal ((p.comp v).comp q)⟩ : RayMor P)).ncard := by
  refine IsRayCategory.ncard_below_lt h0 ⟨pathVal p, pathVal q, pathVal_comp3 p v q⟩ ?_
  rintro ⟨a'', c'', he''⟩
  let a' : a.out ⟶ x.out := a''
  let c' : y.out ⟶ c.out := c''
  have hval := pathVal_comp3 p v q
  have he : pathVal v = a' ≫ (pathVal p ≫ pathVal v ≫ pathVal q) ≫ c' := he''.trans (by rw [hval])
  rw [hval] at h0
  have e : pathVal p ≫ pathVal v ≫ pathVal q =
      (pathVal p ≫ a') ≫ (pathVal p ≫ pathVal v ≫ pathVal q) ≫ (c' ≫ pathVal q) := by
    conv_lhs => rw [he]
    simp [Category.assoc]
  obtain ⟨h1, h2⟩ := IsRayCategory.eq_id_of_two_sided _ h0 _ _ e
  rcases hlen with hl | hl
  · have : IsIso (pathVal p ≫ a') := by rw [h1]; infer_instance
    have hp : IsIso (pathVal p) := (LargeIndecomposable.ray_isIso_factors _ a').1
    obtain ⟨hxa, hpe⟩ := eq_eqToHom_of_isIso (pathVal p)
    change x = a at hxa
    subst hxa
    exact pathVal_ne_id_of_length p hl hpe
  · have : IsIso (c' ≫ pathVal q) := by rw [h2]; infer_instance
    have hq : IsIso (pathVal q) := (LargeIndecomposable.ray_isIso_factors c' _).2
    obtain ⟨hcy, hqe⟩ := eq_eqToHom_of_isIso (pathVal q)
    change c = y at hcy
    subst hcy
    exact pathVal_ne_id_of_length q hl hqe

/-- The class in `FG(P/⟨αᵢ⟩)` of a path avoiding the ideal. -/
abbrev clsQ {x y : RayVert P} (p : Quiver.Path x y) (h : Avoids α p) :
    (CategoryTheory.Quotient.functor (homotopy (P := ArrowQuot α))).obj
        ((Quiver.FreeGroupoid.of _).obj (qV α x)) ⟶
      (CategoryTheory.Quotient.functor homotopy).obj ((Quiver.FreeGroupoid.of _).obj (qV α y)) :=
  (CategoryTheory.Quotient.functor homotopy).map (pathFG (toQ α hα p h))

/-- The data of Fischbacher's Lemma 2.1, in the form used by Lemma 2.2. -/
structure RedData where
  /-- The arrows `aᵢ` with values `αᵢ`. -/
  a : ∀ i, RayVert.mk b ⟶ RayVert.mk (d i)
  a_val : ∀ i, (a i).1 = α i
  a_inj : ∀ i i' (h : d i = d i'), α i ≫ eqToHom h = α i' → i = i'
  /-- The common target of the contours. -/
  c : P
  u : Quiver.Path (RayVert.mk b) (RayVert.mk c)
  us : ∀ i, Quiver.Path (RayVert.mk (d i)) (RayVert.mk c)
  hu : Avoids α u
  hus : ∀ i, ¬(arrowIdeal α).mem (pathVal (us i))
  hcomp : ∀ i, α i ≫ pathVal (us i) = pathVal u
  hu0 : pathVal u ≠ 0

omit [Finite P] [LargeIndecomposable.IsFiniteRayCategory0 P] in
lemma lift_map_of {V G : Type*} [Quiver V] [Groupoid G] (φ : V ⥤q G) {x y : V} (e : x ⟶ y) :
    (Quiver.FreeGroupoid.lift φ).map ((Quiver.FreeGroupoid.of V).map e) = φ.map e := by
  have := Prefunctor.congr_hom (Quiver.FreeGroupoid.lift_spec φ) e
  exact (Quiver.homOfEq_rfl _).symm.trans this

/-- The object of `FG(P/⟨αᵢ⟩)` below an object of `P`. -/
abbrev objG (z : P) : FundGroupoid (ArrowQuot α) :=
  (CategoryTheory.Quotient.functor (homotopy (P := ArrowQuot α))).obj
    ((Quiver.FreeGroupoid.of _).obj (qV α (RayVert.mk z)))

namespace RedData

variable {α} {hα} (D : RedData α)

omit [Finite P] [LargeIndecomposable.IsFiniteRayCategory0 P] in
lemma avoids_us (i : ι) : Avoids α (D.us i) := avoids_of_not_mem α _ (D.hus i)

/-- The image of `αᵢ`: `[u] ≫ [uᵢ]⁻¹`. -/
def psiA (i : ι) : objG α b ⟶ objG α (d i) :=
  clsQ α hα D.u D.hu ≫ inv (clsQ α hα (D.us i) (D.avoids_us i))

open Classical in
/-- The prefunctor defining `Ψ`. -/
def psiPre : RayVert P ⥤q FundGroupoid (ArrowQuot α) where
  obj x := objG α x.out
  map {x y} e := if h : (arrowIdeal α).mem e.1 then
      eqToHom (congrArg (objG α) (eq_alpha_of_mem α hα e.2 h).choose_spec.choose) ≫
        D.psiA (hα := hα) (eq_alpha_of_mem α hα e.2 h).choose ≫
        eqToHom (congrArg (objG α) (eq_alpha_of_mem α hα e.2 h).choose_spec.choose_spec.choose).symm
    else (CategoryTheory.Quotient.functor homotopy).map
      ((Quiver.FreeGroupoid.of _).map (qArr α hα e h))

/-- The functor `Ψ : FG(P) ⥤ FG(P/⟨αᵢ⟩)`, replacing `αᵢ` by `u uᵢ⁻¹`. -/
def psiFG : Quiver.FreeGroupoid (RayVert P) ⥤ FundGroupoid (ArrowQuot α) :=
  Quiver.FreeGroupoid.lift (D.psiPre (hα := hα))

lemma psiFG_map_of_not_mem {x y : RayVert P} (e : x ⟶ y) (h : ¬(arrowIdeal α).mem e.1) :
    (D.psiFG (hα := hα)).map ((Quiver.FreeGroupoid.of _).map e) =
      (CategoryTheory.Quotient.functor homotopy).map
        ((Quiver.FreeGroupoid.of _).map (qArr α hα e h)) := by
  change (Quiver.FreeGroupoid.lift (D.psiPre (hα := hα))).map _ = _
  rw [lift_map_of]
  exact dif_neg h

/-- `Ψ` sends a path avoiding the ideal to its class in `P/⟨αᵢ⟩`. -/
lemma psiFG_map_pathFG {x : RayVert P} : ∀ {y : RayVert P} (p : Quiver.Path x y)
    (h : Avoids α p), (D.psiFG (hα := hα)).map (pathFG p) = clsQ α hα p h
  | _, .nil, _ =>
    ((D.psiFG (hα := hα)).map_id _).trans
      ((CategoryTheory.Quotient.functor (homotopy (P := ArrowQuot α))).map_id _).symm
  | _, .cons p e, h => by
    change (D.psiFG (hα := hα)).map (pathFG p ≫ (Quiver.FreeGroupoid.of _).map e) = _
    rw [Functor.map_comp, psiFG_map_pathFG p h.1, psiFG_map_of_not_mem D e h.2]
    change _ = (CategoryTheory.Quotient.functor homotopy).map
      (pathFG (toQ α hα p h.1) ≫ (Quiver.FreeGroupoid.of _).map (qArr α hα e h.2))
    rw [Functor.map_comp]
    rfl

omit [Finite P] in
lemma psiA_cast (i i' : ι) (hx : b = b) (hy : d i = d i')
    (he : α i = eqToHom hx ≫ α i' ≫ eqToHom hy.symm) :
    eqToHom (congrArg (objG α) hx) ≫ D.psiA (hα := hα) i' ≫
      eqToHom (congrArg (objG α) hy).symm = D.psiA (hα := hα) i := by
  have hii : i = i' := D.a_inj i i' hy (by rw [he]; simp)
  subst hii
  simp

/-- `Ψ(aᵢ) = [u] ≫ [uᵢ]⁻¹`. -/
lemma psiFG_map_a (i : ι) :
    (D.psiFG (hα := hα)).map ((Quiver.FreeGroupoid.of _).map (D.a i)) = D.psiA (hα := hα) i := by
  have hm : (arrowIdeal α).mem (D.a i).1 :=
    Or.inr ⟨i, 𝟙 _, 𝟙 _, by
      change (D.a i).1 = 𝟙 b ≫ α i ≫ 𝟙 (d i)
      rw [D.a_val, Category.id_comp, Category.comp_id]⟩
  change (Quiver.FreeGroupoid.lift (D.psiPre (hα := hα))).map _ = _
  rw [lift_map_of]
  refine (dif_pos hm).trans ?_
  have h := eq_alpha_of_mem α hα (D.a i).2 hm
  exact D.psiA_cast i h.choose h.choose_spec.choose h.choose_spec.choose_spec.choose
    ((D.a_val i).symm.trans h.choose_spec.choose_spec.choose_spec)

/-- One side of an essential contour killed in `P'`: it starts with some `aᵢ`
and `s₀ s₁ ~ uᵢ` in `P'`, or `s s₁ ~ u` in `P'`. -/
def Good {y : RayVert P} (s : Quiver.Path (RayVert.mk b) y) (s₁ : Quiver.Path y (RayVert.mk D.c))
    (h₁ : Avoids α s₁) : Prop :=
  (∃ (i : ι) (s₀ : Quiver.Path (RayVert.mk (d i)) y) (h₀ : Avoids α s₀),
      s = (Quiver.Path.nil.cons (D.a i)).comp s₀ ∧
        clsQ α hα s₀ h₀ ≫ clsQ α hα s₁ h₁ = clsQ α hα (D.us i) (D.avoids_us i)) ∨
    ∃ h : Avoids α s, clsQ α hα s h ≫ clsQ α hα s₁ h₁ = clsQ α hα D.u D.hu

/-- `Good`, or interlaced with `u` through a trivial `s₁`. -/
def Good' {y : RayVert P} (s : Quiver.Path (RayVert.mk b) y) (s₁ : Quiver.Path y (RayVert.mk D.c))
    (h₁ : Avoids α s₁) : Prop :=
  D.Good (hα := hα) s s₁ h₁ ∨ (s₁.length = 0 ∧ Interlaced (s.comp s₁) D.u)

/-- Conditions (2)–(3) of Fischbacher's Lemma 2.1, in the form used here: an
essential contour of `P` whose value is killed starts at `b`, and both of its
paths are good (`Good'`) for a common `s₁`. -/
def EssHyp : Prop :=
  (∀ {x y : RayVert P} (s t : Quiver.Path x y), pathVal s = pathVal t → pathVal s ≠ 0 →
      (arrowIdeal α).mem (pathVal s) → ¬Interlaced s t → x = RayVert.mk b) ∧
    ∀ {y : RayVert P} (s t : Quiver.Path (RayVert.mk b) y), pathVal s = pathVal t →
      pathVal s ≠ 0 → (arrowIdeal α).mem (pathVal s) → ¬Interlaced s t →
        ∃ (s₁ : Quiver.Path y (RayVert.mk D.c)) (h₁ : Avoids α s₁),
          D.Good' (hα := hα) s s₁ h₁ ∧ D.Good' (hα := hα) t s₁ h₁

/-- A good path is sent by `Ψ` to `[u] ≫ [s₁]⁻¹`. -/
lemma psiFG_good {y : RayVert P} {s : Quiver.Path (RayVert.mk b) y}
    {s₁ : Quiver.Path y (RayVert.mk D.c)} {h₁ : Avoids α s₁} (hg : D.Good (hα := hα) s s₁ h₁) :
    (D.psiFG (hα := hα)).map (pathFG s) ≫ clsQ α hα s₁ h₁ = clsQ α hα D.u D.hu := by
  rcases hg with ⟨i, s₀, h₀, rfl, he⟩ | ⟨h, he⟩
  · rw [pathFG_comp, Functor.map_comp]
    change ((D.psiFG (hα := hα)).map (𝟙 _ ≫ (Quiver.FreeGroupoid.of _).map (D.a i)) ≫ _) ≫ _ = _
    rw [Category.id_comp, psiFG_map_a, psiFG_map_pathFG D s₀ h₀]
    change (D.psiA (hα := hα) i ≫ clsQ α hα s₀ h₀) ≫ clsQ α hα s₁ h₁ = _
    rw [Category.assoc, he, psiA, Category.assoc, IsIso.inv_hom_id, Category.comp_id]
  · rw [psiFG_map_pathFG D s h]
    exact he

/-- `Ψ` identifies paths with the same nonzero value (induction on the number
of nonzero morphisms below the value). -/
theorem psiFG_sound (hE : D.EssHyp (hα := hα)) : ∀ (n : ℕ) {x y : RayVert P}
    (s t : Quiver.Path x y), pathVal s = pathVal t → pathVal s ≠ 0 →
    (IsRayCategory.below (⟨x.out, y.out, pathVal s⟩ : RayMor P)).ncard ≤ n →
    (D.psiFG (hα := hα)).map (pathFG s) = (D.psiFG (hα := hα)).map (pathFG t) := by
  intro n
  induction n with
  | zero =>
    intro x y s t _ h0 hle
    exfalso
    have := (Set.ncard_pos (IsRayCategory.below_finite (⟨x.out, y.out, pathVal s⟩ : RayMor P) h0)).2
      ⟨(⟨x.out, y.out, pathVal s⟩ : RayMor P), h0, IsRayCategory.le_refl _⟩
    omega
  | succ n ih =>
    intro x y s t hst h0 hle
    -- interlacing steps reduce to pairs of smaller value
    have key : ∀ (s' t' : Quiver.Path x y), Interlaced s' t' → pathVal s' = pathVal s →
        (D.psiFG (hα := hα)).map (pathFG s') = (D.psiFG (hα := hα)).map (pathFG t') := by
      intro s' t' h
      induction h with
      | rel s' t' hstep =>
        intro hv
        obtain ⟨a, c, p, v', w', q, rfl, rfl, hvw, hv0, hlen⟩ := hstep
        rw [pathFG_comp3, pathFG_comp3, Functor.map_comp, Functor.map_comp, Functor.map_comp,
          Functor.map_comp]
        congr 2
        refine ih v' w' hvw hv0 (Nat.lt_succ_iff.1 (lt_of_lt_of_le ?_ hle))
        have := below_lt_of_step p v' q (hv ▸ h0) hlen
        rwa [hv] at this
      | refl => intro _; rfl
      | symm s' t' h ih' => intro hv; exact (ih' ((interlaced_val h).trans hv)).symm
      | trans s' u' t' h h' ih' ih'' =>
        intro hv
        exact (ih' hv).trans (ih'' ((interlaced_val h).symm.trans hv))
    by_cases hm : (arrowIdeal α).mem (pathVal s)
    · by_cases hi : Interlaced s t
      · exact key s t hi rfl
      · obtain hx := hE.1 s t hst h0 hm hi
        subst hx
        obtain ⟨s₁, h₁, gs, gt⟩ := hE.2 s t hst h0 hm hi
        have hg : ∀ r : Quiver.Path x y, pathVal r = pathVal s →
            D.Good' (hα := hα) r s₁ h₁ → (D.psiFG (hα := hα)).map (pathFG r) ≫ clsQ α hα s₁ h₁ =
              clsQ α hα D.u D.hu := by
          intro r hr g
          rcases g with g | ⟨hl, hi'⟩
          · exact D.psiFG_good g
          · have hy := Quiver.Path.eq_of_length_zero s₁ hl
            subst hy
            have hn := Quiver.Path.eq_nil_of_length_zero s₁ hl
            subst hn
            rw [Quiver.Path.comp_nil] at hi'
            rw [key r D.u hi' hr, psiFG_map_pathFG D D.u D.hu]
            exact Category.comp_id _
        have := (hg s rfl gs).trans (hg t hst.symm gt).symm
        have hm' : Mono (show (D.psiFG (hα := hα)).obj ((Quiver.FreeGroupoid.of _).obj y) ⟶
            (D.psiFG (hα := hα)).obj ((Quiver.FreeGroupoid.of _).obj (RayVert.mk D.c)) from
              clsQ α hα s₁ h₁) := inferInstance
        exact (cancel_mono (show (D.psiFG (hα := hα)).obj ((Quiver.FreeGroupoid.of _).obj y) ⟶
            (D.psiFG (hα := hα)).obj ((Quiver.FreeGroupoid.of _).obj (RayVert.mk D.c)) from
              clsQ α hα s₁ h₁)).1 this
    · have hs := avoids_of_not_mem α s hm
      have ht := avoids_of_not_mem α t (hst ▸ hm)
      rw [psiFG_map_pathFG D s hs, psiFG_map_pathFG D t ht]
      refine CategoryTheory.Quotient.sound _ (homotopy.path _ _ ?_ ?_)
      · rw [pathVal_toQ, pathVal_toQ, hst]
      · rw [pathVal_toQ]
        exact ((arrowIdeal α).functor_map_ne_zero_iff _).2 hm

/-- `Ψ` on fundamental groupoids. -/
def psiBar (hE : D.EssHyp (hα := hα)) : FundGroupoid P ⥤ FundGroupoid (ArrowQuot α) :=
  CategoryTheory.Quotient.lift homotopy (D.psiFG (hα := hα)) fun _ _ f g h ↦ by
    cases h with
    | path p q hpq h0 => exact D.psiFG_sound hE _ p q hpq h0 le_rfl

end RedData

/-- `Φ` on fundamental groupoids. -/
def phiBar : FundGroupoid (ArrowQuot α) ⥤ FundGroupoid P :=
  CategoryTheory.Quotient.lift homotopy (inclFG α hα ⋙ CategoryTheory.Quotient.functor homotopy)
    fun _ _ _ _ h ↦ inclFG_homotopy α hα h

omit [Finite P] in
lemma incl_qArr {x y : RayVert P} (e : x ⟶ y) (h : ¬(arrowIdeal α).mem e.1) :
    (inclQuiver α hα).map (qArr α hα e h) = e :=
  Subtype.ext (quotF_map_injective α (liftQ_not_mem α hα (qArr α hα e h).2)
    ((quotF_liftQ α _).trans rfl))

omit [Finite P] in
lemma incl_toQ {x : RayVert P} : ∀ {y : RayVert P} (p : Quiver.Path x y) (h : Avoids α p),
    (inclQuiver α hα).mapPath (toQ α hα p h) = p
  | _, .nil, _ => rfl
  | _, .cons p e, h => by
    change ((inclQuiver α hα).mapPath (toQ α hα p h.1)).cons
      ((inclQuiver α hα).map (qArr α hα e h.2)) = _
    rw [incl_toQ p h.1, incl_qArr α hα e h.2]
    rfl

lemma phiBar_clsQ {x y : RayVert P} (p : Quiver.Path x y) (h : Avoids α p) :
    (phiBar α hα).map (clsQ α hα p h) =
      (CategoryTheory.Quotient.functor homotopy).map (pathFG p) := by
  change (CategoryTheory.Quotient.lift homotopy (inclFG α hα ⋙
    CategoryTheory.Quotient.functor homotopy) _).map
      ((CategoryTheory.Quotient.functor homotopy).map _) = _
  rw [CategoryTheory.Quotient.lift_map_functor_map]
  change (CategoryTheory.Quotient.functor homotopy).map ((inclFG α hα).map _) = _
  rw [freeGroupoidFunctor_pathFG, incl_toQ]
  rfl

/-! ### No essential contour: the fundamental group is free -/

/-- `P` has no essential contour: paths with the same nonzero value are interlaced. -/
def NoEssContour : Prop :=
  ∀ {x y : RayVert P} (s t : Quiver.Path x y), pathVal s = pathVal t → pathVal s ≠ 0 →
    Interlaced s t

omit hα in
/-- Without essential contours, homotopic paths are equal in the free groupoid. -/
lemma pathFG_eq_of_noEss (hP : NoEssContour (P := P)) : ∀ (n : ℕ) {x y : RayVert P}
    (s t : Quiver.Path x y), pathVal s = pathVal t → pathVal s ≠ 0 →
    (IsRayCategory.below (⟨x.out, y.out, pathVal s⟩ : RayMor P)).ncard ≤ n →
    pathFG s = pathFG t := by
  intro n
  induction n with
  | zero =>
    intro x y s t _ h0 hle
    exfalso
    have := (Set.ncard_pos (IsRayCategory.below_finite (⟨x.out, y.out, pathVal s⟩ : RayMor P) h0)).2
      ⟨(⟨x.out, y.out, pathVal s⟩ : RayMor P), h0, IsRayCategory.le_refl _⟩
    omega
  | succ n ih =>
    intro x y s t hst h0 hle
    have key : ∀ (s' t' : Quiver.Path x y), Interlaced s' t' → pathVal s' = pathVal s →
        pathFG s' = pathFG t' := by
      intro s' t' h
      induction h with
      | rel s' t' hstep =>
        intro hv
        obtain ⟨a, c, p, v', w', q, rfl, rfl, hvw, hv0, hlen⟩ := hstep
        rw [pathFG_comp3, pathFG_comp3]
        congr 2
        refine ih v' w' hvw hv0 (Nat.lt_succ_iff.1 (lt_of_lt_of_le ?_ hle))
        have := below_lt_of_step p v' q (hv ▸ h0) hlen
        rwa [hv] at this
      | refl => intro _; rfl
      | symm s' t' h ih' => intro hv; exact (ih' ((interlaced_val h).trans hv)).symm
      | trans s' u' t' h h' ih' ih'' =>
        intro hv
        exact (ih' hv).trans (ih'' ((interlaced_val h).symm.trans hv))
    exact key s t (hP s t hst h0) rfl

omit hα in
/-- Without essential contours the fundamental groupoid is the free groupoid. -/
lemma homotopy_eq_of_noEss (hP : NoEssContour (P := P)) {X Y : Quiver.FreeGroupoid (RayVert P)}
    {f g : X ⟶ Y} (h : homotopy f g) : f = g := by
  cases h with
  | path p q hpq h0 => exact pathFG_eq_of_noEss hP _ p q hpq h0 le_rfl

namespace RedData

variable {α} {hα} (D : RedData α)

omit [Finite P] [LargeIndecomposable.IsFiniteRayCategory0 P] in
lemma comp_inv_of_eq {G : Type*} [Groupoid G] {X Y Z : G} (f : X ⟶ Z) (g : Y ⟶ Z) (h : X ⟶ Y)
    (hh : h ≫ g = f) : f ≫ inv g = h := by
  rw [← hh, Category.assoc, IsIso.hom_inv_id, Category.comp_id]

/-- `Φ ⋙ Ψ = 𝟭` on generators. -/
lemma psiFG_incl {x' y' : RayVert (ArrowQuot α)} (e' : x' ⟶ y') :
    (D.psiFG (hα := hα)).map ((Quiver.FreeGroupoid.of _).map ((inclQuiver α hα).map e')) =
      (CategoryTheory.Quotient.functor homotopy).map ((Quiver.FreeGroupoid.of _).map e') := by
  rw [D.psiFG_map_of_not_mem _ (liftQ_not_mem α hα e'.2)]
  congr 2
  exact Subtype.ext (quotF_liftQ α e'.1)

/-- `Ψ ⋙ Φ = 𝟭` on generators. -/
lemma phiBar_psiFG {x y : RayVert P} (e : x ⟶ y) :
    (phiBar α hα).map ((D.psiFG (hα := hα)).map ((Quiver.FreeGroupoid.of _).map e)) =
      (CategoryTheory.Quotient.functor homotopy).map ((Quiver.FreeGroupoid.of _).map e) := by
  by_cases hm : (arrowIdeal α).mem e.1
  · obtain ⟨i, hx, hy, he⟩ := eq_alpha_of_mem α hα e.2 hm
    have hx' : x = RayVert.mk b := hx
    have hy' : y = RayVert.mk (d i) := hy
    subst x
    subst y
    have hea : e = D.a i := Subtype.ext (by
      rw [he, D.a_val]
      change eqToHom (rfl : b = b) ≫ α i ≫ eqToHom (rfl : d i = d i) = α i
      simp only [eqToHom_refl, Category.id_comp, Category.comp_id])
    subst hea
    rw [D.psiFG_map_a]
    change (phiBar α hα).map (clsQ α hα D.u D.hu ≫ inv (clsQ α hα (D.us i) (D.avoids_us i))) = _
    rw [Functor.map_comp, Functor.map_inv]
    refine comp_inv_of_eq _ _ _ ?_
    rw [phiBar_clsQ, phiBar_clsQ]
    have hval : pathVal ((Quiver.Path.nil.cons (D.a i)).comp (D.us i)) = pathVal D.u := by
      rw [pathVal_comp]
      change (𝟙 _ ≫ (D.a i).1) ≫ _ = _
      rw [Category.id_comp, D.a_val]
      exact D.hcomp i
    have hh := homotopic_of_pathVal_eq _ _ hval (hval ▸ D.hu0)
    rw [pathFG_comp, Functor.map_comp] at hh
    change (CategoryTheory.Quotient.functor homotopy).map
      (𝟙 _ ≫ (Quiver.FreeGroupoid.of _).map (D.a i)) ≫ _ = _ at hh
    rw [Category.id_comp] at hh
    exact hh
  · rw [D.psiFG_map_of_not_mem e hm]
    have h1 : (CategoryTheory.Quotient.functor homotopy).map
        ((Quiver.FreeGroupoid.of _).map (qArr α hα e hm)) =
        clsQ α hα (Quiver.Path.nil.cons e) ⟨trivial, hm⟩ := by
      change _ = (CategoryTheory.Quotient.functor homotopy).map (𝟙 _ ≫ _)
      rw [Category.id_comp]
    rw [h1]
    refine (phiBar_clsQ α hα (Quiver.Path.nil.cons e) ⟨trivial, hm⟩).trans ?_
    change (CategoryTheory.Quotient.functor homotopy).map (𝟙 _ ≫ _) = _
    rw [Category.id_comp]

omit [Finite P] [LargeIndecomposable.IsFiniteRayCategory0 P] in
lemma functor_eq_of_gen {V G : Type*} [Quiver V] [Groupoid G]
    (F₁ F₂ : Quiver.FreeGroupoid V ⥤ G)
    (h : Quiver.FreeGroupoid.of V ⋙q F₁.toPrefunctor = Quiver.FreeGroupoid.of V ⋙q F₂.toPrefunctor) :
    F₁ = F₂ :=
  (Quiver.FreeGroupoid.lift_unique _ F₁ h).trans (Quiver.FreeGroupoid.lift_unique _ F₂ rfl).symm

/-- `Ψ ⋙ Φ = 𝟭`. -/
lemma psiBar_phiBar (hE : D.EssHyp (hα := hα)) :
    D.psiBar hE ⋙ phiBar α hα = 𝟭 (FundGroupoid P) := by
  have h : D.psiFG (hα := hα) ⋙ phiBar α hα = CategoryTheory.Quotient.functor homotopy :=
    functor_eq_of_gen _ _ (Prefunctor.ext (fun _ ↦ rfl) fun _ _ e ↦ D.phiBar_psiFG e)
  rw [CategoryTheory.Quotient.lift_unique homotopy (CategoryTheory.Quotient.functor homotopy)
      (fun _ _ _ _ h ↦ CategoryTheory.Quotient.sound _ h) (D.psiBar hE ⋙ phiBar α hα)
      (by rw [← Functor.assoc, psiBar, CategoryTheory.Quotient.lift_spec, h]),
    CategoryTheory.Quotient.lift_unique homotopy (CategoryTheory.Quotient.functor homotopy)
      (fun _ _ _ _ h ↦ CategoryTheory.Quotient.sound _ h) (𝟭 _) (Functor.comp_id _)]

/-- `Φ ⋙ Ψ = 𝟭`. -/
lemma phiBar_psiBar (hE : D.EssHyp (hα := hα)) :
    phiBar α hα ⋙ D.psiBar hE = 𝟭 (FundGroupoid (ArrowQuot α)) := by
  have h : (inclFG α hα ⋙ CategoryTheory.Quotient.functor homotopy) ⋙ D.psiBar hE =
      CategoryTheory.Quotient.functor homotopy := by
    rw [Functor.assoc, psiBar, CategoryTheory.Quotient.lift_spec]
    refine functor_eq_of_gen _ _ (Prefunctor.ext (fun _ ↦ rfl) fun _ _ e ↦ ?_)
    change (D.psiFG (hα := hα)).map ((Quiver.FreeGroupoid.lift
      (inclQuiver α hα ⋙q Quiver.FreeGroupoid.of _)).map ((Quiver.FreeGroupoid.of _).map e)) = _
    rw [lift_map_of]
    exact D.psiFG_incl e
  rw [CategoryTheory.Quotient.lift_unique homotopy (CategoryTheory.Quotient.functor homotopy)
      (fun _ _ _ _ h ↦ CategoryTheory.Quotient.sound _ h) (phiBar α hα ⋙ D.psiBar hE)
      (by rw [← Functor.assoc, phiBar, CategoryTheory.Quotient.lift_spec, h]),
    CategoryTheory.Quotient.lift_unique homotopy (CategoryTheory.Quotient.functor homotopy)
      (fun _ _ _ _ h ↦ CategoryTheory.Quotient.sound _ h) (𝟭 _) (Functor.comp_id _)]

/-- **Fischbacher, Lemma 2.2**: killing the arrows `αᵢ` does not change the
fundamental group. -/
noncomputable def pi1Equiv (hE : D.EssHyp (hα := hα)) (X : FundGroupoid P) :
    End X ≃* End ((D.psiBar hE).obj X) :=
  (CategoryTheory.Equivalence.mk (D.psiBar hE) (phiBar α hα) (eqToIso (D.psiBar_phiBar hE).symm)
    (eqToIso (D.phiBar_psiBar hE))).fullyFaithfulFunctor.mulEquivEnd X

end RedData

end Finite

section Base

variable {Q : Type u} [Category.{v} Q] [HasZeroMorphisms Q]
  [LargeIndecomposable.IsFiniteRayCategory0 Q] [Finite Q]

attribute [local instance] isRayCategory_of_finiteRayCategory

/-- Without essential contours, the fundamental group of a connected ray
category is free. -/
theorem isFreeGroup_end_of_noEss (hP : NoEssContour (P := Q))
    [IsConnected (Quiver.FreeGroupoid (RayVert Q))] (X : Quiver.FreeGroupoid (RayVert Q)) :
    IsFreeGroup (End ((CategoryTheory.Quotient.functor (homotopy (P := Q))).obj X)) := by
  have : IsFreeGroup (End X) := isFreeGroup_end_freeGroupoid₂ X
  have hinj : ∀ {X Y : Quiver.FreeGroupoid (RayVert Q)}, Function.Injective
      ((CategoryTheory.Quotient.functor (homotopy (P := Q))).map (X := X) (Y := Y)) := by
    intro X Y f g hfg
    have H : ∀ (X Y : Quiver.FreeGroupoid (RayVert Q)) (f g : X ⟶ Y), homotopy f g →
        (𝟭 _).map f = (𝟭 _).map g := fun _ _ _ _ h ↦ homotopy_eq_of_noEss hP h
    have := congrArg (CategoryTheory.Quotient.lift homotopy (𝟭 _) H).map hfg
    rwa [CategoryTheory.Quotient.lift_map_functor_map, CategoryTheory.Quotient.lift_map_functor_map]
      at this
  let e : End X ≃* End ((CategoryTheory.Quotient.functor (homotopy (P := Q))).obj X) :=
    MulEquiv.ofBijective ((CategoryTheory.Quotient.functor homotopy).mapEnd X)
      ⟨hinj, fun g ↦ (CategoryTheory.Quotient.functor homotopy).map_surjective g⟩
  exact IsFreeGroup.ofMulEquiv e

end Base

