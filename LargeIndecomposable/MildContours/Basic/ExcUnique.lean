module

public import LargeIndecomposable.MildContours.Basic.ExcContour

/-!
# Uniqueness of exceptional contours

An exceptional dumb-bell contour is the only exceptional contour (`db_unique`). Two
`Q₂'` contours at the same point agree (`q2_same`), and the twisted arrow of a `Q₂'`
contour is not an arrow of a `Q₂'` contour at another point (`q2_apart`).
-/

@[expose] public section

set_option autoImplicit false
set_option linter.unusedSectionVars false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits Opposite RayCat LargeIndecomposable

namespace RayCat

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P]
  [Fintype P] [DecidableEq P] [IsFiniteRayCategory P] {k : Type*} [Field k] [Infinite k]

/-- A loop at a point whose radical is generated by `ρ` is `ρ`. -/
lemma loop_eq_of_gen {x : RayVert P} (ρ : x ⟶ x) (hρ : LoopGen' ρ) (e : x ⟶ x) : e = ρ := by
  obtain ⟨n, hn, hen⟩ := hρ e.1 e.2.2.1
  rcases n with _ | _ | n
  · omega
  · exact Subtype.ext (by rw [hen]; simp [rpow])
  · exfalso
    rcases e.2.2.2 _ (rpow ρ.1 (n + 1)) ρ.1 (by rw [hen, rpow_succ]) with h | h
    · exact MildContour.rpow_not_isIso ρ.1 ρ.2.2.1 (n + 1) (by omega) h
    · exact ρ.2.2.1 h

/-- A loop is an irreducible out of and into its point. -/
lemma loop_not_sink_source {x : RayVert P} (ρ : x ⟶ x)
    (h : (∀ {Z : P} (e : x.out ⟶ Z), ¬IsIrreducible e) ∨ ∀ {Z : P} (e : Z ⟶ x.out), ¬IsIrreducible e) :
    False := by
  rcases h with h | h
  · exact h ρ.1 ρ.2
  · exact h ρ.1 ρ.2

/-- **An exceptional dumb-bell contour is the only exceptional contour.** -/
theorem db_unique {x y : RayVert P} {v w : Quiver.Path x y} (hdb : DBExcPair v w)
    {x' y' : RayVert P} {v' w' : Quiver.Path x' y'} (h' : ExcPair v' w') :
    ∃ (_ : x' = x) (_ : y' = y), (HEq v' v ∧ HEq w' w) ∨ (HEq v' w ∧ HEq w' v) := by
  obtain ⟨χ, μ, α, N, hχ, hμ, hα, hv, hw, hF1, hF4, -, -⟩ := hdb
  have inxy : ∀ z : RayVert P, (z ⟶ z) → z = x ∨ z = y := by
    intro z ℓ
    by_contra hz
    push Not at hz
    exact loop_not_sink_source ℓ (hF1 z.out hz.1 hz.2)
  have inxy' : ∀ (z : RayVert P) {u u' : RayVert P} (_ : u ⟶ z) (_ : z ⟶ u'),
      z = x ∨ z = y := by
    intro z u u' e f
    by_contra hz
    push Not at hz
    rcases hF1 z.out hz.1 hz.2 with h | h
    · exact h f.1 f.2
    · exact h e.1 e.2
  have hyx : ∀ e : y ⟶ x, False := fun e ↦ e.2.1 (N.hyx e.1)
  have hLx : LoopGen' χ := fun f hf ↦ by rw [← hχ]; exact N.hρx f hf
  have hLy : LoopGen' α := fun f hf ↦ by rw [← hα]; exact N.hρ f hf
  -- a dumb-bell `E'` is `E`
  have db_case : ∀ {v₁ w₁ : Quiver.Path x' y'}, DBExcPair v₁ w₁ →
      ∃ (_ : x' = x) (_ : y' = y), HEq v₁ v ∧ HEq w₁ w := by
    intro v₁ w₁ h
    obtain ⟨χ', μ', α', N', -, -, -, hv', hw', -, -, -, -⟩ := h
    rcases inxy x' χ' with hx' | hx' <;> rcases inxy y' α' with hy' | hy'
    · exact absurd (by rw [hx', hy']) N'.hxy
    · subst hx' hy'
      have h1 := loop_eq_of_gen χ hLx χ'
      have h2 := loop_eq_of_gen α hLy α'
      have h3 : μ' = μ := Subtype.ext (by rw [hF4 μ'.1 μ'.2])
      subst h1 h2 h3 hv' hw'
      exact ⟨rfl, rfl, by rw [hv], by rw [hw]⟩
    · subst hx' hy'
      exact (hyx μ').elim
    · exact absurd (by rw [hx', hy']) N'.hxy
  rcases h' with h | h | ⟨hyx', h | h⟩
  · obtain ⟨h1, h2, h3, h4⟩ := db_case h
    exact ⟨h1, h2, Or.inl ⟨h3, h4⟩⟩
  · obtain ⟨h1, h2, h3, h4⟩ := db_case h
    exact ⟨h1, h2, Or.inr ⟨h4, h3⟩⟩
  all_goals
    subst hyx'
    obtain ⟨ρ', t', a', β', ht', -, -, -, -, -⟩ := h
    exfalso
    rcases inxy y' ρ' with hx' | hx' <;> rcases inxy' t' a' β' with ht | ht
    · exact ht' (ht.trans hx'.symm)
    · subst hx' ht; exact hyx β'
    · subst hx' ht; exact hyx a'
    · exact ht' (ht.trans hx'.symm)

/-- `e` is the arrow `T`. -/
def PIsA {a b : RayVert P} (T : a ⟶ b) {c d : RayVert P} (e : c ⟶ d) : Prop :=
  ∃ (_ : c = a) (_ : d = b), HEq e T

/-- **Two `Q₂'` contours at the same point agree.** -/
theorem q2_same (hM : MildHyp k P) {x : RayVert P} {v w : Quiver.Path x x} (h : Q2Pair v w)
    (hval : pathVal v = pathVal w) (h0 : pathVal v ≠ 0) (hni : ¬Interlaced v w)
    {v' w' : Quiver.Path x x} (h' : Q2Pair v' w') (hval' : pathVal v' = pathVal w') :
    v' = v ∧ w' = w := by
  obtain ⟨ρ, t, a, β, ht, hv, hw, hLG, h3, -⟩ := h
  obtain ⟨ρ', t', a', β', ht', hv', hw', -, -, -⟩ := h'
  have hρ := loop_eq_of_gen ρ hLG ρ'
  subst hρ
  have hvv : v' = v := by rw [hv', hv]
  refine ⟨hvv, ?_⟩
  have hωρ : pathVal v ≫ ρ'.1 ≠ 0 := by
    rw [hv]; change ((𝟙 _ ≫ ρ'.1) ≫ ρ'.1) ≫ ρ'.1 ≠ 0; simpa using h3
  rcases hM.path_unique hval h0 hni ρ'.2.2.1 hωρ w' (by rw [← hval', hvv]) with h1 | h1
  · exfalso
    rw [hw', hv] at h1
    exact ht' (Quiver.Path.obj_eq_of_cons_eq_cons h1)
  · exact h1

/-- **The twisted arrow `β` of a `Q₂'` contour at `x` is not an arrow of a `Q₂'` contour at
another point.** -/
theorem q2_apart_src {x t : RayVert P} (ρ : x ⟶ x) (β : t ⟶ x) (hsrc : Q2Src ρ β) (ht : t ≠ x)
    {x' t' : RayVert P} (ρ' : x' ⟶ x') (a' : x' ⟶ t') (β' : t' ⟶ x') (hx : x' ≠ x)
    (hval' : a'.1 ≫ β'.1 = ρ'.1 ≫ ρ'.1) (h0' : ρ'.1 ≫ ρ'.1 ≠ 0) :
    ¬PIsA β ρ' ∧ ¬PIsA β a' ∧ ¬PIsA β β' := by
  refine ⟨fun ⟨_, h2, _⟩ ↦ hx h2, fun ⟨h1, h2, h3⟩ ↦ ?_, fun ⟨_, h2, _⟩ ↦ hx h2⟩
  subst h1 h2
  have he := eq_of_heq h3
  subst he
  apply h0'
  rw [← hval']
  have := hsrc β' (fun ⟨h, _⟩ ↦ ht h) 0
  simpa [rpow] using this

/-- **The twisted arrow `a` of a `Q₂'` contour at `x` is not an arrow of a `Q₂'` contour at
another point.** -/
theorem q2_apart_tgt {x t : RayVert P} (ρ : x ⟶ x) (a : x ⟶ t) (htgt : Q2Tgt ρ a) (ht : t ≠ x)
    {x' t' : RayVert P} (ρ' : x' ⟶ x') (a' : x' ⟶ t') (β' : t' ⟶ x') (hx : x' ≠ x)
    (hval' : a'.1 ≫ β'.1 = ρ'.1 ≫ ρ'.1) (h0' : ρ'.1 ≫ ρ'.1 ≠ 0) :
    ¬PIsA a ρ' ∧ ¬PIsA a a' ∧ ¬PIsA a β' := by
  refine ⟨fun ⟨h1, _, _⟩ ↦ hx h1, fun ⟨h1, _, _⟩ ↦ hx h1, fun ⟨h1, h2, h3⟩ ↦ ?_⟩
  subst h1 h2
  have he := eq_of_heq h3
  subst he
  apply h0'
  rw [← hval']
  have := htgt a' (fun ⟨h, _⟩ ↦ ht h) 0
  simpa [rpow] using this

end RayCat

end LargeIndecomposable
