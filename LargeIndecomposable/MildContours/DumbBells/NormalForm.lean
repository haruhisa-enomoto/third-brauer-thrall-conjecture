public import LargeIndecomposable.Cleaving.Families.FamDB31A
public import LargeIndecomposable.Cleaving.Families.FamDB31B

/-!
# Dumb-bells in normal form ([mild] PDB, LDB)

`DBN x y`: arrows `χ : x ⟶ x`, `μ : x ⟶ y`, `α : y ⟶ y` with `χ μ = μ α`,
`μ α² ≠ 0`, `P(y, x) = 0`, and the radicals of `End x`, `End y` generated by
`χ`, `α`. `DBData.toN` builds it from case (DB) of [mild] Lemma 2.2.
`DBN.ldb`: `μ` and `α` are the only arrows into `y` ([mild] LDB).
-/

@[expose] public section

set_option autoImplicit false
set_option linter.unusedSectionVars false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits Opposite RayCat LargeIndecomposable

namespace RayCat

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P]

/-- A dumb-bell in normal form. -/
structure DBN (x y : P) where
  χ : x ⟶ x
  μ : x ⟶ y
  α : y ⟶ y
  hχ : IsIrreducible χ
  hμ : IsIrreducible μ
  hα : IsIrreducible α
  comm : χ ≫ μ = μ ≫ α
  hτ : μ ≫ α ≫ α ≠ 0
  hxy : x ≠ y
  hyx : ∀ f : y ⟶ x, f = 0
  hρ : ∀ f : y ⟶ y, ¬IsIso f → ∃ n, 0 < n ∧ f = rpow α n
  hρx : ∀ f : x ⟶ x, ¬IsIso f → ∃ n, 0 < n ∧ f = rpow χ n
  nχμ : ¬∃ g, χ ≫ g = μ
  nαμ : ¬∃ g, g ≫ α = μ

/-- **The dual dumb-bell** in `Pᵒᵖ` (loops and ends exchanged). -/
def DBN.op {x y : P} (N : DBN x y) : DBN (Opposite.op y) (Opposite.op x) where
  χ := N.α.op
  μ := N.μ.op
  α := N.χ.op
  hχ := (isIrreducible_op _).2 N.hα
  hμ := (isIrreducible_op _).2 N.hμ
  hα := (isIrreducible_op _).2 N.hχ
  comm := by rw [← op_comp, ← op_comp, N.comm]
  hτ := by
    intro h
    apply N.hτ
    apply Quiver.Hom.op_inj
    have e : N.χ ≫ N.χ ≫ N.μ = N.μ ≫ N.α ≫ N.α := by
      rw [N.comm, ← Category.assoc, N.comm, Category.assoc]
    rw [op_zero, ← h, ← e]; simp
  hxy := fun h ↦ N.hxy (Opposite.op_injective h).symm
  hyx := fun f ↦ Quiver.Hom.unop_inj (by rw [N.hyx f.unop]; rfl)
  hρ := by
    intro f hf
    obtain ⟨n, hn, h⟩ := N.hρx f.unop (fun h' ↦ hf ((isIso_unop_iff f).1 h'))
    exact ⟨n, hn, by rw [← op_rpow, ← h]; rfl⟩
  hρx := by
    intro f hf
    obtain ⟨n, hn, h⟩ := N.hρ f.unop (fun h' ↦ hf ((isIso_unop_iff f).1 h'))
    exact ⟨n, hn, by rw [← op_rpow, ← h]; rfl⟩
  nχμ := neg_op_left N.nαμ
  nαμ := neg_op_right N.nχμ

variable [Fintype P] [DecidableEq P] [IsFiniteRayCategory P] {k : Type*} [Field k] [Infinite k]

/-- An irreducible generator of a cyclic radical is the generator. -/
lemma gen_of_irr {x : P} (c : x ⟶ x) (hc : IsIrreducible c) (hE : EndCyclic P) :
    ∀ f : x ⟶ x, ¬IsIso f → ∃ n, 0 < n ∧ f = rpow c n := by
  obtain ⟨π, hπ⟩ := hE x
  obtain ⟨m, hm, hcm⟩ := hπ c hc.2.1
  have hπn : ¬IsIso π := fun h ↦ by
    obtain ⟨h0, h1⟩ := RayQuiver.eq_id_of_isIso π
    exact hc.2.1 (by rw [hcm, show π = 𝟙 _ from by simpa using h1, MildContour.rpow_id]
                     infer_instance)
  have hm1 : m = 1 := by
    by_contra h
    obtain ⟨m', rfl⟩ : ∃ m', m = m' + 2 := ⟨m - 2, by omega⟩
    rcases hc.2.2 _ π (rpow π (m' + 1)) (by rw [hcm, ← rpow_succ']) with h' | h'
    · exact hπn h'
    · exact MildContour.rpow_not_isIso π hπn (m' + 1) (by omega) h'
  subst hm1
  have hcπ : c = π := by rw [hcm]; simp [rpow_succ]
  subst hcπ
  exact hπ

namespace DBData

variable {x y : RayVert P} (D : DBData x y)

include D in
/-- **[mild] PDB**: case (DB) gives a dumb-bell in normal form. -/
theorem toN (hM : MildHyp k P) (hOS : OneSidedCyclic P) (hE : EndCyclic P) :
    Nonempty (DBN x.out y.out) := by
  obtain ⟨χ, hχ⟩ := D.suffix hM hOS
  have hR : RightCancel P := hM.right
  have hcirr : IsIrreducible (pathVal χ) := irr_of_length_one χ (D.χ_len hM hχ)
  have hqiso : IsIso (pathVal D.q) := MildContour.isIso_pathVal_of_length_zero _ (D.q_nil hM hχ)
  have hμirr : IsIrreducible D.μ := isIrreducible_iso_comp (pathVal D.q) D.β.2
  have hap := D.C.apart hR
  refine ⟨⟨pathVal χ, D.μ, D.α.1, hcirr, hμirr, D.α.2, (D.ω_w hχ).symm.trans (D.ω_v), ?_,
    D.x_ne_y hM, D.no_yx hM hχ, D.hρ, gen_of_irr _ hcirr hE, D.not_c_μ hM hχ, ?_⟩⟩
  · have := D.hωρ; rw [D.ω_v] at this; simpa using this
  · rintro ⟨g, hg⟩
    have hg0 : g ≠ 0 := fun h ↦ D.h0 (by rw [D.ω_v, ← hg, h, zero_comp, zero_comp])
    obtain ⟨pg, hpg⟩ := exists_path g hg0
    exact cons_ne_of_apart _ D.α _ D.β hap
      (D.uniq_μ hM (pg.cons D.α) (by change pathVal pg ≫ D.α.1 = _; rw [hpg, hg]))

end DBData

namespace DBN

variable {x y : P} (N : DBN x y)

/-- The killed morphism `τ = μ α²`. -/
abbrev τ : x ⟶ y := N.μ ≫ N.α ≫ N.α

lemma τ_n : ¬IsIso N.τ := not_isIso_comp_left' _ N.hμ.2.1

lemma τ_χ : N.χ ≫ N.μ ≫ N.α = N.τ := by rw [← Category.assoc, N.comm, Category.assoc]

lemma τ_χχ : N.χ ≫ N.χ ≫ N.μ = N.τ := by rw [N.comm, N.τ_χ]

include N in
lemma noiso_yx (g : y ⟶ x) : ¬IsIso g := fun h ↦ N.hxy (eq_of_isIso h).symm

include N in
lemma noiso_xy (g : x ⟶ y) : ¬IsIso g := fun h ↦ N.hxy (eq_of_isIso h)

lemma rpow_comm (n : ℕ) : N.α ≫ rpow N.α n = rpow N.α n ≫ N.α := by
  rw [← rpow_succ', rpow_succ]

/-- `ν ≫ α` does not factor through `τ` for an arrow `ν` into `y`. -/
lemma ftm_να {z : P} (ν : z ⟶ y) (hν : IsIrreducible ν) (hR : RightCancel P) (h0 : ν ≫ N.α ≠ 0) :
    ¬FactorsThroughMorphism N.τ (ν ≫ N.α) := by
  rintro ⟨u, v, huv⟩
  have key : ∀ w : y ⟶ y, ν ≫ N.α = (u ≫ N.μ ≫ N.α ≫ w) ≫ N.α → False := by
    intro w e
    have hν' := hR _ _ _ e h0
    rcases hν.2.2 _ (u ≫ N.μ) (N.α ≫ w) (by rw [hν']; simp) with h | h
    · exact N.hμ.2.1 (ray_isIso_factors u N.μ).2
    · exact N.hα.2.1 (ray_isIso_factors N.α w).1
  by_cases hv : IsIso v
  · obtain ⟨hh, hv1⟩ := RayQuiver.eq_id_of_isIso v
    have : v = 𝟙 _ := by simpa using hv1
    subst this
    exact key (𝟙 _) (by rw [huv]; simp)
  · obtain ⟨n, hn, rfl⟩ := N.hρ v hv
    obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
    exact key (N.α ≫ rpow N.α m) (by rw [huv, rpow_succ]; simp)

/-- **An extra arrow `ν` into `y` is killed by `α`** ([mild] LDB, the `D̃₄` star). -/
theorem να (hM : MildHyp k P) {z : P} (ν : z ⟶ y) (hν : IsIrreducible ν)
    (h1 : ¬∃ g, g ≫ N.μ = ν) (h2 : ¬∃ g, g ≫ N.α = ν) : ν ≫ N.α = 0 := by
  by_contra h
  have hτ0 := N.hτ
  have hμn := N.hμ.2.1
  have hαn := N.hα.2.1
  refine hM.not_in3 N.τ N.τ_n hτ0 N.μ N.α ν N.α
    (nfp hτ0 N.μ N.α N.α (Or.inl hμn) rfl)
    (nfp hτ0 (𝟙 _) N.μ (N.α ≫ N.α) (Or.inr (not_isIso_comp_left' _ hαn)) (by simp))
    (nfp hτ0 (𝟙 _) (N.μ ≫ N.α) N.α (Or.inr hαn) (by simp))
    (nfp hτ0 N.μ N.α N.α (Or.inl hμn) rfl)
    (nfp hτ0 N.μ (N.α ≫ N.α) (𝟙 _) (Or.inl hμn) (by simp))
    (irr_not_ftm_comp N.μ (N.α ≫ N.α) hμn (not_isIso_comp_left' _ hαn) ν hν)
    (N.ftm_να ν hν hM.right h) hμn hαn hν.2.1 hαn ?_ h1 N.nαμ h2 ?_ ?_
  · rintro ⟨g, hg⟩
    exact N.hα.1 (by rw [← hg, N.hyx g, zero_comp])
  · rintro ⟨g, hg⟩
    rcases N.hμ.2.2 _ g ν hg.symm with h' | h'
    · exact h1 ⟨inv g, by rw [← hg]; simp⟩
    · exact hν.2.1 h'
  · rintro ⟨g, hg⟩
    rcases N.hα.2.2 _ g ν hg.symm with h' | h'
    · exact h2 ⟨inv g, by rw [← hg]; simp⟩
    · exact hν.2.1 h'

/-- **[mild] LDB**: `μ` and `α` are the only arrows into `y`. -/
theorem ldb (hM : MildHyp k P) {z : P} (ν : z ⟶ y) (hν : IsIrreducible ν)
    (h1 : ¬∃ g, g ≫ N.μ = ν) (h2 : ¬∃ g, g ≫ N.α = ν) : False := by
  have hR : RightCancel P := hM.right
  have hL : LeftCancel P := hM.left
  have hτ0 := N.hτ
  have hμn := N.hμ.2.1
  have hαn := N.hα.2.1
  have hχn := N.hχ.2.1
  have hνα := N.να hM ν hν h1 h2
  have n1 : ¬∃ g, g ≫ ν = N.μ := by
    rintro ⟨g, hg⟩
    rcases N.hμ.2.2 _ g ν hg.symm with h' | h'
    · exact h1 ⟨inv g, by rw [← hg]; simp⟩
    · exact hν.2.1 h'
  have n2 : ¬∃ g, g ≫ ν = N.α := by
    rintro ⟨g, hg⟩
    rcases N.hα.2.2 _ g ν hg.symm with h' | h'
    · exact h2 ⟨inv g, by rw [← hg]; simp⟩
    · exact hν.2.1 h'
  have z1 : ¬∃ g, N.μ ≫ g = N.χ := fun ⟨g, hg⟩ ↦ N.hχ.1 (by rw [← hg, N.hyx g, comp_zero])
  have z2 : ¬∃ g, N.μ ≫ g = N.χ ≫ N.χ := fun ⟨g, hg⟩ ↦ hτ0 (by
    rw [show N.μ ≫ N.α ≫ N.α = N.χ ≫ N.χ ≫ N.μ from N.τ_χχ.symm, ← Category.assoc, ← hg,
      N.hyx g, comp_zero, zero_comp])
  have z3 : ¬∃ g, g ≫ N.μ = N.α := fun ⟨g, hg⟩ ↦ N.hα.1 (by rw [← hg, N.hyx g, zero_comp])
  have z4 : ¬∃ g, g ≫ N.μ = N.α ≫ N.α := fun ⟨g, hg⟩ ↦ hτ0 (by
    rw [← hg, N.hyx g, zero_comp, comp_zero])
  have z5 : ¬∃ g, g ≫ ν = N.μ ≫ N.α := fun ⟨g, hg⟩ ↦ hτ0 (by
    rw [← Category.assoc, ← hg, Category.assoc, hνα, comp_zero])
  have h0 := fun {s t : P} (pp : x ⟶ s) (f : s ⟶ t) (q : t ⟶ y) (hpq : ¬IsIso pp ∨ ¬IsIso q)
    (h : pp ≫ f ≫ q = N.τ) ↦ nfp hτ0 pp f q hpq h
  have hνf := irr_not_ftm_comp N.μ (N.α ≫ N.α) hμn (not_isIso_comp_left' _ hαn) ν hν
  by_cases hξ : ∃ ξ, ξ ≫ ν = N.α ≫ N.α
  swap
  · exact hM.not_db31a N.τ N.τ_n hτ0 N.μ N.α N.χ N.μ N.α ν N.χ
      DB31A.not_isRepresentationFinite N.comm
      (h0 (𝟙 _) N.μ (N.α ≫ N.α) (Or.inr (not_isIso_comp_left' _ hαn)) (by simp))
      (h0 (𝟙 _) N.χ (N.χ ≫ N.μ) (Or.inr (not_isIso_comp_left' _ hχn)) (by simp [N.τ_χχ]))
      (h0 (𝟙 _) (N.μ ≫ N.α) N.α (Or.inr hαn) (by simp))
      (h0 (𝟙 _) (N.χ ≫ N.χ) N.μ (Or.inr hμn) (by simp [N.τ_χχ]))
      (h0 N.μ N.α N.α (Or.inl hμn) rfl)
      (h0 N.χ N.μ N.α (Or.inl hχn) N.τ_χ)
      (h0 N.χ N.χ N.μ (Or.inl hχn) N.τ_χχ)
      (h0 N.μ N.α N.α (Or.inl hμn) rfl)
      (h0 N.μ (N.α ≫ N.α) (𝟙 _) (Or.inl hμn) (by simp))
      hνf hμn hαn hχn hμn hαn hν.2.1 hχn z1 z2 N.nχμ z1 N.nχμ z3 N.nαμ h2 z3 z4 h1 N.nαμ
      z5 n2 n1 hξ
  obtain ⟨ξ, hξ⟩ := hξ
  have hξ0 : ξ ≠ 0 := fun h ↦ hτ0 (by rw [← hξ, h, zero_comp, comp_zero])
  have hξn : ¬IsIso ξ := fun h ↦ by
    rcases hν.2.2 _ (inv ξ ≫ N.α) N.α (by rw [Category.assoc, hξ.symm.trans rfl]; simp
      ) with h' | h'
    · exact hαn ((ray_isIso_factors (inv ξ) N.α).2)
    · exact hαn h'
  obtain ⟨w, η, ξ', hη, rfl⟩ := exists_first_arrow' ξ hξ0 hξn
  have hτη : N.μ ≫ η ≫ ξ' ≫ ν = N.τ := by show _ = N.μ ≫ N.α ≫ N.α; rw [← hξ]; simp
  have hμη : N.μ ≫ η ≠ 0 := fun h ↦ hτ0 (by
    rw [show N.μ ≫ N.α ≫ N.α = _ from hτη.symm, ← Category.assoc, h, zero_comp])
  have a1 : ¬∃ g, N.α ≫ g = η := by
    rintro ⟨g, hg⟩
    rcases hη.2.2 _ N.α g hg.symm with h' | h'
    · exact hαn h'
    · have e : N.α ≫ N.α = N.α ≫ (g ≫ ξ' ≫ ν) := by rw [← hξ, ← hg]; simp
      have e' := hL _ _ _ e (fun h ↦ hτ0 (by rw [h, comp_zero]))
      rcases N.hα.2.2 _ (g ≫ ξ') ν (by rw [e']; simp) with h'' | h''
      · exact h2 ⟨inv (g ≫ ξ'), by rw [e']; simp⟩
      · exact hν.2.1 h''
  have a2 : ¬∃ g, η ≫ g = N.α := by
    rintro ⟨g, hg⟩
    rcases N.hα.2.2 _ η g hg.symm with h' | h'
    · exact hη.2.1 h'
    · exact a1 ⟨inv g, by rw [← hg]; simp⟩
  by_cases hζ : ∃ ζ, N.χ ≫ ζ = N.μ ≫ η
  swap
  · exact hM.not_db31b N.τ N.τ_n hτ0 N.μ N.α N.χ N.μ η ν N.χ
      DB31B.not_isRepresentationFinite N.comm
      (h0 (𝟙 _) N.μ (N.α ≫ N.α) (Or.inr (not_isIso_comp_left' _ hαn)) (by simp))
      (h0 (𝟙 _) N.χ (N.χ ≫ N.μ) (Or.inr (not_isIso_comp_left' _ hχn)) (by simp [N.τ_χχ]))
      (h0 (𝟙 _) (N.μ ≫ N.α) N.α (Or.inr hαn) (by simp))
      (h0 (𝟙 _) (N.χ ≫ N.χ) N.μ (Or.inr hμn) (by simp [N.τ_χχ]))
      (h0 (𝟙 _) (N.μ ≫ η) (ξ' ≫ ν) (Or.inr (not_isIso_comp_right' _ hν.2.1)) (by simp [hτη]))
      (h0 N.μ N.α N.α (Or.inl hμn) rfl)
      (irr_not_ftm_comp N.μ (N.α ≫ N.α) hμn (not_isIso_comp_left' _ hαn) η hη)
      (h0 N.χ N.μ N.α (Or.inl hχn) N.τ_χ)
      (h0 N.χ N.χ N.μ (Or.inl hχn) N.τ_χχ)
      hνf hμn hαn hχn hμn hη.2.1 hν.2.1 hχn z1 z2 N.nχμ hζ a1 a2 z1 N.nχμ N.nαμ h2 z3 h1
      z5 n2 n1
  obtain ⟨ζ, hζ⟩ := hζ
  refine hM.not_crown2 N.τ N.τ_n hτ0 N.μ N.α η ζ
    (irr_not_ftm_comp N.μ (N.α ≫ N.α) hμn (not_isIso_comp_left' _ hαn) N.μ N.hμ)
    (irr_not_ftm_comp N.μ (N.α ≫ N.α) hμn (not_isIso_comp_left' _ hαn) N.α N.hα)
    (irr_not_ftm_comp N.μ (N.α ≫ N.α) hμn (not_isIso_comp_left' _ hαn) η hη) ?_
    N.nαμ z3 ?_ ?_ a1 a2 ?_ ?_
  · rintro ⟨u, v, huv⟩
    have e : N.τ = (N.χ ≫ u) ≫ N.τ ≫ (v ≫ ξ' ≫ ν) := by
      calc N.τ = (N.μ ≫ η) ≫ ξ' ≫ ν := hτη.symm.trans (by simp)
        _ = (N.χ ≫ ζ) ≫ ξ' ≫ ν := by rw [hζ]
        _ = _ := by rw [huv]; simp
    have := (IsRayCategory.eq_id_of_two_sided _ hτ0 _ _ e).1
    haveI : IsIso (N.χ ≫ u) := by rw [this]; infer_instance
    exact hχn (ray_isIso_factors N.χ u).1
  · rintro ⟨g, hg⟩
    exact hη.1 (by rw [← hg, N.hyx g, zero_comp])
  · rintro ⟨g, hg⟩
    have e : (N.χ ≫ g) ≫ η = N.μ ≫ η := by rw [Category.assoc, hg, hζ]
    exact N.nχμ ⟨g, hR _ _ _ e (by rw [e]; exact hμη)⟩
  · rintro ⟨g, hg⟩
    rcases N.hμ.2.2 _ ζ g hg.symm with h' | h'
    · apply N.hχ.1
      have e : N.χ = N.μ ≫ (η ≫ inv ζ) := by
        rw [← Category.assoc, ← hζ]; simp
      rw [e, N.hyx (η ≫ inv ζ), comp_zero]
    · have e : N.μ ≫ (N.α ≫ inv g) = N.μ ≫ η := by
        conv_lhs => rw [← Category.assoc, ← N.comm, ← hg]
        simp [hζ]
      exact a1 ⟨inv g, hL _ _ _ e (by rw [e]; exact hμη)⟩
  · rintro ⟨g, hg⟩
    have e : N.μ ≫ (N.α ≫ g) = N.μ ≫ η := by
      rw [← Category.assoc, ← N.comm, Category.assoc, hg, hζ]
    exact a1 ⟨g, hL _ _ _ e (by rw [e]; exact hμη)⟩

/-- **[mild] LDB, dual**: `χ` and `μ` are the only arrows out of `x`. -/
theorem ldb_op (hMo : MildHyp k Pᵒᵖ) {z : P} (ν : x ⟶ z) (hν : IsIrreducible ν)
    (h1 : ¬∃ g, N.μ ≫ g = ν) (h2 : ¬∃ g, N.χ ≫ g = ν) : False := by
  letI := isRayCategory_of_finiteRayCategory (C := Pᵒᵖ)
  letI : Fintype Pᵒᵖ := Fintype.ofFinite _
  letI : DecidableEq Pᵒᵖ := Classical.decEq _
  exact N.op.ldb hMo ν.op ((isIrreducible_op _).2 hν) (neg_op_right h1) (neg_op_right h2)

end DBN

end RayCat

