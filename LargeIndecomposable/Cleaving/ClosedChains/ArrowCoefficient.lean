module

public import LargeIndecomposable.RayCategories.Distributive.DistributiveHomStructure
public import Mathlib.LinearAlgebra.Dual.Lemmas

@[expose] public section

set_option autoImplicit false
noncomputable section

open CategoryTheory

namespace LargeIndecomposable.ClosedZigzagTransfer

universe u v w z

variable {k : Type w} [Field k]
variable {C : Type u} [Category.{v} C] [Preadditive C] [Linear k C]

/-- The endpoint-radical part of the principal bimodule generated by `f`. -/
def endpointRadicalSubmodule {X Y : C} (f : X ⟶ Y) :
    Submodule k (X ⟶ Y) where
  carrier := {g | ∃ a : End X, a ∈ Ring.jacobson (End X) ∧
    ∃ b : End Y, b ∈ Ring.jacobson (End Y) ∧
      g = a.asHom ≫ f + f ≫ b.asHom}
  zero_mem' := by
    refine ⟨0, (Ring.jacobson (End X)).zero_mem, 0,
      (Ring.jacobson (End Y)).zero_mem, ?_⟩
    change (0 : X ⟶ Y) = (0 : X ⟶ X) ≫ f + f ≫ (0 : Y ⟶ Y)
    simp
  add_mem' := by
    rintro g h ⟨a, ha, b, hb, rfl⟩ ⟨c, hc, d, hd, rfl⟩
    refine ⟨a + c, (Ring.jacobson (End X)).add_mem ha hc,
      b + d, (Ring.jacobson (End Y)).add_mem hb hd, ?_⟩
    change (a.asHom ≫ f + f ≫ b.asHom) +
        (c.asHom ≫ f + f ≫ d.asHom) =
      (a.asHom + c.asHom) ≫ f + f ≫ (b.asHom + d.asHom)
    rw [Preadditive.add_comp, Preadditive.comp_add]
    abel
  smul_mem' := by
    rintro r g ⟨a, ha, b, hb, rfl⟩
    refine ⟨r • a, ?_, r • b, ?_, ?_⟩
    · rw [Algebra.smul_def]
      exact (Ring.jacobson (End X)).mul_mem_left _ ha
    · rw [Algebra.smul_def]
      exact (Ring.jacobson (End Y)).mul_mem_left _ hb
    · change r • (a.asHom ≫ f + f ≫ b.asHom) =
        (r • a.asHom) ≫ f + f ≫ (r • b.asHom)
      rw [smul_add, Linear.smul_comp, Linear.comp_smul]

private theorem radical_element_isNilpotent
    {R : Type z} [Ring R] [IsArtinianRing R]
    (r : R) (hr : r ∈ Ring.jacobson R) : IsNilpotent r := by
  obtain ⟨n, hn⟩ := IsArtinianRing.isNilpotent_jacobson_bot (R := R)
  rw [Ideal.jacobson_bot] at hn
  refine ⟨n, ?_⟩
  have hpow : r ^ n ∈ (Ring.jacobson R) ^ n := Ideal.pow_mem_pow hr n
  rw [hn] at hpow
  simpa using hpow

private theorem eq_zero_of_eq_comp_comp_of_isNilpotent_right
    {X Y : C} {f : X ⟶ Y} (a : End X) (b : End Y)
    (hb : IsNilpotent b)
    (h : f = (a.asHom ≫ f) ≫ b.asHom) : f = 0 := by
  obtain ⟨n, hn⟩ := hb
  have hp : ∀ m : ℕ,
      f = ((a ^ m).asHom ≫ f) ≫ (b ^ m).asHom := by
    intro m
    induction m with
    | zero => simp
    | succ m ih =>
        calc
          f = (a.asHom ≫ f) ≫ b.asHom := h
          _ = (a.asHom ≫ (((a ^ m).asHom ≫ f) ≫
                (b ^ m).asHom)) ≫ b.asHom := by rw [← ih]
          _ = ((a ^ Nat.succ m).asHom ≫ f) ≫
                (b ^ Nat.succ m).asHom := by
              rw [pow_succ a m, pow_succ' b m, End.mul_def, End.mul_def]
              change (a.asHom ≫ (((a ^ m).asHom ≫ f) ≫
                  (b ^ m).asHom)) ≫ b.asHom =
                ((a.asHom ≫ (a ^ m).asHom) ≫ f) ≫
                  ((b ^ m).asHom ≫ b.asHom)
              simp only [Category.assoc]
  have hz : (b ^ n).asHom = (0 : Y ⟶ Y) := congrArg End.asHom hn
  rw [hp n, hz]
  simp

private theorem eq_zero_of_eq_comp_comp_of_isNilpotent_left
    {X Y : C} {f : X ⟶ Y} (a : End X) (b : End Y)
    (ha : IsNilpotent a)
    (h : f = (a.asHom ≫ f) ≫ b.asHom) : f = 0 := by
  obtain ⟨n, hn⟩ := ha
  have hp : ∀ m : ℕ,
      f = ((a ^ m).asHom ≫ f) ≫ (b ^ m).asHom := by
    intro m
    induction m with
    | zero => simp
    | succ m ih =>
        calc
          f = (a.asHom ≫ f) ≫ b.asHom := h
          _ = (a.asHom ≫ (((a ^ m).asHom ≫ f) ≫
                (b ^ m).asHom)) ≫ b.asHom := by rw [← ih]
          _ = ((a ^ Nat.succ m).asHom ≫ f) ≫
                (b ^ Nat.succ m).asHom := by
              rw [pow_succ a m, pow_succ' b m, End.mul_def, End.mul_def]
              change (a.asHom ≫ (((a ^ m).asHom ≫ f) ≫
                  (b ^ m).asHom)) ≫ b.asHom =
                ((a.asHom ≫ (a ^ m).asHom) ≫ f) ≫
                  ((b ^ m).asHom ≫ b.asHom)
              simp only [Category.assoc]
  have hz : (a ^ n).asHom = (0 : X ⟶ X) := congrArg End.asHom hn
  rw [hp n, hz]
  simp

private theorem eq_zero_of_radical_transfer_right
    [∀ T : C, IsLocalRing (End T)]
    [∀ T : C, IsArtinianRing (End T)]
    {X Y : C} {f : X ⟶ Y} (hf : f ≠ 0)
    (a : End X) (b : End Y) (ha : a ∈ Ring.jacobson (End X))
    (hab : a.asHom ≫ f = f ≫ b.asHom) :
    b ∈ Ring.jacobson (End Y) := by
  by_contra hb
  have hbunit : IsUnit b := by
    by_contra hbu
    exact hb ((mem_ringJacobson_iff_not_isUnit (End Y) b).2 hbu)
  haveI : IsIso b.asHom := (isUnit_iff_isIso _).1 hbunit
  have haNil : IsNilpotent a := radical_element_isNilpotent a ha
  let bi : End Y := End.of (inv b.asHom)
  have hfix : f = (a.asHom ≫ f) ≫ bi.asHom := by
    dsimp [bi]
    rw [hab, Category.assoc, IsIso.hom_inv_id, Category.comp_id]
  exact hf (eq_zero_of_eq_comp_comp_of_isNilpotent_left a bi haNil hfix)

private theorem eq_zero_of_radical_transfer_left
    [∀ T : C, IsLocalRing (End T)]
    [∀ T : C, IsArtinianRing (End T)]
    {X Y : C} {f : X ⟶ Y} (hf : f ≠ 0)
    (a : End X) (b : End Y) (hb : b ∈ Ring.jacobson (End Y))
    (hab : a.asHom ≫ f = f ≫ b.asHom) :
    a ∈ Ring.jacobson (End X) := by
  by_contra ha
  have haunit : IsUnit a := by
    by_contra hau
    exact ha ((mem_ringJacobson_iff_not_isUnit (End X) a).2 hau)
  haveI : IsIso a.asHom := (isUnit_iff_isIso _).1 haunit
  have hbNil : IsNilpotent b := radical_element_isNilpotent b hb
  let ai : End X := End.of (inv a.asHom)
  have hfix : f = (ai.asHom ≫ f) ≫ b.asHom := by
    dsimp [ai]
    calc
      f = inv a.asHom ≫ (a.asHom ≫ f) := by simp
      _ = inv a.asHom ≫ (f ≫ b.asHom) := by rw [hab]
      _ = (inv a.asHom ≫ f) ≫ b.asHom := by rw [Category.assoc]
  exact hf (eq_zero_of_eq_comp_comp_of_isNilpotent_right ai b hbNil hfix)

/-- A nonzero cyclic Hom generator does not lie in the sum of its two
endpoint-Jacobson actions. -/
theorem not_mem_endpointRadicalSubmodule
    [∀ T : C, IsLocalRing (End T)]
    [∀ T : C, IsArtinianRing (End T)]
    [HasBGRSDistributiveHomStructure k C]
    {X Y : C} (f : X ⟶ Y) (hf : f ≠ 0) :
    f ∉ endpointRadicalSubmodule (k := k) f := by
  rintro ⟨a, ha, b, hb, hab⟩
  rcases HasBGRSDistributiveHomStructure.transit_or_cotransit
      (k := k) (C := C) f with ht | hc
  · obtain ⟨c, hac⟩ := ht a
    have hcJ : c ∈ Ring.jacobson (End Y) :=
      eq_zero_of_radical_transfer_right hf a c ha hac
    let d : End Y := c + b
    have hdJ : d ∈ Ring.jacobson (End Y) :=
      (Ring.jacobson (End Y)).add_mem hcJ hb
    have hdNil : IsNilpotent d := radical_element_isNilpotent d hdJ
    have hfd : f = f ≫ d.asHom := by
      calc
        f = a.asHom ≫ f + f ≫ b.asHom := hab
        _ = f ≫ c.asHom + f ≫ b.asHom := by rw [hac]
        _ = f ≫ d.asHom := by
          dsimp [d]
          change f ≫ c.asHom + f ≫ b.asHom =
            f ≫ (c.asHom + b.asHom)
          rw [Preadditive.comp_add]
    have hu : IsUnit (1 - d) := hdNil.isUnit_one_sub
    haveI : IsIso (1 - d).asHom := (isUnit_iff_isIso _).1 hu
    have hz : f ≫ (1 - d).asHom = 0 := by
      change f ≫ ((𝟙 Y) - d.asHom) = 0
      rw [Preadditive.comp_sub, Category.comp_id]
      exact sub_eq_zero.mpr hfd
    apply hf
    apply (cancel_mono (1 - d).asHom).1
    simpa using hz
  · obtain ⟨c, hbc⟩ := hc b
    have hcJ : c ∈ Ring.jacobson (End X) :=
      eq_zero_of_radical_transfer_left hf c b hb hbc.symm
    let d : End X := a + c
    have hdJ : d ∈ Ring.jacobson (End X) :=
      (Ring.jacobson (End X)).add_mem ha hcJ
    have hdNil : IsNilpotent d := radical_element_isNilpotent d hdJ
    have hdf : f = d.asHom ≫ f := by
      calc
        f = a.asHom ≫ f + f ≫ b.asHom := hab
        _ = a.asHom ≫ f + c.asHom ≫ f := by rw [hbc]
        _ = d.asHom ≫ f := by
          dsimp [d]
          change a.asHom ≫ f + c.asHom ≫ f =
            (a.asHom + c.asHom) ≫ f
          rw [Preadditive.add_comp]
    have hu : IsUnit (1 - d) := hdNil.isUnit_one_sub
    haveI : IsIso (1 - d).asHom := (isUnit_iff_isIso _).1 hu
    have hz : (1 - d).asHom ≫ f = 0 := by
      change ((𝟙 X) - d.asHom) ≫ f = 0
      rw [Preadditive.sub_comp, Category.id_comp]
      exact sub_eq_zero.mpr hdf
    apply hf
    apply (cancel_epi (1 - d).asHom).1
    simpa using hz

/-- A normalized coefficient functional that kills both endpoint radical
actions on a nonzero morphism. -/
theorem exists_normalized_endpointRadicalCoefficient
    [∀ T : C, IsLocalRing (End T)]
    [∀ T : C, IsArtinianRing (End T)]
    [HasBGRSDistributiveHomStructure k C]
    {X Y : C} (f : X ⟶ Y) (hf : f ≠ 0) :
    ∃ ell : (X ⟶ Y) →ₗ[k] k,
      ell f = 1 ∧ endpointRadicalSubmodule (k := k) f ≤ LinearMap.ker ell := by
  obtain ⟨φ, hφf, hφ⟩ :=
    (endpointRadicalSubmodule (k := k) f).exists_le_ker_of_notMem
      (not_mem_endpointRadicalSubmodule (k := k) f hf)
  let ell : (X ⟶ Y) →ₗ[k] k := (φ f)⁻¹ • φ
  refine ⟨ell, ?_, ?_⟩
  · dsimp [ell]
    simp [hφf]
  · intro g hg
    change (φ f)⁻¹ * φ g = 0
    rw [show φ g = 0 from hφ hg]
    simp

/-- A normalized endpoint-radical coefficient transforms under source
endomorphisms by the split residue scalar. -/
theorem endpointRadicalCoefficient_comp_left
    {X Y : C} (f : X ⟶ Y)
    (res : End X →ₐ[k] k)
    (hres : ∀ a : End X,
      res a = 0 ↔ a ∈ Ring.jacobson (End X))
    (ell : (X ⟶ Y) →ₗ[k] k) (hellf : ell f = 1)
    (hell : endpointRadicalSubmodule (k := k) f ≤ LinearMap.ker ell)
    (a : End X) :
    ell (a.asHom ≫ f) = res a := by
  let r : End X := a - algebraMap k (End X) (res a)
  have hrres : res r = 0 := by
    dsimp [r]
    rw [map_sub, AlgHom.commutes]
    exact sub_self _
  have hrJ : r ∈ Ring.jacobson (End X) := (hres r).1 hrres
  have hrmem : r.asHom ≫ f ∈ endpointRadicalSubmodule (k := k) f := by
    refine ⟨r, hrJ, 0, (Ring.jacobson (End Y)).zero_mem, ?_⟩
    change r.asHom ≫ f = r.asHom ≫ f + f ≫ (0 : Y ⟶ Y)
    simp
  have hellr : ell (r.asHom ≫ f) = 0 := hell hrmem
  have hscalar :
      (algebraMap k (End X) (res a)).asHom ≫ f = res a • f := by
    change ((res a • (1 : End X)).asHom) ≫ f = res a • f
    change (res a • (𝟙 X)) ≫ f = res a • f
    rw [Linear.smul_comp, Category.id_comp]
  have ha : a = r + algebraMap k (End X) (res a) := by
    dsimp [r]
    abel
  have haHom : a.asHom =
      r.asHom + (algebraMap k (End X) (res a)).asHom := by
    exact congrArg End.asHom ha
  calc
    ell (a.asHom ≫ f) =
        ell (r.asHom ≫ f +
          (algebraMap k (End X) (res a)).asHom ≫ f) := by
      rw [haHom, Preadditive.add_comp]
    _ = ell (r.asHom ≫ f) +
        ell ((algebraMap k (End X) (res a)).asHom ≫ f) :=
      ell.map_add _ _
    _ = res a := by rw [hellr, hscalar, ell.map_smul, hellf]; simp

/-- A normalized endpoint-radical coefficient transforms under target
endomorphisms by the split residue scalar. -/
theorem endpointRadicalCoefficient_comp_right
    {X Y : C} (f : X ⟶ Y)
    (res : End Y →ₐ[k] k)
    (hres : ∀ b : End Y,
      res b = 0 ↔ b ∈ Ring.jacobson (End Y))
    (ell : (X ⟶ Y) →ₗ[k] k) (hellf : ell f = 1)
    (hell : endpointRadicalSubmodule (k := k) f ≤ LinearMap.ker ell)
    (b : End Y) :
    ell (f ≫ b.asHom) = res b := by
  let r : End Y := b - algebraMap k (End Y) (res b)
  have hrres : res r = 0 := by
    dsimp [r]
    rw [map_sub, AlgHom.commutes]
    exact sub_self _
  have hrJ : r ∈ Ring.jacobson (End Y) := (hres r).1 hrres
  have hrmem : f ≫ r.asHom ∈ endpointRadicalSubmodule (k := k) f := by
    refine ⟨0, (Ring.jacobson (End X)).zero_mem,
      r, hrJ, ?_⟩
    change f ≫ r.asHom = (0 : X ⟶ X) ≫ f + f ≫ r.asHom
    simp
  have hellr : ell (f ≫ r.asHom) = 0 := hell hrmem
  have hscalar :
      f ≫ (algebraMap k (End Y) (res b)).asHom = res b • f := by
    change f ≫ ((res b • (1 : End Y)).asHom) = res b • f
    change f ≫ (res b • (𝟙 Y)) = res b • f
    rw [Linear.comp_smul, Category.comp_id]
  have hb : b = r + algebraMap k (End Y) (res b) := by
    dsimp [r]
    abel
  have hbHom : b.asHom =
      r.asHom + (algebraMap k (End Y) (res b)).asHom := by
    exact congrArg End.asHom hb
  calc
    ell (f ≫ b.asHom) =
        ell (f ≫ r.asHom +
          f ≫ (algebraMap k (End Y) (res b)).asHom) := by
      rw [hbHom, Preadditive.comp_add]
    _ = ell (f ≫ r.asHom) +
        ell (f ≫ (algebraMap k (End Y) (res b)).asHom) :=
      ell.map_add _ _
    _ = res b := by rw [hellr, hscalar, ell.map_smul, hellf]; simp

private theorem endpointCoefficient_exists_comp_of_mem_span_of_allowsTransit
    {X Y : C} {f g : X ⟶ Y} (ht : AllowsTransit f)
    (hg : g ∈ twoSidedEndomorphismSpan k f) :
    ∃ b : End Y, g = f ≫ b.asHom := by
  induction hg using Submodule.span_induction with
  | mem g hg =>
      rcases hg with ⟨a, b, rfl⟩
      obtain ⟨c, hc⟩ := ht a
      refine ⟨b * c, ?_⟩
      change (a.asHom ≫ f) ≫ b.asHom = f ≫ (b * c).asHom
      rw [hc, End.mul_def, Category.assoc]
  | zero =>
      refine ⟨0, ?_⟩
      change (0 : X ⟶ Y) = f ≫ (0 : Y ⟶ Y)
      simp
  | add g h _ _ hg hh =>
      rcases hg with ⟨a, rfl⟩
      rcases hh with ⟨b, rfl⟩
      refine ⟨a + b, ?_⟩
      change (f ≫ a.asHom) + (f ≫ b.asHom) =
        f ≫ (a.asHom + b.asHom)
      rw [Preadditive.comp_add]
  | smul c g _ hg =>
      rcases hg with ⟨a, rfl⟩
      refine ⟨c • a, ?_⟩
      change c • (f ≫ a.asHom) = f ≫ (c • a.asHom)
      rw [Linear.comp_smul]

private theorem endpointCoefficient_exists_comp_of_mem_span_of_allowsCotransit
    {X Y : C} {f g : X ⟶ Y} (ht : AllowsCotransit f)
    (hg : g ∈ twoSidedEndomorphismSpan k f) :
    ∃ a : End X, g = a.asHom ≫ f := by
  induction hg using Submodule.span_induction with
  | mem g hg =>
      rcases hg with ⟨a, b, rfl⟩
      obtain ⟨c, hc⟩ := ht b
      refine ⟨a.asHom ≫ c.asHom, ?_⟩
      change (a.asHom ≫ f) ≫ b.asHom =
        (a.asHom ≫ c.asHom) ≫ f
      rw [Category.assoc, hc]
      simp only [Category.assoc]
  | zero =>
      refine ⟨0, ?_⟩
      change (0 : X ⟶ Y) = (0 : X ⟶ X) ≫ f
      simp
  | add g h _ _ hg hh =>
      rcases hg with ⟨a, rfl⟩
      rcases hh with ⟨b, rfl⟩
      refine ⟨a + b, ?_⟩
      change (a.asHom ≫ f) + (b.asHom ≫ f) =
        (a.asHom + b.asHom) ≫ f
      rw [Preadditive.add_comp]
  | smul c g _ hg =>
      rcases hg with ⟨a, rfl⟩
      refine ⟨c • a, ?_⟩
      change c • (a.asHom ≫ f) = (c • a.asHom) ≫ f
      rw [Linear.smul_comp]

/-- Every element whose principal bimodule lies strictly below that of `f`
belongs to the endpoint-radical layer of `f`. -/
theorem mem_endpointRadicalSubmodule_of_span_lt
    [∀ T : C, IsLocalRing (End T)]
    [∀ T : C, IsArtinianRing (End T)]
    [HasBGRSDistributiveHomStructure k C]
    {X Y : C} {f g : X ⟶ Y}
    (hlt : twoSidedEndomorphismSpan k g <
      twoSidedEndomorphismSpan k f) :
    g ∈ endpointRadicalSubmodule (k := k) f := by
  have hgmem : g ∈ twoSidedEndomorphismSpan k f :=
    hlt.le (mem_twoSidedEndomorphismSpan k g)
  rcases HasBGRSDistributiveHomStructure.transit_or_cotransit
      (k := k) (C := C) f with ht | hc
  · obtain ⟨b, hgb⟩ :=
      endpointCoefficient_exists_comp_of_mem_span_of_allowsTransit ht hgmem
    have hbnu : ¬ IsUnit b := by
      intro hbu
      haveI : IsIso b.asHom := (isUnit_iff_isIso _).1 hbu
      have hre : UnitRayEquivalent f g :=
        ⟨Iso.refl X, asIso b.asHom, by simpa using hgb⟩
      apply hlt.ne
      exact (twoSidedEndomorphismSpan_eq_of_unitRayEquivalent k hre).symm
    have hbJ : b ∈ Ring.jacobson (End Y) :=
      (mem_ringJacobson_iff_not_isUnit (End Y) b).2 hbnu
    refine ⟨0, (Ring.jacobson (End X)).zero_mem,
      b, hbJ, ?_⟩
    change g = (0 : X ⟶ X) ≫ f + f ≫ b.asHom
    simpa using hgb
  · obtain ⟨a, hga⟩ :=
      endpointCoefficient_exists_comp_of_mem_span_of_allowsCotransit hc hgmem
    have hanu : ¬ IsUnit a := by
      intro hau
      haveI : IsIso a.asHom := (isUnit_iff_isIso _).1 hau
      have hre : UnitRayEquivalent f g :=
        ⟨asIso a.asHom, Iso.refl Y, by simpa using hga⟩
      apply hlt.ne
      exact (twoSidedEndomorphismSpan_eq_of_unitRayEquivalent k hre).symm
    have haJ : a ∈ Ring.jacobson (End X) :=
      (mem_ringJacobson_iff_not_isUnit (End X) a).2 hanu
    refine ⟨a, haJ, 0, (Ring.jacobson (End Y)).zero_mem, ?_⟩
    change g = a.asHom ≫ f + f ≫ (0 : Y ⟶ Y)
    simpa using hga

/-- Conversely, membership in the endpoint-radical layer of a nonzero
principal generator forces a strict principal-span drop. -/
theorem span_lt_of_mem_endpointRadicalSubmodule
    [∀ T : C, IsLocalRing (End T)]
    [∀ T : C, IsArtinianRing (End T)]
    [HasBGRSDistributiveHomStructure k C]
    {X Y : C} {f g : X ⟶ Y} (hf : f ≠ 0)
    (hg : g ∈ endpointRadicalSubmodule (k := k) f) :
    twoSidedEndomorphismSpan k g <
      twoSidedEndomorphismSpan k f := by
  rcases hg with ⟨a, ha, b, hb, hg⟩
  have hgmem : g ∈ twoSidedEndomorphismSpan k f := by
    rw [hg]
    exact (twoSidedEndomorphismSpan k f).add_mem
      ((isHomSubbimodule_twoSidedEndomorphismSpan f).1 a
        (mem_twoSidedEndomorphismSpan k f))
      ((isHomSubbimodule_twoSidedEndomorphismSpan f).2 b
        (mem_twoSidedEndomorphismSpan k f))
  have hle := twoSidedEndomorphismSpan_le_of_mem hgmem
  apply lt_of_le_of_ne hle
  intro heq
  have hreverse : twoSidedEndomorphismSpan k f ≤
      twoSidedEndomorphismSpan k g := by
    rw [heq]
  have hfmem := hreverse (mem_twoSidedEndomorphismSpan k f)
  apply not_mem_endpointRadicalSubmodule (k := k) f hf
  rcases HasBGRSDistributiveHomStructure.transit_or_cotransit
      (k := k) (C := C) g with hgT | hgC
  · obtain ⟨d, hd⟩ :=
      endpointCoefficient_exists_comp_of_mem_span_of_allowsTransit hgT hfmem
    rcases HasBGRSDistributiveHomStructure.transit_or_cotransit
        (k := k) (C := C) f with hfT | hfC
    · obtain ⟨c, hac⟩ := hfT a
      have hc : c ∈ Ring.jacobson (End Y) :=
        eq_zero_of_radical_transfer_right hf a c ha hac
      let e : End Y := d * c + d * b
      have he : e ∈ Ring.jacobson (End Y) :=
        (Ring.jacobson (End Y)).add_mem
          ((Ring.jacobson (End Y)).mul_mem_left d hc)
          ((Ring.jacobson (End Y)).mul_mem_left d hb)
      refine ⟨0, (Ring.jacobson (End X)).zero_mem, e, he, ?_⟩
      change f = (0 : X ⟶ X) ≫ f + f ≫ e.asHom
      simp
      calc
        f = g ≫ d.asHom := hd
        _ = (a.asHom ≫ f + f ≫ b.asHom) ≫ d.asHom := by rw [hg]
        _ = f ≫ e.asHom := by
          dsimp [e]
          change (a.asHom ≫ f + f ≫ b.asHom) ≫ d.asHom =
            f ≫ ((c.asHom ≫ d.asHom) + (b.asHom ≫ d.asHom))
          rw [Preadditive.add_comp, Preadditive.comp_add, hac]
          simp only [Category.assoc]
    · obtain ⟨c, hbc⟩ := hfC b
      have hc : c ∈ Ring.jacobson (End X) :=
        eq_zero_of_radical_transfer_left hf c b hb hbc.symm
      obtain ⟨e, hde⟩ := hfC d
      let z : End X := e * (a + c)
      have hz : z ∈ Ring.jacobson (End X) :=
        (Ring.jacobson (End X)).mul_mem_left e
          ((Ring.jacobson (End X)).add_mem ha hc)
      refine ⟨z, hz, 0, (Ring.jacobson (End Y)).zero_mem, ?_⟩
      change f = z.asHom ≫ f + f ≫ (0 : Y ⟶ Y)
      simp
      calc
        f = g ≫ d.asHom := hd
        _ = (a.asHom ≫ f + f ≫ b.asHom) ≫ d.asHom := by rw [hg]
        _ = z.asHom ≫ f := by
          dsimp [z]
          change (a.asHom ≫ f + f ≫ b.asHom) ≫ d.asHom =
            ((a.asHom + c.asHom) ≫ e.asHom) ≫ f
          rw [hbc]
          calc
            (a.asHom ≫ f + c.asHom ≫ f) ≫ d.asHom =
                ((a.asHom + c.asHom) ≫ f) ≫ d.asHom := by
              congr 1
              rw [Preadditive.add_comp]
            _ = (a.asHom + c.asHom) ≫ (f ≫ d.asHom) := by
              rw [Category.assoc]
            _ = (a.asHom + c.asHom) ≫ (e.asHom ≫ f) := by
              rw [hde]
            _ = ((a.asHom + c.asHom) ≫ e.asHom) ≫ f := by
              rw [Category.assoc]
  · obtain ⟨c, hc⟩ :=
      endpointCoefficient_exists_comp_of_mem_span_of_allowsCotransit hgC hfmem
    rcases HasBGRSDistributiveHomStructure.transit_or_cotransit
        (k := k) (C := C) f with hfT | hfC
    · obtain ⟨d, hcf⟩ := hfT c
      let z : End X := a * c
      let e : End Y := b * d
      have hz : z ∈ Ring.jacobson (End X) :=
        (Ring.jacobson (End X)).mul_mem_right c ha
      have he : e ∈ Ring.jacobson (End Y) :=
        (Ring.jacobson (End Y)).mul_mem_right d hb
      refine ⟨z, hz, e, he, ?_⟩
      calc
        f = c.asHom ≫ g := hc
        _ = c.asHom ≫ (a.asHom ≫ f + f ≫ b.asHom) := by rw [hg]
        _ = z.asHom ≫ f + f ≫ e.asHom := by
          dsimp [z, e]
          change c.asHom ≫ (a.asHom ≫ f + f ≫ b.asHom) =
            (c.asHom ≫ a.asHom) ≫ f +
              f ≫ (d.asHom ≫ b.asHom)
          calc
            c.asHom ≫ (a.asHom ≫ f + f ≫ b.asHom) =
                (c.asHom ≫ a.asHom) ≫ f +
                  (c.asHom ≫ f) ≫ b.asHom := by
              rw [Preadditive.comp_add]
              simp only [Category.assoc]
            _ = (c.asHom ≫ a.asHom) ≫ f +
                (f ≫ d.asHom) ≫ b.asHom := by rw [hcf]
            _ = (c.asHom ≫ a.asHom) ≫ f +
                f ≫ (d.asHom ≫ b.asHom) := by
              congr 1
              exact Category.assoc _ _ _
    · obtain ⟨d, hbf⟩ := hfC b
      have hd : d ∈ Ring.jacobson (End X) :=
        eq_zero_of_radical_transfer_left hf d b hb hbf.symm
      let z : End X := a * c + d * c
      have hz : z ∈ Ring.jacobson (End X) :=
        (Ring.jacobson (End X)).add_mem
          ((Ring.jacobson (End X)).mul_mem_right c ha)
          ((Ring.jacobson (End X)).mul_mem_right c hd)
      refine ⟨z, hz, 0, (Ring.jacobson (End Y)).zero_mem, ?_⟩
      change f = z.asHom ≫ f + f ≫ (0 : Y ⟶ Y)
      simp
      calc
        f = c.asHom ≫ g := hc
        _ = c.asHom ≫ (a.asHom ≫ f + f ≫ b.asHom) := by rw [hg]
        _ = z.asHom ≫ f := by
          dsimp [z]
          change c.asHom ≫ (a.asHom ≫ f + f ≫ b.asHom) =
            ((c.asHom ≫ a.asHom) + (c.asHom ≫ d.asHom)) ≫ f
          rw [Preadditive.comp_add, hbf, Preadditive.add_comp]
          simp only [Category.assoc]

/-- Endpoint-radical membership survives outer whiskering when the left
whisker admits cotransit and the right whisker admits transit. -/
theorem whisker_mem_endpointRadicalSubmodule
    [∀ T : C, IsLocalRing (End T)]
    [∀ T : C, IsArtinianRing (End T)]
    {X' X Y Y' : C} (p : X' ⟶ X) (f g : X ⟶ Y) (q : Y ⟶ Y')
    (hp0 : p ≠ 0) (hq0 : q ≠ 0)
    (hpC : AllowsCotransit p) (hqT : AllowsTransit q)
    (hg : g ∈ endpointRadicalSubmodule (k := k) f) :
    (p ≫ g) ≫ q ∈
      endpointRadicalSubmodule (k := k) ((p ≫ f) ≫ q) := by
  rcases hg with ⟨a, ha, b, hb, hg⟩
  obtain ⟨a', ha'⟩ := hpC a
  have ha'J : a' ∈ Ring.jacobson (End X') :=
    eq_zero_of_radical_transfer_left hp0 a' a ha ha'.symm
  obtain ⟨b', hb'⟩ := hqT b
  have hb'J : b' ∈ Ring.jacobson (End Y') :=
    eq_zero_of_radical_transfer_right hq0 b b' hb hb'
  have hleft : (p ≫ (a.asHom ≫ f)) ≫ q =
      a'.asHom ≫ ((p ≫ f) ≫ q) := by
    simpa only [Category.assoc] using
      congrArg (fun h ↦ (h ≫ f) ≫ q) ha'
  have hright : (p ≫ (f ≫ b.asHom)) ≫ q =
      ((p ≫ f) ≫ q) ≫ b'.asHom := by
    simpa only [Category.assoc] using
      congrArg (fun h ↦ (p ≫ f) ≫ h) hb'
  refine ⟨a', ha'J, b', hb'J, ?_⟩
  rw [hg, Preadditive.comp_add, Preadditive.add_comp, hleft, hright]


end LargeIndecomposable.ClosedZigzagTransfer
