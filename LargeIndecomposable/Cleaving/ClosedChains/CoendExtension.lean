module

public import LargeIndecomposable.Foundations.PathCategories.LinearPathLift
public import LargeIndecomposable.Cleaving.ClosedChains.CleavingTransfer
public import Mathlib.Algebra.Category.ModuleCat.Abelian
public import Mathlib.CategoryTheory.Linear.FunctorCategory
public import Mathlib.RingTheory.TensorProduct.Finite

@[expose] public section

set_option autoImplicit false
set_option linter.unusedSectionVars false
noncomputable section

open CategoryTheory
open CategoryTheory.Limits
open scoped TensorProduct

namespace LargeIndecomposable.ClosedZigzagTransfer

universe u v w x z

variable {k : Type u} [Field k]
variable {K : Type v} [Category.{w} K] [Preadditive K] [Linear k K]
variable {C : Type x} [Category.{w} C] [Preadditive C] [Linear k C]
variable (D : CategoryTheory.Functor K C) [D.Linear k]
variable (M : CategoryTheory.Functor K (ModuleCat.{max v w z} k)) [M.Linear k]

/-- The finite direct sum underlying the enriched coend formula for left
Kan extension.  We use a dependent product because the object type is finite. -/
abbrev coendRaw [Fintype K] (c : C) :=
  ∀ a : K, TensorProduct k (D.obj a ⟶ c) (M.obj a)

def coendSingle [Fintype K] {c : C} (a : K) :
    TensorProduct k (D.obj a ⟶ c) (M.obj a) →ₗ[k] coendRaw D M c :=
  by
    classical
    exact LinearMap.single k
      (fun b : K => TensorProduct k (D.obj b ⟶ c) (M.obj b)) a

/-- A generating coend relation
`(D f ≫ h) ⊗ m = h ⊗ M(f)m`. -/
def coendRelationSet [Fintype K] (c : C) : Set (coendRaw D M c) :=
  {r | ∃ (a b : K) (f : a ⟶ b) (h : D.obj b ⟶ c) (m : M.obj a),
    r = coendSingle D M a ((D.map f ≫ h) ⊗ₜ[k] m) -
      coendSingle D M b (h ⊗ₜ[k] M.map f m)}

/-- The submodule generated by the enriched coend relations. -/
def coendRelations [Fintype K] (c : C) : Submodule k (coendRaw D M c) :=
  Submodule.span k (coendRelationSet D M c)

/-- The objectwise enriched left-Kan-extension candidate. -/
abbrev coendObject [Fintype K] (c : C) :=
  coendRaw D M c ⧸ coendRelations D M c

instance coendObject_finite [Fintype K]
    [∀ (a : K) (c : C), Module.Finite k (D.obj a ⟶ c)]
    [∀ a : K, Module.Finite k (M.obj a)] (c : C) :
    Module.Finite k (coendObject D M c) := by
  letI : Module.Finite k (coendRaw D M c) := by infer_instance
  exact Module.Finite.quotient k (coendRelations D M c)

/-- Postcomposition on the representable factor of the coend. -/
def coendPostcomp {c c' : C} (g : c ⟶ c') (a : K) :
    (D.obj a ⟶ c) →ₗ[k] (D.obj a ⟶ c') :=
  CategoryTheory.Linear.rightComp k (D.obj a) g

omit [Preadditive K] [Linear k K] [D.Linear k] in
@[simp]
private theorem coendPostcomp_id (c : C) (a : K) :
    coendPostcomp (k := k) D (𝟙 c) a =
      (LinearMap.id : (D.obj a ⟶ c) →ₗ[k] (D.obj a ⟶ c)) := by
  ext h
  simp [coendPostcomp]

omit [Preadditive K] [Linear k K] [D.Linear k] in
@[simp]
private theorem coendPostcomp_comp {c c' c'' : C}
    (g : c ⟶ c') (g' : c' ⟶ c'') (a : K) :
    coendPostcomp (k := k) D (g ≫ g') a =
      (coendPostcomp (k := k) D g' a).comp
        (coendPostcomp (k := k) D g a) := by
  ext h
  simp [coendPostcomp, Category.assoc]

omit [Preadditive K] [Linear k K] [D.Linear k] in
@[simp]
private theorem coendPostcomp_add {c c' : C} (g g' : c ⟶ c') (a : K) :
    coendPostcomp (k := k) D (g + g') a =
      coendPostcomp (k := k) D g a +
        coendPostcomp (k := k) D g' a := by
  ext h
  simp [coendPostcomp]

omit [Preadditive K] [Linear k K] [D.Linear k] in
@[simp]
private theorem coendPostcomp_smul {c c' : C} (r : k) (g : c ⟶ c') (a : K) :
    coendPostcomp (k := k) D (r • g) a =
      r • coendPostcomp (k := k) D g a := by
  ext h
  simp [coendPostcomp]

/-- Objectwise postcomposition before quotienting by the coend relations. -/
def coendRawMap [Fintype K] {c c' : C} (g : c ⟶ c') :
    coendRaw D M c →ₗ[k] coendRaw D M c' where
  toFun x a := TensorProduct.map (coendPostcomp (k := k) D g a)
    (LinearMap.id : M.obj a →ₗ[k] M.obj a) (x a)
  map_add' x y := by
    ext a
    exact LinearMap.map_add _ _ _
  map_smul' r x := by
    ext a
    exact LinearMap.map_smul _ _ _

omit [Preadditive K] [Linear k K] [D.Linear k] [M.Linear k] in
@[simp]
private theorem coendRawMap_id [Fintype K] (c : C) :
    coendRawMap D M (𝟙 c) = LinearMap.id := by
  ext x a
  simp [coendRawMap]

omit [Preadditive K] [Linear k K] [D.Linear k] [M.Linear k] in
@[simp]
private theorem coendRawMap_comp [Fintype K] {c c' c'' : C}
    (g : c ⟶ c') (g' : c' ⟶ c'') :
    coendRawMap D M (g ≫ g') =
      (coendRawMap D M g').comp (coendRawMap D M g) := by
  ext x a
  simp [coendRawMap, TensorProduct.map_map]

omit [Preadditive K] [Linear k K] [D.Linear k] [M.Linear k] in
@[simp]
private theorem coendRawMap_add [Fintype K] {c c' : C} (g g' : c ⟶ c') :
    coendRawMap D M (g + g') = coendRawMap D M g + coendRawMap D M g' := by
  ext x a
  simp [coendRawMap, TensorProduct.map_add_left]

omit [Preadditive K] [Linear k K] [D.Linear k] [M.Linear k] in
@[simp]
private theorem coendRawMap_smul [Fintype K] {c c' : C} (r : k) (g : c ⟶ c') :
    coendRawMap D M (r • g) = r • coendRawMap D M g := by
  ext x a
  simp [coendRawMap, TensorProduct.map_smul_left]

omit [Preadditive K] [Linear k K] [D.Linear k] [M.Linear k] in
@[simp]
private theorem coendRawMap_single_tmul [Fintype K] {c c' : C}
    (g : c ⟶ c') (a : K) (h : D.obj a ⟶ c) (m : M.obj a) :
    coendRawMap D M g (coendSingle D M a (h ⊗ₜ[k] m)) =
      coendSingle D M a ((h ≫ g) ⊗ₜ[k] m) := by
  classical
  ext b
  by_cases hab : b = a
  · subst b
    simp [coendRawMap, coendSingle, coendPostcomp]
  · simp [coendRawMap, coendSingle, hab]

omit [Preadditive K] [Linear k K] [D.Linear k] [M.Linear k] in
/-- Postcomposition preserves the coend relation submodules. -/
theorem coendRawMap_relations [Fintype K] {c c' : C}
    (g : c ⟶ c') :
    coendRelations D M c ≤
      (coendRelations D M c').comap (coendRawMap D M g) := by
  rw [coendRelations, Submodule.span_le]
  rintro r ⟨a, b, f, h, m, rfl⟩
  change coendRawMap D M g
      (coendSingle D M a ((D.map f ≫ h) ⊗ₜ[k] m) -
        coendSingle D M b (h ⊗ₜ[k] M.map f m)) ∈
    coendRelations D M c'
  rw [LinearMap.map_sub, coendRawMap_single_tmul,
    coendRawMap_single_tmul]
  apply Submodule.subset_span
  refine ⟨a, b, f, h ≫ g, m, ?_⟩
  simp only [Category.assoc]

/-- The linear map on coend quotients induced by postcomposition. -/
def coendMap [Fintype K] {c c' : C} (g : c ⟶ c') :
    coendObject D M c →ₗ[k] coendObject D M c' :=
  Submodule.mapQ (coendRelations D M c) (coendRelations D M c')
    (coendRawMap D M g) (coendRawMap_relations D M g)

@[simp]
theorem coendMap_mkQ [Fintype K] {c c' : C} (g : c ⟶ c')
    (x : coendRaw D M c) :
    coendMap D M g ((coendRelations D M c).mkQ x) =
      (coendRelations D M c').mkQ (coendRawMap D M g x) :=
  rfl

@[simp]
private theorem coendMap_id [Fintype K] (c : C) :
    coendMap D M (𝟙 c) = LinearMap.id := by
  apply LinearMap.ext
  intro q
  obtain ⟨x, rfl⟩ := (coendRelations D M c).mkQ_surjective q
  change (coendRelations D M c).mkQ (coendRawMap D M (𝟙 c) x) =
    (coendRelations D M c).mkQ x
  rw [coendRawMap_id]
  rfl

@[simp]
private theorem coendMap_comp [Fintype K] {c c' c'' : C}
    (g : c ⟶ c') (g' : c' ⟶ c'') :
    coendMap D M (g ≫ g') = (coendMap D M g').comp (coendMap D M g) := by
  apply LinearMap.ext
  intro q
  obtain ⟨x, rfl⟩ := (coendRelations D M c).mkQ_surjective q
  change (coendRelations D M c'').mkQ (coendRawMap D M (g ≫ g') x) =
    (coendRelations D M c'').mkQ
      (coendRawMap D M g' (coendRawMap D M g x))
  rw [coendRawMap_comp]
  rfl

@[simp]
private theorem coendMap_add [Fintype K] {c c' : C} (g g' : c ⟶ c') :
    coendMap D M (g + g') = coendMap D M g + coendMap D M g' := by
  apply LinearMap.ext
  intro q
  obtain ⟨x, rfl⟩ := (coendRelations D M c).mkQ_surjective q
  change (coendRelations D M c').mkQ (coendRawMap D M (g + g') x) =
    (coendRelations D M c').mkQ (coendRawMap D M g x) +
      (coendRelations D M c').mkQ (coendRawMap D M g' x)
  rw [coendRawMap_add]
  change (coendRelations D M c').mkQ
      (coendRawMap D M g x + coendRawMap D M g' x) = _
  exact LinearMap.map_add _ _ _

@[simp]
private theorem coendMap_smul [Fintype K] {c c' : C} (r : k) (g : c ⟶ c') :
    coendMap D M (r • g) = r • coendMap D M g := by
  apply LinearMap.ext
  intro q
  obtain ⟨x, rfl⟩ := (coendRelations D M c).mkQ_surjective q
  change (coendRelations D M c').mkQ (coendRawMap D M (r • g) x) =
    r • (coendRelations D M c').mkQ (coendRawMap D M g x)
  rw [coendRawMap_smul]
  change (coendRelations D M c').mkQ (r • coendRawMap D M g x) = _
  exact LinearMap.map_smul _ _ _

/-- The objectwise finite enriched coend, functorial in the target object. -/
def coendExtension [Fintype K] :
    CategoryTheory.Functor C (ModuleCat.{max v w z} k) where
  obj c := ModuleCat.of k (coendObject D M c)
  map g := ModuleCat.ofHom (coendMap D M g)
  map_id c := by
    apply ModuleCat.hom_ext
    exact coendMap_id D M c
  map_comp g g' := by
    apply ModuleCat.hom_ext
    exact coendMap_comp D M g g'

instance coendExtension_additive [Fintype K] :
    (coendExtension D M).Additive where
  map_add {c c'} {g g'} := by
    apply ModuleCat.hom_ext
    exact coendMap_add D M g g'

instance coendExtension_linear [Fintype K] :
    (coendExtension D M).Linear k where
  map_smul {c c'} g r := by
    apply ModuleCat.hom_ext
    exact coendMap_smul D M r g

/-- The coend extension is pointwise finite-dimensional whenever the object
type, the relevant Hom spaces, and the values of the input functor are
finite. -/
instance coendExtension_obj_finite [Fintype K]
    [∀ (a : K) (c : C), Module.Finite k (D.obj a ⟶ c)]
    [∀ a : K, Module.Finite k (M.obj a)] (c : C) :
    Module.Finite k ((coendExtension D M).obj c) := by
  change Module.Finite k (coendObject D M c)
  infer_instance

/-- Insert a vector into the summand indexed by `a`, paired with the identity
of `D a`. -/
def coendUnitRaw [Fintype K] (a : K) :
    M.obj a →ₗ[k] coendRaw D M (D.obj a) :=
  (coendSingle D M a).comp
    ((TensorProduct.mk k (D.obj a ⟶ D.obj a) (M.obj a)) (𝟙 (D.obj a)))

/-- The component of the coend extension unit. -/
def coendUnitLinear [Fintype K] (a : K) :
    M.obj a →ₗ[k] coendObject D M (D.obj a) :=
  (coendRelations D M (D.obj a)).mkQ.comp (coendUnitRaw D M a)

omit [Preadditive K] [Linear k K] [D.Linear k] [M.Linear k] in
@[simp]
theorem coendUnitLinear_apply [Fintype K] (a : K) (m : M.obj a) :
    coendUnitLinear D M a m =
      (coendRelations D M (D.obj a)).mkQ
        (coendSingle D M a ((𝟙 (D.obj a)) ⊗ₜ[k] m)) :=
  rfl

/-- The canonical unit `M ⟶ D ⋙ extension` of the enriched coend
construction. -/
def coendUnit [Fintype K] :
    M ⟶ D ⋙ coendExtension D M where
  app a := ModuleCat.ofHom (coendUnitLinear D M a)
  naturality := by
    intro a b f
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro m
    change coendUnitLinear D M b (M.map f m) =
      coendMap D M (D.map f) (coendUnitLinear D M a m)
    rw [coendUnitLinear_apply, coendUnitLinear_apply, coendMap_mkQ,
      coendRawMap_single_tmul]
    symm
    apply (Submodule.Quotient.eq _).mpr
    apply Submodule.subset_span
    refine ⟨a, b, f, 𝟙 (D.obj b), m, ?_⟩
    simp

/-- Evaluation of one tensor summand using the Hom-bifunctor retraction and
the action of `M` on the retracted morphism. -/
def coendRetractTensor [D.Additive] [M.Additive]
    (hD : HomBifunctorRetraction (k := k) D) (a b : K) :
    TensorProduct k (D.obj b ⟶ D.obj a) (M.obj b) →ₗ[k] M.obj a :=
  TensorProduct.lift
    { toFun := fun g ↦ (M.map (hD.retraction b a g)).hom
      map_add' := by
        intro g g'
        rw [LinearMap.map_add, M.map_add]
        rfl
      map_smul' := by
        intro r g
        rw [LinearMap.map_smul, M.map_smul]
        rfl }

@[simp]
private theorem coendRetractTensor_tmul [D.Additive] [M.Additive]
    (hD : HomBifunctorRetraction (k := k) D) (a b : K)
    (g : D.obj b ⟶ D.obj a) (m : M.obj b) :
    coendRetractTensor D M hD a b (g ⊗ₜ[k] m) =
      M.map (hD.retraction b a g) m :=
  rfl

/-- Sum the retracted evaluations over all summands of the raw finite
coend. -/
def coendRawRetraction [Fintype K] [D.Additive] [M.Additive]
    (hD : HomBifunctorRetraction (k := k) D) (a : K) :
    coendRaw D M (D.obj a) →ₗ[k] M.obj a := by
  classical
  exact
    { toFun := fun x ↦ ∑ b, coendRetractTensor D M hD a b (x b)
      map_add' := by
        intro x y
        rw [← Finset.sum_add_distrib]
        apply Finset.sum_congr rfl
        intro b hb
        exact LinearMap.map_add _ _ _
      map_smul' := by
        intro r x
        rw [Finset.smul_sum]
        apply Finset.sum_congr rfl
        intro b hb
        exact LinearMap.map_smul (coendRetractTensor D M hD a b) r (x b) }

@[simp]
private theorem coendRawRetraction_single_tmul [Fintype K]
    [D.Additive] [M.Additive]
    (hD : HomBifunctorRetraction (k := k) D) (a b : K)
    (g : D.obj b ⟶ D.obj a) (m : M.obj b) :
    coendRawRetraction D M hD a
        (coendSingle D M b (g ⊗ₜ[k] m)) =
      M.map (hD.retraction b a g) m := by
  classical
  change ∑ b', coendRetractTensor D M hD a b'
      (coendSingle D M b (g ⊗ₜ[k] m) b') = _
  rw [Fintype.sum_eq_single b]
  · simp [coendSingle]
  · intro b' hb'
    simp [coendSingle, hb']

/-- The raw retraction kills every enriched coend relation. -/
theorem coendRelations_le_ker_rawRetraction [Fintype K]
    [D.Additive] [M.Additive]
    (hD : HomBifunctorRetraction (k := k) D) (a : K) :
    coendRelations D M (D.obj a) ≤
      LinearMap.ker (coendRawRetraction D M hD a) := by
  rw [coendRelations, Submodule.span_le]
  rintro r ⟨b, b', f, g, m, rfl⟩
  change coendRawRetraction D M hD a
    (coendSingle D M b ((D.map f ≫ g) ⊗ₜ[k] m) -
      coendSingle D M b' (g ⊗ₜ[k] M.map f m)) = 0
  rw [LinearMap.map_sub,
    coendRawRetraction_single_tmul, coendRawRetraction_single_tmul]
  have hnat := hD.naturality f g (𝟙 a)
  simp only [D.map_id, Category.comp_id] at hnat
  rw [hnat, M.map_comp]
  simp only [ModuleCat.hom_comp, LinearMap.coe_comp, Function.comp_apply,
    sub_self]

/-- The Hom-bifunctor retraction descends to each coend quotient over an
object in the image of `D`. -/
def coendRetractionLinear [Fintype K] [D.Additive] [M.Additive]
    (hD : HomBifunctorRetraction (k := k) D) (a : K) :
    coendObject D M (D.obj a) →ₗ[k] M.obj a :=
  (coendRelations D M (D.obj a)).liftQ
    (coendRawRetraction D M hD a)
    (coendRelations_le_ker_rawRetraction D M hD a)

@[simp]
theorem coendRetractionLinear_mkQ [Fintype K] [D.Additive] [M.Additive]
    (hD : HomBifunctorRetraction (k := k) D) (a : K)
    (x : coendRaw D M (D.obj a)) :
    coendRetractionLinear D M hD a
        ((coendRelations D M (D.obj a)).mkQ x) =
      coendRawRetraction D M hD a x :=
  rfl

/-- Retraction of one tensor commutes with a morphism in the target copy of
`K`. -/
private theorem coendRetractTensor_postcomp [D.Additive] [M.Additive]
    (hD : HomBifunctorRetraction (k := k) D) {a a' : K} (f : a ⟶ a')
    (b : K) (x : TensorProduct k (D.obj b ⟶ D.obj a) (M.obj b)) :
    coendRetractTensor D M hD a' b
        (TensorProduct.map (coendPostcomp (k := k) D (D.map f) b)
          (LinearMap.id : M.obj b →ₗ[k] M.obj b) x) =
      M.map f (coendRetractTensor D M hD a b x) := by
  induction x using TensorProduct.induction_on with
  | zero => simp
  | tmul g m =>
      change M.map (hD.retraction b a' (g ≫ D.map f)) m =
        M.map f (M.map (hD.retraction b a g) m)
      have hnat := hD.naturality (𝟙 b) g f
      simp only [D.map_id, Category.id_comp] at hnat
      rw [hnat, M.map_comp]
      simp only [ModuleCat.hom_comp, LinearMap.coe_comp, Function.comp_apply]
  | add x y hx hy =>
      simp only [LinearMap.map_add, hx, hy]

/-- Naturality of the raw retraction before passage to the quotient. -/
private theorem coendRawRetraction_naturality [Fintype K]
    [D.Additive] [M.Additive]
    (hD : HomBifunctorRetraction (k := k) D) {a a' : K} (f : a ⟶ a')
    (x : coendRaw D M (D.obj a)) :
    coendRawRetraction D M hD a'
        (coendRawMap D M (D.map f) x) =
      M.map f (coendRawRetraction D M hD a x) := by
  classical
  change (∑ b, coendRetractTensor D M hD a' b
      (TensorProduct.map (coendPostcomp (k := k) D (D.map f) b)
        (LinearMap.id : M.obj b →ₗ[k] M.obj b) (x b))) =
    M.map f (∑ b, coendRetractTensor D M hD a b (x b))
  rw [map_sum]
  apply Finset.sum_congr rfl
  intro b hb
  exact coendRetractTensor_postcomp D M hD f b (x b)

/-- The quotient retractions are natural in `K`. -/
def coendRetraction [Fintype K] [D.Additive] [M.Additive]
    (hD : HomBifunctorRetraction (k := k) D) :
    D ⋙ coendExtension D M ⟶ M where
  app a := ModuleCat.ofHom (coendRetractionLinear D M hD a)
  naturality := by
    intro a a' f
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro q
    obtain ⟨x, rfl⟩ :=
      (coendRelations D M (D.obj a)).mkQ_surjective q
    change coendRetractionLinear D M hD a'
        (coendMap D M (D.map f)
          ((coendRelations D M (D.obj a)).mkQ x)) =
      M.map f
        (coendRetractionLinear D M hD a
          ((coendRelations D M (D.obj a)).mkQ x))
    rw [coendMap_mkQ, coendRetractionLinear_mkQ,
      coendRetractionLinear_mkQ]
    exact coendRawRetraction_naturality D M hD f x

/-- On each object, the coend unit followed by the retraction is the
identity. -/
@[simp]
theorem coendRetractionLinear_unit [Fintype K] [D.Additive] [M.Additive]
    (hD : HomBifunctorRetraction (k := k) D) (a : K) (m : M.obj a) :
    coendRetractionLinear D M hD a (coendUnitLinear D M a m) = m := by
  rw [coendUnitLinear_apply, coendRetractionLinear_mkQ,
    coendRawRetraction_single_tmul]
  have hret := hD.map_retraction (𝟙 a)
  rw [D.map_id] at hret
  rw [hret, M.map_id]
  rfl

/-- The canonical extension unit is split by the natural coend
retraction. -/
theorem coendUnit_retraction [Fintype K] [D.Additive] [M.Additive]
    (hD : HomBifunctorRetraction (k := k) D) :
    coendUnit D M ≫ coendRetraction D M hD = 𝟙 M := by
  ext a m
  exact coendRetractionLinear_unit D M hD a m


end LargeIndecomposable.ClosedZigzagTransfer
