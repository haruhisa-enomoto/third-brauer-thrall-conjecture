theorem MildHyp.not_mi42a (hM : MildHyp k P) {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {OX0 OX1 OX2 OY0 OY1 OY2 OY3 OZ0 OZ1 : P}
    (c₁ : OX0 ⟶ OX1) (c₂ : OX1 ⟶ OX2) (μ₁ : OX0 ⟶ OY2) (μ₂ : OX1 ⟶ OY3) (a₁ : OY0 ⟶ OY1) (a₂ : OY1 ⟶ OY2) (a₃ : OY2 ⟶ OY3) (t₀ : OY0 ⟶ OZ0) (t₁ : OY1 ⟶ OZ1)
    (hD : ¬Statement.IsRepresentationFinite (Linearization (ThinCat thin) k))
    (hc0 : c₁ ≫ μ₂ = μ₁ ≫ a₃)
    (hz0 : a₁ ≫ t₁ = 0)
    (h0_X0_X1 : ¬FactorsThroughMorphism τ (c₁))
    (h0_X0_X2 : ¬FactorsThroughMorphism τ (c₁ ≫ c₂))
    (h0_X0_Y2 : ¬FactorsThroughMorphism τ (μ₁))
    (h0_X0_Y3 : ¬FactorsThroughMorphism τ (μ₁ ≫ a₃))
    (h0_X1_X2 : ¬FactorsThroughMorphism τ (c₂))
    (h0_X1_Y3 : ¬FactorsThroughMorphism τ (μ₂))
    (h0_Y0_Y1 : ¬FactorsThroughMorphism τ (a₁))
    (h0_Y0_Y2 : ¬FactorsThroughMorphism τ (a₁ ≫ a₂))
    (h0_Y0_Y3 : ¬FactorsThroughMorphism τ ((a₁ ≫ a₂) ≫ a₃))
    (h0_Y0_Z0 : ¬FactorsThroughMorphism τ (t₀))
    (h0_Y1_Y2 : ¬FactorsThroughMorphism τ (a₂))
    (h0_Y1_Y3 : ¬FactorsThroughMorphism τ (a₂ ≫ a₃))
    (h0_Y1_Z1 : ¬FactorsThroughMorphism τ (t₁))
    (h0_Y2_Y3 : ¬FactorsThroughMorphism τ (a₃))
    (hi_c₁ : ¬IsIso c₁)
    (hi_c₂ : ¬IsIso c₂)
    (hi_μ₁ : ¬IsIso μ₁)
    (hi_μ₂ : ¬IsIso μ₂)
    (hi_a₁ : ¬IsIso a₁)
    (hi_a₂ : ¬IsIso a₂)
    (hi_a₃ : ¬IsIso a₃)
    (hi_t₀ : ¬IsIso t₀)
    (hi_t₁ : ¬IsIso t₁)
    (hlft_X0_X1_Y2 : ¬∃ g, c₁ ≫ g = μ₁)
    (hlft_X0_Y2_X1 : ¬∃ g, μ₁ ≫ g = c₁)
    (hlft_X0_Y2_X2 : ¬∃ g, μ₁ ≫ g = c₁ ≫ c₂)
    (hlft_X1_X2_Y3 : ¬∃ g, c₂ ≫ g = μ₂)
    (hlft_X1_Y3_X2 : ¬∃ g, μ₂ ≫ g = c₂)
    (hlft_Y0_Y1_Z0 : ¬∃ g, a₁ ≫ g = t₀)
    (hlft_Y0_Z0_Y1 : ¬∃ g, t₀ ≫ g = a₁)
    (hlft_Y0_Z0_Y2 : ¬∃ g, t₀ ≫ g = a₁ ≫ a₂)
    (hlft_Y0_Z0_Y3 : ¬∃ g, t₀ ≫ g = (a₁ ≫ a₂) ≫ a₃)
    (hlft_Y1_Y2_Z1 : ¬∃ g, a₂ ≫ g = t₁)
    (hlft_Y1_Z1_Y2 : ¬∃ g, t₁ ≫ g = a₂)
    (hlft_Y1_Z1_Y3 : ¬∃ g, t₁ ≫ g = a₂ ≫ a₃)
    (hrgt_Y0_X0_Y2 : ¬∃ g, g ≫ μ₁ = a₁ ≫ a₂)
    (hrgt_Y1_X0_Y2 : ¬∃ g, g ≫ μ₁ = a₂)
    (hrgt_Y0_X1_Y3 : ¬∃ g, g ≫ μ₂ = (a₁ ≫ a₂) ≫ a₃)
    (hrgt_Y1_X1_Y3 : ¬∃ g, g ≫ μ₂ = a₂ ≫ a₃)
    (hrgt_Y2_X1_Y3 : ¬∃ g, g ≫ μ₂ = a₃)
    (hrgt_X0_Y1_Y2 : ¬∃ g, g ≫ a₂ = μ₁)
    (hrgt_X1_Y2_Y3 : ¬∃ g, g ≫ a₃ = μ₂)
    : False := by
  have hlft_X0_X1_X0 : ¬∃ g, c₁ ≫ g = 𝟙 _ := not_split_mono hi_c₁
  have hlft_X0_Y2_X0 : ¬∃ g, μ₁ ≫ g = 𝟙 _ := not_split_mono hi_μ₁
  have hlft_X1_X2_X1 : ¬∃ g, c₂ ≫ g = 𝟙 _ := not_split_mono hi_c₂
  have hlft_X1_Y3_X1 : ¬∃ g, μ₂ ≫ g = 𝟙 _ := not_split_mono hi_μ₂
  have hlft_Y0_Y1_Y0 : ¬∃ g, a₁ ≫ g = 𝟙 _ := not_split_mono hi_a₁
  have hlft_Y0_Z0_Y0 : ¬∃ g, t₀ ≫ g = 𝟙 _ := not_split_mono hi_t₀
  have hlft_Y1_Y2_Y1 : ¬∃ g, a₂ ≫ g = 𝟙 _ := not_split_mono hi_a₂
  have hlft_Y1_Z1_Y1 : ¬∃ g, t₁ ≫ g = 𝟙 _ := not_split_mono hi_t₁
  have hlft_Y2_Y3_Y2 : ¬∃ g, a₃ ≫ g = 𝟙 _ := not_split_mono hi_a₃
  have hrgt_X1_X0_X1 : ¬∃ g, g ≫ c₁ = 𝟙 _ := not_split_epi hi_c₁
  have hrgt_Y2_X0_Y2 : ¬∃ g, g ≫ μ₁ = 𝟙 _ := not_split_epi hi_μ₁
  have hrgt_X2_X1_X2 : ¬∃ g, g ≫ c₂ = 𝟙 _ := not_split_epi hi_c₂
  have hrgt_Y3_X1_Y3 : ¬∃ g, g ≫ μ₂ = 𝟙 _ := not_split_epi hi_μ₂
  have hrgt_Y1_Y0_Y1 : ¬∃ g, g ≫ a₁ = 𝟙 _ := not_split_epi hi_a₁
  have hrgt_Z0_Y0_Z0 : ¬∃ g, g ≫ t₀ = 𝟙 _ := not_split_epi hi_t₀
  have hrgt_Y2_Y1_Y2 : ¬∃ g, g ≫ a₂ = 𝟙 _ := not_split_epi hi_a₂
  have hrgt_Z1_Y1_Z1 : ¬∃ g, g ≫ t₁ = 𝟙 _ := not_split_epi hi_t₁
  have hrgt_Y3_Y2_Y3 : ¬∃ g, g ≫ a₃ = 𝟙 _ := not_split_epi hi_a₃
  have hc0' := reassoc_of% hc0
  have hz0' := reassoc_of% hz0
  refine hM.not_thin_diagram τ hτ hτ0 hD arrows obj (fun x y _ ↦ tab c₁ c₂ μ₁ μ₂ a₁ a₂ a₃ t₀ t₁ x y)
    (fun x ↦ by cases x <;> rfl) ?_ ?_ ?_ ?_
  · intro x y z h h'
    cases x <;> cases y <;> (try exact absurd h (by decide)) <;> cases z <;>
      (try exact absurd h' (by decide)) <;> split_ifs with hn <;>
      (try exact absurd hn (by decide)) <;>
      simp only [tab, Category.assoc, Category.id_comp, Category.comp_id, zero_comp, comp_zero, hc0', hc0, hz0', hz0]
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | exact not_factorsThrough_id hτ _
      | assumption
  · intro x z y ha hy
    cases x <;> cases z <;> (try exact absurd ha (by decide)) <;> cases y <;>
      (try exact absurd hy (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›
  · intro x z y ha hx
    cases z <;> cases y <;> (try exact absurd ha (by decide)) <;> cases x <;>
      (try exact absurd hx (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›

