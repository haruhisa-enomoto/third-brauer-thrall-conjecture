variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type*} [Field k] [Infinite k]

set_option maxHeartbeats 16000000 in
open MB85 in
/-- **No cleaving diagram `MB85` in `P/τ`.** -/
theorem MildHyp.not_mb85 (hM : MildHyp k P) {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {OAa OCc OXx OBp OBb OYy ODd OAp : P}
    (η₁ : OAa ⟶ OCc) (η₂ : OCc ⟶ OXx) (δ : OXx ⟶ OBp) (β : OBb ⟶ OYy) (ω₁ : OYy ⟶ ODd) (ω₂ : ODd ⟶ OAp) (α : OAa ⟶ OYy) (ξ : OCc ⟶ ODd) (γ : OXx ⟶ OAp)
    (hD : ¬Statement.IsRepresentationFinite (Linearization (ThinCat thin) k))
    (hc0 : η₁ ≫ η₂ ≫ γ = α ≫ ω₁ ≫ ω₂)
    (hc1 : η₁ ≫ ξ ≫ ω₂ = α ≫ ω₁ ≫ ω₂)
    (hc2 : η₁ ≫ ξ = α ≫ ω₁)
    (hc3 : η₂ ≫ γ = ξ ≫ ω₂)
    (h0_Aa_Ap : ¬FactorsThroughMorphism τ ((α ≫ ω₁) ≫ ω₂))
    (h0_Aa_Bp : ¬FactorsThroughMorphism τ ((η₁ ≫ η₂) ≫ δ))
    (h0_Aa_Cc : ¬FactorsThroughMorphism τ (η₁))
    (h0_Aa_Dd : ¬FactorsThroughMorphism τ (α ≫ ω₁))
    (h0_Aa_Xx : ¬FactorsThroughMorphism τ (η₁ ≫ η₂))
    (h0_Aa_Yy : ¬FactorsThroughMorphism τ (α))
    (h0_Bb_Ap : ¬FactorsThroughMorphism τ ((β ≫ ω₁) ≫ ω₂))
    (h0_Bb_Dd : ¬FactorsThroughMorphism τ (β ≫ ω₁))
    (h0_Bb_Yy : ¬FactorsThroughMorphism τ (β))
    (h0_Cc_Ap : ¬FactorsThroughMorphism τ (ξ ≫ ω₂))
    (h0_Cc_Bp : ¬FactorsThroughMorphism τ (η₂ ≫ δ))
    (h0_Cc_Dd : ¬FactorsThroughMorphism τ (ξ))
    (h0_Cc_Xx : ¬FactorsThroughMorphism τ (η₂))
    (h0_Dd_Ap : ¬FactorsThroughMorphism τ (ω₂))
    (h0_Xx_Ap : ¬FactorsThroughMorphism τ (γ))
    (h0_Xx_Bp : ¬FactorsThroughMorphism τ (δ))
    (h0_Yy_Ap : ¬FactorsThroughMorphism τ (ω₁ ≫ ω₂))
    (h0_Yy_Dd : ¬FactorsThroughMorphism τ (ω₁))
    (hi_η₁ : ¬IsIso η₁)
    (hi_η₂ : ¬IsIso η₂)
    (hi_δ : ¬IsIso δ)
    (hi_β : ¬IsIso β)
    (hi_ω₁ : ¬IsIso ω₁)
    (hi_ω₂ : ¬IsIso ω₂)
    (hi_α : ¬IsIso α)
    (hi_ξ : ¬IsIso ξ)
    (hi_γ : ¬IsIso γ)
    (hlft_Aa_Cc_Yy : ¬∃ g, η₁ ≫ g = α)
    (hlft_Aa_Yy_Cc : ¬∃ g, α ≫ g = η₁)
    (hlft_Aa_Yy_Xx : ¬∃ g, α ≫ g = η₁ ≫ η₂)
    (hlft_Aa_Yy_Bp : ¬∃ g, α ≫ g = (η₁ ≫ η₂) ≫ δ)
    (hlft_Cc_Dd_Xx : ¬∃ g, ξ ≫ g = η₂)
    (hlft_Cc_Dd_Bp : ¬∃ g, ξ ≫ g = η₂ ≫ δ)
    (hlft_Cc_Xx_Dd : ¬∃ g, η₂ ≫ g = ξ)
    (hlft_Xx_Ap_Bp : ¬∃ g, γ ≫ g = δ)
    (hlft_Xx_Bp_Ap : ¬∃ g, δ ≫ g = γ)
    (hrgt_Bb_Aa_Yy : ¬∃ g, g ≫ α = β)
    (hrgt_Aa_Bb_Yy : ¬∃ g, g ≫ β = α)
    (hrgt_Bb_Cc_Dd : ¬∃ g, g ≫ ξ = β ≫ ω₁)
    (hrgt_Yy_Cc_Dd : ¬∃ g, g ≫ ξ = ω₁)
    (hrgt_Xx_Dd_Ap : ¬∃ g, g ≫ ω₂ = γ)
    (hrgt_Bb_Xx_Ap : ¬∃ g, g ≫ γ = (β ≫ ω₁) ≫ ω₂)
    (hrgt_Yy_Xx_Ap : ¬∃ g, g ≫ γ = ω₁ ≫ ω₂)
    (hrgt_Dd_Xx_Ap : ¬∃ g, g ≫ γ = ω₂)
    (hrgt_Cc_Yy_Dd : ¬∃ g, g ≫ ω₁ = ξ)
    : False := by
  have hlft_Aa_Cc_Aa : ¬∃ g, η₁ ≫ g = 𝟙 _ := not_split_mono hi_η₁
  have hlft_Aa_Yy_Aa : ¬∃ g, α ≫ g = 𝟙 _ := not_split_mono hi_α
  have hlft_Bb_Yy_Bb : ¬∃ g, β ≫ g = 𝟙 _ := not_split_mono hi_β
  have hlft_Cc_Dd_Cc : ¬∃ g, ξ ≫ g = 𝟙 _ := not_split_mono hi_ξ
  have hlft_Cc_Xx_Cc : ¬∃ g, η₂ ≫ g = 𝟙 _ := not_split_mono hi_η₂
  have hlft_Dd_Ap_Dd : ¬∃ g, ω₂ ≫ g = 𝟙 _ := not_split_mono hi_ω₂
  have hlft_Xx_Ap_Xx : ¬∃ g, γ ≫ g = 𝟙 _ := not_split_mono hi_γ
  have hlft_Xx_Bp_Xx : ¬∃ g, δ ≫ g = 𝟙 _ := not_split_mono hi_δ
  have hlft_Yy_Dd_Yy : ¬∃ g, ω₁ ≫ g = 𝟙 _ := not_split_mono hi_ω₁
  have hrgt_Cc_Aa_Cc : ¬∃ g, g ≫ η₁ = 𝟙 _ := not_split_epi hi_η₁
  have hrgt_Yy_Aa_Yy : ¬∃ g, g ≫ α = 𝟙 _ := not_split_epi hi_α
  have hrgt_Yy_Bb_Yy : ¬∃ g, g ≫ β = 𝟙 _ := not_split_epi hi_β
  have hrgt_Dd_Cc_Dd : ¬∃ g, g ≫ ξ = 𝟙 _ := not_split_epi hi_ξ
  have hrgt_Xx_Cc_Xx : ¬∃ g, g ≫ η₂ = 𝟙 _ := not_split_epi hi_η₂
  have hrgt_Ap_Dd_Ap : ¬∃ g, g ≫ ω₂ = 𝟙 _ := not_split_epi hi_ω₂
  have hrgt_Ap_Xx_Ap : ¬∃ g, g ≫ γ = 𝟙 _ := not_split_epi hi_γ
  have hrgt_Bp_Xx_Bp : ¬∃ g, g ≫ δ = 𝟙 _ := not_split_epi hi_δ
  have hrgt_Dd_Yy_Dd : ¬∃ g, g ≫ ω₁ = 𝟙 _ := not_split_epi hi_ω₁
  have hc0' := reassoc_of% hc0
  have hc1' := reassoc_of% hc1
  have hc2' := reassoc_of% hc2
  have hc3' := reassoc_of% hc3
  refine hM.not_thin_diagram τ hτ hτ0 hD arrows obj (fun x y _ ↦ tab η₁ η₂ δ β ω₁ ω₂ α ξ γ x y)
    (fun x ↦ by cases x <;> rfl) ?_ ?_ ?_ ?_
  · intro x y z h h'
    cases x <;> cases y <;> (try exact absurd h (by decide)) <;> cases z <;>
      (try exact absurd h' (by decide)) <;> split_ifs with hn <;>
      (try exact absurd hn (by decide)) <;>
      simp only [tab, Category.assoc, Category.id_comp, Category.comp_id, zero_comp, comp_zero, hc0', hc0, hc1', hc1, hc2', hc2, hc3', hc3]
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | exact not_factorsThrough_id hτ _
      | assumption
  · intro x z y ha hy
    cases x <;> cases z <;> (try exact absurd ha (by decide)) <;> cases y <;>
      (try exact absurd hy (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›
  · intro x z y ha hx
    cases z <;> cases y <;> (try exact absurd ha (by decide)) <;> cases x <;>
      (try exact absurd hx (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›

end RayCat

