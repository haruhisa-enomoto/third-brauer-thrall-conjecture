namespace MB85

instance : Fintype MB85 := ⟨{Aa, Cc, Xx, Bp, Bb, Yy, Dd, Ap}, by intro v; cases v <;> simp⟩

/-- The order (nonzero morphisms). -/
def leb : MB85 → MB85 → Bool
  | Aa, Aa | Aa, Ap | Aa, Bp | Aa, Cc | Aa, Dd | Aa, Xx | Aa, Yy | Ap, Ap | Bb, Ap | Bb, Bb | Bb, Dd | Bb, Yy | Bp, Bp | Cc, Ap | Cc, Bp | Cc, Cc | Cc, Dd | Cc, Xx | Dd, Ap | Dd, Dd | Xx, Ap | Xx, Bp | Xx, Xx | Yy, Ap | Yy, Dd | Yy, Yy => true
  | _, _ => false

/-- The arrows. -/
def arb : MB85 → MB85 → Bool
  | Aa, Cc | Aa, Yy | Bb, Yy | Cc, Dd | Cc, Xx | Dd, Ap | Xx, Ap | Xx, Bp | Yy, Dd => true
  | _, _ => false

/-- The thin category. -/
abbrev thin : ThinData MB85 where
  le x y := leb x y = true
  nz x _ z := leb x z = true
  refl x := by cases x <;> rfl
  antisymm := by decide
  nz_le _ _ _ _ _ h := h
  nz_left _ _ h := h
  nz_right _ _ h := h
  assoc := by decide

/-- The generating arrows. -/
abbrev arrows : ThinArrows thin where
  ar x y := arb x y = true
  ar_le := by decide
  ar_ne := by decide
  first := by decide
  last := by decide

