module

public import LargeIndecomposable.Cleaving.Shapes.ShapeD6
public import LargeIndecomposable.Cleaving.Basic.Tools

/-!
# The tree diagram `MD4`

[mild] figure 2.1 (third diagram): the `D̃₄` star `x → z`, `z → y`, `z → z'`, `z → t`.

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `MD4`. -/
inductive MD4
  | z | x | y | zb | t
  deriving DecidableEq

namespace MD4

instance : Fintype MD4 := ⟨{z, x, y, zb, t}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : MD4 → MD4 → Bool
  | x, z | z, y | z, zb | z, t => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : MD4) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph MD4 := SimpleGraph.fromRel o

lemma adj_iff (u v : MD4) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : MD4) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : MD4) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : MD4) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : MD4 → Option MD4
  | z => none
  | x => some z
  | y => some z
  | zb => some z
  | t => some z

/-- The height. -/
def ht : MD4 → ℕ
  | z => 0
  | x => 1
  | y => 1
  | zb => 1
  | t => 1

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `D̃`. -/
def cmap : AffineD 0 → MD4
  | .spine j => z
  | .leaf i => if (i : ℕ) = 0 then x else if (i : ℕ) = 1 then y else if (i : ℕ) = 2 then zb else t

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `D̃`. -/
def copy : (underlyingGraph (AffineD 0)).Copy G :=
  copyD G 0 cmap (by
    intro u v h
    rcases u with i | j <;> rcases v with i' | j'
    · fin_cases i <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases i <;> fin_cases j' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases j' <;> simp_all [cmap])
    (fun i ↦ by
      fin_cases i
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide)
    (fun j j' h ↦ by fin_cases j <;> fin_cases j' <;> simp_all [cmap] <;> decide)

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {Z X Y Zb T : P}
  (γ : X ⟶ Z) (α : Z ⟶ Y) (τ' : Z ⟶ Zb) (η : Z ⟶ T)

/-- The objects. -/
def obj : MD4 → P
  | z => Z | x => X | y => Y | zb => Zb | t => T

/-- The arrows. -/
def arr : ∀ u v : MD4, o u v → ((obj (Z := Z) (X := X) (Y := Y) (Zb := Zb) (T := T) u) ⟶ obj (Z := Z) (X := X) (Y := Y) (Zb := Zb) (T := T) v)
  | x, z, _ => γ
  | z, y, _ => α
  | z, zb, _ => τ'
  | z, t, _ => η
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : MD4, Option ((obj (Z := Z) (X := X) (Y := Y) (Zb := Zb) (T := T) u) ⟶ obj (Z := Z) (X := X) (Y := Y) (Zb := Zb) (T := T) v)
  | z, z => some (𝟙 _)
  | z, y => some (α)
  | z, zb => some (τ')
  | z, t => some (η)
  | x, x => some (𝟙 _)
  | x, z => some (γ)
  | x, y => some (γ ≫ α)
  | x, zb => some (γ ≫ τ')
  | x, t => some (γ ≫ η)
  | y, y => some (𝟙 _)
  | zb, zb => some (𝟙 _)
  | t, t => some (𝟙 _)
  | _, _ => none

end Diagram

end MD4

end RayCat

namespace RayCat

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type u} [Field k] [Infinite k]

set_option maxHeartbeats 8000000 in
open MD4 in
/-- **No cleaving diagram `MD4` in `P/τ`.** -/
theorem MildHyp.not_md4 (hM : MildHyp k P)
    {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {Z X Y Zb T : P}
    (γ : X ⟶ Z) (α : Z ⟶ Y) (τ' : Z ⟶ Zb) (η : Z ⟶ T)
    (h0_z_y : ¬FactorsThroughMorphism τ (α))
    (h0_z_zb : ¬FactorsThroughMorphism τ (τ'))
    (h0_z_t : ¬FactorsThroughMorphism τ (η))
    (h0_x_z : ¬FactorsThroughMorphism τ (γ))
    (h0_x_y : ¬FactorsThroughMorphism τ (γ ≫ α))
    (h0_x_zb : ¬FactorsThroughMorphism τ (γ ≫ τ'))
    (h0_x_t : ¬FactorsThroughMorphism τ (γ ≫ η))
    (hi_γ : ¬IsIso γ)
    (hi_α : ¬IsIso α)
    (hi_τ' : ¬IsIso τ')
    (hi_η : ¬IsIso η)
    (hl_α_τ'_zb : ¬∃ g, α ≫ g = τ')
    (hl_α_η_t : ¬∃ g, α ≫ g = η)
    (hl_τ'_α_y : ¬∃ g, τ' ≫ g = α)
    (hl_τ'_η_t : ¬∃ g, τ' ≫ g = η)
    (hl_η_α_y : ¬∃ g, η ≫ g = α)
    (hl_η_τ'_zb : ¬∃ g, η ≫ g = τ')
    : False := by
  haveI : Fact (LargeIndecomposable.Foundations.Quiver.IsAcyclic (OT G o)) := ⟨OT.isAcyclic ho hasym isAcyclic⟩
  refine hM.not_tree_table τ hτ hτ0 G o ho hasym isAcyclic
    (OT.not_isRepresentationFinite_affineD ho hcov k 0 copy) obj (arr γ α τ' η)
    (tab γ α τ' η) (fun v ↦ by cases v <;> rfl) ?_ ?_ ?_ ?_ ?_
  · intro x y z h f hf
    cases y <;> cases z <;> (try exact absurd h (by decide)) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; rfl)
      | rfl
  · intro x y f hf hne
    cases x <;> cases y <;> (try exact absurd rfl hne) <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;> assumption
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | assumption
  · intro x c c' y h h' f hne hf
    cases x <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases y <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.comp_id]; assumption)
      | assumption
  · intro x c c' y h h' f hne hf
    cases y <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; assumption)
      | assumption

end RayCat

end LargeIndecomposable
