namespace RayCat

/-- Vertices of the diagram `F84`. -/
inductive F84
  | xn | tφ | B | x | a | x₂ | x₃ | y₁ | z₂
  deriving DecidableEq

namespace F84

instance : Fintype F84 := ⟨{xn, tφ, B, x, a, x₂, x₃, y₁, z₂}, by intro v; cases v <;> simp⟩

/-- The order (nonzero morphisms). -/
def leb : F84 → F84 → Bool
  | B, B | a, a | a, y₁ | a, z₂ | tφ, tφ | x, B | x, a | x, x | x, y₁ | xn, B | xn, tφ | xn, xn | x₂, a | x₂, x₂ | x₂, y₁ | x₂, z₂ | x₃, a | x₃, x₃ | x₃, z₂ | y₁, y₁ | z₂, z₂ => true
  | _, _ => false

/-- The arrows. -/
def arb : F84 → F84 → Bool
  | a, y₁ | a, z₂ | x, B | x, a | xn, B | xn, tφ | x₂, a | x₃, a => true
  | _, _ => false

/-- The thin category. -/
abbrev thin : ThinData F84 where
  le x y := leb x y = true
  nz x _ z := leb x z = true
  refl x := by cases x <;> rfl
  antisymm := by decide
  nz_le _ _ _ _ _ h := h
  nz_left _ _ h := h
  nz_right _ _ h := h
  assoc := by decide

/-- The generating arrows. -/
abbrev arrows : ThinArrows thin where
  ar x y := arb x y = true
  ar_le := by decide
  ar_ne := by decide
  first := by decide
  last := by decide

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {Xn Tφ Bb X Aa X₂ X₃ Y₁ Z₂ : P}
  (φ : Xn ⟶ Tφ) (r : Xn ⟶ Bb) (W₁ : X ⟶ Bb) (V₁ : X ⟶ Aa) (σ₂' : X₂ ⟶ Aa) (σ₃' : X₃ ⟶ Aa) (ρ₁' : Aa ⟶ Y₁) (ρ₂' : Aa ⟶ Z₂)

/-- The objects. -/
abbrev obj : F84 → P
  | xn => Xn | tφ => Tφ | B => Bb | x => X | a => Aa | x₂ => X₂ | x₃ => X₃ | y₁ => Y₁ | z₂ => Z₂

/-- The morphisms. -/
abbrev tab : ∀ u v : F84, (obj (Xn := Xn) (Tφ := Tφ) (Bb := Bb) (X := X) (Aa := Aa) (X₂ := X₂) (X₃ := X₃) (Y₁ := Y₁) (Z₂ := Z₂) u) ⟶ obj (Xn := Xn) (Tφ := Tφ) (Bb := Bb) (X := X) (Aa := Aa) (X₂ := X₂) (X₃ := X₃) (Y₁ := Y₁) (Z₂ := Z₂) v
  | B, B => 𝟙 _
  | a, a => 𝟙 _
  | a, y₁ => ρ₁'
  | a, z₂ => ρ₂'
  | tφ, tφ => 𝟙 _
  | x, B => W₁
  | x, a => V₁
  | x, x => 𝟙 _
  | x, y₁ => V₁ ≫ ρ₁'
  | xn, B => r
  | xn, tφ => φ
  | xn, xn => 𝟙 _
  | x₂, a => σ₂'
  | x₂, x₂ => 𝟙 _
  | x₂, y₁ => σ₂' ≫ ρ₁'
  | x₂, z₂ => σ₂' ≫ ρ₂'
  | x₃, a => σ₃'
  | x₃, x₃ => 𝟙 _
  | x₃, z₂ => σ₃' ≫ ρ₂'
  | y₁, y₁ => 𝟙 _
  | z₂, z₂ => 𝟙 _
  | _, _ => 0

end Diagram

