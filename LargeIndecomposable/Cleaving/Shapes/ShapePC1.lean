module

public import LargeIndecomposable.Cleaving.Shapes.ShapeD6
public import LargeIndecomposable.Cleaving.Diagrams.Tools

/-!
# The tree diagram `PC1`

Open penny-farthing (`n = 2`): `D̃₅` with spine `x₁ ← t`, two exits `γ, γ'` at `t` and `α²` through `x₁`.

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `PC1`. -/
inductive PC1
  | X1 | T0 | X0 | X2 | C0 | D0
  deriving DecidableEq

namespace PC1

instance : Fintype PC1 := ⟨{X1, T0, X0, X2, C0, D0}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : PC1 → PC1 → Bool
  | X0, X1 | X1, X2 | T0, X1 | T0, C0 | T0, D0 => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : PC1) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph PC1 := SimpleGraph.fromRel o

lemma adj_iff (u v : PC1) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : PC1) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : PC1) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : PC1) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : PC1 → Option PC1
  | X1 => none
  | T0 => some X1
  | X0 => some X1
  | X2 => some X1
  | C0 => some T0
  | D0 => some T0

/-- The height. -/
def ht : PC1 → ℕ
  | X1 => 0
  | T0 => 1
  | X0 => 1
  | X2 => 1
  | C0 => 2
  | D0 => 2

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `D̃`. -/
def cmap : AffineD 1 → PC1
  | .spine j => if (j : ℕ) = 0 then X1 else T0
  | .leaf i => if (i : ℕ) = 0 then X0 else if (i : ℕ) = 1 then X2 else if (i : ℕ) = 2 then C0 else D0

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `D̃`. -/
def copy : (underlyingGraph (AffineD 1)).Copy G :=
  copyD G 1 cmap (by
    intro u v h
    rcases u with i | j <;> rcases v with i' | j'
    · fin_cases i <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases i <;> fin_cases j' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases j' <;> simp_all [cmap])
    (fun i ↦ by
      fin_cases i
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide)
    (fun j j' h ↦ by fin_cases j <;> fin_cases j' <;> simp_all [cmap] <;> decide)

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {OX1 OT0 OX0 OX2 OC0 OD0 : P}
  (α₁ : OX0 ⟶ OX1) (α₂ : OX1 ⟶ OX2) (b : OT0 ⟶ OX1) (γ : OT0 ⟶ OC0) (γ' : OT0 ⟶ OD0)

/-- The objects. -/
def obj : PC1 → P
  | X1 => OX1 | T0 => OT0 | X0 => OX0 | X2 => OX2 | C0 => OC0 | D0 => OD0

/-- The arrows. -/
def arr : ∀ u v : PC1, o u v → ((obj (OX1 := OX1) (OT0 := OT0) (OX0 := OX0) (OX2 := OX2) (OC0 := OC0) (OD0 := OD0) u) ⟶ obj (OX1 := OX1) (OT0 := OT0) (OX0 := OX0) (OX2 := OX2) (OC0 := OC0) (OD0 := OD0) v)
  | X0, X1, _ => α₁
  | X1, X2, _ => α₂
  | T0, X1, _ => b
  | T0, C0, _ => γ
  | T0, D0, _ => γ'
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : PC1, Option ((obj (OX1 := OX1) (OT0 := OT0) (OX0 := OX0) (OX2 := OX2) (OC0 := OC0) (OD0 := OD0) u) ⟶ obj (OX1 := OX1) (OT0 := OT0) (OX0 := OX0) (OX2 := OX2) (OC0 := OC0) (OD0 := OD0) v)
  | X1, X1 => some (𝟙 _)
  | X1, X2 => some (α₂)
  | T0, T0 => some (𝟙 _)
  | T0, X1 => some (b)
  | T0, X2 => some (b ≫ α₂)
  | T0, C0 => some (γ)
  | T0, D0 => some (γ')
  | X0, X0 => some (𝟙 _)
  | X0, X1 => some (α₁)
  | X0, X2 => some (α₁ ≫ α₂)
  | X2, X2 => some (𝟙 _)
  | C0, C0 => some (𝟙 _)
  | D0, D0 => some (𝟙 _)
  | _, _ => none

end Diagram

end PC1

end RayCat

namespace RayCat

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type u} [Field k] [Infinite k]

set_option maxHeartbeats 8000000 in
open PC1 in
/-- **No cleaving diagram `PC1` in `P/τ`.** -/
theorem MildHyp.not_pc1 (hM : MildHyp k P)
    {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {OX1 OT0 OX0 OX2 OC0 OD0 : P}
    (α₁ : OX0 ⟶ OX1) (α₂ : OX1 ⟶ OX2) (b : OT0 ⟶ OX1) (γ : OT0 ⟶ OC0) (γ' : OT0 ⟶ OD0)
    (h0_X1_X2 : ¬FactorsThroughMorphism τ (α₂))
    (h0_T0_X1 : ¬FactorsThroughMorphism τ (b))
    (h0_T0_X2 : ¬FactorsThroughMorphism τ (b ≫ α₂))
    (h0_T0_C0 : ¬FactorsThroughMorphism τ (γ))
    (h0_T0_D0 : ¬FactorsThroughMorphism τ (γ'))
    (h0_X0_X1 : ¬FactorsThroughMorphism τ (α₁))
    (h0_X0_X2 : ¬FactorsThroughMorphism τ (α₁ ≫ α₂))
    (hi_α₁ : ¬IsIso α₁)
    (hi_α₂ : ¬IsIso α₂)
    (hi_b : ¬IsIso b)
    (hi_γ : ¬IsIso γ)
    (hi_γ' : ¬IsIso γ')
    (hl_b_γ_C0 : ¬∃ g, b ≫ g = γ)
    (hl_b_γ'_D0 : ¬∃ g, b ≫ g = γ')
    (hl_γ_b_X1 : ¬∃ g, γ ≫ g = b)
    (hl_γ_b_X2 : ¬∃ g, γ ≫ g = b ≫ α₂)
    (hl_γ_γ'_D0 : ¬∃ g, γ ≫ g = γ')
    (hl_γ'_b_X1 : ¬∃ g, γ' ≫ g = b)
    (hl_γ'_b_X2 : ¬∃ g, γ' ≫ g = b ≫ α₂)
    (hl_γ'_γ_C0 : ¬∃ g, γ' ≫ g = γ)
    (hr_α₁_b_T0 : ¬∃ g, g ≫ α₁ = b)
    (hr_b_α₁_X0 : ¬∃ g, g ≫ b = α₁)
    : False := by
  haveI : Fact (LargeIndecomposable.Foundations.Quiver.IsAcyclic (OT G o)) := ⟨OT.isAcyclic ho hasym isAcyclic⟩
  refine hM.not_tree_table τ hτ hτ0 G o ho hasym isAcyclic
    (OT.not_isRepresentationFinite_affineD ho hcov k 1 copy) obj (arr α₁ α₂ b γ γ')
    (tab α₁ α₂ b γ γ') (fun v ↦ by cases v <;> rfl) ?_ ?_ ?_ ?_ ?_
  · intro x y z h f hf
    cases y <;> cases z <;> (try exact absurd h (by decide)) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; rfl)
      | rfl
  · intro x y f hf hne
    cases x <;> cases y <;> (try exact absurd rfl hne) <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;> assumption
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | assumption
  · intro x c c' y h h' f hne hf
    cases x <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases y <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.comp_id]; assumption)
      | assumption
  · intro x c c' y h h' f hne hf
    cases y <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; assumption)
      | assumption

end RayCat

end LargeIndecomposable
