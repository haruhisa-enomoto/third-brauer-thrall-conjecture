  | x₂, a, _ => σ₂'
  | x₂, z₂, _ => ρ₂
  | x₃, z₂, _ => σ₃
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : F81, Option ((obj (Aa := Aa) (Y₁ := Y₁) (X := X) (Bb := Bb) (Xn := Xn) (X₂ := X₂) (Z₂ := Z₂) (X₃ := X₃) u) ⟶ obj (Aa := Aa) (Y₁ := Y₁) (X := X) (Bb := Bb) (Xn := Xn) (X₂ := X₂) (Z₂ := Z₂) (X₃ := X₃) v)
  | a, a => some (𝟙 _)
  | a, y₁ => some (ρ₁')
  | y₁, y₁ => some (𝟙 _)
