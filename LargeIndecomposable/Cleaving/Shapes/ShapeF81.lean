namespace RayCat

/-- Vertices of the diagram `F81`. -/
inductive F81
  | a | y₁ | x | B | xn | x₂ | z₂ | x₃
  deriving DecidableEq

namespace F81

instance : Fintype F81 := ⟨{a, y₁, x, B, xn, x₂, z₂, x₃}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : F81 → F81 → Bool
  | xn, B | x, B | x, a | a, y₁ | x₂, a | x₂, z₂ | x₃, z₂ => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : F81) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph F81 := SimpleGraph.fromRel o

lemma adj_iff (u v : F81) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : F81) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : F81) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : F81) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : F81 → Option F81
  | a => none
  | y₁ => some a
  | x => some a
  | B => some x
  | xn => some B
  | x₂ => some a
  | z₂ => some x₂
  | x₃ => some z₂

/-- The height. -/
def ht : F81 → ℕ
  | a => 0
  | y₁ => 1
  | x => 1
  | B => 2
  | xn => 3
  | x₂ => 1
  | z₂ => 2
  | x₃ => 3

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `Ẽ₇` (long arms listed from the centre). -/
def cmap : AffineE7 → F81
  | .center => a
  | .short => y₁
  | .inner i => if (i : ℕ) = 0 then x else x₂
  | .middle i => if (i : ℕ) = 0 then B else z₂
  | .outer i => if (i : ℕ) = 0 then xn else x₃

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `Ẽ₇`. -/
def copy : (underlyingGraph AffineE7).Copy G :=
  copyOf G cmap (by
    intro u v h
    rcases u with _ | _ | i | i | i <;> rcases v with _ | _ | j | j | j <;>
      (try fin_cases i) <;> (try fin_cases j) <;> simp_all [cmap])
    (by
      intro a b e
      change AffineE7.Arrow a b at e
      cases e with
      | outerMiddle i => fin_cases i <;> simp only [cmap] <;> decide
      | middleInner i => fin_cases i <;> simp only [cmap] <;> decide
      | innerCenter i => fin_cases i <;> simp only [cmap] <;> decide
      | shortCenter => simp only [cmap]; decide)

section Diagram

