/-- The objects. -/
def obj : F81 → P
  | a => Aa | y₁ => Y₁ | x => X | B => Bb | xn => Xn | x₂ => X₂ | z₂ => Z₂ | x₃ => X₃

/-- The arrows. -/
def arr : ∀ u v : F81, o u v → ((obj (Aa := Aa) (Y₁ := Y₁) (X := X) (Bb := Bb) (Xn := Xn) (X₂ := X₂) (Z₂ := Z₂) (X₃ := X₃) u) ⟶ obj (Aa := Aa) (Y₁ := Y₁) (X := X) (Bb := Bb) (Xn := Xn) (X₂ := X₂) (Z₂ := Z₂) (X₃ := X₃) v)
  | xn, B, _ => r
  | x, B, _ => W₁
