noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `PC7`. -/
inductive PC7
  | X0 | X2 | T0 | C0 | C1
  deriving DecidableEq

namespace PC7

instance : Fintype PC7 := ⟨{X0, X2, T0, C0, C1}, by intro v; cases v <;> simp⟩

/-- The order (nonzero morphisms). -/
def leb : PC7 → PC7 → Bool
  | C0, C0 | C0, C1 | C1, C1 | T0, C0 | T0, C1 | T0, T0 | T0, X2 | X0, C1 | X0, X0 | X0, X2 | X2, X2 => true
  | _, _ => false

/-- The arrows. -/
def arb : PC7 → PC7 → Bool
  | C0, C1 | T0, C0 | T0, X2 | X0, C1 | X0, X2 => true
  | _, _ => false

/-- The thin category. -/
abbrev thin : ThinData PC7 where
  le x y := leb x y = true
  nz x _ z := leb x z = true
  refl x := by cases x <;> rfl
  antisymm := by decide
  nz_le _ _ _ _ _ h := h
  nz_left _ _ h := h
  nz_right _ _ h := h
  assoc := by decide

/-- The generating arrows. -/
abbrev arrows : ThinArrows thin where
  ar x y := arb x y = true
  ar_le := by decide
  ar_ne := by decide
  first := by decide
  last := by decide

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {OX0 OX2 OT0 OC0 OC1 : P}
  (s : OX0 ⟶ OX2) (u : OX0 ⟶ OC1) (f : OT0 ⟶ OX2) (γ : OT0 ⟶ OC0) (ℓ : OC0 ⟶ OC1)

/-- The objects. -/
abbrev obj : PC7 → P
  | X0 => OX0 | X2 => OX2 | T0 => OT0 | C0 => OC0 | C1 => OC1

/-- The morphisms. -/
abbrev tab : ∀ u v : PC7, (obj (OX0 := OX0) (OX2 := OX2) (OT0 := OT0) (OC0 := OC0) (OC1 := OC1) u) ⟶ obj (OX0 := OX0) (OX2 := OX2) (OT0 := OT0) (OC0 := OC0) (OC1 := OC1) v
  | C0, C0 => 𝟙 _
  | C0, C1 => ℓ
  | C1, C1 => 𝟙 _
  | T0, C0 => γ
  | T0, C1 => γ ≫ ℓ
  | T0, T0 => 𝟙 _
  | T0, X2 => f
  | X0, C1 => u
  | X0, X0 => 𝟙 _
  | X0, X2 => s
  | X2, X2 => 𝟙 _
  | _, _ => 0

end Diagram

