namespace RayCat

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type*} [Field k] [Infinite k]

set_option maxHeartbeats 16000000 in
open PC7 in
/-- **No cleaving diagram `PC7` in `P/τ`.** -/
theorem MildHyp.not_pc7 (hM : MildHyp k P) {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {OX0 OX2 OT0 OC0 OC1 : P}
    (s : OX0 ⟶ OX2) (u : OX0 ⟶ OC1) (f : OT0 ⟶ OX2) (γ : OT0 ⟶ OC0) (ℓ : OC0 ⟶ OC1)
    (hD : ¬Statement.IsRepresentationFinite (Linearization (ThinCat thin) k))
    (h0_C0_C1 : ¬FactorsThroughMorphism τ (ℓ))
    (h0_T0_C0 : ¬FactorsThroughMorphism τ (γ))
    (h0_T0_C1 : ¬FactorsThroughMorphism τ (γ ≫ ℓ))
    (h0_T0_X2 : ¬FactorsThroughMorphism τ (f))
    (h0_X0_C1 : ¬FactorsThroughMorphism τ (u))
    (h0_X0_X2 : ¬FactorsThroughMorphism τ (s))
    (hi_s : ¬IsIso s)
    (hi_u : ¬IsIso u)
    (hi_f : ¬IsIso f)
    (hi_γ : ¬IsIso γ)
    (hi_ℓ : ¬IsIso ℓ)
    (hlft_T0_C0_X2 : ¬∃ g, γ ≫ g = f)
    (hlft_T0_X2_C0 : ¬∃ g, f ≫ g = γ)
    (hlft_T0_X2_C1 : ¬∃ g, f ≫ g = γ ≫ ℓ)
    (hlft_X0_C1_X2 : ¬∃ g, u ≫ g = s)
    (hlft_X0_X2_C1 : ¬∃ g, s ≫ g = u)
    (hrgt_X0_C0_C1 : ¬∃ g, g ≫ ℓ = u)
    (hrgt_X0_T0_X2 : ¬∃ g, g ≫ f = s)
    (hrgt_T0_X0_C1 : ¬∃ g, g ≫ u = γ ≫ ℓ)
    (hrgt_C0_X0_C1 : ¬∃ g, g ≫ u = ℓ)
    (hrgt_T0_X0_X2 : ¬∃ g, g ≫ s = f)
    : False := by
  have hlft_C0_C1_C0 : ¬∃ g, ℓ ≫ g = 𝟙 _ := not_split_mono hi_ℓ
  have hlft_T0_C0_T0 : ¬∃ g, γ ≫ g = 𝟙 _ := not_split_mono hi_γ
  have hlft_T0_X2_T0 : ¬∃ g, f ≫ g = 𝟙 _ := not_split_mono hi_f
  have hlft_X0_C1_X0 : ¬∃ g, u ≫ g = 𝟙 _ := not_split_mono hi_u
  have hlft_X0_X2_X0 : ¬∃ g, s ≫ g = 𝟙 _ := not_split_mono hi_s
  have hrgt_C1_C0_C1 : ¬∃ g, g ≫ ℓ = 𝟙 _ := not_split_epi hi_ℓ
  have hrgt_C0_T0_C0 : ¬∃ g, g ≫ γ = 𝟙 _ := not_split_epi hi_γ
  have hrgt_X2_T0_X2 : ¬∃ g, g ≫ f = 𝟙 _ := not_split_epi hi_f
  have hrgt_C1_X0_C1 : ¬∃ g, g ≫ u = 𝟙 _ := not_split_epi hi_u
  have hrgt_X2_X0_X2 : ¬∃ g, g ≫ s = 𝟙 _ := not_split_epi hi_s
  refine hM.not_thin_diagram τ hτ hτ0 hD arrows obj (fun x y _ ↦ tab s u f γ ℓ x y)
    (fun x ↦ by cases x <;> rfl) ?_ ?_ ?_ ?_
  · intro x y z h h'
    cases x <;> cases y <;> (try exact absurd h (by decide)) <;> cases z <;>
      (try exact absurd h' (by decide)) <;> split_ifs with hn <;>
      (try exact absurd hn (by decide)) <;>
      simp only [tab, Category.assoc, Category.id_comp, Category.comp_id, zero_comp, comp_zero]
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | exact not_factorsThrough_id hτ _
      | assumption
  · intro x z y ha hy
    cases x <;> cases z <;> (try exact absurd ha (by decide)) <;> cases y <;>
      (try exact absurd hy (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›
  · intro x z y ha hx
    cases z <;> cases y <;> (try exact absurd ha (by decide)) <;> cases x <;>
      (try exact absurd hx (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›

end RayCat

