namespace RayCat

/-- Vertices of the diagram `F613`. -/
inductive F613
  | y₀ | x' | b | zn | m | y₁ | z₂
  deriving DecidableEq

namespace F613

instance : Fintype F613 := ⟨{y₀, x', b, zn, m, y₁, z₂}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : F613 → F613 → Bool
  | x', b | b, zn | b, y₀ | m, y₀ | m, y₁ | m, z₂ => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : F613) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph F613 := SimpleGraph.fromRel o

lemma adj_iff (u v : F613) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : F613) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : F613) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : F613) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : F613 → Option F613
  | y₀ => none
  | x' => some b
  | b => some y₀
  | zn => some b
  | m => some y₀
  | y₁ => some m
  | z₂ => some m

/-- The height. -/
def ht : F613 → ℕ
  | y₀ => 0
  | x' => 2
  | b => 1
  | zn => 2
  | m => 1
  | y₁ => 2
  | z₂ => 2

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `D̃`. -/
def cmap : AffineD 2 → F613
  | .spine j => if (j : ℕ) = 0 then b else if (j : ℕ) = 1 then y₀ else m
  | .leaf i => if (i : ℕ) = 0 then x' else if (i : ℕ) = 1 then zn else if (i : ℕ) = 2 then y₁ else z₂

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `D̃`. -/
def copy : (underlyingGraph (AffineD 2)).Copy G :=
  copyD G 2 cmap (by
    intro u v h
    rcases u with i | j <;> rcases v with i' | j'
    · fin_cases i <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases i <;> fin_cases j' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases j' <;> simp_all [cmap])
    (fun i ↦ by
      fin_cases i
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide)
    (fun j j' h ↦ by fin_cases j <;> fin_cases j' <;> simp_all [cmap] <;> decide)

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {Y₀ X' Bb Zn M Y₁ Z₂ : P}
  (r : X' ⟶ Bb) (s : Bb ⟶ Zn) (W : Bb ⟶ Y₀) (U : M ⟶ Y₀) (U' : M ⟶ Y₁) (q : M ⟶ Z₂)

/-- The objects. -/
def obj : F613 → P
  | y₀ => Y₀ | x' => X' | b => Bb | zn => Zn | m => M | y₁ => Y₁ | z₂ => Z₂

/-- The arrows. -/
def arr : ∀ u v : F613, o u v → ((obj (Y₀ := Y₀) (X' := X') (Bb := Bb) (Zn := Zn) (M := M) (Y₁ := Y₁) (Z₂ := Z₂) u) ⟶ obj (Y₀ := Y₀) (X' := X') (Bb := Bb) (Zn := Zn) (M := M) (Y₁ := Y₁) (Z₂ := Z₂) v)
  | x', b, _ => r
  | b, zn, _ => s
  | b, y₀, _ => W
  | m, y₀, _ => U
  | m, y₁, _ => U'
  | m, z₂, _ => q
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : F613, Option ((obj (Y₀ := Y₀) (X' := X') (Bb := Bb) (Zn := Zn) (M := M) (Y₁ := Y₁) (Z₂ := Z₂) u) ⟶ obj (Y₀ := Y₀) (X' := X') (Bb := Bb) (Zn := Zn) (M := M) (Y₁ := Y₁) (Z₂ := Z₂) v)
  | y₀, y₀ => some (𝟙 _)
  | x', x' => some (𝟙 _)
  | x', b => some (r)
  | x', zn => some (r ≫ s)
  | x', y₀ => some (r ≫ W)
  | b, b => some (𝟙 _)
  | b, zn => some (s)
  | b, y₀ => some (W)
  | zn, zn => some (𝟙 _)
  | m, m => some (𝟙 _)
  | m, y₀ => some (U)
  | m, y₁ => some (U')
  | m, z₂ => some (q)
  | y₁, y₁ => some (𝟙 _)
  | z₂, z₂ => some (𝟙 _)
  | _, _ => none

end Diagram

