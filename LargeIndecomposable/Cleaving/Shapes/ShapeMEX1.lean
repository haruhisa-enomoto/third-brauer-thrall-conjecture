variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type*} [Field k] [Infinite k]

set_option maxHeartbeats 16000000 in
open MEX1 in
/-- **No cleaving diagram `MEX1` in `P/τ`.** -/
theorem MildHyp.not_mex1 (hM : MildHyp k P) {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {OCc OXx OA OB OYy OY0 ODd OEe : P}
    (η₂ : OCc ⟶ OXx) (ω₁ : OY0 ⟶ ODd) (ω₂ : ODd ⟶ OA) (γ : OXx ⟶ OA) (δ : OXx ⟶ OB) (α : OA ⟶ OYy) (β : OB ⟶ OYy) (ω₃ : OYy ⟶ OEe)
    (hD : ¬Statement.IsRepresentationFinite (Linearization (ThinCat thin) k))
    (hc0 : η₂ ≫ δ ≫ β ≫ ω₃ = η₂ ≫ γ ≫ α ≫ ω₃)
    (hc1 : η₂ ≫ δ ≫ β = η₂ ≫ γ ≫ α)
    (hc2 : δ ≫ β ≫ ω₃ = γ ≫ α ≫ ω₃)
    (hc3 : δ ≫ β = γ ≫ α)
    (h0_A_Ee : ¬FactorsThroughMorphism τ (α ≫ ω₃))
    (h0_A_Yy : ¬FactorsThroughMorphism τ (α))
    (h0_B_Ee : ¬FactorsThroughMorphism τ (β ≫ ω₃))
    (h0_B_Yy : ¬FactorsThroughMorphism τ (β))
    (h0_Cc_A : ¬FactorsThroughMorphism τ (η₂ ≫ γ))
    (h0_Cc_B : ¬FactorsThroughMorphism τ (η₂ ≫ δ))
    (h0_Cc_Ee : ¬FactorsThroughMorphism τ (((η₂ ≫ γ) ≫ α) ≫ ω₃))
    (h0_Cc_Xx : ¬FactorsThroughMorphism τ (η₂))
    (h0_Cc_Yy : ¬FactorsThroughMorphism τ ((η₂ ≫ γ) ≫ α))
    (h0_Dd_A : ¬FactorsThroughMorphism τ (ω₂))
    (h0_Dd_Ee : ¬FactorsThroughMorphism τ ((ω₂ ≫ α) ≫ ω₃))
    (h0_Dd_Yy : ¬FactorsThroughMorphism τ (ω₂ ≫ α))
    (h0_Xx_A : ¬FactorsThroughMorphism τ (γ))
    (h0_Xx_B : ¬FactorsThroughMorphism τ (δ))
    (h0_Xx_Ee : ¬FactorsThroughMorphism τ ((γ ≫ α) ≫ ω₃))
    (h0_Xx_Yy : ¬FactorsThroughMorphism τ (γ ≫ α))
    (h0_Y0_A : ¬FactorsThroughMorphism τ (ω₁ ≫ ω₂))
    (h0_Y0_Dd : ¬FactorsThroughMorphism τ (ω₁))
    (h0_Y0_Ee : ¬FactorsThroughMorphism τ (((ω₁ ≫ ω₂) ≫ α) ≫ ω₃))
    (h0_Y0_Yy : ¬FactorsThroughMorphism τ ((ω₁ ≫ ω₂) ≫ α))
    (h0_Yy_Ee : ¬FactorsThroughMorphism τ (ω₃))
    (hi_η₂ : ¬IsIso η₂)
    (hi_ω₁ : ¬IsIso ω₁)
    (hi_ω₂ : ¬IsIso ω₂)
    (hi_γ : ¬IsIso γ)
    (hi_δ : ¬IsIso δ)
    (hi_α : ¬IsIso α)
    (hi_β : ¬IsIso β)
    (hi_ω₃ : ¬IsIso ω₃)
    (hlft_Xx_A_B : ¬∃ g, γ ≫ g = δ)
    (hlft_Xx_B_A : ¬∃ g, δ ≫ g = γ)
    (hrgt_B_A_Yy : ¬∃ g, g ≫ α = β)
    (hrgt_A_B_Yy : ¬∃ g, g ≫ β = α)
    (hrgt_Y0_B_Yy : ¬∃ g, g ≫ β = (ω₁ ≫ ω₂) ≫ α)
    (hrgt_Dd_B_Yy : ¬∃ g, g ≫ β = ω₂ ≫ α)
    (hrgt_Cc_Dd_A : ¬∃ g, g ≫ ω₂ = η₂ ≫ γ)
    (hrgt_Xx_Dd_A : ¬∃ g, g ≫ ω₂ = γ)
    (hrgt_Y0_Xx_A : ¬∃ g, g ≫ γ = ω₁ ≫ ω₂)
    (hrgt_Dd_Xx_A : ¬∃ g, g ≫ γ = ω₂)
    : False := by
  have hlft_A_Yy_A : ¬∃ g, α ≫ g = 𝟙 _ := not_split_mono hi_α
  have hlft_B_Yy_B : ¬∃ g, β ≫ g = 𝟙 _ := not_split_mono hi_β
  have hlft_Cc_Xx_Cc : ¬∃ g, η₂ ≫ g = 𝟙 _ := not_split_mono hi_η₂
  have hlft_Dd_A_Dd : ¬∃ g, ω₂ ≫ g = 𝟙 _ := not_split_mono hi_ω₂
  have hlft_Xx_A_Xx : ¬∃ g, γ ≫ g = 𝟙 _ := not_split_mono hi_γ
  have hlft_Xx_B_Xx : ¬∃ g, δ ≫ g = 𝟙 _ := not_split_mono hi_δ
  have hlft_Y0_Dd_Y0 : ¬∃ g, ω₁ ≫ g = 𝟙 _ := not_split_mono hi_ω₁
  have hlft_Yy_Ee_Yy : ¬∃ g, ω₃ ≫ g = 𝟙 _ := not_split_mono hi_ω₃
  have hrgt_Yy_A_Yy : ¬∃ g, g ≫ α = 𝟙 _ := not_split_epi hi_α
  have hrgt_Yy_B_Yy : ¬∃ g, g ≫ β = 𝟙 _ := not_split_epi hi_β
  have hrgt_Xx_Cc_Xx : ¬∃ g, g ≫ η₂ = 𝟙 _ := not_split_epi hi_η₂
  have hrgt_A_Dd_A : ¬∃ g, g ≫ ω₂ = 𝟙 _ := not_split_epi hi_ω₂
  have hrgt_A_Xx_A : ¬∃ g, g ≫ γ = 𝟙 _ := not_split_epi hi_γ
  have hrgt_B_Xx_B : ¬∃ g, g ≫ δ = 𝟙 _ := not_split_epi hi_δ
  have hrgt_Dd_Y0_Dd : ¬∃ g, g ≫ ω₁ = 𝟙 _ := not_split_epi hi_ω₁
  have hrgt_Ee_Yy_Ee : ¬∃ g, g ≫ ω₃ = 𝟙 _ := not_split_epi hi_ω₃
  have hc0' := reassoc_of% hc0
  have hc1' := reassoc_of% hc1
  have hc2' := reassoc_of% hc2
  have hc3' := reassoc_of% hc3
  refine hM.not_thin_diagram τ hτ hτ0 hD arrows obj (fun x y _ ↦ tab η₂ ω₁ ω₂ γ δ α β ω₃ x y)
    (fun x ↦ by cases x <;> rfl) ?_ ?_ ?_ ?_
  · intro x y z h h'
    cases x <;> cases y <;> (try exact absurd h (by decide)) <;> cases z <;>
      (try exact absurd h' (by decide)) <;> split_ifs with hn <;>
      (try exact absurd hn (by decide)) <;>
      simp only [tab, Category.assoc, Category.id_comp, Category.comp_id, zero_comp, comp_zero, hc0', hc0, hc1', hc1, hc2', hc2, hc3', hc3]
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | exact not_factorsThrough_id hτ _
      | assumption
  · intro x z y ha hy
    cases x <;> cases z <;> (try exact absurd ha (by decide)) <;> cases y <;>
      (try exact absurd hy (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›
  · intro x z y ha hx
    cases z <;> cases y <;> (try exact absurd ha (by decide)) <;> cases x <;>
      (try exact absurd hx (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›

end RayCat

