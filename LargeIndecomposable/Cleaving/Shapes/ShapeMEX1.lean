/-- The morphisms. -/
abbrev tab : ∀ u v : MEX1, (obj (OCc := OCc) (OXx := OXx) (OA := OA) (OB := OB) (OYy := OYy) (OY0 := OY0) (ODd := ODd) (OEe := OEe) u) ⟶ obj (OCc := OCc) (OXx := OXx) (OA := OA) (OB := OB) (OYy := OYy) (OY0 := OY0) (ODd := ODd) (OEe := OEe) v
