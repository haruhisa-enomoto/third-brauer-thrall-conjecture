/-- Vertices of the diagram `MEX1`. -/
inductive MEX1
  | Cc | Xx | A | B | Yy | Y0 | Dd | Ee
  deriving DecidableEq

namespace MEX1

instance : Fintype MEX1 := ⟨{Cc, Xx, A, B, Yy, Y0, Dd, Ee}, by intro v; cases v <;> simp⟩

/-- The order (nonzero morphisms). -/
def leb : MEX1 → MEX1 → Bool
  | A, A | A, Ee | A, Yy | B, B | B, Ee | B, Yy | Cc, A | Cc, B | Cc, Cc | Cc, Ee | Cc, Xx | Cc, Yy | Dd, A | Dd, Dd | Dd, Ee | Dd, Yy | Ee, Ee | Xx, A | Xx, B | Xx, Ee | Xx, Xx | Xx, Yy | Y0, A | Y0, Dd | Y0, Ee | Y0, Y0 | Y0, Yy | Yy, Ee | Yy, Yy => true
  | _, _ => false

/-- The arrows. -/
def arb : MEX1 → MEX1 → Bool
  | A, Yy | B, Yy | Cc, Xx | Dd, A | Xx, A | Xx, B | Y0, Dd | Yy, Ee => true
  | _, _ => false

/-- The thin category. -/
abbrev thin : ThinData MEX1 where
  le x y := leb x y = true
  nz x _ z := leb x z = true
  refl x := by cases x <;> rfl
  antisymm := by decide
  nz_le _ _ _ _ _ h := h
  nz_left _ _ h := h
  nz_right _ _ h := h
  assoc := by decide

/-- The generating arrows. -/
abbrev arrows : ThinArrows thin where
  ar x y := arb x y = true
  ar_le := by decide
  ar_ne := by decide
  first := by decide
  last := by decide

