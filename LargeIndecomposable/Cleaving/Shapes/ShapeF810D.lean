namespace RayCat

/-- Vertices of the diagram `F810D`. -/
inductive F810D
  | y₁ | tω | a | m | x | y₀ | z₂
  deriving DecidableEq

namespace F810D

instance : Fintype F810D := ⟨{y₁, tω, a, m, x, y₀, z₂}, by intro v; cases v <;> simp⟩

/-- The order (nonzero morphisms). -/
def leb : F810D → F810D → Bool
  | a, a | a, y₀ | a, y₁ | a, z₂ | m, a | m, m | m, y₁ | m, z₂ | tω, tω | tω, y₁ | x, a | x, x | x, y₀ | x, y₁ | y₀, y₀ | y₁, y₁ | z₂, z₂ => true
  | _, _ => false

/-- The arrows. -/
def arb : F810D → F810D → Bool
  | a, y₀ | a, y₁ | a, z₂ | m, a | tω, y₁ | x, a => true
  | _, _ => false

/-- The thin category. -/
abbrev thin : ThinData F810D where
  le x y := leb x y = true
  nz x _ z := leb x z = true
  refl x := by cases x <;> rfl
  antisymm := by decide
  nz_le _ _ _ _ _ h := h
  nz_left _ _ h := h
  nz_right _ _ h := h
  assoc := by decide

/-- The generating arrows. -/
abbrev arrows : ThinArrows thin where
  ar x y := arb x y = true
  ar_le := by decide
  ar_ne := by decide
  first := by decide
  last := by decide

