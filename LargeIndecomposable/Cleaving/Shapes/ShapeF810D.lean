  (ω : Tω ⟶ Y₁) (ρ₁' : Aa ⟶ Y₁) (V₂ : Aa ⟶ Y₀) (ρ₂' : Aa ⟶ Z₂) (d : M ⟶ Aa) (V₁ : X ⟶ Aa)

/-- The objects. -/
abbrev obj : F810D → P
  | y₁ => Y₁ | tω => Tω | a => Aa | m => M | x => X | y₀ => Y₀ | z₂ => Z₂

/-- The morphisms. -/
abbrev tab : ∀ u v : F810D, (obj (Y₁ := Y₁) (Tω := Tω) (Aa := Aa) (M := M) (X := X) (Y₀ := Y₀) (Z₂ := Z₂) u) ⟶ obj (Y₁ := Y₁) (Tω := Tω) (Aa := Aa) (M := M) (X := X) (Y₀ := Y₀) (Z₂ := Z₂) v
