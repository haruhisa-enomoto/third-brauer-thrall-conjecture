/-- **No cleaving diagram `DB31A` in `P/τ`.** -/
theorem MildHyp.not_db31a (hM : MildHyp k P) {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {OA OB OC OD OE OF OG : P}
    (μ₁ : OA ⟶ OB) (a₁ : OB ⟶ OD) (c₁ : OA ⟶ OC) (μ₂ : OC ⟶ OD) (a₂ : OE ⟶ OB) (ν : OF ⟶ OD) (c₂ : OC ⟶ OG)
    (hD : ¬Statement.IsRepresentationFinite (Linearization (ThinCat thin) k))
    (hc0 : c₁ ≫ μ₂ = μ₁ ≫ a₁)
    (h0_Aa_Bb : ¬FactorsThroughMorphism τ (μ₁))
    (h0_Aa_Cc : ¬FactorsThroughMorphism τ (c₁))
    (h0_Aa_Dd : ¬FactorsThroughMorphism τ (μ₁ ≫ a₁))
    (h0_Aa_Gg : ¬FactorsThroughMorphism τ (c₁ ≫ c₂))
    (h0_Bb_Dd : ¬FactorsThroughMorphism τ (a₁))
    (h0_Cc_Dd : ¬FactorsThroughMorphism τ (μ₂))
    (h0_Cc_Gg : ¬FactorsThroughMorphism τ (c₂))
    (h0_Ee_Bb : ¬FactorsThroughMorphism τ (a₂))
    (h0_Ee_Dd : ¬FactorsThroughMorphism τ (a₂ ≫ a₁))
    (h0_Ff_Dd : ¬FactorsThroughMorphism τ (ν))
    (hi_μ₁ : ¬IsIso μ₁)
    (hi_a₁ : ¬IsIso a₁)
    (hi_c₁ : ¬IsIso c₁)
    (hi_μ₂ : ¬IsIso μ₂)
    (hi_a₂ : ¬IsIso a₂)
    (hi_ν : ¬IsIso ν)
    (hi_c₂ : ¬IsIso c₂)
    (hlft_Aa_Bb_Cc : ¬∃ g, μ₁ ≫ g = c₁)
    (hlft_Aa_Bb_Gg : ¬∃ g, μ₁ ≫ g = c₁ ≫ c₂)
    (hlft_Aa_Cc_Bb : ¬∃ g, c₁ ≫ g = μ₁)
    (hlft_Cc_Dd_Gg : ¬∃ g, μ₂ ≫ g = c₂)
    (hlft_Cc_Gg_Dd : ¬∃ g, c₂ ≫ g = μ₂)
    (hrgt_Ee_Aa_Bb : ¬∃ g, g ≫ μ₁ = a₂)
    (hrgt_Cc_Bb_Dd : ¬∃ g, g ≫ a₁ = μ₂)
    (hrgt_Ff_Bb_Dd : ¬∃ g, g ≫ a₁ = ν)
    (hrgt_Bb_Cc_Dd : ¬∃ g, g ≫ μ₂ = a₁)
    (hrgt_Ee_Cc_Dd : ¬∃ g, g ≫ μ₂ = a₂ ≫ a₁)
    (hrgt_Ff_Cc_Dd : ¬∃ g, g ≫ μ₂ = ν)
    (hrgt_Aa_Ee_Bb : ¬∃ g, g ≫ a₂ = μ₁)
    (hrgt_Aa_Ff_Dd : ¬∃ g, g ≫ ν = μ₁ ≫ a₁)
    (hrgt_Bb_Ff_Dd : ¬∃ g, g ≫ ν = a₁)
    (hrgt_Cc_Ff_Dd : ¬∃ g, g ≫ ν = μ₂)
    (hrgt_Ee_Ff_Dd : ¬∃ g, g ≫ ν = a₂ ≫ a₁)
    : False := by
  have hlft_Aa_Bb_Aa : ¬∃ g, μ₁ ≫ g = 𝟙 _ := not_split_mono hi_μ₁
  have hlft_Aa_Cc_Aa : ¬∃ g, c₁ ≫ g = 𝟙 _ := not_split_mono hi_c₁
  have hlft_Bb_Dd_Bb : ¬∃ g, a₁ ≫ g = 𝟙 _ := not_split_mono hi_a₁
  have hlft_Cc_Dd_Cc : ¬∃ g, μ₂ ≫ g = 𝟙 _ := not_split_mono hi_μ₂
  have hlft_Cc_Gg_Cc : ¬∃ g, c₂ ≫ g = 𝟙 _ := not_split_mono hi_c₂
  have hlft_Ee_Bb_Ee : ¬∃ g, a₂ ≫ g = 𝟙 _ := not_split_mono hi_a₂
  have hlft_Ff_Dd_Ff : ¬∃ g, ν ≫ g = 𝟙 _ := not_split_mono hi_ν
  have hrgt_Bb_Aa_Bb : ¬∃ g, g ≫ μ₁ = 𝟙 _ := not_split_epi hi_μ₁
  have hrgt_Cc_Aa_Cc : ¬∃ g, g ≫ c₁ = 𝟙 _ := not_split_epi hi_c₁
  have hrgt_Dd_Bb_Dd : ¬∃ g, g ≫ a₁ = 𝟙 _ := not_split_epi hi_a₁
  have hrgt_Dd_Cc_Dd : ¬∃ g, g ≫ μ₂ = 𝟙 _ := not_split_epi hi_μ₂
  have hrgt_Gg_Cc_Gg : ¬∃ g, g ≫ c₂ = 𝟙 _ := not_split_epi hi_c₂
  have hrgt_Bb_Ee_Bb : ¬∃ g, g ≫ a₂ = 𝟙 _ := not_split_epi hi_a₂
  have hrgt_Dd_Ff_Dd : ¬∃ g, g ≫ ν = 𝟙 _ := not_split_epi hi_ν
  have hc0' := reassoc_of% hc0
  refine hM.not_thin_diagram τ hτ hτ0 hD arrows obj (fun x y _ ↦ tab μ₁ a₁ c₁ μ₂ a₂ ν c₂ x y)
    (fun x ↦ by cases x <;> rfl) ?_ ?_ ?_ ?_
  · intro x y z h h'
    cases x <;> cases y <;> (try exact absurd h (by decide)) <;> cases z <;>
      (try exact absurd h' (by decide)) <;> split_ifs with hn <;>
      (try exact absurd hn (by decide)) <;>
      simp only [tab, Category.assoc, Category.id_comp, Category.comp_id, zero_comp, comp_zero, hc0', hc0]
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | exact not_factorsThrough_id hτ _
      | assumption
  · intro x z y ha hy
    cases x <;> cases z <;> (try exact absurd ha (by decide)) <;> cases y <;>
      (try exact absurd hy (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›
  · intro x z y ha hx
    cases z <;> cases y <;> (try exact absurd ha (by decide)) <;> cases x <;>
      (try exact absurd hx (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›

