module

public import LargeIndecomposable.Cleaving.Shapes.ShapeD6
public import LargeIndecomposable.Cleaving.Diagrams.Tools

/-!
# The tree diagram `DM5`

[mild] figure 2.5 (first diagram): `α, β` into `y`, `ω' : y → a`, `γ : x → a`, `α : a → y` again (`D̃₅`).

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `DM5`. -/
inductive DM5
  | Y | A2 | A | B | S | Y2
  deriving DecidableEq

namespace DM5

instance : Fintype DM5 := ⟨{Y, A2, A, B, S, Y2}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : DM5 → DM5 → Bool
  | A, Y | B, Y | Y, A2 | S, A2 | A2, Y2 => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : DM5) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph DM5 := SimpleGraph.fromRel o

lemma adj_iff (u v : DM5) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : DM5) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : DM5) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : DM5) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : DM5 → Option DM5
  | Y => none
  | A2 => some Y
  | A => some Y
  | B => some Y
  | S => some A2
  | Y2 => some A2

/-- The height. -/
def ht : DM5 → ℕ
  | Y => 0
  | A2 => 1
  | A => 1
  | B => 1
  | S => 2
  | Y2 => 2

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `D̃`. -/
def cmap : AffineD 1 → DM5
  | .spine j => if (j : ℕ) = 0 then Y else A2
  | .leaf i => if (i : ℕ) = 0 then A else if (i : ℕ) = 1 then B else if (i : ℕ) = 2 then S else Y2

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `D̃`. -/
def copy : (underlyingGraph (AffineD 1)).Copy G :=
  copyD G 1 cmap (by
    intro u v h
    rcases u with i | j <;> rcases v with i' | j'
    · fin_cases i <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases i <;> fin_cases j' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases j' <;> simp_all [cmap])
    (fun i ↦ by
      fin_cases i
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide)
    (fun j j' h ↦ by fin_cases j <;> fin_cases j' <;> simp_all [cmap] <;> decide)

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {OY OA2 OA OB OS OY2 : P}
  (α : OA ⟶ OY) (β : OB ⟶ OY) (ω : OY ⟶ OA2) (γ : OS ⟶ OA2) (α₂ : OA2 ⟶ OY2)

/-- The objects. -/
def obj : DM5 → P
  | Y => OY | A2 => OA2 | A => OA | B => OB | S => OS | Y2 => OY2

/-- The arrows. -/
def arr : ∀ u v : DM5, o u v → ((obj (OY := OY) (OA2 := OA2) (OA := OA) (OB := OB) (OS := OS) (OY2 := OY2) u) ⟶ obj (OY := OY) (OA2 := OA2) (OA := OA) (OB := OB) (OS := OS) (OY2 := OY2) v)
  | A, Y, _ => α
  | B, Y, _ => β
  | Y, A2, _ => ω
  | S, A2, _ => γ
  | A2, Y2, _ => α₂
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : DM5, Option ((obj (OY := OY) (OA2 := OA2) (OA := OA) (OB := OB) (OS := OS) (OY2 := OY2) u) ⟶ obj (OY := OY) (OA2 := OA2) (OA := OA) (OB := OB) (OS := OS) (OY2 := OY2) v)
  | Y, Y => some (𝟙 _)
  | Y, A2 => some (ω)
  | Y, Y2 => some (ω ≫ α₂)
  | A2, A2 => some (𝟙 _)
  | A2, Y2 => some (α₂)
  | A, A => some (𝟙 _)
  | A, Y => some (α)
  | A, A2 => some (α ≫ ω)
  | A, Y2 => some ((α ≫ ω) ≫ α₂)
  | B, B => some (𝟙 _)
  | B, Y => some (β)
  | B, A2 => some (β ≫ ω)
  | B, Y2 => some ((β ≫ ω) ≫ α₂)
  | S, S => some (𝟙 _)
  | S, A2 => some (γ)
  | S, Y2 => some (γ ≫ α₂)
  | Y2, Y2 => some (𝟙 _)
  | _, _ => none

end Diagram

end DM5

end RayCat

namespace RayCat

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type u} [Field k] [Infinite k]

set_option maxHeartbeats 8000000 in
open DM5 in
/-- **No cleaving diagram `DM5` in `P/τ`.** -/
theorem MildHyp.not_dm5 (hM : MildHyp k P)
    {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {OY OA2 OA OB OS OY2 : P}
    (α : OA ⟶ OY) (β : OB ⟶ OY) (ω : OY ⟶ OA2) (γ : OS ⟶ OA2) (α₂ : OA2 ⟶ OY2)
    (h0_Y_A2 : ¬FactorsThroughMorphism τ (ω))
    (h0_Y_Y2 : ¬FactorsThroughMorphism τ (ω ≫ α₂))
    (h0_A2_Y2 : ¬FactorsThroughMorphism τ (α₂))
    (h0_A_Y : ¬FactorsThroughMorphism τ (α))
    (h0_A_A2 : ¬FactorsThroughMorphism τ (α ≫ ω))
    (h0_A_Y2 : ¬FactorsThroughMorphism τ ((α ≫ ω) ≫ α₂))
    (h0_B_Y : ¬FactorsThroughMorphism τ (β))
    (h0_B_A2 : ¬FactorsThroughMorphism τ (β ≫ ω))
    (h0_B_Y2 : ¬FactorsThroughMorphism τ ((β ≫ ω) ≫ α₂))
    (h0_S_A2 : ¬FactorsThroughMorphism τ (γ))
    (h0_S_Y2 : ¬FactorsThroughMorphism τ (γ ≫ α₂))
    (hi_α : ¬IsIso α)
    (hi_β : ¬IsIso β)
    (hi_ω : ¬IsIso ω)
    (hi_γ : ¬IsIso γ)
    (hi_α₂ : ¬IsIso α₂)
    (hr_α_β_B : ¬∃ g, g ≫ α = β)
    (hr_β_α_A : ¬∃ g, g ≫ β = α)
    (hr_ω_γ_S : ¬∃ g, g ≫ ω = γ)
    (hr_γ_ω_Y : ¬∃ g, g ≫ γ = ω)
    (hr_γ_ω_A : ¬∃ g, g ≫ γ = α ≫ ω)
    (hr_γ_ω_B : ¬∃ g, g ≫ γ = β ≫ ω)
    : False := by
  haveI : Fact (LargeIndecomposable.Foundations.Quiver.IsAcyclic (OT G o)) := ⟨OT.isAcyclic ho hasym isAcyclic⟩
  refine hM.not_tree_table τ hτ hτ0 G o ho hasym isAcyclic
    (OT.not_isRepresentationFinite_affineD ho hcov k 1 copy) obj (arr α β ω γ α₂)
    (tab α β ω γ α₂) (fun v ↦ by cases v <;> rfl) ?_ ?_ ?_ ?_ ?_
  · intro x y z h f hf
    cases y <;> cases z <;> (try exact absurd h (by decide)) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; rfl)
      | rfl
  · intro x y f hf hne
    cases x <;> cases y <;> (try exact absurd rfl hne) <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;> assumption
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | assumption
  · intro x c c' y h h' f hne hf
    cases x <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases y <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.comp_id]; assumption)
      | assumption
  · intro x c c' y h h' f hne hf
    cases y <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; assumption)
      | assumption

end RayCat

