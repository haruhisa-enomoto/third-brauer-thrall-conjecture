namespace RayCat

/-- Vertices of the diagram `F73`. -/
inductive F73
  | x | c | y₀ | a | b | y₁ | b' | a' | tz
  deriving DecidableEq

namespace F73

instance : Fintype F73 := ⟨{x, c, y₀, a, b, y₁, b', a', tz}, by intro v; cases v <;> simp⟩

/-- The order (nonzero morphisms). -/
def leb : F73 → F73 → Bool
  | a, a | a, b | a, y₀ | a, y₁ | a', a' | a', b' | a', tz | a', y₁ | b, b | b, y₀ | b', b' | b', y₁ | c, c | c, y₀ | tz, tz | x, a | x, b | x, c | x, x | x, y₀ | x, y₁ | y₀, y₀ | y₁, y₁ => true
  | _, _ => false

/-- The arrows. -/
def arb : F73 → F73 → Bool
  | a, b | a, y₁ | a', b' | a', tz | b, y₀ | b', y₁ | c, y₀ | x, a | x, c => true
  | _, _ => false

/-- The thin category. -/
abbrev thin : ThinData F73 where
  le x y := leb x y = true
  nz x _ z := leb x z = true
  refl x := by cases x <;> rfl
  antisymm := by decide
  nz_le _ _ _ _ _ h := h
  nz_left _ _ h := h
  nz_right _ _ h := h
  assoc := by decide

/-- The generating arrows. -/
abbrev arrows : ThinArrows thin where
  ar x y := arb x y = true
  ar_le := by decide
  ar_ne := by decide
  first := by decide
  last := by decide

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {X Cc Y₀ Aa Bb Y₁ B' A' Tz : P}
  (W₁ : X ⟶ Cc) (W₂ : Cc ⟶ Y₀) (V₁ : X ⟶ Aa) (V₂ : Aa ⟶ Bb) (V₃ : Bb ⟶ Y₀) (r : Aa ⟶ Y₁) (V₃' : B' ⟶ Y₁) (V₂' : A' ⟶ B') (ρ₂' : A' ⟶ Tz)

/-- The objects. -/
abbrev obj : F73 → P
  | x => X | c => Cc | y₀ => Y₀ | a => Aa | b => Bb | y₁ => Y₁ | b' => B' | a' => A' | tz => Tz

/-- The morphisms. -/
abbrev tab : ∀ u v : F73, (obj (X := X) (Cc := Cc) (Y₀ := Y₀) (Aa := Aa) (Bb := Bb) (Y₁ := Y₁) (B' := B') (A' := A') (Tz := Tz) u) ⟶ obj (X := X) (Cc := Cc) (Y₀ := Y₀) (Aa := Aa) (Bb := Bb) (Y₁ := Y₁) (B' := B') (A' := A') (Tz := Tz) v
  | a, a => 𝟙 _
  | a, b => V₂
  | a, y₀ => V₂ ≫ V₃
  | a, y₁ => r
  | a', a' => 𝟙 _
  | a', b' => V₂'
  | a', tz => ρ₂'
  | a', y₁ => V₂' ≫ V₃'
  | b, b => 𝟙 _
  | b, y₀ => V₃
  | b', b' => 𝟙 _
  | b', y₁ => V₃'
  | c, c => 𝟙 _
  | c, y₀ => W₂
  | tz, tz => 𝟙 _
  | x, a => V₁
  | x, b => V₁ ≫ V₂
  | x, c => W₁
  | x, x => 𝟙 _
  | x, y₀ => W₁ ≫ W₂
  | x, y₁ => V₁ ≫ r
  | y₀, y₀ => 𝟙 _
  | y₁, y₁ => 𝟙 _
  | _, _ => 0

end Diagram

