variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type u} [Field k] [Infinite k]
  {A : Type u} [Ring A] [Algebra k A] (B : MulBasis k P A)

set_option maxHeartbeats 16000000 in
open F73 in
include B in
/-- **No cleaving diagram `F73` in `P/τ`.** -/
theorem not_f73
    (hmin : ∀ I : TwoSidedIdeal A, I ≠ ⊥ → Statement.IsRepresentationFinite (A ⧸ I.asIdeal))
    (hL : LeftCancel P) (hR : RightCancel P) {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {X Cc Y₀ Aa Bb Y₁ B' A' Tz : P}
    (W₁ : X ⟶ Cc) (W₂ : Cc ⟶ Y₀) (V₁ : X ⟶ Aa) (V₂ : Aa ⟶ Bb) (V₃ : Bb ⟶ Y₀) (r : Aa ⟶ Y₁) (V₃' : B' ⟶ Y₁) (V₂' : A' ⟶ B') (ρ₂' : A' ⟶ Tz)
    (hD : ¬Statement.IsRepresentationFinite (Linearization (ThinCat thin) k))
    (hc0 : V₁ ≫ V₂ ≫ V₃ = W₁ ≫ W₂)
    (h0_a_b : ¬FactorsThroughMorphism τ (V₂))
    (h0_a_y₀ : ¬FactorsThroughMorphism τ (V₂ ≫ V₃))
    (h0_a_y₁ : ¬FactorsThroughMorphism τ (r))
    (h0_a'_b' : ¬FactorsThroughMorphism τ (V₂'))
    (h0_a'_tz : ¬FactorsThroughMorphism τ (ρ₂'))
    (h0_a'_y₁ : ¬FactorsThroughMorphism τ (V₂' ≫ V₃'))
    (h0_b_y₀ : ¬FactorsThroughMorphism τ (V₃))
    (h0_b'_y₁ : ¬FactorsThroughMorphism τ (V₃'))
    (h0_c_y₀ : ¬FactorsThroughMorphism τ (W₂))
    (h0_x_a : ¬FactorsThroughMorphism τ (V₁))
    (h0_x_b : ¬FactorsThroughMorphism τ (V₁ ≫ V₂))
    (h0_x_c : ¬FactorsThroughMorphism τ (W₁))
    (h0_x_y₀ : ¬FactorsThroughMorphism τ (W₁ ≫ W₂))
    (h0_x_y₁ : ¬FactorsThroughMorphism τ (V₁ ≫ r))
    (hi_W₁ : ¬IsIso W₁)
    (hi_W₂ : ¬IsIso W₂)
    (hi_V₁ : ¬IsIso V₁)
    (hi_V₂ : ¬IsIso V₂)
    (hi_V₃ : ¬IsIso V₃)
    (hi_r : ¬IsIso r)
    (hi_V₃' : ¬IsIso V₃')
    (hi_V₂' : ¬IsIso V₂')
    (hi_ρ₂' : ¬IsIso ρ₂')
    (hlft_a_b_y₁ : ¬∃ g, V₂ ≫ g = r)
    (hlft_a_y₁_y₀ : ¬∃ g, r ≫ g = V₂ ≫ V₃)
    (hlft_a_y₁_b : ¬∃ g, r ≫ g = V₂)
    (hlft_a'_b'_tz : ¬∃ g, V₂' ≫ g = ρ₂')
    (hlft_a'_tz_y₁ : ¬∃ g, ρ₂' ≫ g = V₂' ≫ V₃')
    (hlft_a'_tz_b' : ¬∃ g, ρ₂' ≫ g = V₂')
    (hlft_x_a_c : ¬∃ g, V₁ ≫ g = W₁)
    (hlft_x_c_a : ¬∃ g, W₁ ≫ g = V₁)
    (hlft_x_c_b : ¬∃ g, W₁ ≫ g = V₁ ≫ V₂)
    (hlft_x_c_y₁ : ¬∃ g, W₁ ≫ g = V₁ ≫ r)
    (hrgt_b'_a_y₁ : ¬∃ g, g ≫ r = V₃')
    (hrgt_a'_a_y₁ : ¬∃ g, g ≫ r = V₂' ≫ V₃')
    (hrgt_c_b_y₀ : ¬∃ g, g ≫ V₃ = W₂)
    (hrgt_x_b'_y₁ : ¬∃ g, g ≫ V₃' = V₁ ≫ r)
    (hrgt_a_b'_y₁ : ¬∃ g, g ≫ V₃' = r)
    (hrgt_a_c_y₀ : ¬∃ g, g ≫ W₂ = V₂ ≫ V₃)
    (hrgt_b_c_y₀ : ¬∃ g, g ≫ W₂ = V₃)
    : False := by
  have hlft_a_b_a : ¬∃ g, V₂ ≫ g = 𝟙 _ := not_split_mono hi_V₂
  have hlft_a_y₁_a : ¬∃ g, r ≫ g = 𝟙 _ := not_split_mono hi_r
  have hlft_a'_b'_a' : ¬∃ g, V₂' ≫ g = 𝟙 _ := not_split_mono hi_V₂'
  have hlft_a'_tz_a' : ¬∃ g, ρ₂' ≫ g = 𝟙 _ := not_split_mono hi_ρ₂'
  have hlft_b_y₀_b : ¬∃ g, V₃ ≫ g = 𝟙 _ := not_split_mono hi_V₃
  have hlft_b'_y₁_b' : ¬∃ g, V₃' ≫ g = 𝟙 _ := not_split_mono hi_V₃'
  have hlft_c_y₀_c : ¬∃ g, W₂ ≫ g = 𝟙 _ := not_split_mono hi_W₂
  have hlft_x_a_x : ¬∃ g, V₁ ≫ g = 𝟙 _ := not_split_mono hi_V₁
  have hlft_x_c_x : ¬∃ g, W₁ ≫ g = 𝟙 _ := not_split_mono hi_W₁
  have hrgt_b_a_b : ¬∃ g, g ≫ V₂ = 𝟙 _ := not_split_epi hi_V₂
  have hrgt_y₁_a_y₁ : ¬∃ g, g ≫ r = 𝟙 _ := not_split_epi hi_r
  have hrgt_b'_a'_b' : ¬∃ g, g ≫ V₂' = 𝟙 _ := not_split_epi hi_V₂'
  have hrgt_tz_a'_tz : ¬∃ g, g ≫ ρ₂' = 𝟙 _ := not_split_epi hi_ρ₂'
  have hrgt_y₀_b_y₀ : ¬∃ g, g ≫ V₃ = 𝟙 _ := not_split_epi hi_V₃
  have hrgt_y₁_b'_y₁ : ¬∃ g, g ≫ V₃' = 𝟙 _ := not_split_epi hi_V₃'
  have hrgt_y₀_c_y₀ : ¬∃ g, g ≫ W₂ = 𝟙 _ := not_split_epi hi_W₂
  have hrgt_a_x_a : ¬∃ g, g ≫ V₁ = 𝟙 _ := not_split_epi hi_V₁
  have hrgt_c_x_c : ¬∃ g, g ≫ W₁ = 𝟙 _ := not_split_epi hi_W₁
  have hc0' := reassoc_of% hc0
  refine B.not_thin_diagram hmin hL hR τ hτ hτ0 hD arrows obj (fun x y _ ↦ tab W₁ W₂ V₁ V₂ V₃ r V₃' V₂' ρ₂' x y)
    (fun x ↦ by cases x <;> rfl) ?_ ?_ ?_ ?_
  · intro x y z h h'
    cases x <;> cases y <;> (try exact absurd h (by decide)) <;> cases z <;>
      (try exact absurd h' (by decide)) <;> split_ifs with hn <;>
      (try exact absurd hn (by decide)) <;>
      simp only [tab, Category.assoc, Category.id_comp, Category.comp_id, zero_comp, comp_zero, hc0', hc0]
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | exact not_factorsThrough_id hτ _
      | assumption
  · intro x z y ha hy
    cases x <;> cases z <;> (try exact absurd ha (by decide)) <;> cases y <;>
      (try exact absurd hy (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›
  · intro x z y ha hx
    cases z <;> cases y <;> (try exact absurd ha (by decide)) <;> cases x <;>
      (try exact absurd hx (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›

end MulBasis

