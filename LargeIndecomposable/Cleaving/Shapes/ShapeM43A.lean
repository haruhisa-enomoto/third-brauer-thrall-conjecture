variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {XZ XX1 XC XA XB XBb XG : P}
  (δ : XZ ⟶ XX1) (β : XX1 ⟶ XC) (ρ : XA ⟶ XB) (a : XA ⟶ XX1) (ε : XA ⟶ XBb) (ρ' : XB ⟶ XC) (β' : XG ⟶ XB)

/-- The objects. -/
abbrev obj : M43A → P
  | Z => XZ | X1 => XX1 | W => XC | A => XA | B => XB | Bb => XBb | G => XG

/-- The morphisms. -/
abbrev tab : ∀ u v : M43A, (obj (XZ := XZ) (XX1 := XX1) (XC := XC) (XA := XA) (XB := XB) (XBb := XBb) (XG := XG) u) ⟶ obj (XZ := XZ) (XX1 := XX1) (XC := XC) (XA := XA) (XB := XB) (XBb := XBb) (XG := XG) v
  | A, A => 𝟙 _
  | A, B => ρ
  | A, Bb => ε
  | A, W => ρ ≫ ρ'
  | A, X1 => a
  | B, B => 𝟙 _
  | B, W => ρ'
  | Bb, Bb => 𝟙 _
  | G, B => β'
  | G, G => 𝟙 _
  | G, W => β' ≫ ρ'
  | W, W => 𝟙 _
  | X1, W => β
  | X1, X1 => 𝟙 _
  | Z, W => δ ≫ β
  | Z, X1 => δ
  | Z, Z => 𝟙 _
  | _, _ => 0

end Diagram

