namespace RayCat

/-- Vertices of the diagram `M43A`. -/
inductive M43A
  | Z | X1 | W | A | B | Bb | G
  deriving DecidableEq

namespace M43A

instance : Fintype M43A := ⟨{Z, X1, W, A, B, Bb, G}, by intro v; cases v <;> simp⟩

/-- The order (nonzero morphisms). -/
def leb : M43A → M43A → Bool
  | A, A | A, B | A, Bb | A, W | A, X1 | B, B | B, W | Bb, Bb | G, B | G, G | G, W | W, W | X1, W | X1, X1 | Z, W | Z, X1 | Z, Z => true
  | _, _ => false

/-- The arrows. -/
def arb : M43A → M43A → Bool
  | A, B | A, Bb | A, X1 | B, W | G, B | X1, W | Z, X1 => true
  | _, _ => false

/-- The thin category. -/
abbrev thin : ThinData M43A where
  le x y := leb x y = true
  nz x _ z := leb x z = true
  refl x := by cases x <;> rfl
  antisymm := by decide
  nz_le _ _ _ _ _ h := h
  nz_left _ _ h := h
  nz_right _ _ h := h
  assoc := by decide

/-- The generating arrows. -/
abbrev arrows : ThinArrows thin where
  ar x y := arb x y = true
  ar_le := by decide
  ar_ne := by decide
  first := by decide
  last := by decide

