open MD33 in
/-- **No cleaving diagram `MD33` in `P/τ`.** -/
theorem MildHyp.not_md33 (hM : MildHyp k P) {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {OXa OCc OAa OBb OYy OX2 OB3 OY2 OB4 : P}
    (ε : OXa ⟶ OCc) (γ : OXa ⟶ OAa) (δ : OXa ⟶ OBb) (α : OAa ⟶ OYy) (β : OBb ⟶ OYy) (η : OAa ⟶ OX2) (δ₂ : OX2 ⟶ OB3) (ω : OY2 ⟶ OAa) (β₂ : OB4 ⟶ OY2)
    (hD : ¬Statement.IsRepresentationFinite (Linearization (ThinCat thin) k))
    (hc0 : δ ≫ β = γ ≫ α)
    (hz0 : FactorsThroughMorphism τ (β₂ ≫ ω ≫ η ≫ δ₂))
    (hz1 : FactorsThroughMorphism τ (β₂ ≫ ω ≫ η))
    (hz2 : FactorsThroughMorphism τ (ω ≫ η ≫ δ₂))
    (hz3 : FactorsThroughMorphism τ (ω ≫ η))
    (h0_Aa_B3 : ¬FactorsThroughMorphism τ (η ≫ δ₂))
    (h0_Aa_X2 : ¬FactorsThroughMorphism τ (η))
    (h0_Aa_Yy : ¬FactorsThroughMorphism τ (α))
    (h0_B4_Aa : ¬FactorsThroughMorphism τ (β₂ ≫ ω))
    (h0_B4_Y2 : ¬FactorsThroughMorphism τ (β₂))
    (h0_B4_Yy : ¬FactorsThroughMorphism τ ((β₂ ≫ ω) ≫ α))
    (h0_Bb_Yy : ¬FactorsThroughMorphism τ (β))
    (h0_X2_B3 : ¬FactorsThroughMorphism τ (δ₂))
    (h0_Xa_Aa : ¬FactorsThroughMorphism τ (γ))
    (h0_Xa_B3 : ¬FactorsThroughMorphism τ ((γ ≫ η) ≫ δ₂))
    (h0_Xa_Bb : ¬FactorsThroughMorphism τ (δ))
    (h0_Xa_Cc : ¬FactorsThroughMorphism τ (ε))
    (h0_Xa_X2 : ¬FactorsThroughMorphism τ (γ ≫ η))
    (h0_Xa_Yy : ¬FactorsThroughMorphism τ (γ ≫ α))
    (h0_Y2_Aa : ¬FactorsThroughMorphism τ (ω))
    (h0_Y2_Yy : ¬FactorsThroughMorphism τ (ω ≫ α))
    (hi_ε : ¬IsIso ε)
    (hi_γ : ¬IsIso γ)
    (hi_δ : ¬IsIso δ)
    (hi_α : ¬IsIso α)
    (hi_β : ¬IsIso β)
    (hi_η : ¬IsIso η)
    (hi_δ₂ : ¬IsIso δ₂)
    (hi_ω : ¬IsIso ω)
    (hi_β₂ : ¬IsIso β₂)
    (hlft_Aa_X2_Yy : ¬∃ g, η ≫ g = α)
    (hlft_Aa_Yy_X2 : ¬∃ g, α ≫ g = η)
    (hlft_Aa_Yy_B3 : ¬∃ g, α ≫ g = η ≫ δ₂)
    (hlft_Xa_Aa_Cc : ¬∃ g, γ ≫ g = ε)
    (hlft_Xa_Aa_Bb : ¬∃ g, γ ≫ g = δ)
    (hlft_Xa_Bb_Cc : ¬∃ g, δ ≫ g = ε)
    (hlft_Xa_Bb_Aa : ¬∃ g, δ ≫ g = γ)
    (hlft_Xa_Bb_X2 : ¬∃ g, δ ≫ g = γ ≫ η)
    (hlft_Xa_Bb_B3 : ¬∃ g, δ ≫ g = (γ ≫ η) ≫ δ₂)
    (hlft_Xa_Cc_Aa : ¬∃ g, ε ≫ g = γ)
    (hlft_Xa_Cc_Bb : ¬∃ g, ε ≫ g = δ)
    (hlft_Xa_Cc_Yy : ¬∃ g, ε ≫ g = γ ≫ α)
    (hlft_Xa_Cc_X2 : ¬∃ g, ε ≫ g = γ ≫ η)
    (hlft_Xa_Cc_B3 : ¬∃ g, ε ≫ g = (γ ≫ η) ≫ δ₂)
    (hrgt_Bb_Aa_Yy : ¬∃ g, g ≫ α = β)
    (hrgt_Aa_Bb_Yy : ¬∃ g, g ≫ β = α)
    (hrgt_Y2_Bb_Yy : ¬∃ g, g ≫ β = ω ≫ α)
    (hrgt_B4_Bb_Yy : ¬∃ g, g ≫ β = (β₂ ≫ ω) ≫ α)
    (hrgt_Y2_Xa_Aa : ¬∃ g, g ≫ γ = ω)
    (hrgt_B4_Xa_Aa : ¬∃ g, g ≫ γ = β₂ ≫ ω)
    (hrgt_Xa_Y2_Aa : ¬∃ g, g ≫ ω = γ)
    : False := by
  have hlft_Aa_X2_Aa : ¬∃ g, η ≫ g = 𝟙 _ := not_split_mono hi_η
  have hlft_Aa_Yy_Aa : ¬∃ g, α ≫ g = 𝟙 _ := not_split_mono hi_α
  have hlft_B4_Y2_B4 : ¬∃ g, β₂ ≫ g = 𝟙 _ := not_split_mono hi_β₂
  have hlft_Bb_Yy_Bb : ¬∃ g, β ≫ g = 𝟙 _ := not_split_mono hi_β
  have hlft_X2_B3_X2 : ¬∃ g, δ₂ ≫ g = 𝟙 _ := not_split_mono hi_δ₂
  have hlft_Xa_Aa_Xa : ¬∃ g, γ ≫ g = 𝟙 _ := not_split_mono hi_γ
  have hlft_Xa_Bb_Xa : ¬∃ g, δ ≫ g = 𝟙 _ := not_split_mono hi_δ
  have hlft_Xa_Cc_Xa : ¬∃ g, ε ≫ g = 𝟙 _ := not_split_mono hi_ε
  have hlft_Y2_Aa_Y2 : ¬∃ g, ω ≫ g = 𝟙 _ := not_split_mono hi_ω
  have hrgt_X2_Aa_X2 : ¬∃ g, g ≫ η = 𝟙 _ := not_split_epi hi_η
  have hrgt_Yy_Aa_Yy : ¬∃ g, g ≫ α = 𝟙 _ := not_split_epi hi_α
  have hrgt_Y2_B4_Y2 : ¬∃ g, g ≫ β₂ = 𝟙 _ := not_split_epi hi_β₂
  have hrgt_Yy_Bb_Yy : ¬∃ g, g ≫ β = 𝟙 _ := not_split_epi hi_β
  have hrgt_B3_X2_B3 : ¬∃ g, g ≫ δ₂ = 𝟙 _ := not_split_epi hi_δ₂
  have hrgt_Aa_Xa_Aa : ¬∃ g, g ≫ γ = 𝟙 _ := not_split_epi hi_γ
  have hrgt_Bb_Xa_Bb : ¬∃ g, g ≫ δ = 𝟙 _ := not_split_epi hi_δ
  have hrgt_Cc_Xa_Cc : ¬∃ g, g ≫ ε = 𝟙 _ := not_split_epi hi_ε
  have hrgt_Aa_Y2_Aa : ¬∃ g, g ≫ ω = 𝟙 _ := not_split_epi hi_ω
  have hc0' := reassoc_of% hc0
  have hzq0 : ∀ {W : P} (q : OB3 ⟶ W), FactorsThroughMorphism τ (β₂ ≫ ω ≫ η ≫ δ₂ ≫ q) :=
    fun q ↦ by simpa only [Category.assoc] using ftm_comp_right hz0 q
  have hzq1 : ∀ {W : P} (q : OX2 ⟶ W), FactorsThroughMorphism τ (β₂ ≫ ω ≫ η ≫ q) :=
    fun q ↦ by simpa only [Category.assoc] using ftm_comp_right hz1 q
  have hzq2 : ∀ {W : P} (q : OB3 ⟶ W), FactorsThroughMorphism τ (ω ≫ η ≫ δ₂ ≫ q) :=
    fun q ↦ by simpa only [Category.assoc] using ftm_comp_right hz2 q
  have hzq3 : ∀ {W : P} (q : OX2 ⟶ W), FactorsThroughMorphism τ (ω ≫ η ≫ q) :=
    fun q ↦ by simpa only [Category.assoc] using ftm_comp_right hz3 q
  refine hM.not_thin_diagram' τ hτ hτ0 hD arrows obj (fun x y _ ↦ tab ε γ δ α β η δ₂ ω β₂ x y)
    (fun x ↦ by cases x <;> rfl) ?_ ?_ ?_ ?_
  · intro x y z h h'
    cases x <;> cases y <;> (try exact absurd h (by decide)) <;> cases z <;>
      (try exact absurd h' (by decide)) <;> split_ifs with hn <;>
      (try exact absurd hn (by decide)) <;>
      (try simp only [tab, Category.assoc, Category.id_comp, Category.comp_id, zero_comp, comp_zero, hc0', hc0]) <;>
      (try (repeat (first | exact hz0 | exact hz1 | exact hz2 | exact hz3 | exact hzq0 _ | exact hzq1 _ | exact hzq2 _ | exact hzq3 _ | apply ftm_comp_left)))
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | exact not_factorsThrough_id hτ _
      | assumption
  · intro x z y ha hy
    cases x <;> cases z <;> (try exact absurd ha (by decide)) <;> cases y <;>
      (try exact absurd hy (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›
  · intro x z y ha hx
    cases z <;> cases y <;> (try exact absurd ha (by decide)) <;> cases x <;>
      (try exact absurd hx (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›

