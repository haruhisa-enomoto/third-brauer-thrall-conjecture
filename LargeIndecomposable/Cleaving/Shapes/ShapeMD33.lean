/-- Vertices of the diagram `MD33`. -/
inductive MD33
  | Xa | Cc | Aa | Bb | Yy | X2 | B3 | Y2 | B4
  deriving DecidableEq

namespace MD33

instance : Fintype MD33 := ⟨{Xa, Cc, Aa, Bb, Yy, X2, B3, Y2, B4}, by intro v; cases v <;> simp⟩

/-- The order (nonzero morphisms). -/
def leb : MD33 → MD33 → Bool
  | Aa, Aa | Aa, B3 | Aa, X2 | Aa, Yy | B3, B3 | B4, Aa | B4, B4 | B4, Y2 | B4, Yy | Bb, Bb | Bb, Yy | Cc, Cc | X2, B3 | X2, X2 | Xa, Aa | Xa, B3 | Xa, Bb | Xa, Cc | Xa, X2 | Xa, Xa | Xa, Yy | Y2, Aa | Y2, Y2 | Y2, Yy | Yy, Yy => true
  | _, _ => false

/-- The arrows. -/
def arb : MD33 → MD33 → Bool
  | Aa, X2 | Aa, Yy | B4, Y2 | Bb, Yy | X2, B3 | Xa, Aa | Xa, Bb | Xa, Cc | Y2, Aa => true
  | _, _ => false

/-- The thin category. -/
abbrev thin : ThinData MD33 where
  le x y := leb x y = true
  nz x _ z := leb x z = true
  refl x := by cases x <;> rfl
  antisymm := by decide
  nz_le _ _ _ _ _ h := h
  nz_left _ _ h := h
  nz_right _ _ h := h
  assoc := by decide

/-- The generating arrows. -/
abbrev arrows : ThinArrows thin where
  ar x y := arb x y = true
  ar_le := by decide
  ar_ne := by decide
  first := by decide
  last := by decide

