abbrev obj : MD33 → P
  | Xa => OXa | Cc => OCc | Aa => OAa | Bb => OBb | Yy => OYy | X2 => OX2 | B3 => OB3 | Y2 => OY2 | B4 => OB4

/-- The morphisms. -/
abbrev tab : ∀ u v : MD33, (obj (OXa := OXa) (OCc := OCc) (OAa := OAa) (OBb := OBb) (OYy := OYy) (OX2 := OX2) (OB3 := OB3) (OY2 := OY2) (OB4 := OB4) u) ⟶ obj (OXa := OXa) (OCc := OCc) (OAa := OAa) (OBb := OBb) (OYy := OYy) (OX2 := OX2) (OB3 := OB3) (OY2 := OY2) (OB4 := OB4) v
  | Aa, Aa => 𝟙 _
