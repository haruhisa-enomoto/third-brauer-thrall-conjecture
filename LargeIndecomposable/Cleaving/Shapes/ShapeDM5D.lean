module

public import LargeIndecomposable.Cleaving.Shapes.ShapeD6
public import LargeIndecomposable.Cleaving.Basic.Tools

/-!
# The tree diagram `DM5D`

`D̃₅` with spine `y → d`: two arrows into `y` and two arrows out of `d`.

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `DM5D`. -/
inductive DM5D
  | Yy | Dd | A | B | A2 | Z
  deriving DecidableEq

namespace DM5D

instance : Fintype DM5D := ⟨{Yy, Dd, A, B, A2, Z}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : DM5D → DM5D → Bool
  | A, Yy | B, Yy | Yy, Dd | Dd, A2 | Dd, Z => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : DM5D) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph DM5D := SimpleGraph.fromRel o

lemma adj_iff (u v : DM5D) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : DM5D) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : DM5D) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : DM5D) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : DM5D → Option DM5D
  | Yy => none
  | Dd => some Yy
  | A => some Yy
  | B => some Yy
  | A2 => some Dd
  | Z => some Dd

/-- The height. -/
def ht : DM5D → ℕ
  | Yy => 0
  | Dd => 1
  | A => 1
  | B => 1
  | A2 => 2
  | Z => 2

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `D̃`. -/
def cmap : AffineD 1 → DM5D
  | .spine j => if (j : ℕ) = 0 then Yy else Dd
  | .leaf i => if (i : ℕ) = 0 then A else if (i : ℕ) = 1 then B else if (i : ℕ) = 2 then A2 else Z

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `D̃`. -/
def copy : (underlyingGraph (AffineD 1)).Copy G :=
  copyD G 1 cmap (by
    intro u v h
    rcases u with i | j <;> rcases v with i' | j'
    · fin_cases i <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases i <;> fin_cases j' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases j' <;> simp_all [cmap])
    (fun i ↦ by
      fin_cases i
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide)
    (fun j j' h ↦ by fin_cases j <;> fin_cases j' <;> simp_all [cmap] <;> decide)

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {OYy ODd OA OB OA2 OZ : P}
  (α : OA ⟶ OYy) (β : OB ⟶ OYy) (ω₁ : OYy ⟶ ODd) (ω₂ : ODd ⟶ OA2) (φ : ODd ⟶ OZ)

/-- The objects. -/
def obj : DM5D → P
  | Yy => OYy | Dd => ODd | A => OA | B => OB | A2 => OA2 | Z => OZ

/-- The arrows. -/
def arr : ∀ u v : DM5D, o u v → ((obj (OYy := OYy) (ODd := ODd) (OA := OA) (OB := OB) (OA2 := OA2) (OZ := OZ) u) ⟶ obj (OYy := OYy) (ODd := ODd) (OA := OA) (OB := OB) (OA2 := OA2) (OZ := OZ) v)
  | A, Yy, _ => α
  | B, Yy, _ => β
  | Yy, Dd, _ => ω₁
  | Dd, A2, _ => ω₂
  | Dd, Z, _ => φ
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : DM5D, Option ((obj (OYy := OYy) (ODd := ODd) (OA := OA) (OB := OB) (OA2 := OA2) (OZ := OZ) u) ⟶ obj (OYy := OYy) (ODd := ODd) (OA := OA) (OB := OB) (OA2 := OA2) (OZ := OZ) v)
  | Yy, Yy => some (𝟙 _)
  | Yy, Dd => some (ω₁)
  | Yy, A2 => some (ω₁ ≫ ω₂)
  | Yy, Z => some (ω₁ ≫ φ)
  | Dd, Dd => some (𝟙 _)
  | Dd, A2 => some (ω₂)
  | Dd, Z => some (φ)
  | A, A => some (𝟙 _)
  | A, Yy => some (α)
  | A, Dd => some (α ≫ ω₁)
  | A, A2 => some ((α ≫ ω₁) ≫ ω₂)
  | A, Z => some ((α ≫ ω₁) ≫ φ)
  | B, B => some (𝟙 _)
  | B, Yy => some (β)
  | B, Dd => some (β ≫ ω₁)
  | B, A2 => some ((β ≫ ω₁) ≫ ω₂)
  | B, Z => some ((β ≫ ω₁) ≫ φ)
  | A2, A2 => some (𝟙 _)
  | Z, Z => some (𝟙 _)
  | _, _ => none

end Diagram

end DM5D

end RayCat

namespace RayCat

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type u} [Field k] [Infinite k]

set_option maxHeartbeats 8000000 in
open DM5D in
/-- **No cleaving diagram `DM5D` in `P/τ`.** -/
theorem MildHyp.not_dm5d (hM : MildHyp k P)
    {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {OYy ODd OA OB OA2 OZ : P}
    (α : OA ⟶ OYy) (β : OB ⟶ OYy) (ω₁ : OYy ⟶ ODd) (ω₂ : ODd ⟶ OA2) (φ : ODd ⟶ OZ)
    (h0_Yy_Dd : ¬FactorsThroughMorphism τ (ω₁))
    (h0_Yy_A2 : ¬FactorsThroughMorphism τ (ω₁ ≫ ω₂))
    (h0_Yy_Z : ¬FactorsThroughMorphism τ (ω₁ ≫ φ))
    (h0_Dd_A2 : ¬FactorsThroughMorphism τ (ω₂))
    (h0_Dd_Z : ¬FactorsThroughMorphism τ (φ))
    (h0_A_Yy : ¬FactorsThroughMorphism τ (α))
    (h0_A_Dd : ¬FactorsThroughMorphism τ (α ≫ ω₁))
    (h0_A_A2 : ¬FactorsThroughMorphism τ ((α ≫ ω₁) ≫ ω₂))
    (h0_A_Z : ¬FactorsThroughMorphism τ ((α ≫ ω₁) ≫ φ))
    (h0_B_Yy : ¬FactorsThroughMorphism τ (β))
    (h0_B_Dd : ¬FactorsThroughMorphism τ (β ≫ ω₁))
    (h0_B_A2 : ¬FactorsThroughMorphism τ ((β ≫ ω₁) ≫ ω₂))
    (h0_B_Z : ¬FactorsThroughMorphism τ ((β ≫ ω₁) ≫ φ))
    (hi_α : ¬IsIso α)
    (hi_β : ¬IsIso β)
    (hi_ω₁ : ¬IsIso ω₁)
    (hi_ω₂ : ¬IsIso ω₂)
    (hi_φ : ¬IsIso φ)
    (hl_ω₂_φ_Z : ¬∃ g, ω₂ ≫ g = φ)
    (hl_φ_ω₂_A2 : ¬∃ g, φ ≫ g = ω₂)
    (hr_α_β_B : ¬∃ g, g ≫ α = β)
    (hr_β_α_A : ¬∃ g, g ≫ β = α)
    : False := by
  haveI : Fact (LargeIndecomposable.Foundations.Quiver.IsAcyclic (OT G o)) := ⟨OT.isAcyclic ho hasym isAcyclic⟩
  refine hM.not_tree_table τ hτ hτ0 G o ho hasym isAcyclic
    (OT.not_isRepresentationFinite_affineD ho hcov k 1 copy) obj (arr α β ω₁ ω₂ φ)
    (tab α β ω₁ ω₂ φ) (fun v ↦ by cases v <;> rfl) ?_ ?_ ?_ ?_ ?_
  · intro x y z h f hf
    cases y <;> cases z <;> (try exact absurd h (by decide)) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; rfl)
      | rfl
  · intro x y f hf hne
    cases x <;> cases y <;> (try exact absurd rfl hne) <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;> assumption
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | assumption
  · intro x c c' y h h' f hne hf
    cases x <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases y <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.comp_id]; assumption)
      | assumption
  · intro x c c' y h h' f hne hf
    cases y <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; assumption)
      | assumption

end RayCat

end LargeIndecomposable
