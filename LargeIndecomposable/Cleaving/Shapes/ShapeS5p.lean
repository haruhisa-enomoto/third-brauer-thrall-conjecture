module

public import LargeIndecomposable.Cleaving.Shapes.ShapeD6

/-!
# The tree diagram `S5p`

The `D̃₅` tree `m₁ → m → y₀`, `m → y₁ ← b'`, `te → y₁`.

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `S5p`. -/
inductive S5p
  | m | m₁ | y₀ | y₁ | b' | te
  deriving DecidableEq

namespace S5p

instance : Fintype S5p := ⟨{m, m₁, y₀, y₁, b', te}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : S5p → S5p → Bool
  | m₁, m | m, y₀ | m, y₁ | b', y₁ | te, y₁ => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : S5p) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph S5p := SimpleGraph.fromRel o

lemma adj_iff (u v : S5p) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : S5p) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : S5p) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : S5p) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : S5p → Option S5p
  | m => none
  | m₁ => some m
  | y₀ => some m
  | y₁ => some m
  | b' => some y₁
  | te => some y₁

/-- The height. -/
def ht : S5p → ℕ
  | m => 0
  | m₁ => 1
  | y₀ => 1
  | y₁ => 1
  | b' => 2
  | te => 2

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `D̃`. -/
def cmap : AffineD 1 → S5p
  | .spine j => if (j : ℕ) = 0 then m else y₁
  | .leaf i => if (i : ℕ) = 0 then m₁ else if (i : ℕ) = 1 then y₀ else if (i : ℕ) = 2 then b' else te

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `D̃`. -/
def copy : (underlyingGraph (AffineD 1)).Copy G :=
  copyD G 1 cmap (by
    intro u v h
    rcases u with i | j <;> rcases v with i' | j'
    · fin_cases i <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases i <;> fin_cases j' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases j' <;> simp_all [cmap])
    (fun i ↦ by
      fin_cases i
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide)
    (fun j j' h ↦ by fin_cases j <;> fin_cases j' <;> simp_all [cmap] <;> decide)

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {M M₁ Y₀ Y₁ B' Te : P}
  (p : M₁ ⟶ M) (U : M ⟶ Y₀) (U' : M ⟶ Y₁) (W' : B' ⟶ Y₁) (e : Te ⟶ Y₁)

/-- The objects. -/
def obj : S5p → P
  | m => M | m₁ => M₁ | y₀ => Y₀ | y₁ => Y₁ | b' => B' | te => Te

/-- The arrows. -/
def arr : ∀ u v : S5p, o u v → ((obj (M := M) (M₁ := M₁) (Y₀ := Y₀) (Y₁ := Y₁) (B' := B') (Te := Te) u) ⟶ obj (M := M) (M₁ := M₁) (Y₀ := Y₀) (Y₁ := Y₁) (B' := B') (Te := Te) v)
  | m₁, m, _ => p
  | m, y₀, _ => U
  | m, y₁, _ => U'
  | b', y₁, _ => W'
  | te, y₁, _ => e
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : S5p, Option ((obj (M := M) (M₁ := M₁) (Y₀ := Y₀) (Y₁ := Y₁) (B' := B') (Te := Te) u) ⟶ obj (M := M) (M₁ := M₁) (Y₀ := Y₀) (Y₁ := Y₁) (B' := B') (Te := Te) v)
  | m, m => some (𝟙 _)
  | m, y₀ => some (U)
  | m, y₁ => some (U')
  | m₁, m₁ => some (𝟙 _)
  | m₁, m => some (p)
  | m₁, y₀ => some (p ≫ U)
  | m₁, y₁ => some (p ≫ U')
  | y₀, y₀ => some (𝟙 _)
  | y₁, y₁ => some (𝟙 _)
  | b', b' => some (𝟙 _)
  | b', y₁ => some (W')
  | te, te => some (𝟙 _)
  | te, y₁ => some (e)
  | _, _ => none

end Diagram

end S5p

end RayCat

namespace RayQuiver

namespace MulBasis

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type u} [Field k] [Infinite k]
  {A : Type u} [Ring A] [Algebra k A] (B : MulBasis k P A)

set_option maxHeartbeats 8000000 in
open S5p in
include B in
/-- **No cleaving diagram `S5p` in `P/τ`.** -/
theorem not_s5p
    (hmin : ∀ I : TwoSidedIdeal A, I ≠ ⊥ → Statement.IsRepresentationFinite (A ⧸ I.asIdeal))
    (hL : LeftCancel P) (hR : RightCancel P) {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {M M₁ Y₀ Y₁ B' Te : P}
    (p : M₁ ⟶ M) (U : M ⟶ Y₀) (U' : M ⟶ Y₁) (W' : B' ⟶ Y₁) (e : Te ⟶ Y₁)
    (h0_m_y₀ : ¬FactorsThroughMorphism τ (U))
    (h0_m_y₁ : ¬FactorsThroughMorphism τ (U'))
    (h0_m₁_m : ¬FactorsThroughMorphism τ (p))
    (h0_m₁_y₀ : ¬FactorsThroughMorphism τ (p ≫ U))
    (h0_m₁_y₁ : ¬FactorsThroughMorphism τ (p ≫ U'))
    (h0_b'_y₁ : ¬FactorsThroughMorphism τ (W'))
    (h0_te_y₁ : ¬FactorsThroughMorphism τ (e))
    (hi_p : ¬IsIso p)
    (hi_U : ¬IsIso U)
    (hi_U' : ¬IsIso U')
    (hi_W' : ¬IsIso W')
    (hi_e : ¬IsIso e)
    (hl_U_U'_y₁ : ¬∃ g, U ≫ g = U')
    (hl_U'_U_y₀ : ¬∃ g, U' ≫ g = U)
    (hr_U'_W'_b' : ¬∃ g, g ≫ U' = W')
    (hr_U'_e_te : ¬∃ g, g ≫ U' = e)
    (hr_W'_U'_m : ¬∃ g, g ≫ W' = U')
    (hr_W'_U'_m₁ : ¬∃ g, g ≫ W' = p ≫ U')
    (hr_W'_e_te : ¬∃ g, g ≫ W' = e)
    (hr_e_U'_m : ¬∃ g, g ≫ e = U')
    (hr_e_U'_m₁ : ¬∃ g, g ≫ e = p ≫ U')
    (hr_e_W'_b' : ¬∃ g, g ≫ e = W')
    : False := by
  haveI : Fact (LargeIndecomposable.Foundations.Quiver.IsAcyclic (OT G o)) := ⟨OT.isAcyclic ho hasym isAcyclic⟩
  refine B.not_tree_table hmin hL hR τ hτ hτ0 G o ho hasym isAcyclic
    (OT.not_isRepresentationFinite_affineD ho hcov k 1 copy) obj (arr p U U' W' e)
    (tab p U U' W' e) (fun v ↦ by cases v <;> rfl) ?_ ?_ ?_ ?_ ?_
  · intro x y z h f hf
    cases y <;> cases z <;> (try exact absurd h (by decide)) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; rfl)
      | rfl
  · intro x y f hf hne
    cases x <;> cases y <;> (try exact absurd rfl hne) <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;> assumption
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | assumption
  · intro x c c' y h h' f hne hf
    cases x <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases y <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.comp_id]; assumption)
      | assumption
  · intro x c c' y h h' f hne hf
    cases y <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; assumption)
      | assumption

end MulBasis

end RayQuiver

end LargeIndecomposable
