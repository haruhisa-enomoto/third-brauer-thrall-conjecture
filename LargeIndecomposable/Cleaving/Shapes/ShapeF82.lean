namespace RayCat

/-- Vertices of the diagram `F82`. -/
inductive F82
  | B | xn | yn1 | y₀ | a | y₁ | z₂
  deriving DecidableEq

namespace F82

instance : Fintype F82 := ⟨{B, xn, yn1, y₀, a, y₁, z₂}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : F82 → F82 → Bool
  | xn, B | B, yn1 | B, y₀ | a, y₀ | a, y₁ | a, z₂ => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : F82) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph F82 := SimpleGraph.fromRel o

lemma adj_iff (u v : F82) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : F82) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : F82) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : F82) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : F82 → Option F82
  | B => none
  | xn => some B
  | yn1 => some B
  | y₀ => some B
  | a => some y₀
  | y₁ => some a
  | z₂ => some a

/-- The height. -/
def ht : F82 → ℕ
  | B => 0
  | xn => 1
  | yn1 => 1
  | y₀ => 1
  | a => 2
  | y₁ => 3
  | z₂ => 3

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `D̃`. -/
def cmap : AffineD 2 → F82
  | .spine j => if (j : ℕ) = 0 then B else if (j : ℕ) = 1 then y₀ else a
  | .leaf i => if (i : ℕ) = 0 then xn else if (i : ℕ) = 1 then yn1 else if (i : ℕ) = 2 then y₁ else z₂

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `D̃`. -/
def copy : (underlyingGraph (AffineD 2)).Copy G :=
  copyD G 2 cmap (by
    intro u v h
    rcases u with i | j <;> rcases v with i' | j'
    · fin_cases i <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases i <;> fin_cases j' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases j' <;> simp_all [cmap])
    (fun i ↦ by
      fin_cases i
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide)
    (fun j j' h ↦ by fin_cases j <;> fin_cases j' <;> simp_all [cmap] <;> decide)

section Diagram

