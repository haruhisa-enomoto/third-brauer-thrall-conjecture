/-- The arrows. -/
def arr : ∀ u v : F82, o u v → ((obj (Bb := Bb) (Xn := Xn) (Yn1 := Yn1) (Y₀ := Y₀) (Aa := Aa) (Y₁ := Y₁) (Z₂ := Z₂) u) ⟶ obj (Bb := Bb) (Xn := Xn) (Yn1 := Yn1) (Y₀ := Y₀) (Aa := Aa) (Y₁ := Y₁) (Z₂ := Z₂) v)
