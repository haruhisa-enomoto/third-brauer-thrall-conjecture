/-- The order (nonzero morphisms). -/
def leb : M44A → M44A → Bool
  | A, A | A, B | A, Bv | A, W | A, X1 | A, Y1 | B, B | B, W | B, Y1 | Bv, Bv | G, B | G, G | G, W | W, W | X1, W | X1, X1 | Y1, Y1 | Zp, Bv | Zp, Zp => true
  | _, _ => false

/-- The arrows. -/
def arb : M44A → M44A → Bool
  | A, B | A, Bv | A, X1 | B, W | B, Y1 | G, B | X1, W | Zp, Bv => true
  | _, _ => false

/-- The thin category. -/
abbrev thin : ThinData M44A where
  le x y := leb x y = true
  nz x _ z := leb x z = true
  refl x := by cases x <;> rfl
  antisymm := by decide
  nz_le _ _ _ _ _ h := h
  nz_left _ _ h := h
  nz_right _ _ h := h
  assoc := by decide

/-- The generating arrows. -/
abbrev arrows : ThinArrows thin where
  ar x y := arb x y = true
  ar_le := by decide
  ar_ne := by decide
  first := by decide
  last := by decide

