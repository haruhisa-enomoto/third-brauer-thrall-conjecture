module

public import LargeIndecomposable.Cleaving.Shapes.ShapeD6
public import LargeIndecomposable.Cleaving.Basic.Tools

/-!
# The tree diagram `PC2`

Open penny-farthing (`n = 2`): `Ẽ₇` centred at `t` (`a`, `b`, `γ`), arms `x → t ← w` (along `α a`, `δ`) and `x ← t → c` (along `b α`, `γ`).

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `PC2`. -/
inductive PC2
  | T1 | X0 | T2 | W2 | X2 | T0 | C0 | C1
  deriving DecidableEq

namespace PC2

instance : Fintype PC2 := ⟨{T1, X0, T2, W2, X2, T0, C0, C1}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : PC2 → PC2 → Bool
  | X0, T1 | X0, T2 | W2, T2 | T1, X2 | T0, X2 | T0, C0 | T1, C1 => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : PC2) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph PC2 := SimpleGraph.fromRel o

lemma adj_iff (u v : PC2) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : PC2) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : PC2) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : PC2) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : PC2 → Option PC2
  | T1 => none
  | X0 => some T1
  | T2 => some X0
  | W2 => some T2
  | X2 => some T1
  | T0 => some X2
  | C0 => some T0
  | C1 => some T1

/-- The height. -/
def ht : PC2 → ℕ
  | T1 => 0
  | X0 => 1
  | T2 => 2
  | W2 => 3
  | X2 => 1
  | T0 => 2
  | C0 => 3
  | C1 => 1

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `Ẽ₇` (long arms listed from the centre). -/
def cmap : AffineE7 → PC2
  | .center => T1
  | .short => C1
  | .inner i => if (i : ℕ) = 0 then X0 else X2
  | .middle i => if (i : ℕ) = 0 then T2 else T0
  | .outer i => if (i : ℕ) = 0 then W2 else C0

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `Ẽ₇`. -/
def copy : (underlyingGraph AffineE7).Copy G :=
  copyOf G cmap (by
    intro u v h
    rcases u with _ | _ | i | i | i <;> rcases v with _ | _ | j | j | j <;>
      (try fin_cases i) <;> (try fin_cases j) <;> simp_all [cmap])
    (by
      intro a b e
      change AffineE7.Arrow a b at e
      cases e with
      | outerMiddle i => fin_cases i <;> simp only [cmap] <;> decide
      | middleInner i => fin_cases i <;> simp only [cmap] <;> decide
      | innerCenter i => fin_cases i <;> simp only [cmap] <;> decide
      | shortCenter => simp only [cmap]; decide)

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {OT1 OX0 OT2 OW2 OX2 OT0 OC0 OC1 : P}
  (a : OX0 ⟶ OT1) (e : OX0 ⟶ OT2) (d : OW2 ⟶ OT2) (b : OT1 ⟶ OX2) (f : OT0 ⟶ OX2) (γ₀ : OT0 ⟶ OC0) (γ₁ : OT1 ⟶ OC1)

/-- The objects. -/
def obj : PC2 → P
  | T1 => OT1 | X0 => OX0 | T2 => OT2 | W2 => OW2 | X2 => OX2 | T0 => OT0 | C0 => OC0 | C1 => OC1

/-- The arrows. -/
def arr : ∀ u v : PC2, o u v → ((obj (OT1 := OT1) (OX0 := OX0) (OT2 := OT2) (OW2 := OW2) (OX2 := OX2) (OT0 := OT0) (OC0 := OC0) (OC1 := OC1) u) ⟶ obj (OT1 := OT1) (OX0 := OX0) (OT2 := OT2) (OW2 := OW2) (OX2 := OX2) (OT0 := OT0) (OC0 := OC0) (OC1 := OC1) v)
  | X0, T1, _ => a
  | X0, T2, _ => e
  | W2, T2, _ => d
  | T1, X2, _ => b
  | T0, X2, _ => f
  | T0, C0, _ => γ₀
  | T1, C1, _ => γ₁
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : PC2, Option ((obj (OT1 := OT1) (OX0 := OX0) (OT2 := OT2) (OW2 := OW2) (OX2 := OX2) (OT0 := OT0) (OC0 := OC0) (OC1 := OC1) u) ⟶ obj (OT1 := OT1) (OX0 := OX0) (OT2 := OT2) (OW2 := OW2) (OX2 := OX2) (OT0 := OT0) (OC0 := OC0) (OC1 := OC1) v)
  | T1, T1 => some (𝟙 _)
  | T1, X2 => some (b)
  | T1, C1 => some (γ₁)
  | X0, X0 => some (𝟙 _)
  | X0, T1 => some (a)
  | X0, X2 => some (a ≫ b)
  | X0, C1 => some (a ≫ γ₁)
  | X0, T2 => some (e)
  | T2, T2 => some (𝟙 _)
  | W2, W2 => some (𝟙 _)
  | W2, T2 => some (d)
  | X2, X2 => some (𝟙 _)
  | T0, T0 => some (𝟙 _)
  | T0, X2 => some (f)
  | T0, C0 => some (γ₀)
  | C0, C0 => some (𝟙 _)
  | C1, C1 => some (𝟙 _)
  | _, _ => none

end Diagram

end PC2

end RayCat

namespace RayCat

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type u} [Field k] [Infinite k]

set_option maxHeartbeats 8000000 in
open PC2 in
/-- **No cleaving diagram `PC2` in `P/τ`.** -/
theorem MildHyp.not_pc2 (hM : MildHyp k P)
    {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {OT1 OX0 OT2 OW2 OX2 OT0 OC0 OC1 : P}
    (a : OX0 ⟶ OT1) (e : OX0 ⟶ OT2) (d : OW2 ⟶ OT2) (b : OT1 ⟶ OX2) (f : OT0 ⟶ OX2) (γ₀ : OT0 ⟶ OC0) (γ₁ : OT1 ⟶ OC1)
    (h0_T1_X2 : ¬FactorsThroughMorphism τ (b))
    (h0_T1_C1 : ¬FactorsThroughMorphism τ (γ₁))
    (h0_X0_T1 : ¬FactorsThroughMorphism τ (a))
    (h0_X0_X2 : ¬FactorsThroughMorphism τ (a ≫ b))
    (h0_X0_C1 : ¬FactorsThroughMorphism τ (a ≫ γ₁))
    (h0_X0_T2 : ¬FactorsThroughMorphism τ (e))
    (h0_W2_T2 : ¬FactorsThroughMorphism τ (d))
    (h0_T0_X2 : ¬FactorsThroughMorphism τ (f))
    (h0_T0_C0 : ¬FactorsThroughMorphism τ (γ₀))
    (hi_a : ¬IsIso a)
    (hi_e : ¬IsIso e)
    (hi_d : ¬IsIso d)
    (hi_b : ¬IsIso b)
    (hi_f : ¬IsIso f)
    (hi_γ₀ : ¬IsIso γ₀)
    (hi_γ₁ : ¬IsIso γ₁)
    (hl_b_γ₁_C1 : ¬∃ g, b ≫ g = γ₁)
    (hl_γ₁_b_X2 : ¬∃ g, γ₁ ≫ g = b)
    (hl_a_e_T2 : ¬∃ g, a ≫ g = e)
    (hl_e_a_T1 : ¬∃ g, e ≫ g = a)
    (hl_e_a_X2 : ¬∃ g, e ≫ g = a ≫ b)
    (hl_e_a_C1 : ¬∃ g, e ≫ g = a ≫ γ₁)
    (hl_f_γ₀_C0 : ¬∃ g, f ≫ g = γ₀)
    (hl_γ₀_f_X2 : ¬∃ g, γ₀ ≫ g = f)
    (hr_e_d_W2 : ¬∃ g, g ≫ e = d)
    (hr_d_e_X0 : ¬∃ g, g ≫ d = e)
    (hr_b_f_T0 : ¬∃ g, g ≫ b = f)
    (hr_f_b_T1 : ¬∃ g, g ≫ f = b)
    (hr_f_b_X0 : ¬∃ g, g ≫ f = a ≫ b)
    : False := by
  haveI : Fact (LargeIndecomposable.Foundations.Quiver.IsAcyclic (OT G o)) := ⟨OT.isAcyclic ho hasym isAcyclic⟩
  refine hM.not_tree_table τ hτ hτ0 G o ho hasym isAcyclic
    (OT.not_isRepresentationFinite_affineE7 ho hcov k copy) obj (arr a e d b f γ₀ γ₁)
    (tab a e d b f γ₀ γ₁) (fun v ↦ by cases v <;> rfl) ?_ ?_ ?_ ?_ ?_
  · intro x y z h f hf
    cases y <;> cases z <;> (try exact absurd h (by decide)) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; rfl)
      | rfl
  · intro x y f hf hne
    cases x <;> cases y <;> (try exact absurd rfl hne) <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;> assumption
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | assumption
  · intro x c c' y h h' f hne hf
    cases x <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases y <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.comp_id]; assumption)
      | assumption
  · intro x c c' y h h' f hne hf
    cases y <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; assumption)
      | assumption

end RayCat

end LargeIndecomposable
