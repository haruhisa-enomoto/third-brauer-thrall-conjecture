/-- Vertices of the diagram `F95B`. -/
inductive F95B
  | a | m | x | wm | xn | y₁ | x₂ | y₂ | x₃
  deriving DecidableEq

namespace F95B

instance : Fintype F95B := ⟨{a, m, x, wm, xn, y₁, x₂, y₂, x₃}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : F95B → F95B → Bool
  | a, m | x, a | x, wm | xn, a | xn, y₁ | x₂, y₁ | x₂, y₂ | x₃, y₂ => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : F95B) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph F95B := SimpleGraph.fromRel o

lemma adj_iff (u v : F95B) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : F95B) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : F95B) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : F95B) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : F95B → Option F95B
  | a => none
  | m => some a
  | x => some a
  | wm => some x
  | xn => some a
  | y₁ => some xn
  | x₂ => some y₁
  | y₂ => some x₂
  | x₃ => some y₂

/-- The height. -/
def ht : F95B → ℕ
  | a => 0
  | m => 1
  | x => 1
  | wm => 2
  | xn => 1
  | y₁ => 2
  | x₂ => 3
  | y₂ => 4
  | x₃ => 5

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

