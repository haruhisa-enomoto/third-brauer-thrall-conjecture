def cmap : AffineE8 → F95B
  | .center => a
  | .short => m
  | .medium4 => x
  | .medium2 => wm
  | .long5 => xn
  | .long4 => y₁
  | .long3 => x₂
  | .long2 => y₂
  | .long1 => x₃

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `Ẽ₈`. -/
def copy : (underlyingGraph AffineE8).Copy G :=
  copyOf G cmap (by
    intro u v h
    cases u <;> cases v <;> simp_all [cmap])
    (by
      intro a b e
      change AffineE8.Arrow a b at e
      cases e <;> simp only [cmap] <;> decide)

