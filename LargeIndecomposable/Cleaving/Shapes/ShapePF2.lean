/-!
# The tree diagram `MPF2`

[mild] figure 2.4 (second diagram): `y₁ →α y₂ →α y₃ →α y₄` with `y₂ →δ t'`, `t →β y₃`.

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `MPF2`. -/
inductive MPF2
  | y2 | y1 | tb | y3 | y4 | t
  deriving DecidableEq

namespace MPF2

instance : Fintype MPF2 := ⟨{y2, y1, tb, y3, y4, t}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : MPF2 → MPF2 → Bool
  | y1, y2 | y2, y3 | y3, y4 | y2, tb | t, y3 => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : MPF2) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph MPF2 := SimpleGraph.fromRel o

lemma adj_iff (u v : MPF2) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : MPF2) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : MPF2) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : MPF2) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : MPF2 → Option MPF2
  | y2 => none
  | y1 => some y2
  | tb => some y2
  | y3 => some y2
  | y4 => some y3
  | t => some y3

/-- The height. -/
def ht : MPF2 → ℕ
  | y2 => 0
  | y1 => 1
  | tb => 1
  | y3 => 1
  | y4 => 2
  | t => 2

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `D̃`. -/
def cmap : AffineD 1 → MPF2
  | .spine j => if (j : ℕ) = 0 then y2 else y3
  | .leaf i => if (i : ℕ) = 0 then y1 else if (i : ℕ) = 1 then tb else if (i : ℕ) = 2 then y4 else t

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `D̃`. -/
def copy : (underlyingGraph (AffineD 1)).Copy G :=
  copyD G 1 cmap (by
    intro u v h
    rcases u with i | j <;> rcases v with i' | j'
    · fin_cases i <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases i <;> fin_cases j' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases j' <;> simp_all [cmap])
    (fun i ↦ by
      fin_cases i
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide)
    (fun j j' h ↦ by fin_cases j <;> fin_cases j' <;> simp_all [cmap] <;> decide)

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {Y₂ Y₁ Tb Y₃ Y₄ T : P}
  (α₁ : Y₁ ⟶ Y₂) (α₂ : Y₂ ⟶ Y₃) (α₃ : Y₃ ⟶ Y₄) (δ : Y₂ ⟶ Tb) (β : T ⟶ Y₃)

/-- The objects. -/
def obj : MPF2 → P
  | y2 => Y₂ | y1 => Y₁ | tb => Tb | y3 => Y₃ | y4 => Y₄ | t => T

/-- The arrows. -/
def arr : ∀ u v : MPF2, o u v → ((obj (Y₂ := Y₂) (Y₁ := Y₁) (Tb := Tb) (Y₃ := Y₃) (Y₄ := Y₄) (T := T) u) ⟶ obj (Y₂ := Y₂) (Y₁ := Y₁) (Tb := Tb) (Y₃ := Y₃) (Y₄ := Y₄) (T := T) v)
  | y1, y2, _ => α₁
  | y2, y3, _ => α₂
  | y3, y4, _ => α₃
  | y2, tb, _ => δ
  | t, y3, _ => β
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : MPF2, Option ((obj (Y₂ := Y₂) (Y₁ := Y₁) (Tb := Tb) (Y₃ := Y₃) (Y₄ := Y₄) (T := T) u) ⟶ obj (Y₂ := Y₂) (Y₁ := Y₁) (Tb := Tb) (Y₃ := Y₃) (Y₄ := Y₄) (T := T) v)
  | y2, y2 => some (𝟙 _)
  | y2, y3 => some (α₂)
  | y2, y4 => some (α₂ ≫ α₃)
  | y2, tb => some (δ)
  | y1, y1 => some (𝟙 _)
  | y1, y2 => some (α₁)
  | y1, y3 => some (α₁ ≫ α₂)
  | y1, y4 => some ((α₁ ≫ α₂) ≫ α₃)
  | y1, tb => some (α₁ ≫ δ)
  | tb, tb => some (𝟙 _)
  | y3, y3 => some (𝟙 _)
  | y3, y4 => some (α₃)
  | y4, y4 => some (𝟙 _)
  | t, t => some (𝟙 _)
  | t, y3 => some (β)
  | t, y4 => some (β ≫ α₃)
  | _, _ => none

end Diagram

