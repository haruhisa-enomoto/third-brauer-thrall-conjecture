/-- **No cleaving diagram `F612` in `P/τ`.** -/
theorem not_f612
    (hmin : ∀ I : TwoSidedIdeal A, I ≠ ⊥ → Statement.IsRepresentationFinite (A ⧸ I.asIdeal))
    (hL : LeftCancel P) (hR : RightCancel P) {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {X' Zn Bb Y₀ M Z₂ Y₁ B' X'' : P}
    (σn : X' ⟶ Zn) (r : X' ⟶ Bb) (W : Bb ⟶ Y₀) (U : M ⟶ Y₀) (ρ₂' : M ⟶ Z₂) (U' : M ⟶ Y₁) (W' : B' ⟶ Y₁) (t : X'' ⟶ M)
    (hD : ¬Statement.IsRepresentationFinite (Linearization (ThinCat thin) k))
    (hz0 : t ≫ U = 0)
    (h0_b_y₀ : ¬FactorsThroughMorphism τ (W))
    (h0_b'_y₁ : ¬FactorsThroughMorphism τ (W'))
    (h0_m_y₀ : ¬FactorsThroughMorphism τ (U))
    (h0_m_y₁ : ¬FactorsThroughMorphism τ (U'))
    (h0_m_z₂ : ¬FactorsThroughMorphism τ (ρ₂'))
    (h0_x'_b : ¬FactorsThroughMorphism τ (r))
    (h0_x'_y₀ : ¬FactorsThroughMorphism τ (r ≫ W))
    (h0_x'_zn : ¬FactorsThroughMorphism τ (σn))
    (h0_x''_m : ¬FactorsThroughMorphism τ (t))
    (h0_x''_y₁ : ¬FactorsThroughMorphism τ (t ≫ U'))
    (h0_x''_z₂ : ¬FactorsThroughMorphism τ (t ≫ ρ₂'))
    (hi_σn : ¬IsIso σn)
    (hi_r : ¬IsIso r)
    (hi_W : ¬IsIso W)
    (hi_U : ¬IsIso U)
    (hi_ρ₂' : ¬IsIso ρ₂')
    (hi_U' : ¬IsIso U')
    (hi_W' : ¬IsIso W')
    (hi_t : ¬IsIso t)
    (hlft_m_y₀_z₂ : ¬∃ g, U ≫ g = ρ₂')
    (hlft_m_y₀_y₁ : ¬∃ g, U ≫ g = U')
    (hlft_m_y₁_y₀ : ¬∃ g, U' ≫ g = U)
    (hlft_m_y₁_z₂ : ¬∃ g, U' ≫ g = ρ₂')
    (hlft_m_z₂_y₀ : ¬∃ g, ρ₂' ≫ g = U)
    (hlft_m_z₂_y₁ : ¬∃ g, ρ₂' ≫ g = U')
    (hlft_x'_b_zn : ¬∃ g, r ≫ g = σn)
    (hlft_x'_zn_b : ¬∃ g, σn ≫ g = r)
    (hlft_x'_zn_y₀ : ¬∃ g, σn ≫ g = r ≫ W)
    (hrgt_m_b_y₀ : ¬∃ g, g ≫ W = U)
    (hrgt_m_b'_y₁ : ¬∃ g, g ≫ W' = U')
    (hrgt_x''_b'_y₁ : ¬∃ g, g ≫ W' = t ≫ U')
    (hrgt_x'_m_y₀ : ¬∃ g, g ≫ U = r ≫ W)
    (hrgt_b_m_y₀ : ¬∃ g, g ≫ U = W)
    (hrgt_b'_m_y₁ : ¬∃ g, g ≫ U' = W')
    : False := by
  have hlft_b_y₀_b : ¬∃ g, W ≫ g = 𝟙 _ := not_split_mono hi_W
  have hlft_b'_y₁_b' : ¬∃ g, W' ≫ g = 𝟙 _ := not_split_mono hi_W'
  have hlft_m_y₀_m : ¬∃ g, U ≫ g = 𝟙 _ := not_split_mono hi_U
  have hlft_m_y₁_m : ¬∃ g, U' ≫ g = 𝟙 _ := not_split_mono hi_U'
  have hlft_m_z₂_m : ¬∃ g, ρ₂' ≫ g = 𝟙 _ := not_split_mono hi_ρ₂'
  have hlft_x'_b_x' : ¬∃ g, r ≫ g = 𝟙 _ := not_split_mono hi_r
  have hlft_x'_zn_x' : ¬∃ g, σn ≫ g = 𝟙 _ := not_split_mono hi_σn
  have hlft_x''_m_x'' : ¬∃ g, t ≫ g = 𝟙 _ := not_split_mono hi_t
  have hrgt_y₀_b_y₀ : ¬∃ g, g ≫ W = 𝟙 _ := not_split_epi hi_W
  have hrgt_y₁_b'_y₁ : ¬∃ g, g ≫ W' = 𝟙 _ := not_split_epi hi_W'
  have hrgt_y₀_m_y₀ : ¬∃ g, g ≫ U = 𝟙 _ := not_split_epi hi_U
  have hrgt_y₁_m_y₁ : ¬∃ g, g ≫ U' = 𝟙 _ := not_split_epi hi_U'
  have hrgt_z₂_m_z₂ : ¬∃ g, g ≫ ρ₂' = 𝟙 _ := not_split_epi hi_ρ₂'
  have hrgt_b_x'_b : ¬∃ g, g ≫ r = 𝟙 _ := not_split_epi hi_r
  have hrgt_zn_x'_zn : ¬∃ g, g ≫ σn = 𝟙 _ := not_split_epi hi_σn
  have hrgt_m_x''_m : ¬∃ g, g ≫ t = 𝟙 _ := not_split_epi hi_t
  have hz0' := reassoc_of% hz0
  refine B.not_thin_diagram hmin hL hR τ hτ hτ0 hD arrows obj (fun x y _ ↦ tab σn r W U ρ₂' U' W' t x y)
    (fun x ↦ by cases x <;> rfl) ?_ ?_ ?_ ?_
  · intro x y z h h'
    cases x <;> cases y <;> (try exact absurd h (by decide)) <;> cases z <;>
      (try exact absurd h' (by decide)) <;> split_ifs with hn <;>
      (try exact absurd hn (by decide)) <;>
      simp only [tab, Category.assoc, Category.id_comp, Category.comp_id, zero_comp, comp_zero, hz0', hz0]
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | exact not_factorsThrough_id hτ _
      | assumption
  · intro x z y ha hy
    cases x <;> cases z <;> (try exact absurd ha (by decide)) <;> cases y <;>
      (try exact absurd hy (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›
  · intro x z y ha hx
    cases z <;> cases y <;> (try exact absurd ha (by decide)) <;> cases x <;>
      (try exact absurd hx (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›

