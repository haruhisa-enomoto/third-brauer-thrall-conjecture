instance : Fintype F612 := ⟨{x', zn, b, y₀, m, z₂, y₁, b', x''}, by intro v; cases v <;> simp⟩

/-- The order (nonzero morphisms). -/
def leb : F612 → F612 → Bool
  | b, b | b, y₀ | b', b' | b', y₁ | m, m | m, y₀ | m, y₁ | m, z₂ | x', b | x', x' | x', y₀ | x', zn | x'', m | x'', x'' | x'', y₁ | x'', z₂ | y₀, y₀ | y₁, y₁ | zn, zn | z₂, z₂ => true
  | _, _ => false

/-- The arrows. -/
def arb : F612 → F612 → Bool
  | b, y₀ | b', y₁ | m, y₀ | m, y₁ | m, z₂ | x', b | x', zn | x'', m => true
  | _, _ => false

/-- The thin category. -/
abbrev thin : ThinData F612 where
  le x y := leb x y = true
  nz x _ z := leb x z = true
  refl x := by cases x <;> rfl
  antisymm := by decide
  nz_le _ _ _ _ _ h := h
  nz_left _ _ h := h
  nz_right _ _ h := h
  assoc := by decide

/-- The generating arrows. -/
abbrev arrows : ThinArrows thin where
  ar x y := arb x y = true
  ar_le := by decide
  ar_ne := by decide
  first := by decide
  last := by decide

