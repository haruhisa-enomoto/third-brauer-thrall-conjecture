variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type*} [Field k] [Infinite k]

set_option maxHeartbeats 16000000 in
open PC8 in
/-- **No cleaving diagram `PC8` in `P/τ`.** -/
theorem MildHyp.not_pc8 (hM : MildHyp k P) {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {OX1 OX2 OT0 OT1 OC1 : P}
    (α₁ : OX1 ⟶ OX2) (b₀ : OT0 ⟶ OX1) (u : OT0 ⟶ OC1) (b₁ : OT1 ⟶ OX2) (γ : OT1 ⟶ OC1)
    (hD : ¬Statement.IsRepresentationFinite (Linearization (ThinCat thin) k))
    (h0_T0_C1 : ¬FactorsThroughMorphism τ (u))
    (h0_T0_X1 : ¬FactorsThroughMorphism τ (b₀))
    (h0_T0_X2 : ¬FactorsThroughMorphism τ (b₀ ≫ α₁))
    (h0_T1_C1 : ¬FactorsThroughMorphism τ (γ))
    (h0_T1_X2 : ¬FactorsThroughMorphism τ (b₁))
    (h0_X1_X2 : ¬FactorsThroughMorphism τ (α₁))
    (hi_α₁ : ¬IsIso α₁)
    (hi_b₀ : ¬IsIso b₀)
    (hi_u : ¬IsIso u)
    (hi_b₁ : ¬IsIso b₁)
    (hi_γ : ¬IsIso γ)
    (hlft_T0_C1_X1 : ¬∃ g, u ≫ g = b₀)
    (hlft_T0_C1_X2 : ¬∃ g, u ≫ g = b₀ ≫ α₁)
    (hlft_T0_X1_C1 : ¬∃ g, b₀ ≫ g = u)
    (hlft_T1_C1_X2 : ¬∃ g, γ ≫ g = b₁)
    (hlft_T1_X2_C1 : ¬∃ g, b₁ ≫ g = γ)
    (hrgt_T1_T0_C1 : ¬∃ g, g ≫ u = γ)
    (hrgt_T0_T1_C1 : ¬∃ g, g ≫ γ = u)
    (hrgt_X1_T1_X2 : ¬∃ g, g ≫ b₁ = α₁)
    (hrgt_T0_T1_X2 : ¬∃ g, g ≫ b₁ = b₀ ≫ α₁)
    (hrgt_T1_X1_X2 : ¬∃ g, g ≫ α₁ = b₁)
    : False := by
  have hlft_T0_C1_T0 : ¬∃ g, u ≫ g = 𝟙 _ := not_split_mono hi_u
  have hlft_T0_X1_T0 : ¬∃ g, b₀ ≫ g = 𝟙 _ := not_split_mono hi_b₀
  have hlft_T1_C1_T1 : ¬∃ g, γ ≫ g = 𝟙 _ := not_split_mono hi_γ
  have hlft_T1_X2_T1 : ¬∃ g, b₁ ≫ g = 𝟙 _ := not_split_mono hi_b₁
  have hlft_X1_X2_X1 : ¬∃ g, α₁ ≫ g = 𝟙 _ := not_split_mono hi_α₁
  have hrgt_C1_T0_C1 : ¬∃ g, g ≫ u = 𝟙 _ := not_split_epi hi_u
  have hrgt_X1_T0_X1 : ¬∃ g, g ≫ b₀ = 𝟙 _ := not_split_epi hi_b₀
  have hrgt_C1_T1_C1 : ¬∃ g, g ≫ γ = 𝟙 _ := not_split_epi hi_γ
  have hrgt_X2_T1_X2 : ¬∃ g, g ≫ b₁ = 𝟙 _ := not_split_epi hi_b₁
  have hrgt_X2_X1_X2 : ¬∃ g, g ≫ α₁ = 𝟙 _ := not_split_epi hi_α₁
  refine hM.not_thin_diagram τ hτ hτ0 hD arrows obj (fun x y _ ↦ tab α₁ b₀ u b₁ γ x y)
    (fun x ↦ by cases x <;> rfl) ?_ ?_ ?_ ?_
  · intro x y z h h'
    cases x <;> cases y <;> (try exact absurd h (by decide)) <;> cases z <;>
      (try exact absurd h' (by decide)) <;> split_ifs with hn <;>
      (try exact absurd hn (by decide)) <;>
      simp only [tab, Category.assoc, Category.id_comp, Category.comp_id, zero_comp, comp_zero]
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | exact not_factorsThrough_id hτ _
      | assumption
  · intro x z y ha hy
    cases x <;> cases z <;> (try exact absurd ha (by decide)) <;> cases y <;>
      (try exact absurd hy (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›
  · intro x z y ha hx
    cases z <;> cases y <;> (try exact absurd ha (by decide)) <;> cases x <;>
      (try exact absurd hx (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›

end RayCat

