namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `PC8`. -/
inductive PC8
  | X1 | X2 | T0 | T1 | C1
  deriving DecidableEq

namespace PC8

instance : Fintype PC8 := ⟨{X1, X2, T0, T1, C1}, by intro v; cases v <;> simp⟩

/-- The order (nonzero morphisms). -/
def leb : PC8 → PC8 → Bool
  | C1, C1 | T0, C1 | T0, T0 | T0, X1 | T0, X2 | T1, C1 | T1, T1 | T1, X2 | X1, X1 | X1, X2 | X2, X2 => true
  | _, _ => false

/-- The arrows. -/
def arb : PC8 → PC8 → Bool
  | T0, C1 | T0, X1 | T1, C1 | T1, X2 | X1, X2 => true
  | _, _ => false

/-- The thin category. -/
abbrev thin : ThinData PC8 where
  le x y := leb x y = true
  nz x _ z := leb x z = true
  refl x := by cases x <;> rfl
  antisymm := by decide
  nz_le _ _ _ _ _ h := h
  nz_left _ _ h := h
  nz_right _ _ h := h
  assoc := by decide

/-- The generating arrows. -/
abbrev arrows : ThinArrows thin where
  ar x y := arb x y = true
  ar_le := by decide
  ar_ne := by decide
  first := by decide
  last := by decide

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {OX1 OX2 OT0 OT1 OC1 : P}
  (α₁ : OX1 ⟶ OX2) (b₀ : OT0 ⟶ OX1) (u : OT0 ⟶ OC1) (b₁ : OT1 ⟶ OX2) (γ : OT1 ⟶ OC1)

/-- The objects. -/
abbrev obj : PC8 → P
  | X1 => OX1 | X2 => OX2 | T0 => OT0 | T1 => OT1 | C1 => OC1

/-- The morphisms. -/
abbrev tab : ∀ u v : PC8, (obj (OX1 := OX1) (OX2 := OX2) (OT0 := OT0) (OT1 := OT1) (OC1 := OC1) u) ⟶ obj (OX1 := OX1) (OX2 := OX2) (OT0 := OT0) (OT1 := OT1) (OC1 := OC1) v
  | C1, C1 => 𝟙 _
  | T0, C1 => u
  | T0, T0 => 𝟙 _
  | T0, X1 => b₀
  | T0, X2 => b₀ ≫ α₁
  | T1, C1 => γ
  | T1, T1 => 𝟙 _
  | T1, X2 => b₁
  | X1, X1 => 𝟙 _
  | X1, X2 => α₁
  | X2, X2 => 𝟙 _
  | _, _ => 0

end Diagram

