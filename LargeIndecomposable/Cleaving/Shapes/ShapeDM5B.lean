/-!
# The tree diagram `DM5B`

`D̃₅` with spine `p₁ → p₂`, an arrow into and an arrow out of each spine vertex ([mild] figure 2.6, first and third diagrams).

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `DM5B`. -/
inductive DM5B
  | P1 | P2 | P0 | Q1 | Q2 | P3
  deriving DecidableEq

namespace DM5B

instance : Fintype DM5B := ⟨{P1, P2, P0, Q1, Q2, P3}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : DM5B → DM5B → Bool
  | P0, P1 | P1, Q1 | P1, P2 | Q2, P2 | P2, P3 => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : DM5B) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph DM5B := SimpleGraph.fromRel o

lemma adj_iff (u v : DM5B) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : DM5B) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : DM5B) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : DM5B) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : DM5B → Option DM5B
  | P1 => none
  | P2 => some P1
  | P0 => some P1
  | Q1 => some P1
  | Q2 => some P2
  | P3 => some P2

/-- The height. -/
def ht : DM5B → ℕ
  | P1 => 0
  | P2 => 1
  | P0 => 1
  | Q1 => 1
  | Q2 => 2
  | P3 => 2

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `D̃`. -/
def cmap : AffineD 1 → DM5B
  | .spine j => if (j : ℕ) = 0 then P1 else P2
  | .leaf i => if (i : ℕ) = 0 then P0 else if (i : ℕ) = 1 then Q1 else if (i : ℕ) = 2 then Q2 else P3

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `D̃`. -/
def copy : (underlyingGraph (AffineD 1)).Copy G :=
  copyD G 1 cmap (by
    intro u v h
    rcases u with i | j <;> rcases v with i' | j'
    · fin_cases i <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases i <;> fin_cases j' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases j' <;> simp_all [cmap])
    (fun i ↦ by
      fin_cases i
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide)
    (fun j j' h ↦ by fin_cases j <;> fin_cases j' <;> simp_all [cmap] <;> decide)

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {OP1 OP2 OP0 OQ1 OQ2 OP3 : P}
  (f : OP0 ⟶ OP1) (d : OP1 ⟶ OQ1) (s : OP1 ⟶ OP2) (β : OQ2 ⟶ OP2) (e : OP2 ⟶ OP3)

/-- The objects. -/
def obj : DM5B → P
  | P1 => OP1 | P2 => OP2 | P0 => OP0 | Q1 => OQ1 | Q2 => OQ2 | P3 => OP3

/-- The arrows. -/
def arr : ∀ u v : DM5B, o u v → ((obj (OP1 := OP1) (OP2 := OP2) (OP0 := OP0) (OQ1 := OQ1) (OQ2 := OQ2) (OP3 := OP3) u) ⟶ obj (OP1 := OP1) (OP2 := OP2) (OP0 := OP0) (OQ1 := OQ1) (OQ2 := OQ2) (OP3 := OP3) v)
  | P0, P1, _ => f
  | P1, Q1, _ => d
  | P1, P2, _ => s
  | Q2, P2, _ => β
  | P2, P3, _ => e
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : DM5B, Option ((obj (OP1 := OP1) (OP2 := OP2) (OP0 := OP0) (OQ1 := OQ1) (OQ2 := OQ2) (OP3 := OP3) u) ⟶ obj (OP1 := OP1) (OP2 := OP2) (OP0 := OP0) (OQ1 := OQ1) (OQ2 := OQ2) (OP3 := OP3) v)
  | P1, P1 => some (𝟙 _)
  | P1, Q1 => some (d)
  | P1, P2 => some (s)
  | P1, P3 => some (s ≫ e)
  | P2, P2 => some (𝟙 _)
  | P2, P3 => some (e)
  | P0, P0 => some (𝟙 _)
  | P0, P1 => some (f)
  | P0, Q1 => some (f ≫ d)
  | P0, P2 => some (f ≫ s)
  | P0, P3 => some ((f ≫ s) ≫ e)
  | Q1, Q1 => some (𝟙 _)
  | Q2, Q2 => some (𝟙 _)
  | Q2, P2 => some (β)
  | Q2, P3 => some (β ≫ e)
  | P3, P3 => some (𝟙 _)
  | _, _ => none

end Diagram

end DM5B

end RayCat

namespace RayCat

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type u} [Field k] [Infinite k]

set_option maxHeartbeats 8000000 in
open DM5B in
/-- **No cleaving diagram `DM5B` in `P/τ`.** -/
theorem MildHyp.not_dm5b (hM : MildHyp k P)
    {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {OP1 OP2 OP0 OQ1 OQ2 OP3 : P}
    (f : OP0 ⟶ OP1) (d : OP1 ⟶ OQ1) (s : OP1 ⟶ OP2) (β : OQ2 ⟶ OP2) (e : OP2 ⟶ OP3)
    (h0_P1_Q1 : ¬FactorsThroughMorphism τ (d))
    (h0_P1_P2 : ¬FactorsThroughMorphism τ (s))
    (h0_P1_P3 : ¬FactorsThroughMorphism τ (s ≫ e))
    (h0_P2_P3 : ¬FactorsThroughMorphism τ (e))
    (h0_P0_P1 : ¬FactorsThroughMorphism τ (f))
    (h0_P0_Q1 : ¬FactorsThroughMorphism τ (f ≫ d))
    (h0_P0_P2 : ¬FactorsThroughMorphism τ (f ≫ s))
    (h0_P0_P3 : ¬FactorsThroughMorphism τ ((f ≫ s) ≫ e))
    (h0_Q2_P2 : ¬FactorsThroughMorphism τ (β))
    (h0_Q2_P3 : ¬FactorsThroughMorphism τ (β ≫ e))
    (hi_f : ¬IsIso f)
    (hi_d : ¬IsIso d)
    (hi_s : ¬IsIso s)
    (hi_β : ¬IsIso β)
    (hi_e : ¬IsIso e)
    (hl_d_s_P2 : ¬∃ g, d ≫ g = s)
    (hl_d_s_P3 : ¬∃ g, d ≫ g = s ≫ e)
    (hl_s_d_Q1 : ¬∃ g, s ≫ g = d)
    (hr_s_β_Q2 : ¬∃ g, g ≫ s = β)
    (hr_β_s_P1 : ¬∃ g, g ≫ β = s)
    (hr_β_s_P0 : ¬∃ g, g ≫ β = f ≫ s)
    : False := by
  haveI : Fact (LargeIndecomposable.Foundations.Quiver.IsAcyclic (OT G o)) := ⟨OT.isAcyclic ho hasym isAcyclic⟩
  refine hM.not_tree_table τ hτ hτ0 G o ho hasym isAcyclic
    (OT.not_isRepresentationFinite_affineD ho hcov k 1 copy) obj (arr f d s β e)
    (tab f d s β e) (fun v ↦ by cases v <;> rfl) ?_ ?_ ?_ ?_ ?_
  · intro x y z h f hf
    cases y <;> cases z <;> (try exact absurd h (by decide)) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; rfl)
      | rfl
  · intro x y f hf hne
    cases x <;> cases y <;> (try exact absurd rfl hne) <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;> assumption
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | assumption
  · intro x c c' y h h' f hne hf
    cases x <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases y <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.comp_id]; assumption)
      | assumption
  · intro x c c' y h h' f hne hf
    cases y <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; assumption)
      | assumption

end RayCat

