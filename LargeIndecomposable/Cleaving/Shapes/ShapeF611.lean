namespace F611

instance : Fintype F611 := ⟨{x, m, b', y₁, b, x', x'', z₂}, by intro v; cases v <;> simp⟩

/-- The order (nonzero morphisms). -/
def leb : F611 → F611 → Bool
  | b, b | b', b' | b', y₁ | m, m | m, y₁ | x, b | x, b' | x, m | x, x | x, y₁ | x', b | x', x' | x'', m | x'', x'' | x'', y₁ | x'', z₂ | y₁, y₁ | z₂, z₂ => true
  | _, _ => false

/-- The arrows. -/
def arb : F611 → F611 → Bool
  | b', y₁ | m, y₁ | x, b | x, b' | x, m | x', b | x'', m | x'', z₂ => true
  | _, _ => false

/-- The thin category. -/
abbrev thin : ThinData F611 where
  le x y := leb x y = true
  nz x _ z := leb x z = true
  refl x := by cases x <;> rfl
  antisymm := by decide
  nz_le _ _ _ _ _ h := h
  nz_left _ _ h := h
  nz_right _ _ h := h
  assoc := by decide

/-- The generating arrows. -/
abbrev arrows : ThinArrows thin where
  ar x y := arb x y = true
  ar_le := by decide
  ar_ne := by decide
  first := by decide
  last := by decide

