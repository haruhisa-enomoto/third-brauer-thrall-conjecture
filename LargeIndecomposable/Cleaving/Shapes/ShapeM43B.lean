/-- **No cleaving diagram `M43B` in `P/τ`.** -/
theorem MildHyp.not_m43b (hM : MildHyp k P) {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {XZ XX1 XW XA XB XBb XD1 XG XZ2 : P}
    (δ : XZ ⟶ XX1) (β : XX1 ⟶ XW) (ρ : XA ⟶ XB) (ε : XA ⟶ XBb) (a : XA ⟶ XX1) (ρ' : XB ⟶ XW) (a' : XB ⟶ XD1) (β' : XG ⟶ XB) (δ' : XZ2 ⟶ XD1)
    (hD : ¬Statement.IsRepresentationFinite (Linearization (ThinCat thin) k))
    (hc0 : a ≫ β = ρ ≫ ρ')
    (hz0 : β' ≫ a' = 0)
    (hz1 : δ ≫ β = 0)
    (h0_A_B : ¬FactorsThroughMorphism τ (ρ))
    (h0_A_Bb : ¬FactorsThroughMorphism τ (ε))
    (h0_A_D1 : ¬FactorsThroughMorphism τ (ρ ≫ a'))
    (h0_A_W : ¬FactorsThroughMorphism τ (ρ ≫ ρ'))
    (h0_A_X1 : ¬FactorsThroughMorphism τ (a))
    (h0_B_D1 : ¬FactorsThroughMorphism τ (a'))
    (h0_B_W : ¬FactorsThroughMorphism τ (ρ'))
    (h0_G_B : ¬FactorsThroughMorphism τ (β'))
