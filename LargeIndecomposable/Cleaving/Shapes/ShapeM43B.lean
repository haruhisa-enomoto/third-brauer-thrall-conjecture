    (h0_Z2_D1 : ¬FactorsThroughMorphism τ (δ'))
    (hi_δ : ¬IsIso δ)
    (hi_β : ¬IsIso β)
    (hi_ρ : ¬IsIso ρ)
    (hi_ε : ¬IsIso ε)
    (hi_a : ¬IsIso a)
    (hi_ρ' : ¬IsIso ρ')
    (hi_a' : ¬IsIso a')
    (hi_β' : ¬IsIso β')
    (hi_δ' : ¬IsIso δ')
    (hlft_A_B_X1 : ¬∃ g, ρ ≫ g = a)
    (hlft_A_B_Bb : ¬∃ g, ρ ≫ g = ε)
    (hlft_A_Bb_X1 : ¬∃ g, ε ≫ g = a)
    (hlft_A_Bb_W : ¬∃ g, ε ≫ g = ρ ≫ ρ')
    (hlft_A_Bb_B : ¬∃ g, ε ≫ g = ρ)
    (hlft_A_Bb_D1 : ¬∃ g, ε ≫ g = ρ ≫ a')
    (hlft_A_X1_B : ¬∃ g, a ≫ g = ρ)
    (hlft_A_X1_Bb : ¬∃ g, a ≫ g = ε)
    (hlft_A_X1_D1 : ¬∃ g, a ≫ g = ρ ≫ a')
    (hlft_B_D1_W : ¬∃ g, a' ≫ g = ρ')
    (hlft_B_W_D1 : ¬∃ g, ρ' ≫ g = a')
    (hrgt_G_A_B : ¬∃ g, g ≫ ρ = β')
    (hrgt_Z_A_X1 : ¬∃ g, g ≫ a = δ)
    (hrgt_Z2_B_D1 : ¬∃ g, g ≫ a' = δ')
    (hrgt_X1_B_W : ¬∃ g, g ≫ ρ' = β)
    (hrgt_A_G_B : ¬∃ g, g ≫ β' = ρ)
    (hrgt_B_X1_W : ¬∃ g, g ≫ β = ρ')
    (hrgt_G_X1_W : ¬∃ g, g ≫ β = β' ≫ ρ')
    (hrgt_A_Z_X1 : ¬∃ g, g ≫ δ = a)
    (hrgt_A_Z2_D1 : ¬∃ g, g ≫ δ' = ρ ≫ a')
    (hrgt_B_Z2_D1 : ¬∃ g, g ≫ δ' = a')
    : False := by
  have hlft_A_B_A : ¬∃ g, ρ ≫ g = 𝟙 _ := not_split_mono hi_ρ
  have hlft_A_Bb_A : ¬∃ g, ε ≫ g = 𝟙 _ := not_split_mono hi_ε
  have hlft_A_X1_A : ¬∃ g, a ≫ g = 𝟙 _ := not_split_mono hi_a
  have hlft_B_D1_B : ¬∃ g, a' ≫ g = 𝟙 _ := not_split_mono hi_a'
  have hlft_B_W_B : ¬∃ g, ρ' ≫ g = 𝟙 _ := not_split_mono hi_ρ'
  have hlft_G_B_G : ¬∃ g, β' ≫ g = 𝟙 _ := not_split_mono hi_β'
  have hlft_X1_W_X1 : ¬∃ g, β ≫ g = 𝟙 _ := not_split_mono hi_β
  have hlft_Z_X1_Z : ¬∃ g, δ ≫ g = 𝟙 _ := not_split_mono hi_δ
  have hlft_Z2_D1_Z2 : ¬∃ g, δ' ≫ g = 𝟙 _ := not_split_mono hi_δ'
  have hrgt_B_A_B : ¬∃ g, g ≫ ρ = 𝟙 _ := not_split_epi hi_ρ
  have hrgt_Bb_A_Bb : ¬∃ g, g ≫ ε = 𝟙 _ := not_split_epi hi_ε
  have hrgt_X1_A_X1 : ¬∃ g, g ≫ a = 𝟙 _ := not_split_epi hi_a
  have hrgt_D1_B_D1 : ¬∃ g, g ≫ a' = 𝟙 _ := not_split_epi hi_a'
  have hrgt_W_B_W : ¬∃ g, g ≫ ρ' = 𝟙 _ := not_split_epi hi_ρ'
  have hrgt_B_G_B : ¬∃ g, g ≫ β' = 𝟙 _ := not_split_epi hi_β'
  have hrgt_W_X1_W : ¬∃ g, g ≫ β = 𝟙 _ := not_split_epi hi_β
  have hrgt_X1_Z_X1 : ¬∃ g, g ≫ δ = 𝟙 _ := not_split_epi hi_δ
  have hrgt_D1_Z2_D1 : ¬∃ g, g ≫ δ' = 𝟙 _ := not_split_epi hi_δ'
  have hc0' := reassoc_of% hc0
  have hz0' := reassoc_of% hz0
  have hz1' := reassoc_of% hz1
  refine hM.not_thin_diagram τ hτ hτ0 hD arrows obj (fun x y _ ↦ tab δ β ρ ε a ρ' a' β' δ' x y)
    (fun x ↦ by cases x <;> rfl) ?_ ?_ ?_ ?_
  · intro x y z h h'
    cases x <;> cases y <;> (try exact absurd h (by decide)) <;> cases z <;>
      (try exact absurd h' (by decide)) <;> split_ifs with hn <;>
      (try exact absurd hn (by decide)) <;>
      simp only [tab, Category.assoc, Category.id_comp, Category.comp_id, zero_comp, comp_zero, hc0', hc0, hz0', hz0, hz1', hz1]
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | exact not_factorsThrough_id hτ _
      | assumption
  · intro x z y ha hy
    cases x <;> cases z <;> (try exact absurd ha (by decide)) <;> cases y <;>
      (try exact absurd hy (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›
  · intro x z y ha hx
    cases z <;> cases y <;> (try exact absurd ha (by decide)) <;> cases x <;>
      (try exact absurd hx (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›

