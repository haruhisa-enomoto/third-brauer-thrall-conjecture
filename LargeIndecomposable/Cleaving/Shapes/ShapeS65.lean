/-!
# The tree diagram `S65`

BO13a figure 6.5: the `D̃₅` tree `b ← x → b'`, `x → m`, `x' → m ← x''`.

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `S65`. -/
inductive S65
  | x | m | b | b' | x' | x''
  deriving DecidableEq

namespace S65

instance : Fintype S65 := ⟨{x, m, b, b', x', x''}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : S65 → S65 → Bool
  | x, b | x, m | x, b' | x', m | x'', m => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : S65) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph S65 := SimpleGraph.fromRel o

lemma adj_iff (u v : S65) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : S65) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : S65) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : S65) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : S65 → Option S65
  | x => none
  | m => some x
  | b => some x
  | b' => some x
  | x' => some m
  | x'' => some m

/-- The height. -/
def ht : S65 → ℕ
  | x => 0
  | m => 1
  | b => 1
  | b' => 1
  | x' => 2
  | x'' => 2

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `D̃`. -/
def cmap : AffineD 1 → S65
  | .spine j => if (j : ℕ) = 0 then x else m
  | .leaf i => if (i : ℕ) = 0 then b else if (i : ℕ) = 1 then b' else if (i : ℕ) = 2 then x' else x''

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `D̃`. -/
def copy : (underlyingGraph (AffineD 1)).Copy G :=
  copyD G 1 cmap (by
    intro u v h
    rcases u with i | j <;> rcases v with i' | j'
    · fin_cases i <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases i <;> fin_cases j' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases j' <;> simp_all [cmap])
    (fun i ↦ by
      fin_cases i
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide)
    (fun j j' h ↦ by fin_cases j <;> fin_cases j' <;> simp_all [cmap] <;> decide)

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {X M Bb B' X' X'' : P}
  (β : X ⟶ Bb) (ψ : X ⟶ M) (β' : X ⟶ B') (r : X' ⟶ M) (t : X'' ⟶ M)

/-- The objects. -/
def obj : S65 → P
  | x => X | m => M | b => Bb | b' => B' | x' => X' | x'' => X''

/-- The arrows. -/
def arr : ∀ u v : S65, o u v → ((obj (X := X) (M := M) (Bb := Bb) (B' := B') (X' := X') (X'' := X'') u) ⟶ obj (X := X) (M := M) (Bb := Bb) (B' := B') (X' := X') (X'' := X'') v)
  | x, b, _ => β
  | x, m, _ => ψ
  | x, b', _ => β'
  | x', m, _ => r
  | x'', m, _ => t
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : S65, Option ((obj (X := X) (M := M) (Bb := Bb) (B' := B') (X' := X') (X'' := X'') u) ⟶ obj (X := X) (M := M) (Bb := Bb) (B' := B') (X' := X') (X'' := X'') v)
  | x, x => some (𝟙 _)
  | x, b => some (β)
  | x, m => some (ψ)
  | x, b' => some (β')
  | m, m => some (𝟙 _)
  | b, b => some (𝟙 _)
  | b', b' => some (𝟙 _)
  | x', x' => some (𝟙 _)
  | x', m => some (r)
  | x'', x'' => some (𝟙 _)
  | x'', m => some (t)
  | _, _ => none

end Diagram

end S65

end RayCat

