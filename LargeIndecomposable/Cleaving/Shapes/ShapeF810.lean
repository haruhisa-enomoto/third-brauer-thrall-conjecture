/-- **No cleaving diagram `F810` in `P/τ`.** -/
theorem not_f810
    (hmin : ∀ I : TwoSidedIdeal A, I ≠ ⊥ → Statement.IsRepresentationFinite (A ⧸ I.asIdeal))
    (hL : LeftCancel P) (hR : RightCancel P) {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {X C' Aa Xn X₂ Cc Y₁ : P}
    (W₁ : X ⟶ C') (V₁ : X ⟶ Aa) (r : Xn ⟶ Aa) (σ₂' : X₂ ⟶ Aa) (A : Aa ⟶ Cc) (ρ₁' : Aa ⟶ Y₁)
    (hD : ¬Statement.IsRepresentationFinite (Linearization (ThinCat thin) k))
    (hz0 : r ≫ ρ₁' = 0)
    (hz1 : σ₂' ≫ A = 0)
    (h0_a_c : ¬FactorsThroughMorphism τ (A))
    (h0_a_y₁ : ¬FactorsThroughMorphism τ (ρ₁'))
    (h0_x_a : ¬FactorsThroughMorphism τ (V₁))
    (h0_x_c : ¬FactorsThroughMorphism τ (V₁ ≫ A))
    (h0_x_c' : ¬FactorsThroughMorphism τ (W₁))
    (h0_x_y₁ : ¬FactorsThroughMorphism τ (V₁ ≫ ρ₁'))
    (h0_xn_a : ¬FactorsThroughMorphism τ (r))
    (h0_xn_c : ¬FactorsThroughMorphism τ (r ≫ A))
    (h0_x₂_a : ¬FactorsThroughMorphism τ (σ₂'))
    (h0_x₂_y₁ : ¬FactorsThroughMorphism τ (σ₂' ≫ ρ₁'))
    (hi_W₁ : ¬IsIso W₁)
    (hi_V₁ : ¬IsIso V₁)
    (hi_r : ¬IsIso r)
    (hi_σ₂' : ¬IsIso σ₂')
    (hi_A : ¬IsIso A)
    (hi_ρ₁' : ¬IsIso ρ₁')
    (hlft_a_c_y₁ : ¬∃ g, A ≫ g = ρ₁')
    (hlft_a_y₁_c : ¬∃ g, ρ₁' ≫ g = A)
    (hlft_x_a_c' : ¬∃ g, V₁ ≫ g = W₁)
    (hlft_x_c'_a : ¬∃ g, W₁ ≫ g = V₁)
    (hlft_x_c'_c : ¬∃ g, W₁ ≫ g = V₁ ≫ A)
    (hlft_x_c'_y₁ : ¬∃ g, W₁ ≫ g = V₁ ≫ ρ₁')
    (hrgt_xn_x_a : ¬∃ g, g ≫ V₁ = r)
    (hrgt_x₂_x_a : ¬∃ g, g ≫ V₁ = σ₂')
    (hrgt_x_xn_a : ¬∃ g, g ≫ r = V₁)
    (hrgt_x₂_xn_a : ¬∃ g, g ≫ r = σ₂')
    (hrgt_x_x₂_a : ¬∃ g, g ≫ σ₂' = V₁)
    (hrgt_xn_x₂_a : ¬∃ g, g ≫ σ₂' = r)
    : False := by
  have hlft_a_c_a : ¬∃ g, A ≫ g = 𝟙 _ := not_split_mono hi_A
  have hlft_a_y₁_a : ¬∃ g, ρ₁' ≫ g = 𝟙 _ := not_split_mono hi_ρ₁'
  have hlft_x_a_x : ¬∃ g, V₁ ≫ g = 𝟙 _ := not_split_mono hi_V₁
  have hlft_x_c'_x : ¬∃ g, W₁ ≫ g = 𝟙 _ := not_split_mono hi_W₁
  have hlft_xn_a_xn : ¬∃ g, r ≫ g = 𝟙 _ := not_split_mono hi_r
  have hlft_x₂_a_x₂ : ¬∃ g, σ₂' ≫ g = 𝟙 _ := not_split_mono hi_σ₂'
  have hrgt_c_a_c : ¬∃ g, g ≫ A = 𝟙 _ := not_split_epi hi_A
  have hrgt_y₁_a_y₁ : ¬∃ g, g ≫ ρ₁' = 𝟙 _ := not_split_epi hi_ρ₁'
  have hrgt_a_x_a : ¬∃ g, g ≫ V₁ = 𝟙 _ := not_split_epi hi_V₁
  have hrgt_c'_x_c' : ¬∃ g, g ≫ W₁ = 𝟙 _ := not_split_epi hi_W₁
  have hrgt_a_xn_a : ¬∃ g, g ≫ r = 𝟙 _ := not_split_epi hi_r
  have hrgt_a_x₂_a : ¬∃ g, g ≫ σ₂' = 𝟙 _ := not_split_epi hi_σ₂'
  have hz0' := reassoc_of% hz0
  have hz1' := reassoc_of% hz1
  refine B.not_thin_diagram hmin hL hR τ hτ hτ0 hD arrows obj (fun x y _ ↦ tab W₁ V₁ r σ₂' A ρ₁' x y)
    (fun x ↦ by cases x <;> rfl) ?_ ?_ ?_ ?_
  · intro x y z h h'
    cases x <;> cases y <;> (try exact absurd h (by decide)) <;> cases z <;>
      (try exact absurd h' (by decide)) <;> split_ifs with hn <;>
      (try exact absurd hn (by decide)) <;>
      simp only [tab, Category.assoc, Category.id_comp, Category.comp_id, zero_comp, comp_zero, hz0', hz0, hz1', hz1]
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | exact not_factorsThrough_id hτ _
      | assumption
  · intro x z y ha hy
    cases x <;> cases z <;> (try exact absurd ha (by decide)) <;> cases y <;>
      (try exact absurd hy (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›
  · intro x z y ha hx
    cases z <;> cases y <;> (try exact absurd ha (by decide)) <;> cases x <;>
      (try exact absurd hx (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›

