/-- Vertices of the diagram `F810`. -/
inductive F810
  | x | c' | a | xn | x₂ | c | y₁
  deriving DecidableEq

namespace F810

instance : Fintype F810 := ⟨{x, c', a, xn, x₂, c, y₁}, by intro v; cases v <;> simp⟩

/-- The order (nonzero morphisms). -/
def leb : F810 → F810 → Bool
  | a, a | a, c | a, y₁ | c, c | c', c' | x, a | x, c | x, c' | x, x | x, y₁ | xn, a | xn, c | xn, xn | x₂, a | x₂, x₂ | x₂, y₁ | y₁, y₁ => true
  | _, _ => false

/-- The arrows. -/
def arb : F810 → F810 → Bool
  | a, c | a, y₁ | x, a | x, c' | xn, a | x₂, a => true
  | _, _ => false

/-- The thin category. -/
abbrev thin : ThinData F810 where
  le x y := leb x y = true
  nz x _ z := leb x z = true
  refl x := by cases x <;> rfl
  antisymm := by decide
  nz_le _ _ _ _ _ h := h
  nz_left _ _ h := h
  nz_right _ _ h := h
  assoc := by decide

/-- The generating arrows. -/
abbrev arrows : ThinArrows thin where
  ar x y := arb x y = true
  ar_le := by decide
  ar_ne := by decide
  first := by decide
  last := by decide

