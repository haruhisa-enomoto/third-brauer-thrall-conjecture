/-!
# The tree diagram `F75`

BO13a Lemma 7, reflecting case: the `D̃₅` tree `x₂ → a' → tz`, `a' → b' → y₁`, `x → b'`.

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `F75`. -/
inductive F75
  | a' | x₂ | tz | b' | y₁ | x
  deriving DecidableEq

namespace F75

instance : Fintype F75 := ⟨{a', x₂, tz, b', y₁, x}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : F75 → F75 → Bool
  | x₂, a' | a', b' | a', tz | b', y₁ | x, b' => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : F75) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph F75 := SimpleGraph.fromRel o

lemma adj_iff (u v : F75) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : F75) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : F75) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : F75) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : F75 → Option F75
  | a' => none
  | x₂ => some a'
  | tz => some a'
  | b' => some a'
  | y₁ => some b'
  | x => some b'

/-- The height. -/
def ht : F75 → ℕ
  | a' => 0
  | x₂ => 1
  | tz => 1
  | b' => 1
  | y₁ => 2
  | x => 2

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `D̃`. -/
def cmap : AffineD 1 → F75
  | .spine j => if (j : ℕ) = 0 then a' else b'
  | .leaf i => if (i : ℕ) = 0 then x₂ else if (i : ℕ) = 1 then tz else if (i : ℕ) = 2 then y₁ else x

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `D̃`. -/
def copy : (underlyingGraph (AffineD 1)).Copy G :=
  copyD G 1 cmap (by
    intro u v h
    rcases u with i | j <;> rcases v with i' | j'
    · fin_cases i <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases i <;> fin_cases j' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases j' <;> simp_all [cmap])
    (fun i ↦ by
      fin_cases i
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide)
    (fun j j' h ↦ by fin_cases j <;> fin_cases j' <;> simp_all [cmap] <;> decide)

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {A' X₂ Tz B' Y₁ X : P}
  (V₁' : X₂ ⟶ A') (V₂' : A' ⟶ B') (ρ₂' : A' ⟶ Tz) (V₃' : B' ⟶ Y₁) (φ : X ⟶ B')

/-- The objects. -/
def obj : F75 → P
  | a' => A' | x₂ => X₂ | tz => Tz | b' => B' | y₁ => Y₁ | x => X

/-- The arrows. -/
def arr : ∀ u v : F75, o u v → ((obj (A' := A') (X₂ := X₂) (Tz := Tz) (B' := B') (Y₁ := Y₁) (X := X) u) ⟶ obj (A' := A') (X₂ := X₂) (Tz := Tz) (B' := B') (Y₁ := Y₁) (X := X) v)
  | x₂, a', _ => V₁'
  | a', b', _ => V₂'
  | a', tz, _ => ρ₂'
  | b', y₁, _ => V₃'
  | x, b', _ => φ
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : F75, Option ((obj (A' := A') (X₂ := X₂) (Tz := Tz) (B' := B') (Y₁ := Y₁) (X := X) u) ⟶ obj (A' := A') (X₂ := X₂) (Tz := Tz) (B' := B') (Y₁ := Y₁) (X := X) v)
  | a', a' => some (𝟙 _)
  | a', b' => some (V₂')
  | a', y₁ => some (V₂' ≫ V₃')
  | a', tz => some (ρ₂')
  | x₂, x₂ => some (𝟙 _)
  | x₂, a' => some (V₁')
  | x₂, b' => some (V₁' ≫ V₂')
  | x₂, y₁ => some ((V₁' ≫ V₂') ≫ V₃')
  | x₂, tz => some (V₁' ≫ ρ₂')
  | tz, tz => some (𝟙 _)
  | b', b' => some (𝟙 _)
  | b', y₁ => some (V₃')
  | y₁, y₁ => some (𝟙 _)
  | x, x => some (𝟙 _)
  | x, b' => some (φ)
  | x, y₁ => some (φ ≫ V₃')
  | _, _ => none

end Diagram

