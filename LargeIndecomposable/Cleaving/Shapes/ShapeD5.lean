module

public import LargeIndecomposable.Cleaving.Shapes.ShapeD6
public import LargeIndecomposable.Cleaving.Diagrams.Tools

/-!
# The tree diagram `MD5`

[mild] Lemma 2.2: the `D̃₅` tree with `α, β` into `y`, `q : y → m` and `a, b` out of `m`.

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `MD5`. -/
inductive MD5
  | y | z | t | m | u | v
  deriving DecidableEq

namespace MD5

instance : Fintype MD5 := ⟨{y, z, t, m, u, v}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : MD5 → MD5 → Bool
  | z, y | t, y | y, m | m, u | m, v => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : MD5) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph MD5 := SimpleGraph.fromRel o

lemma adj_iff (u v : MD5) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : MD5) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : MD5) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : MD5) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : MD5 → Option MD5
  | y => none
  | z => some y
  | t => some y
  | m => some y
  | u => some m
  | v => some m

/-- The height. -/
def ht : MD5 → ℕ
  | y => 0
  | z => 1
  | t => 1
  | m => 1
  | u => 2
  | v => 2

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `D̃`. -/
def cmap : AffineD 1 → MD5
  | .spine j => if (j : ℕ) = 0 then y else m
  | .leaf i => if (i : ℕ) = 0 then z else if (i : ℕ) = 1 then t else if (i : ℕ) = 2 then u else v

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `D̃`. -/
def copy : (underlyingGraph (AffineD 1)).Copy G :=
  copyD G 1 cmap (by
    intro u v h
    rcases u with i | j <;> rcases v with i' | j'
    · fin_cases i <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases i <;> fin_cases j' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases j' <;> simp_all [cmap])
    (fun i ↦ by
      fin_cases i
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide)
    (fun j j' h ↦ by fin_cases j <;> fin_cases j' <;> simp_all [cmap] <;> decide)

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {Y Z T M U V : P}
  (α : Z ⟶ Y) (β : T ⟶ Y) (q : Y ⟶ M) (a : M ⟶ U) (b : M ⟶ V)

/-- The objects. -/
def obj : MD5 → P
  | y => Y | z => Z | t => T | m => M | u => U | v => V

/-- The arrows. -/
def arr : ∀ u v : MD5, o u v → ((obj (Y := Y) (Z := Z) (T := T) (M := M) (U := U) (V := V) u) ⟶ obj (Y := Y) (Z := Z) (T := T) (M := M) (U := U) (V := V) v)
  | z, y, _ => α
  | t, y, _ => β
  | y, m, _ => q
  | m, u, _ => a
  | m, v, _ => b
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : MD5, Option ((obj (Y := Y) (Z := Z) (T := T) (M := M) (U := U) (V := V) u) ⟶ obj (Y := Y) (Z := Z) (T := T) (M := M) (U := U) (V := V) v)
  | y, y => some (𝟙 _)
  | y, m => some (q)
  | y, u => some (q ≫ a)
  | y, v => some (q ≫ b)
  | z, z => some (𝟙 _)
  | z, y => some (α)
  | z, m => some (α ≫ q)
  | z, u => some ((α ≫ q) ≫ a)
  | z, v => some ((α ≫ q) ≫ b)
  | t, t => some (𝟙 _)
  | t, y => some (β)
  | t, m => some (β ≫ q)
  | t, u => some ((β ≫ q) ≫ a)
  | t, v => some ((β ≫ q) ≫ b)
  | m, m => some (𝟙 _)
  | m, u => some (a)
  | m, v => some (b)
  | u, u => some (𝟙 _)
  | v, v => some (𝟙 _)
  | _, _ => none

end Diagram

end MD5

end RayCat

namespace RayCat

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type u} [Field k] [Infinite k]

set_option maxHeartbeats 8000000 in
open MD5 in
/-- **No cleaving diagram `MD5` in `P/τ`.** -/
theorem MildHyp.not_md5 (hM : MildHyp k P)
    {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {Y Z T M U V : P}
    (α : Z ⟶ Y) (β : T ⟶ Y) (q : Y ⟶ M) (a : M ⟶ U) (b : M ⟶ V)
    (h0_y_m : ¬FactorsThroughMorphism τ (q))
    (h0_y_u : ¬FactorsThroughMorphism τ (q ≫ a))
    (h0_y_v : ¬FactorsThroughMorphism τ (q ≫ b))
    (h0_z_y : ¬FactorsThroughMorphism τ (α))
    (h0_z_m : ¬FactorsThroughMorphism τ (α ≫ q))
    (h0_z_u : ¬FactorsThroughMorphism τ ((α ≫ q) ≫ a))
    (h0_z_v : ¬FactorsThroughMorphism τ ((α ≫ q) ≫ b))
    (h0_t_y : ¬FactorsThroughMorphism τ (β))
    (h0_t_m : ¬FactorsThroughMorphism τ (β ≫ q))
    (h0_t_u : ¬FactorsThroughMorphism τ ((β ≫ q) ≫ a))
    (h0_t_v : ¬FactorsThroughMorphism τ ((β ≫ q) ≫ b))
    (h0_m_u : ¬FactorsThroughMorphism τ (a))
    (h0_m_v : ¬FactorsThroughMorphism τ (b))
    (hi_α : ¬IsIso α)
    (hi_β : ¬IsIso β)
    (hi_q : ¬IsIso q)
    (hi_a : ¬IsIso a)
    (hi_b : ¬IsIso b)
    (hl_a_b_v : ¬∃ g, a ≫ g = b)
    (hl_b_a_u : ¬∃ g, b ≫ g = a)
    (hr_α_β_t : ¬∃ g, g ≫ α = β)
    (hr_β_α_z : ¬∃ g, g ≫ β = α)
    : False := by
  haveI : Fact (LargeIndecomposable.Foundations.Quiver.IsAcyclic (OT G o)) := ⟨OT.isAcyclic ho hasym isAcyclic⟩
  refine hM.not_tree_table τ hτ hτ0 G o ho hasym isAcyclic
    (OT.not_isRepresentationFinite_affineD ho hcov k 1 copy) obj (arr α β q a b)
    (tab α β q a b) (fun v ↦ by cases v <;> rfl) ?_ ?_ ?_ ?_ ?_
  · intro x y z h f hf
    cases y <;> cases z <;> (try exact absurd h (by decide)) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; rfl)
      | rfl
  · intro x y f hf hne
    cases x <;> cases y <;> (try exact absurd rfl hne) <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;> assumption
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | assumption
  · intro x c c' y h h' f hne hf
    cases x <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases y <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.comp_id]; assumption)
      | assumption
  · intro x c c' y h h' f hne hf
    cases y <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; assumption)
      | assumption

end RayCat

end LargeIndecomposable
