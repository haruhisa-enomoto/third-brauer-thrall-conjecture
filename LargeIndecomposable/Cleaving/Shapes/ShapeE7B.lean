/-!
# The tree diagram `ME7B`

[mild] Lemma 2.1, Case II: the `Ẽ₇` tree `z₁ ← x → t ← z → y ← y' ← t'`, `x' → z`.

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `ME7B`. -/
inductive ME7B
  | z | xa | t | x | z1 | y | yb | tb
  deriving DecidableEq

namespace ME7B

instance : Fintype ME7B := ⟨{z, xa, t, x, z1, y, yb, tb}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : ME7B → ME7B → Bool
  | z, t | x, t | x, z1 | xa, z | z, y | yb, y | tb, yb => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : ME7B) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph ME7B := SimpleGraph.fromRel o

lemma adj_iff (u v : ME7B) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : ME7B) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : ME7B) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : ME7B) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : ME7B → Option ME7B
  | z => none
  | xa => some z
  | t => some z
  | x => some t
  | z1 => some x
  | y => some z
  | yb => some y
  | tb => some yb

/-- The height. -/
def ht : ME7B → ℕ
  | z => 0
  | xa => 1
  | t => 1
  | x => 2
  | z1 => 3
  | y => 1
  | yb => 2
  | tb => 3

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `Ẽ₇` (long arms listed from the centre). -/
def cmap : AffineE7 → ME7B
  | .center => z
  | .short => xa
  | .inner i => if (i : ℕ) = 0 then t else y
  | .middle i => if (i : ℕ) = 0 then x else yb
  | .outer i => if (i : ℕ) = 0 then z1 else tb

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `Ẽ₇`. -/
def copy : (underlyingGraph AffineE7).Copy G :=
  copyOf G cmap (by
    intro u v h
    rcases u with _ | _ | i | i | i <;> rcases v with _ | _ | j | j | j <;>
      (try fin_cases i) <;> (try fin_cases j) <;> simp_all [cmap])
    (by
      intro a b e
      change AffineE7.Arrow a b at e
      cases e with
      | outerMiddle i => fin_cases i <;> simp only [cmap] <;> decide
      | middleInner i => fin_cases i <;> simp only [cmap] <;> decide
      | innerCenter i => fin_cases i <;> simp only [cmap] <;> decide
      | shortCenter => simp only [cmap]; decide)

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {Z Xa T X Z₁ Y Yb Tb : P}
  (φ : Z ⟶ T) (δ : X ⟶ T) (γ₁ : X ⟶ Z₁) (γ₂ : Xa ⟶ Z) (α : Z ⟶ Y) (ρ : Yb ⟶ Y) (β : Tb ⟶ Yb)

/-- The objects. -/
def obj : ME7B → P
  | z => Z | xa => Xa | t => T | x => X | z1 => Z₁ | y => Y | yb => Yb | tb => Tb

/-- The arrows. -/
def arr : ∀ u v : ME7B, o u v → ((obj (Z := Z) (Xa := Xa) (T := T) (X := X) (Z₁ := Z₁) (Y := Y) (Yb := Yb) (Tb := Tb) u) ⟶ obj (Z := Z) (Xa := Xa) (T := T) (X := X) (Z₁ := Z₁) (Y := Y) (Yb := Yb) (Tb := Tb) v)
  | z, t, _ => φ
  | x, t, _ => δ
  | x, z1, _ => γ₁
  | xa, z, _ => γ₂
  | z, y, _ => α
  | yb, y, _ => ρ
  | tb, yb, _ => β
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : ME7B, Option ((obj (Z := Z) (Xa := Xa) (T := T) (X := X) (Z₁ := Z₁) (Y := Y) (Yb := Yb) (Tb := Tb) u) ⟶ obj (Z := Z) (Xa := Xa) (T := T) (X := X) (Z₁ := Z₁) (Y := Y) (Yb := Yb) (Tb := Tb) v)
  | z, z => some (𝟙 _)
  | z, t => some (φ)
  | z, y => some (α)
  | xa, xa => some (𝟙 _)
  | xa, z => some (γ₂)
  | xa, t => some (γ₂ ≫ φ)
  | xa, y => some (γ₂ ≫ α)
  | t, t => some (𝟙 _)
  | x, x => some (𝟙 _)
  | x, t => some (δ)
  | x, z1 => some (γ₁)
  | z1, z1 => some (𝟙 _)
  | y, y => some (𝟙 _)
  | yb, yb => some (𝟙 _)
  | yb, y => some (ρ)
  | tb, tb => some (𝟙 _)
  | tb, yb => some (β)
  | tb, y => some (β ≫ ρ)
  | _, _ => none

end Diagram

end ME7B

