/-!
# The tree diagram `SE6B`

`Ẽ₆` at `y`: the arm `y → a → y` into `y`, the tail `y → a → y`, and `y ← x → x` (`β`, `d`).

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `SE6B`. -/
inductive SE6B
  | Y | A1 | Y0 | A3 | Y4 | X | X2
  deriving DecidableEq

namespace SE6B

instance : Fintype SE6B := ⟨{Y, A1, Y0, A3, Y4, X, X2}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : SE6B → SE6B → Bool
  | Y0, A1 | A1, Y | Y, A3 | A3, Y4 | X, Y | X, X2 => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : SE6B) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph SE6B := SimpleGraph.fromRel o

lemma adj_iff (u v : SE6B) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : SE6B) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : SE6B) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : SE6B) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : SE6B → Option SE6B
  | Y => none
  | A1 => some Y
  | Y0 => some A1
  | A3 => some Y
  | Y4 => some A3
  | X => some Y
  | X2 => some X

/-- The height. -/
def ht : SE6B → ℕ
  | Y => 0
  | A1 => 1
  | Y0 => 2
  | A3 => 1
  | Y4 => 2
  | X => 1
  | X2 => 2

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `Ẽ₆`. -/
def cmap : AffineE6 → SE6B
  | .center => Y
  | .inner i => if (i : ℕ) = 0 then A1 else if (i : ℕ) = 1 then A3 else X
  | .outer i => if (i : ℕ) = 0 then Y0 else if (i : ℕ) = 1 then Y4 else X2

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `Ẽ₆`. -/
def copy : (underlyingGraph AffineE6).Copy G :=
  copyOf G cmap (by
    intro u v h
    rcases u with _ | i | i <;> rcases v with _ | j | j <;>
      (try fin_cases i) <;> (try fin_cases j) <;> simp_all [cmap])
    (by
      intro a b e
      rcases a with _ | i | i <;> rcases b with _ | j | j
      all_goals first
        | exact (IsEmpty.false e).elim
        | exact e.elim
        | (obtain rfl : i = j := e.down; fin_cases i <;> simp only [cmap] <;> decide)
        | (fin_cases i <;> simp only [cmap] <;> decide))

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {OY OA1 OY0 OA3 OY4 OX OX2 : P}
  (u : OY0 ⟶ OA1) (α : OA1 ⟶ OY) (ω : OY ⟶ OA3) (α₂ : OA3 ⟶ OY4) (β : OX ⟶ OY) (d : OX ⟶ OX2)

/-- The objects. -/
def obj : SE6B → P
  | Y => OY | A1 => OA1 | Y0 => OY0 | A3 => OA3 | Y4 => OY4 | X => OX | X2 => OX2

/-- The arrows. -/
def arr : ∀ u v : SE6B, o u v → ((obj (OY := OY) (OA1 := OA1) (OY0 := OY0) (OA3 := OA3) (OY4 := OY4) (OX := OX) (OX2 := OX2) u) ⟶ obj (OY := OY) (OA1 := OA1) (OY0 := OY0) (OA3 := OA3) (OY4 := OY4) (OX := OX) (OX2 := OX2) v)
  | Y0, A1, _ => u
  | A1, Y, _ => α
  | Y, A3, _ => ω
  | A3, Y4, _ => α₂
  | X, Y, _ => β
  | X, X2, _ => d
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : SE6B, Option ((obj (OY := OY) (OA1 := OA1) (OY0 := OY0) (OA3 := OA3) (OY4 := OY4) (OX := OX) (OX2 := OX2) u) ⟶ obj (OY := OY) (OA1 := OA1) (OY0 := OY0) (OA3 := OA3) (OY4 := OY4) (OX := OX) (OX2 := OX2) v)
  | Y, Y => some (𝟙 _)
  | Y, A3 => some (ω)
  | Y, Y4 => some (ω ≫ α₂)
  | A1, A1 => some (𝟙 _)
  | A1, Y => some (α)
  | A1, A3 => some (α ≫ ω)
  | A1, Y4 => some ((α ≫ ω) ≫ α₂)
  | Y0, Y0 => some (𝟙 _)
  | Y0, A1 => some (u)
  | Y0, Y => some (u ≫ α)
  | Y0, A3 => some ((u ≫ α) ≫ ω)
  | Y0, Y4 => some (((u ≫ α) ≫ ω) ≫ α₂)
  | A3, A3 => some (𝟙 _)
  | A3, Y4 => some (α₂)
  | Y4, Y4 => some (𝟙 _)
  | X, X => some (𝟙 _)
  | X, Y => some (β)
  | X, A3 => some (β ≫ ω)
  | X, Y4 => some ((β ≫ ω) ≫ α₂)
  | X, X2 => some (d)
  | X2, X2 => some (𝟙 _)
  | _, _ => none

end Diagram

end SE6B

