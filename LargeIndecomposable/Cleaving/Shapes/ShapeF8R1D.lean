/-- The order (nonzero morphisms). -/
def leb : F8R1D → F8R1D → Bool
  | a, a | a, c | a, y₁ | a, z₂ | c, c | c, y₁ | c', c' | x, a | x, c | x, c' | x, x | x, y₁ | xn, c | xn, xn | x₂, a | x₂, c | x₂, x₂ | x₂, y₁ | x₂, z₂ | y₁, y₁ | z₂, z₂ => true
  | _, _ => false

/-- The arrows. -/
def arb : F8R1D → F8R1D → Bool
  | a, c | a, z₂ | c, y₁ | x, a | x, c' | xn, c | x₂, a => true
  | _, _ => false

/-- The thin category. -/
abbrev thin : ThinData F8R1D where
  le x y := leb x y = true
  nz x _ z := leb x z = true
  refl x := by cases x <;> rfl
  antisymm := by decide
  nz_le _ _ _ _ _ h := h
  nz_left _ _ h := h
  nz_right _ _ h := h
  assoc := by decide

/-- The generating arrows. -/
abbrev arrows : ThinArrows thin where
  ar x y := arb x y = true
  ar_le := by decide
  ar_ne := by decide
  first := by decide
  last := by decide

