/-- Vertices of the diagram `F93`. -/
inductive F93
  | a | y₀ | y₁ | x₂ | c' | b' | y₂ | x₃
  deriving DecidableEq

namespace F93

instance : Fintype F93 := ⟨{a, y₀, y₁, x₂, c', b', y₂, x₃}, by intro v; cases v <;> simp⟩

/-- The order (nonzero morphisms). -/
def leb : F93 → F93 → Bool
  | a, a | a, y₀ | a, y₁ | b', b' | b', y₁ | c', c' | c', y₁ | c', y₂ | x₂, b' | x₂, c' | x₂, x₂ | x₂, y₁ | x₂, y₂ | x₃, x₃ | x₃, y₂ | y₀, y₀ | y₁, y₁ | y₂, y₂ => true
  | _, _ => false

/-- The arrows. -/
def arb : F93 → F93 → Bool
  | a, y₀ | a, y₁ | b', y₁ | c', y₁ | c', y₂ | x₂, b' | x₂, c' | x₃, y₂ => true
  | _, _ => false

/-- The thin category. -/
abbrev thin : ThinData F93 where
  le x y := leb x y = true
  nz x _ z := leb x z = true
  refl x := by cases x <;> rfl
  antisymm := by decide
  nz_le _ _ _ _ _ h := h
  nz_left _ _ h := h
  nz_right _ _ h := h
  assoc := by decide

/-- The generating arrows. -/
abbrev arrows : ThinArrows thin where
  ar x y := arb x y = true
  ar_le := by decide
  ar_ne := by decide
  first := by decide
  last := by decide

