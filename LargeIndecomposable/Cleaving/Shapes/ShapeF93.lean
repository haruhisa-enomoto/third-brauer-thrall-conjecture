/-- **No cleaving diagram `F93` in `P/τ`.** -/
theorem not_f93
    (hmin : ∀ I : TwoSidedIdeal A, I ≠ ⊥ → Statement.IsRepresentationFinite (A ⧸ I.asIdeal))
    (hL : LeftCancel P) (hR : RightCancel P) {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {Aa Y₀ Y₁ X₂ C' B' Y₂ X₃ : P}
    (V₂ : Aa ⟶ Y₀) (ρ₁' : Aa ⟶ Y₁) (V₁' : X₂ ⟶ C') (W₁' : X₂ ⟶ B') (V₂' : C' ⟶ Y₁) (W₂' : B' ⟶ Y₁) (ρ₂' : C' ⟶ Y₂) (σ₃ : X₃ ⟶ Y₂)
    (hD : ¬Statement.IsRepresentationFinite (Linearization (ThinCat thin) k))
    (hc0 : W₁' ≫ W₂' = V₁' ≫ V₂')
    (h0_a_y₀ : ¬FactorsThroughMorphism τ (V₂))
    (h0_a_y₁ : ¬FactorsThroughMorphism τ (ρ₁'))
    (h0_b'_y₁ : ¬FactorsThroughMorphism τ (W₂'))
    (h0_c'_y₁ : ¬FactorsThroughMorphism τ (V₂'))
    (h0_c'_y₂ : ¬FactorsThroughMorphism τ (ρ₂'))
    (h0_x₂_b' : ¬FactorsThroughMorphism τ (W₁'))
    (h0_x₂_c' : ¬FactorsThroughMorphism τ (V₁'))
    (h0_x₂_y₁ : ¬FactorsThroughMorphism τ (V₁' ≫ V₂'))
    (h0_x₂_y₂ : ¬FactorsThroughMorphism τ (V₁' ≫ ρ₂'))
    (h0_x₃_y₂ : ¬FactorsThroughMorphism τ (σ₃))
    (hi_V₂ : ¬IsIso V₂)
    (hi_ρ₁' : ¬IsIso ρ₁')
    (hi_V₁' : ¬IsIso V₁')
    (hi_W₁' : ¬IsIso W₁')
    (hi_V₂' : ¬IsIso V₂')
    (hi_W₂' : ¬IsIso W₂')
    (hi_ρ₂' : ¬IsIso ρ₂')
    (hi_σ₃ : ¬IsIso σ₃)
    (hlft_a_y₀_y₁ : ¬∃ g, V₂ ≫ g = ρ₁')
    (hlft_a_y₁_y₀ : ¬∃ g, ρ₁' ≫ g = V₂)
    (hlft_c'_y₁_y₂ : ¬∃ g, V₂' ≫ g = ρ₂')
    (hlft_c'_y₂_y₁ : ¬∃ g, ρ₂' ≫ g = V₂')
    (hlft_x₂_b'_c' : ¬∃ g, W₁' ≫ g = V₁')
    (hlft_x₂_b'_y₂ : ¬∃ g, W₁' ≫ g = V₁' ≫ ρ₂')
    (hlft_x₂_c'_b' : ¬∃ g, V₁' ≫ g = W₁')
    (hrgt_x₂_a_y₁ : ¬∃ g, g ≫ ρ₁' = V₁' ≫ V₂')
    (hrgt_c'_a_y₁ : ¬∃ g, g ≫ ρ₁' = V₂')
    (hrgt_b'_a_y₁ : ¬∃ g, g ≫ ρ₁' = W₂')
    (hrgt_a_b'_y₁ : ¬∃ g, g ≫ W₂' = ρ₁')
    (hrgt_c'_b'_y₁ : ¬∃ g, g ≫ W₂' = V₂')
    (hrgt_a_c'_y₁ : ¬∃ g, g ≫ V₂' = ρ₁')
    (hrgt_b'_c'_y₁ : ¬∃ g, g ≫ V₂' = W₂')
    (hrgt_x₃_c'_y₂ : ¬∃ g, g ≫ ρ₂' = σ₃)
    (hrgt_x₂_x₃_y₂ : ¬∃ g, g ≫ σ₃ = V₁' ≫ ρ₂')
    (hrgt_c'_x₃_y₂ : ¬∃ g, g ≫ σ₃ = ρ₂')
    : False := by
  have hlft_a_y₀_a : ¬∃ g, V₂ ≫ g = 𝟙 _ := not_split_mono hi_V₂
  have hlft_a_y₁_a : ¬∃ g, ρ₁' ≫ g = 𝟙 _ := not_split_mono hi_ρ₁'
  have hlft_b'_y₁_b' : ¬∃ g, W₂' ≫ g = 𝟙 _ := not_split_mono hi_W₂'
  have hlft_c'_y₁_c' : ¬∃ g, V₂' ≫ g = 𝟙 _ := not_split_mono hi_V₂'
  have hlft_c'_y₂_c' : ¬∃ g, ρ₂' ≫ g = 𝟙 _ := not_split_mono hi_ρ₂'
  have hlft_x₂_b'_x₂ : ¬∃ g, W₁' ≫ g = 𝟙 _ := not_split_mono hi_W₁'
  have hlft_x₂_c'_x₂ : ¬∃ g, V₁' ≫ g = 𝟙 _ := not_split_mono hi_V₁'
  have hlft_x₃_y₂_x₃ : ¬∃ g, σ₃ ≫ g = 𝟙 _ := not_split_mono hi_σ₃
  have hrgt_y₀_a_y₀ : ¬∃ g, g ≫ V₂ = 𝟙 _ := not_split_epi hi_V₂
  have hrgt_y₁_a_y₁ : ¬∃ g, g ≫ ρ₁' = 𝟙 _ := not_split_epi hi_ρ₁'
  have hrgt_y₁_b'_y₁ : ¬∃ g, g ≫ W₂' = 𝟙 _ := not_split_epi hi_W₂'
  have hrgt_y₁_c'_y₁ : ¬∃ g, g ≫ V₂' = 𝟙 _ := not_split_epi hi_V₂'
  have hrgt_y₂_c'_y₂ : ¬∃ g, g ≫ ρ₂' = 𝟙 _ := not_split_epi hi_ρ₂'
  have hrgt_b'_x₂_b' : ¬∃ g, g ≫ W₁' = 𝟙 _ := not_split_epi hi_W₁'
  have hrgt_c'_x₂_c' : ¬∃ g, g ≫ V₁' = 𝟙 _ := not_split_epi hi_V₁'
  have hrgt_y₂_x₃_y₂ : ¬∃ g, g ≫ σ₃ = 𝟙 _ := not_split_epi hi_σ₃
  have hc0' := reassoc_of% hc0
  refine B.not_thin_diagram hmin hL hR τ hτ hτ0 hD arrows obj (fun x y _ ↦ tab V₂ ρ₁' V₁' W₁' V₂' W₂' ρ₂' σ₃ x y)
    (fun x ↦ by cases x <;> rfl) ?_ ?_ ?_ ?_
  · intro x y z h h'
    cases x <;> cases y <;> (try exact absurd h (by decide)) <;> cases z <;>
      (try exact absurd h' (by decide)) <;> split_ifs with hn <;>
      (try exact absurd hn (by decide)) <;>
      simp only [tab, Category.assoc, Category.id_comp, Category.comp_id, zero_comp, comp_zero, hc0', hc0]
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | exact not_factorsThrough_id hτ _
      | assumption
  · intro x z y ha hy
    cases x <;> cases z <;> (try exact absurd ha (by decide)) <;> cases y <;>
      (try exact absurd hy (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›
  · intro x z y ha hx
    cases z <;> cases y <;> (try exact absurd ha (by decide)) <;> cases x <;>
      (try exact absurd hx (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›

