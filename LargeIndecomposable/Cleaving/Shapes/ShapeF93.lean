abbrev tab : ∀ u v : F93, (obj (Aa := Aa) (Y₀ := Y₀) (Y₁ := Y₁) (X₂ := X₂) (C' := C') (B' := B') (Y₂ := Y₂) (X₃ := X₃) u) ⟶ obj (Aa := Aa) (Y₀ := Y₀) (Y₁ := Y₁) (X₂ := X₂) (C' := C') (B' := B') (Y₂ := Y₂) (X₃ := X₃) v
