/-- Vertices of the diagram `F8R1A`. -/
inductive F8R1A
  | a | x | y₁ | c | y₀ | xn
  deriving DecidableEq

namespace F8R1A

instance : Fintype F8R1A := ⟨{a, x, y₁, c, y₀, xn}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : F8R1A → F8R1A → Bool
  | x, a | a, c | c, y₀ | xn, c | a, y₁ => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : F8R1A) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph F8R1A := SimpleGraph.fromRel o

lemma adj_iff (u v : F8R1A) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : F8R1A) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : F8R1A) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : F8R1A) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : F8R1A → Option F8R1A
  | a => none
  | x => some a
  | y₁ => some a
  | c => some a
  | y₀ => some c
  | xn => some c

/-- The height. -/
def ht : F8R1A → ℕ
  | a => 0
  | x => 1
  | y₁ => 1
  | c => 1
  | y₀ => 2
  | xn => 2

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `D̃`. -/
def cmap : AffineD 1 → F8R1A
  | .spine j => if (j : ℕ) = 0 then a else c
  | .leaf i => if (i : ℕ) = 0 then x else if (i : ℕ) = 1 then y₁ else if (i : ℕ) = 2 then y₀ else xn

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `D̃`. -/
def copy : (underlyingGraph (AffineD 1)).Copy G :=
  copyD G 1 cmap (by
    intro u v h
    rcases u with i | j <;> rcases v with i' | j'
    · fin_cases i <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases i <;> fin_cases j' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases j' <;> simp_all [cmap])
    (fun i ↦ by
      fin_cases i
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide)
    (fun j j' h ↦ by fin_cases j <;> fin_cases j' <;> simp_all [cmap] <;> decide)

