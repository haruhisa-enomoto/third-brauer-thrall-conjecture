/-!
# The thin diagram `F64`

BO13a figure 6.4: the square `β ≫ w₂ = ψ ≫ u₂` with `σₙ ← x' → m` (`ρₙ'`) and `x → b'' ← x''` (`w₁'`, `σ₂'`).

Generated by `scripts/gen_thin_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `F64`. -/
inductive F64
  | x | b | m | y₀ | x' | zn | b'' | x''
  deriving DecidableEq

namespace F64

instance : Fintype F64 := ⟨{x, b, m, y₀, x', zn, b'', x''}, by intro v; cases v <;> simp⟩

/-- The order (nonzero morphisms). -/
def leb : F64 → F64 → Bool
  | b, b | b, y₀ | b'', b'' | m, m | m, y₀ | x, b | x, b'' | x, m | x, x | x, y₀ | x', m | x', x' | x', y₀ | x', zn | x'', b'' | x'', x'' | y₀, y₀ | zn, zn => true
  | _, _ => false

/-- The arrows. -/
def arb : F64 → F64 → Bool
  | b, y₀ | m, y₀ | x, b | x, b'' | x, m | x', m | x', zn | x'', b'' => true
  | _, _ => false

/-- The thin category. -/
abbrev thin : ThinData F64 where
  le x y := leb x y = true
  nz x _ z := leb x z = true
  refl x := by cases x <;> rfl
  antisymm := by decide
  nz_le _ _ _ _ _ h := h
  nz_left _ _ h := h
  nz_right _ _ h := h
  assoc := by decide

/-- The generating arrows. -/
abbrev arrows : ThinArrows thin where
  ar x y := arb x y = true
  ar_le := by decide
  ar_ne := by decide
  first := by decide
  last := by decide

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {X Bb M Y₀ X' Zn B'' X'' : P}
  (β : X ⟶ Bb) (ψ : X ⟶ M) (W : Bb ⟶ Y₀) (U : M ⟶ Y₀) (σn : X' ⟶ Zn) (r : X' ⟶ M) (w₁ : X ⟶ B'') (t : X'' ⟶ B'')

/-- The objects. -/
abbrev obj : F64 → P
  | x => X | b => Bb | m => M | y₀ => Y₀ | x' => X' | zn => Zn | b'' => B'' | x'' => X''

/-- The morphisms. -/
abbrev tab : ∀ u v : F64, (obj (X := X) (Bb := Bb) (M := M) (Y₀ := Y₀) (X' := X') (Zn := Zn) (B'' := B'') (X'' := X'') u) ⟶ obj (X := X) (Bb := Bb) (M := M) (Y₀ := Y₀) (X' := X') (Zn := Zn) (B'' := B'') (X'' := X'') v
  | b, b => 𝟙 _
  | b, y₀ => W
  | b'', b'' => 𝟙 _
  | m, m => 𝟙 _
  | m, y₀ => U
  | x, b => β
  | x, b'' => w₁
  | x, m => ψ
  | x, x => 𝟙 _
  | x, y₀ => β ≫ W
  | x', m => r
  | x', x' => 𝟙 _
  | x', y₀ => r ≫ U
  | x', zn => σn
  | x'', b'' => t
  | x'', x'' => 𝟙 _
  | y₀, y₀ => 𝟙 _
  | zn, zn => 𝟙 _
  | _, _ => 0

end Diagram

end F64

end RayCat

