namespace MulBasis

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type u} [Field k] [Infinite k]
  {A : Type u} [Ring A] [Algebra k A] (B : MulBasis k P A)

set_option maxHeartbeats 16000000 in
open F64 in
include B in
/-- **No cleaving diagram `F64` in `P/τ`.** -/
theorem not_f64
    (hmin : ∀ I : TwoSidedIdeal A, I ≠ ⊥ → Statement.IsRepresentationFinite (A ⧸ I.asIdeal))
    (hL : LeftCancel P) (hR : RightCancel P) {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {X Bb M Y₀ X' Zn B'' X'' : P}
    (β : X ⟶ Bb) (ψ : X ⟶ M) (W : Bb ⟶ Y₀) (U : M ⟶ Y₀) (σn : X' ⟶ Zn) (r : X' ⟶ M) (w₁ : X ⟶ B'') (t : X'' ⟶ B'')
    (hD : ¬Statement.IsRepresentationFinite (Linearization (ThinCat thin) k))
    (hc0 : ψ ≫ U = β ≫ W)
    (h0_b_y₀ : ¬FactorsThroughMorphism τ (W))
    (h0_m_y₀ : ¬FactorsThroughMorphism τ (U))
    (h0_x_b : ¬FactorsThroughMorphism τ (β))
    (h0_x_b'' : ¬FactorsThroughMorphism τ (w₁))
    (h0_x_m : ¬FactorsThroughMorphism τ (ψ))
    (h0_x_y₀ : ¬FactorsThroughMorphism τ (β ≫ W))
    (h0_x'_m : ¬FactorsThroughMorphism τ (r))
    (h0_x'_y₀ : ¬FactorsThroughMorphism τ (r ≫ U))
    (h0_x'_zn : ¬FactorsThroughMorphism τ (σn))
    (h0_x''_b'' : ¬FactorsThroughMorphism τ (t))
    (hi_β : ¬IsIso β)
    (hi_ψ : ¬IsIso ψ)
    (hi_W : ¬IsIso W)
    (hi_U : ¬IsIso U)
    (hi_σn : ¬IsIso σn)
    (hi_r : ¬IsIso r)
    (hi_w₁ : ¬IsIso w₁)
    (hi_t : ¬IsIso t)
    (hlft_x_b_m : ¬∃ g, β ≫ g = ψ)
    (hlft_x_b_b'' : ¬∃ g, β ≫ g = w₁)
    (hlft_x_b''_b : ¬∃ g, w₁ ≫ g = β)
    (hlft_x_b''_m : ¬∃ g, w₁ ≫ g = ψ)
    (hlft_x_b''_y₀ : ¬∃ g, w₁ ≫ g = β ≫ W)
    (hlft_x_m_b : ¬∃ g, ψ ≫ g = β)
    (hlft_x_m_b'' : ¬∃ g, ψ ≫ g = w₁)
    (hlft_x'_m_zn : ¬∃ g, r ≫ g = σn)
    (hlft_x'_zn_m : ¬∃ g, σn ≫ g = r)
    (hlft_x'_zn_y₀ : ¬∃ g, σn ≫ g = r ≫ U)
    (hrgt_m_b_y₀ : ¬∃ g, g ≫ W = U)
    (hrgt_x'_b_y₀ : ¬∃ g, g ≫ W = r ≫ U)
    (hrgt_b_m_y₀ : ¬∃ g, g ≫ U = W)
    (hrgt_x''_x_b'' : ¬∃ g, g ≫ w₁ = t)
    (hrgt_x'_x_m : ¬∃ g, g ≫ ψ = r)
    (hrgt_x_x'_m : ¬∃ g, g ≫ r = ψ)
    (hrgt_x_x''_b'' : ¬∃ g, g ≫ t = w₁)
    : False := by
  have hlft_b_y₀_b : ¬∃ g, W ≫ g = 𝟙 _ := not_split_mono hi_W
  have hlft_m_y₀_m : ¬∃ g, U ≫ g = 𝟙 _ := not_split_mono hi_U
  have hlft_x_b_x : ¬∃ g, β ≫ g = 𝟙 _ := not_split_mono hi_β
  have hlft_x_b''_x : ¬∃ g, w₁ ≫ g = 𝟙 _ := not_split_mono hi_w₁
  have hlft_x_m_x : ¬∃ g, ψ ≫ g = 𝟙 _ := not_split_mono hi_ψ
  have hlft_x'_m_x' : ¬∃ g, r ≫ g = 𝟙 _ := not_split_mono hi_r
  have hlft_x'_zn_x' : ¬∃ g, σn ≫ g = 𝟙 _ := not_split_mono hi_σn
  have hlft_x''_b''_x'' : ¬∃ g, t ≫ g = 𝟙 _ := not_split_mono hi_t
  have hrgt_y₀_b_y₀ : ¬∃ g, g ≫ W = 𝟙 _ := not_split_epi hi_W
  have hrgt_y₀_m_y₀ : ¬∃ g, g ≫ U = 𝟙 _ := not_split_epi hi_U
  have hrgt_b_x_b : ¬∃ g, g ≫ β = 𝟙 _ := not_split_epi hi_β
  have hrgt_b''_x_b'' : ¬∃ g, g ≫ w₁ = 𝟙 _ := not_split_epi hi_w₁
  have hrgt_m_x_m : ¬∃ g, g ≫ ψ = 𝟙 _ := not_split_epi hi_ψ
  have hrgt_m_x'_m : ¬∃ g, g ≫ r = 𝟙 _ := not_split_epi hi_r
  have hrgt_zn_x'_zn : ¬∃ g, g ≫ σn = 𝟙 _ := not_split_epi hi_σn
  have hrgt_b''_x''_b'' : ¬∃ g, g ≫ t = 𝟙 _ := not_split_epi hi_t
  have hc0' := reassoc_of% hc0
  refine B.not_thin_diagram hmin hL hR τ hτ hτ0 hD arrows obj (fun x y _ ↦ tab β ψ W U σn r w₁ t x y)
    (fun x ↦ by cases x <;> rfl) ?_ ?_ ?_ ?_
  · intro x y z h h'
    cases x <;> cases y <;> (try exact absurd h (by decide)) <;> cases z <;>
      (try exact absurd h' (by decide)) <;> split_ifs with hn <;>
      (try exact absurd hn (by decide)) <;>
      simp only [tab, Category.assoc, Category.id_comp, Category.comp_id, zero_comp, comp_zero, hc0', hc0]
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | exact not_factorsThrough_id hτ _
      | assumption
  · intro x z y ha hy
    cases x <;> cases z <;> (try exact absurd ha (by decide)) <;> cases y <;>
      (try exact absurd hy (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›
  · intro x z y ha hx
    cases z <;> cases y <;> (try exact absurd ha (by decide)) <;> cases x <;>
      (try exact absurd hx (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›

end MulBasis

