/-!
# The tree diagram `F88`

BO13a figure 8.8: the `Ẽ₆` tree with centre `a` and arms `a ← x → c'`, `a ← x₂ → tφ`, `a ← xn → yn1`.

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `F88`. -/
inductive F88
  | a | x | c' | x₂ | tφ | xn | yn1
  deriving DecidableEq

namespace F88

instance : Fintype F88 := ⟨{a, x, c', x₂, tφ, xn, yn1}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : F88 → F88 → Bool
  | x, a | x, c' | x₂, a | x₂, tφ | xn, a | xn, yn1 => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : F88) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph F88 := SimpleGraph.fromRel o

lemma adj_iff (u v : F88) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : F88) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : F88) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : F88) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : F88 → Option F88
  | a => none
  | x => some a
  | c' => some x
  | x₂ => some a
  | tφ => some x₂
  | xn => some a
  | yn1 => some xn

/-- The height. -/
def ht : F88 → ℕ
  | a => 0
  | x => 1
  | c' => 2
  | x₂ => 1
  | tφ => 2
  | xn => 1
  | yn1 => 2

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `Ẽ₆`. -/
def cmap : AffineE6 → F88
  | .center => a
  | .inner i => if (i : ℕ) = 0 then x else if (i : ℕ) = 1 then x₂ else xn
  | .outer i => if (i : ℕ) = 0 then c' else if (i : ℕ) = 1 then tφ else yn1

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `Ẽ₆`. -/
def copy : (underlyingGraph AffineE6).Copy G :=
  copyOf G cmap (by
    intro u v h
    rcases u with _ | i | i <;> rcases v with _ | j | j <;>
      (try fin_cases i) <;> (try fin_cases j) <;> simp_all [cmap])
    (by
      intro a b e
      rcases a with _ | i | i <;> rcases b with _ | j | j
      all_goals first
        | exact (IsEmpty.false e).elim
        | exact e.elim
        | (obtain rfl : i = j := e.down; fin_cases i <;> simp only [cmap] <;> decide)
        | (fin_cases i <;> simp only [cmap] <;> decide))

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {Aa X C' X₂ Tφ Xn Yn1 : P}
  (V₁ : X ⟶ Aa) (W₁ : X ⟶ C') (σ₂' : X₂ ⟶ Aa) (φ : X₂ ⟶ Tφ) (r : Xn ⟶ Aa) (σn : Xn ⟶ Yn1)

/-- The objects. -/
def obj : F88 → P
  | a => Aa | x => X | c' => C' | x₂ => X₂ | tφ => Tφ | xn => Xn | yn1 => Yn1

/-- The arrows. -/
def arr : ∀ u v : F88, o u v → ((obj (Aa := Aa) (X := X) (C' := C') (X₂ := X₂) (Tφ := Tφ) (Xn := Xn) (Yn1 := Yn1) u) ⟶ obj (Aa := Aa) (X := X) (C' := C') (X₂ := X₂) (Tφ := Tφ) (Xn := Xn) (Yn1 := Yn1) v)
  | x, a, _ => V₁
  | x, c', _ => W₁
  | x₂, a, _ => σ₂'
  | x₂, tφ, _ => φ
  | xn, a, _ => r
  | xn, yn1, _ => σn
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : F88, Option ((obj (Aa := Aa) (X := X) (C' := C') (X₂ := X₂) (Tφ := Tφ) (Xn := Xn) (Yn1 := Yn1) u) ⟶ obj (Aa := Aa) (X := X) (C' := C') (X₂ := X₂) (Tφ := Tφ) (Xn := Xn) (Yn1 := Yn1) v)
  | a, a => some (𝟙 _)
  | x, x => some (𝟙 _)
  | x, a => some (V₁)
  | x, c' => some (W₁)
  | c', c' => some (𝟙 _)
  | x₂, x₂ => some (𝟙 _)
  | x₂, a => some (σ₂')
  | x₂, tφ => some (φ)
  | tφ, tφ => some (𝟙 _)
  | xn, xn => some (𝟙 _)
  | xn, a => some (r)
  | xn, yn1 => some (σn)
  | yn1, yn1 => some (𝟙 _)
  | _, _ => none

end Diagram

