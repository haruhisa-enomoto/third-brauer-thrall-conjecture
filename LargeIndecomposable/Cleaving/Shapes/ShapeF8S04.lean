/-- Vertices of the diagram `F8S04`. -/
inductive F8S04
  | a | y₀ | y₁ | z₂ | yn1
  deriving DecidableEq

namespace F8S04

instance : Fintype F8S04 := ⟨{a, y₀, y₁, z₂, yn1}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : F8S04 → F8S04 → Bool
  | a, y₀ | a, y₁ | a, z₂ | a, yn1 => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : F8S04) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph F8S04 := SimpleGraph.fromRel o

lemma adj_iff (u v : F8S04) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : F8S04) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : F8S04) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : F8S04) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : F8S04 → Option F8S04
  | a => none
  | y₀ => some a
  | y₁ => some a
  | z₂ => some a
  | yn1 => some a

/-- The height. -/
def ht : F8S04 → ℕ
  | a => 0
  | y₀ => 1
  | y₁ => 1
  | z₂ => 1
  | yn1 => 1

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

