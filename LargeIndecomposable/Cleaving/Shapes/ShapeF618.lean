namespace RayCat

/-- Vertices of the diagram `F618`. -/
inductive F618
  | c | x' | y₀ | m | z₂ | y₁
  deriving DecidableEq

namespace F618

instance : Fintype F618 := ⟨{c, x', y₀, m, z₂, y₁}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : F618 → F618 → Bool
  | x', c | c, y₀ | m, c | m, z₂ | m, y₁ => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : F618) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph F618 := SimpleGraph.fromRel o

lemma adj_iff (u v : F618) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : F618) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : F618) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : F618) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : F618 → Option F618
  | c => none
  | x' => some c
  | y₀ => some c
  | m => some c
  | z₂ => some m
  | y₁ => some m

/-- The height. -/
def ht : F618 → ℕ
  | c => 0
  | x' => 1
  | y₀ => 1
  | m => 1
  | z₂ => 2
  | y₁ => 2

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `D̃`. -/
def cmap : AffineD 1 → F618
  | .spine j => if (j : ℕ) = 0 then c else m
  | .leaf i => if (i : ℕ) = 0 then x' else if (i : ℕ) = 1 then y₀ else if (i : ℕ) = 2 then z₂ else y₁

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `D̃`. -/
def copy : (underlyingGraph (AffineD 1)).Copy G :=
  copyD G 1 cmap (by
    intro u v h
    rcases u with i | j <;> rcases v with i' | j'
    · fin_cases i <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases i <;> fin_cases j' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases j' <;> simp_all [cmap])
    (fun i ↦ by
      fin_cases i
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide)
    (fun j j' h ↦ by fin_cases j <;> fin_cases j' <;> simp_all [cmap] <;> decide)

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {Cc X' Y₀ M Z₂ Y₁ : P}
  (r : X' ⟶ Cc) (bb : Cc ⟶ Y₀) (a : M ⟶ Cc) (q : M ⟶ Z₂) (U' : M ⟶ Y₁)

/-- The objects. -/
def obj : F618 → P
  | c => Cc | x' => X' | y₀ => Y₀ | m => M | z₂ => Z₂ | y₁ => Y₁

/-- The arrows. -/
def arr : ∀ u v : F618, o u v → ((obj (Cc := Cc) (X' := X') (Y₀ := Y₀) (M := M) (Z₂ := Z₂) (Y₁ := Y₁) u) ⟶ obj (Cc := Cc) (X' := X') (Y₀ := Y₀) (M := M) (Z₂ := Z₂) (Y₁ := Y₁) v)
  | x', c, _ => r
  | c, y₀, _ => bb
  | m, c, _ => a
  | m, z₂, _ => q
  | m, y₁, _ => U'
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : F618, Option ((obj (Cc := Cc) (X' := X') (Y₀ := Y₀) (M := M) (Z₂ := Z₂) (Y₁ := Y₁) u) ⟶ obj (Cc := Cc) (X' := X') (Y₀ := Y₀) (M := M) (Z₂ := Z₂) (Y₁ := Y₁) v)
  | c, c => some (𝟙 _)
  | c, y₀ => some (bb)
  | x', x' => some (𝟙 _)
  | x', c => some (r)
  | x', y₀ => some (r ≫ bb)
  | y₀, y₀ => some (𝟙 _)
  | m, m => some (𝟙 _)
  | m, c => some (a)
  | m, y₀ => some (a ≫ bb)
  | m, z₂ => some (q)
  | m, y₁ => some (U')
  | z₂, z₂ => some (𝟙 _)
  | y₁, y₁ => some (𝟙 _)
  | _, _ => none

end Diagram

