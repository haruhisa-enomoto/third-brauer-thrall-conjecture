/-!
# The thin diagram `F86`

BO13a figure 8.6: `c' ← x → a ← x₂ → tφ`, `xn → a → y₁` with `ρn' ≫ ρ₁' = 0`.

Generated by `scripts/gen_thin_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `F86`. -/
inductive F86
  | x | c' | a | xn | y₁ | x₂ | tφ
  deriving DecidableEq

namespace F86

instance : Fintype F86 := ⟨{x, c', a, xn, y₁, x₂, tφ}, by intro v; cases v <;> simp⟩

/-- The order (nonzero morphisms). -/
def leb : F86 → F86 → Bool
  | a, a | a, y₁ | c', c' | tφ, tφ | x, a | x, c' | x, x | x, y₁ | xn, a | xn, xn | x₂, a | x₂, tφ | x₂, x₂ | x₂, y₁ | y₁, y₁ => true
  | _, _ => false

/-- The arrows. -/
def arb : F86 → F86 → Bool
  | a, y₁ | x, a | x, c' | xn, a | x₂, a | x₂, tφ => true
  | _, _ => false

/-- The thin category. -/
abbrev thin : ThinData F86 where
  le x y := leb x y = true
  nz x _ z := leb x z = true
  refl x := by cases x <;> rfl
  antisymm := by decide
  nz_le _ _ _ _ _ h := h
  nz_left _ _ h := h
  nz_right _ _ h := h
  assoc := by decide

/-- The generating arrows. -/
abbrev arrows : ThinArrows thin where
  ar x y := arb x y = true
  ar_le := by decide
  ar_ne := by decide
  first := by decide
  last := by decide

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {X C' Aa Xn Y₁ X₂ Tφ : P}
  (W₁ : X ⟶ C') (V₁ : X ⟶ Aa) (r : Xn ⟶ Aa) (ρ₁' : Aa ⟶ Y₁) (σ₂' : X₂ ⟶ Aa) (φ : X₂ ⟶ Tφ)

/-- The objects. -/
abbrev obj : F86 → P
  | x => X | c' => C' | a => Aa | xn => Xn | y₁ => Y₁ | x₂ => X₂ | tφ => Tφ

/-- The morphisms. -/
abbrev tab : ∀ u v : F86, (obj (X := X) (C' := C') (Aa := Aa) (Xn := Xn) (Y₁ := Y₁) (X₂ := X₂) (Tφ := Tφ) u) ⟶ obj (X := X) (C' := C') (Aa := Aa) (Xn := Xn) (Y₁ := Y₁) (X₂ := X₂) (Tφ := Tφ) v
  | a, a => 𝟙 _
  | a, y₁ => ρ₁'
  | c', c' => 𝟙 _
  | tφ, tφ => 𝟙 _
  | x, a => V₁
  | x, c' => W₁
  | x, x => 𝟙 _
  | x, y₁ => V₁ ≫ ρ₁'
  | xn, a => r
  | xn, xn => 𝟙 _
  | x₂, a => σ₂'
  | x₂, tφ => φ
  | x₂, x₂ => 𝟙 _
  | x₂, y₁ => σ₂' ≫ ρ₁'
  | y₁, y₁ => 𝟙 _
  | _, _ => 0

end Diagram

