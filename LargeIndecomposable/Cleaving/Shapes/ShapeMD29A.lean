variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type*} [Field k] [Infinite k]

set_option maxHeartbeats 16000000 in
open MD29A in
/-- **No cleaving diagram `MD29A` in `P/τ`.** -/
theorem MildHyp.not_md29a (hM : MildHyp k P) {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {OA1 OXm OY1 OA2 OC0 OB3 OB0 : P}
    (γl : OC0 ⟶ OA1) (η : OA1 ⟶ OXm) (δ : OXm ⟶ OB3) (β : OB0 ⟶ OY1) (ω : OY1 ⟶ OA2) (α : OA1 ⟶ OY1) (γ : OXm ⟶ OA2)
    (hD : ¬Statement.IsRepresentationFinite (Linearization (ThinCat thin) k))
    (hc0 : α ≫ ω = η ≫ γ)
    (hc1 : γl ≫ α ≫ ω = γl ≫ η ≫ γ)
    (h0_A1_A2 : ¬FactorsThroughMorphism τ (η ≫ γ))
    (h0_A1_B3 : ¬FactorsThroughMorphism τ (η ≫ δ))
    (h0_A1_Xm : ¬FactorsThroughMorphism τ (η))
    (h0_A1_Y1 : ¬FactorsThroughMorphism τ (α))
    (h0_B0_A2 : ¬FactorsThroughMorphism τ (β ≫ ω))
    (h0_B0_Y1 : ¬FactorsThroughMorphism τ (β))
    (h0_C0_A1 : ¬FactorsThroughMorphism τ (γl))
    (h0_C0_A2 : ¬FactorsThroughMorphism τ ((γl ≫ η) ≫ γ))
    (h0_C0_B3 : ¬FactorsThroughMorphism τ ((γl ≫ η) ≫ δ))
    (h0_C0_Xm : ¬FactorsThroughMorphism τ (γl ≫ η))
    (h0_C0_Y1 : ¬FactorsThroughMorphism τ (γl ≫ α))
    (h0_Xm_A2 : ¬FactorsThroughMorphism τ (γ))
    (h0_Xm_B3 : ¬FactorsThroughMorphism τ (δ))
    (h0_Y1_A2 : ¬FactorsThroughMorphism τ (ω))
    (hi_γl : ¬IsIso γl)
    (hi_η : ¬IsIso η)
    (hi_δ : ¬IsIso δ)
    (hi_β : ¬IsIso β)
    (hi_ω : ¬IsIso ω)
    (hi_α : ¬IsIso α)
    (hi_γ : ¬IsIso γ)
    (hlft_A1_Xm_Y1 : ¬∃ g, η ≫ g = α)
    (hlft_A1_Y1_Xm : ¬∃ g, α ≫ g = η)
    (hlft_A1_Y1_B3 : ¬∃ g, α ≫ g = η ≫ δ)
    (hlft_Xm_A2_B3 : ¬∃ g, γ ≫ g = δ)
    (hlft_Xm_B3_A2 : ¬∃ g, δ ≫ g = γ)
    (hrgt_B0_A1_Y1 : ¬∃ g, g ≫ α = β)
    (hrgt_A1_B0_Y1 : ¬∃ g, g ≫ β = α)
    (hrgt_C0_B0_Y1 : ¬∃ g, g ≫ β = γl ≫ α)
    (hrgt_Y1_Xm_A2 : ¬∃ g, g ≫ γ = ω)
    (hrgt_B0_Xm_A2 : ¬∃ g, g ≫ γ = β ≫ ω)
    (hrgt_Xm_Y1_A2 : ¬∃ g, g ≫ ω = γ)
    : False := by
  have hlft_A1_Xm_A1 : ¬∃ g, η ≫ g = 𝟙 _ := not_split_mono hi_η
  have hlft_A1_Y1_A1 : ¬∃ g, α ≫ g = 𝟙 _ := not_split_mono hi_α
  have hlft_B0_Y1_B0 : ¬∃ g, β ≫ g = 𝟙 _ := not_split_mono hi_β
  have hlft_C0_A1_C0 : ¬∃ g, γl ≫ g = 𝟙 _ := not_split_mono hi_γl
  have hlft_Xm_A2_Xm : ¬∃ g, γ ≫ g = 𝟙 _ := not_split_mono hi_γ
  have hlft_Xm_B3_Xm : ¬∃ g, δ ≫ g = 𝟙 _ := not_split_mono hi_δ
  have hlft_Y1_A2_Y1 : ¬∃ g, ω ≫ g = 𝟙 _ := not_split_mono hi_ω
  have hrgt_Xm_A1_Xm : ¬∃ g, g ≫ η = 𝟙 _ := not_split_epi hi_η
  have hrgt_Y1_A1_Y1 : ¬∃ g, g ≫ α = 𝟙 _ := not_split_epi hi_α
  have hrgt_Y1_B0_Y1 : ¬∃ g, g ≫ β = 𝟙 _ := not_split_epi hi_β
  have hrgt_A1_C0_A1 : ¬∃ g, g ≫ γl = 𝟙 _ := not_split_epi hi_γl
  have hrgt_A2_Xm_A2 : ¬∃ g, g ≫ γ = 𝟙 _ := not_split_epi hi_γ
  have hrgt_B3_Xm_B3 : ¬∃ g, g ≫ δ = 𝟙 _ := not_split_epi hi_δ
  have hrgt_A2_Y1_A2 : ¬∃ g, g ≫ ω = 𝟙 _ := not_split_epi hi_ω
  have hc0' := reassoc_of% hc0
  have hc1' := reassoc_of% hc1
  refine hM.not_thin_diagram τ hτ hτ0 hD arrows obj (fun x y _ ↦ tab γl η δ β ω α γ x y)
    (fun x ↦ by cases x <;> rfl) ?_ ?_ ?_ ?_
  · intro x y z h h'
    cases x <;> cases y <;> (try exact absurd h (by decide)) <;> cases z <;>
      (try exact absurd h' (by decide)) <;> split_ifs with hn <;>
      (try exact absurd hn (by decide)) <;>
      simp only [tab, Category.assoc, Category.id_comp, Category.comp_id, zero_comp, comp_zero, hc0', hc0, hc1', hc1]
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | exact not_factorsThrough_id hτ _
      | assumption
  · intro x z y ha hy
    cases x <;> cases z <;> (try exact absurd ha (by decide)) <;> cases y <;>
      (try exact absurd hy (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›
  · intro x z y ha hx
    cases z <;> cases y <;> (try exact absurd ha (by decide)) <;> cases x <;>
      (try exact absurd hx (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›

end RayCat

