/-- The order (nonzero morphisms). -/
def leb : MD29A → MD29A → Bool
  | A1, A1 | A1, A2 | A1, B3 | A1, Xm | A1, Y1 | A2, A2 | B0, A2 | B0, B0 | B0, Y1 | B3, B3 | C0, A1 | C0, A2 | C0, B3 | C0, C0 | C0, Xm | C0, Y1 | Xm, A2 | Xm, B3 | Xm, Xm | Y1, A2 | Y1, Y1 => true
  | _, _ => false

/-- The arrows. -/
def arb : MD29A → MD29A → Bool
  | A1, Xm | A1, Y1 | B0, Y1 | C0, A1 | Xm, A2 | Xm, B3 | Y1, A2 => true
  | _, _ => false

/-- The thin category. -/
abbrev thin : ThinData MD29A where
  le x y := leb x y = true
  nz x _ z := leb x z = true
  refl x := by cases x <;> rfl
  antisymm := by decide
  nz_le _ _ _ _ _ h := h
  nz_left _ _ h := h
  nz_right _ _ h := h
  assoc := by decide

/-- The generating arrows. -/
abbrev arrows : ThinArrows thin where
  ar x y := arb x y = true
  ar_le := by decide
  ar_ne := by decide
  first := by decide
  last := by decide

