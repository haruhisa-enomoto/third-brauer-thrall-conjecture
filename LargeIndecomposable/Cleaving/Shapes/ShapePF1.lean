/-!
# The tree diagram `MPF1`

[mild] figure 2.4 (first diagram): `y₁ →α y₂ →α y₃ →α y₄` with `t₁ →β y₂`, `t₂ →β y₃`.

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `MPF1`. -/
inductive MPF1
  | y2 | y1 | t1 | y3 | y4 | t2
  deriving DecidableEq

namespace MPF1

instance : Fintype MPF1 := ⟨{y2, y1, t1, y3, y4, t2}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : MPF1 → MPF1 → Bool
  | y1, y2 | y2, y3 | y3, y4 | t1, y2 | t2, y3 => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : MPF1) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph MPF1 := SimpleGraph.fromRel o

lemma adj_iff (u v : MPF1) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : MPF1) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : MPF1) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : MPF1) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : MPF1 → Option MPF1
  | y2 => none
  | y1 => some y2
  | t1 => some y2
  | y3 => some y2
  | y4 => some y3
  | t2 => some y3

/-- The height. -/
def ht : MPF1 → ℕ
  | y2 => 0
  | y1 => 1
  | t1 => 1
  | y3 => 1
  | y4 => 2
  | t2 => 2

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `D̃`. -/
def cmap : AffineD 1 → MPF1
  | .spine j => if (j : ℕ) = 0 then y2 else y3
  | .leaf i => if (i : ℕ) = 0 then y1 else if (i : ℕ) = 1 then t1 else if (i : ℕ) = 2 then y4 else t2

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `D̃`. -/
def copy : (underlyingGraph (AffineD 1)).Copy G :=
  copyD G 1 cmap (by
    intro u v h
    rcases u with i | j <;> rcases v with i' | j'
    · fin_cases i <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases i <;> fin_cases j' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases j' <;> simp_all [cmap])
    (fun i ↦ by
      fin_cases i
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide)
    (fun j j' h ↦ by fin_cases j <;> fin_cases j' <;> simp_all [cmap] <;> decide)

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {Y₂ Y₁ T₁ Y₃ Y₄ T₂ : P}
  (α₁ : Y₁ ⟶ Y₂) (α₂ : Y₂ ⟶ Y₃) (α₃ : Y₃ ⟶ Y₄) (β₁ : T₁ ⟶ Y₂) (β₂ : T₂ ⟶ Y₃)

/-- The objects. -/
def obj : MPF1 → P
  | y2 => Y₂ | y1 => Y₁ | t1 => T₁ | y3 => Y₃ | y4 => Y₄ | t2 => T₂

/-- The arrows. -/
def arr : ∀ u v : MPF1, o u v → ((obj (Y₂ := Y₂) (Y₁ := Y₁) (T₁ := T₁) (Y₃ := Y₃) (Y₄ := Y₄) (T₂ := T₂) u) ⟶ obj (Y₂ := Y₂) (Y₁ := Y₁) (T₁ := T₁) (Y₃ := Y₃) (Y₄ := Y₄) (T₂ := T₂) v)
  | y1, y2, _ => α₁
  | y2, y3, _ => α₂
  | y3, y4, _ => α₃
  | t1, y2, _ => β₁
  | t2, y3, _ => β₂
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : MPF1, Option ((obj (Y₂ := Y₂) (Y₁ := Y₁) (T₁ := T₁) (Y₃ := Y₃) (Y₄ := Y₄) (T₂ := T₂) u) ⟶ obj (Y₂ := Y₂) (Y₁ := Y₁) (T₁ := T₁) (Y₃ := Y₃) (Y₄ := Y₄) (T₂ := T₂) v)
  | y2, y2 => some (𝟙 _)
  | y2, y3 => some (α₂)
  | y2, y4 => some (α₂ ≫ α₃)
  | y1, y1 => some (𝟙 _)
  | y1, y2 => some (α₁)
  | y1, y3 => some (α₁ ≫ α₂)
  | y1, y4 => some ((α₁ ≫ α₂) ≫ α₃)
  | t1, t1 => some (𝟙 _)
  | t1, y2 => some (β₁)
  | t1, y3 => some (β₁ ≫ α₂)
  | t1, y4 => some ((β₁ ≫ α₂) ≫ α₃)
  | y3, y3 => some (𝟙 _)
  | y3, y4 => some (α₃)
  | y4, y4 => some (𝟙 _)
  | t2, t2 => some (𝟙 _)
  | t2, y3 => some (β₂)
  | t2, y4 => some (β₂ ≫ α₃)
  | _, _ => none

end Diagram

end MPF1

