variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type u} [Field k] [Infinite k]

set_option maxHeartbeats 8000000 in
open DB23B in
/-- **No cleaving diagram `DB23B` in `P/τ`.** -/
theorem MildHyp.not_db23b (hM : MildHyp k P)
    {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {OS2 OS1 OR1 OR2 OS3 OT1 OR3 OT2 : P}
    (c₁ : OS1 ⟶ OS2) (c₂ : OS2 ⟶ OS3) (φ : OS2 ⟶ OT1) (μ : OS1 ⟶ OR1) (a₁ : OR2 ⟶ OR1) (a₂ : OR3 ⟶ OR2) (β : OT2 ⟶ OR2)
    (h0_S2_S3 : ¬FactorsThroughMorphism τ (c₂))
    (h0_S2_T1 : ¬FactorsThroughMorphism τ (φ))
    (h0_S1_S2 : ¬FactorsThroughMorphism τ (c₁))
    (h0_S1_S3 : ¬FactorsThroughMorphism τ (c₁ ≫ c₂))
    (h0_S1_T1 : ¬FactorsThroughMorphism τ (c₁ ≫ φ))
    (h0_S1_R1 : ¬FactorsThroughMorphism τ (μ))
    (h0_R2_R1 : ¬FactorsThroughMorphism τ (a₁))
    (h0_R3_R2 : ¬FactorsThroughMorphism τ (a₂))
    (h0_R3_R1 : ¬FactorsThroughMorphism τ (a₂ ≫ a₁))
    (h0_T2_R2 : ¬FactorsThroughMorphism τ (β))
    (h0_T2_R1 : ¬FactorsThroughMorphism τ (β ≫ a₁))
    (hi_c₁ : ¬IsIso c₁)
    (hi_c₂ : ¬IsIso c₂)
    (hi_φ : ¬IsIso φ)
    (hi_μ : ¬IsIso μ)
    (hi_a₁ : ¬IsIso a₁)
    (hi_a₂ : ¬IsIso a₂)
    (hi_β : ¬IsIso β)
    (hl_c₂_φ_T1 : ¬∃ g, c₂ ≫ g = φ)
    (hl_φ_c₂_S3 : ¬∃ g, φ ≫ g = c₂)
    (hl_c₁_μ_R1 : ¬∃ g, c₁ ≫ g = μ)
    (hl_μ_c₁_S2 : ¬∃ g, μ ≫ g = c₁)
    (hl_μ_c₁_S3 : ¬∃ g, μ ≫ g = c₁ ≫ c₂)
    (hl_μ_c₁_T1 : ¬∃ g, μ ≫ g = c₁ ≫ φ)
    (hr_μ_a₁_R2 : ¬∃ g, g ≫ μ = a₁)
    (hr_μ_a₁_R3 : ¬∃ g, g ≫ μ = a₂ ≫ a₁)
    (hr_μ_a₁_T2 : ¬∃ g, g ≫ μ = β ≫ a₁)
    (hr_a₁_μ_S1 : ¬∃ g, g ≫ a₁ = μ)
    (hr_a₂_β_T2 : ¬∃ g, g ≫ a₂ = β)
    (hr_β_a₂_R3 : ¬∃ g, g ≫ β = a₂)
    : False := by
  haveI : Fact (LargeIndecomposable.Foundations.Quiver.IsAcyclic (OT G o)) := ⟨OT.isAcyclic ho hasym isAcyclic⟩
  refine hM.not_tree_table τ hτ hτ0 G o ho hasym isAcyclic
    (OT.not_isRepresentationFinite_affineD ho hcov k 3 copy) obj (arr c₁ c₂ φ μ a₁ a₂ β)
    (tab c₁ c₂ φ μ a₁ a₂ β) (fun v ↦ by cases v <;> rfl) ?_ ?_ ?_ ?_ ?_
  · intro x y z h f hf
    cases y <;> cases z <;> (try exact absurd h (by decide)) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; rfl)
      | rfl
  · intro x y f hf hne
    cases x <;> cases y <;> (try exact absurd rfl hne) <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;> assumption
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | assumption
  · intro x c c' y h h' f hne hf
    cases x <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases y <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.comp_id]; assumption)
      | assumption
  · intro x c c' y h h' f hne hf
    cases y <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; assumption)
      | assumption

