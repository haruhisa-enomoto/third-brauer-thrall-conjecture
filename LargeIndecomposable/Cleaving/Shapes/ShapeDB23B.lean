/-!
# The tree diagram `DB23B`

`D̃₇` for a dumb-bell with `μ = φ β`, `φ` not invertible ([mild] figure 2.3, second diagram): spine `s₂ ← s₁ → r₁ ← r₂`, leaves `s₃`, `t₁` at `s₂` (along `χ`, `φ`) and `r₃`, `t₂` at `r₂` (along `α`, `β`).

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `DB23B`. -/
inductive DB23B
  | S2 | S1 | R1 | R2 | S3 | T1 | R3 | T2
  deriving DecidableEq

namespace DB23B

instance : Fintype DB23B := ⟨{S2, S1, R1, R2, S3, T1, R3, T2}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : DB23B → DB23B → Bool
  | S1, S2 | S2, S3 | S2, T1 | S1, R1 | R2, R1 | R3, R2 | T2, R2 => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : DB23B) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph DB23B := SimpleGraph.fromRel o

lemma adj_iff (u v : DB23B) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : DB23B) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : DB23B) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : DB23B) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : DB23B → Option DB23B
  | S2 => none
  | S1 => some S2
  | R1 => some S1
  | R2 => some R1
  | S3 => some S2
  | T1 => some S2
  | R3 => some R2
  | T2 => some R2

/-- The height. -/
def ht : DB23B → ℕ
  | S2 => 0
  | S1 => 1
  | R1 => 2
  | R2 => 3
  | S3 => 1
  | T1 => 1
  | R3 => 4
  | T2 => 4

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `D̃`. -/
def cmap : AffineD 3 → DB23B
  | .spine j => if (j : ℕ) = 0 then S2 else if (j : ℕ) = 1 then S1 else if (j : ℕ) = 2 then R1 else R2
  | .leaf i => if (i : ℕ) = 0 then S3 else if (i : ℕ) = 1 then T1 else if (i : ℕ) = 2 then R3 else T2

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `D̃`. -/
def copy : (underlyingGraph (AffineD 3)).Copy G :=
  copyD G 3 cmap (by
    intro u v h
    rcases u with i | j <;> rcases v with i' | j'
    · fin_cases i <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases i <;> fin_cases j' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases j' <;> simp_all [cmap])
    (fun i ↦ by
      fin_cases i
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide)
    (fun j j' h ↦ by fin_cases j <;> fin_cases j' <;> simp_all [cmap] <;> decide)

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {OS2 OS1 OR1 OR2 OS3 OT1 OR3 OT2 : P}
  (c₁ : OS1 ⟶ OS2) (c₂ : OS2 ⟶ OS3) (φ : OS2 ⟶ OT1) (μ : OS1 ⟶ OR1) (a₁ : OR2 ⟶ OR1) (a₂ : OR3 ⟶ OR2) (β : OT2 ⟶ OR2)

/-- The objects. -/
def obj : DB23B → P
  | S2 => OS2 | S1 => OS1 | R1 => OR1 | R2 => OR2 | S3 => OS3 | T1 => OT1 | R3 => OR3 | T2 => OT2

/-- The arrows. -/
def arr : ∀ u v : DB23B, o u v → ((obj (OS2 := OS2) (OS1 := OS1) (OR1 := OR1) (OR2 := OR2) (OS3 := OS3) (OT1 := OT1) (OR3 := OR3) (OT2 := OT2) u) ⟶ obj (OS2 := OS2) (OS1 := OS1) (OR1 := OR1) (OR2 := OR2) (OS3 := OS3) (OT1 := OT1) (OR3 := OR3) (OT2 := OT2) v)
  | S1, S2, _ => c₁
  | S2, S3, _ => c₂
  | S2, T1, _ => φ
  | S1, R1, _ => μ
  | R2, R1, _ => a₁
  | R3, R2, _ => a₂
  | T2, R2, _ => β
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : DB23B, Option ((obj (OS2 := OS2) (OS1 := OS1) (OR1 := OR1) (OR2 := OR2) (OS3 := OS3) (OT1 := OT1) (OR3 := OR3) (OT2 := OT2) u) ⟶ obj (OS2 := OS2) (OS1 := OS1) (OR1 := OR1) (OR2 := OR2) (OS3 := OS3) (OT1 := OT1) (OR3 := OR3) (OT2 := OT2) v)
  | S2, S2 => some (𝟙 _)
  | S2, S3 => some (c₂)
  | S2, T1 => some (φ)
  | S1, S1 => some (𝟙 _)
  | S1, S2 => some (c₁)
  | S1, S3 => some (c₁ ≫ c₂)
  | S1, T1 => some (c₁ ≫ φ)
  | S1, R1 => some (μ)
  | R1, R1 => some (𝟙 _)
  | R2, R2 => some (𝟙 _)
  | R2, R1 => some (a₁)
  | S3, S3 => some (𝟙 _)
  | T1, T1 => some (𝟙 _)
  | R3, R3 => some (𝟙 _)
  | R3, R2 => some (a₂)
  | R3, R1 => some (a₂ ≫ a₁)
  | T2, T2 => some (𝟙 _)
  | T2, R2 => some (β)
  | T2, R1 => some (β ≫ a₁)
