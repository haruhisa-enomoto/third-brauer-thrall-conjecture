open RayQuiver

namespace RayCat

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type*} [Field k] [Infinite k]

set_option maxHeartbeats 16000000 in
open LPF2 in
/-- **No cleaving diagram `LPF2` in `P/τ`.** -/
theorem MildHyp.not_lpf2 (hM : MildHyp k P) {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {OX0 OXI OY OXM OXB OX1 OXI2 OXI3 OX13 : P}
    (l : OX0 ⟶ OXI) (s : OXI ⟶ OXB) (ρ : OX0 ⟶ OXM) (ρ' : OXM ⟶ OXB) (ε : OXI ⟶ OY) (a : OXM ⟶ OX1) (c : OX1 ⟶ OXI2) (s' : OXI3 ⟶ OXM) (c' : OX13 ⟶ OXI3)
    (hD : ¬Statement.IsRepresentationFinite (Linearization (ThinCat thin) k))
    (hc0 : ρ ≫ ρ' = l ≫ s)
    (hz0 : c' ≫ s' ≫ a = 0)
    (hz1 : c' ≫ s' ≫ a ≫ c = 0)
    (hz2 : s' ≫ a = 0)
    (hz3 : s' ≫ a ≫ c = 0)
    (h0_X0_X1 : ¬FactorsThroughMorphism τ (ρ ≫ a))
    (h0_X0_XB : ¬FactorsThroughMorphism τ (l ≫ s))
    (h0_X0_XI : ¬FactorsThroughMorphism τ (l))
    (h0_X0_XI2 : ¬FactorsThroughMorphism τ ((ρ ≫ a) ≫ c))
    (h0_X0_XM : ¬FactorsThroughMorphism τ (ρ))
    (h0_X0_Y : ¬FactorsThroughMorphism τ (l ≫ ε))
    (h0_X1_XI2 : ¬FactorsThroughMorphism τ (c))
    (h0_X13_XB : ¬FactorsThroughMorphism τ ((c' ≫ s') ≫ ρ'))
    (h0_X13_XI3 : ¬FactorsThroughMorphism τ (c'))
    (h0_X13_XM : ¬FactorsThroughMorphism τ (c' ≫ s'))
    (h0_XI_XB : ¬FactorsThroughMorphism τ (s))
    (h0_XI_Y : ¬FactorsThroughMorphism τ (ε))
    (h0_XI3_XB : ¬FactorsThroughMorphism τ (s' ≫ ρ'))
    (h0_XI3_XM : ¬FactorsThroughMorphism τ (s'))
    (h0_XM_X1 : ¬FactorsThroughMorphism τ (a))
    (h0_XM_XB : ¬FactorsThroughMorphism τ (ρ'))
    (h0_XM_XI2 : ¬FactorsThroughMorphism τ (a ≫ c))
    (hi_l : ¬IsIso l)
    (hi_s : ¬IsIso s)
    (hi_ρ : ¬IsIso ρ)
    (hi_ρ' : ¬IsIso ρ')
    (hi_ε : ¬IsIso ε)
    (hi_a : ¬IsIso a)
    (hi_c : ¬IsIso c)
    (hi_s' : ¬IsIso s')
    (hi_c' : ¬IsIso c')
    (hlft_X0_XI_XM : ¬∃ g, l ≫ g = ρ)
    (hlft_X0_XI_X1 : ¬∃ g, l ≫ g = ρ ≫ a)
    (hlft_X0_XI_XI2 : ¬∃ g, l ≫ g = (ρ ≫ a) ≫ c)
    (hlft_X0_XM_XI : ¬∃ g, ρ ≫ g = l)
    (hlft_X0_XM_Y : ¬∃ g, ρ ≫ g = l ≫ ε)
    (hlft_XI_XB_Y : ¬∃ g, s ≫ g = ε)
    (hlft_XI_Y_XB : ¬∃ g, ε ≫ g = s)
    (hlft_XM_X1_XB : ¬∃ g, a ≫ g = ρ')
    (hlft_XM_XB_X1 : ¬∃ g, ρ' ≫ g = a)
    (hlft_XM_XB_XI2 : ¬∃ g, ρ' ≫ g = a ≫ c)
    (hrgt_XI3_X0_XM : ¬∃ g, g ≫ ρ = s')
    (hrgt_X13_X0_XM : ¬∃ g, g ≫ ρ = c' ≫ s')
    (hrgt_XM_XI_XB : ¬∃ g, g ≫ s = ρ')
    (hrgt_XI3_XI_XB : ¬∃ g, g ≫ s = s' ≫ ρ')
    (hrgt_X13_XI_XB : ¬∃ g, g ≫ s = (c' ≫ s') ≫ ρ')
    (hrgt_X0_XI3_XM : ¬∃ g, g ≫ s' = ρ)
    (hrgt_XI_XM_XB : ¬∃ g, g ≫ ρ' = s)
    : False := by
  have hlft_X0_XI_X0 : ¬∃ g, l ≫ g = 𝟙 _ := not_split_mono hi_l
  have hlft_X0_XM_X0 : ¬∃ g, ρ ≫ g = 𝟙 _ := not_split_mono hi_ρ
  have hlft_X1_XI2_X1 : ¬∃ g, c ≫ g = 𝟙 _ := not_split_mono hi_c
  have hlft_X13_XI3_X13 : ¬∃ g, c' ≫ g = 𝟙 _ := not_split_mono hi_c'
  have hlft_XI_XB_XI : ¬∃ g, s ≫ g = 𝟙 _ := not_split_mono hi_s
  have hlft_XI_Y_XI : ¬∃ g, ε ≫ g = 𝟙 _ := not_split_mono hi_ε
  have hlft_XI3_XM_XI3 : ¬∃ g, s' ≫ g = 𝟙 _ := not_split_mono hi_s'
  have hlft_XM_X1_XM : ¬∃ g, a ≫ g = 𝟙 _ := not_split_mono hi_a
  have hlft_XM_XB_XM : ¬∃ g, ρ' ≫ g = 𝟙 _ := not_split_mono hi_ρ'
  have hrgt_XI_X0_XI : ¬∃ g, g ≫ l = 𝟙 _ := not_split_epi hi_l
  have hrgt_XM_X0_XM : ¬∃ g, g ≫ ρ = 𝟙 _ := not_split_epi hi_ρ
  have hrgt_XI2_X1_XI2 : ¬∃ g, g ≫ c = 𝟙 _ := not_split_epi hi_c
  have hrgt_XI3_X13_XI3 : ¬∃ g, g ≫ c' = 𝟙 _ := not_split_epi hi_c'
  have hrgt_XB_XI_XB : ¬∃ g, g ≫ s = 𝟙 _ := not_split_epi hi_s
  have hrgt_Y_XI_Y : ¬∃ g, g ≫ ε = 𝟙 _ := not_split_epi hi_ε
  have hrgt_XM_XI3_XM : ¬∃ g, g ≫ s' = 𝟙 _ := not_split_epi hi_s'
  have hrgt_X1_XM_X1 : ¬∃ g, g ≫ a = 𝟙 _ := not_split_epi hi_a
  have hrgt_XB_XM_XB : ¬∃ g, g ≫ ρ' = 𝟙 _ := not_split_epi hi_ρ'
  have hc0' := reassoc_of% hc0
  have hz0' := reassoc_of% hz0
  have hz1' := reassoc_of% hz1
  have hz2' := reassoc_of% hz2
  have hz3' := reassoc_of% hz3
  refine hM.not_thin_diagram τ hτ hτ0 hD arrows obj (fun x y _ ↦ tab l s ρ ρ' ε a c s' c' x y)
    (fun x ↦ by cases x <;> rfl) ?_ ?_ ?_ ?_
  · intro x y z h h'
    cases x <;> cases y <;> (try exact absurd h (by decide)) <;> cases z <;>
      (try exact absurd h' (by decide)) <;> split_ifs with hn <;>
      (try exact absurd hn (by decide)) <;>
      simp only [tab, Category.assoc, Category.id_comp, Category.comp_id, zero_comp, comp_zero, hc0', hc0, hz0', hz0, hz1', hz1, hz2', hz2, hz3', hz3]
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | exact not_factorsThrough_id hτ _
      | assumption
  · intro x z y ha hy
    cases x <;> cases z <;> (try exact absurd ha (by decide)) <;> cases y <;>
      (try exact absurd hy (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›
  · intro x z y ha hx
    cases z <;> cases y <;> (try exact absurd ha (by decide)) <;> cases x <;>
      (try exact absurd hx (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›

end RayCat

end LargeIndecomposable
