/-!
# The thin diagram `LPF2`

[mild] figure 3.2, second diagram (LPF, exit `ε` at `x_i`, `i ≥ 2`): the square `λ ≫ σ = ρ ≫ ρ` (`λ` the prefix of `w` to `x_i`, `σ` the rest), `ε` at `x_i`, `ρ ≫ a₁ ≫ c` (`c : x₁ → x_i`) and `c' ≫ σ` into the middle `x₀`.

Generated by `scripts/gen_thin_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `LPF2`. -/
inductive LPF2
  | X0 | XI | Y | XM | XB | X1 | XI2 | XI3 | X13
  deriving DecidableEq

namespace LPF2

instance : Fintype LPF2 := ⟨{X0, XI, Y, XM, XB, X1, XI2, XI3, X13}, by intro v; cases v <;> simp⟩

/-- The order (nonzero morphisms). -/
def leb : LPF2 → LPF2 → Bool
  | X0, X0 | X0, X1 | X0, XB | X0, XI | X0, XI2 | X0, XM | X0, Y | X1, X1 | X1, XI2 | X13, X13 | X13, XB | X13, XI3 | X13, XM | XB, XB | XI, XB | XI, XI | XI, Y | XI2, XI2 | XI3, XB | XI3, XI3 | XI3, XM | XM, X1 | XM, XB | XM, XI2 | XM, XM | Y, Y => true
  | _, _ => false

/-- The arrows. -/
def arb : LPF2 → LPF2 → Bool
  | X0, XI | X0, XM | X1, XI2 | X13, XI3 | XI, XB | XI, Y | XI3, XM | XM, X1 | XM, XB => true
  | _, _ => false

/-- The thin category. -/
abbrev thin : ThinData LPF2 where
  le x y := leb x y = true
  nz x _ z := leb x z = true
  refl x := by cases x <;> rfl
  antisymm := by decide
  nz_le _ _ _ _ _ h := h
  nz_left _ _ h := h
  nz_right _ _ h := h
  assoc := by decide

/-- The generating arrows. -/
abbrev arrows : ThinArrows thin where
  ar x y := arb x y = true
  ar_le := by decide
  ar_ne := by decide
  first := by decide
  last := by decide

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {OX0 OXI OY OXM OXB OX1 OXI2 OXI3 OX13 : P}
  (l : OX0 ⟶ OXI) (s : OXI ⟶ OXB) (ρ : OX0 ⟶ OXM) (ρ' : OXM ⟶ OXB) (ε : OXI ⟶ OY) (a : OXM ⟶ OX1) (c : OX1 ⟶ OXI2) (s' : OXI3 ⟶ OXM) (c' : OX13 ⟶ OXI3)

/-- The objects. -/
abbrev obj : LPF2 → P
  | X0 => OX0 | XI => OXI | Y => OY | XM => OXM | XB => OXB | X1 => OX1 | XI2 => OXI2 | XI3 => OXI3 | X13 => OX13

/-- The morphisms. -/
abbrev tab : ∀ u v : LPF2, (obj (OX0 := OX0) (OXI := OXI) (OY := OY) (OXM := OXM) (OXB := OXB) (OX1 := OX1) (OXI2 := OXI2) (OXI3 := OXI3) (OX13 := OX13) u) ⟶ obj (OX0 := OX0) (OXI := OXI) (OY := OY) (OXM := OXM) (OXB := OXB) (OX1 := OX1) (OXI2 := OXI2) (OXI3 := OXI3) (OX13 := OX13) v
  | X0, X0 => 𝟙 _
  | X0, X1 => ρ ≫ a
  | X0, XB => l ≫ s
  | X0, XI => l
  | X0, XI2 => (ρ ≫ a) ≫ c
  | X0, XM => ρ
  | X0, Y => l ≫ ε
  | X1, X1 => 𝟙 _
  | X1, XI2 => c
  | X13, X13 => 𝟙 _
  | X13, XB => (c' ≫ s') ≫ ρ'
  | X13, XI3 => c'
  | X13, XM => c' ≫ s'
  | XB, XB => 𝟙 _
  | XI, XB => s
  | XI, XI => 𝟙 _
  | XI, Y => ε
  | XI2, XI2 => 𝟙 _
  | XI3, XB => s' ≫ ρ'
  | XI3, XI3 => 𝟙 _
  | XI3, XM => s'
  | XM, X1 => a
  | XM, XB => ρ'
  | XM, XI2 => a ≫ c
  | XM, XM => 𝟙 _
  | Y, Y => 𝟙 _
  | _, _ => 0

end Diagram

end LPF2

