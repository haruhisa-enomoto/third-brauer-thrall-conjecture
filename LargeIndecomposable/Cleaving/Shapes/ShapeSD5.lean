module

public import LargeIndecomposable.Cleaving.Shapes.ShapeD6
public import LargeIndecomposable.Cleaving.Diagrams.Tools

/-!
# The tree diagram `SD5`

Separated-quiver `D̃₅`: a loop `ρ` at `x` (`x⁺ → x⁻`) with two further arrows `a, b` out of `x` and two further arrows `α, β` into `x`.

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `SD5`. -/
inductive SD5
  | xp | xm | u | v | z | t
  deriving DecidableEq

namespace SD5

instance : Fintype SD5 := ⟨{xp, xm, u, v, z, t}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : SD5 → SD5 → Bool
  | xp, xm | xp, u | xp, v | z, xm | t, xm => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : SD5) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph SD5 := SimpleGraph.fromRel o

lemma adj_iff (u v : SD5) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : SD5) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : SD5) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : SD5) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : SD5 → Option SD5
  | xp => none
  | xm => some xp
  | u => some xp
  | v => some xp
  | z => some xm
  | t => some xm

/-- The height. -/
def ht : SD5 → ℕ
  | xp => 0
  | xm => 1
  | u => 1
  | v => 1
  | z => 2
  | t => 2

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `D̃`. -/
def cmap : AffineD 1 → SD5
  | .spine j => if (j : ℕ) = 0 then xp else xm
  | .leaf i => if (i : ℕ) = 0 then u else if (i : ℕ) = 1 then v else if (i : ℕ) = 2 then z else t

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `D̃`. -/
def copy : (underlyingGraph (AffineD 1)).Copy G :=
  copyD G 1 cmap (by
    intro u v h
    rcases u with i | j <;> rcases v with i' | j'
    · fin_cases i <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases i <;> fin_cases j' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases j' <;> simp_all [cmap])
    (fun i ↦ by
      fin_cases i
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide)
    (fun j j' h ↦ by fin_cases j <;> fin_cases j' <;> simp_all [cmap] <;> decide)

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {Xp Xm U V Z T : P}
  (ρ : Xp ⟶ Xm) (a : Xp ⟶ U) (b : Xp ⟶ V) (α : Z ⟶ Xm) (β : T ⟶ Xm)

/-- The objects. -/
def obj : SD5 → P
  | xp => Xp | xm => Xm | u => U | v => V | z => Z | t => T

/-- The arrows. -/
def arr : ∀ u v : SD5, o u v → ((obj (Xp := Xp) (Xm := Xm) (U := U) (V := V) (Z := Z) (T := T) u) ⟶ obj (Xp := Xp) (Xm := Xm) (U := U) (V := V) (Z := Z) (T := T) v)
  | xp, xm, _ => ρ
  | xp, u, _ => a
  | xp, v, _ => b
  | z, xm, _ => α
  | t, xm, _ => β
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : SD5, Option ((obj (Xp := Xp) (Xm := Xm) (U := U) (V := V) (Z := Z) (T := T) u) ⟶ obj (Xp := Xp) (Xm := Xm) (U := U) (V := V) (Z := Z) (T := T) v)
  | xp, xp => some (𝟙 _)
  | xp, xm => some (ρ)
  | xp, u => some (a)
  | xp, v => some (b)
  | xm, xm => some (𝟙 _)
  | u, u => some (𝟙 _)
  | v, v => some (𝟙 _)
  | z, z => some (𝟙 _)
  | z, xm => some (α)
  | t, t => some (𝟙 _)
  | t, xm => some (β)
  | _, _ => none

end Diagram

end SD5

end RayCat

namespace RayCat

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type u} [Field k] [Infinite k]

set_option maxHeartbeats 8000000 in
open SD5 in
/-- **No cleaving diagram `SD5` in `P/τ`.** -/
theorem MildHyp.not_sd5 (hM : MildHyp k P)
    {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {Xp Xm U V Z T : P}
    (ρ : Xp ⟶ Xm) (a : Xp ⟶ U) (b : Xp ⟶ V) (α : Z ⟶ Xm) (β : T ⟶ Xm)
    (h0_xp_xm : ¬FactorsThroughMorphism τ (ρ))
    (h0_xp_u : ¬FactorsThroughMorphism τ (a))
    (h0_xp_v : ¬FactorsThroughMorphism τ (b))
    (h0_z_xm : ¬FactorsThroughMorphism τ (α))
    (h0_t_xm : ¬FactorsThroughMorphism τ (β))
    (hi_ρ : ¬IsIso ρ)
    (hi_a : ¬IsIso a)
    (hi_b : ¬IsIso b)
    (hi_α : ¬IsIso α)
    (hi_β : ¬IsIso β)
    (hl_ρ_a_u : ¬∃ g, ρ ≫ g = a)
    (hl_ρ_b_v : ¬∃ g, ρ ≫ g = b)
    (hl_a_ρ_xm : ¬∃ g, a ≫ g = ρ)
    (hl_a_b_v : ¬∃ g, a ≫ g = b)
    (hl_b_ρ_xm : ¬∃ g, b ≫ g = ρ)
    (hl_b_a_u : ¬∃ g, b ≫ g = a)
    (hr_ρ_α_z : ¬∃ g, g ≫ ρ = α)
    (hr_ρ_β_t : ¬∃ g, g ≫ ρ = β)
    (hr_α_ρ_xp : ¬∃ g, g ≫ α = ρ)
    (hr_α_β_t : ¬∃ g, g ≫ α = β)
    (hr_β_ρ_xp : ¬∃ g, g ≫ β = ρ)
    (hr_β_α_z : ¬∃ g, g ≫ β = α)
    : False := by
  haveI : Fact (LargeIndecomposable.Foundations.Quiver.IsAcyclic (OT G o)) := ⟨OT.isAcyclic ho hasym isAcyclic⟩
  refine hM.not_tree_table τ hτ hτ0 G o ho hasym isAcyclic
    (OT.not_isRepresentationFinite_affineD ho hcov k 1 copy) obj (arr ρ a b α β)
    (tab ρ a b α β) (fun v ↦ by cases v <;> rfl) ?_ ?_ ?_ ?_ ?_
  · intro x y z h f hf
    cases y <;> cases z <;> (try exact absurd h (by decide)) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; rfl)
      | rfl
  · intro x y f hf hne
    cases x <;> cases y <;> (try exact absurd rfl hne) <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;> assumption
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | assumption
  · intro x c c' y h h' f hne hf
    cases x <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases y <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.comp_id]; assumption)
      | assumption
  · intro x c c' y h h' f hne hf
    cases y <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; assumption)
      | assumption

end RayCat

end LargeIndecomposable
