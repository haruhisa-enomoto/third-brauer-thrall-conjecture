module

public import LargeIndecomposable.Cleaving.Shapes.ShapeD6

/-!
# The tree diagram `S4s`

The `D̃₄` star `x' → m ← x`, `y₀ ← m → c`.

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `S4s`. -/
inductive S4s
  | m | x' | x | y₀ | c
  deriving DecidableEq

namespace S4s

instance : Fintype S4s := ⟨{m, x', x, y₀, c}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : S4s → S4s → Bool
  | x', m | x, m | m, y₀ | m, c => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : S4s) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph S4s := SimpleGraph.fromRel o

lemma adj_iff (u v : S4s) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : S4s) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : S4s) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : S4s) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : S4s → Option S4s
  | m => none
  | x' => some m
  | x => some m
  | y₀ => some m
  | c => some m

/-- The height. -/
def ht : S4s → ℕ
  | m => 0
  | x' => 1
  | x => 1
  | y₀ => 1
  | c => 1

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `D̃`. -/
def cmap : AffineD 0 → S4s
  | .spine j => m
  | .leaf i => if (i : ℕ) = 0 then x' else if (i : ℕ) = 1 then x else if (i : ℕ) = 2 then y₀ else c

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `D̃`. -/
def copy : (underlyingGraph (AffineD 0)).Copy G :=
  copyD G 0 cmap (by
    intro u v h
    rcases u with i | j <;> rcases v with i' | j'
    · fin_cases i <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases i <;> fin_cases j' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases j' <;> simp_all [cmap])
    (fun i ↦ by
      fin_cases i
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide)
    (fun j j' h ↦ by fin_cases j <;> fin_cases j' <;> simp_all [cmap] <;> decide)

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {M X' X Y₀ Cc : P}
  (r : X' ⟶ M) (ψ : X ⟶ M) (U : M ⟶ Y₀) (d : M ⟶ Cc)

/-- The objects. -/
def obj : S4s → P
  | m => M | x' => X' | x => X | y₀ => Y₀ | c => Cc

/-- The arrows. -/
def arr : ∀ u v : S4s, o u v → ((obj (M := M) (X' := X') (X := X) (Y₀ := Y₀) (Cc := Cc) u) ⟶ obj (M := M) (X' := X') (X := X) (Y₀ := Y₀) (Cc := Cc) v)
  | x', m, _ => r
  | x, m, _ => ψ
  | m, y₀, _ => U
  | m, c, _ => d
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : S4s, Option ((obj (M := M) (X' := X') (X := X) (Y₀ := Y₀) (Cc := Cc) u) ⟶ obj (M := M) (X' := X') (X := X) (Y₀ := Y₀) (Cc := Cc) v)
  | m, m => some (𝟙 _)
  | m, y₀ => some (U)
  | m, c => some (d)
  | x', x' => some (𝟙 _)
  | x', m => some (r)
  | x', y₀ => some (r ≫ U)
  | x', c => some (r ≫ d)
  | x, x => some (𝟙 _)
  | x, m => some (ψ)
  | x, y₀ => some (ψ ≫ U)
  | x, c => some (ψ ≫ d)
  | y₀, y₀ => some (𝟙 _)
  | c, c => some (𝟙 _)
  | _, _ => none

end Diagram

end S4s

end RayCat

namespace RayQuiver

namespace MulBasis

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type u} [Field k] [Infinite k]
  {A : Type u} [Ring A] [Algebra k A] (B : MulBasis k P A)

set_option maxHeartbeats 8000000 in
open S4s in
include B in
/-- **No cleaving diagram `S4s` in `P/τ`.** -/
theorem not_s4s
    (hmin : ∀ I : TwoSidedIdeal A, I ≠ ⊥ → Statement.IsRepresentationFinite (A ⧸ I.asIdeal))
    (hL : LeftCancel P) (hR : RightCancel P) {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {M X' X Y₀ Cc : P}
    (r : X' ⟶ M) (ψ : X ⟶ M) (U : M ⟶ Y₀) (d : M ⟶ Cc)
    (h0_m_y₀ : ¬FactorsThroughMorphism τ (U))
    (h0_m_c : ¬FactorsThroughMorphism τ (d))
    (h0_x'_m : ¬FactorsThroughMorphism τ (r))
    (h0_x'_y₀ : ¬FactorsThroughMorphism τ (r ≫ U))
    (h0_x'_c : ¬FactorsThroughMorphism τ (r ≫ d))
    (h0_x_m : ¬FactorsThroughMorphism τ (ψ))
    (h0_x_y₀ : ¬FactorsThroughMorphism τ (ψ ≫ U))
    (h0_x_c : ¬FactorsThroughMorphism τ (ψ ≫ d))
    (hi_r : ¬IsIso r)
    (hi_ψ : ¬IsIso ψ)
    (hi_U : ¬IsIso U)
    (hi_d : ¬IsIso d)
    (hl_U_d_c : ¬∃ g, U ≫ g = d)
    (hl_d_U_y₀ : ¬∃ g, d ≫ g = U)
    (hr_r_ψ_x : ¬∃ g, g ≫ r = ψ)
    (hr_ψ_r_x' : ¬∃ g, g ≫ ψ = r)
    : False := by
  haveI : Fact (LargeIndecomposable.Foundations.Quiver.IsAcyclic (OT G o)) := ⟨OT.isAcyclic ho hasym isAcyclic⟩
  refine B.not_tree_table hmin hL hR τ hτ hτ0 G o ho hasym isAcyclic
    (OT.not_isRepresentationFinite_affineD ho hcov k 0 copy) obj (arr r ψ U d)
    (tab r ψ U d) (fun v ↦ by cases v <;> rfl) ?_ ?_ ?_ ?_ ?_
  · intro x y z h f hf
    cases y <;> cases z <;> (try exact absurd h (by decide)) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; rfl)
      | rfl
  · intro x y f hf hne
    cases x <;> cases y <;> (try exact absurd rfl hne) <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;> assumption
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | assumption
  · intro x c c' y h h' f hne hf
    cases x <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases y <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.comp_id]; assumption)
      | assumption
  · intro x c c' y h h' f hne hf
    cases y <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; assumption)
      | assumption

end MulBasis

end RayQuiver

end LargeIndecomposable
