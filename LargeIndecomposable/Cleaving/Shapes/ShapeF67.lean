/-!
# The thin diagram `F67`

BO13a figure 6.7 (category 11): the square `w₁ ≫ w₂ = ψ ≫ u₂` with `ρₙ' : x' → b`, `w₁' : x → b'` and `b : m → c`.

Generated by `scripts/gen_thin_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `F67`. -/
inductive F67
  | x | b | m | y₀ | x' | b' | c
  deriving DecidableEq

namespace F67

instance : Fintype F67 := ⟨{x, b, m, y₀, x', b', c}, by intro v; cases v <;> simp⟩

/-- The order (nonzero morphisms). -/
def leb : F67 → F67 → Bool
  | b, b | b, y₀ | b', b' | c, c | m, c | m, m | m, y₀ | x, b | x, b' | x, c | x, m | x, x | x, y₀ | x', b | x', x' | x', y₀ | y₀, y₀ => true
  | _, _ => false

/-- The arrows. -/
def arb : F67 → F67 → Bool
  | b, y₀ | m, c | m, y₀ | x, b | x, b' | x, m | x', b => true
  | _, _ => false

/-- The thin category. -/
abbrev thin : ThinData F67 where
  le x y := leb x y = true
  nz x _ z := leb x z = true
  refl x := by cases x <;> rfl
  antisymm := by decide
  nz_le _ _ _ _ _ h := h
  nz_left _ _ h := h
  nz_right _ _ h := h
  assoc := by decide

/-- The generating arrows. -/
abbrev arrows : ThinArrows thin where
  ar x y := arb x y = true
  ar_le := by decide
  ar_ne := by decide
  first := by decide
  last := by decide

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {X Bb M Y₀ X' B' Cc : P}
  (w₁ : X ⟶ Bb) (ψ : X ⟶ M) (w₂ : Bb ⟶ Y₀) (U : M ⟶ Y₀) (r : X' ⟶ Bb) (v : X ⟶ B') (d : M ⟶ Cc)

/-- The objects. -/
abbrev obj : F67 → P
  | x => X | b => Bb | m => M | y₀ => Y₀ | x' => X' | b' => B' | c => Cc

/-- The morphisms. -/
abbrev tab : ∀ u v : F67, (obj (X := X) (Bb := Bb) (M := M) (Y₀ := Y₀) (X' := X') (B' := B') (Cc := Cc) u) ⟶ obj (X := X) (Bb := Bb) (M := M) (Y₀ := Y₀) (X' := X') (B' := B') (Cc := Cc) v
  | b, b => 𝟙 _
  | b, y₀ => w₂
  | b', b' => 𝟙 _
  | c, c => 𝟙 _
  | m, c => d
  | m, m => 𝟙 _
  | m, y₀ => U
  | x, b => w₁
  | x, b' => v
  | x, c => ψ ≫ d
  | x, m => ψ
  | x, x => 𝟙 _
  | x, y₀ => w₁ ≫ w₂
  | x', b => r
  | x', x' => 𝟙 _
  | x', y₀ => r ≫ w₂
  | y₀, y₀ => 𝟙 _
  | _, _ => 0

end Diagram

end F67

end RayCat

namespace RayQuiver

namespace MulBasis

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type u} [Field k] [Infinite k]
  {A : Type u} [Ring A] [Algebra k A] (B : MulBasis k P A)

set_option maxHeartbeats 16000000 in
open F67 in
include B in
/-- **No cleaving diagram `F67` in `P/τ`.** -/
theorem not_f67
    (hmin : ∀ I : TwoSidedIdeal A, I ≠ ⊥ → Statement.IsRepresentationFinite (A ⧸ I.asIdeal))
    (hL : LeftCancel P) (hR : RightCancel P) {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {X Bb M Y₀ X' B' Cc : P}
    (w₁ : X ⟶ Bb) (ψ : X ⟶ M) (w₂ : Bb ⟶ Y₀) (U : M ⟶ Y₀) (r : X' ⟶ Bb) (v : X ⟶ B') (d : M ⟶ Cc)
    (hD : ¬Statement.IsRepresentationFinite (Linearization (ThinCat thin) k))
    (hc0 : ψ ≫ U = w₁ ≫ w₂)
    (h0_b_y₀ : ¬FactorsThroughMorphism τ (w₂))
    (h0_m_c : ¬FactorsThroughMorphism τ (d))
    (h0_m_y₀ : ¬FactorsThroughMorphism τ (U))
    (h0_x_b : ¬FactorsThroughMorphism τ (w₁))
    (h0_x_b' : ¬FactorsThroughMorphism τ (v))
    (h0_x_c : ¬FactorsThroughMorphism τ (ψ ≫ d))
    (h0_x_m : ¬FactorsThroughMorphism τ (ψ))
    (h0_x_y₀ : ¬FactorsThroughMorphism τ (w₁ ≫ w₂))
    (h0_x'_b : ¬FactorsThroughMorphism τ (r))
    (h0_x'_y₀ : ¬FactorsThroughMorphism τ (r ≫ w₂))
    (hi_w₁ : ¬IsIso w₁)
    (hi_ψ : ¬IsIso ψ)
    (hi_w₂ : ¬IsIso w₂)
    (hi_U : ¬IsIso U)
    (hi_r : ¬IsIso r)
    (hi_v : ¬IsIso v)
    (hi_d : ¬IsIso d)
    (hlft_m_c_y₀ : ¬∃ g, d ≫ g = U)
    (hlft_m_y₀_c : ¬∃ g, U ≫ g = d)
    (hlft_x_b_m : ¬∃ g, w₁ ≫ g = ψ)
    (hlft_x_b_b' : ¬∃ g, w₁ ≫ g = v)
    (hlft_x_b_c : ¬∃ g, w₁ ≫ g = ψ ≫ d)
    (hlft_x_b'_b : ¬∃ g, v ≫ g = w₁)
    (hlft_x_b'_m : ¬∃ g, v ≫ g = ψ)
    (hlft_x_b'_y₀ : ¬∃ g, v ≫ g = w₁ ≫ w₂)
    (hlft_x_b'_c : ¬∃ g, v ≫ g = ψ ≫ d)
    (hlft_x_m_b : ¬∃ g, ψ ≫ g = w₁)
    (hlft_x_m_b' : ¬∃ g, ψ ≫ g = v)
    (hrgt_m_b_y₀ : ¬∃ g, g ≫ w₂ = U)
    (hrgt_b_m_y₀ : ¬∃ g, g ≫ U = w₂)
    (hrgt_x'_m_y₀ : ¬∃ g, g ≫ U = r ≫ w₂)
    (hrgt_x'_x_b : ¬∃ g, g ≫ w₁ = r)
    (hrgt_x_x'_b : ¬∃ g, g ≫ r = w₁)
    : False := by
  have hlft_b_y₀_b : ¬∃ g, w₂ ≫ g = 𝟙 _ := not_split_mono hi_w₂
  have hlft_m_c_m : ¬∃ g, d ≫ g = 𝟙 _ := not_split_mono hi_d
  have hlft_m_y₀_m : ¬∃ g, U ≫ g = 𝟙 _ := not_split_mono hi_U
  have hlft_x_b_x : ¬∃ g, w₁ ≫ g = 𝟙 _ := not_split_mono hi_w₁
  have hlft_x_b'_x : ¬∃ g, v ≫ g = 𝟙 _ := not_split_mono hi_v
  have hlft_x_m_x : ¬∃ g, ψ ≫ g = 𝟙 _ := not_split_mono hi_ψ
  have hlft_x'_b_x' : ¬∃ g, r ≫ g = 𝟙 _ := not_split_mono hi_r
  have hrgt_y₀_b_y₀ : ¬∃ g, g ≫ w₂ = 𝟙 _ := not_split_epi hi_w₂
  have hrgt_c_m_c : ¬∃ g, g ≫ d = 𝟙 _ := not_split_epi hi_d
  have hrgt_y₀_m_y₀ : ¬∃ g, g ≫ U = 𝟙 _ := not_split_epi hi_U
  have hrgt_b_x_b : ¬∃ g, g ≫ w₁ = 𝟙 _ := not_split_epi hi_w₁
  have hrgt_b'_x_b' : ¬∃ g, g ≫ v = 𝟙 _ := not_split_epi hi_v
  have hrgt_m_x_m : ¬∃ g, g ≫ ψ = 𝟙 _ := not_split_epi hi_ψ
  have hrgt_b_x'_b : ¬∃ g, g ≫ r = 𝟙 _ := not_split_epi hi_r
  have hc0' := reassoc_of% hc0
  refine B.not_thin_diagram hmin hL hR τ hτ hτ0 hD arrows obj (fun x y _ ↦ tab w₁ ψ w₂ U r v d x y)
    (fun x ↦ by cases x <;> rfl) ?_ ?_ ?_ ?_
  · intro x y z h h'
    cases x <;> cases y <;> (try exact absurd h (by decide)) <;> cases z <;>
      (try exact absurd h' (by decide)) <;> split_ifs with hn <;>
      (try exact absurd hn (by decide)) <;>
      simp only [tab, Category.assoc, Category.id_comp, Category.comp_id, zero_comp, comp_zero, hc0', hc0]
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | exact not_factorsThrough_id hτ _
      | assumption
  · intro x z y ha hy
    cases x <;> cases z <;> (try exact absurd ha (by decide)) <;> cases y <;>
      (try exact absurd hy (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›
  · intro x z y ha hx
    cases z <;> cases y <;> (try exact absurd ha (by decide)) <;> cases x <;>
      (try exact absurd hx (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›

end MulBasis

