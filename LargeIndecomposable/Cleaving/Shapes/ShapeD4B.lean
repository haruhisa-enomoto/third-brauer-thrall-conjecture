/-!
# The tree diagram `MD4B`

[mild] Lemma 2.2: the `D̃₄` star with `α, β` into `y` and `a, b` out of `y`.

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `MD4B`. -/
inductive MD4B
  | y | z | t | u | v
  deriving DecidableEq

namespace MD4B

instance : Fintype MD4B := ⟨{y, z, t, u, v}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : MD4B → MD4B → Bool
  | z, y | t, y | y, u | y, v => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : MD4B) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph MD4B := SimpleGraph.fromRel o

lemma adj_iff (u v : MD4B) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : MD4B) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : MD4B) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : MD4B) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : MD4B → Option MD4B
  | y => none
  | z => some y
  | t => some y
  | u => some y
  | v => some y

/-- The height. -/
def ht : MD4B → ℕ
  | y => 0
  | z => 1
  | t => 1
  | u => 1
  | v => 1

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `D̃`. -/
def cmap : AffineD 0 → MD4B
  | .spine j => y
  | .leaf i => if (i : ℕ) = 0 then z else if (i : ℕ) = 1 then t else if (i : ℕ) = 2 then u else v

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `D̃`. -/
def copy : (underlyingGraph (AffineD 0)).Copy G :=
  copyD G 0 cmap (by
    intro u v h
    rcases u with i | j <;> rcases v with i' | j'
    · fin_cases i <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases i <;> fin_cases j' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases j' <;> simp_all [cmap])
    (fun i ↦ by
      fin_cases i
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide)
    (fun j j' h ↦ by fin_cases j <;> fin_cases j' <;> simp_all [cmap] <;> decide)

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {Y Z T U V : P}
  (α : Z ⟶ Y) (β : T ⟶ Y) (a : Y ⟶ U) (b : Y ⟶ V)

/-- The objects. -/
def obj : MD4B → P
  | y => Y | z => Z | t => T | u => U | v => V

/-- The arrows. -/
def arr : ∀ u v : MD4B, o u v → ((obj (Y := Y) (Z := Z) (T := T) (U := U) (V := V) u) ⟶ obj (Y := Y) (Z := Z) (T := T) (U := U) (V := V) v)
  | z, y, _ => α
  | t, y, _ => β
  | y, u, _ => a
  | y, v, _ => b
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : MD4B, Option ((obj (Y := Y) (Z := Z) (T := T) (U := U) (V := V) u) ⟶ obj (Y := Y) (Z := Z) (T := T) (U := U) (V := V) v)
  | y, y => some (𝟙 _)
  | y, u => some (a)
  | y, v => some (b)
  | z, z => some (𝟙 _)
  | z, y => some (α)
  | z, u => some (α ≫ a)
  | z, v => some (α ≫ b)
  | t, t => some (𝟙 _)
  | t, y => some (β)
  | t, u => some (β ≫ a)
  | t, v => some (β ≫ b)
  | u, u => some (𝟙 _)
  | v, v => some (𝟙 _)
  | _, _ => none

end Diagram

end MD4B

end RayCat

namespace RayCat

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type u} [Field k] [Infinite k]

set_option maxHeartbeats 8000000 in
open MD4B in
/-- **No cleaving diagram `MD4B` in `P/τ`.** -/
theorem MildHyp.not_md4b (hM : MildHyp k P)
    {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {Y Z T U V : P}
    (α : Z ⟶ Y) (β : T ⟶ Y) (a : Y ⟶ U) (b : Y ⟶ V)
    (h0_y_u : ¬FactorsThroughMorphism τ (a))
    (h0_y_v : ¬FactorsThroughMorphism τ (b))
    (h0_z_y : ¬FactorsThroughMorphism τ (α))
    (h0_z_u : ¬FactorsThroughMorphism τ (α ≫ a))
    (h0_z_v : ¬FactorsThroughMorphism τ (α ≫ b))
    (h0_t_y : ¬FactorsThroughMorphism τ (β))
    (h0_t_u : ¬FactorsThroughMorphism τ (β ≫ a))
    (h0_t_v : ¬FactorsThroughMorphism τ (β ≫ b))
    (hi_α : ¬IsIso α)
    (hi_β : ¬IsIso β)
    (hi_a : ¬IsIso a)
    (hi_b : ¬IsIso b)
    (hl_a_b_v : ¬∃ g, a ≫ g = b)
    (hl_b_a_u : ¬∃ g, b ≫ g = a)
    (hr_α_β_t : ¬∃ g, g ≫ α = β)
    (hr_β_α_z : ¬∃ g, g ≫ β = α)
    : False := by
  haveI : Fact (LargeIndecomposable.Foundations.Quiver.IsAcyclic (OT G o)) := ⟨OT.isAcyclic ho hasym isAcyclic⟩
  refine hM.not_tree_table τ hτ hτ0 G o ho hasym isAcyclic
    (OT.not_isRepresentationFinite_affineD ho hcov k 0 copy) obj (arr α β a b)
    (tab α β a b) (fun v ↦ by cases v <;> rfl) ?_ ?_ ?_ ?_ ?_
  · intro x y z h f hf
    cases y <;> cases z <;> (try exact absurd h (by decide)) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; rfl)
      | rfl
  · intro x y f hf hne
    cases x <;> cases y <;> (try exact absurd rfl hne) <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;> assumption
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | assumption
  · intro x c c' y h h' f hne hf
    cases x <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases y <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.comp_id]; assumption)
      | assumption
  · intro x c c' y h h' f hne hf
    cases y <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; assumption)
      | assumption

end RayCat

