/-- **No cleaving diagram `F83` in `P/τ`.** -/
theorem not_f83
    (hmin : ∀ I : TwoSidedIdeal A, I ≠ ⊥ → Statement.IsRepresentationFinite (A ⧸ I.asIdeal))
    (hL : LeftCancel P) (hR : RightCancel P) {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {Xn Tφ Bb Y₀ Aa Y₁ X₂ Z₂ X₃ : P}
    (φ : Xn ⟶ Tφ) (r : Xn ⟶ Bb) (W₂ : Bb ⟶ Y₀) (V₂ : Aa ⟶ Y₀) (ρ₁' : Aa ⟶ Y₁) (σ₂' : X₂ ⟶ Aa) (ρ₂' : Aa ⟶ Z₂) (σ₃ : X₃ ⟶ Z₂)
    (hD : ¬Statement.IsRepresentationFinite (Linearization (ThinCat thin) k))
    (hz0 : σ₂' ≫ V₂ = 0)
    (h0_B_y₀ : ¬FactorsThroughMorphism τ (W₂))
    (h0_a_y₀ : ¬FactorsThroughMorphism τ (V₂))
    (h0_a_y₁ : ¬FactorsThroughMorphism τ (ρ₁'))
    (h0_a_z₂ : ¬FactorsThroughMorphism τ (ρ₂'))
    (h0_xn_B : ¬FactorsThroughMorphism τ (r))
    (h0_xn_tφ : ¬FactorsThroughMorphism τ (φ))
    (h0_xn_y₀ : ¬FactorsThroughMorphism τ (r ≫ W₂))
    (h0_x₂_a : ¬FactorsThroughMorphism τ (σ₂'))
    (h0_x₂_y₁ : ¬FactorsThroughMorphism τ (σ₂' ≫ ρ₁'))
    (h0_x₂_z₂ : ¬FactorsThroughMorphism τ (σ₂' ≫ ρ₂'))
    (h0_x₃_z₂ : ¬FactorsThroughMorphism τ (σ₃))
    (hi_φ : ¬IsIso φ)
    (hi_r : ¬IsIso r)
    (hi_W₂ : ¬IsIso W₂)
    (hi_V₂ : ¬IsIso V₂)
    (hi_ρ₁' : ¬IsIso ρ₁')
    (hi_σ₂' : ¬IsIso σ₂')
    (hi_ρ₂' : ¬IsIso ρ₂')
    (hi_σ₃ : ¬IsIso σ₃)
    (hlft_a_y₀_y₁ : ¬∃ g, V₂ ≫ g = ρ₁')
    (hlft_a_y₀_z₂ : ¬∃ g, V₂ ≫ g = ρ₂')
    (hlft_a_y₁_y₀ : ¬∃ g, ρ₁' ≫ g = V₂)
    (hlft_a_y₁_z₂ : ¬∃ g, ρ₁' ≫ g = ρ₂')
    (hlft_a_z₂_y₀ : ¬∃ g, ρ₂' ≫ g = V₂)
    (hlft_a_z₂_y₁ : ¬∃ g, ρ₂' ≫ g = ρ₁')
    (hlft_xn_B_tφ : ¬∃ g, r ≫ g = φ)
    (hlft_xn_tφ_B : ¬∃ g, φ ≫ g = r)
    (hlft_xn_tφ_y₀ : ¬∃ g, φ ≫ g = r ≫ W₂)
    (hrgt_a_B_y₀ : ¬∃ g, g ≫ W₂ = V₂)
    (hrgt_xn_a_y₀ : ¬∃ g, g ≫ V₂ = r ≫ W₂)
    (hrgt_B_a_y₀ : ¬∃ g, g ≫ V₂ = W₂)
    (hrgt_x₃_a_z₂ : ¬∃ g, g ≫ ρ₂' = σ₃)
    (hrgt_a_x₃_z₂ : ¬∃ g, g ≫ σ₃ = ρ₂')
    (hrgt_x₂_x₃_z₂ : ¬∃ g, g ≫ σ₃ = σ₂' ≫ ρ₂')
    : False := by
  have hlft_B_y₀_B : ¬∃ g, W₂ ≫ g = 𝟙 _ := not_split_mono hi_W₂
  have hlft_a_y₀_a : ¬∃ g, V₂ ≫ g = 𝟙 _ := not_split_mono hi_V₂
  have hlft_a_y₁_a : ¬∃ g, ρ₁' ≫ g = 𝟙 _ := not_split_mono hi_ρ₁'
  have hlft_a_z₂_a : ¬∃ g, ρ₂' ≫ g = 𝟙 _ := not_split_mono hi_ρ₂'
  have hlft_xn_B_xn : ¬∃ g, r ≫ g = 𝟙 _ := not_split_mono hi_r
  have hlft_xn_tφ_xn : ¬∃ g, φ ≫ g = 𝟙 _ := not_split_mono hi_φ
  have hlft_x₂_a_x₂ : ¬∃ g, σ₂' ≫ g = 𝟙 _ := not_split_mono hi_σ₂'
  have hlft_x₃_z₂_x₃ : ¬∃ g, σ₃ ≫ g = 𝟙 _ := not_split_mono hi_σ₃
  have hrgt_y₀_B_y₀ : ¬∃ g, g ≫ W₂ = 𝟙 _ := not_split_epi hi_W₂
  have hrgt_y₀_a_y₀ : ¬∃ g, g ≫ V₂ = 𝟙 _ := not_split_epi hi_V₂
  have hrgt_y₁_a_y₁ : ¬∃ g, g ≫ ρ₁' = 𝟙 _ := not_split_epi hi_ρ₁'
  have hrgt_z₂_a_z₂ : ¬∃ g, g ≫ ρ₂' = 𝟙 _ := not_split_epi hi_ρ₂'
  have hrgt_B_xn_B : ¬∃ g, g ≫ r = 𝟙 _ := not_split_epi hi_r
  have hrgt_tφ_xn_tφ : ¬∃ g, g ≫ φ = 𝟙 _ := not_split_epi hi_φ
  have hrgt_a_x₂_a : ¬∃ g, g ≫ σ₂' = 𝟙 _ := not_split_epi hi_σ₂'
  have hrgt_z₂_x₃_z₂ : ¬∃ g, g ≫ σ₃ = 𝟙 _ := not_split_epi hi_σ₃
  have hz0' := reassoc_of% hz0
  refine B.not_thin_diagram hmin hL hR τ hτ hτ0 hD arrows obj (fun x y _ ↦ tab φ r W₂ V₂ ρ₁' σ₂' ρ₂' σ₃ x y)
    (fun x ↦ by cases x <;> rfl) ?_ ?_ ?_ ?_
  · intro x y z h h'
    cases x <;> cases y <;> (try exact absurd h (by decide)) <;> cases z <;>
      (try exact absurd h' (by decide)) <;> split_ifs with hn <;>
      (try exact absurd hn (by decide)) <;>
      simp only [tab, Category.assoc, Category.id_comp, Category.comp_id, zero_comp, comp_zero, hz0', hz0]
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | exact not_factorsThrough_id hτ _
      | assumption
  · intro x z y ha hy
    cases x <;> cases z <;> (try exact absurd ha (by decide)) <;> cases y <;>
      (try exact absurd hy (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›
  · intro x z y ha hx
    cases z <;> cases y <;> (try exact absurd ha (by decide)) <;> cases x <;>
