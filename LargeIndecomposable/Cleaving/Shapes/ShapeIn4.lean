module

public import LargeIndecomposable.Cleaving.Shapes.ShapeD6
public import LargeIndecomposable.Cleaving.Basic.Tools

/-!
# The tree diagram `In4`

The `D̃₄` star with four arrows `α, β, γ, δ` into `y` ([mild] Lemma 2.1).

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `In4`. -/
inductive In4
  | y | a | b | c | d
  deriving DecidableEq

namespace In4

instance : Fintype In4 := ⟨{y, a, b, c, d}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : In4 → In4 → Bool
  | a, y | b, y | c, y | d, y => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : In4) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph In4 := SimpleGraph.fromRel o

lemma adj_iff (u v : In4) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : In4) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : In4) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : In4) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : In4 → Option In4
  | y => none
  | a => some y
  | b => some y
  | c => some y
  | d => some y

/-- The height. -/
def ht : In4 → ℕ
  | y => 0
  | a => 1
  | b => 1
  | c => 1
  | d => 1

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `D̃`. -/
def cmap : AffineD 0 → In4
  | .spine j => y
  | .leaf i => if (i : ℕ) = 0 then a else if (i : ℕ) = 1 then b else if (i : ℕ) = 2 then c else d

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `D̃`. -/
def copy : (underlyingGraph (AffineD 0)).Copy G :=
  copyD G 0 cmap (by
    intro u v h
    rcases u with i | j <;> rcases v with i' | j'
    · fin_cases i <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases i <;> fin_cases j' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases j' <;> simp_all [cmap])
    (fun i ↦ by
      fin_cases i
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide)
    (fun j j' h ↦ by fin_cases j <;> fin_cases j' <;> simp_all [cmap] <;> decide)

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {Y Aa Bb Cc Dd : P}
  (α : Aa ⟶ Y) (β : Bb ⟶ Y) (γ : Cc ⟶ Y) (δ : Dd ⟶ Y)

/-- The objects. -/
def obj : In4 → P
  | y => Y | a => Aa | b => Bb | c => Cc | d => Dd

/-- The arrows. -/
def arr : ∀ u v : In4, o u v → ((obj (Y := Y) (Aa := Aa) (Bb := Bb) (Cc := Cc) (Dd := Dd) u) ⟶ obj (Y := Y) (Aa := Aa) (Bb := Bb) (Cc := Cc) (Dd := Dd) v)
  | a, y, _ => α
  | b, y, _ => β
  | c, y, _ => γ
  | d, y, _ => δ
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : In4, Option ((obj (Y := Y) (Aa := Aa) (Bb := Bb) (Cc := Cc) (Dd := Dd) u) ⟶ obj (Y := Y) (Aa := Aa) (Bb := Bb) (Cc := Cc) (Dd := Dd) v)
  | y, y => some (𝟙 _)
  | a, a => some (𝟙 _)
  | a, y => some (α)
  | b, b => some (𝟙 _)
  | b, y => some (β)
  | c, c => some (𝟙 _)
  | c, y => some (γ)
  | d, d => some (𝟙 _)
  | d, y => some (δ)
  | _, _ => none

end Diagram

end In4

end RayCat

namespace RayCat

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type u} [Field k] [Infinite k]

set_option maxHeartbeats 8000000 in
open In4 in
/-- **No cleaving diagram `In4` in `P/τ`.** -/
theorem MildHyp.not_in4 (hM : MildHyp k P)
    {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {Y Aa Bb Cc Dd : P}
    (α : Aa ⟶ Y) (β : Bb ⟶ Y) (γ : Cc ⟶ Y) (δ : Dd ⟶ Y)
    (h0_a_y : ¬FactorsThroughMorphism τ (α))
    (h0_b_y : ¬FactorsThroughMorphism τ (β))
    (h0_c_y : ¬FactorsThroughMorphism τ (γ))
    (h0_d_y : ¬FactorsThroughMorphism τ (δ))
    (hi_α : ¬IsIso α)
    (hi_β : ¬IsIso β)
    (hi_γ : ¬IsIso γ)
    (hi_δ : ¬IsIso δ)
    (hr_α_β_b : ¬∃ g, g ≫ α = β)
    (hr_α_γ_c : ¬∃ g, g ≫ α = γ)
    (hr_α_δ_d : ¬∃ g, g ≫ α = δ)
    (hr_β_α_a : ¬∃ g, g ≫ β = α)
    (hr_β_γ_c : ¬∃ g, g ≫ β = γ)
    (hr_β_δ_d : ¬∃ g, g ≫ β = δ)
    (hr_γ_α_a : ¬∃ g, g ≫ γ = α)
    (hr_γ_β_b : ¬∃ g, g ≫ γ = β)
    (hr_γ_δ_d : ¬∃ g, g ≫ γ = δ)
    (hr_δ_α_a : ¬∃ g, g ≫ δ = α)
    (hr_δ_β_b : ¬∃ g, g ≫ δ = β)
    (hr_δ_γ_c : ¬∃ g, g ≫ δ = γ)
    : False := by
  haveI : Fact (LargeIndecomposable.Foundations.Quiver.IsAcyclic (OT G o)) := ⟨OT.isAcyclic ho hasym isAcyclic⟩
  refine hM.not_tree_table τ hτ hτ0 G o ho hasym isAcyclic
    (OT.not_isRepresentationFinite_affineD ho hcov k 0 copy) obj (arr α β γ δ)
    (tab α β γ δ) (fun v ↦ by cases v <;> rfl) ?_ ?_ ?_ ?_ ?_
  · intro x y z h f hf
    cases y <;> cases z <;> (try exact absurd h (by decide)) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; rfl)
      | rfl
  · intro x y f hf hne
    cases x <;> cases y <;> (try exact absurd rfl hne) <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;> assumption
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | assumption
  · intro x c c' y h h' f hne hf
    cases x <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases y <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.comp_id]; assumption)
      | assumption
  · intro x c c' y h h' f hne hf
    cases y <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; assumption)
      | assumption

end RayCat

end LargeIndecomposable
