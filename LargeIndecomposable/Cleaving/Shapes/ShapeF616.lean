namespace RayCat

/-- Vertices of the diagram `F616`. -/
inductive F616
  | c | x' | zn | m | y₁ | y₀ | b
  deriving DecidableEq

namespace F616

instance : Fintype F616 := ⟨{c, x', zn, m, y₁, y₀, b}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : F616 → F616 → Bool
  | x', c | x', zn | m, c | m, y₁ | c, y₀ | b, y₀ => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : F616) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph F616 := SimpleGraph.fromRel o

lemma adj_iff (u v : F616) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : F616) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : F616) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : F616) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : F616 → Option F616
  | c => none
  | x' => some c
  | zn => some x'
  | m => some c
  | y₁ => some m
  | y₀ => some c
  | b => some y₀

/-- The height. -/
def ht : F616 → ℕ
  | c => 0
  | x' => 1
  | zn => 2
  | m => 1
  | y₁ => 2
  | y₀ => 1
  | b => 2

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `Ẽ₆`. -/
def cmap : AffineE6 → F616
  | .center => c
  | .inner i => if (i : ℕ) = 0 then x' else if (i : ℕ) = 1 then m else y₀
  | .outer i => if (i : ℕ) = 0 then zn else if (i : ℕ) = 1 then y₁ else b

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `Ẽ₆`. -/
def copy : (underlyingGraph AffineE6).Copy G :=
  copyOf G cmap (by
    intro u v h
    rcases u with _ | i | i <;> rcases v with _ | j | j <;>
      (try fin_cases i) <;> (try fin_cases j) <;> simp_all [cmap])
    (by
      intro a b e
      rcases a with _ | i | i <;> rcases b with _ | j | j
      all_goals first
        | exact (IsEmpty.false e).elim
        | exact e.elim
        | (obtain rfl : i = j := e.down; fin_cases i <;> simp only [cmap] <;> decide)
        | (fin_cases i <;> simp only [cmap] <;> decide))

