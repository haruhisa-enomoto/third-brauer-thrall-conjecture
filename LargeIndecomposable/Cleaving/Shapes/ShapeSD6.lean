module

public import LargeIndecomposable.Cleaving.Shapes.ShapeD6
public import LargeIndecomposable.Cleaving.Diagrams.Tools

/-!
# The tree diagram `SD6`

Separated-quiver `D̃₆`: arrows `p → c, p → c', p → q` and `r → q, r → s, r → t`.

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `SD6`. -/
inductive SD6
  | p | q | r | c | c2 | s | t
  deriving DecidableEq

namespace SD6

instance : Fintype SD6 := ⟨{p, q, r, c, c2, s, t}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : SD6 → SD6 → Bool
  | p, c | p, c2 | p, q | r, q | r, s | r, t => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : SD6) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph SD6 := SimpleGraph.fromRel o

lemma adj_iff (u v : SD6) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : SD6) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : SD6) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : SD6) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : SD6 → Option SD6
  | p => none
  | q => some p
  | r => some q
  | c => some p
  | c2 => some p
  | s => some r
  | t => some r

/-- The height. -/
def ht : SD6 → ℕ
  | p => 0
  | q => 1
  | r => 2
  | c => 1
  | c2 => 1
  | s => 3
  | t => 3

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `D̃`. -/
def cmap : AffineD 2 → SD6
  | .spine j => if (j : ℕ) = 0 then p else if (j : ℕ) = 1 then q else r
  | .leaf i => if (i : ℕ) = 0 then c else if (i : ℕ) = 1 then c2 else if (i : ℕ) = 2 then s else t

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `D̃`. -/
def copy : (underlyingGraph (AffineD 2)).Copy G :=
  copyD G 2 cmap (by
    intro u v h
    rcases u with i | j <;> rcases v with i' | j'
    · fin_cases i <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases i <;> fin_cases j' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases j' <;> simp_all [cmap])
    (fun i ↦ by
      fin_cases i
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide)
    (fun j j' h ↦ by fin_cases j <;> fin_cases j' <;> simp_all [cmap] <;> decide)

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {Pp Qq Rr Cc Cc2 Ss Tt : P}
  (γ : Pp ⟶ Cc) (γ' : Pp ⟶ Cc2) (β : Pp ⟶ Qq) (ρ : Rr ⟶ Qq) (a : Rr ⟶ Ss) (ε : Rr ⟶ Tt)

/-- The objects. -/
def obj : SD6 → P
  | p => Pp | q => Qq | r => Rr | c => Cc | c2 => Cc2 | s => Ss | t => Tt

/-- The arrows. -/
def arr : ∀ u v : SD6, o u v → ((obj (Pp := Pp) (Qq := Qq) (Rr := Rr) (Cc := Cc) (Cc2 := Cc2) (Ss := Ss) (Tt := Tt) u) ⟶ obj (Pp := Pp) (Qq := Qq) (Rr := Rr) (Cc := Cc) (Cc2 := Cc2) (Ss := Ss) (Tt := Tt) v)
  | p, c, _ => γ
  | p, c2, _ => γ'
  | p, q, _ => β
  | r, q, _ => ρ
  | r, s, _ => a
  | r, t, _ => ε
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : SD6, Option ((obj (Pp := Pp) (Qq := Qq) (Rr := Rr) (Cc := Cc) (Cc2 := Cc2) (Ss := Ss) (Tt := Tt) u) ⟶ obj (Pp := Pp) (Qq := Qq) (Rr := Rr) (Cc := Cc) (Cc2 := Cc2) (Ss := Ss) (Tt := Tt) v)
  | p, p => some (𝟙 _)
  | p, c => some (γ)
  | p, c2 => some (γ')
  | p, q => some (β)
  | q, q => some (𝟙 _)
  | r, r => some (𝟙 _)
  | r, q => some (ρ)
  | r, s => some (a)
  | r, t => some (ε)
  | c, c => some (𝟙 _)
  | c2, c2 => some (𝟙 _)
  | s, s => some (𝟙 _)
  | t, t => some (𝟙 _)
  | _, _ => none

end Diagram

end SD6

end RayCat

namespace RayCat

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type u} [Field k] [Infinite k]

set_option maxHeartbeats 8000000 in
open SD6 in
/-- **No cleaving diagram `SD6` in `P/τ`.** -/
theorem MildHyp.not_sd6 (hM : MildHyp k P)
    {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {Pp Qq Rr Cc Cc2 Ss Tt : P}
    (γ : Pp ⟶ Cc) (γ' : Pp ⟶ Cc2) (β : Pp ⟶ Qq) (ρ : Rr ⟶ Qq) (a : Rr ⟶ Ss) (ε : Rr ⟶ Tt)
    (h0_p_c : ¬FactorsThroughMorphism τ (γ))
    (h0_p_c2 : ¬FactorsThroughMorphism τ (γ'))
    (h0_p_q : ¬FactorsThroughMorphism τ (β))
    (h0_r_q : ¬FactorsThroughMorphism τ (ρ))
    (h0_r_s : ¬FactorsThroughMorphism τ (a))
    (h0_r_t : ¬FactorsThroughMorphism τ (ε))
    (hi_γ : ¬IsIso γ)
    (hi_γ' : ¬IsIso γ')
    (hi_β : ¬IsIso β)
    (hi_ρ : ¬IsIso ρ)
    (hi_a : ¬IsIso a)
    (hi_ε : ¬IsIso ε)
    (hl_γ_γ'_c2 : ¬∃ g, γ ≫ g = γ')
    (hl_γ_β_q : ¬∃ g, γ ≫ g = β)
    (hl_γ'_γ_c : ¬∃ g, γ' ≫ g = γ)
    (hl_γ'_β_q : ¬∃ g, γ' ≫ g = β)
    (hl_β_γ_c : ¬∃ g, β ≫ g = γ)
    (hl_β_γ'_c2 : ¬∃ g, β ≫ g = γ')
    (hl_ρ_a_s : ¬∃ g, ρ ≫ g = a)
    (hl_ρ_ε_t : ¬∃ g, ρ ≫ g = ε)
    (hl_a_ρ_q : ¬∃ g, a ≫ g = ρ)
    (hl_a_ε_t : ¬∃ g, a ≫ g = ε)
    (hl_ε_ρ_q : ¬∃ g, ε ≫ g = ρ)
    (hl_ε_a_s : ¬∃ g, ε ≫ g = a)
    (hr_β_ρ_r : ¬∃ g, g ≫ β = ρ)
    (hr_ρ_β_p : ¬∃ g, g ≫ ρ = β)
    : False := by
  haveI : Fact (LargeIndecomposable.Foundations.Quiver.IsAcyclic (OT G o)) := ⟨OT.isAcyclic ho hasym isAcyclic⟩
  refine hM.not_tree_table τ hτ hτ0 G o ho hasym isAcyclic
    (OT.not_isRepresentationFinite_affineD ho hcov k 2 copy) obj (arr γ γ' β ρ a ε)
    (tab γ γ' β ρ a ε) (fun v ↦ by cases v <;> rfl) ?_ ?_ ?_ ?_ ?_
  · intro x y z h f hf
    cases y <;> cases z <;> (try exact absurd h (by decide)) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; rfl)
      | rfl
  · intro x y f hf hne
    cases x <;> cases y <;> (try exact absurd rfl hne) <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;> assumption
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | assumption
  · intro x c c' y h h' f hne hf
    cases x <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases y <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.comp_id]; assumption)
      | assumption
  · intro x c c' y h h' f hne hf
    cases y <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; assumption)
      | assumption

end RayCat

end LargeIndecomposable
