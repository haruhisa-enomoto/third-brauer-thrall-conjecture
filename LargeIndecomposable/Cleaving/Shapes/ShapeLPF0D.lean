module

public import LargeIndecomposable.Cleaving.Shapes.ShapeD6
public import LargeIndecomposable.Cleaving.Diagrams.Tools

/-!
# The tree diagram `LPF0D`

LPF, exit `ε` at `x₀` with `ε ≫ ζ = ρ ≫ a₁` (`D̃₅`): `ρ, a₁, ε` out of `x₀`, `ζ : y → x₁`, `a₂ : x₁ → x₂`.

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `LPF0D`. -/
inductive LPF0D
  | Y1 | X3 | X6 | C5 | E7 | Y4
  deriving DecidableEq

namespace LPF0D

instance : Fintype LPF0D := ⟨{Y1, X3, X6, C5, E7, Y4}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : LPF0D → LPF0D → Bool
  | Y1, C5 | X3, X6 | X3, C5 | X3, Y4 | C5, E7 => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : LPF0D) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph LPF0D := SimpleGraph.fromRel o

lemma adj_iff (u v : LPF0D) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : LPF0D) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : LPF0D) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : LPF0D) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : LPF0D → Option LPF0D
  | Y1 => none
  | X3 => some C5
  | X6 => some X3
  | C5 => some Y1
  | E7 => some C5
  | Y4 => some X3

/-- The height. -/
def ht : LPF0D → ℕ
  | Y1 => 0
  | X3 => 2
  | X6 => 3
  | C5 => 1
  | E7 => 2
  | Y4 => 3

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `D̃`. -/
def cmap : AffineD 1 → LPF0D
  | .spine j => if (j : ℕ) = 0 then X3 else C5
  | .leaf i => if (i : ℕ) = 0 then X6 else if (i : ℕ) = 1 then Y4 else if (i : ℕ) = 2 then Y1 else E7

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `D̃`. -/
def copy : (underlyingGraph (AffineD 1)).Copy G :=
  copyD G 1 cmap (by
    intro u v h
    rcases u with i | j <;> rcases v with i' | j'
    · fin_cases i <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases i <;> fin_cases j' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases j' <;> simp_all [cmap])
    (fun i ↦ by
      fin_cases i
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide)
    (fun j j' h ↦ by fin_cases j <;> fin_cases j' <;> simp_all [cmap] <;> decide)

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {OY1 OX3 OX6 OC5 OE7 OY4 : P}
  (ζ : OY1 ⟶ OC5) (ρ : OX3 ⟶ OX6) (a : OX3 ⟶ OC5) (ε : OX3 ⟶ OY4) (b : OC5 ⟶ OE7)

/-- The objects. -/
def obj : LPF0D → P
  | Y1 => OY1 | X3 => OX3 | X6 => OX6 | C5 => OC5 | E7 => OE7 | Y4 => OY4

/-- The arrows. -/
def arr : ∀ u v : LPF0D, o u v → ((obj (OY1 := OY1) (OX3 := OX3) (OX6 := OX6) (OC5 := OC5) (OE7 := OE7) (OY4 := OY4) u) ⟶ obj (OY1 := OY1) (OX3 := OX3) (OX6 := OX6) (OC5 := OC5) (OE7 := OE7) (OY4 := OY4) v)
  | Y1, C5, _ => ζ
  | X3, X6, _ => ρ
  | X3, C5, _ => a
  | X3, Y4, _ => ε
  | C5, E7, _ => b
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : LPF0D, Option ((obj (OY1 := OY1) (OX3 := OX3) (OX6 := OX6) (OC5 := OC5) (OE7 := OE7) (OY4 := OY4) u) ⟶ obj (OY1 := OY1) (OX3 := OX3) (OX6 := OX6) (OC5 := OC5) (OE7 := OE7) (OY4 := OY4) v)
  | Y1, Y1 => some (𝟙 _)
  | Y1, C5 => some (ζ)
  | Y1, E7 => some (ζ ≫ b)
  | X3, X3 => some (𝟙 _)
  | X3, X6 => some (ρ)
  | X3, C5 => some (a)
  | X3, E7 => some (a ≫ b)
  | X3, Y4 => some (ε)
  | X6, X6 => some (𝟙 _)
  | C5, C5 => some (𝟙 _)
  | C5, E7 => some (b)
  | E7, E7 => some (𝟙 _)
  | Y4, Y4 => some (𝟙 _)
  | _, _ => none

end Diagram

end LPF0D

end RayCat

namespace RayCat

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type u} [Field k] [Infinite k]

set_option maxHeartbeats 8000000 in
open LPF0D in
/-- **No cleaving diagram `LPF0D` in `P/τ`.** -/
theorem MildHyp.not_lpf0d (hM : MildHyp k P)
    {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {OY1 OX3 OX6 OC5 OE7 OY4 : P}
    (ζ : OY1 ⟶ OC5) (ρ : OX3 ⟶ OX6) (a : OX3 ⟶ OC5) (ε : OX3 ⟶ OY4) (b : OC5 ⟶ OE7)
    (h0_Y1_C5 : ¬FactorsThroughMorphism τ (ζ))
    (h0_Y1_E7 : ¬FactorsThroughMorphism τ (ζ ≫ b))
    (h0_X3_X6 : ¬FactorsThroughMorphism τ (ρ))
    (h0_X3_C5 : ¬FactorsThroughMorphism τ (a))
    (h0_X3_E7 : ¬FactorsThroughMorphism τ (a ≫ b))
    (h0_X3_Y4 : ¬FactorsThroughMorphism τ (ε))
    (h0_C5_E7 : ¬FactorsThroughMorphism τ (b))
    (hi_ζ : ¬IsIso ζ)
    (hi_ρ : ¬IsIso ρ)
    (hi_a : ¬IsIso a)
    (hi_ε : ¬IsIso ε)
    (hi_b : ¬IsIso b)
    (hl_ρ_a_C5 : ¬∃ g, ρ ≫ g = a)
    (hl_ρ_a_E7 : ¬∃ g, ρ ≫ g = a ≫ b)
    (hl_ρ_ε_Y4 : ¬∃ g, ρ ≫ g = ε)
    (hl_a_ρ_X6 : ¬∃ g, a ≫ g = ρ)
    (hl_a_ε_Y4 : ¬∃ g, a ≫ g = ε)
    (hl_ε_ρ_X6 : ¬∃ g, ε ≫ g = ρ)
    (hl_ε_a_C5 : ¬∃ g, ε ≫ g = a)
    (hl_ε_a_E7 : ¬∃ g, ε ≫ g = a ≫ b)
    (hr_ζ_a_X3 : ¬∃ g, g ≫ ζ = a)
    (hr_a_ζ_Y1 : ¬∃ g, g ≫ a = ζ)
    : False := by
  haveI : Fact (LargeIndecomposable.Foundations.Quiver.IsAcyclic (OT G o)) := ⟨OT.isAcyclic ho hasym isAcyclic⟩
  refine hM.not_tree_table τ hτ hτ0 G o ho hasym isAcyclic
    (OT.not_isRepresentationFinite_affineD ho hcov k 1 copy) obj (arr ζ ρ a ε b)
    (tab ζ ρ a ε b) (fun v ↦ by cases v <;> rfl) ?_ ?_ ?_ ?_ ?_
  · intro x y z h f hf
    cases y <;> cases z <;> (try exact absurd h (by decide)) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; rfl)
      | rfl
  · intro x y f hf hne
    cases x <;> cases y <;> (try exact absurd rfl hne) <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;> assumption
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | assumption
  · intro x c c' y h h' f hne hf
    cases x <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases y <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.comp_id]; assumption)
      | assumption
  · intro x c c' y h h' f hne hf
    cases y <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; assumption)
      | assumption

end RayCat

end LargeIndecomposable
