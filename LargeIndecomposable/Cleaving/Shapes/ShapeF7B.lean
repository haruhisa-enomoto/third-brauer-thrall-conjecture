/-!
# The tree diagram `F7B`

BO13a figure 7.2 (second tree): the `Ẽ₆` tree `c ← x → a`, `a → b → b₂`, `a → y₁ ← e`.

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `F7B`. -/
inductive F7B
  | a | x | c | b | b₂ | y₁ | e
  deriving DecidableEq

namespace F7B

instance : Fintype F7B := ⟨{a, x, c, b, b₂, y₁, e}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : F7B → F7B → Bool
  | x, a | x, c | a, b | b, b₂ | a, y₁ | e, y₁ => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : F7B) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph F7B := SimpleGraph.fromRel o

lemma adj_iff (u v : F7B) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : F7B) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : F7B) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : F7B) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : F7B → Option F7B
  | a => none
  | x => some a
  | c => some x
  | b => some a
  | b₂ => some b
  | y₁ => some a
  | e => some y₁

/-- The height. -/
def ht : F7B → ℕ
  | a => 0
  | x => 1
  | c => 2
  | b => 1
  | b₂ => 2
  | y₁ => 1
  | e => 2

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `Ẽ₆`. -/
def cmap : AffineE6 → F7B
  | .center => a
  | .inner i => if (i : ℕ) = 0 then x else if (i : ℕ) = 1 then b else y₁
  | .outer i => if (i : ℕ) = 0 then c else if (i : ℕ) = 1 then b₂ else e

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `Ẽ₆`. -/
def copy : (underlyingGraph AffineE6).Copy G :=
  copyOf G cmap (by
    intro u v h
    rcases u with _ | i | i <;> rcases v with _ | j | j <;>
      (try fin_cases i) <;> (try fin_cases j) <;> simp_all [cmap])
    (by
      intro a b e
      rcases a with _ | i | i <;> rcases b with _ | j | j
      all_goals first
        | exact (IsEmpty.false e).elim
        | exact e.elim
        | (obtain rfl : i = j := e.down; fin_cases i <;> simp only [cmap] <;> decide)
        | (fin_cases i <;> simp only [cmap] <;> decide))

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {Aa X Cc Bb B₂ Y₁ E : P}
  (V₁ : X ⟶ Aa) (W₁ : X ⟶ Cc) (V₂ : Aa ⟶ Bb) (s : Bb ⟶ B₂) (r : Aa ⟶ Y₁) (η : E ⟶ Y₁)

/-- The objects. -/
def obj : F7B → P
  | a => Aa | x => X | c => Cc | b => Bb | b₂ => B₂ | y₁ => Y₁ | e => E

/-- The arrows. -/
def arr : ∀ u v : F7B, o u v → ((obj (Aa := Aa) (X := X) (Cc := Cc) (Bb := Bb) (B₂ := B₂) (Y₁ := Y₁) (E := E) u) ⟶ obj (Aa := Aa) (X := X) (Cc := Cc) (Bb := Bb) (B₂ := B₂) (Y₁ := Y₁) (E := E) v)
  | x, a, _ => V₁
  | x, c, _ => W₁
  | a, b, _ => V₂
  | b, b₂, _ => s
  | a, y₁, _ => r
  | e, y₁, _ => η
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : F7B, Option ((obj (Aa := Aa) (X := X) (Cc := Cc) (Bb := Bb) (B₂ := B₂) (Y₁ := Y₁) (E := E) u) ⟶ obj (Aa := Aa) (X := X) (Cc := Cc) (Bb := Bb) (B₂ := B₂) (Y₁ := Y₁) (E := E) v)
  | a, a => some (𝟙 _)
  | a, b => some (V₂)
  | a, b₂ => some (V₂ ≫ s)
  | a, y₁ => some (r)
  | x, x => some (𝟙 _)
  | x, a => some (V₁)
  | x, b => some (V₁ ≫ V₂)
  | x, b₂ => some ((V₁ ≫ V₂) ≫ s)
  | x, y₁ => some (V₁ ≫ r)
  | x, c => some (W₁)
  | c, c => some (𝟙 _)
  | b, b => some (𝟙 _)
  | b, b₂ => some (s)
  | b₂, b₂ => some (𝟙 _)
  | y₁, y₁ => some (𝟙 _)
  | e, e => some (𝟙 _)
  | e, y₁ => some (η)
  | _, _ => none

end Diagram

