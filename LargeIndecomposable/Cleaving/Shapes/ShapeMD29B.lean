/-- **No cleaving diagram `MD29B` in `P/τ`.** -/
theorem MildHyp.not_md29b (hM : MildHyp k P) {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {OA1 OXm OY1 OA2 OM1 OB1 OM2 OB2 : P}
    (η : OA1 ⟶ OXm) (δf : OXm ⟶ OM1) (ξ : OM1 ⟶ OB1) (ξ₂ : OM2 ⟶ OB2) (β : OB2 ⟶ OY1) (ω : OY1 ⟶ OA2) (α : OA1 ⟶ OY1) (γ : OXm ⟶ OA2)
    (hD : ¬Statement.IsRepresentationFinite (Linearization (ThinCat thin) k))
    (hc0 : α ≫ ω = η ≫ γ)
    (h0_A1_A2 : ¬FactorsThroughMorphism τ (η ≫ γ))
    (h0_A1_B1 : ¬FactorsThroughMorphism τ ((η ≫ δf) ≫ ξ))
    (h0_A1_M1 : ¬FactorsThroughMorphism τ (η ≫ δf))
    (h0_A1_Xm : ¬FactorsThroughMorphism τ (η))
    (h0_A1_Y1 : ¬FactorsThroughMorphism τ (α))
    (h0_B2_A2 : ¬FactorsThroughMorphism τ (β ≫ ω))
    (h0_B2_Y1 : ¬FactorsThroughMorphism τ (β))
    (h0_M1_B1 : ¬FactorsThroughMorphism τ (ξ))
    (h0_M2_A2 : ¬FactorsThroughMorphism τ ((ξ₂ ≫ β) ≫ ω))
    (h0_M2_B2 : ¬FactorsThroughMorphism τ (ξ₂))
    (h0_M2_Y1 : ¬FactorsThroughMorphism τ (ξ₂ ≫ β))
    (h0_Xm_A2 : ¬FactorsThroughMorphism τ (γ))
    (h0_Xm_B1 : ¬FactorsThroughMorphism τ (δf ≫ ξ))
    (h0_Xm_M1 : ¬FactorsThroughMorphism τ (δf))
    (h0_Y1_A2 : ¬FactorsThroughMorphism τ (ω))
    (hi_η : ¬IsIso η)
    (hi_δf : ¬IsIso δf)
    (hi_ξ : ¬IsIso ξ)
    (hi_ξ₂ : ¬IsIso ξ₂)
    (hi_β : ¬IsIso β)
    (hi_ω : ¬IsIso ω)
    (hi_α : ¬IsIso α)
    (hi_γ : ¬IsIso γ)
    (hlft_A1_Xm_Y1 : ¬∃ g, η ≫ g = α)
    (hlft_A1_Y1_Xm : ¬∃ g, α ≫ g = η)
    (hlft_A1_Y1_M1 : ¬∃ g, α ≫ g = η ≫ δf)
    (hlft_A1_Y1_B1 : ¬∃ g, α ≫ g = (η ≫ δf) ≫ ξ)
    (hlft_Xm_A2_M1 : ¬∃ g, γ ≫ g = δf)
    (hlft_Xm_A2_B1 : ¬∃ g, γ ≫ g = δf ≫ ξ)
    (hlft_Xm_M1_A2 : ¬∃ g, δf ≫ g = γ)
    (hrgt_M2_A1_Y1 : ¬∃ g, g ≫ α = ξ₂ ≫ β)
    (hrgt_B2_A1_Y1 : ¬∃ g, g ≫ α = β)
    (hrgt_A1_B2_Y1 : ¬∃ g, g ≫ β = α)
    (hrgt_Y1_Xm_A2 : ¬∃ g, g ≫ γ = ω)
    (hrgt_M2_Xm_A2 : ¬∃ g, g ≫ γ = (ξ₂ ≫ β) ≫ ω)
    (hrgt_B2_Xm_A2 : ¬∃ g, g ≫ γ = β ≫ ω)
    (hrgt_Xm_Y1_A2 : ¬∃ g, g ≫ ω = γ)
    : False := by
  have hlft_A1_Xm_A1 : ¬∃ g, η ≫ g = 𝟙 _ := not_split_mono hi_η
  have hlft_A1_Y1_A1 : ¬∃ g, α ≫ g = 𝟙 _ := not_split_mono hi_α
  have hlft_B2_Y1_B2 : ¬∃ g, β ≫ g = 𝟙 _ := not_split_mono hi_β
  have hlft_M1_B1_M1 : ¬∃ g, ξ ≫ g = 𝟙 _ := not_split_mono hi_ξ
  have hlft_M2_B2_M2 : ¬∃ g, ξ₂ ≫ g = 𝟙 _ := not_split_mono hi_ξ₂
  have hlft_Xm_A2_Xm : ¬∃ g, γ ≫ g = 𝟙 _ := not_split_mono hi_γ
  have hlft_Xm_M1_Xm : ¬∃ g, δf ≫ g = 𝟙 _ := not_split_mono hi_δf
  have hlft_Y1_A2_Y1 : ¬∃ g, ω ≫ g = 𝟙 _ := not_split_mono hi_ω
  have hrgt_Xm_A1_Xm : ¬∃ g, g ≫ η = 𝟙 _ := not_split_epi hi_η
  have hrgt_Y1_A1_Y1 : ¬∃ g, g ≫ α = 𝟙 _ := not_split_epi hi_α
  have hrgt_Y1_B2_Y1 : ¬∃ g, g ≫ β = 𝟙 _ := not_split_epi hi_β
  have hrgt_B1_M1_B1 : ¬∃ g, g ≫ ξ = 𝟙 _ := not_split_epi hi_ξ
  have hrgt_B2_M2_B2 : ¬∃ g, g ≫ ξ₂ = 𝟙 _ := not_split_epi hi_ξ₂
  have hrgt_A2_Xm_A2 : ¬∃ g, g ≫ γ = 𝟙 _ := not_split_epi hi_γ
  have hrgt_M1_Xm_M1 : ¬∃ g, g ≫ δf = 𝟙 _ := not_split_epi hi_δf
  have hrgt_A2_Y1_A2 : ¬∃ g, g ≫ ω = 𝟙 _ := not_split_epi hi_ω
  have hc0' := reassoc_of% hc0
  refine hM.not_thin_diagram τ hτ hτ0 hD arrows obj (fun x y _ ↦ tab η δf ξ ξ₂ β ω α γ x y)
    (fun x ↦ by cases x <;> rfl) ?_ ?_ ?_ ?_
  · intro x y z h h'
    cases x <;> cases y <;> (try exact absurd h (by decide)) <;> cases z <;>
      (try exact absurd h' (by decide)) <;> split_ifs with hn <;>
      (try exact absurd hn (by decide)) <;>
      simp only [tab, Category.assoc, Category.id_comp, Category.comp_id, zero_comp, comp_zero, hc0', hc0]
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | exact not_factorsThrough_id hτ _
      | assumption
  · intro x z y ha hy
    cases x <;> cases z <;> (try exact absurd ha (by decide)) <;> cases y <;>
      (try exact absurd hy (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›
  · intro x z y ha hx
    cases z <;> cases y <;> (try exact absurd ha (by decide)) <;> cases x <;>
      (try exact absurd hx (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›

