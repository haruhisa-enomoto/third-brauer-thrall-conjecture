namespace RayCat

/-- Vertices of the diagram `F68`. -/
inductive F68
  | x | b | m | b' | y₀ | y₁ | x' | x''
  deriving DecidableEq

namespace F68

instance : Fintype F68 := ⟨{x, b, m, b', y₀, y₁, x', x''}, by intro v; cases v <;> simp⟩

/-- The order (nonzero morphisms). -/
def leb : F68 → F68 → Bool
  | b, b | b, y₀ | b', b' | b', y₁ | m, m | m, y₀ | m, y₁ | x, b | x, b' | x, m | x, x | x, y₀ | x, y₁ | x', b | x', x' | x', y₀ | x'', b' | x'', x'' | x'', y₁ | y₀, y₀ | y₁, y₁ => true
  | _, _ => false

/-- The arrows. -/
def arb : F68 → F68 → Bool
  | b, y₀ | b', y₁ | m, y₀ | m, y₁ | x, b | x, b' | x, m | x', b | x'', b' => true
  | _, _ => false

/-- The thin category. -/
abbrev thin : ThinData F68 where
  le x y := leb x y = true
  nz x _ z := leb x z = true
  refl x := by cases x <;> rfl
  antisymm := by decide
  nz_le _ _ _ _ _ h := h
  nz_left _ _ h := h
  nz_right _ _ h := h
  assoc := by decide

/-- The generating arrows. -/
abbrev arrows : ThinArrows thin where
  ar x y := arb x y = true
  ar_le := by decide
  ar_ne := by decide
  first := by decide
  last := by decide

