  (w₁ : X ⟶ Bb) (ψ : X ⟶ M) (v : X ⟶ B') (w₂ : Bb ⟶ Y₀) (U : M ⟶ Y₀) (U' : M ⟶ Y₁) (v₂ : B' ⟶ Y₁) (r : X' ⟶ Bb) (t : X'' ⟶ B')

/-- The objects. -/
abbrev obj : F68 → P
  | x => X | b => Bb | m => M | b' => B' | y₀ => Y₀ | y₁ => Y₁ | x' => X' | x'' => X''

/-- The morphisms. -/
abbrev tab : ∀ u v : F68, (obj (X := X) (Bb := Bb) (M := M) (B' := B') (Y₀ := Y₀) (Y₁ := Y₁) (X' := X') (X'' := X'') u) ⟶ obj (X := X) (Bb := Bb) (M := M) (B' := B') (Y₀ := Y₀) (Y₁ := Y₁) (X' := X') (X'' := X'') v
  | b, b => 𝟙 _
  | b, y₀ => w₂
  | b', b' => 𝟙 _
  | b', y₁ => v₂
  | m, m => 𝟙 _
  | m, y₀ => U
  | m, y₁ => U'
  | x, b => w₁
  | x, b' => v
  | x, m => ψ
  | x, x => 𝟙 _
  | x, y₀ => w₁ ≫ w₂
  | x, y₁ => ψ ≫ U'
  | x', b => r
  | x', x' => 𝟙 _
  | x', y₀ => r ≫ w₂
  | x'', b' => t
  | x'', x'' => 𝟙 _
  | x'', y₁ => t ≫ v₂
