/-!
# The tree diagram `Out3`

The `D̃₄` star with one arrow `ρ` into `y` and three arrows `α, β, γ` out of `y` ([mild] Lemma LPF).

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `Out3`. -/
inductive Out3
  | y | s | a | b | c
  deriving DecidableEq

namespace Out3

instance : Fintype Out3 := ⟨{y, s, a, b, c}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : Out3 → Out3 → Bool
  | s, y | y, a | y, b | y, c => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : Out3) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph Out3 := SimpleGraph.fromRel o

lemma adj_iff (u v : Out3) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : Out3) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : Out3) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : Out3) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : Out3 → Option Out3
  | y => none
  | s => some y
  | a => some y
  | b => some y
  | c => some y

/-- The height. -/
def ht : Out3 → ℕ
  | y => 0
  | s => 1
  | a => 1
  | b => 1
  | c => 1

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `D̃`. -/
def cmap : AffineD 0 → Out3
  | .spine j => y
  | .leaf i => if (i : ℕ) = 0 then s else if (i : ℕ) = 1 then a else if (i : ℕ) = 2 then b else c

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `D̃`. -/
def copy : (underlyingGraph (AffineD 0)).Copy G :=
  copyD G 0 cmap (by
    intro u v h
    rcases u with i | j <;> rcases v with i' | j'
    · fin_cases i <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases i <;> fin_cases j' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases j' <;> simp_all [cmap])
    (fun i ↦ by
      fin_cases i
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide)
    (fun j j' h ↦ by fin_cases j <;> fin_cases j' <;> simp_all [cmap] <;> decide)

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {Y Ss Aa Bb Cc : P}
  (ρ : Ss ⟶ Y) (α : Y ⟶ Aa) (β : Y ⟶ Bb) (γ : Y ⟶ Cc)

/-- The objects. -/
def obj : Out3 → P
  | y => Y | s => Ss | a => Aa | b => Bb | c => Cc

/-- The arrows. -/
def arr : ∀ u v : Out3, o u v → ((obj (Y := Y) (Ss := Ss) (Aa := Aa) (Bb := Bb) (Cc := Cc) u) ⟶ obj (Y := Y) (Ss := Ss) (Aa := Aa) (Bb := Bb) (Cc := Cc) v)
  | s, y, _ => ρ
  | y, a, _ => α
  | y, b, _ => β
  | y, c, _ => γ
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : Out3, Option ((obj (Y := Y) (Ss := Ss) (Aa := Aa) (Bb := Bb) (Cc := Cc) u) ⟶ obj (Y := Y) (Ss := Ss) (Aa := Aa) (Bb := Bb) (Cc := Cc) v)
  | y, y => some (𝟙 _)
  | y, a => some (α)
  | y, b => some (β)
  | y, c => some (γ)
  | s, s => some (𝟙 _)
  | s, y => some (ρ)
  | s, a => some (ρ ≫ α)
  | s, b => some (ρ ≫ β)
  | s, c => some (ρ ≫ γ)
  | a, a => some (𝟙 _)
  | b, b => some (𝟙 _)
  | c, c => some (𝟙 _)
  | _, _ => none

end Diagram

end Out3

end RayCat

namespace RayCat

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type u} [Field k] [Infinite k]

set_option maxHeartbeats 8000000 in
open Out3 in
/-- **No cleaving diagram `Out3` in `P/τ`.** -/
theorem MildHyp.not_out3 (hM : MildHyp k P)
    {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {Y Ss Aa Bb Cc : P}
    (ρ : Ss ⟶ Y) (α : Y ⟶ Aa) (β : Y ⟶ Bb) (γ : Y ⟶ Cc)
    (h0_y_a : ¬FactorsThroughMorphism τ (α))
    (h0_y_b : ¬FactorsThroughMorphism τ (β))
    (h0_y_c : ¬FactorsThroughMorphism τ (γ))
    (h0_s_y : ¬FactorsThroughMorphism τ (ρ))
    (h0_s_a : ¬FactorsThroughMorphism τ (ρ ≫ α))
    (h0_s_b : ¬FactorsThroughMorphism τ (ρ ≫ β))
    (h0_s_c : ¬FactorsThroughMorphism τ (ρ ≫ γ))
    (hi_ρ : ¬IsIso ρ)
    (hi_α : ¬IsIso α)
    (hi_β : ¬IsIso β)
    (hi_γ : ¬IsIso γ)
    (hl_α_β_b : ¬∃ g, α ≫ g = β)
    (hl_α_γ_c : ¬∃ g, α ≫ g = γ)
    (hl_β_α_a : ¬∃ g, β ≫ g = α)
    (hl_β_γ_c : ¬∃ g, β ≫ g = γ)
    (hl_γ_α_a : ¬∃ g, γ ≫ g = α)
    (hl_γ_β_b : ¬∃ g, γ ≫ g = β)
    : False := by
  haveI : Fact (LargeIndecomposable.Foundations.Quiver.IsAcyclic (OT G o)) := ⟨OT.isAcyclic ho hasym isAcyclic⟩
  refine hM.not_tree_table τ hτ hτ0 G o ho hasym isAcyclic
    (OT.not_isRepresentationFinite_affineD ho hcov k 0 copy) obj (arr ρ α β γ)
    (tab ρ α β γ) (fun v ↦ by cases v <;> rfl) ?_ ?_ ?_ ?_ ?_
  · intro x y z h f hf
    cases y <;> cases z <;> (try exact absurd h (by decide)) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; rfl)
      | rfl
  · intro x y f hf hne
    cases x <;> cases y <;> (try exact absurd rfl hne) <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;> assumption
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | assumption
  · intro x c c' y h h' f hne hf
    cases x <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases y <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.comp_id]; assumption)
      | assumption
  · intro x c c' y h h' f hne hf
    cases y <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; assumption)
      | assumption

end RayCat

end LargeIndecomposable
