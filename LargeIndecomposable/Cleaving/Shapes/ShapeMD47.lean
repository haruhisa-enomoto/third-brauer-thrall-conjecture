  (β₂ : OBq ⟶ OYq) (ω : OYq ⟶ OA1) (η₁ : OC1 ⟶ OC2) (η₂ : OC2 ⟶ OX1) (γ : OX1 ⟶ OA1) (δ : OX1 ⟶ OB1) (α : OA1 ⟶ OY1) (β : OB1 ⟶ OY1)

/-- The objects. -/
abbrev obj : MD47 → P
  | Bq => OBq | Yq => OYq | A1 => OA1 | C1 => OC1 | C2 => OC2 | X1 => OX1 | B1 => OB1 | Y1 => OY1

/-- The morphisms. -/
abbrev tab : ∀ u v : MD47, (obj (OBq := OBq) (OYq := OYq) (OA1 := OA1) (OC1 := OC1) (OC2 := OC2) (OX1 := OX1) (OB1 := OB1) (OY1 := OY1) u) ⟶ obj (OBq := OBq) (OYq := OYq) (OA1 := OA1) (OC1 := OC1) (OC2 := OC2) (OX1 := OX1) (OB1 := OB1) (OY1 := OY1) v
  | A1, A1 => 𝟙 _
  | A1, Y1 => α
  | B1, B1 => 𝟙 _
  | B1, Y1 => β
  | Bq, A1 => β₂ ≫ ω
  | Bq, Bq => 𝟙 _
  | Bq, Y1 => (β₂ ≫ ω) ≫ α
  | Bq, Yq => β₂
  | C1, A1 => (η₁ ≫ η₂) ≫ γ
  | C1, B1 => (η₁ ≫ η₂) ≫ δ
