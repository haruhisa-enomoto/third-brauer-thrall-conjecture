namespace RayCat

/-- Vertices of the diagram `MD47`. -/
inductive MD47
  | Bq | Yq | A1 | C1 | C2 | X1 | B1 | Y1
  deriving DecidableEq

namespace MD47

instance : Fintype MD47 := ⟨{Bq, Yq, A1, C1, C2, X1, B1, Y1}, by intro v; cases v <;> simp⟩

/-- The order (nonzero morphisms). -/
def leb : MD47 → MD47 → Bool
  | A1, A1 | A1, Y1 | B1, B1 | B1, Y1 | Bq, A1 | Bq, Bq | Bq, Y1 | Bq, Yq | C1, A1 | C1, B1 | C1, C1 | C1, C2 | C1, X1 | C1, Y1 | C2, A1 | C2, B1 | C2, C2 | C2, X1 | C2, Y1 | X1, A1 | X1, B1 | X1, X1 | X1, Y1 | Y1, Y1 | Yq, A1 | Yq, Y1 | Yq, Yq => true
  | _, _ => false

/-- The arrows. -/
def arb : MD47 → MD47 → Bool
  | A1, Y1 | B1, Y1 | Bq, Yq | C1, C2 | C2, X1 | X1, A1 | X1, B1 | Yq, A1 => true
  | _, _ => false

/-- The thin category. -/
abbrev thin : ThinData MD47 where
  le x y := leb x y = true
  nz x _ z := leb x z = true
  refl x := by cases x <;> rfl
  antisymm := by decide
  nz_le _ _ _ _ _ h := h
  nz_left _ _ h := h
  nz_right _ _ h := h
  assoc := by decide

/-- The generating arrows. -/
abbrev arrows : ThinArrows thin where
  ar x y := arb x y = true
  ar_le := by decide
  ar_ne := by decide
  first := by decide
  last := by decide

