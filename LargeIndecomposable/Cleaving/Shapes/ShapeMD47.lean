namespace RayCat

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type*} [Field k] [Infinite k]

set_option maxHeartbeats 16000000 in
open MD47 in
/-- **No cleaving diagram `MD47` in `P/τ`.** -/
theorem MildHyp.not_md47 (hM : MildHyp k P) {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {OBq OYq OA1 OC1 OC2 OX1 OB1 OY1 : P}
    (β₂ : OBq ⟶ OYq) (ω : OYq ⟶ OA1) (η₁ : OC1 ⟶ OC2) (η₂ : OC2 ⟶ OX1) (γ : OX1 ⟶ OA1) (δ : OX1 ⟶ OB1) (α : OA1 ⟶ OY1) (β : OB1 ⟶ OY1)
    (hD : ¬Statement.IsRepresentationFinite (Linearization (ThinCat thin) k))
    (hc0 : η₁ ≫ η₂ ≫ δ ≫ β = η₁ ≫ η₂ ≫ γ ≫ α)
    (hc1 : η₂ ≫ δ ≫ β = η₂ ≫ γ ≫ α)
    (hc2 : δ ≫ β = γ ≫ α)
    (h0_A1_Y1 : ¬FactorsThroughMorphism τ (α))
    (h0_B1_Y1 : ¬FactorsThroughMorphism τ (β))
    (h0_Bq_A1 : ¬FactorsThroughMorphism τ (β₂ ≫ ω))
    (h0_Bq_Y1 : ¬FactorsThroughMorphism τ ((β₂ ≫ ω) ≫ α))
    (h0_Bq_Yq : ¬FactorsThroughMorphism τ (β₂))
    (h0_C1_A1 : ¬FactorsThroughMorphism τ ((η₁ ≫ η₂) ≫ γ))
    (h0_C1_B1 : ¬FactorsThroughMorphism τ ((η₁ ≫ η₂) ≫ δ))
    (h0_C1_C2 : ¬FactorsThroughMorphism τ (η₁))
    (h0_C1_X1 : ¬FactorsThroughMorphism τ (η₁ ≫ η₂))
    (h0_C1_Y1 : ¬FactorsThroughMorphism τ (((η₁ ≫ η₂) ≫ γ) ≫ α))
    (h0_C2_A1 : ¬FactorsThroughMorphism τ (η₂ ≫ γ))
    (h0_C2_B1 : ¬FactorsThroughMorphism τ (η₂ ≫ δ))
    (h0_C2_X1 : ¬FactorsThroughMorphism τ (η₂))
    (h0_C2_Y1 : ¬FactorsThroughMorphism τ ((η₂ ≫ γ) ≫ α))
    (h0_X1_A1 : ¬FactorsThroughMorphism τ (γ))
    (h0_X1_B1 : ¬FactorsThroughMorphism τ (δ))
    (h0_X1_Y1 : ¬FactorsThroughMorphism τ (γ ≫ α))
    (h0_Yq_A1 : ¬FactorsThroughMorphism τ (ω))
    (h0_Yq_Y1 : ¬FactorsThroughMorphism τ (ω ≫ α))
    (hi_β₂ : ¬IsIso β₂)
    (hi_ω : ¬IsIso ω)
    (hi_η₁ : ¬IsIso η₁)
    (hi_η₂ : ¬IsIso η₂)
    (hi_γ : ¬IsIso γ)
    (hi_δ : ¬IsIso δ)
    (hi_α : ¬IsIso α)
    (hi_β : ¬IsIso β)
    (hlft_X1_A1_B1 : ¬∃ g, γ ≫ g = δ)
    (hlft_X1_B1_A1 : ¬∃ g, δ ≫ g = γ)
    (hrgt_B1_A1_Y1 : ¬∃ g, g ≫ α = β)
    (hrgt_Bq_B1_Y1 : ¬∃ g, g ≫ β = (β₂ ≫ ω) ≫ α)
    (hrgt_Yq_B1_Y1 : ¬∃ g, g ≫ β = ω ≫ α)
    (hrgt_A1_B1_Y1 : ¬∃ g, g ≫ β = α)
    (hrgt_Bq_X1_A1 : ¬∃ g, g ≫ γ = β₂ ≫ ω)
    (hrgt_Yq_X1_A1 : ¬∃ g, g ≫ γ = ω)
    (hrgt_C1_Yq_A1 : ¬∃ g, g ≫ ω = (η₁ ≫ η₂) ≫ γ)
    (hrgt_C2_Yq_A1 : ¬∃ g, g ≫ ω = η₂ ≫ γ)
    (hrgt_X1_Yq_A1 : ¬∃ g, g ≫ ω = γ)
    : False := by
  have hlft_A1_Y1_A1 : ¬∃ g, α ≫ g = 𝟙 _ := not_split_mono hi_α
  have hlft_B1_Y1_B1 : ¬∃ g, β ≫ g = 𝟙 _ := not_split_mono hi_β
  have hlft_Bq_Yq_Bq : ¬∃ g, β₂ ≫ g = 𝟙 _ := not_split_mono hi_β₂
  have hlft_C1_C2_C1 : ¬∃ g, η₁ ≫ g = 𝟙 _ := not_split_mono hi_η₁
  have hlft_C2_X1_C2 : ¬∃ g, η₂ ≫ g = 𝟙 _ := not_split_mono hi_η₂
  have hlft_X1_A1_X1 : ¬∃ g, γ ≫ g = 𝟙 _ := not_split_mono hi_γ
  have hlft_X1_B1_X1 : ¬∃ g, δ ≫ g = 𝟙 _ := not_split_mono hi_δ
  have hlft_Yq_A1_Yq : ¬∃ g, ω ≫ g = 𝟙 _ := not_split_mono hi_ω
  have hrgt_Y1_A1_Y1 : ¬∃ g, g ≫ α = 𝟙 _ := not_split_epi hi_α
  have hrgt_Y1_B1_Y1 : ¬∃ g, g ≫ β = 𝟙 _ := not_split_epi hi_β
  have hrgt_Yq_Bq_Yq : ¬∃ g, g ≫ β₂ = 𝟙 _ := not_split_epi hi_β₂
  have hrgt_C2_C1_C2 : ¬∃ g, g ≫ η₁ = 𝟙 _ := not_split_epi hi_η₁
  have hrgt_X1_C2_X1 : ¬∃ g, g ≫ η₂ = 𝟙 _ := not_split_epi hi_η₂
  have hrgt_A1_X1_A1 : ¬∃ g, g ≫ γ = 𝟙 _ := not_split_epi hi_γ
  have hrgt_B1_X1_B1 : ¬∃ g, g ≫ δ = 𝟙 _ := not_split_epi hi_δ
  have hrgt_A1_Yq_A1 : ¬∃ g, g ≫ ω = 𝟙 _ := not_split_epi hi_ω
  have hc0' := reassoc_of% hc0
  have hc1' := reassoc_of% hc1
  have hc2' := reassoc_of% hc2
  refine hM.not_thin_diagram τ hτ hτ0 hD arrows obj (fun x y _ ↦ tab β₂ ω η₁ η₂ γ δ α β x y)
    (fun x ↦ by cases x <;> rfl) ?_ ?_ ?_ ?_
  · intro x y z h h'
    cases x <;> cases y <;> (try exact absurd h (by decide)) <;> cases z <;>
      (try exact absurd h' (by decide)) <;> split_ifs with hn <;>
      (try exact absurd hn (by decide)) <;>
      simp only [tab, Category.assoc, Category.id_comp, Category.comp_id, zero_comp, comp_zero, hc0', hc0, hc1', hc1, hc2', hc2]
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | exact not_factorsThrough_id hτ _
      | assumption
  · intro x z y ha hy
    cases x <;> cases z <;> (try exact absurd ha (by decide)) <;> cases y <;>
      (try exact absurd hy (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›
  · intro x z y ha hx
    cases z <;> cases y <;> (try exact absurd ha (by decide)) <;> cases x <;>
      (try exact absurd hx (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›

end RayCat

