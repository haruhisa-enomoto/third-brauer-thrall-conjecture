/-- **No cleaving diagram `MI41B` in `P/τ`.** -/
theorem MildHyp.not_mi41b (hM : MildHyp k P) {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {OX0 OX1 OX2 OT OY0 OY1 OY2 OZ : P}
    (c₁ : OX0 ⟶ OX1) (c₂ : OX1 ⟶ OX2) (ζ : OT ⟶ OX2) (μ₁ : OX0 ⟶ OY1) (μ₂ : OX1 ⟶ OY2) (a₁ : OY0 ⟶ OY1) (a₂ : OY1 ⟶ OY2) (t : OY0 ⟶ OZ)
    (hD : ¬Statement.IsRepresentationFinite (Linearization (ThinCat thin) k))
    (hc0 : c₁ ≫ μ₂ = μ₁ ≫ a₂)
    (h0_Tt_X2 : ¬FactorsThroughMorphism τ (ζ))
    (h0_X0_X1 : ¬FactorsThroughMorphism τ (c₁))
    (h0_X0_X2 : ¬FactorsThroughMorphism τ (c₁ ≫ c₂))
    (h0_X0_Y1 : ¬FactorsThroughMorphism τ (μ₁))
    (h0_X0_Y2 : ¬FactorsThroughMorphism τ (μ₁ ≫ a₂))
    (h0_X1_X2 : ¬FactorsThroughMorphism τ (c₂))
    (h0_X1_Y2 : ¬FactorsThroughMorphism τ (μ₂))
    (h0_Y0_Y1 : ¬FactorsThroughMorphism τ (a₁))
