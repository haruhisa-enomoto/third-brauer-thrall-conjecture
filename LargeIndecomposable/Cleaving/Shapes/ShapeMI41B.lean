    (h0_Y1_Y2 : ¬FactorsThroughMorphism τ (a₂))
    (hi_c₁ : ¬IsIso c₁)
    (hi_c₂ : ¬IsIso c₂)
    (hi_ζ : ¬IsIso ζ)
    (hi_μ₁ : ¬IsIso μ₁)
    (hi_μ₂ : ¬IsIso μ₂)
    (hi_a₁ : ¬IsIso a₁)
    (hi_a₂ : ¬IsIso a₂)
    (hi_t : ¬IsIso t)
    (hlft_X0_X1_Y1 : ¬∃ g, c₁ ≫ g = μ₁)
    (hlft_X0_Y1_X1 : ¬∃ g, μ₁ ≫ g = c₁)
    (hlft_X0_Y1_X2 : ¬∃ g, μ₁ ≫ g = c₁ ≫ c₂)
    (hlft_X1_X2_Y2 : ¬∃ g, c₂ ≫ g = μ₂)
    (hlft_X1_Y2_X2 : ¬∃ g, μ₂ ≫ g = c₂)
    (hlft_Y0_Y1_Zz : ¬∃ g, a₁ ≫ g = t)
    (hlft_Y0_Zz_Y1 : ¬∃ g, t ≫ g = a₁)
    (hlft_Y0_Zz_Y2 : ¬∃ g, t ≫ g = a₁ ≫ a₂)
    (hrgt_X0_Tt_X2 : ¬∃ g, g ≫ ζ = c₁ ≫ c₂)
    (hrgt_X1_Tt_X2 : ¬∃ g, g ≫ ζ = c₂)
    (hrgt_Y0_X0_Y1 : ¬∃ g, g ≫ μ₁ = a₁)
    (hrgt_Tt_X1_X2 : ¬∃ g, g ≫ c₂ = ζ)
    (hrgt_Y0_X1_Y2 : ¬∃ g, g ≫ μ₂ = a₁ ≫ a₂)
    (hrgt_Y1_X1_Y2 : ¬∃ g, g ≫ μ₂ = a₂)
    (hrgt_X0_Y0_Y1 : ¬∃ g, g ≫ a₁ = μ₁)
    (hrgt_X1_Y1_Y2 : ¬∃ g, g ≫ a₂ = μ₂)
    : False := by
  have hlft_Tt_X2_Tt : ¬∃ g, ζ ≫ g = 𝟙 _ := not_split_mono hi_ζ
  have hlft_X0_X1_X0 : ¬∃ g, c₁ ≫ g = 𝟙 _ := not_split_mono hi_c₁
  have hlft_X0_Y1_X0 : ¬∃ g, μ₁ ≫ g = 𝟙 _ := not_split_mono hi_μ₁
  have hlft_X1_X2_X1 : ¬∃ g, c₂ ≫ g = 𝟙 _ := not_split_mono hi_c₂
  have hlft_X1_Y2_X1 : ¬∃ g, μ₂ ≫ g = 𝟙 _ := not_split_mono hi_μ₂
  have hlft_Y0_Y1_Y0 : ¬∃ g, a₁ ≫ g = 𝟙 _ := not_split_mono hi_a₁
  have hlft_Y0_Zz_Y0 : ¬∃ g, t ≫ g = 𝟙 _ := not_split_mono hi_t
  have hlft_Y1_Y2_Y1 : ¬∃ g, a₂ ≫ g = 𝟙 _ := not_split_mono hi_a₂
  have hrgt_X2_Tt_X2 : ¬∃ g, g ≫ ζ = 𝟙 _ := not_split_epi hi_ζ
  have hrgt_X1_X0_X1 : ¬∃ g, g ≫ c₁ = 𝟙 _ := not_split_epi hi_c₁
  have hrgt_Y1_X0_Y1 : ¬∃ g, g ≫ μ₁ = 𝟙 _ := not_split_epi hi_μ₁
  have hrgt_X2_X1_X2 : ¬∃ g, g ≫ c₂ = 𝟙 _ := not_split_epi hi_c₂
  have hrgt_Y2_X1_Y2 : ¬∃ g, g ≫ μ₂ = 𝟙 _ := not_split_epi hi_μ₂
  have hrgt_Y1_Y0_Y1 : ¬∃ g, g ≫ a₁ = 𝟙 _ := not_split_epi hi_a₁
  have hrgt_Zz_Y0_Zz : ¬∃ g, g ≫ t = 𝟙 _ := not_split_epi hi_t
  have hrgt_Y2_Y1_Y2 : ¬∃ g, g ≫ a₂ = 𝟙 _ := not_split_epi hi_a₂
  have hc0' := reassoc_of% hc0
  refine hM.not_thin_diagram τ hτ hτ0 hD arrows obj (fun x y _ ↦ tab c₁ c₂ ζ μ₁ μ₂ a₁ a₂ t x y)
    (fun x ↦ by cases x <;> rfl) ?_ ?_ ?_ ?_
  · intro x y z h h'
    cases x <;> cases y <;> (try exact absurd h (by decide)) <;> cases z <;>
      (try exact absurd h' (by decide)) <;> split_ifs with hn <;>
      (try exact absurd hn (by decide)) <;>
      simp only [tab, Category.assoc, Category.id_comp, Category.comp_id, zero_comp, comp_zero, hc0', hc0]
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | exact not_factorsThrough_id hτ _
      | assumption
  · intro x z y ha hy
    cases x <;> cases z <;> (try exact absurd ha (by decide)) <;> cases y <;>
      (try exact absurd hy (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›
  · intro x z y ha hx
    cases z <;> cases y <;> (try exact absurd ha (by decide)) <;> cases x <;>
      (try exact absurd hx (by decide)) <;>
      first
      | exact fun _ ↦ by decide
