/-- **No cleaving diagram `F95A` in `P/τ`.** -/
theorem not_f95a
    (hmin : ∀ I : TwoSidedIdeal A, I ≠ ⊥ → Statement.IsRepresentationFinite (A ⧸ I.asIdeal))
    (hL : LeftCancel P) (hR : RightCancel P) {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {Aa Mid Y₀ Wm Y₁ X₂ Y₂ X₃ Y₃ : P}
    (α : Mid ⟶ Aa) (V₂ : Aa ⟶ Y₀) (W₂ : Wm ⟶ Y₀) (ρ₁' : Aa ⟶ Y₁) (σ₂ : X₂ ⟶ Y₁) (ρ₂ : X₂ ⟶ Y₂) (σ₃ : X₃ ⟶ Y₂) (ρ₃ : X₃ ⟶ Y₃)
    (h0_a_y₀ : ¬FactorsThroughMorphism τ (V₂))
    (h0_a_y₁ : ¬FactorsThroughMorphism τ (ρ₁'))
    (h0_mid_a : ¬FactorsThroughMorphism τ (α))
    (h0_mid_y₀ : ¬FactorsThroughMorphism τ (α ≫ V₂))
    (h0_mid_y₁ : ¬FactorsThroughMorphism τ (α ≫ ρ₁'))
    (h0_wm_y₀ : ¬FactorsThroughMorphism τ (W₂))
    (h0_x₂_y₁ : ¬FactorsThroughMorphism τ (σ₂))
    (h0_x₂_y₂ : ¬FactorsThroughMorphism τ (ρ₂))
    (h0_x₃_y₂ : ¬FactorsThroughMorphism τ (σ₃))
    (h0_x₃_y₃ : ¬FactorsThroughMorphism τ (ρ₃))
    (hi_α : ¬IsIso α)
    (hi_V₂ : ¬IsIso V₂)
    (hi_W₂ : ¬IsIso W₂)
    (hi_ρ₁' : ¬IsIso ρ₁')
    (hi_σ₂ : ¬IsIso σ₂)
    (hi_ρ₂ : ¬IsIso ρ₂)
    (hi_σ₃ : ¬IsIso σ₃)
    (hi_ρ₃ : ¬IsIso ρ₃)
    (hl_V₂_ρ₁'_y₁ : ¬∃ g, V₂ ≫ g = ρ₁')
    (hl_ρ₁'_V₂_y₀ : ¬∃ g, ρ₁' ≫ g = V₂)
    (hl_σ₂_ρ₂_y₂ : ¬∃ g, σ₂ ≫ g = ρ₂)
    (hl_ρ₂_σ₂_y₁ : ¬∃ g, ρ₂ ≫ g = σ₂)
    (hl_σ₃_ρ₃_y₃ : ¬∃ g, σ₃ ≫ g = ρ₃)
    (hl_ρ₃_σ₃_y₂ : ¬∃ g, ρ₃ ≫ g = σ₃)
    (hr_V₂_W₂_wm : ¬∃ g, g ≫ V₂ = W₂)
    (hr_W₂_V₂_a : ¬∃ g, g ≫ W₂ = V₂)
    (hr_W₂_V₂_mid : ¬∃ g, g ≫ W₂ = α ≫ V₂)
    (hr_ρ₁'_σ₂_x₂ : ¬∃ g, g ≫ ρ₁' = σ₂)
    (hr_σ₂_ρ₁'_a : ¬∃ g, g ≫ σ₂ = ρ₁')
    (hr_σ₂_ρ₁'_mid : ¬∃ g, g ≫ σ₂ = α ≫ ρ₁')
    (hr_ρ₂_σ₃_x₃ : ¬∃ g, g ≫ ρ₂ = σ₃)
    (hr_σ₃_ρ₂_x₂ : ¬∃ g, g ≫ σ₃ = ρ₂)
    : False := by
  haveI : Fact (LargeIndecomposable.Foundations.Quiver.IsAcyclic (OT G o)) := ⟨OT.isAcyclic ho hasym isAcyclic⟩
  refine B.not_tree_table hmin hL hR τ hτ hτ0 G o ho hasym isAcyclic
    (OT.not_isRepresentationFinite_affineE8 ho hcov k copy) obj (arr α V₂ W₂ ρ₁' σ₂ ρ₂ σ₃ ρ₃)
    (tab α V₂ W₂ ρ₁' σ₂ ρ₂ σ₃ ρ₃) (fun v ↦ by cases v <;> rfl) ?_ ?_ ?_ ?_ ?_
  · intro x y z h f hf
    cases y <;> cases z <;> (try exact absurd h (by decide)) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; rfl)
      | rfl
  · intro x y f hf hne
    cases x <;> cases y <;> (try exact absurd rfl hne) <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;> assumption
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | assumption
  · intro x c c' y h h' f hne hf
    cases x <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases y <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.comp_id]; assumption)
      | assumption
  · intro x c c' y h h' f hne hf
    cases y <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; assumption)
      | assumption

