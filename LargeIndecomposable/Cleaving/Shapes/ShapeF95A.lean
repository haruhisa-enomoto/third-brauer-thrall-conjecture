namespace RayCat

/-- Vertices of the diagram `F95A`. -/
inductive F95A
  | a | mid | y₀ | wm | y₁ | x₂ | y₂ | x₃ | y₃
  deriving DecidableEq

namespace F95A

instance : Fintype F95A := ⟨{a, mid, y₀, wm, y₁, x₂, y₂, x₃, y₃}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : F95A → F95A → Bool
  | mid, a | a, y₀ | wm, y₀ | a, y₁ | x₂, y₁ | x₂, y₂ | x₃, y₂ | x₃, y₃ => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : F95A) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph F95A := SimpleGraph.fromRel o

lemma adj_iff (u v : F95A) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : F95A) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : F95A) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : F95A) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : F95A → Option F95A
  | a => none
  | mid => some a
  | y₀ => some a
  | wm => some y₀
  | y₁ => some a
  | x₂ => some y₁
  | y₂ => some x₂
  | x₃ => some y₂
  | y₃ => some x₃

/-- The height. -/
def ht : F95A → ℕ
  | a => 0
  | mid => 1
  | y₀ => 1
  | wm => 2
  | y₁ => 1
  | x₂ => 2
  | y₂ => 3
  | x₃ => 4
  | y₃ => 5

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `Ẽ₈` (arms listed from the centre). -/
def cmap : AffineE8 → F95A
  | .center => a
  | .short => mid
  | .medium4 => y₀
  | .medium2 => wm
  | .long5 => y₁
  | .long4 => x₂
  | .long3 => y₂
  | .long2 => x₃
  | .long1 => y₃

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `Ẽ₈`. -/
def copy : (underlyingGraph AffineE8).Copy G :=
  copyOf G cmap (by
    intro u v h
    cases u <;> cases v <;> simp_all [cmap])
    (by
      intro a b e
      change AffineE8.Arrow a b at e
      cases e <;> simp only [cmap] <;> decide)

