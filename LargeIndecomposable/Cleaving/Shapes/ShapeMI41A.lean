namespace MI41A

instance : Fintype MI41A := ⟨{Y0, Y1, Y2, Xx, Zz, Zp}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : MI41A → MI41A → Bool
  | Y0, Y1 | Y1, Y2 | Xx, Y1 | Y0, Zz | Y0, Zp => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : MI41A) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph MI41A := SimpleGraph.fromRel o

lemma adj_iff (u v : MI41A) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : MI41A) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : MI41A) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : MI41A) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : MI41A → Option MI41A
  | Y0 => none
  | Y1 => some Y0
  | Y2 => some Y1
  | Xx => some Y1
  | Zz => some Y0
  | Zp => some Y0

/-- The height. -/
def ht : MI41A → ℕ
  | Y0 => 0
  | Y1 => 1
  | Y2 => 2
  | Xx => 2
  | Zz => 1
  | Zp => 1

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

