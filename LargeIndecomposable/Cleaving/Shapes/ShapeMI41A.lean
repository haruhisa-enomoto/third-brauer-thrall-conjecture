/-- **No cleaving diagram `MI41A` in `P/τ`.** -/
theorem MildHyp.not_mi41a (hM : MildHyp k P)
    {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {OY0 OY1 OY2 OX OZ OZp : P}
    (a₁ : OY0 ⟶ OY1) (a₂ : OY1 ⟶ OY2) (μ : OX ⟶ OY1) (t₁ : OY0 ⟶ OZ) (t₂ : OY0 ⟶ OZp)
    (h0_Y0_Y1 : ¬FactorsThroughMorphism τ (a₁))
    (h0_Y0_Y2 : ¬FactorsThroughMorphism τ (a₁ ≫ a₂))
    (h0_Y0_Zz : ¬FactorsThroughMorphism τ (t₁))
    (h0_Y0_Zp : ¬FactorsThroughMorphism τ (t₂))
    (h0_Y1_Y2 : ¬FactorsThroughMorphism τ (a₂))
    (h0_Xx_Y1 : ¬FactorsThroughMorphism τ (μ))
    (h0_Xx_Y2 : ¬FactorsThroughMorphism τ (μ ≫ a₂))
    (hi_a₁ : ¬IsIso a₁)
    (hi_a₂ : ¬IsIso a₂)
    (hi_μ : ¬IsIso μ)
    (hi_t₁ : ¬IsIso t₁)
    (hi_t₂ : ¬IsIso t₂)
    (hl_a₁_t₁_Zz : ¬∃ g, a₁ ≫ g = t₁)
    (hl_a₁_t₂_Zp : ¬∃ g, a₁ ≫ g = t₂)
    (hl_t₁_a₁_Y1 : ¬∃ g, t₁ ≫ g = a₁)
    (hl_t₁_a₁_Y2 : ¬∃ g, t₁ ≫ g = a₁ ≫ a₂)
    (hl_t₁_t₂_Zp : ¬∃ g, t₁ ≫ g = t₂)
    (hl_t₂_a₁_Y1 : ¬∃ g, t₂ ≫ g = a₁)
    (hl_t₂_a₁_Y2 : ¬∃ g, t₂ ≫ g = a₁ ≫ a₂)
    (hl_t₂_t₁_Zz : ¬∃ g, t₂ ≫ g = t₁)
    (hr_a₁_μ_Xx : ¬∃ g, g ≫ a₁ = μ)
    (hr_μ_a₁_Y0 : ¬∃ g, g ≫ μ = a₁)
    : False := by
  haveI : Fact (LargeIndecomposable.Foundations.Quiver.IsAcyclic (OT G o)) := ⟨OT.isAcyclic ho hasym isAcyclic⟩
  refine hM.not_tree_table τ hτ hτ0 G o ho hasym isAcyclic
    (OT.not_isRepresentationFinite_affineD ho hcov k 1 copy) obj (arr a₁ a₂ μ t₁ t₂)
    (tab a₁ a₂ μ t₁ t₂) (fun v ↦ by cases v <;> rfl) ?_ ?_ ?_ ?_ ?_
  · intro x y z h f hf
    cases y <;> cases z <;> (try exact absurd h (by decide)) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; rfl)
      | rfl
  · intro x y f hf hne
    cases x <;> cases y <;> (try exact absurd rfl hne) <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;> assumption
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | assumption
  · intro x c c' y h h' f hne hf
    cases x <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases y <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.comp_id]; assumption)
      | assumption
  · intro x c c' y h h' f hne hf
    cases y <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; assumption)
      | assumption

