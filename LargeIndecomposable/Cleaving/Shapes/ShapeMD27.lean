/-!
# The thin diagram `MD27`

[mild] figure 2.7: the contour square `x → a → y`, `x → b → y` with `b → x' → b'` (`η`, `δ`) and `a' → y' → a` (`α`, `ω'`).

Generated by `scripts/gen_thin_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `MD27`. -/
inductive MD27
  | Xp | A | B | Y | Xm | Bp | Yp | Ap
  deriving DecidableEq

namespace MD27

instance : Fintype MD27 := ⟨{Xp, A, B, Y, Xm, Bp, Yp, Ap}, by intro v; cases v <;> simp⟩

/-- The order (nonzero morphisms). -/
def leb : MD27 → MD27 → Bool
  | A, A | A, Y | Ap, A | Ap, Ap | Ap, Y | Ap, Yp | B, B | B, Bp | B, Xm | B, Y | Bp, Bp | Xm, Bp | Xm, Xm | Xp, A | Xp, B | Xp, Bp | Xp, Xm | Xp, Xp | Xp, Y | Y, Y | Yp, A | Yp, Y | Yp, Yp => true
  | _, _ => false

/-- The arrows. -/
def arb : MD27 → MD27 → Bool
  | A, Y | Ap, Yp | B, Xm | B, Y | Xm, Bp | Xp, A | Xp, B | Yp, A => true
  | _, _ => false

/-- The thin category. -/
abbrev thin : ThinData MD27 where
  le x y := leb x y = true
  nz x _ z := leb x z = true
  refl x := by cases x <;> rfl
  antisymm := by decide
  nz_le _ _ _ _ _ h := h
  nz_left _ _ h := h
  nz_right _ _ h := h
  assoc := by decide

/-- The generating arrows. -/
abbrev arrows : ThinArrows thin where
  ar x y := arb x y = true
  ar_le := by decide
  ar_ne := by decide
  first := by decide
  last := by decide

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {OXp OA OB OY OX OBp OYp OAp : P}
  (γ : OXp ⟶ OA) (δ : OXp ⟶ OB) (α : OA ⟶ OY) (β : OB ⟶ OY) (η : OB ⟶ OX) (δ₂ : OX ⟶ OBp) (ω : OYp ⟶ OA) (α₂ : OAp ⟶ OYp)

/-- The objects. -/
abbrev obj : MD27 → P
  | Xp => OXp | A => OA | B => OB | Y => OY | Xm => OX | Bp => OBp | Yp => OYp | Ap => OAp

/-- The morphisms. -/
abbrev tab : ∀ u v : MD27, (obj (OXp := OXp) (OA := OA) (OB := OB) (OY := OY) (OX := OX) (OBp := OBp) (OYp := OYp) (OAp := OAp) u) ⟶ obj (OXp := OXp) (OA := OA) (OB := OB) (OY := OY) (OX := OX) (OBp := OBp) (OYp := OYp) (OAp := OAp) v
  | A, A => 𝟙 _
  | A, Y => α
  | Ap, A => α₂ ≫ ω
  | Ap, Ap => 𝟙 _
  | Ap, Y => (α₂ ≫ ω) ≫ α
  | Ap, Yp => α₂
  | B, B => 𝟙 _
  | B, Bp => η ≫ δ₂
  | B, Xm => η
  | B, Y => β
  | Bp, Bp => 𝟙 _
  | Xm, Bp => δ₂
  | Xm, Xm => 𝟙 _
  | Xp, A => γ
  | Xp, B => δ
  | Xp, Bp => (δ ≫ η) ≫ δ₂
  | Xp, Xm => δ ≫ η
  | Xp, Xp => 𝟙 _
  | Xp, Y => γ ≫ α
  | Y, Y => 𝟙 _
  | Yp, A => ω
  | Yp, Y => ω ≫ α
  | Yp, Yp => 𝟙 _
  | _, _ => 0

end Diagram

end MD27

