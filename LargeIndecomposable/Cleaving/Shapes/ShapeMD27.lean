open RayQuiver

namespace RayCat

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type*} [Field k] [Infinite k]

set_option maxHeartbeats 16000000 in
open MD27 in
/-- **No cleaving diagram `MD27` in `P/τ`.** -/
theorem MildHyp.not_md27 (hM : MildHyp k P) {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {OXp OA OB OY OX OBp OYp OAp : P}
    (γ : OXp ⟶ OA) (δ : OXp ⟶ OB) (α : OA ⟶ OY) (β : OB ⟶ OY) (η : OB ⟶ OX) (δ₂ : OX ⟶ OBp) (ω : OYp ⟶ OA) (α₂ : OAp ⟶ OYp)
    (hD : ¬Statement.IsRepresentationFinite (Linearization (ThinCat thin) k))
    (hc0 : δ ≫ β = γ ≫ α)
    (h0_A_Y : ¬FactorsThroughMorphism τ (α))
    (h0_Ap_A : ¬FactorsThroughMorphism τ (α₂ ≫ ω))
    (h0_Ap_Y : ¬FactorsThroughMorphism τ ((α₂ ≫ ω) ≫ α))
    (h0_Ap_Yp : ¬FactorsThroughMorphism τ (α₂))
    (h0_B_Bp : ¬FactorsThroughMorphism τ (η ≫ δ₂))
    (h0_B_Xm : ¬FactorsThroughMorphism τ (η))
    (h0_B_Y : ¬FactorsThroughMorphism τ (β))
    (h0_Xm_Bp : ¬FactorsThroughMorphism τ (δ₂))
    (h0_Xp_A : ¬FactorsThroughMorphism τ (γ))
    (h0_Xp_B : ¬FactorsThroughMorphism τ (δ))
    (h0_Xp_Bp : ¬FactorsThroughMorphism τ ((δ ≫ η) ≫ δ₂))
    (h0_Xp_Xm : ¬FactorsThroughMorphism τ (δ ≫ η))
    (h0_Xp_Y : ¬FactorsThroughMorphism τ (γ ≫ α))
    (h0_Yp_A : ¬FactorsThroughMorphism τ (ω))
    (h0_Yp_Y : ¬FactorsThroughMorphism τ (ω ≫ α))
    (hi_γ : ¬IsIso γ)
    (hi_δ : ¬IsIso δ)
    (hi_α : ¬IsIso α)
    (hi_β : ¬IsIso β)
    (hi_η : ¬IsIso η)
    (hi_δ₂ : ¬IsIso δ₂)
    (hi_ω : ¬IsIso ω)
    (hi_α₂ : ¬IsIso α₂)
    (hlft_B_Xm_Y : ¬∃ g, η ≫ g = β)
    (hlft_B_Y_Xm : ¬∃ g, β ≫ g = η)
    (hlft_B_Y_Bp : ¬∃ g, β ≫ g = η ≫ δ₂)
    (hlft_Xp_A_B : ¬∃ g, γ ≫ g = δ)
    (hlft_Xp_A_Xm : ¬∃ g, γ ≫ g = δ ≫ η)
    (hlft_Xp_A_Bp : ¬∃ g, γ ≫ g = (δ ≫ η) ≫ δ₂)
    (hlft_Xp_B_A : ¬∃ g, δ ≫ g = γ)
    (hrgt_B_A_Y : ¬∃ g, g ≫ α = β)
    (hrgt_A_B_Y : ¬∃ g, g ≫ β = α)
    (hrgt_Yp_B_Y : ¬∃ g, g ≫ β = ω ≫ α)
    (hrgt_Ap_B_Y : ¬∃ g, g ≫ β = (α₂ ≫ ω) ≫ α)
    (hrgt_Yp_Xp_A : ¬∃ g, g ≫ γ = ω)
    (hrgt_Ap_Xp_A : ¬∃ g, g ≫ γ = α₂ ≫ ω)
    (hrgt_Xp_Yp_A : ¬∃ g, g ≫ ω = γ)
    : False := by
  have hlft_A_Y_A : ¬∃ g, α ≫ g = 𝟙 _ := not_split_mono hi_α
  have hlft_Ap_Yp_Ap : ¬∃ g, α₂ ≫ g = 𝟙 _ := not_split_mono hi_α₂
  have hlft_B_Xm_B : ¬∃ g, η ≫ g = 𝟙 _ := not_split_mono hi_η
  have hlft_B_Y_B : ¬∃ g, β ≫ g = 𝟙 _ := not_split_mono hi_β
  have hlft_Xm_Bp_Xm : ¬∃ g, δ₂ ≫ g = 𝟙 _ := not_split_mono hi_δ₂
  have hlft_Xp_A_Xp : ¬∃ g, γ ≫ g = 𝟙 _ := not_split_mono hi_γ
  have hlft_Xp_B_Xp : ¬∃ g, δ ≫ g = 𝟙 _ := not_split_mono hi_δ
  have hlft_Yp_A_Yp : ¬∃ g, ω ≫ g = 𝟙 _ := not_split_mono hi_ω
  have hrgt_Y_A_Y : ¬∃ g, g ≫ α = 𝟙 _ := not_split_epi hi_α
  have hrgt_Yp_Ap_Yp : ¬∃ g, g ≫ α₂ = 𝟙 _ := not_split_epi hi_α₂
  have hrgt_Xm_B_Xm : ¬∃ g, g ≫ η = 𝟙 _ := not_split_epi hi_η
  have hrgt_Y_B_Y : ¬∃ g, g ≫ β = 𝟙 _ := not_split_epi hi_β
  have hrgt_Bp_Xm_Bp : ¬∃ g, g ≫ δ₂ = 𝟙 _ := not_split_epi hi_δ₂
  have hrgt_A_Xp_A : ¬∃ g, g ≫ γ = 𝟙 _ := not_split_epi hi_γ
  have hrgt_B_Xp_B : ¬∃ g, g ≫ δ = 𝟙 _ := not_split_epi hi_δ
  have hrgt_A_Yp_A : ¬∃ g, g ≫ ω = 𝟙 _ := not_split_epi hi_ω
  have hc0' := reassoc_of% hc0
  refine hM.not_thin_diagram τ hτ hτ0 hD arrows obj (fun x y _ ↦ tab γ δ α β η δ₂ ω α₂ x y)
    (fun x ↦ by cases x <;> rfl) ?_ ?_ ?_ ?_
  · intro x y z h h'
    cases x <;> cases y <;> (try exact absurd h (by decide)) <;> cases z <;>
      (try exact absurd h' (by decide)) <;> split_ifs with hn <;>
      (try exact absurd hn (by decide)) <;>
      simp only [tab, Category.assoc, Category.id_comp, Category.comp_id, zero_comp, comp_zero, hc0', hc0]
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | exact not_factorsThrough_id hτ _
      | assumption
  · intro x z y ha hy
    cases x <;> cases z <;> (try exact absurd ha (by decide)) <;> cases y <;>
      (try exact absurd hy (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›
  · intro x z y ha hx
    cases z <;> cases y <;> (try exact absurd ha (by decide)) <;> cases x <;>
      (try exact absurd hx (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›

end RayCat

