  (w₁ : X ⟶ Bb) (ψ : X ⟶ M) (w₂ : Bb ⟶ Y₀) (U : M ⟶ Y₀) (r : X' ⟶ Bb) (v : X ⟶ B') (t : X'' ⟶ M)

/-- The objects. -/
abbrev obj : F610 → P
  | x => X | b => Bb | m => M | y₀ => Y₀ | x' => X' | b' => B' | x'' => X''

/-- The morphisms. -/
abbrev tab : ∀ u v : F610, (obj (X := X) (Bb := Bb) (M := M) (Y₀ := Y₀) (X' := X') (B' := B') (X'' := X'') u) ⟶ obj (X := X) (Bb := Bb) (M := M) (Y₀ := Y₀) (X' := X') (B' := B') (X'' := X'') v
  | b, b => 𝟙 _
  | b, y₀ => w₂
  | b', b' => 𝟙 _
  | m, m => 𝟙 _
  | m, y₀ => U
  | x, b => w₁
  | x, b' => v
  | x, m => ψ
  | x, x => 𝟙 _
  | x, y₀ => w₁ ≫ w₂
  | x', b => r
  | x', x' => 𝟙 _
  | x', y₀ => r ≫ w₂
  | x'', m => t
  | x'', x'' => 𝟙 _
  | x'', y₀ => t ≫ U
  | y₀, y₀ => 𝟙 _
