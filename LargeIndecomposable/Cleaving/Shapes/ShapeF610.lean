namespace RayCat

/-- Vertices of the diagram `F610`. -/
inductive F610
  | x | b | m | y₀ | x' | b' | x''
  deriving DecidableEq

namespace F610

instance : Fintype F610 := ⟨{x, b, m, y₀, x', b', x''}, by intro v; cases v <;> simp⟩

/-- The order (nonzero morphisms). -/
def leb : F610 → F610 → Bool
  | b, b | b, y₀ | b', b' | m, m | m, y₀ | x, b | x, b' | x, m | x, x | x, y₀ | x', b | x', x' | x', y₀ | x'', m | x'', x'' | x'', y₀ | y₀, y₀ => true
  | _, _ => false

/-- The arrows. -/
def arb : F610 → F610 → Bool
  | b, y₀ | m, y₀ | x, b | x, b' | x, m | x', b | x'', m => true
  | _, _ => false

/-- The thin category. -/
abbrev thin : ThinData F610 where
  le x y := leb x y = true
  nz x _ z := leb x z = true
  refl x := by cases x <;> rfl
  antisymm := by decide
  nz_le _ _ _ _ _ h := h
  nz_left _ _ h := h
  nz_right _ _ h := h
  assoc := by decide

/-- The generating arrows. -/
abbrev arrows : ThinArrows thin where
  ar x y := arb x y = true
  ar_le := by decide
  ar_ne := by decide
  first := by decide
  last := by decide

