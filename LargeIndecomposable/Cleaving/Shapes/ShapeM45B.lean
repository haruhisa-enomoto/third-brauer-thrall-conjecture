/-- Vertices of the diagram `M45B`. -/
inductive M45B
  | A | Bb | B | X1 | Cc | W | G
  deriving DecidableEq

namespace M45B

instance : Fintype M45B := ⟨{A, Bb, B, X1, Cc, W, G}, by intro v; cases v <;> simp⟩

/-- The order (nonzero morphisms). -/
def leb : M45B → M45B → Bool
  | A, A | A, B | A, Bb | A, Cc | A, W | A, X1 | B, B | B, W | Bb, Bb | Cc, Cc | G, B | G, G | G, W | W, W | X1, Cc | X1, W | X1, X1 => true
  | _, _ => false

/-- The arrows. -/
def arb : M45B → M45B → Bool
  | A, B | A, Bb | A, X1 | B, W | G, B | X1, Cc | X1, W => true
  | _, _ => false

/-- The thin category. -/
abbrev thin : ThinData M45B where
  le x y := leb x y = true
  nz x _ z := leb x z = true
  refl x := by cases x <;> rfl
  antisymm := by decide
  nz_le _ _ _ _ _ h := h
  nz_left _ _ h := h
  nz_right _ _ h := h
  assoc := by decide

/-- The generating arrows. -/
abbrev arrows : ThinArrows thin where
  ar x y := arb x y = true
  ar_le := by decide
  ar_ne := by decide
  first := by decide
  last := by decide

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {XA XBb XB XX1 XCc XW XG : P}
  (ε : XA ⟶ XBb) (ρ : XA ⟶ XB) (a : XA ⟶ XX1) (γ : XX1 ⟶ XCc) (β : XX1 ⟶ XW) (ρ' : XB ⟶ XW) (β' : XG ⟶ XB)

/-- The objects. -/
abbrev obj : M45B → P
  | A => XA | Bb => XBb | B => XB | X1 => XX1 | Cc => XCc | W => XW | G => XG

/-- The morphisms. -/
abbrev tab : ∀ u v : M45B, (obj (XA := XA) (XBb := XBb) (XB := XB) (XX1 := XX1) (XCc := XCc) (XW := XW) (XG := XG) u) ⟶ obj (XA := XA) (XBb := XBb) (XB := XB) (XX1 := XX1) (XCc := XCc) (XW := XW) (XG := XG) v
  | A, A => 𝟙 _
  | A, B => ρ
  | A, Bb => ε
  | A, Cc => a ≫ γ
  | A, W => ρ ≫ ρ'
  | A, X1 => a
  | B, B => 𝟙 _
  | B, W => ρ'
  | Bb, Bb => 𝟙 _
  | Cc, Cc => 𝟙 _
  | G, B => β'
  | G, G => 𝟙 _
  | G, W => β' ≫ ρ'
  | W, W => 𝟙 _
  | X1, Cc => γ
  | X1, W => β
  | X1, X1 => 𝟙 _
  | _, _ => 0

end Diagram

