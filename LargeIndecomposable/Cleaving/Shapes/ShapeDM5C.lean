/-!
# The tree diagram `DM5C`

`D̃₅` with spine `a → c`: `x → a → y` at `a` and two arrows out of `c` ([mild] figure 4.9, first diagram).

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `DM5C`. -/
inductive DM5C
  | A | Cc | Xx | Yy | X2 | Z
  deriving DecidableEq

namespace DM5C

instance : Fintype DM5C := ⟨{A, Cc, Xx, Yy, X2, Z}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : DM5C → DM5C → Bool
  | Xx, A | A, Yy | A, Cc | Cc, X2 | Cc, Z => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : DM5C) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph DM5C := SimpleGraph.fromRel o

lemma adj_iff (u v : DM5C) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : DM5C) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : DM5C) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : DM5C) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : DM5C → Option DM5C
  | A => none
  | Cc => some A
  | Xx => some A
  | Yy => some A
  | X2 => some Cc
  | Z => some Cc

/-- The height. -/
def ht : DM5C → ℕ
  | A => 0
  | Cc => 1
  | Xx => 1
  | Yy => 1
  | X2 => 2
  | Z => 2

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `D̃`. -/
def cmap : AffineD 1 → DM5C
  | .spine j => if (j : ℕ) = 0 then A else Cc
  | .leaf i => if (i : ℕ) = 0 then Xx else if (i : ℕ) = 1 then Yy else if (i : ℕ) = 2 then X2 else Z

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `D̃`. -/
def copy : (underlyingGraph (AffineD 1)).Copy G :=
  copyD G 1 cmap (by
    intro u v h
    rcases u with i | j <;> rcases v with i' | j'
    · fin_cases i <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases i <;> fin_cases j' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases j' <;> simp_all [cmap])
    (fun i ↦ by
      fin_cases i
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide)
    (fun j j' h ↦ by fin_cases j <;> fin_cases j' <;> simp_all [cmap] <;> decide)

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {OA OCc OXx OYy OX2 OZ : P}
  (γ : OXx ⟶ OA) (α : OA ⟶ OYy) (η₁ : OA ⟶ OCc) (η₂ : OCc ⟶ OX2) (φ : OCc ⟶ OZ)

/-- The objects. -/
def obj : DM5C → P
  | A => OA | Cc => OCc | Xx => OXx | Yy => OYy | X2 => OX2 | Z => OZ

/-- The arrows. -/
def arr : ∀ u v : DM5C, o u v → ((obj (OA := OA) (OCc := OCc) (OXx := OXx) (OYy := OYy) (OX2 := OX2) (OZ := OZ) u) ⟶ obj (OA := OA) (OCc := OCc) (OXx := OXx) (OYy := OYy) (OX2 := OX2) (OZ := OZ) v)
  | Xx, A, _ => γ
  | A, Yy, _ => α
  | A, Cc, _ => η₁
  | Cc, X2, _ => η₂
  | Cc, Z, _ => φ
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : DM5C, Option ((obj (OA := OA) (OCc := OCc) (OXx := OXx) (OYy := OYy) (OX2 := OX2) (OZ := OZ) u) ⟶ obj (OA := OA) (OCc := OCc) (OXx := OXx) (OYy := OYy) (OX2 := OX2) (OZ := OZ) v)
  | A, A => some (𝟙 _)
  | A, Yy => some (α)
  | A, Cc => some (η₁)
  | A, X2 => some (η₁ ≫ η₂)
  | A, Z => some (η₁ ≫ φ)
  | Cc, Cc => some (𝟙 _)
  | Cc, X2 => some (η₂)
  | Cc, Z => some (φ)
  | Xx, Xx => some (𝟙 _)
  | Xx, A => some (γ)
  | Xx, Yy => some (γ ≫ α)
  | Xx, Cc => some (γ ≫ η₁)
  | Xx, X2 => some ((γ ≫ η₁) ≫ η₂)
  | Xx, Z => some ((γ ≫ η₁) ≫ φ)
  | Yy, Yy => some (𝟙 _)
  | X2, X2 => some (𝟙 _)
  | Z, Z => some (𝟙 _)
  | _, _ => none

end Diagram

end DM5C

end RayCat

namespace RayCat

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type u} [Field k] [Infinite k]

set_option maxHeartbeats 8000000 in
open DM5C in
/-- **No cleaving diagram `DM5C` in `P/τ`.** -/
theorem MildHyp.not_dm5c (hM : MildHyp k P)
    {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {OA OCc OXx OYy OX2 OZ : P}
    (γ : OXx ⟶ OA) (α : OA ⟶ OYy) (η₁ : OA ⟶ OCc) (η₂ : OCc ⟶ OX2) (φ : OCc ⟶ OZ)
    (h0_A_Yy : ¬FactorsThroughMorphism τ (α))
    (h0_A_Cc : ¬FactorsThroughMorphism τ (η₁))
    (h0_A_X2 : ¬FactorsThroughMorphism τ (η₁ ≫ η₂))
    (h0_A_Z : ¬FactorsThroughMorphism τ (η₁ ≫ φ))
    (h0_Cc_X2 : ¬FactorsThroughMorphism τ (η₂))
    (h0_Cc_Z : ¬FactorsThroughMorphism τ (φ))
    (h0_Xx_A : ¬FactorsThroughMorphism τ (γ))
    (h0_Xx_Yy : ¬FactorsThroughMorphism τ (γ ≫ α))
    (h0_Xx_Cc : ¬FactorsThroughMorphism τ (γ ≫ η₁))
    (h0_Xx_X2 : ¬FactorsThroughMorphism τ ((γ ≫ η₁) ≫ η₂))
    (h0_Xx_Z : ¬FactorsThroughMorphism τ ((γ ≫ η₁) ≫ φ))
    (hi_γ : ¬IsIso γ)
    (hi_α : ¬IsIso α)
    (hi_η₁ : ¬IsIso η₁)
    (hi_η₂ : ¬IsIso η₂)
    (hi_φ : ¬IsIso φ)
    (hl_α_η₁_Cc : ¬∃ g, α ≫ g = η₁)
    (hl_α_η₁_X2 : ¬∃ g, α ≫ g = η₁ ≫ η₂)
    (hl_α_η₁_Z : ¬∃ g, α ≫ g = η₁ ≫ φ)
    (hl_η₁_α_Yy : ¬∃ g, η₁ ≫ g = α)
    (hl_η₂_φ_Z : ¬∃ g, η₂ ≫ g = φ)
    (hl_φ_η₂_X2 : ¬∃ g, φ ≫ g = η₂)
    : False := by
  haveI : Fact (LargeIndecomposable.Foundations.Quiver.IsAcyclic (OT G o)) := ⟨OT.isAcyclic ho hasym isAcyclic⟩
  refine hM.not_tree_table τ hτ hτ0 G o ho hasym isAcyclic
    (OT.not_isRepresentationFinite_affineD ho hcov k 1 copy) obj (arr γ α η₁ η₂ φ)
    (tab γ α η₁ η₂ φ) (fun v ↦ by cases v <;> rfl) ?_ ?_ ?_ ?_ ?_
  · intro x y z h f hf
    cases y <;> cases z <;> (try exact absurd h (by decide)) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; rfl)
      | rfl
  · intro x y f hf hne
    cases x <;> cases y <;> (try exact absurd rfl hne) <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;> assumption
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | assumption
  · intro x c c' y h h' f hne hf
    cases x <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases y <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.comp_id]; assumption)
      | assumption
  · intro x c c' y h h' f hne hf
    cases y <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; assumption)
      | assumption

end RayCat

