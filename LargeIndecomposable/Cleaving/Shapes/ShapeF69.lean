/-- **No cleaving diagram `F69` in `P/τ`.** -/
theorem not_f69
    (hmin : ∀ I : TwoSidedIdeal A, I ≠ ⊥ → Statement.IsRepresentationFinite (A ⧸ I.asIdeal))
    (hL : LeftCancel P) (hR : RightCancel P) {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {Y₀ X' Cc Bb M Y₁ B' C' X'' : P}
    (r : X' ⟶ Bb) (a : Cc ⟶ Bb) (W : Bb ⟶ Y₀) (U : M ⟶ Y₀) (U' : M ⟶ Y₁) (W' : B' ⟶ Y₁) (a' : C' ⟶ B') (t : X'' ⟶ B')
    (h0_x'_b : ¬FactorsThroughMorphism τ (r))
    (h0_x'_y₀ : ¬FactorsThroughMorphism τ (r ≫ W))
    (h0_c_b : ¬FactorsThroughMorphism τ (a))
    (h0_c_y₀ : ¬FactorsThroughMorphism τ (a ≫ W))
    (h0_b_y₀ : ¬FactorsThroughMorphism τ (W))
    (h0_m_y₀ : ¬FactorsThroughMorphism τ (U))
    (h0_m_y₁ : ¬FactorsThroughMorphism τ (U'))
    (h0_b'_y₁ : ¬FactorsThroughMorphism τ (W'))
    (h0_c'_b' : ¬FactorsThroughMorphism τ (a'))
    (h0_c'_y₁ : ¬FactorsThroughMorphism τ (a' ≫ W'))
    (h0_x''_b' : ¬FactorsThroughMorphism τ (t))
    (h0_x''_y₁ : ¬FactorsThroughMorphism τ (t ≫ W'))
    (hi_r : ¬IsIso r)
    (hi_a : ¬IsIso a)
    (hi_W : ¬IsIso W)
    (hi_U : ¬IsIso U)
    (hi_U' : ¬IsIso U')
    (hi_W' : ¬IsIso W')
    (hi_a' : ¬IsIso a')
    (hi_t : ¬IsIso t)
    (hl_U_U'_y₁ : ¬∃ g, U ≫ g = U')
    (hl_U'_U_y₀ : ¬∃ g, U' ≫ g = U)
    (hr_W_U_m : ¬∃ g, g ≫ W = U)
    (hr_U_W_x' : ¬∃ g, g ≫ U = r ≫ W)
    (hr_U_W_c : ¬∃ g, g ≫ U = a ≫ W)
    (hr_U_W_b : ¬∃ g, g ≫ U = W)
    (hr_r_a_c : ¬∃ g, g ≫ r = a)
    (hr_a_r_x' : ¬∃ g, g ≫ a = r)
    (hr_U'_W'_b' : ¬∃ g, g ≫ U' = W')
    (hr_U'_W'_c' : ¬∃ g, g ≫ U' = a' ≫ W')
    (hr_U'_W'_x'' : ¬∃ g, g ≫ U' = t ≫ W')
    (hr_W'_U'_m : ¬∃ g, g ≫ W' = U')
    (hr_a'_t_x'' : ¬∃ g, g ≫ a' = t)
    (hr_t_a'_c' : ¬∃ g, g ≫ t = a')
    : False := by
  haveI : Fact (LargeIndecomposable.Foundations.Quiver.IsAcyclic (OT G o)) := ⟨OT.isAcyclic ho hasym isAcyclic⟩
  refine B.not_tree_table hmin hL hR τ hτ hτ0 G o ho hasym isAcyclic
    (OT.not_isRepresentationFinite_affineD ho hcov k 4 copy) obj (arr r a W U U' W' a' t)
    (tab r a W U U' W' a' t) (fun v ↦ by cases v <;> rfl) ?_ ?_ ?_ ?_ ?_
  · intro x y z h f hf
    cases y <;> cases z <;> (try exact absurd h (by decide)) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; rfl)
      | rfl
  · intro x y f hf hne
    cases x <;> cases y <;> (try exact absurd rfl hne) <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;> assumption
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | assumption
  · intro x c c' y h h' f hne hf
    cases x <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases y <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.comp_id]; assumption)
      | assumption
  · intro x c c' y h h' f hne hf
    cases y <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; assumption)
      | assumption

