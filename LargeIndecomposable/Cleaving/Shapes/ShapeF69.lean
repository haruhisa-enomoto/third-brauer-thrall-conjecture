/-!
# The tree diagram `F69`

BO13a figure 6.9: the `D̃₈` tree `x' → b ← c`, `b → y₀ ← m → y₁ ← b'`, `c' → b' ← x''`.

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `F69`. -/
inductive F69
  | y₀ | x' | c | b | m | y₁ | b' | c' | x''
  deriving DecidableEq

namespace F69

instance : Fintype F69 := ⟨{y₀, x', c, b, m, y₁, b', c', x''}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : F69 → F69 → Bool
  | x', b | c, b | b, y₀ | m, y₀ | m, y₁ | b', y₁ | c', b' | x'', b' => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : F69) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph F69 := SimpleGraph.fromRel o

lemma adj_iff (u v : F69) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : F69) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : F69) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : F69) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : F69 → Option F69
  | y₀ => none
  | x' => some b
  | c => some b
  | b => some y₀
  | m => some y₀
  | y₁ => some m
  | b' => some y₁
  | c' => some b'
  | x'' => some b'

/-- The height. -/
def ht : F69 → ℕ
  | y₀ => 0
  | x' => 2
  | c => 2
  | b => 1
  | m => 1
  | y₁ => 2
  | b' => 3
  | c' => 4
  | x'' => 4

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `D̃`. -/
def cmap : AffineD 4 → F69
  | .spine j => if (j : ℕ) = 0 then b else if (j : ℕ) = 1 then y₀ else if (j : ℕ) = 2 then m else if (j : ℕ) = 3 then y₁ else b'
  | .leaf i => if (i : ℕ) = 0 then x' else if (i : ℕ) = 1 then c else if (i : ℕ) = 2 then c' else x''

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `D̃`. -/
def copy : (underlyingGraph (AffineD 4)).Copy G :=
  copyD G 4 cmap (by
    intro u v h
    rcases u with i | j <;> rcases v with i' | j'
    · fin_cases i <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases i <;> fin_cases j' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases j' <;> simp_all [cmap])
    (fun i ↦ by
      fin_cases i
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide)
    (fun j j' h ↦ by fin_cases j <;> fin_cases j' <;> simp_all [cmap] <;> decide)

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {Y₀ X' Cc Bb M Y₁ B' C' X'' : P}
  (r : X' ⟶ Bb) (a : Cc ⟶ Bb) (W : Bb ⟶ Y₀) (U : M ⟶ Y₀) (U' : M ⟶ Y₁) (W' : B' ⟶ Y₁) (a' : C' ⟶ B') (t : X'' ⟶ B')

/-- The objects. -/
def obj : F69 → P
  | y₀ => Y₀ | x' => X' | c => Cc | b => Bb | m => M | y₁ => Y₁ | b' => B' | c' => C' | x'' => X''

/-- The arrows. -/
def arr : ∀ u v : F69, o u v → ((obj (Y₀ := Y₀) (X' := X') (Cc := Cc) (Bb := Bb) (M := M) (Y₁ := Y₁) (B' := B') (C' := C') (X'' := X'') u) ⟶ obj (Y₀ := Y₀) (X' := X') (Cc := Cc) (Bb := Bb) (M := M) (Y₁ := Y₁) (B' := B') (C' := C') (X'' := X'') v)
  | x', b, _ => r
  | c, b, _ => a
  | b, y₀, _ => W
  | m, y₀, _ => U
  | m, y₁, _ => U'
  | b', y₁, _ => W'
  | c', b', _ => a'
  | x'', b', _ => t
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : F69, Option ((obj (Y₀ := Y₀) (X' := X') (Cc := Cc) (Bb := Bb) (M := M) (Y₁ := Y₁) (B' := B') (C' := C') (X'' := X'') u) ⟶ obj (Y₀ := Y₀) (X' := X') (Cc := Cc) (Bb := Bb) (M := M) (Y₁ := Y₁) (B' := B') (C' := C') (X'' := X'') v)
  | y₀, y₀ => some (𝟙 _)
  | x', x' => some (𝟙 _)
  | x', b => some (r)
  | x', y₀ => some (r ≫ W)
  | c, c => some (𝟙 _)
  | c, b => some (a)
  | c, y₀ => some (a ≫ W)
  | b, b => some (𝟙 _)
  | b, y₀ => some (W)
  | m, m => some (𝟙 _)
  | m, y₀ => some (U)
  | m, y₁ => some (U')
  | y₁, y₁ => some (𝟙 _)
  | b', b' => some (𝟙 _)
  | b', y₁ => some (W')
  | c', c' => some (𝟙 _)
  | c', b' => some (a')
  | c', y₁ => some (a' ≫ W')
  | x'', x'' => some (𝟙 _)
  | x'', b' => some (t)
  | x'', y₁ => some (t ≫ W')
  | _, _ => none

end Diagram

