/-!
# The tree diagram `F89`

BO13a figure 8.9: the `Ẽ₆` tree with centre `a` and arms `a ← x → t₁`, `a ← xn → t₃`, `a ← x₂ → t₂`.

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `F89`. -/
inductive F89
  | a | x | t₁ | xn | t₃ | x₂ | t₂
  deriving DecidableEq

namespace F89

instance : Fintype F89 := ⟨{a, x, t₁, xn, t₃, x₂, t₂}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : F89 → F89 → Bool
  | x, a | x, t₁ | xn, a | xn, t₃ | x₂, a | x₂, t₂ => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : F89) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph F89 := SimpleGraph.fromRel o

lemma adj_iff (u v : F89) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : F89) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : F89) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : F89) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : F89 → Option F89
  | a => none
  | x => some a
  | t₁ => some x
  | xn => some a
  | t₃ => some xn
  | x₂ => some a
  | t₂ => some x₂

/-- The height. -/
def ht : F89 → ℕ
  | a => 0
  | x => 1
  | t₁ => 2
  | xn => 1
  | t₃ => 2
  | x₂ => 1
  | t₂ => 2

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `Ẽ₆`. -/
def cmap : AffineE6 → F89
  | .center => a
  | .inner i => if (i : ℕ) = 0 then x else if (i : ℕ) = 1 then xn else x₂
  | .outer i => if (i : ℕ) = 0 then t₁ else if (i : ℕ) = 1 then t₃ else t₂

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `Ẽ₆`. -/
def copy : (underlyingGraph AffineE6).Copy G :=
  copyOf G cmap (by
    intro u v h
    rcases u with _ | i | i <;> rcases v with _ | j | j <;>
      (try fin_cases i) <;> (try fin_cases j) <;> simp_all [cmap])
    (by
      intro a b e
      rcases a with _ | i | i <;> rcases b with _ | j | j
      all_goals first
        | exact (IsEmpty.false e).elim
        | exact e.elim
        | (obtain rfl : i = j := e.down; fin_cases i <;> simp only [cmap] <;> decide)
        | (fin_cases i <;> simp only [cmap] <;> decide))

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {Aa X T₁ Xn T₃ X₂ T₂ : P}
  (V₁ : X ⟶ Aa) (ψ₁ : X ⟶ T₁) (r : Xn ⟶ Aa) (ψ₃ : Xn ⟶ T₃) (σ₂' : X₂ ⟶ Aa) (ψ₂ : X₂ ⟶ T₂)

/-- The objects. -/
def obj : F89 → P
  | a => Aa | x => X | t₁ => T₁ | xn => Xn | t₃ => T₃ | x₂ => X₂ | t₂ => T₂

/-- The arrows. -/
def arr : ∀ u v : F89, o u v → ((obj (Aa := Aa) (X := X) (T₁ := T₁) (Xn := Xn) (T₃ := T₃) (X₂ := X₂) (T₂ := T₂) u) ⟶ obj (Aa := Aa) (X := X) (T₁ := T₁) (Xn := Xn) (T₃ := T₃) (X₂ := X₂) (T₂ := T₂) v)
  | x, a, _ => V₁
  | x, t₁, _ => ψ₁
  | xn, a, _ => r
  | xn, t₃, _ => ψ₃
  | x₂, a, _ => σ₂'
  | x₂, t₂, _ => ψ₂
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : F89, Option ((obj (Aa := Aa) (X := X) (T₁ := T₁) (Xn := Xn) (T₃ := T₃) (X₂ := X₂) (T₂ := T₂) u) ⟶ obj (Aa := Aa) (X := X) (T₁ := T₁) (Xn := Xn) (T₃ := T₃) (X₂ := X₂) (T₂ := T₂) v)
  | a, a => some (𝟙 _)
  | x, x => some (𝟙 _)
  | x, a => some (V₁)
  | x, t₁ => some (ψ₁)
  | t₁, t₁ => some (𝟙 _)
  | xn, xn => some (𝟙 _)
  | xn, a => some (r)
  | xn, t₃ => some (ψ₃)
  | t₃, t₃ => some (𝟙 _)
  | x₂, x₂ => some (𝟙 _)
  | x₂, a => some (σ₂')
  | x₂, t₂ => some (ψ₂)
  | t₂, t₂ => some (𝟙 _)
  | _, _ => none

end Diagram

