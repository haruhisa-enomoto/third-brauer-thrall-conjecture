public import LargeIndecomposable.Cleaving.Shapes.ShapeD6
public import LargeIndecomposable.Cleaving.Diagrams.Tools

/-!
# The tree diagram `LPF3`

LPF, exit `ε` at `x₁`: `x₀ → x₁ → x₀` along `a₁`, `σ` (the rest of `w`), `ε` at `x₁`; `x₀ → x₁ → x_{n-1}` along `α a₁`, `d = a₂…a_{n-1}`; `x₁ → x_{n-1} → x₀` along `d`, `β`.

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `LPF3`. -/
inductive LPF3
  | X1 | X3 | P0 | P1 | P2 | Q0 | Q2 | E1
  deriving DecidableEq

namespace LPF3

instance : Fintype LPF3 := ⟨{X1, X3, P0, P1, P2, Q0, Q2, E1}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : LPF3 → LPF3 → Bool
  | X1, P1 | X1, P2 | P0, Q0 | P1, X3 | P1, E1 | P2, Q2 | Q0, X3 => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : LPF3) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph LPF3 := SimpleGraph.fromRel o

lemma adj_iff (u v : LPF3) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : LPF3) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : LPF3) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : LPF3) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : LPF3 → Option LPF3
  | X1 => none
  | X3 => some P1
  | P0 => some Q0
  | P1 => some X1
  | P2 => some X1
  | Q0 => some X3
  | Q2 => some P2
  | E1 => some P1

/-- The height. -/
def ht : LPF3 → ℕ
  | X1 => 0
  | X3 => 2
  | P0 => 4
  | P1 => 1
  | P2 => 1
  | Q0 => 3
  | Q2 => 2
  | E1 => 2

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `Ẽ₇` (long arms listed from the centre). -/
def cmap : AffineE7 → LPF3
  | .center => P1
  | .short => E1
  | .inner i => if (i : ℕ) = 0 then X1 else X3
  | .middle i => if (i : ℕ) = 0 then P2 else Q0
  | .outer i => if (i : ℕ) = 0 then Q2 else P0

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `Ẽ₇`. -/
def copy : (underlyingGraph AffineE7).Copy G :=
  copyOf G cmap (by
    intro u v h
    rcases u with _ | _ | i | i | i <;> rcases v with _ | _ | j | j | j <;>
      (try fin_cases i) <;> (try fin_cases j) <;> simp_all [cmap])
    (by
      intro a b e
      change AffineE7.Arrow a b at e
      cases e with
      | outerMiddle i => fin_cases i <;> simp only [cmap] <;> decide
      | middleInner i => fin_cases i <;> simp only [cmap] <;> decide
      | innerCenter i => fin_cases i <;> simp only [cmap] <;> decide
      | shortCenter => simp only [cmap]; decide)

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {OX1 OX3 OP0 OP1 OP2 OQ0 OQ2 OE1 : P}
  (a : OX1 ⟶ OP1) (e : OX1 ⟶ OP2) (d : OP0 ⟶ OQ0) (s : OP1 ⟶ OX3) (ε : OP1 ⟶ OE1) (d' : OP2 ⟶ OQ2) (b : OQ0 ⟶ OX3)

/-- The objects. -/
def obj : LPF3 → P
  | X1 => OX1 | X3 => OX3 | P0 => OP0 | P1 => OP1 | P2 => OP2 | Q0 => OQ0 | Q2 => OQ2 | E1 => OE1

/-- The arrows. -/
def arr : ∀ u v : LPF3, o u v → ((obj (OX1 := OX1) (OX3 := OX3) (OP0 := OP0) (OP1 := OP1) (OP2 := OP2) (OQ0 := OQ0) (OQ2 := OQ2) (OE1 := OE1) u) ⟶ obj (OX1 := OX1) (OX3 := OX3) (OP0 := OP0) (OP1 := OP1) (OP2 := OP2) (OQ0 := OQ0) (OQ2 := OQ2) (OE1 := OE1) v)
  | X1, P1, _ => a
  | X1, P2, _ => e
  | P0, Q0, _ => d
  | P1, X3, _ => s
  | P1, E1, _ => ε
  | P2, Q2, _ => d'
  | Q0, X3, _ => b
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : LPF3, Option ((obj (OX1 := OX1) (OX3 := OX3) (OP0 := OP0) (OP1 := OP1) (OP2 := OP2) (OQ0 := OQ0) (OQ2 := OQ2) (OE1 := OE1) u) ⟶ obj (OX1 := OX1) (OX3 := OX3) (OP0 := OP0) (OP1 := OP1) (OP2 := OP2) (OQ0 := OQ0) (OQ2 := OQ2) (OE1 := OE1) v)
  | X1, X1 => some (𝟙 _)
  | X1, P1 => some (a)
  | X1, X3 => some (a ≫ s)
  | X1, E1 => some (a ≫ ε)
  | X1, P2 => some (e)
  | X1, Q2 => some (e ≫ d')
  | X3, X3 => some (𝟙 _)
  | P0, P0 => some (𝟙 _)
  | P0, Q0 => some (d)
  | P0, X3 => some (d ≫ b)
  | P1, P1 => some (𝟙 _)
  | P1, X3 => some (s)
  | P1, E1 => some (ε)
  | P2, P2 => some (𝟙 _)
  | P2, Q2 => some (d')
  | Q0, Q0 => some (𝟙 _)
  | Q0, X3 => some (b)
  | Q2, Q2 => some (𝟙 _)
  | E1, E1 => some (𝟙 _)
  | _, _ => none

end Diagram

end LPF3

end RayCat

namespace RayCat

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type u} [Field k] [Infinite k]

set_option maxHeartbeats 8000000 in
open LPF3 in
/-- **No cleaving diagram `LPF3` in `P/τ`.** -/
theorem MildHyp.not_lpf3 (hM : MildHyp k P)
    {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {OX1 OX3 OP0 OP1 OP2 OQ0 OQ2 OE1 : P}
    (a : OX1 ⟶ OP1) (e : OX1 ⟶ OP2) (d : OP0 ⟶ OQ0) (s : OP1 ⟶ OX3) (ε : OP1 ⟶ OE1) (d' : OP2 ⟶ OQ2) (b : OQ0 ⟶ OX3)
    (h0_X1_P1 : ¬FactorsThroughMorphism τ (a))
    (h0_X1_X3 : ¬FactorsThroughMorphism τ (a ≫ s))
    (h0_X1_E1 : ¬FactorsThroughMorphism τ (a ≫ ε))
    (h0_X1_P2 : ¬FactorsThroughMorphism τ (e))
    (h0_X1_Q2 : ¬FactorsThroughMorphism τ (e ≫ d'))
    (h0_P0_Q0 : ¬FactorsThroughMorphism τ (d))
    (h0_P0_X3 : ¬FactorsThroughMorphism τ (d ≫ b))
    (h0_P1_X3 : ¬FactorsThroughMorphism τ (s))
    (h0_P1_E1 : ¬FactorsThroughMorphism τ (ε))
    (h0_P2_Q2 : ¬FactorsThroughMorphism τ (d'))
    (h0_Q0_X3 : ¬FactorsThroughMorphism τ (b))
    (hi_a : ¬IsIso a)
    (hi_e : ¬IsIso e)
    (hi_d : ¬IsIso d)
    (hi_s : ¬IsIso s)
    (hi_ε : ¬IsIso ε)
    (hi_d' : ¬IsIso d')
    (hi_b : ¬IsIso b)
    (hl_a_e_P2 : ¬∃ g, a ≫ g = e)
    (hl_a_e_Q2 : ¬∃ g, a ≫ g = e ≫ d')
    (hl_e_a_P1 : ¬∃ g, e ≫ g = a)
    (hl_e_a_X3 : ¬∃ g, e ≫ g = a ≫ s)
    (hl_e_a_E1 : ¬∃ g, e ≫ g = a ≫ ε)
    (hl_s_ε_E1 : ¬∃ g, s ≫ g = ε)
    (hl_ε_s_X3 : ¬∃ g, ε ≫ g = s)
    (hr_s_b_P0 : ¬∃ g, g ≫ s = d ≫ b)
    (hr_s_b_Q0 : ¬∃ g, g ≫ s = b)
    (hr_b_s_X1 : ¬∃ g, g ≫ b = a ≫ s)
    (hr_b_s_P1 : ¬∃ g, g ≫ b = s)
    : False := by
  haveI : Fact (LargeIndecomposable.Foundations.Quiver.IsAcyclic (OT G o)) := ⟨OT.isAcyclic ho hasym isAcyclic⟩
  refine hM.not_tree_table τ hτ hτ0 G o ho hasym isAcyclic
    (OT.not_isRepresentationFinite_affineE7 ho hcov k copy) obj (arr a e d s ε d' b)
    (tab a e d s ε d' b) (fun v ↦ by cases v <;> rfl) ?_ ?_ ?_ ?_ ?_
  · intro x y z h f hf
    cases y <;> cases z <;> (try exact absurd h (by decide)) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; rfl)
      | rfl
  · intro x y f hf hne
    cases x <;> cases y <;> (try exact absurd rfl hne) <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;> assumption
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | assumption
  · intro x c c' y h h' f hne hf
    cases x <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases y <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.comp_id]; assumption)
      | assumption
  · intro x c c' y h h' f hne hf
    cases y <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; assumption)
      | assumption

end RayCat

