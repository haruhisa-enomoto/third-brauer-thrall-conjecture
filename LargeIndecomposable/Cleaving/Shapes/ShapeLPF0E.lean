module

public import LargeIndecomposable.Cleaving.Shapes.ShapeD6
public import LargeIndecomposable.Cleaving.Diagrams.Tools

/-!
# The tree diagram `LPF0E`

LPF, exit `ε` at `x₀` with `ε ≫ ζ = ρ ≫ λ` (`λ` the prefix of `w` to `q`, `D̃₅`): `ρ ≫ a₁, λ, ε` out of `x₀`, `ζ : y → q`, `σ : q → x₀` the rest of `w`.

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `LPF0E`. -/
inductive LPF0E
  | Y1 | X3 | C8 | Q | Y4 | X9
  deriving DecidableEq

namespace LPF0E

instance : Fintype LPF0E := ⟨{Y1, X3, C8, Q, Y4, X9}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : LPF0E → LPF0E → Bool
  | Y1, Q | X3, C8 | X3, Q | X3, Y4 | Q, X9 => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : LPF0E) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph LPF0E := SimpleGraph.fromRel o

lemma adj_iff (u v : LPF0E) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : LPF0E) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : LPF0E) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : LPF0E) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : LPF0E → Option LPF0E
  | Y1 => none
  | X3 => some Q
  | C8 => some X3
  | Q => some Y1
  | Y4 => some X3
  | X9 => some Q

/-- The height. -/
def ht : LPF0E → ℕ
  | Y1 => 0
  | X3 => 2
  | C8 => 3
  | Q => 1
  | Y4 => 3
  | X9 => 2

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `D̃`. -/
def cmap : AffineD 1 → LPF0E
  | .spine j => if (j : ℕ) = 0 then X3 else Q
  | .leaf i => if (i : ℕ) = 0 then C8 else if (i : ℕ) = 1 then Y4 else if (i : ℕ) = 2 then Y1 else X9

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `D̃`. -/
def copy : (underlyingGraph (AffineD 1)).Copy G :=
  copyD G 1 cmap (by
    intro u v h
    rcases u with i | j <;> rcases v with i' | j'
    · fin_cases i <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases i <;> fin_cases j' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases j' <;> simp_all [cmap])
    (fun i ↦ by
      fin_cases i
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide)
    (fun j j' h ↦ by fin_cases j <;> fin_cases j' <;> simp_all [cmap] <;> decide)

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {OY1 OX3 OC8 OQ OY4 OX9 : P}
  (ζ : OY1 ⟶ OQ) (m : OX3 ⟶ OC8) (l : OX3 ⟶ OQ) (ε : OX3 ⟶ OY4) (s : OQ ⟶ OX9)

/-- The objects. -/
def obj : LPF0E → P
  | Y1 => OY1 | X3 => OX3 | C8 => OC8 | Q => OQ | Y4 => OY4 | X9 => OX9

/-- The arrows. -/
def arr : ∀ u v : LPF0E, o u v → ((obj (OY1 := OY1) (OX3 := OX3) (OC8 := OC8) (OQ := OQ) (OY4 := OY4) (OX9 := OX9) u) ⟶ obj (OY1 := OY1) (OX3 := OX3) (OC8 := OC8) (OQ := OQ) (OY4 := OY4) (OX9 := OX9) v)
  | Y1, Q, _ => ζ
  | X3, C8, _ => m
  | X3, Q, _ => l
  | X3, Y4, _ => ε
  | Q, X9, _ => s
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : LPF0E, Option ((obj (OY1 := OY1) (OX3 := OX3) (OC8 := OC8) (OQ := OQ) (OY4 := OY4) (OX9 := OX9) u) ⟶ obj (OY1 := OY1) (OX3 := OX3) (OC8 := OC8) (OQ := OQ) (OY4 := OY4) (OX9 := OX9) v)
  | Y1, Y1 => some (𝟙 _)
  | Y1, Q => some (ζ)
  | Y1, X9 => some (ζ ≫ s)
  | X3, X3 => some (𝟙 _)
  | X3, C8 => some (m)
  | X3, Q => some (l)
  | X3, X9 => some (l ≫ s)
  | X3, Y4 => some (ε)
  | C8, C8 => some (𝟙 _)
  | Q, Q => some (𝟙 _)
  | Q, X9 => some (s)
  | Y4, Y4 => some (𝟙 _)
  | X9, X9 => some (𝟙 _)
  | _, _ => none

end Diagram

end LPF0E

end RayCat

namespace RayCat

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type u} [Field k] [Infinite k]

set_option maxHeartbeats 8000000 in
open LPF0E in
/-- **No cleaving diagram `LPF0E` in `P/τ`.** -/
theorem MildHyp.not_lpf0e (hM : MildHyp k P)
    {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {OY1 OX3 OC8 OQ OY4 OX9 : P}
    (ζ : OY1 ⟶ OQ) (m : OX3 ⟶ OC8) (l : OX3 ⟶ OQ) (ε : OX3 ⟶ OY4) (s : OQ ⟶ OX9)
    (h0_Y1_Q : ¬FactorsThroughMorphism τ (ζ))
    (h0_Y1_X9 : ¬FactorsThroughMorphism τ (ζ ≫ s))
    (h0_X3_C8 : ¬FactorsThroughMorphism τ (m))
    (h0_X3_Q : ¬FactorsThroughMorphism τ (l))
    (h0_X3_X9 : ¬FactorsThroughMorphism τ (l ≫ s))
    (h0_X3_Y4 : ¬FactorsThroughMorphism τ (ε))
    (h0_Q_X9 : ¬FactorsThroughMorphism τ (s))
    (hi_ζ : ¬IsIso ζ)
    (hi_m : ¬IsIso m)
    (hi_l : ¬IsIso l)
    (hi_ε : ¬IsIso ε)
    (hi_s : ¬IsIso s)
    (hl_m_l_Q : ¬∃ g, m ≫ g = l)
    (hl_m_l_X9 : ¬∃ g, m ≫ g = l ≫ s)
    (hl_m_ε_Y4 : ¬∃ g, m ≫ g = ε)
    (hl_l_m_C8 : ¬∃ g, l ≫ g = m)
    (hl_l_ε_Y4 : ¬∃ g, l ≫ g = ε)
    (hl_ε_m_C8 : ¬∃ g, ε ≫ g = m)
    (hl_ε_l_Q : ¬∃ g, ε ≫ g = l)
    (hl_ε_l_X9 : ¬∃ g, ε ≫ g = l ≫ s)
    (hr_ζ_l_X3 : ¬∃ g, g ≫ ζ = l)
    (hr_l_ζ_Y1 : ¬∃ g, g ≫ l = ζ)
    : False := by
  haveI : Fact (LargeIndecomposable.Foundations.Quiver.IsAcyclic (OT G o)) := ⟨OT.isAcyclic ho hasym isAcyclic⟩
  refine hM.not_tree_table τ hτ hτ0 G o ho hasym isAcyclic
    (OT.not_isRepresentationFinite_affineD ho hcov k 1 copy) obj (arr ζ m l ε s)
    (tab ζ m l ε s) (fun v ↦ by cases v <;> rfl) ?_ ?_ ?_ ?_ ?_
  · intro x y z h f hf
    cases y <;> cases z <;> (try exact absurd h (by decide)) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; rfl)
      | rfl
  · intro x y f hf hne
    cases x <;> cases y <;> (try exact absurd rfl hne) <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;> assumption
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | assumption
  · intro x c c' y h h' f hne hf
    cases x <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases y <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.comp_id]; assumption)
      | assumption
  · intro x c c' y h h' f hne hf
    cases y <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; assumption)
      | assumption

end RayCat

end LargeIndecomposable
