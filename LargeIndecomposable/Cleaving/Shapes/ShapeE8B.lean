namespace RayCat

/-- Vertices of the diagram `ME8B`. -/
inductive ME8B
  | xc | z2 | x | z1 | t | z | y | yb | tb
  deriving DecidableEq

namespace ME8B

instance : Fintype ME8B := ⟨{xc, z2, x, z1, t, z, y, yb, tb}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : ME8B → ME8B → Bool
  | xc, x | x, z1 | xc, z2 | xc, t | z, t | z, y | yb, y | tb, yb => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : ME8B) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph ME8B := SimpleGraph.fromRel o

lemma adj_iff (u v : ME8B) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : ME8B) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : ME8B) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : ME8B) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : ME8B → Option ME8B
  | xc => none
  | z2 => some xc
  | x => some xc
  | z1 => some x
  | t => some xc
  | z => some t
  | y => some z
  | yb => some y
  | tb => some yb

/-- The height. -/
def ht : ME8B → ℕ
  | xc => 0
  | z2 => 1
  | x => 1
  | z1 => 2
  | t => 1
  | z => 2
  | y => 3
  | yb => 4
  | tb => 5

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `Ẽ₈` (arms listed from the centre). -/
def cmap : AffineE8 → ME8B
  | .center => xc
  | .short => z2
  | .medium4 => x
  | .medium2 => z1
  | .long5 => t
  | .long4 => z
  | .long3 => y
  | .long2 => yb
  | .long1 => tb

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `Ẽ₈`. -/
def copy : (underlyingGraph AffineE8).Copy G :=
  copyOf G cmap (by
    intro u v h
    cases u <;> cases v <;> simp_all [cmap])
    (by
      intro a b e
      change AffineE8.Arrow a b at e
      cases e <;> simp only [cmap] <;> decide)

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {Xc Z₂ X Z₁ T Z Y Yb Tb : P}
  (ξ : Xc ⟶ X) (γ₁ : X ⟶ Z₁) (γ₂ : Xc ⟶ Z₂) (δ : Xc ⟶ T) (φ : Z ⟶ T) (α : Z ⟶ Y) (ρ : Yb ⟶ Y) (β : Tb ⟶ Yb)

/-- The objects. -/
def obj : ME8B → P
  | xc => Xc | z2 => Z₂ | x => X | z1 => Z₁ | t => T | z => Z | y => Y | yb => Yb | tb => Tb

/-- The arrows. -/
def arr : ∀ u v : ME8B, o u v → ((obj (Xc := Xc) (Z₂ := Z₂) (X := X) (Z₁ := Z₁) (T := T) (Z := Z) (Y := Y) (Yb := Yb) (Tb := Tb) u) ⟶ obj (Xc := Xc) (Z₂ := Z₂) (X := X) (Z₁ := Z₁) (T := T) (Z := Z) (Y := Y) (Yb := Yb) (Tb := Tb) v)
  | xc, x, _ => ξ
  | x, z1, _ => γ₁
  | xc, z2, _ => γ₂
  | xc, t, _ => δ
  | z, t, _ => φ
  | z, y, _ => α
  | yb, y, _ => ρ
  | tb, yb, _ => β
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : ME8B, Option ((obj (Xc := Xc) (Z₂ := Z₂) (X := X) (Z₁ := Z₁) (T := T) (Z := Z) (Y := Y) (Yb := Yb) (Tb := Tb) u) ⟶ obj (Xc := Xc) (Z₂ := Z₂) (X := X) (Z₁ := Z₁) (T := T) (Z := Z) (Y := Y) (Yb := Yb) (Tb := Tb) v)
  | xc, xc => some (𝟙 _)
  | xc, x => some (ξ)
  | xc, z1 => some (ξ ≫ γ₁)
  | xc, z2 => some (γ₂)
  | xc, t => some (δ)
  | z2, z2 => some (𝟙 _)
  | x, x => some (𝟙 _)
  | x, z1 => some (γ₁)
  | z1, z1 => some (𝟙 _)
  | t, t => some (𝟙 _)
  | z, z => some (𝟙 _)
  | z, t => some (φ)
  | z, y => some (α)
  | y, y => some (𝟙 _)
  | yb, yb => some (𝟙 _)
  | yb, y => some (ρ)
  | tb, tb => some (𝟙 _)
