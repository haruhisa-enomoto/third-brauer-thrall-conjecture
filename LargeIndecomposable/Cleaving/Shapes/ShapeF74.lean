namespace RayCat

/-- Vertices of the diagram `F74`. -/
inductive F74
  | x | c | a | m | x₂ | a' | b' | tz
  deriving DecidableEq

namespace F74

instance : Fintype F74 := ⟨{x, c, a, m, x₂, a', b', tz}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : F74 → F74 → Bool
  | x, c | x, a | x, m | x₂, m | x₂, a' | a', b' | a', tz => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : F74) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph F74 := SimpleGraph.fromRel o

lemma adj_iff (u v : F74) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : F74) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : F74) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : F74) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : F74 → Option F74
  | x => none
  | c => some x
  | a => some x
  | m => some x
  | x₂ => some m
  | a' => some x₂
  | b' => some a'
  | tz => some a'

/-- The height. -/
def ht : F74 → ℕ
  | x => 0
  | c => 1
  | a => 1
  | m => 1
  | x₂ => 2
  | a' => 3
  | b' => 4
  | tz => 4

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `D̃`. -/
def cmap : AffineD 3 → F74
  | .spine j => if (j : ℕ) = 0 then x else if (j : ℕ) = 1 then m else if (j : ℕ) = 2 then x₂ else a'
  | .leaf i => if (i : ℕ) = 0 then c else if (i : ℕ) = 1 then a else if (i : ℕ) = 2 then b' else tz

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `D̃`. -/
def copy : (underlyingGraph (AffineD 3)).Copy G :=
  copyD G 3 cmap (by
    intro u v h
    rcases u with i | j <;> rcases v with i' | j'
    · fin_cases i <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases i <;> fin_cases j' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases j' <;> simp_all [cmap])
    (fun i ↦ by
      fin_cases i
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide)
    (fun j j' h ↦ by fin_cases j <;> fin_cases j' <;> simp_all [cmap] <;> decide)

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {X Cc Aa M X₂ A' B' Tz : P}
  (W₁ : X ⟶ Cc) (V₁ : X ⟶ Aa) (γ : X ⟶ M) (W₁' : X₂ ⟶ M) (V₁' : X₂ ⟶ A') (V₂' : A' ⟶ B') (ρ₂' : A' ⟶ Tz)

/-- The objects. -/
def obj : F74 → P
  | x => X | c => Cc | a => Aa | m => M | x₂ => X₂ | a' => A' | b' => B' | tz => Tz

/-- The arrows. -/
def arr : ∀ u v : F74, o u v → ((obj (X := X) (Cc := Cc) (Aa := Aa) (M := M) (X₂ := X₂) (A' := A') (B' := B') (Tz := Tz) u) ⟶ obj (X := X) (Cc := Cc) (Aa := Aa) (M := M) (X₂ := X₂) (A' := A') (B' := B') (Tz := Tz) v)
  | x, c, _ => W₁
  | x, a, _ => V₁
  | x, m, _ => γ
  | x₂, m, _ => W₁'
  | x₂, a', _ => V₁'
  | a', b', _ => V₂'
  | a', tz, _ => ρ₂'
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : F74, Option ((obj (X := X) (Cc := Cc) (Aa := Aa) (M := M) (X₂ := X₂) (A' := A') (B' := B') (Tz := Tz) u) ⟶ obj (X := X) (Cc := Cc) (Aa := Aa) (M := M) (X₂ := X₂) (A' := A') (B' := B') (Tz := Tz) v)
  | x, x => some (𝟙 _)
  | x, c => some (W₁)
  | x, a => some (V₁)
  | x, m => some (γ)
  | c, c => some (𝟙 _)
  | a, a => some (𝟙 _)
  | m, m => some (𝟙 _)
  | x₂, x₂ => some (𝟙 _)
  | x₂, m => some (W₁')
  | x₂, a' => some (V₁')
  | x₂, b' => some (V₁' ≫ V₂')
  | x₂, tz => some (V₁' ≫ ρ₂')
  | a', a' => some (𝟙 _)
  | a', b' => some (V₂')
  | a', tz => some (ρ₂')
  | b', b' => some (𝟙 _)
  | tz, tz => some (𝟙 _)
  | _, _ => none

end Diagram

