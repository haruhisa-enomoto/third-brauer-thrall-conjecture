def obj : F8S13 → P
  | c => Cc | a => Aa | y₀ => Y₀ | y₁ => Y₁ | z₂ => Z₂

/-- The arrows. -/
def arr : ∀ u v : F8S13, o u v → ((obj (Cc := Cc) (Aa := Aa) (Y₀ := Y₀) (Y₁ := Y₁) (Z₂ := Z₂) u) ⟶ obj (Cc := Cc) (Aa := Aa) (Y₀ := Y₀) (Y₁ := Y₁) (Z₂ := Z₂) v)
  | a, c, _ => A
  | c, y₀, _ => Bm
  | c, y₁, _ => r₁
  | c, z₂, _ => r₂
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : F8S13, Option ((obj (Cc := Cc) (Aa := Aa) (Y₀ := Y₀) (Y₁ := Y₁) (Z₂ := Z₂) u) ⟶ obj (Cc := Cc) (Aa := Aa) (Y₀ := Y₀) (Y₁ := Y₁) (Z₂ := Z₂) v)
  | c, c => some (𝟙 _)
  | c, y₀ => some (Bm)
  | c, y₁ => some (r₁)
  | c, z₂ => some (r₂)
  | a, a => some (𝟙 _)
  | a, c => some (A)
  | a, y₀ => some (A ≫ Bm)
  | a, y₁ => some (A ≫ r₁)
  | a, z₂ => some (A ≫ r₂)
  | y₀, y₀ => some (𝟙 _)
  | y₁, y₁ => some (𝟙 _)
  | z₂, z₂ => some (𝟙 _)
