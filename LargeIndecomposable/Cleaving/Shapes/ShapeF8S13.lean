namespace RayCat

/-- Vertices of the diagram `F8S13`. -/
inductive F8S13
  | c | a | y₀ | y₁ | z₂
  deriving DecidableEq

namespace F8S13

instance : Fintype F8S13 := ⟨{c, a, y₀, y₁, z₂}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : F8S13 → F8S13 → Bool
  | a, c | c, y₀ | c, y₁ | c, z₂ => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : F8S13) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph F8S13 := SimpleGraph.fromRel o

lemma adj_iff (u v : F8S13) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : F8S13) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : F8S13) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : F8S13) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : F8S13 → Option F8S13
  | c => none
  | a => some c
  | y₀ => some c
  | y₁ => some c
  | z₂ => some c

/-- The height. -/
def ht : F8S13 → ℕ
  | c => 0
  | a => 1
  | y₀ => 1
  | y₁ => 1
  | z₂ => 1

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `D̃`. -/
def cmap : AffineD 0 → F8S13
  | .spine j => c
  | .leaf i => if (i : ℕ) = 0 then a else if (i : ℕ) = 1 then y₀ else if (i : ℕ) = 2 then y₁ else z₂

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `D̃`. -/
def copy : (underlyingGraph (AffineD 0)).Copy G :=
  copyD G 0 cmap (by
    intro u v h
    rcases u with i | j <;> rcases v with i' | j'
    · fin_cases i <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases i <;> fin_cases j' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases j' <;> simp_all [cmap])
    (fun i ↦ by
      fin_cases i
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide)
    (fun j j' h ↦ by fin_cases j <;> fin_cases j' <;> simp_all [cmap] <;> decide)

section Diagram

