module

public import LargeIndecomposable.Cleaving.Shapes.ShapeD6
public import LargeIndecomposable.Cleaving.Diagrams.Tools

/-!
# The tree diagram `PC4`

Open penny-farthing (`n = 2`): `Ẽ₆` centred at `t`, arms `x → t` (`α a`), `x ← t` (`b α`) and `c ← w` (`ζ`).

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `PC4`. -/
inductive PC4
  | T1 | X0 | X2 | C1 | T2 | T0 | W1
  deriving DecidableEq

namespace PC4

instance : Fintype PC4 := ⟨{T1, X0, X2, C1, T2, T0, W1}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : PC4 → PC4 → Bool
  | X0, T1 | X0, T2 | T1, X2 | T0, X2 | T1, C1 | W1, C1 => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : PC4) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph PC4 := SimpleGraph.fromRel o

lemma adj_iff (u v : PC4) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : PC4) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : PC4) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : PC4) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : PC4 → Option PC4
  | T1 => none
  | X0 => some T1
  | X2 => some T1
  | C1 => some T1
  | T2 => some X0
  | T0 => some X2
  | W1 => some C1

/-- The height. -/
def ht : PC4 → ℕ
  | T1 => 0
  | X0 => 1
  | X2 => 1
  | C1 => 1
  | T2 => 2
  | T0 => 2
  | W1 => 2

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `Ẽ₆`. -/
def cmap : AffineE6 → PC4
  | .center => T1
  | .inner i => if (i : ℕ) = 0 then X0 else if (i : ℕ) = 1 then X2 else C1
  | .outer i => if (i : ℕ) = 0 then T2 else if (i : ℕ) = 1 then T0 else W1

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `Ẽ₆`. -/
def copy : (underlyingGraph AffineE6).Copy G :=
  copyOf G cmap (by
    intro u v h
    rcases u with _ | i | i <;> rcases v with _ | j | j <;>
      (try fin_cases i) <;> (try fin_cases j) <;> simp_all [cmap])
    (by
      intro a b e
      rcases a with _ | i | i <;> rcases b with _ | j | j
      all_goals first
        | exact (IsEmpty.false e).elim
        | exact e.elim
        | (obtain rfl : i = j := e.down; fin_cases i <;> simp only [cmap] <;> decide)
        | (fin_cases i <;> simp only [cmap] <;> decide))

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {OT1 OX0 OX2 OC1 OT2 OT0 OW1 : P}
  (a : OX0 ⟶ OT1) (e : OX0 ⟶ OT2) (b : OT1 ⟶ OX2) (f : OT0 ⟶ OX2) (γ : OT1 ⟶ OC1) (ζ : OW1 ⟶ OC1)

/-- The objects. -/
def obj : PC4 → P
  | T1 => OT1 | X0 => OX0 | X2 => OX2 | C1 => OC1 | T2 => OT2 | T0 => OT0 | W1 => OW1

/-- The arrows. -/
def arr : ∀ u v : PC4, o u v → ((obj (OT1 := OT1) (OX0 := OX0) (OX2 := OX2) (OC1 := OC1) (OT2 := OT2) (OT0 := OT0) (OW1 := OW1) u) ⟶ obj (OT1 := OT1) (OX0 := OX0) (OX2 := OX2) (OC1 := OC1) (OT2 := OT2) (OT0 := OT0) (OW1 := OW1) v)
  | X0, T1, _ => a
  | X0, T2, _ => e
  | T1, X2, _ => b
  | T0, X2, _ => f
  | T1, C1, _ => γ
  | W1, C1, _ => ζ
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : PC4, Option ((obj (OT1 := OT1) (OX0 := OX0) (OX2 := OX2) (OC1 := OC1) (OT2 := OT2) (OT0 := OT0) (OW1 := OW1) u) ⟶ obj (OT1 := OT1) (OX0 := OX0) (OX2 := OX2) (OC1 := OC1) (OT2 := OT2) (OT0 := OT0) (OW1 := OW1) v)
  | T1, T1 => some (𝟙 _)
  | T1, X2 => some (b)
  | T1, C1 => some (γ)
  | X0, X0 => some (𝟙 _)
  | X0, T1 => some (a)
  | X0, X2 => some (a ≫ b)
  | X0, C1 => some (a ≫ γ)
  | X0, T2 => some (e)
  | X2, X2 => some (𝟙 _)
  | C1, C1 => some (𝟙 _)
  | T2, T2 => some (𝟙 _)
  | T0, T0 => some (𝟙 _)
  | T0, X2 => some (f)
  | W1, W1 => some (𝟙 _)
  | W1, C1 => some (ζ)
  | _, _ => none

end Diagram

end PC4

end RayCat

namespace RayCat

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type u} [Field k] [Infinite k]

set_option maxHeartbeats 8000000 in
open PC4 in
/-- **No cleaving diagram `PC4` in `P/τ`.** -/
theorem MildHyp.not_pc4 (hM : MildHyp k P)
    {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {OT1 OX0 OX2 OC1 OT2 OT0 OW1 : P}
    (a : OX0 ⟶ OT1) (e : OX0 ⟶ OT2) (b : OT1 ⟶ OX2) (f : OT0 ⟶ OX2) (γ : OT1 ⟶ OC1) (ζ : OW1 ⟶ OC1)
    (h0_T1_X2 : ¬FactorsThroughMorphism τ (b))
    (h0_T1_C1 : ¬FactorsThroughMorphism τ (γ))
    (h0_X0_T1 : ¬FactorsThroughMorphism τ (a))
    (h0_X0_X2 : ¬FactorsThroughMorphism τ (a ≫ b))
    (h0_X0_C1 : ¬FactorsThroughMorphism τ (a ≫ γ))
    (h0_X0_T2 : ¬FactorsThroughMorphism τ (e))
    (h0_T0_X2 : ¬FactorsThroughMorphism τ (f))
    (h0_W1_C1 : ¬FactorsThroughMorphism τ (ζ))
    (hi_a : ¬IsIso a)
    (hi_e : ¬IsIso e)
    (hi_b : ¬IsIso b)
    (hi_f : ¬IsIso f)
    (hi_γ : ¬IsIso γ)
    (hi_ζ : ¬IsIso ζ)
    (hl_b_γ_C1 : ¬∃ g, b ≫ g = γ)
    (hl_γ_b_X2 : ¬∃ g, γ ≫ g = b)
    (hl_a_e_T2 : ¬∃ g, a ≫ g = e)
    (hl_e_a_T1 : ¬∃ g, e ≫ g = a)
    (hl_e_a_X2 : ¬∃ g, e ≫ g = a ≫ b)
    (hl_e_a_C1 : ¬∃ g, e ≫ g = a ≫ γ)
    (hr_b_f_T0 : ¬∃ g, g ≫ b = f)
    (hr_f_b_T1 : ¬∃ g, g ≫ f = b)
    (hr_f_b_X0 : ¬∃ g, g ≫ f = a ≫ b)
    (hr_γ_ζ_W1 : ¬∃ g, g ≫ γ = ζ)
    (hr_ζ_γ_T1 : ¬∃ g, g ≫ ζ = γ)
    (hr_ζ_γ_X0 : ¬∃ g, g ≫ ζ = a ≫ γ)
    : False := by
  haveI : Fact (LargeIndecomposable.Foundations.Quiver.IsAcyclic (OT G o)) := ⟨OT.isAcyclic ho hasym isAcyclic⟩
  refine hM.not_tree_table τ hτ hτ0 G o ho hasym isAcyclic
    (OT.not_isRepresentationFinite_affineE6 ho hcov k copy) obj (arr a e b f γ ζ)
    (tab a e b f γ ζ) (fun v ↦ by cases v <;> rfl) ?_ ?_ ?_ ?_ ?_
  · intro x y z h f hf
    cases y <;> cases z <;> (try exact absurd h (by decide)) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; rfl)
      | rfl
  · intro x y f hf hne
    cases x <;> cases y <;> (try exact absurd rfl hne) <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;> assumption
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | assumption
  · intro x c c' y h h' f hne hf
    cases x <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases y <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.comp_id]; assumption)
      | assumption
  · intro x c c' y h h' f hne hf
    cases y <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; assumption)
      | assumption

end RayCat

end LargeIndecomposable
