namespace RayCat

/-- Vertices of the diagram `F8S31`. -/
inductive F8S31
  | a | x | xn | x₂ | c
  deriving DecidableEq

namespace F8S31

instance : Fintype F8S31 := ⟨{a, x, xn, x₂, c}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : F8S31 → F8S31 → Bool
  | x, a | xn, a | x₂, a | a, c => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : F8S31) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph F8S31 := SimpleGraph.fromRel o

lemma adj_iff (u v : F8S31) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : F8S31) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : F8S31) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : F8S31) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : F8S31 → Option F8S31
  | a => none
  | x => some a
  | xn => some a
  | x₂ => some a
  | c => some a

/-- The height. -/
def ht : F8S31 → ℕ
  | a => 0
  | x => 1
  | xn => 1
  | x₂ => 1
  | c => 1

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `D̃`. -/
def cmap : AffineD 0 → F8S31
  | .spine j => a
  | .leaf i => if (i : ℕ) = 0 then x else if (i : ℕ) = 1 then xn else if (i : ℕ) = 2 then x₂ else c

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `D̃`. -/
def copy : (underlyingGraph (AffineD 0)).Copy G :=
  copyD G 0 cmap (by
    intro u v h
    rcases u with i | j <;> rcases v with i' | j'
    · fin_cases i <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases i <;> fin_cases j' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases j' <;> simp_all [cmap])
    (fun i ↦ by
      fin_cases i
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide)
    (fun j j' h ↦ by fin_cases j <;> fin_cases j' <;> simp_all [cmap] <;> decide)

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {Aa X Xn X₂ Cc : P}
  (V₁ : X ⟶ Aa) (r : Xn ⟶ Aa) (σ₂' : X₂ ⟶ Aa) (A : Aa ⟶ Cc)

/-- The objects. -/
def obj : F8S31 → P
  | a => Aa | x => X | xn => Xn | x₂ => X₂ | c => Cc

/-- The arrows. -/
def arr : ∀ u v : F8S31, o u v → ((obj (Aa := Aa) (X := X) (Xn := Xn) (X₂ := X₂) (Cc := Cc) u) ⟶ obj (Aa := Aa) (X := X) (Xn := Xn) (X₂ := X₂) (Cc := Cc) v)
  | x, a, _ => V₁
  | xn, a, _ => r
  | x₂, a, _ => σ₂'
  | a, c, _ => A
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : F8S31, Option ((obj (Aa := Aa) (X := X) (Xn := Xn) (X₂ := X₂) (Cc := Cc) u) ⟶ obj (Aa := Aa) (X := X) (Xn := Xn) (X₂ := X₂) (Cc := Cc) v)
  | a, a => some (𝟙 _)
  | a, c => some (A)
  | x, x => some (𝟙 _)
  | x, a => some (V₁)
  | x, c => some (V₁ ≫ A)
  | xn, xn => some (𝟙 _)
  | xn, a => some (r)
  | xn, c => some (r ≫ A)
  | x₂, x₂ => some (𝟙 _)
  | x₂, a => some (σ₂')
  | x₂, c => some (σ₂' ≫ A)
  | c, c => some (𝟙 _)
  | _, _ => none

end Diagram

