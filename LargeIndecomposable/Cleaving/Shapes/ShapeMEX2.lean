/-- The order (nonzero morphisms). -/
def leb : MEX2 → MEX2 → Bool
  | A, A | A, D2 | A, Yy | B, B | B, D2 | B, Yy | D2, D2 | Dd, A | Dd, D2 | Dd, Dd | Dd, Yy | Xx, A | Xx, B | Xx, D2 | Xx, Xx | Xx, Yy | Y0, A | Y0, D2 | Y0, Dd | Y0, Y0 | Y0, Yy | Yy, D2 | Yy, Yy | Z, D2 | Z, Z => true
  | _, _ => false

/-- The arrows. -/
def arb : MEX2 → MEX2 → Bool
  | A, Yy | B, Yy | Dd, A | Xx, A | Xx, B | Y0, Dd | Yy, D2 | Z, D2 => true
  | _, _ => false

/-- The thin category. -/
abbrev thin : ThinData MEX2 where
  le x y := leb x y = true
  nz x _ z := leb x z = true
  refl x := by cases x <;> rfl
  antisymm := by decide
  nz_le _ _ _ _ _ h := h
  nz_left _ _ h := h
  nz_right _ _ h := h
  assoc := by decide

/-- The generating arrows. -/
abbrev arrows : ThinArrows thin where
  ar x y := arb x y = true
  ar_le := by decide
  ar_ne := by decide
  first := by decide
  last := by decide

