namespace RayCat

/-- Vertices of the diagram `LPF1`. -/
inductive LPF1
  | A | Y | X1 | B | C | D | E | F | G
  deriving DecidableEq

namespace LPF1

instance : Fintype LPF1 := ⟨{A, Y, X1, B, C, D, E, F, G}, by intro v; cases v <;> simp⟩

/-- The order (nonzero morphisms). -/
def leb : LPF1 → LPF1 → Bool
  | A, A | A, B | A, C | A, D | A, E | A, X1 | A, Y | B, B | B, C | B, D | B, E | C, C | D, D | D, E | E, E | F, B | F, C | F, F | G, B | G, C | G, F | G, G | X1, C | X1, X1 | Y, Y => true
  | _, _ => false

/-- The arrows. -/
def arb : LPF1 → LPF1 → Bool
  | A, B | A, X1 | A, Y | B, C | B, D | D, E | F, B | G, F | X1, C => true
  | _, _ => false

/-- The thin category. -/
abbrev thin : ThinData LPF1 where
  le x y := leb x y = true
  nz x _ z := leb x z = true
  refl x := by cases x <;> rfl
  antisymm := by decide
  nz_le _ _ _ _ _ h := h
  nz_left _ _ h := h
  nz_right _ _ h := h
  assoc := by decide

/-- The generating arrows. -/
abbrev arrows : ThinArrows thin where
  ar x y := arb x y = true
  ar_le := by decide
  ar_ne := by decide
  first := by decide
  last := by decide

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {XA XY XX1 XB XC XD XE XF XG : P}
  (ε : XA ⟶ XY) (a : XA ⟶ XX1) (ρ : XA ⟶ XB) (μ₁ : XX1 ⟶ XC) (ρ' : XB ⟶ XC) (a' : XB ⟶ XD) (b : XD ⟶ XE) (μ₂ : XF ⟶ XB) (b' : XG ⟶ XF)

/-- The objects. -/
abbrev obj : LPF1 → P
  | A => XA | Y => XY | X1 => XX1 | B => XB | C => XC | D => XD | E => XE | F => XF | G => XG

/-- The morphisms. -/
abbrev tab : ∀ u v : LPF1, (obj (XA := XA) (XY := XY) (XX1 := XX1) (XB := XB) (XC := XC) (XD := XD) (XE := XE) (XF := XF) (XG := XG) u) ⟶ obj (XA := XA) (XY := XY) (XX1 := XX1) (XB := XB) (XC := XC) (XD := XD) (XE := XE) (XF := XF) (XG := XG) v
  | A, A => 𝟙 _
  | A, B => ρ
  | A, C => ρ ≫ ρ'
  | A, D => ρ ≫ a'
  | A, E => (ρ ≫ a') ≫ b
  | A, X1 => a
  | A, Y => ε
  | B, B => 𝟙 _
  | B, C => ρ'
  | B, D => a'
  | B, E => a' ≫ b
  | C, C => 𝟙 _
  | D, D => 𝟙 _
  | D, E => b
  | E, E => 𝟙 _
  | F, B => μ₂
  | F, C => μ₂ ≫ ρ'
  | F, F => 𝟙 _
  | G, B => b' ≫ μ₂
  | G, C => (b' ≫ μ₂) ≫ ρ'
  | G, F => b'
  | G, G => 𝟙 _
  | X1, C => μ₁
  | X1, X1 => 𝟙 _
  | Y, Y => 𝟙 _
  | _, _ => 0

end Diagram

