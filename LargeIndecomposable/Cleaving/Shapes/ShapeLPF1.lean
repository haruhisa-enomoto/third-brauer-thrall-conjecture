namespace RayCat

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type*} [Field k] [Infinite k]

set_option maxHeartbeats 16000000 in
open LPF1 in
/-- **No cleaving diagram `LPF1` in `P/τ`.** -/
theorem MildHyp.not_lpf1 (hM : MildHyp k P) {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {XA XY XX1 XB XC XD XE XF XG : P}
    (ε : XA ⟶ XY) (a : XA ⟶ XX1) (ρ : XA ⟶ XB) (μ₁ : XX1 ⟶ XC) (ρ' : XB ⟶ XC) (a' : XB ⟶ XD) (b : XD ⟶ XE) (μ₂ : XF ⟶ XB) (b' : XG ⟶ XF)
    (hD : ¬Statement.IsRepresentationFinite (Linearization (ThinCat thin) k))
    (hc0 : a ≫ μ₁ = ρ ≫ ρ')
    (hz0 : μ₂ ≫ a' = 0)
    (hz1 : μ₂ ≫ a' ≫ b = 0)
    (hz2 : b' ≫ μ₂ ≫ a' = 0)
    (hz3 : b' ≫ μ₂ ≫ a' ≫ b = 0)
    (h0_A_B : ¬FactorsThroughMorphism τ (ρ))
    (h0_A_C : ¬FactorsThroughMorphism τ (ρ ≫ ρ'))
    (h0_A_D : ¬FactorsThroughMorphism τ (ρ ≫ a'))
    (h0_A_E : ¬FactorsThroughMorphism τ ((ρ ≫ a') ≫ b))
    (h0_A_X1 : ¬FactorsThroughMorphism τ (a))
    (h0_A_Y : ¬FactorsThroughMorphism τ (ε))
    (h0_B_C : ¬FactorsThroughMorphism τ (ρ'))
    (h0_B_D : ¬FactorsThroughMorphism τ (a'))
    (h0_B_E : ¬FactorsThroughMorphism τ (a' ≫ b))
    (h0_D_E : ¬FactorsThroughMorphism τ (b))
    (h0_F_B : ¬FactorsThroughMorphism τ (μ₂))
    (h0_F_C : ¬FactorsThroughMorphism τ (μ₂ ≫ ρ'))
    (h0_G_B : ¬FactorsThroughMorphism τ (b' ≫ μ₂))
    (h0_G_C : ¬FactorsThroughMorphism τ ((b' ≫ μ₂) ≫ ρ'))
    (h0_G_F : ¬FactorsThroughMorphism τ (b'))
    (h0_X1_C : ¬FactorsThroughMorphism τ (μ₁))
    (hi_ε : ¬IsIso ε)
    (hi_a : ¬IsIso a)
    (hi_ρ : ¬IsIso ρ)
    (hi_μ₁ : ¬IsIso μ₁)
    (hi_ρ' : ¬IsIso ρ')
    (hi_a' : ¬IsIso a')
    (hi_b : ¬IsIso b)
    (hi_μ₂ : ¬IsIso μ₂)
    (hi_b' : ¬IsIso b')
    (hlft_A_B_Y : ¬∃ g, ρ ≫ g = ε)
    (hlft_A_B_X1 : ¬∃ g, ρ ≫ g = a)
    (hlft_A_X1_Y : ¬∃ g, a ≫ g = ε)
    (hlft_A_X1_B : ¬∃ g, a ≫ g = ρ)
    (hlft_A_X1_D : ¬∃ g, a ≫ g = ρ ≫ a')
    (hlft_A_X1_E : ¬∃ g, a ≫ g = (ρ ≫ a') ≫ b)
    (hlft_A_Y_X1 : ¬∃ g, ε ≫ g = a)
    (hlft_A_Y_B : ¬∃ g, ε ≫ g = ρ)
    (hlft_A_Y_C : ¬∃ g, ε ≫ g = ρ ≫ ρ')
    (hlft_A_Y_D : ¬∃ g, ε ≫ g = ρ ≫ a')
    (hlft_A_Y_E : ¬∃ g, ε ≫ g = (ρ ≫ a') ≫ b)
    (hlft_B_C_D : ¬∃ g, ρ' ≫ g = a')
    (hlft_B_C_E : ¬∃ g, ρ' ≫ g = a' ≫ b)
    (hlft_B_D_C : ¬∃ g, a' ≫ g = ρ')
    (hrgt_F_A_B : ¬∃ g, g ≫ ρ = μ₂)
    (hrgt_G_A_B : ¬∃ g, g ≫ ρ = b' ≫ μ₂)
    (hrgt_X1_B_C : ¬∃ g, g ≫ ρ' = μ₁)
    (hrgt_A_F_B : ¬∃ g, g ≫ μ₂ = ρ)
    (hrgt_B_X1_C : ¬∃ g, g ≫ μ₁ = ρ')
    (hrgt_F_X1_C : ¬∃ g, g ≫ μ₁ = μ₂ ≫ ρ')
    (hrgt_G_X1_C : ¬∃ g, g ≫ μ₁ = (b' ≫ μ₂) ≫ ρ')
    : False := by
  have hlft_A_B_A : ¬∃ g, ρ ≫ g = 𝟙 _ := not_split_mono hi_ρ
  have hlft_A_X1_A : ¬∃ g, a ≫ g = 𝟙 _ := not_split_mono hi_a
  have hlft_A_Y_A : ¬∃ g, ε ≫ g = 𝟙 _ := not_split_mono hi_ε
  have hlft_B_C_B : ¬∃ g, ρ' ≫ g = 𝟙 _ := not_split_mono hi_ρ'
  have hlft_B_D_B : ¬∃ g, a' ≫ g = 𝟙 _ := not_split_mono hi_a'
  have hlft_D_E_D : ¬∃ g, b ≫ g = 𝟙 _ := not_split_mono hi_b
  have hlft_F_B_F : ¬∃ g, μ₂ ≫ g = 𝟙 _ := not_split_mono hi_μ₂
  have hlft_G_F_G : ¬∃ g, b' ≫ g = 𝟙 _ := not_split_mono hi_b'
  have hlft_X1_C_X1 : ¬∃ g, μ₁ ≫ g = 𝟙 _ := not_split_mono hi_μ₁
  have hrgt_B_A_B : ¬∃ g, g ≫ ρ = 𝟙 _ := not_split_epi hi_ρ
  have hrgt_X1_A_X1 : ¬∃ g, g ≫ a = 𝟙 _ := not_split_epi hi_a
  have hrgt_Y_A_Y : ¬∃ g, g ≫ ε = 𝟙 _ := not_split_epi hi_ε
  have hrgt_C_B_C : ¬∃ g, g ≫ ρ' = 𝟙 _ := not_split_epi hi_ρ'
  have hrgt_D_B_D : ¬∃ g, g ≫ a' = 𝟙 _ := not_split_epi hi_a'
  have hrgt_E_D_E : ¬∃ g, g ≫ b = 𝟙 _ := not_split_epi hi_b
  have hrgt_B_F_B : ¬∃ g, g ≫ μ₂ = 𝟙 _ := not_split_epi hi_μ₂
  have hrgt_F_G_F : ¬∃ g, g ≫ b' = 𝟙 _ := not_split_epi hi_b'
  have hrgt_C_X1_C : ¬∃ g, g ≫ μ₁ = 𝟙 _ := not_split_epi hi_μ₁
  have hc0' := reassoc_of% hc0
  have hz0' := reassoc_of% hz0
  have hz1' := reassoc_of% hz1
  have hz2' := reassoc_of% hz2
  have hz3' := reassoc_of% hz3
  refine hM.not_thin_diagram τ hτ hτ0 hD arrows obj (fun x y _ ↦ tab ε a ρ μ₁ ρ' a' b μ₂ b' x y)
    (fun x ↦ by cases x <;> rfl) ?_ ?_ ?_ ?_
  · intro x y z h h'
    cases x <;> cases y <;> (try exact absurd h (by decide)) <;> cases z <;>
      (try exact absurd h' (by decide)) <;> split_ifs with hn <;>
      (try exact absurd hn (by decide)) <;>
      simp only [tab, Category.assoc, Category.id_comp, Category.comp_id, zero_comp, comp_zero, hc0', hc0, hz0', hz0, hz1', hz1, hz2', hz2, hz3', hz3]
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | exact not_factorsThrough_id hτ _
      | assumption
  · intro x z y ha hy
    cases x <;> cases z <;> (try exact absurd ha (by decide)) <;> cases y <;>
      (try exact absurd hy (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›
  · intro x z y ha hx
    cases z <;> cases y <;> (try exact absurd ha (by decide)) <;> cases x <;>
      (try exact absurd hx (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›

end RayCat

