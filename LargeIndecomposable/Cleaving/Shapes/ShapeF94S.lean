variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type u} [Field k] [Infinite k]
  {A : Type u} [Ring A] [Algebra k A] (B : MulBasis k P A)

set_option maxHeartbeats 8000000 in
open F94S in
include B in
/-- **No cleaving diagram `F94S` in `P/τ`.** -/
theorem not_f94s
    (hmin : ∀ I : TwoSidedIdeal A, I ≠ ⊥ → Statement.IsRepresentationFinite (A ⧸ I.asIdeal))
    (hL : LeftCancel P) (hR : RightCancel P) {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {Aa X Y₀ Y₁ C' X₂ Z₂ : P}
    (V₁ : X ⟶ Aa) (V₂ : Aa ⟶ Y₀) (ρ₁' : Aa ⟶ Y₁) (σ₂' : C' ⟶ Y₁) (V₁' : X₂ ⟶ C') (V₂' : C' ⟶ Z₂)
    (h0_a_y₀ : ¬FactorsThroughMorphism τ (V₂))
    (h0_a_y₁ : ¬FactorsThroughMorphism τ (ρ₁'))
    (h0_x_a : ¬FactorsThroughMorphism τ (V₁))
    (h0_x_y₀ : ¬FactorsThroughMorphism τ (V₁ ≫ V₂))
    (h0_x_y₁ : ¬FactorsThroughMorphism τ (V₁ ≫ ρ₁'))
    (h0_c'_y₁ : ¬FactorsThroughMorphism τ (σ₂'))
    (h0_c'_z₂ : ¬FactorsThroughMorphism τ (V₂'))
    (h0_x₂_c' : ¬FactorsThroughMorphism τ (V₁'))
    (h0_x₂_y₁ : ¬FactorsThroughMorphism τ (V₁' ≫ σ₂'))
    (h0_x₂_z₂ : ¬FactorsThroughMorphism τ (V₁' ≫ V₂'))
    (hi_V₁ : ¬IsIso V₁)
    (hi_V₂ : ¬IsIso V₂)
    (hi_ρ₁' : ¬IsIso ρ₁')
    (hi_σ₂' : ¬IsIso σ₂')
    (hi_V₁' : ¬IsIso V₁')
    (hi_V₂' : ¬IsIso V₂')
    (hl_V₂_ρ₁'_y₁ : ¬∃ g, V₂ ≫ g = ρ₁')
    (hl_ρ₁'_V₂_y₀ : ¬∃ g, ρ₁' ≫ g = V₂)
    (hl_σ₂'_V₂'_z₂ : ¬∃ g, σ₂' ≫ g = V₂')
    (hl_V₂'_σ₂'_y₁ : ¬∃ g, V₂' ≫ g = σ₂')
    (hr_ρ₁'_σ₂'_c' : ¬∃ g, g ≫ ρ₁' = σ₂')
    (hr_ρ₁'_σ₂'_x₂ : ¬∃ g, g ≫ ρ₁' = V₁' ≫ σ₂')
    (hr_σ₂'_ρ₁'_a : ¬∃ g, g ≫ σ₂' = ρ₁')
    (hr_σ₂'_ρ₁'_x : ¬∃ g, g ≫ σ₂' = V₁ ≫ ρ₁')
    : False := by
  haveI : Fact (LargeIndecomposable.Foundations.Quiver.IsAcyclic (OT G o)) := ⟨OT.isAcyclic ho hasym isAcyclic⟩
  refine B.not_tree_table hmin hL hR τ hτ hτ0 G o ho hasym isAcyclic
    (OT.not_isRepresentationFinite_affineD ho hcov k 2 copy) obj (arr V₁ V₂ ρ₁' σ₂' V₁' V₂')
    (tab V₁ V₂ ρ₁' σ₂' V₁' V₂') (fun v ↦ by cases v <;> rfl) ?_ ?_ ?_ ?_ ?_
  · intro x y z h f hf
    cases y <;> cases z <;> (try exact absurd h (by decide)) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; rfl)
      | rfl
  · intro x y f hf hne
    cases x <;> cases y <;> (try exact absurd rfl hne) <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;> assumption
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | assumption
  · intro x c c' y h h' f hne hf
    cases x <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases y <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.comp_id]; assumption)
      | assumption
  · intro x c c' y h h' f hne hf
    cases y <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; assumption)
      | assumption

