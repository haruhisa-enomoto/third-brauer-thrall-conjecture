/-!
# The tree diagram `F94S`

BO13a figure 9.4 for `j = 2`: the `D̃₆` tree `x → a → y₀`, `a → y₁ ← c'`, `x₂ → c' → z₂`.

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `F94S`. -/
inductive F94S
  | a | x | y₀ | y₁ | c' | x₂ | z₂
  deriving DecidableEq

namespace F94S

instance : Fintype F94S := ⟨{a, x, y₀, y₁, c', x₂, z₂}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : F94S → F94S → Bool
  | x, a | a, y₀ | a, y₁ | c', y₁ | x₂, c' | c', z₂ => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : F94S) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph F94S := SimpleGraph.fromRel o

lemma adj_iff (u v : F94S) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : F94S) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : F94S) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : F94S) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : F94S → Option F94S
  | a => none
  | x => some a
  | y₀ => some a
  | y₁ => some a
  | c' => some y₁
  | x₂ => some c'
  | z₂ => some c'

/-- The height. -/
def ht : F94S → ℕ
  | a => 0
  | x => 1
  | y₀ => 1
  | y₁ => 1
  | c' => 2
  | x₂ => 3
  | z₂ => 3

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `D̃`. -/
def cmap : AffineD 2 → F94S
  | .spine j => if (j : ℕ) = 0 then a else if (j : ℕ) = 1 then y₁ else c'
  | .leaf i => if (i : ℕ) = 0 then x else if (i : ℕ) = 1 then y₀ else if (i : ℕ) = 2 then x₂ else z₂

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `D̃`. -/
def copy : (underlyingGraph (AffineD 2)).Copy G :=
  copyD G 2 cmap (by
    intro u v h
    rcases u with i | j <;> rcases v with i' | j'
    · fin_cases i <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases i <;> fin_cases j' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases i' <;> simp_all [cmap]
    · fin_cases j <;> fin_cases j' <;> simp_all [cmap])
    (fun i ↦ by
      fin_cases i
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide
      · rw [AffineD.leafTarget_of_not_lt_two _ (by decide)]; simp [cmap]; decide)
    (fun j j' h ↦ by fin_cases j <;> fin_cases j' <;> simp_all [cmap] <;> decide)

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {Aa X Y₀ Y₁ C' X₂ Z₂ : P}
  (V₁ : X ⟶ Aa) (V₂ : Aa ⟶ Y₀) (ρ₁' : Aa ⟶ Y₁) (σ₂' : C' ⟶ Y₁) (V₁' : X₂ ⟶ C') (V₂' : C' ⟶ Z₂)

/-- The objects. -/
def obj : F94S → P
  | a => Aa | x => X | y₀ => Y₀ | y₁ => Y₁ | c' => C' | x₂ => X₂ | z₂ => Z₂

/-- The arrows. -/
def arr : ∀ u v : F94S, o u v → ((obj (Aa := Aa) (X := X) (Y₀ := Y₀) (Y₁ := Y₁) (C' := C') (X₂ := X₂) (Z₂ := Z₂) u) ⟶ obj (Aa := Aa) (X := X) (Y₀ := Y₀) (Y₁ := Y₁) (C' := C') (X₂ := X₂) (Z₂ := Z₂) v)
  | x, a, _ => V₁
  | a, y₀, _ => V₂
  | a, y₁, _ => ρ₁'
  | c', y₁, _ => σ₂'
  | x₂, c', _ => V₁'
  | c', z₂, _ => V₂'
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : F94S, Option ((obj (Aa := Aa) (X := X) (Y₀ := Y₀) (Y₁ := Y₁) (C' := C') (X₂ := X₂) (Z₂ := Z₂) u) ⟶ obj (Aa := Aa) (X := X) (Y₀ := Y₀) (Y₁ := Y₁) (C' := C') (X₂ := X₂) (Z₂ := Z₂) v)
  | a, a => some (𝟙 _)
  | a, y₀ => some (V₂)
  | a, y₁ => some (ρ₁')
  | x, x => some (𝟙 _)
  | x, a => some (V₁)
  | x, y₀ => some (V₁ ≫ V₂)
  | x, y₁ => some (V₁ ≫ ρ₁')
  | y₀, y₀ => some (𝟙 _)
  | y₁, y₁ => some (𝟙 _)
  | c', c' => some (𝟙 _)
  | c', y₁ => some (σ₂')
  | c', z₂ => some (V₂')
  | x₂, x₂ => some (𝟙 _)
  | x₂, c' => some (V₁')
  | x₂, y₁ => some (V₁' ≫ σ₂')
  | x₂, z₂ => some (V₁' ≫ V₂')
  | z₂, z₂ => some (𝟙 _)
  | _, _ => none

end Diagram

