namespace RayCat

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type*} [Field k] [Infinite k]

set_option maxHeartbeats 16000000 in
open M44C in
/-- **No cleaving diagram `M44C` in `P/τ`.** -/
theorem MildHyp.not_m44c (hM : MildHyp k P) {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {XBv XA XX1 XB XW XY1 XG XT XS : P}
    (ε : XA ⟶ XBv) (a : XA ⟶ XX1) (ρ : XA ⟶ XB) (ρ' : XB ⟶ XW) (β' : XG ⟶ XB) (η : XG ⟶ XT) (ε₂ : XS ⟶ XT) (a' : XB ⟶ XY1) (β : XX1 ⟶ XW)
    (hD : ¬Statement.IsRepresentationFinite (Linearization (ThinCat thin) k))
    (hc0 : a ≫ β = ρ ≫ ρ')
    (hz0 : β' ≫ a' = 0)
    (h0_A_B : ¬FactorsThroughMorphism τ (ρ))
    (h0_A_Bv : ¬FactorsThroughMorphism τ (ε))
    (h0_A_W : ¬FactorsThroughMorphism τ (ρ ≫ ρ'))
    (h0_A_X1 : ¬FactorsThroughMorphism τ (a))
    (h0_A_Y1 : ¬FactorsThroughMorphism τ (ρ ≫ a'))
    (h0_B_W : ¬FactorsThroughMorphism τ (ρ'))
    (h0_B_Y1 : ¬FactorsThroughMorphism τ (a'))
    (h0_G_B : ¬FactorsThroughMorphism τ (β'))
    (h0_G_T : ¬FactorsThroughMorphism τ (η))
    (h0_G_W : ¬FactorsThroughMorphism τ (β' ≫ ρ'))
    (h0_S_T : ¬FactorsThroughMorphism τ (ε₂))
    (h0_X1_W : ¬FactorsThroughMorphism τ (β))
    (hi_ε : ¬IsIso ε)
    (hi_a : ¬IsIso a)
    (hi_ρ : ¬IsIso ρ)
    (hi_ρ' : ¬IsIso ρ')
    (hi_β' : ¬IsIso β')
    (hi_η : ¬IsIso η)
    (hi_ε₂ : ¬IsIso ε₂)
    (hi_a' : ¬IsIso a')
    (hi_β : ¬IsIso β)
    (hlft_A_B_Bv : ¬∃ g, ρ ≫ g = ε)
    (hlft_A_B_X1 : ¬∃ g, ρ ≫ g = a)
    (hlft_A_Bv_X1 : ¬∃ g, ε ≫ g = a)
    (hlft_A_Bv_B : ¬∃ g, ε ≫ g = ρ)
    (hlft_A_Bv_W : ¬∃ g, ε ≫ g = ρ ≫ ρ')
    (hlft_A_Bv_Y1 : ¬∃ g, ε ≫ g = ρ ≫ a')
    (hlft_A_X1_Bv : ¬∃ g, a ≫ g = ε)
    (hlft_A_X1_B : ¬∃ g, a ≫ g = ρ)
    (hlft_A_X1_Y1 : ¬∃ g, a ≫ g = ρ ≫ a')
    (hlft_B_W_Y1 : ¬∃ g, ρ' ≫ g = a')
    (hlft_B_Y1_W : ¬∃ g, a' ≫ g = ρ')
    (hlft_G_B_T : ¬∃ g, β' ≫ g = η)
    (hlft_G_T_B : ¬∃ g, η ≫ g = β')
    (hlft_G_T_W : ¬∃ g, η ≫ g = β' ≫ ρ')
    (hrgt_G_A_B : ¬∃ g, g ≫ ρ = β')
    (hrgt_X1_B_W : ¬∃ g, g ≫ ρ' = β)
    (hrgt_A_G_B : ¬∃ g, g ≫ β' = ρ)
    (hrgt_S_G_T : ¬∃ g, g ≫ η = ε₂)
    (hrgt_G_S_T : ¬∃ g, g ≫ ε₂ = η)
    (hrgt_B_X1_W : ¬∃ g, g ≫ β = ρ')
    (hrgt_G_X1_W : ¬∃ g, g ≫ β = β' ≫ ρ')
    : False := by
  have hlft_A_B_A : ¬∃ g, ρ ≫ g = 𝟙 _ := not_split_mono hi_ρ
  have hlft_A_Bv_A : ¬∃ g, ε ≫ g = 𝟙 _ := not_split_mono hi_ε
  have hlft_A_X1_A : ¬∃ g, a ≫ g = 𝟙 _ := not_split_mono hi_a
  have hlft_B_W_B : ¬∃ g, ρ' ≫ g = 𝟙 _ := not_split_mono hi_ρ'
  have hlft_B_Y1_B : ¬∃ g, a' ≫ g = 𝟙 _ := not_split_mono hi_a'
  have hlft_G_B_G : ¬∃ g, β' ≫ g = 𝟙 _ := not_split_mono hi_β'
  have hlft_G_T_G : ¬∃ g, η ≫ g = 𝟙 _ := not_split_mono hi_η
  have hlft_S_T_S : ¬∃ g, ε₂ ≫ g = 𝟙 _ := not_split_mono hi_ε₂
  have hlft_X1_W_X1 : ¬∃ g, β ≫ g = 𝟙 _ := not_split_mono hi_β
  have hrgt_B_A_B : ¬∃ g, g ≫ ρ = 𝟙 _ := not_split_epi hi_ρ
  have hrgt_Bv_A_Bv : ¬∃ g, g ≫ ε = 𝟙 _ := not_split_epi hi_ε
  have hrgt_X1_A_X1 : ¬∃ g, g ≫ a = 𝟙 _ := not_split_epi hi_a
  have hrgt_W_B_W : ¬∃ g, g ≫ ρ' = 𝟙 _ := not_split_epi hi_ρ'
  have hrgt_Y1_B_Y1 : ¬∃ g, g ≫ a' = 𝟙 _ := not_split_epi hi_a'
  have hrgt_B_G_B : ¬∃ g, g ≫ β' = 𝟙 _ := not_split_epi hi_β'
  have hrgt_T_G_T : ¬∃ g, g ≫ η = 𝟙 _ := not_split_epi hi_η
  have hrgt_T_S_T : ¬∃ g, g ≫ ε₂ = 𝟙 _ := not_split_epi hi_ε₂
  have hrgt_W_X1_W : ¬∃ g, g ≫ β = 𝟙 _ := not_split_epi hi_β
  have hc0' := reassoc_of% hc0
  have hz0' := reassoc_of% hz0
  refine hM.not_thin_diagram τ hτ hτ0 hD arrows obj (fun x y _ ↦ tab ε a ρ ρ' β' η ε₂ a' β x y)
    (fun x ↦ by cases x <;> rfl) ?_ ?_ ?_ ?_
  · intro x y z h h'
    cases x <;> cases y <;> (try exact absurd h (by decide)) <;> cases z <;>
      (try exact absurd h' (by decide)) <;> split_ifs with hn <;>
      (try exact absurd hn (by decide)) <;>
      simp only [tab, Category.assoc, Category.id_comp, Category.comp_id, zero_comp, comp_zero, hc0', hc0, hz0', hz0]
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | exact not_factorsThrough_id hτ _
      | assumption
  · intro x z y ha hy
    cases x <;> cases z <;> (try exact absurd ha (by decide)) <;> cases y <;>
      (try exact absurd hy (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›
  · intro x z y ha hx
    cases z <;> cases y <;> (try exact absurd ha (by decide)) <;> cases x <;>
      (try exact absurd hx (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›

end RayCat

