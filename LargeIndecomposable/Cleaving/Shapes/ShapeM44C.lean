namespace RayCat

/-- Vertices of the diagram `M44C`. -/
inductive M44C
  | Bv | A | X1 | B | W | Y1 | G | T | S
  deriving DecidableEq

namespace M44C

instance : Fintype M44C := ⟨{Bv, A, X1, B, W, Y1, G, T, S}, by intro v; cases v <;> simp⟩

/-- The order (nonzero morphisms). -/
def leb : M44C → M44C → Bool
  | A, A | A, B | A, Bv | A, W | A, X1 | A, Y1 | B, B | B, W | B, Y1 | Bv, Bv | G, B | G, G | G, T | G, W | S, S | S, T | T, T | W, W | X1, W | X1, X1 | Y1, Y1 => true
  | _, _ => false

/-- The arrows. -/
def arb : M44C → M44C → Bool
  | A, B | A, Bv | A, X1 | B, W | B, Y1 | G, B | G, T | S, T | X1, W => true
  | _, _ => false

/-- The thin category. -/
abbrev thin : ThinData M44C where
  le x y := leb x y = true
  nz x _ z := leb x z = true
  refl x := by cases x <;> rfl
  antisymm := by decide
  nz_le _ _ _ _ _ h := h
  nz_left _ _ h := h
  nz_right _ _ h := h
  assoc := by decide

/-- The generating arrows. -/
abbrev arrows : ThinArrows thin where
  ar x y := arb x y = true
  ar_le := by decide
  ar_ne := by decide
  first := by decide
  last := by decide

