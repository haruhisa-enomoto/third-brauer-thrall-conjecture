variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {XBv XA XX1 XB XW XY1 XG XT XS : P}
  (ε : XA ⟶ XBv) (a : XA ⟶ XX1) (ρ : XA ⟶ XB) (ρ' : XB ⟶ XW) (β' : XG ⟶ XB) (η : XG ⟶ XT) (ε₂ : XS ⟶ XT) (a' : XB ⟶ XY1) (β : XX1 ⟶ XW)

/-- The objects. -/
abbrev obj : M44C → P
  | Bv => XBv | A => XA | X1 => XX1 | B => XB | W => XW | Y1 => XY1 | G => XG | T => XT | S => XS

/-- The morphisms. -/
abbrev tab : ∀ u v : M44C, (obj (XBv := XBv) (XA := XA) (XX1 := XX1) (XB := XB) (XW := XW) (XY1 := XY1) (XG := XG) (XT := XT) (XS := XS) u) ⟶ obj (XBv := XBv) (XA := XA) (XX1 := XX1) (XB := XB) (XW := XW) (XY1 := XY1) (XG := XG) (XT := XT) (XS := XS) v
  | A, A => 𝟙 _
  | A, B => ρ
  | A, Bv => ε
  | A, W => ρ ≫ ρ'
  | A, X1 => a
  | A, Y1 => ρ ≫ a'
  | B, B => 𝟙 _
  | B, W => ρ'
  | B, Y1 => a'
  | Bv, Bv => 𝟙 _
  | G, B => β'
  | G, G => 𝟙 _
  | G, T => η
  | G, W => β' ≫ ρ'
  | S, S => 𝟙 _
