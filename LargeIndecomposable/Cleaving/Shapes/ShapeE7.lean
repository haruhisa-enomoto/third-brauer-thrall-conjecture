/-!
# The tree diagram `ME7`

[mild] figure 2.2 (first diagram): the `Ẽ₇` tree `t ← x → z ← z' → y ← y' ← t'`, `x' → z'`.

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `ME7`. -/
inductive ME7
  | c | xa | z | x | t | y | yb | tb
  deriving DecidableEq

namespace ME7

instance : Fintype ME7 := ⟨{c, xa, z, x, t, y, yb, tb}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : ME7 → ME7 → Bool
  | x, t | x, z | c, z | xa, c | c, y | yb, y | tb, yb => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : ME7) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph ME7 := SimpleGraph.fromRel o

lemma adj_iff (u v : ME7) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : ME7) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : ME7) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : ME7) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : ME7 → Option ME7
  | c => none
  | xa => some c
  | z => some c
  | x => some z
  | t => some x
  | y => some c
  | yb => some y
  | tb => some yb

/-- The height. -/
def ht : ME7 → ℕ
  | c => 0
  | xa => 1
  | z => 1
  | x => 2
  | t => 3
  | y => 1
  | yb => 2
  | tb => 3

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `Ẽ₇` (long arms listed from the centre). -/
def cmap : AffineE7 → ME7
  | .center => c
  | .short => xa
  | .inner i => if (i : ℕ) = 0 then z else y
  | .middle i => if (i : ℕ) = 0 then x else yb
  | .outer i => if (i : ℕ) = 0 then t else tb

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `Ẽ₇`. -/
def copy : (underlyingGraph AffineE7).Copy G :=
  copyOf G cmap (by
    intro u v h
    rcases u with _ | _ | i | i | i <;> rcases v with _ | _ | j | j | j <;>
      (try fin_cases i) <;> (try fin_cases j) <;> simp_all [cmap])
    (by
      intro a b e
      change AffineE7.Arrow a b at e
      cases e with
      | outerMiddle i => fin_cases i <;> simp only [cmap] <;> decide
      | middleInner i => fin_cases i <;> simp only [cmap] <;> decide
      | innerCenter i => fin_cases i <;> simp only [cmap] <;> decide
      | shortCenter => simp only [cmap]; decide)

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {Cz Xa Z X T Y Yb Tb : P}
  (δ : X ⟶ T) (γ₁ : X ⟶ Z) (τ' : Cz ⟶ Z) (γ₂ : Xa ⟶ Cz) (α : Cz ⟶ Y) (ρ : Yb ⟶ Y) (β : Tb ⟶ Yb)

/-- The objects. -/
def obj : ME7 → P
  | c => Cz | xa => Xa | z => Z | x => X | t => T | y => Y | yb => Yb | tb => Tb

/-- The arrows. -/
def arr : ∀ u v : ME7, o u v → ((obj (Cz := Cz) (Xa := Xa) (Z := Z) (X := X) (T := T) (Y := Y) (Yb := Yb) (Tb := Tb) u) ⟶ obj (Cz := Cz) (Xa := Xa) (Z := Z) (X := X) (T := T) (Y := Y) (Yb := Yb) (Tb := Tb) v)
  | x, t, _ => δ
  | x, z, _ => γ₁
  | c, z, _ => τ'
  | xa, c, _ => γ₂
  | c, y, _ => α
  | yb, y, _ => ρ
  | tb, yb, _ => β
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : ME7, Option ((obj (Cz := Cz) (Xa := Xa) (Z := Z) (X := X) (T := T) (Y := Y) (Yb := Yb) (Tb := Tb) u) ⟶ obj (Cz := Cz) (Xa := Xa) (Z := Z) (X := X) (T := T) (Y := Y) (Yb := Yb) (Tb := Tb) v)
  | c, c => some (𝟙 _)
  | c, z => some (τ')
  | c, y => some (α)
  | xa, xa => some (𝟙 _)
  | xa, c => some (γ₂)
  | xa, z => some (γ₂ ≫ τ')
  | xa, y => some (γ₂ ≫ α)
  | z, z => some (𝟙 _)
  | x, x => some (𝟙 _)
  | x, t => some (δ)
  | x, z => some (γ₁)
  | t, t => some (𝟙 _)
  | y, y => some (𝟙 _)
  | yb, yb => some (𝟙 _)
  | yb, y => some (ρ)
  | tb, tb => some (𝟙 _)
  | tb, yb => some (β)
  | tb, y => some (β ≫ ρ)
  | _, _ => none

end Diagram

end ME7

end RayCat

namespace RayCat

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type u} [Field k] [Infinite k]

set_option maxHeartbeats 8000000 in
open ME7 in
/-- **No cleaving diagram `ME7` in `P/τ`.** -/
theorem MildHyp.not_me7 (hM : MildHyp k P)
    {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {Cz Xa Z X T Y Yb Tb : P}
    (δ : X ⟶ T) (γ₁ : X ⟶ Z) (τ' : Cz ⟶ Z) (γ₂ : Xa ⟶ Cz) (α : Cz ⟶ Y) (ρ : Yb ⟶ Y) (β : Tb ⟶ Yb)
    (h0_c_z : ¬FactorsThroughMorphism τ (τ'))
    (h0_c_y : ¬FactorsThroughMorphism τ (α))
    (h0_xa_c : ¬FactorsThroughMorphism τ (γ₂))
    (h0_xa_z : ¬FactorsThroughMorphism τ (γ₂ ≫ τ'))
    (h0_xa_y : ¬FactorsThroughMorphism τ (γ₂ ≫ α))
    (h0_x_t : ¬FactorsThroughMorphism τ (δ))
    (h0_x_z : ¬FactorsThroughMorphism τ (γ₁))
    (h0_yb_y : ¬FactorsThroughMorphism τ (ρ))
    (h0_tb_yb : ¬FactorsThroughMorphism τ (β))
    (h0_tb_y : ¬FactorsThroughMorphism τ (β ≫ ρ))
    (hi_δ : ¬IsIso δ)
    (hi_γ₁ : ¬IsIso γ₁)
    (hi_τ' : ¬IsIso τ')
    (hi_γ₂ : ¬IsIso γ₂)
    (hi_α : ¬IsIso α)
    (hi_ρ : ¬IsIso ρ)
    (hi_β : ¬IsIso β)
    (hl_τ'_α_y : ¬∃ g, τ' ≫ g = α)
    (hl_α_τ'_z : ¬∃ g, α ≫ g = τ')
    (hl_δ_γ₁_z : ¬∃ g, δ ≫ g = γ₁)
    (hl_γ₁_δ_t : ¬∃ g, γ₁ ≫ g = δ)
    (hr_γ₁_τ'_c : ¬∃ g, g ≫ γ₁ = τ')
    (hr_γ₁_τ'_xa : ¬∃ g, g ≫ γ₁ = γ₂ ≫ τ')
    (hr_τ'_γ₁_x : ¬∃ g, g ≫ τ' = γ₁)
    (hr_α_ρ_yb : ¬∃ g, g ≫ α = ρ)
    (hr_α_ρ_tb : ¬∃ g, g ≫ α = β ≫ ρ)
    (hr_ρ_α_c : ¬∃ g, g ≫ ρ = α)
    (hr_ρ_α_xa : ¬∃ g, g ≫ ρ = γ₂ ≫ α)
    : False := by
  haveI : Fact (LargeIndecomposable.Foundations.Quiver.IsAcyclic (OT G o)) := ⟨OT.isAcyclic ho hasym isAcyclic⟩
  refine hM.not_tree_table τ hτ hτ0 G o ho hasym isAcyclic
    (OT.not_isRepresentationFinite_affineE7 ho hcov k copy) obj (arr δ γ₁ τ' γ₂ α ρ β)
    (tab δ γ₁ τ' γ₂ α ρ β) (fun v ↦ by cases v <;> rfl) ?_ ?_ ?_ ?_ ?_
  · intro x y z h f hf
    cases y <;> cases z <;> (try exact absurd h (by decide)) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; rfl)
      | rfl
  · intro x y f hf hne
    cases x <;> cases y <;> (try exact absurd rfl hne) <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;> assumption
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | assumption
  · intro x c c' y h h' f hne hf
    cases x <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases y <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.comp_id]; assumption)
      | assumption
  · intro x c c' y h h' f hne hf
    cases y <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; assumption)
      | assumption

end RayCat

