/-!
# The tree diagram `ME8`

[mild] figure 2.2 (second diagram): the `Ẽ₈` tree `t ← x ← x'' → z ← z' → y ← y' ← t'`, `x'' → t''`.

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `ME8`. -/
inductive ME8
  | xc | td | x | t | z | c | y | yb | tb
  deriving DecidableEq

namespace ME8

instance : Fintype ME8 := ⟨{xc, td, x, t, z, c, y, yb, tb}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : ME8 → ME8 → Bool
  | xc, x | x, t | xc, td | xc, z | c, z | c, y | yb, y | tb, yb => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : ME8) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph ME8 := SimpleGraph.fromRel o

lemma adj_iff (u v : ME8) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : ME8) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : ME8) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : ME8) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : ME8 → Option ME8
  | xc => none
  | td => some xc
  | x => some xc
  | t => some x
  | z => some xc
  | c => some z
  | y => some c
  | yb => some y
  | tb => some yb

/-- The height. -/
def ht : ME8 → ℕ
  | xc => 0
  | td => 1
  | x => 1
  | t => 2
  | z => 1
  | c => 2
  | y => 3
  | yb => 4
  | tb => 5

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `Ẽ₈` (arms listed from the centre). -/
def cmap : AffineE8 → ME8
  | .center => xc
  | .short => td
  | .medium4 => x
  | .medium2 => t
  | .long5 => z
  | .long4 => c
  | .long3 => y
  | .long2 => yb
  | .long1 => tb

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `Ẽ₈`. -/
def copy : (underlyingGraph AffineE8).Copy G :=
  copyOf G cmap (by
    intro u v h
    cases u <;> cases v <;> simp_all [cmap])
    (by
      intro a b e
      change AffineE8.Arrow a b at e
      cases e <;> simp only [cmap] <;> decide)

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {Xc Td X T Z Cz Y Yb Tb : P}
  (ξ : Xc ⟶ X) (δ₁ : X ⟶ T) (δ₂ : Xc ⟶ Td) (γ : Xc ⟶ Z) (τ' : Cz ⟶ Z) (α : Cz ⟶ Y) (ρ : Yb ⟶ Y) (β : Tb ⟶ Yb)

/-- The objects. -/
def obj : ME8 → P
  | xc => Xc | td => Td | x => X | t => T | z => Z | c => Cz | y => Y | yb => Yb | tb => Tb

/-- The arrows. -/
def arr : ∀ u v : ME8, o u v → ((obj (Xc := Xc) (Td := Td) (X := X) (T := T) (Z := Z) (Cz := Cz) (Y := Y) (Yb := Yb) (Tb := Tb) u) ⟶ obj (Xc := Xc) (Td := Td) (X := X) (T := T) (Z := Z) (Cz := Cz) (Y := Y) (Yb := Yb) (Tb := Tb) v)
  | xc, x, _ => ξ
  | x, t, _ => δ₁
  | xc, td, _ => δ₂
  | xc, z, _ => γ
  | c, z, _ => τ'
  | c, y, _ => α
  | yb, y, _ => ρ
  | tb, yb, _ => β
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : ME8, Option ((obj (Xc := Xc) (Td := Td) (X := X) (T := T) (Z := Z) (Cz := Cz) (Y := Y) (Yb := Yb) (Tb := Tb) u) ⟶ obj (Xc := Xc) (Td := Td) (X := X) (T := T) (Z := Z) (Cz := Cz) (Y := Y) (Yb := Yb) (Tb := Tb) v)
  | xc, xc => some (𝟙 _)
  | xc, x => some (ξ)
  | xc, t => some (ξ ≫ δ₁)
  | xc, td => some (δ₂)
  | xc, z => some (γ)
  | td, td => some (𝟙 _)
  | x, x => some (𝟙 _)
  | x, t => some (δ₁)
  | t, t => some (𝟙 _)
  | z, z => some (𝟙 _)
  | c, c => some (𝟙 _)
  | c, z => some (τ')
  | c, y => some (α)
  | y, y => some (𝟙 _)
  | yb, yb => some (𝟙 _)
  | yb, y => some (ρ)
  | tb, tb => some (𝟙 _)
  | tb, yb => some (β)
  | tb, y => some (β ≫ ρ)
  | _, _ => none

end Diagram

end ME8

