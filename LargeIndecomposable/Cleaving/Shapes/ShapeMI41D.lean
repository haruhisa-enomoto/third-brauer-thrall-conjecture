/-- The orientation. -/
def ob : MI41D → MI41D → Bool
  | Y0, Y1 | Y1, Y2 | Y2, Y3 | Xx, Y2 | Y1, Zz => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : MI41D) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph MI41D := SimpleGraph.fromRel o

lemma adj_iff (u v : MI41D) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : MI41D) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : MI41D) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : MI41D) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : MI41D → Option MI41D
  | Y0 => none
  | Y1 => some Y0
  | Y2 => some Y1
  | Y3 => some Y2
  | Xx => some Y2
  | Zz => some Y1

/-- The height. -/
def ht : MI41D → ℕ
  | Y0 => 0
  | Y1 => 1
  | Y2 => 2
  | Y3 => 3
  | Xx => 3
  | Zz => 2

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

