  (W₁ : X ⟶ C') (V₁ : X ⟶ Aa) (σ₂' : X₂ ⟶ Aa) (ρ₁' : Aa ⟶ Y₁) (r : Xn ⟶ Aa) (σn : Xn ⟶ Yn1) (ρn1 : Xn1 ⟶ Yn1) (σn1 : Xn1 ⟶ Yn2)

