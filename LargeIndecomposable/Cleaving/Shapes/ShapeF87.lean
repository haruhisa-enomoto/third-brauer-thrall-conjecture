/-- The morphisms. -/
abbrev tab : ∀ u v : F87, (obj (X := X) (C' := C') (Aa := Aa) (X₂ := X₂) (Y₁ := Y₁) (Xn := Xn) (Yn1 := Yn1) (Xn1 := Xn1) (Yn2 := Yn2) u) ⟶ obj (X := X) (C' := C') (Aa := Aa) (X₂ := X₂) (Y₁ := Y₁) (Xn := Xn) (Yn1 := Yn1) (Xn1 := Xn1) (Yn2 := Yn2) v
  | a, a => 𝟙 _
