/-- Vertices of the diagram `F87`. -/
inductive F87
  | x | c' | a | x₂ | y₁ | xn | yn1 | xn1 | yn2
  deriving DecidableEq

namespace F87

instance : Fintype F87 := ⟨{x, c', a, x₂, y₁, xn, yn1, xn1, yn2}, by intro v; cases v <;> simp⟩

/-- The order (nonzero morphisms). -/
def leb : F87 → F87 → Bool
  | a, a | a, y₁ | c', c' | x, a | x, c' | x, x | x, y₁ | xn, a | xn, xn | xn, yn1 | xn1, xn1 | xn1, yn1 | xn1, yn2 | x₂, a | x₂, x₂ | x₂, y₁ | yn1, yn1 | yn2, yn2 | y₁, y₁ => true
  | _, _ => false

/-- The arrows. -/
def arb : F87 → F87 → Bool
  | a, y₁ | x, a | x, c' | xn, a | xn, yn1 | xn1, yn1 | xn1, yn2 | x₂, a => true
  | _, _ => false

/-- The thin category. -/
abbrev thin : ThinData F87 where
  le x y := leb x y = true
  nz x _ z := leb x z = true
  refl x := by cases x <;> rfl
  antisymm := by decide
  nz_le _ _ _ _ _ h := h
  nz_left _ _ h := h
  nz_right _ _ h := h
  assoc := by decide

/-- The generating arrows. -/
abbrev arrows : ThinArrows thin where
  ar x y := arb x y = true
  ar_le := by decide
  ar_ne := by decide
  first := by decide
  last := by decide

