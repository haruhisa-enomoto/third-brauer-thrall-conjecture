/-!
# The tree diagram `F7A`

BO13a figure 7.2 (first tree): the `Ẽ₆` tree `x → a₀ → a`, `a → b → y₀`, `a → y₁ ← e`.

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `F7A`. -/
inductive F7A
  | a | a₀ | x | b | y₀ | y₁ | e
  deriving DecidableEq

namespace F7A

instance : Fintype F7A := ⟨{a, a₀, x, b, y₀, y₁, e}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : F7A → F7A → Bool
  | x, a₀ | a₀, a | a, b | b, y₀ | a, y₁ | e, y₁ => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : F7A) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph F7A := SimpleGraph.fromRel o

lemma adj_iff (u v : F7A) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : F7A) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : F7A) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : F7A) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : F7A → Option F7A
  | a => none
  | a₀ => some a
  | x => some a₀
  | b => some a
  | y₀ => some b
  | y₁ => some a
  | e => some y₁

/-- The height. -/
def ht : F7A → ℕ
  | a => 0
  | a₀ => 1
  | x => 2
  | b => 1
  | y₀ => 2
  | y₁ => 1
  | e => 2

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `Ẽ₆`. -/
def cmap : AffineE6 → F7A
  | .center => a
  | .inner i => if (i : ℕ) = 0 then a₀ else if (i : ℕ) = 1 then b else y₁
  | .outer i => if (i : ℕ) = 0 then x else if (i : ℕ) = 1 then y₀ else e

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `Ẽ₆`. -/
def copy : (underlyingGraph AffineE6).Copy G :=
  copyOf G cmap (by
    intro u v h
    rcases u with _ | i | i <;> rcases v with _ | j | j <;>
      (try fin_cases i) <;> (try fin_cases j) <;> simp_all [cmap])
    (by
      intro a b e
      rcases a with _ | i | i <;> rcases b with _ | j | j
      all_goals first
        | exact (IsEmpty.false e).elim
        | exact e.elim
        | (obtain rfl : i = j := e.down; fin_cases i <;> simp only [cmap] <;> decide)
        | (fin_cases i <;> simp only [cmap] <;> decide))

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {Aa A₀ X Bb Y₀ Y₁ E : P}
  (p : X ⟶ A₀) (q : A₀ ⟶ Aa) (V₂ : Aa ⟶ Bb) (V₃ : Bb ⟶ Y₀) (r : Aa ⟶ Y₁) (η : E ⟶ Y₁)

/-- The objects. -/
def obj : F7A → P
  | a => Aa | a₀ => A₀ | x => X | b => Bb | y₀ => Y₀ | y₁ => Y₁ | e => E

/-- The arrows. -/
def arr : ∀ u v : F7A, o u v → ((obj (Aa := Aa) (A₀ := A₀) (X := X) (Bb := Bb) (Y₀ := Y₀) (Y₁ := Y₁) (E := E) u) ⟶ obj (Aa := Aa) (A₀ := A₀) (X := X) (Bb := Bb) (Y₀ := Y₀) (Y₁ := Y₁) (E := E) v)
  | x, a₀, _ => p
  | a₀, a, _ => q
  | a, b, _ => V₂
  | b, y₀, _ => V₃
  | a, y₁, _ => r
  | e, y₁, _ => η
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : F7A, Option ((obj (Aa := Aa) (A₀ := A₀) (X := X) (Bb := Bb) (Y₀ := Y₀) (Y₁ := Y₁) (E := E) u) ⟶ obj (Aa := Aa) (A₀ := A₀) (X := X) (Bb := Bb) (Y₀ := Y₀) (Y₁ := Y₁) (E := E) v)
  | a, a => some (𝟙 _)
  | a, b => some (V₂)
  | a, y₀ => some (V₂ ≫ V₃)
  | a, y₁ => some (r)
  | a₀, a₀ => some (𝟙 _)
  | a₀, a => some (q)
  | a₀, b => some (q ≫ V₂)
  | a₀, y₀ => some ((q ≫ V₂) ≫ V₃)
  | a₀, y₁ => some (q ≫ r)
  | x, x => some (𝟙 _)
  | x, a₀ => some (p)
  | x, a => some (p ≫ q)
  | x, b => some ((p ≫ q) ≫ V₂)
  | x, y₀ => some (((p ≫ q) ≫ V₂) ≫ V₃)
  | x, y₁ => some ((p ≫ q) ≫ r)
  | b, b => some (𝟙 _)
  | b, y₀ => some (V₃)
  | y₀, y₀ => some (𝟙 _)
  | y₁, y₁ => some (𝟙 _)
  | e, e => some (𝟙 _)
  | e, y₁ => some (η)
  | _, _ => none

end Diagram

