module

public import LargeIndecomposable.Cleaving.Shapes.ShapeD6
public import LargeIndecomposable.Cleaving.Diagrams.Tools

/-!
# The tree diagram `SE6`

Star `Ẽ₆` at the end `y` of a mild contour: arms `s₁ → t₁ → y` along `v`, `s₂ → t₂ → y` along `w`, and the tail `y → a → y` along `ρ = ω' ≫ α`.

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `SE6`. -/
inductive SE6
  | Y | T1 | S1 | T2 | S2 | A3 | Y4
  deriving DecidableEq

namespace SE6

instance : Fintype SE6 := ⟨{Y, T1, S1, T2, S2, A3, Y4}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : SE6 → SE6 → Bool
  | S1, T1 | T1, Y | S2, T2 | T2, Y | Y, A3 | A3, Y4 => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : SE6) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph SE6 := SimpleGraph.fromRel o

lemma adj_iff (u v : SE6) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : SE6) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : SE6) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : SE6) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : SE6 → Option SE6
  | Y => none
  | T1 => some Y
  | S1 => some T1
  | T2 => some Y
  | S2 => some T2
  | A3 => some Y
  | Y4 => some A3

/-- The height. -/
def ht : SE6 → ℕ
  | Y => 0
  | T1 => 1
  | S1 => 2
  | T2 => 1
  | S2 => 2
  | A3 => 1
  | Y4 => 2

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `Ẽ₆`. -/
def cmap : AffineE6 → SE6
  | .center => Y
  | .inner i => if (i : ℕ) = 0 then T1 else if (i : ℕ) = 1 then T2 else A3
  | .outer i => if (i : ℕ) = 0 then S1 else if (i : ℕ) = 1 then S2 else Y4

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `Ẽ₆`. -/
def copy : (underlyingGraph AffineE6).Copy G :=
  copyOf G cmap (by
    intro u v h
    rcases u with _ | i | i <;> rcases v with _ | j | j <;>
      (try fin_cases i) <;> (try fin_cases j) <;> simp_all [cmap])
    (by
      intro a b e
      rcases a with _ | i | i <;> rcases b with _ | j | j
      all_goals first
        | exact (IsEmpty.false e).elim
        | exact e.elim
        | (obtain rfl : i = j := e.down; fin_cases i <;> simp only [cmap] <;> decide)
        | (fin_cases i <;> simp only [cmap] <;> decide))

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {OY OT1 OS1 OT2 OS2 OA3 OY4 : P}
  (u : OS1 ⟶ OT1) (α : OT1 ⟶ OY) (u' : OS2 ⟶ OT2) (β : OT2 ⟶ OY) (ω : OY ⟶ OA3) (α₂ : OA3 ⟶ OY4)

/-- The objects. -/
def obj : SE6 → P
  | Y => OY | T1 => OT1 | S1 => OS1 | T2 => OT2 | S2 => OS2 | A3 => OA3 | Y4 => OY4

/-- The arrows. -/
def arr : ∀ u v : SE6, o u v → ((obj (OY := OY) (OT1 := OT1) (OS1 := OS1) (OT2 := OT2) (OS2 := OS2) (OA3 := OA3) (OY4 := OY4) u) ⟶ obj (OY := OY) (OT1 := OT1) (OS1 := OS1) (OT2 := OT2) (OS2 := OS2) (OA3 := OA3) (OY4 := OY4) v)
  | S1, T1, _ => u
  | T1, Y, _ => α
  | S2, T2, _ => u'
  | T2, Y, _ => β
  | Y, A3, _ => ω
  | A3, Y4, _ => α₂
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : SE6, Option ((obj (OY := OY) (OT1 := OT1) (OS1 := OS1) (OT2 := OT2) (OS2 := OS2) (OA3 := OA3) (OY4 := OY4) u) ⟶ obj (OY := OY) (OT1 := OT1) (OS1 := OS1) (OT2 := OT2) (OS2 := OS2) (OA3 := OA3) (OY4 := OY4) v)
  | Y, Y => some (𝟙 _)
  | Y, A3 => some (ω)
  | Y, Y4 => some (ω ≫ α₂)
  | T1, T1 => some (𝟙 _)
  | T1, Y => some (α)
  | T1, A3 => some (α ≫ ω)
  | T1, Y4 => some ((α ≫ ω) ≫ α₂)
  | S1, S1 => some (𝟙 _)
  | S1, T1 => some (u)
  | S1, Y => some (u ≫ α)
  | S1, A3 => some ((u ≫ α) ≫ ω)
  | S1, Y4 => some (((u ≫ α) ≫ ω) ≫ α₂)
  | T2, T2 => some (𝟙 _)
  | T2, Y => some (β)
  | T2, A3 => some (β ≫ ω)
  | T2, Y4 => some ((β ≫ ω) ≫ α₂)
  | S2, S2 => some (𝟙 _)
  | S2, T2 => some (u')
  | S2, Y => some (u' ≫ β)
  | S2, A3 => some ((u' ≫ β) ≫ ω)
  | S2, Y4 => some (((u' ≫ β) ≫ ω) ≫ α₂)
  | A3, A3 => some (𝟙 _)
  | A3, Y4 => some (α₂)
  | Y4, Y4 => some (𝟙 _)
  | _, _ => none

end Diagram

end SE6

end RayCat

namespace RayCat

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type u} [Field k] [Infinite k]

set_option maxHeartbeats 8000000 in
open SE6 in
/-- **No cleaving diagram `SE6` in `P/τ`.** -/
theorem MildHyp.not_se6 (hM : MildHyp k P)
    {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {OY OT1 OS1 OT2 OS2 OA3 OY4 : P}
    (u : OS1 ⟶ OT1) (α : OT1 ⟶ OY) (u' : OS2 ⟶ OT2) (β : OT2 ⟶ OY) (ω : OY ⟶ OA3) (α₂ : OA3 ⟶ OY4)
    (h0_Y_A3 : ¬FactorsThroughMorphism τ (ω))
    (h0_Y_Y4 : ¬FactorsThroughMorphism τ (ω ≫ α₂))
    (h0_T1_Y : ¬FactorsThroughMorphism τ (α))
    (h0_T1_A3 : ¬FactorsThroughMorphism τ (α ≫ ω))
    (h0_T1_Y4 : ¬FactorsThroughMorphism τ ((α ≫ ω) ≫ α₂))
    (h0_S1_T1 : ¬FactorsThroughMorphism τ (u))
    (h0_S1_Y : ¬FactorsThroughMorphism τ (u ≫ α))
    (h0_S1_A3 : ¬FactorsThroughMorphism τ ((u ≫ α) ≫ ω))
    (h0_S1_Y4 : ¬FactorsThroughMorphism τ (((u ≫ α) ≫ ω) ≫ α₂))
    (h0_T2_Y : ¬FactorsThroughMorphism τ (β))
    (h0_T2_A3 : ¬FactorsThroughMorphism τ (β ≫ ω))
    (h0_T2_Y4 : ¬FactorsThroughMorphism τ ((β ≫ ω) ≫ α₂))
    (h0_S2_T2 : ¬FactorsThroughMorphism τ (u'))
    (h0_S2_Y : ¬FactorsThroughMorphism τ (u' ≫ β))
    (h0_S2_A3 : ¬FactorsThroughMorphism τ ((u' ≫ β) ≫ ω))
    (h0_S2_Y4 : ¬FactorsThroughMorphism τ (((u' ≫ β) ≫ ω) ≫ α₂))
    (h0_A3_Y4 : ¬FactorsThroughMorphism τ (α₂))
    (hi_u : ¬IsIso u)
    (hi_α : ¬IsIso α)
    (hi_u' : ¬IsIso u')
    (hi_β : ¬IsIso β)
    (hi_ω : ¬IsIso ω)
    (hi_α₂ : ¬IsIso α₂)
    (hr_α_β_T2 : ¬∃ g, g ≫ α = β)
    (hr_α_β_S2 : ¬∃ g, g ≫ α = u' ≫ β)
    (hr_β_α_T1 : ¬∃ g, g ≫ β = α)
    (hr_β_α_S1 : ¬∃ g, g ≫ β = u ≫ α)
    : False := by
  haveI : Fact (LargeIndecomposable.Foundations.Quiver.IsAcyclic (OT G o)) := ⟨OT.isAcyclic ho hasym isAcyclic⟩
  refine hM.not_tree_table τ hτ hτ0 G o ho hasym isAcyclic
    (OT.not_isRepresentationFinite_affineE6 ho hcov k copy) obj (arr u α u' β ω α₂)
    (tab u α u' β ω α₂) (fun v ↦ by cases v <;> rfl) ?_ ?_ ?_ ?_ ?_
  · intro x y z h f hf
    cases y <;> cases z <;> (try exact absurd h (by decide)) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; rfl)
      | rfl
  · intro x y f hf hne
    cases x <;> cases y <;> (try exact absurd rfl hne) <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;> assumption
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | assumption
  · intro x c c' y h h' f hne hf
    cases x <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases y <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.comp_id]; assumption)
      | assumption
  · intro x c c' y h h' f hne hf
    cases y <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; assumption)
      | assumption

end RayCat

end LargeIndecomposable
