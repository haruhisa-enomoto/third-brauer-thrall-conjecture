module

public import LargeIndecomposable.Cleaving.Shapes.ShapeD6
public import LargeIndecomposable.Cleaving.Basic.Tools

/-!
# The tree diagram `SE7`

Star `Ẽ₇` at the end `y` of a mild contour: the arm `y → c → a → y` along the last cycle of `v`, the tail `y → c → a → y` along `ρ = κ ≫ ε ≫ α`, and `b → y` along `β`.

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `SE7`. -/
inductive SE7
  | Y | A1 | C1 | YM | C2 | A2 | Y4 | B
  deriving DecidableEq

namespace SE7

instance : Fintype SE7 := ⟨{Y, A1, C1, YM, C2, A2, Y4, B}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : SE7 → SE7 → Bool
  | YM, C1 | C1, A1 | A1, Y | B, Y | Y, C2 | C2, A2 | A2, Y4 => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : SE7) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph SE7 := SimpleGraph.fromRel o

lemma adj_iff (u v : SE7) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : SE7) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : SE7) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : SE7) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : SE7 → Option SE7
  | Y => none
  | A1 => some Y
  | C1 => some A1
  | YM => some C1
  | C2 => some Y
  | A2 => some C2
  | Y4 => some A2
  | B => some Y

/-- The height. -/
def ht : SE7 → ℕ
  | Y => 0
  | A1 => 1
  | C1 => 2
  | YM => 3
  | C2 => 1
  | A2 => 2
  | Y4 => 3
  | B => 1

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `Ẽ₇` (long arms listed from the centre). -/
def cmap : AffineE7 → SE7
  | .center => Y
  | .short => B
  | .inner i => if (i : ℕ) = 0 then A1 else C2
  | .middle i => if (i : ℕ) = 0 then C1 else A2
  | .outer i => if (i : ℕ) = 0 then YM else Y4

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `Ẽ₇`. -/
def copy : (underlyingGraph AffineE7).Copy G :=
  copyOf G cmap (by
    intro u v h
    rcases u with _ | _ | i | i | i <;> rcases v with _ | _ | j | j | j <;>
      (try fin_cases i) <;> (try fin_cases j) <;> simp_all [cmap])
    (by
      intro a b e
      change AffineE7.Arrow a b at e
      cases e with
      | outerMiddle i => fin_cases i <;> simp only [cmap] <;> decide
      | middleInner i => fin_cases i <;> simp only [cmap] <;> decide
      | innerCenter i => fin_cases i <;> simp only [cmap] <;> decide
      | shortCenter => simp only [cmap]; decide)

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {OY OA1 OC1 OYM OC2 OA2 OY4 OB : P}
  (κ : OYM ⟶ OC1) (ε : OC1 ⟶ OA1) (α : OA1 ⟶ OY) (β : OB ⟶ OY) (κ₂ : OY ⟶ OC2) (ε₂ : OC2 ⟶ OA2) (α₂ : OA2 ⟶ OY4)

/-- The objects. -/
def obj : SE7 → P
  | Y => OY | A1 => OA1 | C1 => OC1 | YM => OYM | C2 => OC2 | A2 => OA2 | Y4 => OY4 | B => OB

/-- The arrows. -/
def arr : ∀ u v : SE7, o u v → ((obj (OY := OY) (OA1 := OA1) (OC1 := OC1) (OYM := OYM) (OC2 := OC2) (OA2 := OA2) (OY4 := OY4) (OB := OB) u) ⟶ obj (OY := OY) (OA1 := OA1) (OC1 := OC1) (OYM := OYM) (OC2 := OC2) (OA2 := OA2) (OY4 := OY4) (OB := OB) v)
  | YM, C1, _ => κ
  | C1, A1, _ => ε
  | A1, Y, _ => α
  | B, Y, _ => β
  | Y, C2, _ => κ₂
  | C2, A2, _ => ε₂
  | A2, Y4, _ => α₂
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : SE7, Option ((obj (OY := OY) (OA1 := OA1) (OC1 := OC1) (OYM := OYM) (OC2 := OC2) (OA2 := OA2) (OY4 := OY4) (OB := OB) u) ⟶ obj (OY := OY) (OA1 := OA1) (OC1 := OC1) (OYM := OYM) (OC2 := OC2) (OA2 := OA2) (OY4 := OY4) (OB := OB) v)
  | Y, Y => some (𝟙 _)
  | Y, C2 => some (κ₂)
  | Y, A2 => some (κ₂ ≫ ε₂)
  | Y, Y4 => some ((κ₂ ≫ ε₂) ≫ α₂)
  | A1, A1 => some (𝟙 _)
  | A1, Y => some (α)
  | A1, C2 => some (α ≫ κ₂)
  | A1, A2 => some ((α ≫ κ₂) ≫ ε₂)
  | A1, Y4 => some (((α ≫ κ₂) ≫ ε₂) ≫ α₂)
  | C1, C1 => some (𝟙 _)
  | C1, A1 => some (ε)
  | C1, Y => some (ε ≫ α)
  | C1, C2 => some ((ε ≫ α) ≫ κ₂)
  | C1, A2 => some (((ε ≫ α) ≫ κ₂) ≫ ε₂)
  | C1, Y4 => some ((((ε ≫ α) ≫ κ₂) ≫ ε₂) ≫ α₂)
  | YM, YM => some (𝟙 _)
  | YM, C1 => some (κ)
  | YM, A1 => some (κ ≫ ε)
  | YM, Y => some ((κ ≫ ε) ≫ α)
  | YM, C2 => some (((κ ≫ ε) ≫ α) ≫ κ₂)
  | YM, A2 => some ((((κ ≫ ε) ≫ α) ≫ κ₂) ≫ ε₂)
  | YM, Y4 => some (((((κ ≫ ε) ≫ α) ≫ κ₂) ≫ ε₂) ≫ α₂)
  | C2, C2 => some (𝟙 _)
  | C2, A2 => some (ε₂)
  | C2, Y4 => some (ε₂ ≫ α₂)
  | A2, A2 => some (𝟙 _)
  | A2, Y4 => some (α₂)
  | Y4, Y4 => some (𝟙 _)
  | B, B => some (𝟙 _)
  | B, Y => some (β)
  | B, C2 => some (β ≫ κ₂)
  | B, A2 => some ((β ≫ κ₂) ≫ ε₂)
  | B, Y4 => some (((β ≫ κ₂) ≫ ε₂) ≫ α₂)
  | _, _ => none

end Diagram

end SE7

end RayCat

namespace RayCat

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type u} [Field k] [Infinite k]

set_option maxHeartbeats 8000000 in
open SE7 in
/-- **No cleaving diagram `SE7` in `P/τ`.** -/
theorem MildHyp.not_se7 (hM : MildHyp k P)
    {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {OY OA1 OC1 OYM OC2 OA2 OY4 OB : P}
    (κ : OYM ⟶ OC1) (ε : OC1 ⟶ OA1) (α : OA1 ⟶ OY) (β : OB ⟶ OY) (κ₂ : OY ⟶ OC2) (ε₂ : OC2 ⟶ OA2) (α₂ : OA2 ⟶ OY4)
    (h0_Y_C2 : ¬FactorsThroughMorphism τ (κ₂))
    (h0_Y_A2 : ¬FactorsThroughMorphism τ (κ₂ ≫ ε₂))
    (h0_Y_Y4 : ¬FactorsThroughMorphism τ ((κ₂ ≫ ε₂) ≫ α₂))
    (h0_A1_Y : ¬FactorsThroughMorphism τ (α))
    (h0_A1_C2 : ¬FactorsThroughMorphism τ (α ≫ κ₂))
    (h0_A1_A2 : ¬FactorsThroughMorphism τ ((α ≫ κ₂) ≫ ε₂))
    (h0_A1_Y4 : ¬FactorsThroughMorphism τ (((α ≫ κ₂) ≫ ε₂) ≫ α₂))
    (h0_C1_A1 : ¬FactorsThroughMorphism τ (ε))
    (h0_C1_Y : ¬FactorsThroughMorphism τ (ε ≫ α))
    (h0_C1_C2 : ¬FactorsThroughMorphism τ ((ε ≫ α) ≫ κ₂))
    (h0_C1_A2 : ¬FactorsThroughMorphism τ (((ε ≫ α) ≫ κ₂) ≫ ε₂))
    (h0_C1_Y4 : ¬FactorsThroughMorphism τ ((((ε ≫ α) ≫ κ₂) ≫ ε₂) ≫ α₂))
    (h0_YM_C1 : ¬FactorsThroughMorphism τ (κ))
    (h0_YM_A1 : ¬FactorsThroughMorphism τ (κ ≫ ε))
    (h0_YM_Y : ¬FactorsThroughMorphism τ ((κ ≫ ε) ≫ α))
    (h0_YM_C2 : ¬FactorsThroughMorphism τ (((κ ≫ ε) ≫ α) ≫ κ₂))
    (h0_YM_A2 : ¬FactorsThroughMorphism τ ((((κ ≫ ε) ≫ α) ≫ κ₂) ≫ ε₂))
    (h0_YM_Y4 : ¬FactorsThroughMorphism τ (((((κ ≫ ε) ≫ α) ≫ κ₂) ≫ ε₂) ≫ α₂))
    (h0_C2_A2 : ¬FactorsThroughMorphism τ (ε₂))
    (h0_C2_Y4 : ¬FactorsThroughMorphism τ (ε₂ ≫ α₂))
    (h0_A2_Y4 : ¬FactorsThroughMorphism τ (α₂))
    (h0_B_Y : ¬FactorsThroughMorphism τ (β))
    (h0_B_C2 : ¬FactorsThroughMorphism τ (β ≫ κ₂))
    (h0_B_A2 : ¬FactorsThroughMorphism τ ((β ≫ κ₂) ≫ ε₂))
    (h0_B_Y4 : ¬FactorsThroughMorphism τ (((β ≫ κ₂) ≫ ε₂) ≫ α₂))
    (hi_κ : ¬IsIso κ)
    (hi_ε : ¬IsIso ε)
    (hi_α : ¬IsIso α)
    (hi_β : ¬IsIso β)
    (hi_κ₂ : ¬IsIso κ₂)
    (hi_ε₂ : ¬IsIso ε₂)
    (hi_α₂ : ¬IsIso α₂)
    (hr_α_β_B : ¬∃ g, g ≫ α = β)
    (hr_β_α_A1 : ¬∃ g, g ≫ β = α)
    (hr_β_α_C1 : ¬∃ g, g ≫ β = ε ≫ α)
    (hr_β_α_YM : ¬∃ g, g ≫ β = (κ ≫ ε) ≫ α)
    : False := by
  haveI : Fact (LargeIndecomposable.Foundations.Quiver.IsAcyclic (OT G o)) := ⟨OT.isAcyclic ho hasym isAcyclic⟩
  refine hM.not_tree_table τ hτ hτ0 G o ho hasym isAcyclic
    (OT.not_isRepresentationFinite_affineE7 ho hcov k copy) obj (arr κ ε α β κ₂ ε₂ α₂)
    (tab κ ε α β κ₂ ε₂ α₂) (fun v ↦ by cases v <;> rfl) ?_ ?_ ?_ ?_ ?_
  · intro x y z h f hf
    cases y <;> cases z <;> (try exact absurd h (by decide)) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; rfl)
      | rfl
  · intro x y f hf hne
    cases x <;> cases y <;> (try exact absurd rfl hne) <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;> assumption
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | assumption
  · intro x c c' y h h' f hne hf
    cases x <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases y <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.comp_id]; assumption)
      | assumption
  · intro x c c' y h h' f hne hf
    cases y <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; assumption)
      | assumption

end RayCat

