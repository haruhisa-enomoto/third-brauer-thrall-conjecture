/-!
# The tree diagram `DB23A`

`Ẽ₆` at the start `x` of a dumb-bell with `χ = c₁ c₂` ([mild] figure 2.3, first diagram): `u₀ → u₁ → w → v₁ → v₀` along `χ χ`, and `w → m ← n` along `μ` and `α²`.

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `DB23A`. -/
inductive DB23A
  | W | U1 | U0 | V1 | V0 | M | N
  deriving DecidableEq

namespace DB23A

instance : Fintype DB23A := ⟨{W, U1, U0, V1, V0, M, N}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : DB23A → DB23A → Bool
  | U0, U1 | U1, W | W, V1 | V1, V0 | W, M | N, M => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : DB23A) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph DB23A := SimpleGraph.fromRel o

lemma adj_iff (u v : DB23A) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : DB23A) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : DB23A) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : DB23A) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : DB23A → Option DB23A
  | W => none
  | U1 => some W
  | U0 => some U1
  | V1 => some W
  | V0 => some V1
  | M => some W
  | N => some M

/-- The height. -/
def ht : DB23A → ℕ
  | W => 0
  | U1 => 1
  | U0 => 2
  | V1 => 1
  | V0 => 2
  | M => 1
  | N => 2

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `Ẽ₆`. -/
def cmap : AffineE6 → DB23A
  | .center => W
  | .inner i => if (i : ℕ) = 0 then U1 else if (i : ℕ) = 1 then V1 else M
  | .outer i => if (i : ℕ) = 0 then U0 else if (i : ℕ) = 1 then V0 else N

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `Ẽ₆`. -/
def copy : (underlyingGraph AffineE6).Copy G :=
  copyOf G cmap (by
    intro u v h
    rcases u with _ | i | i <;> rcases v with _ | j | j <;>
      (try fin_cases i) <;> (try fin_cases j) <;> simp_all [cmap])
    (by
      intro a b e
      rcases a with _ | i | i <;> rcases b with _ | j | j
      all_goals first
        | exact (IsEmpty.false e).elim
        | exact e.elim
        | (obtain rfl : i = j := e.down; fin_cases i <;> simp only [cmap] <;> decide)
        | (fin_cases i <;> simp only [cmap] <;> decide))

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {OW OU1 OU0 OV1 OV0 OM ON : P}
  (c₁ : OU0 ⟶ OU1) (c₂ : OU1 ⟶ OW) (d₁ : OW ⟶ OV1) (d₂ : OV1 ⟶ OV0) (μ : OW ⟶ OM) (a : ON ⟶ OM)

/-- The objects. -/
def obj : DB23A → P
  | W => OW | U1 => OU1 | U0 => OU0 | V1 => OV1 | V0 => OV0 | M => OM | N => ON

/-- The arrows. -/
def arr : ∀ u v : DB23A, o u v → ((obj (OW := OW) (OU1 := OU1) (OU0 := OU0) (OV1 := OV1) (OV0 := OV0) (OM := OM) (ON := ON) u) ⟶ obj (OW := OW) (OU1 := OU1) (OU0 := OU0) (OV1 := OV1) (OV0 := OV0) (OM := OM) (ON := ON) v)
  | U0, U1, _ => c₁
  | U1, W, _ => c₂
  | W, V1, _ => d₁
  | V1, V0, _ => d₂
  | W, M, _ => μ
  | N, M, _ => a
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : DB23A, Option ((obj (OW := OW) (OU1 := OU1) (OU0 := OU0) (OV1 := OV1) (OV0 := OV0) (OM := OM) (ON := ON) u) ⟶ obj (OW := OW) (OU1 := OU1) (OU0 := OU0) (OV1 := OV1) (OV0 := OV0) (OM := OM) (ON := ON) v)
  | W, W => some (𝟙 _)
  | W, V1 => some (d₁)
  | W, V0 => some (d₁ ≫ d₂)
  | W, M => some (μ)
  | U1, U1 => some (𝟙 _)
  | U1, W => some (c₂)
  | U1, V1 => some (c₂ ≫ d₁)
  | U1, V0 => some ((c₂ ≫ d₁) ≫ d₂)
  | U1, M => some (c₂ ≫ μ)
  | U0, U0 => some (𝟙 _)
  | U0, U1 => some (c₁)
  | U0, W => some (c₁ ≫ c₂)
  | U0, V1 => some ((c₁ ≫ c₂) ≫ d₁)
  | U0, V0 => some (((c₁ ≫ c₂) ≫ d₁) ≫ d₂)
  | U0, M => some ((c₁ ≫ c₂) ≫ μ)
  | V1, V1 => some (𝟙 _)
  | V1, V0 => some (d₂)
  | V0, V0 => some (𝟙 _)
  | M, M => some (𝟙 _)
  | N, N => some (𝟙 _)
  | N, M => some (a)
  | _, _ => none

end Diagram

