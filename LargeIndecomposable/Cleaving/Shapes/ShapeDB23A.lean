variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type u} [Field k] [Infinite k]

set_option maxHeartbeats 8000000 in
open DB23A in
/-- **No cleaving diagram `DB23A` in `P/τ`.** -/
theorem MildHyp.not_db23a (hM : MildHyp k P)
    {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {OW OU1 OU0 OV1 OV0 OM ON : P}
    (c₁ : OU0 ⟶ OU1) (c₂ : OU1 ⟶ OW) (d₁ : OW ⟶ OV1) (d₂ : OV1 ⟶ OV0) (μ : OW ⟶ OM) (a : ON ⟶ OM)
    (h0_W_V1 : ¬FactorsThroughMorphism τ (d₁))
    (h0_W_V0 : ¬FactorsThroughMorphism τ (d₁ ≫ d₂))
    (h0_W_M : ¬FactorsThroughMorphism τ (μ))
    (h0_U1_W : ¬FactorsThroughMorphism τ (c₂))
    (h0_U1_V1 : ¬FactorsThroughMorphism τ (c₂ ≫ d₁))
    (h0_U1_V0 : ¬FactorsThroughMorphism τ ((c₂ ≫ d₁) ≫ d₂))
    (h0_U1_M : ¬FactorsThroughMorphism τ (c₂ ≫ μ))
    (h0_U0_U1 : ¬FactorsThroughMorphism τ (c₁))
    (h0_U0_W : ¬FactorsThroughMorphism τ (c₁ ≫ c₂))
    (h0_U0_V1 : ¬FactorsThroughMorphism τ ((c₁ ≫ c₂) ≫ d₁))
    (h0_U0_V0 : ¬FactorsThroughMorphism τ (((c₁ ≫ c₂) ≫ d₁) ≫ d₂))
    (h0_U0_M : ¬FactorsThroughMorphism τ ((c₁ ≫ c₂) ≫ μ))
    (h0_V1_V0 : ¬FactorsThroughMorphism τ (d₂))
    (h0_N_M : ¬FactorsThroughMorphism τ (a))
    (hi_c₁ : ¬IsIso c₁)
    (hi_c₂ : ¬IsIso c₂)
    (hi_d₁ : ¬IsIso d₁)
    (hi_d₂ : ¬IsIso d₂)
    (hi_μ : ¬IsIso μ)
    (hi_a : ¬IsIso a)
    (hl_d₁_μ_M : ¬∃ g, d₁ ≫ g = μ)
    (hl_μ_d₁_V1 : ¬∃ g, μ ≫ g = d₁)
    (hl_μ_d₁_V0 : ¬∃ g, μ ≫ g = d₁ ≫ d₂)
    (hr_μ_a_N : ¬∃ g, g ≫ μ = a)
    (hr_a_μ_W : ¬∃ g, g ≫ a = μ)
    (hr_a_μ_U1 : ¬∃ g, g ≫ a = c₂ ≫ μ)
    (hr_a_μ_U0 : ¬∃ g, g ≫ a = (c₁ ≫ c₂) ≫ μ)
    : False := by
  haveI : Fact (LargeIndecomposable.Foundations.Quiver.IsAcyclic (OT G o)) := ⟨OT.isAcyclic ho hasym isAcyclic⟩
  refine hM.not_tree_table τ hτ hτ0 G o ho hasym isAcyclic
    (OT.not_isRepresentationFinite_affineE6 ho hcov k copy) obj (arr c₁ c₂ d₁ d₂ μ a)
    (tab c₁ c₂ d₁ d₂ μ a) (fun v ↦ by cases v <;> rfl) ?_ ?_ ?_ ?_ ?_
  · intro x y z h f hf
    cases y <;> cases z <;> (try exact absurd h (by decide)) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; rfl)
      | rfl
  · intro x y f hf hne
    cases x <;> cases y <;> (try exact absurd rfl hne) <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;> assumption
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | assumption
  · intro x c c' y h h' f hne hf
    cases x <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases y <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.comp_id]; assumption)
      | assumption
  · intro x c c' y h h' f hne hf
    cases y <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; assumption)
      | assumption

