namespace RayCat

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] [IsRayCategory P] [Fintype P]
  [DecidableEq P] [IsFiniteRayCategory P] {k : Type*} [Field k] [Infinite k]

set_option maxHeartbeats 16000000 in
open PC10 in
/-- **No cleaving diagram `PC10` in `P/τ`.** -/
theorem MildHyp.not_pc10 (hM : MildHyp k P) {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {OX0 OX1 OX2 OT0 OT1 OT2 OC0 OC1 OV0 : P}
    (α₁ : OX0 ⟶ OX1) (a₁ : OX0 ⟶ OT1) (α₂ : OX1 ⟶ OX2) (a₂ : OX1 ⟶ OT2) (b₀ : OT0 ⟶ OX1) (γ₀ : OT0 ⟶ OC0) (b₁ : OT1 ⟶ OX2) (γ₁ : OT1 ⟶ OC1) (ζ : OC0 ⟶ OV0)
    (hD : ¬Statement.IsRepresentationFinite (Linearization (ThinCat thin) k))
    (hc0 : a₁ ≫ b₁ = α₁ ≫ α₂)
    (hz0 : b₀ ≫ a₂ = 0)
    (h0_C0_V0 : ¬FactorsThroughMorphism τ (ζ))
    (h0_T0_C0 : ¬FactorsThroughMorphism τ (γ₀))
    (h0_T0_V0 : ¬FactorsThroughMorphism τ (γ₀ ≫ ζ))
    (h0_T0_X1 : ¬FactorsThroughMorphism τ (b₀))
    (h0_T0_X2 : ¬FactorsThroughMorphism τ (b₀ ≫ α₂))
    (h0_T1_C1 : ¬FactorsThroughMorphism τ (γ₁))
    (h0_T1_X2 : ¬FactorsThroughMorphism τ (b₁))
    (h0_X0_C1 : ¬FactorsThroughMorphism τ (a₁ ≫ γ₁))
    (h0_X0_T1 : ¬FactorsThroughMorphism τ (a₁))
    (h0_X0_T2 : ¬FactorsThroughMorphism τ (α₁ ≫ a₂))
    (h0_X0_X1 : ¬FactorsThroughMorphism τ (α₁))
    (h0_X0_X2 : ¬FactorsThroughMorphism τ (α₁ ≫ α₂))
    (h0_X1_T2 : ¬FactorsThroughMorphism τ (a₂))
    (h0_X1_X2 : ¬FactorsThroughMorphism τ (α₂))
    (hi_α₁ : ¬IsIso α₁)
    (hi_a₁ : ¬IsIso a₁)
    (hi_α₂ : ¬IsIso α₂)
    (hi_a₂ : ¬IsIso a₂)
    (hi_b₀ : ¬IsIso b₀)
    (hi_γ₀ : ¬IsIso γ₀)
    (hi_b₁ : ¬IsIso b₁)
    (hi_γ₁ : ¬IsIso γ₁)
    (hi_ζ : ¬IsIso ζ)
    (hlft_T0_C0_X1 : ¬∃ g, γ₀ ≫ g = b₀)
    (hlft_T0_C0_X2 : ¬∃ g, γ₀ ≫ g = b₀ ≫ α₂)
    (hlft_T0_X1_C0 : ¬∃ g, b₀ ≫ g = γ₀)
    (hlft_T0_X1_V0 : ¬∃ g, b₀ ≫ g = γ₀ ≫ ζ)
    (hlft_T1_C1_X2 : ¬∃ g, γ₁ ≫ g = b₁)
    (hlft_T1_X2_C1 : ¬∃ g, b₁ ≫ g = γ₁)
    (hlft_X0_T1_X1 : ¬∃ g, a₁ ≫ g = α₁)
    (hlft_X0_T1_T2 : ¬∃ g, a₁ ≫ g = α₁ ≫ a₂)
    (hlft_X0_X1_T1 : ¬∃ g, α₁ ≫ g = a₁)
    (hlft_X0_X1_C1 : ¬∃ g, α₁ ≫ g = a₁ ≫ γ₁)
    (hlft_X1_T2_X2 : ¬∃ g, a₂ ≫ g = α₂)
    (hlft_X1_X2_T2 : ¬∃ g, α₂ ≫ g = a₂)
    (hrgt_X0_T0_X1 : ¬∃ g, g ≫ b₀ = α₁)
    (hrgt_X1_T1_X2 : ¬∃ g, g ≫ b₁ = α₂)
    (hrgt_T0_T1_X2 : ¬∃ g, g ≫ b₁ = b₀ ≫ α₂)
    (hrgt_T0_X0_X1 : ¬∃ g, g ≫ α₁ = b₀)
    (hrgt_T1_X1_X2 : ¬∃ g, g ≫ α₂ = b₁)
    : False := by
  have hlft_C0_V0_C0 : ¬∃ g, ζ ≫ g = 𝟙 _ := not_split_mono hi_ζ
  have hlft_T0_C0_T0 : ¬∃ g, γ₀ ≫ g = 𝟙 _ := not_split_mono hi_γ₀
  have hlft_T0_X1_T0 : ¬∃ g, b₀ ≫ g = 𝟙 _ := not_split_mono hi_b₀
  have hlft_T1_C1_T1 : ¬∃ g, γ₁ ≫ g = 𝟙 _ := not_split_mono hi_γ₁
  have hlft_T1_X2_T1 : ¬∃ g, b₁ ≫ g = 𝟙 _ := not_split_mono hi_b₁
  have hlft_X0_T1_X0 : ¬∃ g, a₁ ≫ g = 𝟙 _ := not_split_mono hi_a₁
  have hlft_X0_X1_X0 : ¬∃ g, α₁ ≫ g = 𝟙 _ := not_split_mono hi_α₁
  have hlft_X1_T2_X1 : ¬∃ g, a₂ ≫ g = 𝟙 _ := not_split_mono hi_a₂
  have hlft_X1_X2_X1 : ¬∃ g, α₂ ≫ g = 𝟙 _ := not_split_mono hi_α₂
  have hrgt_V0_C0_V0 : ¬∃ g, g ≫ ζ = 𝟙 _ := not_split_epi hi_ζ
  have hrgt_C0_T0_C0 : ¬∃ g, g ≫ γ₀ = 𝟙 _ := not_split_epi hi_γ₀
  have hrgt_X1_T0_X1 : ¬∃ g, g ≫ b₀ = 𝟙 _ := not_split_epi hi_b₀
  have hrgt_C1_T1_C1 : ¬∃ g, g ≫ γ₁ = 𝟙 _ := not_split_epi hi_γ₁
  have hrgt_X2_T1_X2 : ¬∃ g, g ≫ b₁ = 𝟙 _ := not_split_epi hi_b₁
  have hrgt_T1_X0_T1 : ¬∃ g, g ≫ a₁ = 𝟙 _ := not_split_epi hi_a₁
  have hrgt_X1_X0_X1 : ¬∃ g, g ≫ α₁ = 𝟙 _ := not_split_epi hi_α₁
  have hrgt_T2_X1_T2 : ¬∃ g, g ≫ a₂ = 𝟙 _ := not_split_epi hi_a₂
  have hrgt_X2_X1_X2 : ¬∃ g, g ≫ α₂ = 𝟙 _ := not_split_epi hi_α₂
  have hc0' := reassoc_of% hc0
  have hz0' := reassoc_of% hz0
  refine hM.not_thin_diagram τ hτ hτ0 hD arrows obj (fun x y _ ↦ tab α₁ a₁ α₂ a₂ b₀ γ₀ b₁ γ₁ ζ x y)
    (fun x ↦ by cases x <;> rfl) ?_ ?_ ?_ ?_
  · intro x y z h h'
    cases x <;> cases y <;> (try exact absurd h (by decide)) <;> cases z <;>
      (try exact absurd h' (by decide)) <;> split_ifs with hn <;>
      (try exact absurd hn (by decide)) <;>
      simp only [tab, Category.assoc, Category.id_comp, Category.comp_id, zero_comp, comp_zero, hc0', hc0, hz0', hz0]
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | exact not_factorsThrough_id hτ _
      | assumption
  · intro x z y ha hy
    cases x <;> cases z <;> (try exact absurd ha (by decide)) <;> cases y <;>
      (try exact absurd hy (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›
  · intro x z y ha hx
    cases z <;> cases y <;> (try exact absurd ha (by decide)) <;> cases x <;>
      (try exact absurd hx (by decide)) <;>
      first
      | exact fun _ ↦ by decide
      | exact fun hg ↦ absurd hg ‹_›

end RayCat

