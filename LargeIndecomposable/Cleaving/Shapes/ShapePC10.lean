/-!
# The thin diagram `PC10`

Open penny-farthing (`n = 2`): the square `α α = a₁ β` with `β ← t → c → v` (`γ ζ ≠ 0`, `a₁ γ ζ = 0`) and `t → c` (`γ`); `β a₁ = 0`.

Generated by `scripts/gen_thin_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `PC10`. -/
inductive PC10
  | X0 | X1 | X2 | T0 | T1 | T2 | C0 | C1 | V0
  deriving DecidableEq

namespace PC10

instance : Fintype PC10 := ⟨{X0, X1, X2, T0, T1, T2, C0, C1, V0}, by intro v; cases v <;> simp⟩

/-- The order (nonzero morphisms). -/
def leb : PC10 → PC10 → Bool
  | C0, C0 | C0, V0 | C1, C1 | T0, C0 | T0, T0 | T0, V0 | T0, X1 | T0, X2 | T1, C1 | T1, T1 | T1, X2 | T2, T2 | V0, V0 | X0, C1 | X0, T1 | X0, T2 | X0, X0 | X0, X1 | X0, X2 | X1, T2 | X1, X1 | X1, X2 | X2, X2 => true
  | _, _ => false

/-- The arrows. -/
def arb : PC10 → PC10 → Bool
  | C0, V0 | T0, C0 | T0, X1 | T1, C1 | T1, X2 | X0, T1 | X0, X1 | X1, T2 | X1, X2 => true
  | _, _ => false

/-- The thin category. -/
abbrev thin : ThinData PC10 where
  le x y := leb x y = true
  nz x _ z := leb x z = true
  refl x := by cases x <;> rfl
  antisymm := by decide
  nz_le _ _ _ _ _ h := h
  nz_left _ _ h := h
  nz_right _ _ h := h
  assoc := by decide

/-- The generating arrows. -/
abbrev arrows : ThinArrows thin where
  ar x y := arb x y = true
  ar_le := by decide
  ar_ne := by decide
  first := by decide
  last := by decide

section Diagram

variable {P : Type} [Category.{0} P] [HasZeroMorphisms P] {OX0 OX1 OX2 OT0 OT1 OT2 OC0 OC1 OV0 : P}
  (α₁ : OX0 ⟶ OX1) (a₁ : OX0 ⟶ OT1) (α₂ : OX1 ⟶ OX2) (a₂ : OX1 ⟶ OT2) (b₀ : OT0 ⟶ OX1) (γ₀ : OT0 ⟶ OC0) (b₁ : OT1 ⟶ OX2) (γ₁ : OT1 ⟶ OC1) (ζ : OC0 ⟶ OV0)

/-- The objects. -/
abbrev obj : PC10 → P
  | X0 => OX0 | X1 => OX1 | X2 => OX2 | T0 => OT0 | T1 => OT1 | T2 => OT2 | C0 => OC0 | C1 => OC1 | V0 => OV0

/-- The morphisms. -/
abbrev tab : ∀ u v : PC10, (obj (OX0 := OX0) (OX1 := OX1) (OX2 := OX2) (OT0 := OT0) (OT1 := OT1) (OT2 := OT2) (OC0 := OC0) (OC1 := OC1) (OV0 := OV0) u) ⟶ obj (OX0 := OX0) (OX1 := OX1) (OX2 := OX2) (OT0 := OT0) (OT1 := OT1) (OT2 := OT2) (OC0 := OC0) (OC1 := OC1) (OV0 := OV0) v
  | C0, C0 => 𝟙 _
  | C0, V0 => ζ
  | C1, C1 => 𝟙 _
  | T0, C0 => γ₀
  | T0, T0 => 𝟙 _
  | T0, V0 => γ₀ ≫ ζ
  | T0, X1 => b₀
  | T0, X2 => b₀ ≫ α₂
  | T1, C1 => γ₁
  | T1, T1 => 𝟙 _
  | T1, X2 => b₁
  | T2, T2 => 𝟙 _
  | V0, V0 => 𝟙 _
  | X0, C1 => a₁ ≫ γ₁
  | X0, T1 => a₁
  | X0, T2 => α₁ ≫ a₂
  | X0, X0 => 𝟙 _
  | X0, X1 => α₁
  | X0, X2 => α₁ ≫ α₂
  | X1, T2 => a₂
  | X1, X1 => 𝟙 _
  | X1, X2 => α₂
  | X2, X2 => 𝟙 _
  | _, _ => 0

end Diagram

end PC10

