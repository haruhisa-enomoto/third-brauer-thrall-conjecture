/-- The objects. -/
def obj : F7C → P
  | a => Aa | x => X | c₁ => C₁ | c₂ => C₂ | c₃ => C₃ | c₄ => C₄ | b => Bb | y₁ => Y₁ | e => E

/-- The arrows. -/
def arr : ∀ u v : F7C, o u v → ((obj (Aa := Aa) (X := X) (C₁ := C₁) (C₂ := C₂) (C₃ := C₃) (C₄ := C₄) (Bb := Bb) (Y₁ := Y₁) (E := E) u) ⟶ obj (Aa := Aa) (X := X) (C₁ := C₁) (C₂ := C₂) (C₃ := C₃) (C₄ := C₄) (Bb := Bb) (Y₁ := Y₁) (E := E) v)
  | x, a, _ => V₁
  | x, c₁, _ => w₁
  | c₁, c₂, _ => w₂
  | c₂, c₃, _ => w₃
  | c₃, c₄, _ => w₄
  | a, b, _ => V₂
  | a, y₁, _ => r
  | e, y₁, _ => η
  | _, _, _ => 0

/-- The path values. -/
def tab : ∀ u v : F7C, Option ((obj (Aa := Aa) (X := X) (C₁ := C₁) (C₂ := C₂) (C₃ := C₃) (C₄ := C₄) (Bb := Bb) (Y₁ := Y₁) (E := E) u) ⟶ obj (Aa := Aa) (X := X) (C₁ := C₁) (C₂ := C₂) (C₃ := C₃) (C₄ := C₄) (Bb := Bb) (Y₁ := Y₁) (E := E) v)
  | a, a => some (𝟙 _)
  | a, b => some (V₂)
  | a, y₁ => some (r)
