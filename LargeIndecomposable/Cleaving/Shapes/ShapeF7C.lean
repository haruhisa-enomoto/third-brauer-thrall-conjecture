/-!
# The tree diagram `F7C`

BO13a figure 7.2 (third tree): the `Ẽ₈` tree `a ← x → c₁ → c₂ → c₃ → c₄`, `a → b`, `a → y₁ ← e`.

Generated by `scripts/gen_tree_shape.py`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits RayCat LargeIndecomposable

universe u

namespace RayCat

/-- Vertices of the diagram `F7C`. -/
inductive F7C
  | a | x | c₁ | c₂ | c₃ | c₄ | b | y₁ | e
  deriving DecidableEq

namespace F7C

instance : Fintype F7C := ⟨{a, x, c₁, c₂, c₃, c₄, b, y₁, e}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : F7C → F7C → Bool
  | x, a | x, c₁ | c₁, c₂ | c₂, c₃ | c₃, c₄ | a, b | a, y₁ | e, y₁ => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : F7C) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph F7C := SimpleGraph.fromRel o

lemma adj_iff (u v : F7C) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : F7C) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : F7C) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : F7C) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : F7C → Option F7C
  | a => none
  | x => some a
  | c₁ => some x
  | c₂ => some c₁
  | c₃ => some c₂
  | c₄ => some c₃
  | b => some a
  | y₁ => some a
  | e => some y₁

/-- The height. -/
def ht : F7C → ℕ
  | a => 0
  | x => 1
  | c₁ => 2
  | c₂ => 3
  | c₃ => 4
  | c₄ => 5
  | b => 1
  | y₁ => 1
  | e => 2

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `Ẽ₈` (arms listed from the centre). -/
def cmap : AffineE8 → F7C
  | .center => a
  | .short => b
  | .medium4 => y₁
  | .medium2 => e
  | .long5 => x
  | .long4 => c₁
  | .long3 => c₂
  | .long2 => c₃
  | .long1 => c₄

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `Ẽ₈`. -/
def copy : (underlyingGraph AffineE8).Copy G :=
  copyOf G cmap (by
    intro u v h
    cases u <;> cases v <;> simp_all [cmap])
    (by
      intro a b e
      change AffineE8.Arrow a b at e
      cases e <;> simp only [cmap] <;> decide)

section Diagram

