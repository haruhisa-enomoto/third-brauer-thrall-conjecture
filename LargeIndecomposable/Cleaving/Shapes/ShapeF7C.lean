/-- **No cleaving diagram `F7C` in `P/τ`.** -/
theorem not_f7c
    (hmin : ∀ I : TwoSidedIdeal A, I ≠ ⊥ → Statement.IsRepresentationFinite (A ⧸ I.asIdeal))
    (hL : LeftCancel P) (hR : RightCancel P) {a b : P} (τ : a ⟶ b) (hτ : ¬IsIso τ)
    (hτ0 : τ ≠ 0) {Aa X C₁ C₂ C₃ C₄ Bb Y₁ E : P}
    (V₁ : X ⟶ Aa) (w₁ : X ⟶ C₁) (w₂ : C₁ ⟶ C₂) (w₃ : C₂ ⟶ C₃) (w₄ : C₃ ⟶ C₄) (V₂ : Aa ⟶ Bb) (r : Aa ⟶ Y₁) (η : E ⟶ Y₁)
    (h0_a_b : ¬FactorsThroughMorphism τ (V₂))
    (h0_a_y₁ : ¬FactorsThroughMorphism τ (r))
    (h0_x_a : ¬FactorsThroughMorphism τ (V₁))
    (h0_x_b : ¬FactorsThroughMorphism τ (V₁ ≫ V₂))
    (h0_x_y₁ : ¬FactorsThroughMorphism τ (V₁ ≫ r))
    (h0_x_c₁ : ¬FactorsThroughMorphism τ (w₁))
    (h0_x_c₂ : ¬FactorsThroughMorphism τ (w₁ ≫ w₂))
    (h0_x_c₃ : ¬FactorsThroughMorphism τ ((w₁ ≫ w₂) ≫ w₃))
    (h0_x_c₄ : ¬FactorsThroughMorphism τ (((w₁ ≫ w₂) ≫ w₃) ≫ w₄))
    (h0_c₁_c₂ : ¬FactorsThroughMorphism τ (w₂))
    (h0_c₁_c₃ : ¬FactorsThroughMorphism τ (w₂ ≫ w₃))
    (h0_c₁_c₄ : ¬FactorsThroughMorphism τ ((w₂ ≫ w₃) ≫ w₄))
    (h0_c₂_c₃ : ¬FactorsThroughMorphism τ (w₃))
    (h0_c₂_c₄ : ¬FactorsThroughMorphism τ (w₃ ≫ w₄))
    (h0_c₃_c₄ : ¬FactorsThroughMorphism τ (w₄))
    (h0_e_y₁ : ¬FactorsThroughMorphism τ (η))
    (hi_V₁ : ¬IsIso V₁)
    (hi_w₁ : ¬IsIso w₁)
    (hi_w₂ : ¬IsIso w₂)
    (hi_w₃ : ¬IsIso w₃)
    (hi_w₄ : ¬IsIso w₄)
    (hi_V₂ : ¬IsIso V₂)
    (hi_r : ¬IsIso r)
    (hi_η : ¬IsIso η)
    (hl_V₂_r_y₁ : ¬∃ g, V₂ ≫ g = r)
    (hl_r_V₂_b : ¬∃ g, r ≫ g = V₂)
    (hl_V₁_w₁_c₁ : ¬∃ g, V₁ ≫ g = w₁)
    (hl_V₁_w₁_c₂ : ¬∃ g, V₁ ≫ g = w₁ ≫ w₂)
    (hl_V₁_w₁_c₃ : ¬∃ g, V₁ ≫ g = w₁ ≫ (w₂ ≫ w₃))
    (hl_V₁_w₁_c₄ : ¬∃ g, V₁ ≫ g = w₁ ≫ ((w₂ ≫ w₃) ≫ w₄))
    (hl_w₁_V₁_a : ¬∃ g, w₁ ≫ g = V₁)
    (hl_w₁_V₁_b : ¬∃ g, w₁ ≫ g = V₁ ≫ V₂)
    (hl_w₁_V₁_y₁ : ¬∃ g, w₁ ≫ g = V₁ ≫ r)
    (hr_r_η_e : ¬∃ g, g ≫ r = η)
    (hr_η_r_a : ¬∃ g, g ≫ η = r)
    (hr_η_r_x : ¬∃ g, g ≫ η = V₁ ≫ r)
    : False := by
  haveI : Fact (LargeIndecomposable.Foundations.Quiver.IsAcyclic (OT G o)) := ⟨OT.isAcyclic ho hasym isAcyclic⟩
  refine B.not_tree_table hmin hL hR τ hτ hτ0 G o ho hasym isAcyclic
    (OT.not_isRepresentationFinite_affineE8 ho hcov k copy) obj (arr V₁ w₁ w₂ w₃ w₄ V₂ r η)
    (tab V₁ w₁ w₂ w₃ w₄ V₂ r η) (fun v ↦ by cases v <;> rfl) ?_ ?_ ?_ ?_ ?_
  · intro x y z h f hf
    cases y <;> cases z <;> (try exact absurd h (by decide)) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; rfl)
      | rfl
  · intro x y f hf hne
    cases x <;> cases y <;> (try exact absurd rfl hne) <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;> assumption
  · intro x y h
    cases x <;> cases y <;> first
      | exact absurd h (by decide)
      | assumption
  · intro x c c' y h h' f hne hf
    cases x <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases y <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.comp_id]; assumption)
      | assumption
  · intro x c c' y h h' f hne hf
    cases y <;> cases c <;> (try exact absurd h (by decide)) <;> cases c' <;>
      (try exact absurd h' (by decide)) <;> (try exact absurd rfl hne) <;> cases x <;>
      simp only [tab, reduceCtorEq, Option.some.injEq] at hf <;>
      (first | subst hf | obtain rfl := Option.some.inj hf) <;>
      first
      | (rw [Category.id_comp]; assumption)
      | assumption

