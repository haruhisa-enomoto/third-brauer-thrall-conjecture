    (hlft_x''_z₂_y₁ : ¬∃ g, ρ₂ ≫ g = t ≫ U')
    (hrgt_m_b'_y₁ : ¬∃ g, g ≫ W' = U')
    (hrgt_x''_b'_y₁ : ¬∃ g, g ≫ W' = t ≫ U')
    (hrgt_x'_m_c : ¬∃ g, g ≫ a = r)
    (hrgt_b'_m_y₁ : ¬∃ g, g ≫ U' = W')
    (hrgt_x''_x_m : ¬∃ g, g ≫ ψ = t)
    (hrgt_x_x'_c : ¬∃ g, g ≫ r = ψ ≫ a)
    (hrgt_m_x'_c : ¬∃ g, g ≫ r = a)
    (hrgt_x_x''_m : ¬∃ g, g ≫ t = ψ)
