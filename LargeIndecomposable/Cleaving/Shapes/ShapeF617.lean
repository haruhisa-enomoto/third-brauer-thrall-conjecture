    (β' : X ⟶ B') (ψ : X ⟶ M) (U' : M ⟶ Y₁) (W' : B' ⟶ Y₁) (β : X ⟶ Bb) (a : M ⟶ Cc) (r : X' ⟶ Cc) (t : X'' ⟶ M) (ρ₂ : X'' ⟶ Z₂)
