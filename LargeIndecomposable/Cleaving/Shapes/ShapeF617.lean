  have hrgt_c_m_c : ¬∃ g, g ≫ a = 𝟙 _ := not_split_epi hi_a
  have hrgt_y₁_m_y₁ : ¬∃ g, g ≫ U' = 𝟙 _ := not_split_epi hi_U'
  have hrgt_b_x_b : ¬∃ g, g ≫ β = 𝟙 _ := not_split_epi hi_β
