    (hlft_m_c_y₁ : ¬∃ g, a ≫ g = U')
    (hlft_m_y₁_c : ¬∃ g, U' ≫ g = a)
    (hlft_x_b_b' : ¬∃ g, β ≫ g = β')
    (hlft_x_b_m : ¬∃ g, β ≫ g = ψ)
    (hlft_x_b_y₁ : ¬∃ g, β ≫ g = β' ≫ W')
    (hlft_x_b_c : ¬∃ g, β ≫ g = ψ ≫ a)
    (hlft_x_b'_m : ¬∃ g, β' ≫ g = ψ)
