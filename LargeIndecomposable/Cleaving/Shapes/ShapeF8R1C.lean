/-- Vertices of the diagram `F8R1C`. -/
inductive F8R1C
  | a | x | c' | x₂ | tφ | c | y₁
  deriving DecidableEq

namespace F8R1C

instance : Fintype F8R1C := ⟨{a, x, c', x₂, tφ, c, y₁}, by intro v; cases v <;> simp⟩

/-- The orientation. -/
def ob : F8R1C → F8R1C → Bool
  | x, a | x, c' | x₂, a | x₂, tφ | a, c | c, y₁ => true
  | _, _ => false

/-- The orientation as a relation. -/
abbrev o (u v : F8R1C) : Prop := ob u v = true

/-- The graph. -/
def G : SimpleGraph F8R1C := SimpleGraph.fromRel o

lemma adj_iff (u v : F8R1C) : G.Adj u v ↔ o u v ∨ o v u := by
  rw [G, SimpleGraph.fromRel_adj]
  cases u <;> cases v <;> decide

instance : DecidableRel G.Adj := fun u v ↦ decidable_of_iff _ (adj_iff u v).symm

lemma ho (u v : F8R1C) (h : o u v) : G.Adj u v := (adj_iff u v).2 (Or.inl h)

lemma hcov (u v : F8R1C) (h : G.Adj u v) : o u v ∨ o v u := (adj_iff u v).1 h

lemma hasym (u v : F8R1C) (h : o u v) : ¬o v u := by
  revert h; cases u <;> cases v <;> decide

/-- The parent function. -/
def par : F8R1C → Option F8R1C
  | a => none
  | x => some a
  | c' => some x
  | x₂ => some a
  | tφ => some x₂
  | c => some a
  | y₁ => some c

/-- The height. -/
def ht : F8R1C → ℕ
  | a => 0
  | x => 1
  | c' => 2
  | x₂ => 1
  | tφ => 2
  | c => 1
  | y₁ => 2

lemma isAcyclic : G.IsAcyclic :=
  isAcyclic_of_parent G par ht (fun u v ↦ by rw [adj_iff]; cases u <;> cases v <;> decide)
    (fun u v h ↦ by cases u <;> cases v <;> simp_all [par, ht])

open LargeIndecomposable.Foundations.Quiver in
/-- The vertex map of the copy of `Ẽ₆`. -/
def cmap : AffineE6 → F8R1C
  | .center => a
  | .inner i => if (i : ℕ) = 0 then x else if (i : ℕ) = 1 then x₂ else c
  | .outer i => if (i : ℕ) = 0 then c' else if (i : ℕ) = 1 then tφ else y₁

open LargeIndecomposable.Foundations.Quiver in
/-- The copy of `Ẽ₆`. -/
def copy : (underlyingGraph AffineE6).Copy G :=
  copyOf G cmap (by
    intro u v h
    rcases u with _ | i | i <;> rcases v with _ | j | j <;>
      (try fin_cases i) <;> (try fin_cases j) <;> simp_all [cmap])
    (by
      intro a b e
      rcases a with _ | i | i <;> rcases b with _ | j | j
      all_goals first
        | exact (IsEmpty.false e).elim
        | exact e.elim
        | (obtain rfl : i = j := e.down; fin_cases i <;> simp only [cmap] <;> decide)
        | (fin_cases i <;> simp only [cmap] <;> decide))

