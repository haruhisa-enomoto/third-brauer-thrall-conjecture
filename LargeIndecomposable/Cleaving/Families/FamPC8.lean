/-- The dimension vector. -/
abbrev dim : PC8 → ℕ
  | .X1 => 1
  | .X2 => 1
  | .T0 => 1
  | .T1 => 1
  | .C1 => 1

/-- The matrices of the member `t`. -/
def Mf (t : k) : ∀ u v : PC8, Matrix (Fin (dim v)) (Fin (dim u)) k
  | .X1, .X1 => 1
  | .X1, .X2 => !![1]
  | .X1, .T0 => 0
  | .X1, .T1 => 0
  | .X1, .C1 => 0
  | .X2, .X1 => 0
  | .X2, .X2 => 1
  | .X2, .T0 => 0
  | .X2, .T1 => 0
  | .X2, .C1 => 0
  | .T0, .X1 => !![t]
  | .T0, .X2 => !![t]
  | .T0, .T0 => 1
  | .T0, .T1 => 0
  | .T0, .C1 => !![1]
  | .T1, .X1 => 0
  | .T1, .X2 => !![1]
  | .T1, .T0 => 0
  | .T1, .T1 => 1
  | .T1, .C1 => !![1]
  | .C1, .X1 => 0
  | .C1, .X2 => 0
  | .C1, .T0 => 0
  | .C1, .T1 => 0
  | .C1, .C1 => 1

/-- The excluded parameters. -/
def bad : Polynomial k := X

/-- The family. -/
abbrev fam : MatFam PC8.thin k {t : k // bad.eval t ≠ 0} :=
  MatFam.mk' dim (fun t ↦ Mf t.1) (fun t u ↦ by cases u <;> simp only [Mf]) (by
    rintro ⟨t, -⟩ u v w h1 h2 h3 h4
    cases u <;> cases v <;> cases w <;>
      first
      | exact absurd rfl h1
      | exact absurd rfl h2
      | exact absurd h3 (by decide)
      | exact absurd h4 (by decide)
      | (split_ifs with hn <;>
          first
          | exact absurd hn (by decide)
          | (ext i j; fin_cases i <;> fin_cases j <;>
              simp [Mf, dim, Matrix.mul_apply, Fin.sum_univ_succ] <;> ring)))

/-- **`PC8` is representation-infinite.** -/
theorem not_isRepresentationFinite [Infinite k] :
    ¬Statement.IsRepresentationFinite (Linearization (ThinCat PC8.thin) k) := by
  have hbad : (bad : Polynomial k) ≠ 0 := monic_X.ne_zero
  have := infinite_nonroot bad hbad
  refine fam.not_isRepresentationFinite PC8.X1 (by show 0 < dim PC8.X1; decide) ?_ ?_
  · rintro ⟨t, ht⟩ G hG
    simp only [bad, eval_mul, eval_X, eval_add, eval_sub, eval_C] at ht
    have hft0 : (t) ≠ 0 := fun h ↦ ht (by linear_combination (1) * h)
    have hD0 : (t) ^ 1 ≠ 0 := by apply_rules [mul_ne_zero, pow_ne_zero, hft0]
    have e0 := congrFun (congrFun (hG PC8.X1 PC8.X2 (by decide)) (0 : Fin 1)) (0 : Fin 1)
    have e1 := congrFun (congrFun (hG PC8.T0 PC8.X1 (by decide)) (0 : Fin 1)) (0 : Fin 1)
    have e2 := congrFun (congrFun (hG PC8.T0 PC8.C1 (by decide)) (0 : Fin 1)) (0 : Fin 1)
    have e3 := congrFun (congrFun (hG PC8.T1 PC8.X2 (by decide)) (0 : Fin 1)) (0 : Fin 1)
    have e4 := congrFun (congrFun (hG PC8.T1 PC8.C1 (by decide)) (0 : Fin 1)) (0 : Fin 1)
    simp only [fam, MatFam.mk', Mf, dim, Matrix.mul_apply, Fin.sum_univ_succ, Fin.sum_univ_zero, Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_succ, Matrix.empty_val', Matrix.cons_val_fin_one, Matrix.cons_val_one, Fin.succ_zero_eq_one, Fin.succ_one_eq_two, Fin.reduceSucc, Matrix.cons_val, mul_zero, mul_one, zero_mul, one_mul, add_zero, zero_add, neg_mul, mul_neg, neg_zero] at e0 e1 e2 e3 e4
    have g_0 : G PC8.X1 (0 : Fin 1) (0 : Fin 1) = (G PC8.X1 (0 : Fin 1) (0 : Fin 1) • (1 : Matrix (Fin 1) (Fin 1) k)) 0 0 := by
      rw [Matrix.smul_apply, Matrix.one_apply_eq, smul_eq_mul, mul_one]
    have g_1 : G PC8.X2 (0 : Fin 1) (0 : Fin 1) = (G PC8.X1 (0 : Fin 1) (0 : Fin 1) • (1 : Matrix (Fin 1) (Fin 1) k)) 0 0 := by
      rw [Matrix.smul_apply, Matrix.one_apply_eq, smul_eq_mul, mul_one]
      exact eq_of_mul_sub_eq_zero hD0 (by linear_combination (-1) * e1 + (t) * e2 + (t) * e3 + (-t) * e4)
    have g_2 : G PC8.T0 (0 : Fin 1) (0 : Fin 1) = (G PC8.X1 (0 : Fin 1) (0 : Fin 1) • (1 : Matrix (Fin 1) (Fin 1) k)) 0 0 := by
      rw [Matrix.smul_apply, Matrix.one_apply_eq, smul_eq_mul, mul_one]
      exact eq_of_mul_sub_eq_zero hD0 (by linear_combination (-1) * e1)
    have g_3 : G PC8.T1 (0 : Fin 1) (0 : Fin 1) = (G PC8.X1 (0 : Fin 1) (0 : Fin 1) • (1 : Matrix (Fin 1) (Fin 1) k)) 0 0 := by
      rw [Matrix.smul_apply, Matrix.one_apply_eq, smul_eq_mul, mul_one]
      exact eq_of_mul_sub_eq_zero hD0 (by linear_combination (-1) * e1 + (t) * e2 + (-t) * e4)
    have g_4 : G PC8.C1 (0 : Fin 1) (0 : Fin 1) = (G PC8.X1 (0 : Fin 1) (0 : Fin 1) • (1 : Matrix (Fin 1) (Fin 1) k)) 0 0 := by
      rw [Matrix.smul_apply, Matrix.one_apply_eq, smul_eq_mul, mul_one]
      exact eq_of_mul_sub_eq_zero hD0 (by linear_combination (-1) * e1 + (t) * e2)
    refine ⟨G PC8.X1 (0 : Fin 1) (0 : Fin 1), fun v ↦ ?_⟩
    match v with
    | .X1 => exact Matrix.ext fun (i j : Fin 1) ↦ by fin_cases i <;> fin_cases j; exacts [g_0]
    | .X2 => exact Matrix.ext fun (i j : Fin 1) ↦ by fin_cases i <;> fin_cases j; exacts [g_1]
    | .T0 => exact Matrix.ext fun (i j : Fin 1) ↦ by fin_cases i <;> fin_cases j; exacts [g_2]
    | .T1 => exact Matrix.ext fun (i j : Fin 1) ↦ by fin_cases i <;> fin_cases j; exacts [g_3]
    | .C1 => exact Matrix.ext fun (i j : Fin 1) ↦ by fin_cases i <;> fin_cases j; exacts [g_4]
  · rintro ⟨t, ht⟩ ⟨s, hs⟩ G hG hne
    simp only [bad, eval_mul, eval_X, eval_add, eval_sub, eval_C] at ht hs
    have hts : t - s ≠ 0 := sub_ne_zero.2 fun h ↦ hne (Subtype.ext h)
    have hD : (t - s) ^ 1 ≠ 0 := by apply_rules [mul_ne_zero, pow_ne_zero, hts]
    have h0 := congrFun (congrFun (hG PC8.X1 PC8.X2 (by decide)) (0 : Fin 1)) (0 : Fin 1)
    have h1 := congrFun (congrFun (hG PC8.T0 PC8.X1 (by decide)) (0 : Fin 1)) (0 : Fin 1)
    have h2 := congrFun (congrFun (hG PC8.T0 PC8.C1 (by decide)) (0 : Fin 1)) (0 : Fin 1)
    have h3 := congrFun (congrFun (hG PC8.T1 PC8.X2 (by decide)) (0 : Fin 1)) (0 : Fin 1)
    have h4 := congrFun (congrFun (hG PC8.T1 PC8.C1 (by decide)) (0 : Fin 1)) (0 : Fin 1)
    simp only [fam, MatFam.mk', Mf, dim, Matrix.mul_apply, Fin.sum_univ_succ, Fin.sum_univ_zero, Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_succ, Matrix.empty_val', Matrix.cons_val_fin_one, Matrix.cons_val_one, Fin.succ_zero_eq_one, Fin.succ_one_eq_two, Fin.reduceSucc, Matrix.cons_val, mul_zero, mul_one, zero_mul, one_mul, add_zero, zero_add, neg_mul, mul_neg, neg_zero] at h0 h1 h2 h3 h4
    have g : (t - s) ^ 1 * G PC8.X1 (0 : Fin 1) (0 : Fin 1) = 0 := by linear_combination (s) * h0 + (1) * h1 + (-s) * h2 + (-s) * h3 + (s) * h4
    exact Matrix.ext fun (i j : Fin 1) ↦ by fin_cases i; fin_cases j; exact eq_zero_of_mul_eq_zero hD g

