module

public import LargeIndecomposable.UnitForms.Tree

/-!
# Ovsienko's theorem (radical vector with a coordinate one, coordinates at most six)

A critical unit form in at least three variables is nonnegative of corank one, and its
radical is generated by a positive vector `z` with some coordinate `z_c = 1`
(`Critical.ovsienko`; Ovsienko, see von Höhne 1988, §1). The proof inflates to a graph
form (`UnitForms/Reduction.lean`), treats graph forms by their patterns
(`UnitForms/Graph.lean`, `UnitForms/Tree.lean`) and pulls the vector back.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable.Forms

namespace UnitForm

variable {ι : Type} [Fintype ι] [DecidableEq ι] {q : UnitForm ι}

/-- `Good` pulls back along an inflation. -/
lemma Rad1.good_of_inflate {y : ι → ℤ} (h : q.Rad1 y) {a b : ι} (hab : a ≠ b)
    (hc : q.c a b = 1) (hG : (q.inflate hab hc).Good) : q.Good := by
  obtain ⟨z1, hz1, hrad1, ⟨c, hc1⟩, h6⟩ := hG
  obtain ⟨hradT, hposT, -⟩ := h.of_inflate hab hc hz1 hrad1
  refine ⟨inflMap a b z1, hposT, hradT, ⟨c, ?_⟩, fun d ↦ ?_⟩
  swap
  · simp only [inflMap, LinearMap.coe_mk, AddHom.coe_mk, Pi.sub_apply, Pi.smul_apply,
      smul_eq_mul, Pi.single_apply]
    split_ifs
    · have := hz1 b; have := h6 d; linarith
    · simpa using h6 d
  have hca : c ≠ a := by
    rintro rfl
    have := hposT c
    simp only [inflMap, LinearMap.coe_mk, AddHom.coe_mk, Pi.sub_apply, Pi.smul_apply,
      smul_eq_mul, Pi.single_apply, if_true, mul_one] at this
    have := hz1 b
    omega
  simp [inflMap, Pi.single_apply, hca, hc1]

/-- Corank one with a positive radical vector (at least three points) gives `Good`. -/
theorem Rad1.good (hn : 3 ≤ Fintype.card ι) {y : ι → ℤ} (h : q.Rad1 y) : q.Good := by
  classical
  haveI : Nonempty ι := Fintype.card_pos_iff.1 (by omega)
  obtain ⟨M, hM⟩ : ∃ M : ℕ, ∀ q' ∈ {q : UnitForm ι | ∀ x, 0 ≤ q.val x}, q'.rsum ≤ M := by
    obtain ⟨M, hM⟩ := ((finite_nonneg (ι := ι)).image rsum).bddAbove
    exact ⟨M, fun q' hq' ↦ hM ⟨q', hq', rfl⟩⟩
  suffices H : ∀ n, ∀ (q : UnitForm ι) (y : ι → ℤ), q.Rad1 y → M - q.rsum = n → q.Good from
    H _ q y h rfl
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro q y h hn'
  by_cases hterm : ∀ a b, a ≠ b → q.c a b ≠ 1
  · exact h.good_of_graph fun a b hab ↦ h.coeff_graph hterm hn hab
  push Not at hterm
  obtain ⟨a, b, hab, hc⟩ := hterm
  have h1 := h.inflate hab hc
  have hlt := q.rsum_lt_inflate h hab hc
  have hle := hM _ h1.1
  exact h.good_of_inflate hab hc
    (ih (M - (q.inflate hab hc).rsum) (by omega) _ _ h1 rfl)

/-- **Ovsienko's theorem.** A critical unit form in at least three variables is
nonnegative, and there are a positive radical vector `z` with all coordinates at most `6`
and a point `c` with `z_c = 1` such that every `x` with `q(x) = 0` is `x_c • z`. -/
theorem Critical.ovsienko (q : UnitForm ι) (hq : q.Critical) (hn : 3 ≤ Fintype.card ι) :
    (∀ x, 0 ≤ q.val x) ∧ ∃ (z : ι → ℤ) (c : ι), (∀ a, 0 < z a) ∧ (∀ x, q.B z x = 0) ∧
      z c = 1 ∧ (∀ a, z a ≤ 6) ∧ ∀ x, q.val x = 0 → x = x c • z := by
  obtain ⟨y, hy⟩ := Critical.rad1 q hq hn
  obtain ⟨z, hz, hrad, ⟨c, hc⟩, h6⟩ := hy.good hn
  refine ⟨hy.1, z, c, hz, hrad, hc, h6, fun x hx ↦ ?_⟩
  have pz := hy.2.2.2 z (val_eq_zero_of_radical _ hrad)
  have px := hy.2.2.2 x hx
  funext d
  have e1 := pz c d
  have e2 := px c d
  rw [hc] at e1
  simp only [Pi.smul_apply, smul_eq_mul]
  have hyc := hy.2.1 c
  have : y c * (x d - x c * z d) = 0 := by linear_combination e2 - x c * e1
  rcases mul_eq_zero.1 this with h | h
  · exact absurd h hyc.ne'
  · linarith

end UnitForm

end LargeIndecomposable.Forms
