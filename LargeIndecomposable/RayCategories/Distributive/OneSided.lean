module

public import LargeIndecomposable.RayCategories.Distributive.FromDistributive
public import LargeIndecomposable.RayCategories.Basic.Small

/-!
# One-sided cyclicity in the ray category of a distributive algebra

The ray-category axiom e) of Bongartz–Gabriel ("`P(x, y)` is cyclic over
`P(x, x)` or over `P(y, y)`") for the BGRS ray category of a distributive
algebra.

* `comm_of_chain`: a local algebra with residue field `k` whose two-sided
  `k`-subspaces form a chain is `k[γ]`, hence commutative.
* `hom_transit_or_cotransit`: each Hom space between indecomposable
  projectives is uniformly transit or cotransit (Kupisch, GR 13.2).
* `ray_oneSided`: axiom e) for the BGRS ray category; `RaySmall.oneSidedCyclic`
  transfers it to the small model.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

section Ring

variable {k : Type*} [Field k] {R : Type*} [Ring R] [Algebra k R]

/-- A `k`-subspace closed under multiplication on both sides. -/
def IsTwoSidedSub (V : Submodule k R) : Prop :=
  (∀ a x, x ∈ V → a * x ∈ V) ∧ ∀ a x, x ∈ V → x * a ∈ V

/-- **A chain of two-sided ideals forces commutativity.** A local `k`-algebra
with residue field `k` and nilpotent radical whose two-sided `k`-subspaces form
a chain is generated by one element, hence commutative. -/
theorem comm_of_chain [IsArtinianRing R] (ε : R →ₐ[k] k)
    (hε : ∀ a, ε a = 0 ↔ a ∈ Ring.jacobson R)
    (hchain : ∀ U V : Submodule k R, IsTwoSidedSub U → IsTwoSidedSub V → U ≤ V ∨ V ≤ U) :
    ∀ a b : R, a * b = b * a := by
  set J := Ring.jacobson R with hJ
  have hdec : ∀ a : R, a - algebraMap k R (ε a) ∈ J := fun a ↦ by
    rw [← hε, map_sub, AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply, sub_self]
  -- the two-sided subspace `k x + J²`
  let W : R → Submodule k R := fun x ↦ Submodule.span k {x} ⊔ (J ^ 2).restrictScalars k
  have hJ2 : ∀ y z, y ∈ J → z ∈ J → y * z ∈ J ^ 2 := fun y z hy hz ↦ by
    rw [Ideal.IsTwoSided.pow_succ, Submodule.pow_one]; exact Ideal.mul_mem_mul hy hz
  have hl : ∀ a x : R, a * x = ε a • x + (a - algebraMap k R (ε a)) * x := fun a x ↦ by
    rw [Algebra.smul_def, sub_mul, add_sub_cancel]
  have hr : ∀ a x : R, x * a = ε a • x + x * (a - algebraMap k R (ε a)) := fun a x ↦ by
    rw [Algebra.smul_def, Algebra.commutes, mul_sub, add_sub_cancel]
  have hW : ∀ x ∈ J, IsTwoSidedSub (W x) := by
    intro x hx
    constructor
    · intro a y hy
      obtain ⟨y₁, h₁, y₂, h₂, rfl⟩ := Submodule.mem_sup.1 hy
      obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.1 h₁
      refine Submodule.mem_sup.2 ⟨(c * ε a) • x, Submodule.mem_span_singleton.2 ⟨_, rfl⟩,
        c • ((a - algebraMap k R (ε a)) * x) + a * y₂, ?_, ?_⟩
      · refine Submodule.add_mem _ (Submodule.smul_mem _ _ (hJ2 _ _ (hdec a) hx)) ?_
        exact (J ^ 2).mul_mem_left a h₂
      · rw [mul_add, mul_smul_comm, hl a x, smul_add, smul_smul, add_assoc]
    · intro a y hy
      obtain ⟨y₁, h₁, y₂, h₂, rfl⟩ := Submodule.mem_sup.1 hy
      obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.1 h₁
      refine Submodule.mem_sup.2 ⟨(c * ε a) • x, Submodule.mem_span_singleton.2 ⟨_, rfl⟩,
        c • (x * (a - algebraMap k R (ε a))) + y₂ * a, ?_, ?_⟩
      · refine Submodule.add_mem _ (Submodule.smul_mem _ _ (hJ2 _ _ hx (hdec a))) ?_
        exact (J ^ 2).mul_mem_right a h₂
      · rw [add_mul, smul_mul_assoc, hr a x, smul_add, smul_smul, add_assoc]
  have hJ2k : ∀ (c : k) {y}, y ∈ J ^ 2 → c • y ∈ J ^ 2 := fun c y hy ↦
    ((J ^ 2).restrictScalars k).smul_mem c hy
  -- a generator of `J / J²`
  obtain ⟨γ, hγ, hgen⟩ : ∃ γ ∈ J, ∀ x ∈ J, ∃ c : k, x - c • γ ∈ J ^ 2 := by
    by_cases h : ∃ γ ∈ J, γ ∉ J ^ 2
    · obtain ⟨γ, hγ, hγ2⟩ := h
      refine ⟨γ, hγ, fun x hx ↦ ?_⟩
      rcases hchain (W x) (W γ) (hW x hx) (hW γ hγ) with hle | hle
      · obtain ⟨y₁, h₁, y₂, h₂, he⟩ := Submodule.mem_sup.1
          (hle (Submodule.mem_sup_left (Submodule.mem_span_singleton_self x)))
        obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.1 h₁
        exact ⟨c, by rw [← he, add_sub_cancel_left]; exact h₂⟩
      · obtain ⟨y₁, h₁, y₂, h₂, he⟩ := Submodule.mem_sup.1
          (hle (Submodule.mem_sup_left (Submodule.mem_span_singleton_self γ)))
        obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.1 h₁
        have hc : c ≠ 0 := by
          rintro rfl
          apply hγ2
          rw [← he, zero_smul, zero_add]
          exact h₂
        refine ⟨c⁻¹, ?_⟩
        have : x - c⁻¹ • γ = -(c⁻¹ • y₂) := by
          rw [← he, smul_add, smul_smul, inv_mul_cancel₀ hc, one_smul]
          abel
        rw [this]
        exact (J ^ 2).neg_mem (hJ2k _ h₂)
    · push Not at h
      exact ⟨0, J.zero_mem, fun x hx ↦ ⟨0, by simpa using h x hx⟩⟩
  -- every element of `J` is `γ p(γ)` modulo `J^(n+1)`
  have hB : ∀ n : ℕ, ∀ x ∈ J, ∃ q : Polynomial k, x - γ * Polynomial.aeval γ q ∈ J ^ (n + 1) := by
    intro n
    induction n with
    | zero => exact fun x hx ↦ ⟨0, by
        simp only [map_zero, mul_zero, sub_zero, zero_add, Submodule.pow_one]; exact hx⟩
    | succ n ih =>
      have hprod : ∀ z ∈ J ^ 2, ∃ q : Polynomial k, z - γ * Polynomial.aeval γ q ∈ J ^ (n + 2) := by
        intro z hz
        rw [Ideal.IsTwoSided.pow_succ, Submodule.pow_one] at hz
        refine Submodule.mul_induction_on
          (C := fun z ↦ ∃ q : Polynomial k, z - γ * Polynomial.aeval γ q ∈ J ^ (n + 2)) hz ?_ ?_
        · intro y hy z hz
          obtain ⟨p, hp⟩ := ih y hy
          obtain ⟨q, hq⟩ := ih z hz
          refine ⟨p * Polynomial.X * q, ?_⟩
          have e : y * z - γ * Polynomial.aeval γ (p * Polynomial.X * q) =
              (γ * Polynomial.aeval γ p) * (z - γ * Polynomial.aeval γ q) +
                (y - γ * Polynomial.aeval γ p) * z := by
            simp only [map_mul, Polynomial.aeval_X, mul_sub, sub_mul, mul_assoc]
            abel
          rw [e]
          refine Ideal.add_mem _ ?_ ?_
          · rw [Ideal.IsTwoSided.pow_succ]
            exact Ideal.mul_mem_mul (J.mul_mem_right _ hγ) hq
          · rw [show n + 2 = (n + 1) + 1 from rfl, Submodule.pow_succ]
            exact Ideal.mul_mem_mul hp hz
        · rintro y z ⟨p, hp⟩ ⟨q, hq⟩
          refine ⟨p + q, ?_⟩
          have e : y + z - γ * Polynomial.aeval γ (p + q) =
              (y - γ * Polynomial.aeval γ p) + (z - γ * Polynomial.aeval γ q) := by
            simp only [map_add, mul_add]
            abel
          rw [e]
          exact Ideal.add_mem _ hp hq
      intro x hx
      obtain ⟨c, hc⟩ := hgen x hx
      obtain ⟨q, hq⟩ := hprod _ hc
      refine ⟨Polynomial.C c + q, ?_⟩
      have e : x - γ * Polynomial.aeval γ (Polynomial.C c + q) =
          x - c • γ - γ * Polynomial.aeval γ q := by
        simp only [map_add, Polynomial.aeval_C, mul_add, Algebra.smul_def, Algebra.commutes]
        abel
      rw [e]
      exact hq
  obtain ⟨N, hN⟩ := IsArtinianRing.isNilpotent_jacobson_bot (R := R)
  rw [Ideal.jacobson_bot, ← hJ] at hN
  have hpoly : ∀ r : R, ∃ p : Polynomial k, r = Polynomial.aeval γ p := by
    intro r
    obtain ⟨q, hq⟩ := hB N _ (hdec r)
    have h0 : r - algebraMap k R (ε r) - γ * Polynomial.aeval γ q = 0 := by
      have := Ideal.pow_le_pow_right (I := J) (Nat.le_succ N) hq
      rw [hN] at this
      exact this
    refine ⟨Polynomial.C (ε r) + Polynomial.X * q, ?_⟩
    rw [map_add, map_mul, Polynomial.aeval_C, Polynomial.aeval_X]
    rw [sub_sub, sub_eq_zero] at h0
    exact h0
  intro a b
  obtain ⟨p, rfl⟩ := hpoly a
  obtain ⟨q, rfl⟩ := hpoly b
  rw [← map_mul, mul_comm, map_mul]

end Ring

section Def

open CategoryTheory Limits LargeIndecomposable

/-- **Ray axiom e)**: for each pair of objects, two-sided multiples are
one-sided multiples, on a side depending only on the pair. -/
def OneSidedCyclic (C : Type*) [Category C] [HasZeroMorphisms C] : Prop :=
  ∀ X Y : C,
    (∀ f g : X ⟶ Y, g ≠ 0 → TwoSidedEndomorphismFactors f g → ∃ b : End Y, g = f ≫ b) ∨
      (∀ f g : X ⟶ Y, g ≠ 0 → TwoSidedEndomorphismFactors f g → ∃ a : End X, g = a ≫ f)

namespace RayCat.RaySmall

universe w' v' u'

variable {P : Type u'} [Category.{v'} P] [HasZeroMorphisms P] [LocallySmall.{w'} P]

lemma oneSidedCyclic (h : OneSidedCyclic P) :
    @OneSidedCyclic (RaySmall.{u'} P) category.{w'} hasZeroMorphisms := by
  intro X Y
  have tf : ∀ f g : X ⟶ Y, TwoSidedEndomorphismFactors f g →
      TwoSidedEndomorphismFactors ((sh.{w'}).symm f) ((sh.{w'}).symm g) := by
    rintro f g ⟨a, b, hab⟩
    refine ⟨End.of ((sh.{w'}).symm a), End.of ((sh.{w'}).symm b), ?_⟩
    rw [hab]
    rw [sh_symm_comp, sh_symm_comp]
  have nz : ∀ g : X ⟶ Y, g ≠ 0 → (sh.{w'}).symm g ≠ 0 := fun g hg h0 ↦ hg (by
    rw [← Equiv.apply_symm_apply sh g, h0]; rfl)
  rcases h X.as Y.as with h | h
  · refine Or.inl fun f g hg hfg ↦ ?_
    obtain ⟨b, hb⟩ := h _ _ (nz g hg) (tf f g hfg)
    refine ⟨End.of (sh b), ?_⟩
    rw [← Equiv.apply_symm_apply sh g, hb, sh_comp, Equiv.apply_symm_apply]
  · refine Or.inr fun f g hg hfg ↦ ?_
    obtain ⟨a, ha⟩ := h _ _ (nz g hg) (tf f g hfg)
    refine ⟨End.of (sh a), ?_⟩
    rw [← Equiv.apply_symm_apply sh g, ha, sh_comp, Equiv.apply_symm_apply]

end RayCat.RaySmall

end Def

section Proj

open CategoryTheory LargeIndecomposable

universe u v w

variable {k : Type u} [Field k] {A : Type v} [Ring A] [Algebra k A] [Module.Finite k A]
  {ι : Type w} [Fintype ι] [DecidableEq ι]
  (S : SplitBasicIdempotents (k := k) (A := A) (ι := ι))
  [HasBGRSDistributiveHomStructure k S.ProjectiveCategory]

/-- Endomorphism rings of indecomposable projectives of a distributive algebra
are commutative (they are `k[γ]`). -/
theorem projEnd_comm (i : S.ProjectiveCategory) (a b : End i) : a * b = b * a := by
  refine comm_of_chain (S.projectiveEndResidue i) (fun f ↦ ?_) (fun U V hU hV ↦ ?_) a b
  · rw [S.projectiveEndResidue_eq_zero_iff_val_mem_jacobson,
      ← S.projectiveEnd_mem_jacobson_iff_val_mem_jacobson]
  · have h : ∀ W : Submodule k (End i), IsTwoSidedSub W →
        IsHomSubbimodule (C := S.ProjectiveCategory) (k := k) (X := i) (Y := i) W :=
      fun W hW ↦ ⟨fun a f hf ↦ hW.2 a f hf, fun b f hf ↦ hW.1 b f hf⟩
    exact HasBGRSDistributiveHomStructure.homSubbimodule_comparable U V (h U hU) (h V hV)

lemma projEnd_comp_comm {i : S.ProjectiveCategory} (a b : End i) :
    a.asHom ≫ b.asHom = b.asHom ≫ a.asHom :=
  projEnd_comm S i b a

/-- **Uniform Kupisch cyclicity.** Every Hom space between indecomposable
projectives of a distributive algebra allows transit at all its elements, or
cotransit at all its elements. -/
theorem hom_transit_or_cotransit (X Y : S.ProjectiveCategory) :
    (∀ f : X ⟶ Y, AllowsTransit f) ∨ (∀ f : X ⟶ Y, AllowsCotransit f) := by
  obtain ⟨_, ⟨f₀, rfl⟩, hmax⟩ := (wellFounded_gt (α := Submodule k (X ⟶ Y))).has_min
    (Set.range fun f : X ⟶ Y ↦ twoSidedEndomorphismSpan k f) ⟨_, 0, rfl⟩
  have hall : ∀ f : X ⟶ Y, f ∈ twoSidedEndomorphismSpan k f₀ := by
    intro f
    rcases HasBGRSDistributiveHomStructure.homSubbimodule_comparable (k := k)
        (twoSidedEndomorphismSpan k f) (twoSidedEndomorphismSpan k f₀)
        (isHomSubbimodule_twoSidedEndomorphismSpan f)
        (isHomSubbimodule_twoSidedEndomorphismSpan f₀) with h | h
    · exact h (mem_twoSidedEndomorphismSpan k f)
    · rw [eq_of_le_of_not_lt h (hmax _ ⟨f, rfl⟩)]
      exact mem_twoSidedEndomorphismSpan k f
  rcases HasBGRSDistributiveHomStructure.transit_or_cotransit (k := k) f₀ with hT | hC
  · refine Or.inl fun f a ↦ ?_
    obtain ⟨bf, hbf⟩ := exists_comp_of_mem_span_of_allowsTransit hT (hall f)
    obtain ⟨ba, hba⟩ := hT a
    refine ⟨ba, ?_⟩
    rw [hbf, ← Category.assoc, hba, Category.assoc, Category.assoc, projEnd_comp_comm S ba bf]
  · refine Or.inr fun f b ↦ ?_
    obtain ⟨af, haf⟩ := exists_comp_of_mem_span_of_allowsCotransit hC (hall f)
    obtain ⟨ab, hab⟩ := hC b
    refine ⟨ab, ?_⟩
    rw [haf, Category.assoc, hab, ← Category.assoc, ← Category.assoc, projEnd_comp_comm S af ab]

omit [Module.Finite k A] [HasBGRSDistributiveHomStructure k S.ProjectiveCategory] in
lemma rep_eq_comp_of_ne_zero {X Y Z : S.ProjectiveCategory} {p : X ⟶ Y} {q : Y ⟶ Z}
    (h : bgrsRayRepresentativeProduct p q ≠ 0) : bgrsRayRepresentativeProduct p q = p ≫ q := by
  by_cases hs : IsBGRSSpecialZero p q
  · exact absurd (bgrsRayRepresentativeProduct_eq_zero_of_special hs) h
  · exact bgrsRayRepresentativeProduct_eq_comp_of_not_special hs

/-- A nonzero two-sided multiple of a ray has representatives in the principal
span of a representative. -/
lemma exists_rep_mem_span {X Y : S.ProjectiveCategory}
    (f g : (⟨X⟩ : S.RayCategory) ⟶ ⟨Y⟩) (hg : g ≠ 0) (hfg : TwoSidedEndomorphismFactors f g) :
    ∃ f' g' : X ⟶ Y, f = unitRay f' ∧ g = unitRay g' ∧ g' ≠ 0 ∧
      g' ∈ twoSidedEndomorphismSpan k f' := by
  obtain ⟨a, b, hab⟩ := hfg
  obtain ⟨f', rfl⟩ := unitRay_surjective X Y f
  obtain ⟨g', rfl⟩ := unitRay_surjective X Y g
  obtain ⟨a', rfl⟩ := unitRay_surjective X X a
  obtain ⟨b', rfl⟩ := unitRay_surjective Y Y b
  have hg' : g' ≠ 0 := (unitRay_ne_zero_iff g').1 hg
  change unitRay g' = unitRay (bgrsRayRepresentativeProduct
    (bgrsRayRepresentativeProduct a' f') b') at hab
  obtain ⟨u, v, huv⟩ := (unitRay_eq_iff _ _).1 hab.symm
  have hh : bgrsRayRepresentativeProduct (bgrsRayRepresentativeProduct a' f') b' ≠ 0 := by
    intro h0
    rw [h0] at huv
    exact hg' (by rw [huv]; simp)
  have hh' : bgrsRayRepresentativeProduct a' f' ≠ 0 := by
    intro h0
    apply hh
    rw [h0]
    exact bgrsRayRepresentativeProduct_zero_left b'
  rw [rep_eq_comp_of_ne_zero S hh, rep_eq_comp_of_ne_zero S hh'] at huv
  refine ⟨f', g', rfl, rfl, hg', Submodule.subset_span ⟨End.of (u.hom ≫ a'),
    End.of (b' ≫ v.hom), ?_⟩⟩
  rw [huv]
  simp only [End.of, Category.assoc]

/-- **Ray axiom e)** (one-sided cyclicity). In the ray category of a
distributive algebra, for each pair of objects either every two-sided multiple
of a morphism is already a multiple on the target side, or every one is a
multiple on the source side. -/
theorem ray_oneSided : OneSidedCyclic S.RayCategory := by
  intro X Y
  rcases X with ⟨X⟩
  rcases Y with ⟨Y⟩
  rcases hom_transit_or_cotransit S X Y with hT | hC
  · refine Or.inl fun f g hg hfg ↦ ?_
    obtain ⟨f', g', rfl, rfl, hg', hmem⟩ := exists_rep_mem_span S f g hg hfg
    obtain ⟨b, hb, hns⟩ :=
      exists_nonspecial_right_factor_of_mem_span_of_allowsTransit (k := k) hg' (hT f') hmem
    refine ⟨unitRay b, ?_⟩
    change unitRay g' = unitRay (bgrsRayRepresentativeProduct f' b)
    rw [bgrsRayRepresentativeProduct_eq_comp_of_not_special hns, ← hb]
  · refine Or.inr fun f g hg hfg ↦ ?_
    obtain ⟨f', g', rfl, rfl, hg', hmem⟩ := exists_rep_mem_span S f g hg hfg
    obtain ⟨a, ha, hns⟩ :=
      exists_nonspecial_left_factor_of_mem_span_of_allowsCotransit (k := k) hg' (hC f') hmem
    refine ⟨unitRay a, ?_⟩
    change unitRay g' = unitRay (bgrsRayRepresentativeProduct a f')
    rw [bgrsRayRepresentativeProduct_eq_comp_of_not_special hns, ← ha]

end Proj

end LargeIndecomposable
