module

public import LargeIndecomposable.RayCategories.Distributive.SplitBasicRayCategory
public import Mathlib.Order.Atoms.Finite
public import Mathlib.RingTheory.Ideal.Operations
public import Mathlib.Tactic.Module

@[expose] public section

/-!
# Finite ideal lattices force primitive-projective Hom chains

For a split-basic finite-dimensional algebra, endpoint-stable subspaces of a
primitive-projective Hom space embed into the ambient two-sided ideal lattice.
If two such subspaces were incomparable, finite cover intervals and the split
residue maps would produce a projective pencil indexed injectively by the
ground field.  An infinite field and a finite ideal lattice therefore force
all endpoint-stable Hom subspaces to be comparable.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section

open CategoryTheory
open Mathlib.Tactic.Module
open scoped Pointwise

namespace LargeIndecomposable.SplitBasicIdempotents.ProjectiveCategory

universe u v x

variable {k : Type u} [Field k]
variable {A : Type v} [Ring A] [Algebra k A]
variable {ι : Type x} [Fintype ι] [DecidableEq ι]

variable (S : LargeIndecomposable.SplitBasicIdempotents
  (k := k) (A := A) (ι := ι))

/-- The selected corner of an ambient two-sided ideal. -/
def finiteIdealCorner (I : TwoSidedIdeal A)
    (i j : S.ProjectiveCategory) : Submodule k (i ⟶ j) where
  carrier := {f | f.1 ∈ I}
  zero_mem' := I.zero_mem
  add_mem' hf hg := I.add_mem hf hg
  smul_mem' c f hf := by
    change c • f.1 ∈ I
    rw [Algebra.smul_def]
    exact I.mul_mem_left _ _ hf

theorem finiteIdealCorner_isHomSubbimodule (I : TwoSidedIdeal A)
    (i j : S.ProjectiveCategory) :
    LargeIndecomposable.IsHomSubbimodule (finiteIdealCorner S I i j) := by
  constructor
  · intro a f hf
    change f.1 * a.1 ∈ I
    exact I.mul_mem_right _ _ hf
  · intro b f hf
    change b.1 * f.1 ∈ I
    exact I.mul_mem_left _ _ hf

/-- The ambient ideal generated by an endpoint-stable Hom subspace. -/
def finiteIdealHomSpan {i j : S.ProjectiveCategory}
    (T : Submodule k (i ⟶ j)) : TwoSidedIdeal A :=
  TwoSidedIdeal.span ((fun f : i ⟶ j => f.1) '' (T : Set (i ⟶ j)))

/-- The categorical factor span through one fixed morphism, allowing arbitrary
outer source and target objects. -/
def morphismFactorSpan
    {U V : S.ProjectiveCategory} (r : U ⟶ V)
    (X Y : S.ProjectiveCategory) : Submodule k (X ⟶ Y) :=
  Submodule.span k {h | ∃ (a : X ⟶ U) (b : V ⟶ Y),
    h = (a ≫ r) ≫ b}

/-- Project an ambient algebra element to a chosen primitive corner. -/
private def finiteIdealCornerProjection (i j : S.ProjectiveCategory)
    (a : A) : i ⟶ j :=
  ⟨S.idempotent (S.projectiveVertex j) * a *
      S.idempotent (S.projectiveVertex i), ⟨a, rfl⟩⟩

@[simp]
private theorem finiteIdealCornerProjection_val (i j : S.ProjectiveCategory)
    (a : A) :
    (finiteIdealCornerProjection S i j a).1 =
      S.idempotent (S.projectiveVertex j) * a *
        S.idempotent (S.projectiveVertex i) :=
  rfl

@[simp]
private theorem finiteIdealHom_zero_val {i j : S.ProjectiveCategory} :
    ((0 : i ⟶ j)).1 = (0 : A) :=
  rfl

@[simp]
private theorem finiteIdealHom_add_val {i j : S.ProjectiveCategory}
    (f g : i ⟶ j) : (f + g).1 = f.1 + g.1 :=
  rfl

@[simp]
private theorem finiteIdealHom_neg_val {i j : S.ProjectiveCategory}
    (f : i ⟶ j) : (-f).1 = -f.1 :=
  rfl

@[simp]
private theorem finiteIdealCornerProjection_val_hom
    {i j : S.ProjectiveCategory} (f : i ⟶ j) :
    finiteIdealCornerProjection S i j f.1 = f := by
  apply Subtype.ext
  simp only [finiteIdealCornerProjection_val]
  rw [idempotent_mul_val S f, val_mul_idempotent S f]

/-- The selected corner of the ambient principal ideal generated by a
morphism is exactly the span of categorical composites factoring through that
morphism. -/
theorem finiteIdealCorner_span_singleton_eq_morphismFactorSpan
    {U V : S.ProjectiveCategory} (r : U ⟶ V)
    (X Y : S.ProjectiveCategory) :
    finiteIdealCorner S (TwoSidedIdeal.span ({r.1} : Set A)) X Y =
      morphismFactorSpan S r X Y := by
  apply le_antisymm
  · intro f hf
    change f.1 ∈ TwoSidedIdeal.span ({r.1} : Set A) at hf
    rw [TwoSidedIdeal.mem_span_iff_mem_addSubgroup_closure] at hf
    have hproj : ∀ z : A,
        z ∈ AddSubgroup.closure
          (Set.univ * ({r.1} : Set A) * Set.univ) →
        finiteIdealCornerProjection S X Y z ∈
          morphismFactorSpan S r X Y := by
      intro z hz
      induction hz using AddSubgroup.closure_induction with
      | mem z hz =>
          rcases hz with
            ⟨_, ⟨a, -, z, hz, rfl⟩, b, -, rfl⟩
          simp only [Set.mem_singleton_iff] at hz
          subst z
          let pre : X ⟶ U := finiteIdealCornerProjection S X U b
          let post : V ⟶ Y := finiteIdealCornerProjection S V Y a
          apply Submodule.subset_span
          refine ⟨pre, post, ?_⟩
          apply Subtype.ext
          dsimp [pre, post, finiteIdealCornerProjection]
          have hL := idempotent_mul_val S r
          have hR := val_mul_idempotent S r
          calc
            S.idempotent (S.projectiveVertex Y) *
                  (a * r.1 * b) *
                S.idempotent (S.projectiveVertex X) =
                (S.idempotent (S.projectiveVertex Y) * a) *
                  r.1 *
                    (b * S.idempotent (S.projectiveVertex X)) := by
                      simp only [mul_assoc]
            _ = ((S.idempotent (S.projectiveVertex Y) * a) *
                    S.idempotent (S.projectiveVertex V)) *
                  r.1 *
                    (b * S.idempotent (S.projectiveVertex X)) := by
                      rw [mul_assoc
                        (S.idempotent (S.projectiveVertex Y) * a)
                        (S.idempotent (S.projectiveVertex V)) r.1, hL]
            _ = ((S.idempotent (S.projectiveVertex Y) * a) *
                    S.idempotent (S.projectiveVertex V)) *
                  r.1 *
                    (S.idempotent (S.projectiveVertex U) *
                      (b * S.idempotent (S.projectiveVertex X))) := by
                      let c := (S.idempotent (S.projectiveVertex Y) * a) *
                        S.idempotent (S.projectiveVertex V)
                      let t := b * S.idempotent (S.projectiveVertex X)
                      change c * r.1 * t = c * r.1 *
                        (S.idempotent (S.projectiveVertex U) * t)
                      calc
                        c * r.1 * t = c * (r.1 * t) :=
                          mul_assoc c r.1 t
                        _ = c * (r.1 *
                            (S.idempotent (S.projectiveVertex U) * t)) := by
                              rw [← mul_assoc r.1
                                (S.idempotent (S.projectiveVertex U)) t, hR]
                        _ = c * r.1 *
                            (S.idempotent (S.projectiveVertex U) * t) :=
                              (mul_assoc c r.1 _).symm
            _ = S.idempotent (S.projectiveVertex Y) * a *
                  S.idempotent (S.projectiveVertex V) *
                    (r.1 *
                      (S.idempotent (S.projectiveVertex U) * b *
                        S.idempotent (S.projectiveVertex X))) := by
                          simp only [mul_assoc]
      | zero =>
          change finiteIdealCornerProjection S X Y 0 ∈ _
          convert (morphismFactorSpan S r X Y).zero_mem using 1
          apply Subtype.ext
          simp
      | add a b _ _ ha hb =>
          have heq : finiteIdealCornerProjection S X Y (a + b) =
              finiteIdealCornerProjection S X Y a +
                finiteIdealCornerProjection S X Y b := by
            apply Subtype.ext
            simp [mul_add, add_mul]
          rw [heq]
          exact (morphismFactorSpan S r X Y).add_mem ha hb
      | neg a _ ha =>
          have heq : finiteIdealCornerProjection S X Y (-a) =
              - finiteIdealCornerProjection S X Y a := by
            apply Subtype.ext
            simp
          rw [heq]
          exact (morphismFactorSpan S r X Y).neg_mem ha
    have hp := hproj f.1 hf
    rw [finiteIdealCornerProjection_val_hom S f] at hp
    exact hp
  · apply Submodule.span_le.2
    rintro h ⟨a, b, rfl⟩
    change ((a ≫ r) ≫ b).1 ∈
      TwoSidedIdeal.span ({r.1} : Set A)
    simp only [comp_val]
    exact TwoSidedIdeal.mul_mem_left _ b.1 _
      (TwoSidedIdeal.mul_mem_right _ r.1 a.1
        (TwoSidedIdeal.subset_span (Set.mem_singleton r.1)))

/-- At the source and target of the generator, the categorical factor span is
its usual principal two-sided endomorphism span. -/
theorem morphismFactorSpan_self
    {U V : S.ProjectiveCategory} (r : U ⟶ V) :
    morphismFactorSpan S r U V =
      LargeIndecomposable.twoSidedEndomorphismSpan k r := by
  rfl

/-- Taking a selected corner commutes with the sum of two ambient two-sided
ideals. -/
theorem finiteIdealCorner_sup
    (I J : TwoSidedIdeal A) (X Y : S.ProjectiveCategory) :
    finiteIdealCorner S (I ⊔ J) X Y =
      finiteIdealCorner S I X Y ⊔ finiteIdealCorner S J X Y := by
  ext f
  constructor
  · intro hf
    change f.1 ∈ I ⊔ J at hf
    rw [TwoSidedIdeal.mem_sup] at hf
    rcases hf with ⟨a, ha, b, hb, hab⟩
    rw [Submodule.mem_sup]
    refine ⟨finiteIdealCornerProjection S X Y a, ?_,
      finiteIdealCornerProjection S X Y b, ?_, ?_⟩
    · change S.idempotent (S.projectiveVertex Y) * a *
          S.idempotent (S.projectiveVertex X) ∈ I
      exact I.mul_mem_right _ _ (I.mul_mem_left _ _ ha)
    · change S.idempotent (S.projectiveVertex Y) * b *
          S.idempotent (S.projectiveVertex X) ∈ J
      exact J.mul_mem_right _ _ (J.mul_mem_left _ _ hb)
    · apply Subtype.ext
      change S.idempotent (S.projectiveVertex Y) * a *
          S.idempotent (S.projectiveVertex X) +
        S.idempotent (S.projectiveVertex Y) * b *
          S.idempotent (S.projectiveVertex X) = f.1
      rw [← add_mul, ← mul_add, hab,
        idempotent_mul_val S f, val_mul_idempotent S f]
  · intro hf
    rw [Submodule.mem_sup] at hf
    rcases hf with ⟨a, ha, b, hb, hab⟩
    change f.1 ∈ I ⊔ J
    rw [TwoSidedIdeal.mem_sup]
    refine ⟨a.1, ha, b.1, hb, ?_⟩
    exact congrArg Subtype.val hab

/-- The selected corner of a two-generator ambient ideal is the sum of the
two corresponding categorical factor spans. -/
theorem finiteIdealCorner_span_pair_eq
    {U V W T : S.ProjectiveCategory}
    (r : U ⟶ V) (s : W ⟶ T)
    (X Y : S.ProjectiveCategory) :
    finiteIdealCorner S
        (TwoSidedIdeal.span ({r.1, s.1} : Set A)) X Y =
      morphismFactorSpan S r X Y ⊔
        morphismFactorSpan S s X Y := by
  have hspan : TwoSidedIdeal.span ({r.1, s.1} : Set A) =
      TwoSidedIdeal.span ({r.1} : Set A) ⊔
        TwoSidedIdeal.span ({s.1} : Set A) := by
    apply le_antisymm
    · apply TwoSidedIdeal.span_le.2
      intro a ha
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha
      rcases ha with rfl | rfl
      · exact TwoSidedIdeal.mem_sup_left
          (TwoSidedIdeal.subset_span (Set.mem_singleton r.1))
      · exact TwoSidedIdeal.mem_sup_right
          (TwoSidedIdeal.subset_span (Set.mem_singleton s.1))
    · apply sup_le
      · apply TwoSidedIdeal.span_le.2
        intro a ha
        rw [Set.mem_singleton_iff] at ha
        subst a
        exact TwoSidedIdeal.subset_span (by simp)
      · apply TwoSidedIdeal.span_le.2
        intro a ha
        rw [Set.mem_singleton_iff] at ha
        subst a
        exact TwoSidedIdeal.subset_span (by simp)
  rw [hspan, finiteIdealCorner_sup,
    finiteIdealCorner_span_singleton_eq_morphismFactorSpan,
    finiteIdealCorner_span_singleton_eq_morphismFactorSpan]

/-- Generating an ambient ideal and taking the original corner recovers an
endpoint-stable Hom subspace exactly. -/
theorem finiteIdealCorner_homSpan_eq
    {i j : S.ProjectiveCategory} (T : Submodule k (i ⟶ j))
    (hT : LargeIndecomposable.IsHomSubbimodule T) :
    finiteIdealCorner S (finiteIdealHomSpan S T) i j = T := by
  apply le_antisymm
  · intro f hf
    change f.1 ∈ TwoSidedIdeal.span
      ((fun g : i ⟶ j => g.1) '' (T : Set (i ⟶ j))) at hf
    rw [TwoSidedIdeal.mem_span_iff_mem_addSubgroup_closure] at hf
    have hproj : ∀ z : A,
        z ∈ AddSubgroup.closure
          (Set.univ * ((fun g : i ⟶ j => g.1) ''
            (T : Set (i ⟶ j))) * Set.univ) →
        finiteIdealCornerProjection S i j z ∈ T := by
      intro z hz
      induction hz using AddSubgroup.closure_induction with
      | mem z hz =>
          rcases hz with
            ⟨_, ⟨a, -, z, ⟨g, hg, rfl⟩, rfl⟩, b, -, rfl⟩
          let ai : End i :=
            ⟨S.idempotent (S.projectiveVertex i) * b *
              S.idempotent (S.projectiveVertex i), ⟨b, rfl⟩⟩
          let bj : End j :=
            ⟨S.idempotent (S.projectiveVertex j) * a *
              S.idempotent (S.projectiveVertex j), ⟨a, rfl⟩⟩
          have hm : (ai.asHom ≫ g) ≫ bj.asHom ∈ T :=
            hT.2 bj (hT.1 ai hg)
          have heq : finiteIdealCornerProjection S i j (a * g.1 * b) =
              (ai.asHom ≫ g) ≫ bj.asHom := by
            apply Subtype.ext
            dsimp [finiteIdealCornerProjection, ai, bj]
            have hL := idempotent_mul_val S g
            have hR := val_mul_idempotent S g
            have hL' (q : A) :
                S.idempotent (S.projectiveVertex j) * (g.1 * q) =
                  g.1 * q := by
              rw [← mul_assoc, hL]
            have hR' (q : A) :
                g.1 * (S.idempotent (S.projectiveVertex i) * q) =
                  g.1 * q := by
              rw [← mul_assoc, hR]
            simp only [mul_assoc, hL', hR']
          rw [heq]
          exact hm
      | zero =>
          have heq : finiteIdealCornerProjection S i j 0 = 0 := by
            apply Subtype.ext
            simp only [finiteIdealCornerProjection_val,
              finiteIdealHom_zero_val, mul_zero, zero_mul]
          rw [heq]
          exact T.zero_mem
      | add a b _ _ ha hb =>
          have heq : finiteIdealCornerProjection S i j (a + b) =
              finiteIdealCornerProjection S i j a +
                finiteIdealCornerProjection S i j b := by
            apply Subtype.ext
            simp only [finiteIdealCornerProjection_val,
              finiteIdealHom_add_val, mul_add, add_mul]
          rw [heq]
          exact T.add_mem ha hb
      | neg a _ ha =>
          have heq : finiteIdealCornerProjection S i j (-a) =
              - finiteIdealCornerProjection S i j a := by
            apply Subtype.ext
            simp only [finiteIdealCornerProjection_val,
              finiteIdealHom_neg_val, mul_neg, neg_mul]
          rw [heq]
          exact T.neg_mem ha
    have hp := hproj f.1 hf
    rw [finiteIdealCornerProjection_val_hom S f] at hp
    exact hp
  · intro f hf
    apply TwoSidedIdeal.subset_span
    exact ⟨f, hf, rfl⟩

/-- Bundled endpoint-stable Hom subspaces. -/
private def FiniteIdealHomSubbimodule (i j : S.ProjectiveCategory) :=
  {T : Submodule k (i ⟶ j) // LargeIndecomposable.IsHomSubbimodule T}

private instance finiteIdealHomSubbimodule_partialOrder
    (i j : S.ProjectiveCategory) :
    PartialOrder (FiniteIdealHomSubbimodule S i j) :=
  PartialOrder.lift Subtype.val Subtype.val_injective

private def finiteIdealHomSubbimoduleIdeal {i j : S.ProjectiveCategory}
    (T : FiniteIdealHomSubbimodule S i j) : TwoSidedIdeal A :=
  finiteIdealHomSpan S T.1

private theorem finiteIdealHomSubbimoduleIdeal_injective
    {i j : S.ProjectiveCategory} :
    Function.Injective
      (finiteIdealHomSubbimoduleIdeal S :
        FiniteIdealHomSubbimodule S i j → TwoSidedIdeal A) := by
  intro T U h
  apply Subtype.ext
  have hT := finiteIdealCorner_homSpan_eq S T.1 T.2
  have hU := finiteIdealCorner_homSpan_eq S U.1 U.2
  rw [← hT, ← hU]
  change finiteIdealHomSpan S T.1 = finiteIdealHomSpan S U.1 at h
  rw [h]

private noncomputable instance finiteIdealHomSubbimodule_finite
    [Finite (TwoSidedIdeal A)] (i j : S.ProjectiveCategory) :
    Finite (FiniteIdealHomSubbimodule S i j) :=
  Finite.of_injective (finiteIdealHomSubbimoduleIdeal S)
    (finiteIdealHomSubbimoduleIdeal_injective S)

/-- Intersection in the finite lattice of endpoint-stable Hom subspaces. -/
private def finiteIdealHomSubbimoduleInf {i j : S.ProjectiveCategory}
    (T U : FiniteIdealHomSubbimodule S i j) :
    FiniteIdealHomSubbimodule S i j :=
  ⟨T.1 ⊓ U.1, by
    constructor
    · intro a f hf
      exact ⟨T.2.1 a hf.1, U.2.1 a hf.2⟩
    · intro b f hf
      exact ⟨T.2.2 b hf.1, U.2.2 b hf.2⟩⟩

/-- A left Jacobson-radical product, re-bundled as a two-sided ideal. -/
private def finiteIdealLeftRadicalProduct (I : TwoSidedIdeal A) :
    TwoSidedIdeal A := by
  let P : Ideal A := Ring.jacobson A * I.asIdeal
  letI : P.IsTwoSided := by
    dsimp [P]
    infer_instance
  exact P.toTwoSided

/-- A right Jacobson-radical product, re-bundled as a two-sided ideal. -/
private def finiteIdealRightRadicalProduct (I : TwoSidedIdeal A) :
    TwoSidedIdeal A := by
  let P : Ideal A := I.asIdeal * Ring.jacobson A
  letI : P.IsTwoSided := by
    dsimp [P]
    infer_instance
  exact P.toTwoSided

private def finiteIdealLeftRadicalExtension
    (K I : TwoSidedIdeal A) : TwoSidedIdeal A :=
  K ⊔ finiteIdealLeftRadicalProduct I

private def finiteIdealRightRadicalExtension
    (K I : TwoSidedIdeal A) : TwoSidedIdeal A :=
  K ⊔ finiteIdealRightRadicalProduct I

@[simp]
private theorem mem_finiteIdealLeftRadicalProduct (I : TwoSidedIdeal A) {a : A} :
    a ∈ finiteIdealLeftRadicalProduct I ↔
      a ∈ Ring.jacobson A * I.asIdeal := by
  simp [finiteIdealLeftRadicalProduct]

@[simp]
private theorem mem_finiteIdealRightRadicalProduct (I : TwoSidedIdeal A) {a : A} :
    a ∈ finiteIdealRightRadicalProduct I ↔
      a ∈ I.asIdeal * Ring.jacobson A := by
  simp [finiteIdealRightRadicalProduct]

/-- Nilpotent left Nakayama for nested two-sided ideals. -/
private theorem finiteIdeal_le_of_le_sup_nilpotent_mul
    (J K I : Ideal A) [J.IsTwoSided] [K.IsTwoSided] [I.IsTwoSided]
    (hJ : IsNilpotent J) (h : I ≤ K ⊔ J * I) : I ≤ K := by
  have hn : ∀ n : ℕ, I ≤ K ⊔ J ^ n * I := by
    intro n
    induction n with
    | zero =>
        simpa only [Submodule.pow_zero, Ideal.one_eq_top, Ideal.top_mul]
          using (show I ≤ K ⊔ I from le_sup_right)
    | succ n ih =>
        refine ih.trans (sup_le le_sup_left ?_)
        refine (Ideal.mul_mono_right h).trans ?_
        rw [Ideal.mul_sup]
        apply sup_le
        · exact Ideal.mul_le_right.trans le_sup_left
        · rw [← Ideal.mul_assoc, ← Submodule.pow_succ]
          exact le_sup_right
  obtain ⟨n, hnil⟩ := hJ
  have hn' := hn n
  rw [hnil] at hn'
  simpa only [Ideal.zero_eq_bot, Ideal.bot_mul, sup_bot_eq] using hn'

/-- Nilpotent right Nakayama for nested two-sided ideals. -/
private theorem finiteIdeal_le_of_le_sup_mul_nilpotent
    (J K I : Ideal A) [J.IsTwoSided] [K.IsTwoSided] [I.IsTwoSided]
    (hJ : IsNilpotent J) (h : I ≤ K ⊔ I * J) : I ≤ K := by
  have hn : ∀ n : ℕ, I ≤ K ⊔ I * J ^ n := by
    intro n
    induction n with
    | zero =>
        rw [Submodule.pow_zero, Ideal.IsTwoSided.mul_one]
        exact le_sup_right
    | succ n ih =>
        refine ih.trans (sup_le le_sup_left ?_)
        refine (Ideal.mul_mono_left h).trans ?_
        rw [Ideal.sup_mul]
        apply sup_le
        · exact Ideal.mul_le_left.trans le_sup_left
        · rw [Ideal.mul_assoc, ← Ideal.IsTwoSided.pow_succ]
          exact le_sup_right
  obtain ⟨n, hnil⟩ := hJ
  have hn' := hn n
  rw [hnil] at hn'
  simpa only [Ideal.zero_eq_bot, Ideal.mul_bot, sup_bot_eq] using hn'

/-- At a cover of endpoint-stable Hom subspaces, the target-side radical
product has no new corner component. -/
private theorem finiteIdeal_leftRadicalCorner_eq_of_homCover
    [Module.Finite k A]
    {i j : S.ProjectiveCategory} (W T : Submodule k (i ⟶ j))
    (hW : LargeIndecomposable.IsHomSubbimodule W)
    (hT : LargeIndecomposable.IsHomSubbimodule T)
    (hWT : W ≤ T) (hne : W ≠ T)
    (hcover : ∀ U : Submodule k (i ⟶ j),
      LargeIndecomposable.IsHomSubbimodule U →
      W ≤ U → U ≤ T → U = W ∨ U = T) :
    finiteIdealCorner S
      (finiteIdealLeftRadicalExtension
        (finiteIdealHomSpan S W) (finiteIdealHomSpan S T)) i j = W := by
  let K := finiteIdealHomSpan S W
  let I := finiteIdealHomSpan S T
  let L := finiteIdealLeftRadicalExtension K I
  have hrecW := finiteIdealCorner_homSpan_eq S W hW
  have hrecT := finiteIdealCorner_homSpan_eq S T hT
  have hKI : K ≤ I := by
    apply TwoSidedIdeal.span_mono
    exact Set.image_mono hWT
  have hKleL : K ≤ L := le_sup_left
  have hPleI : finiteIdealLeftRadicalProduct I ≤ I := by
    intro a ha
    rw [mem_finiteIdealLeftRadicalProduct] at ha
    exact Ideal.mul_le_right ha
  have hLleI : L ≤ I := sup_le hKI hPleI
  have hlower : W ≤ finiteIdealCorner S L i j := by
    rw [← hrecW]
    exact fun _ hf => hKleL hf
  have hupper : finiteIdealCorner S L i j ≤ T := by
    rw [← hrecT]
    exact fun _ hf => hLleI hf
  rcases hcover (finiteIdealCorner S L i j)
      (finiteIdealCorner_isHomSubbimodule S L i j)
      hlower hupper with hLW | hLT
  · exact hLW
  · exfalso
    have hIleL : I ≤ L := by
      apply TwoSidedIdeal.span_le.mpr
      rintro _ ⟨f, hf, rfl⟩
      have : f ∈ finiteIdealCorner S L i j := by
        rw [hLT]
        exact hf
      exact this
    have hsup : I.asIdeal ≤
        K.asIdeal ⊔ Ring.jacobson A * I.asIdeal := by
      intro a ha
      have haL : a ∈ L := hIleL ha
      change a ∈ K ⊔ finiteIdealLeftRadicalProduct I at haL
      rw [TwoSidedIdeal.mem_sup] at haL
      rcases haL with ⟨b, hb, c, hc, rfl⟩
      rw [Submodule.mem_sup]
      exact ⟨b, hb, c,
        (mem_finiteIdealLeftRadicalProduct I).mp hc, rfl⟩
    letI : IsArtinianRing A := IsArtinianRing.of_finite k A
    have hnil : IsNilpotent (Ring.jacobson A) := by
      simpa only [Ideal.jacobson_bot] using
        (IsArtinianRing.isNilpotent_jacobson_bot (R := A))
    have hIK : I.asIdeal ≤ K.asIdeal :=
      finiteIdeal_le_of_le_sup_nilpotent_mul
        (Ring.jacobson A) K.asIdeal I.asIdeal hnil hsup
    have hIKeq : I = K := by
      apply TwoSidedIdeal.ext
      intro a
      exact ⟨fun ha => hIK ha, fun ha => hKI ha⟩
    apply hne
    rw [← hrecW, ← hrecT]
    dsimp only [I, K] at hIKeq
    rw [hIKeq]

/-- At a cover, the source-side radical product has no new corner
component. -/
private theorem finiteIdeal_rightRadicalCorner_eq_of_homCover
    [Module.Finite k A]
    {i j : S.ProjectiveCategory} (W T : Submodule k (i ⟶ j))
    (hW : LargeIndecomposable.IsHomSubbimodule W)
    (hT : LargeIndecomposable.IsHomSubbimodule T)
    (hWT : W ≤ T) (hne : W ≠ T)
    (hcover : ∀ U : Submodule k (i ⟶ j),
      LargeIndecomposable.IsHomSubbimodule U →
      W ≤ U → U ≤ T → U = W ∨ U = T) :
    finiteIdealCorner S
      (finiteIdealRightRadicalExtension
        (finiteIdealHomSpan S W) (finiteIdealHomSpan S T)) i j = W := by
  let K := finiteIdealHomSpan S W
  let I := finiteIdealHomSpan S T
  let L := finiteIdealRightRadicalExtension K I
  have hrecW := finiteIdealCorner_homSpan_eq S W hW
  have hrecT := finiteIdealCorner_homSpan_eq S T hT
  have hKI : K ≤ I := by
    apply TwoSidedIdeal.span_mono
    exact Set.image_mono hWT
  have hKleL : K ≤ L := le_sup_left
  have hPleI : finiteIdealRightRadicalProduct I ≤ I := by
    intro a ha
    rw [mem_finiteIdealRightRadicalProduct] at ha
    exact Ideal.mul_le_left ha
  have hLleI : L ≤ I := sup_le hKI hPleI
  have hlower : W ≤ finiteIdealCorner S L i j := by
    rw [← hrecW]
    exact fun _ hf => hKleL hf
  have hupper : finiteIdealCorner S L i j ≤ T := by
    rw [← hrecT]
    exact fun _ hf => hLleI hf
  rcases hcover (finiteIdealCorner S L i j)
      (finiteIdealCorner_isHomSubbimodule S L i j)
      hlower hupper with hLW | hLT
  · exact hLW
  · exfalso
    have hIleL : I ≤ L := by
      apply TwoSidedIdeal.span_le.mpr
      rintro _ ⟨f, hf, rfl⟩
      have : f ∈ finiteIdealCorner S L i j := by
        rw [hLT]
        exact hf
      exact this
    have hsup : I.asIdeal ≤
        K.asIdeal ⊔ I.asIdeal * Ring.jacobson A := by
      intro a ha
      have haL : a ∈ L := hIleL ha
      change a ∈ K ⊔ finiteIdealRightRadicalProduct I at haL
      rw [TwoSidedIdeal.mem_sup] at haL
      rcases haL with ⟨b, hb, c, hc, rfl⟩
      rw [Submodule.mem_sup]
      exact ⟨b, hb, c,
        (mem_finiteIdealRightRadicalProduct I).mp hc, rfl⟩
    letI : IsArtinianRing A := IsArtinianRing.of_finite k A
    have hnil : IsNilpotent (Ring.jacobson A) := by
      simpa only [Ideal.jacobson_bot] using
        (IsArtinianRing.isNilpotent_jacobson_bot (R := A))
    have hIK : I.asIdeal ≤ K.asIdeal :=
      finiteIdeal_le_of_le_sup_mul_nilpotent
        (Ring.jacobson A) K.asIdeal I.asIdeal hnil hsup
    have hIKeq : I = K := by
      apply TwoSidedIdeal.ext
      intro a
      exact ⟨fun ha => hIK ha, fun ha => hKI ha⟩
    apply hne
    rw [← hrecW, ← hrecT]
    dsimp only [I, K] at hIKeq
    rw [hIKeq]

/-- On a cover, every source-endomorphism acts by its split-basic residue
modulo the lower Hom subbimodule. -/
private theorem finiteIdeal_source_action_sub_residue_mem_of_homCover
    [Module.Finite k A]
    {i j : S.ProjectiveCategory} (W T : Submodule k (i ⟶ j))
    (hW : LargeIndecomposable.IsHomSubbimodule W)
    (hT : LargeIndecomposable.IsHomSubbimodule T)
    (hWT : W ≤ T) (hne : W ≠ T)
    (hcover : ∀ U : Submodule k (i ⟶ j),
      LargeIndecomposable.IsHomSubbimodule U →
      W ≤ U → U ≤ T → U = W ∨ U = T)
    {f : i ⟶ j} (hf : f ∈ T) (a : End i) :
    a.asHom ≫ f - S.projectiveEndResidue i a • f ∈ W := by
  let K := finiteIdealHomSpan S W
  let I := finiteIdealHomSpan S T
  let L := finiteIdealRightRadicalExtension K I
  let n : End i := a - S.projectiveEndResidue i a • 1
  have hnres : S.projectiveEndResidue i n = 0 := by
    dsimp only [n]
    rw [map_sub, map_smul, map_one, smul_eq_mul, mul_one, sub_self]
  have hnJ : n.1 ∈ Ring.jacobson A :=
    (S.projectiveEndResidue_eq_zero_iff_val_mem_jacobson i n).1 hnres
  have hfI : f.1 ∈ I := by
    change f ∈ finiteIdealCorner S I i j
    rw [finiteIdealCorner_homSpan_eq S T hT]
    exact hf
  have hprod : f.1 * n.1 ∈ finiteIdealRightRadicalProduct I := by
    rw [mem_finiteIdealRightRadicalProduct]
    exact Ideal.mul_mem_mul hfI hnJ
  have hprodL : f.1 * n.1 ∈ L :=
    (show finiteIdealRightRadicalProduct I ≤ L from le_sup_right) hprod
  have hcomp : n.asHom ≫ f =
      a.asHom ≫ f - S.projectiveEndResidue i a • f := by
    change (a.asHom - S.projectiveEndResidue i a • (𝟙 i)) ≫ f = _
    rw [Preadditive.sub_comp, Linear.smul_comp, Category.id_comp]
  have hg : n.asHom ≫ f ∈ finiteIdealCorner S L i j := by
    change f.1 * n.1 ∈ L
    exact hprodL
  rw [finiteIdeal_rightRadicalCorner_eq_of_homCover S W T
    hW hT hWT hne hcover] at hg
  rw [hcomp] at hg
  exact hg

/-- On a cover, every target-endomorphism acts by its split-basic residue
modulo the lower Hom subbimodule. -/
private theorem finiteIdeal_target_action_sub_residue_mem_of_homCover
    [Module.Finite k A]
    {i j : S.ProjectiveCategory} (W T : Submodule k (i ⟶ j))
    (hW : LargeIndecomposable.IsHomSubbimodule W)
    (hT : LargeIndecomposable.IsHomSubbimodule T)
    (hWT : W ≤ T) (hne : W ≠ T)
    (hcover : ∀ U : Submodule k (i ⟶ j),
      LargeIndecomposable.IsHomSubbimodule U →
      W ≤ U → U ≤ T → U = W ∨ U = T)
    {f : i ⟶ j} (hf : f ∈ T) (b : End j) :
    f ≫ b.asHom - S.projectiveEndResidue j b • f ∈ W := by
  let K := finiteIdealHomSpan S W
  let I := finiteIdealHomSpan S T
  let L := finiteIdealLeftRadicalExtension K I
  let n : End j := b - S.projectiveEndResidue j b • 1
  have hnres : S.projectiveEndResidue j n = 0 := by
    dsimp only [n]
    rw [map_sub, map_smul, map_one, smul_eq_mul, mul_one, sub_self]
  have hnJ : n.1 ∈ Ring.jacobson A :=
    (S.projectiveEndResidue_eq_zero_iff_val_mem_jacobson j n).1 hnres
  have hfI : f.1 ∈ I := by
    change f ∈ finiteIdealCorner S I i j
    rw [finiteIdealCorner_homSpan_eq S T hT]
    exact hf
  have hprod : n.1 * f.1 ∈ finiteIdealLeftRadicalProduct I := by
    rw [mem_finiteIdealLeftRadicalProduct]
    exact Ideal.mul_mem_mul hnJ hfI
  have hprodL : n.1 * f.1 ∈ L :=
    (show finiteIdealLeftRadicalProduct I ≤ L from le_sup_right) hprod
  have hcomp : f ≫ n.asHom =
      f ≫ b.asHom - S.projectiveEndResidue j b • f := by
    change f ≫ (b.asHom - S.projectiveEndResidue j b • (𝟙 j)) = _
    rw [Preadditive.comp_sub, Linear.comp_smul, Category.comp_id]
  have hg : f ≫ n.asHom ∈ finiteIdealCorner S L i j := by
    change n.1 * f.1 ∈ L
    exact hprodL
  rw [finiteIdeal_leftRadicalCorner_eq_of_homCover S W T
    hW hT hWT hne hcover] at hg
  rw [hcomp] at hg
  exact hg

/-- The line through `x + c • y`, enlarged by a fixed lower submodule. -/
private def finiteIdealPencilSubmodule
    {i j : S.ProjectiveCategory} (W : Submodule k (i ⟶ j))
    (x y : i ⟶ j) (c : k) : Submodule k (i ⟶ j) :=
  W ⊔ Submodule.span k ({x + c • y} : Set (i ⟶ j))

/-- If both vectors transform by the endpoint residue characters modulo `W`,
then every member of their projective pencil spans a Hom subbimodule over
`W`. -/
private theorem finiteIdealPencil_isHomSubbimodule
    {i j : S.ProjectiveCategory} (W : Submodule k (i ⟶ j))
    (hW : LargeIndecomposable.IsHomSubbimodule W)
    (x y : i ⟶ j)
    (hxSource : ∀ a : End i,
      a.asHom ≫ x - S.projectiveEndResidue i a • x ∈ W)
    (hySource : ∀ a : End i,
      a.asHom ≫ y - S.projectiveEndResidue i a • y ∈ W)
    (hxTarget : ∀ b : End j,
      x ≫ b.asHom - S.projectiveEndResidue j b • x ∈ W)
    (hyTarget : ∀ b : End j,
      y ≫ b.asHom - S.projectiveEndResidue j b • y ∈ W)
    (c : k) :
    LargeIndecomposable.IsHomSubbimodule
      (finiteIdealPencilSubmodule S W x y c) := by
  let z : i ⟶ j := x + c • y
  let U := finiteIdealPencilSubmodule S W x y c
  have hzmem : z ∈ U := by
    apply (show Submodule.span k ({x + c • y} : Set (i ⟶ j)) ≤ U from
      le_sup_right)
    apply Submodule.subset_span
    simp only [Set.mem_singleton_iff]
    rfl
  have hzSource (a : End i) :
      a.asHom ≫ z - S.projectiveEndResidue i a • z ∈ W := by
    have h := W.add_mem (hxSource a) (W.smul_mem c (hySource a))
    convert h using 1
    dsimp only [z]
    simp only [Preadditive.comp_add, Linear.comp_smul]
    module
  have hzTarget (b : End j) :
      z ≫ b.asHom - S.projectiveEndResidue j b • z ∈ W := by
    have h := W.add_mem (hxTarget b) (W.smul_mem c (hyTarget b))
    convert h using 1
    dsimp only [z]
    simp only [Preadditive.add_comp, Linear.smul_comp]
    module
  constructor
  · intro a f hf
    rcases Submodule.mem_sup.mp hf with ⟨q, hq, r, hr, rfl⟩
    obtain ⟨d, rfl⟩ := Submodule.mem_span_singleton.mp hr
    rw [Preadditive.comp_add, Linear.comp_smul]
    apply U.add_mem
    · exact (show W ≤ U from le_sup_left) (hW.1 a hq)
    · apply U.smul_mem
      have hrad :
          a.asHom ≫ z - S.projectiveEndResidue i a • z ∈ U :=
        (show W ≤ U from le_sup_left) (hzSource a)
      have hscalar : S.projectiveEndResidue i a • z ∈ U :=
        U.smul_mem _ hzmem
      have heq : a.asHom ≫ z =
          (a.asHom ≫ z - S.projectiveEndResidue i a • z) +
            S.projectiveEndResidue i a • z := by
        module
      rw [heq]
      exact U.add_mem hrad hscalar
  · intro b f hf
    rcases Submodule.mem_sup.mp hf with ⟨q, hq, r, hr, rfl⟩
    obtain ⟨d, rfl⟩ := Submodule.mem_span_singleton.mp hr
    rw [Preadditive.add_comp, Linear.smul_comp]
    apply U.add_mem
    · exact (show W ≤ U from le_sup_left) (hW.2 b hq)
    · apply U.smul_mem
      have hrad :
          z ≫ b.asHom - S.projectiveEndResidue j b • z ∈ U :=
        (show W ≤ U from le_sup_left) (hzTarget b)
      have hscalar : S.projectiveEndResidue j b • z ∈ U :=
        U.smul_mem _ hzmem
      have heq : z ≫ b.asHom =
          (z ≫ b.asHom - S.projectiveEndResidue j b • z) +
            S.projectiveEndResidue j b • z := by
        module
      rw [heq]
      exact U.add_mem hrad hscalar

/-- Independent directions modulo `W` give distinct members of the pencil. -/
private theorem finiteIdealPencilSubmodule_injective
    {i j : S.ProjectiveCategory} (W : Submodule k (i ⟶ j))
    (x y : i ⟶ j)
    (hindependent : ∀ a b : k, a • x + b • y ∈ W → a = 0 ∧ b = 0) :
    Function.Injective (finiteIdealPencilSubmodule S W x y) := by
  intro c d hcd
  let zc : i ⟶ j := x + c • y
  let zd : i ⟶ j := x + d • y
  have hzc : zc ∈ finiteIdealPencilSubmodule S W x y c := by
    apply (show Submodule.span k ({x + c • y} : Set (i ⟶ j)) ≤
      finiteIdealPencilSubmodule S W x y c from le_sup_right)
    exact Submodule.subset_span (by simp [zc])
  have hzcd : zc ∈ finiteIdealPencilSubmodule S W x y d := by
    rw [← hcd]
    exact hzc
  rcases Submodule.mem_sup.mp hzcd with ⟨w, hw, r, hr, hsum⟩
  obtain ⟨e, he⟩ := Submodule.mem_span_singleton.mp hr
  have hlinear : (1 - e) • x + (c - e * d) • y = w := by
    dsimp only [zc, zd] at hsum he
    rw [← he] at hsum
    calc
      (1 - e) • x + (c - e * d) • y =
          (x + c • y) - e • (x + d • y) := by module
      _ = w := by rw [← hsum]; module
  have hmem : (1 - e) • x + (c - e * d) • y ∈ W := by
    rw [hlinear]
    exact hw
  obtain ⟨he1, hced⟩ := hindependent (1 - e) (c - e * d) hmem
  have heq : e = 1 := (sub_eq_zero.mp he1).symm
  rw [heq, one_mul, sub_eq_zero] at hced
  exact hced

/-- Vectors chosen in distinct branches above an intersection are linearly
independent modulo that intersection. -/
private theorem finiteIdeal_fork_linear_independent_mod_inf
    {i j : S.ProjectiveCategory}
    (W T U : Submodule k (i ⟶ j)) (hW : W = T ⊓ U)
    (x y : i ⟶ j) (hxT : x ∈ T) (hxW : x ∉ W)
    (hyU : y ∈ U) (hyW : y ∉ W) :
    ∀ a b : k, a • x + b • y ∈ W → a = 0 ∧ b = 0 := by
  intro a b hab
  have hWU : W ≤ U := by
    rw [hW]
    exact inf_le_right
  have hWT : W ≤ T := by
    rw [hW]
    exact inf_le_left
  have haxU : a • x ∈ U := by
    have hsub := U.sub_mem (hWU hab) (U.smul_mem b hyU)
    have hcalc : a • x = (a • x + b • y) - b • y := by
      module
    rw [hcalc]
    exact hsub
  have haxW : a • x ∈ W := by
    rw [hW]
    exact ⟨T.smul_mem a hxT, haxU⟩
  have ha : a = 0 := by
    by_contra ha0
    apply hxW
    have hinv := W.smul_mem a⁻¹ haxW
    simpa only [smul_smul, inv_mul_cancel₀ ha0, one_smul] using hinv
  have hbyT : b • y ∈ T := by
    have hsub := T.sub_mem (hWT hab) (T.smul_mem a hxT)
    rw [ha, zero_smul, sub_zero] at hsub
    simpa only [zero_add] using hsub
  have hbyW : b • y ∈ W := by
    rw [hW]
    exact ⟨hbyT, U.smul_mem b hyU⟩
  have hb : b = 0 := by
    by_contra hb0
    apply hyW
    have hinv := W.smul_mem b⁻¹ hbyW
    simpa only [smul_smul, inv_mul_cancel₀ hb0, one_smul] using hinv
  exact ⟨ha, hb⟩

/-- Finiteness of the ambient two-sided ideal lattice forces every pair of
endpoint-stable Hom subspaces to be comparable.  The only field-size input is
that `k` is infinite. -/
theorem finiteIdeal_homSubbimodule_comparable
    [Module.Finite k A] [Infinite k] [Finite (TwoSidedIdeal A)]
    {i j : S.ProjectiveCategory}
    (T U : Submodule k (i ⟶ j))
    (hT : LargeIndecomposable.IsHomSubbimodule T)
    (hU : LargeIndecomposable.IsHomSubbimodule U) :
    T ≤ U ∨ U ≤ T := by
  by_contra hcomparable
  push Not at hcomparable
  rcases hcomparable with ⟨hTnotU, hUnotT⟩
  let W : Submodule k (i ⟶ j) := T ⊓ U
  have hW : LargeIndecomposable.IsHomSubbimodule W := by
    constructor
    · intro a f hf
      exact ⟨hT.1 a hf.1, hU.1 a hf.2⟩
    · intro b f hf
      exact ⟨hT.2 b hf.1, hU.2 b hf.2⟩
  let Tb : FiniteIdealHomSubbimodule S i j := ⟨T, hT⟩
  let Ub : FiniteIdealHomSubbimodule S i j := ⟨U, hU⟩
  let Wb : FiniteIdealHomSubbimodule S i j := ⟨W, hW⟩
  have hWltTcar : W < T := by
    apply lt_of_le_of_ne
    · exact inf_le_left
    · intro hEq
      apply hTnotU
      rw [← hEq]
      exact inf_le_right
  have hWltUcar : W < U := by
    apply lt_of_le_of_ne
    · exact inf_le_right
    · intro hEq
      apply hUnotT
      rw [← hEq]
      exact inf_le_left
  have hWltT : Wb < Tb := hWltTcar
  have hWltU : Wb < Ub := hWltUcar
  obtain ⟨Pb, hcovP, hPleT⟩ := hWltT.exists_covby_le
  obtain ⟨Qb, hcovQ, hQleU⟩ := hWltU.exists_covby_le
  have hWPcar : W < Pb.1 := hcovP.lt
  have hWQcar : W < Qb.1 := hcovQ.lt
  have hcoverP : ∀ R : Submodule k (i ⟶ j),
      LargeIndecomposable.IsHomSubbimodule R →
      W ≤ R → R ≤ Pb.1 → R = W ∨ R = Pb.1 := by
    intro R hR hWR hRP
    let Rb : FiniteIdealHomSubbimodule S i j := ⟨R, hR⟩
    have hWRb : Wb ≤ Rb := hWR
    have hRPb : Rb ≤ Pb := hRP
    rcases hcovP.eq_or_eq hWRb hRPb with hRW | hRP'
    · exact Or.inl (congrArg Subtype.val hRW)
    · exact Or.inr (congrArg Subtype.val hRP')
  have hcoverQ : ∀ R : Submodule k (i ⟶ j),
      LargeIndecomposable.IsHomSubbimodule R →
      W ≤ R → R ≤ Qb.1 → R = W ∨ R = Qb.1 := by
    intro R hR hWR hRQ
    let Rb : FiniteIdealHomSubbimodule S i j := ⟨R, hR⟩
    have hWRb : Wb ≤ Rb := hWR
    have hRQb : Rb ≤ Qb := hRQ
    rcases hcovQ.eq_or_eq hWRb hRQb with hRW | hRQ'
    · exact Or.inl (congrArg Subtype.val hRW)
    · exact Or.inr (congrArg Subtype.val hRQ')
  have hWinter : W = Pb.1 ⊓ Qb.1 := by
    apply le_antisymm
    · intro f hf
      exact ⟨hcovP.le hf, hcovQ.le hf⟩
    · intro f hf
      change f ∈ T ∧ f ∈ U
      exact ⟨hPleT hf.1, hQleU hf.2⟩
  obtain ⟨x, hxP, hxW⟩ := SetLike.exists_of_lt hWPcar
  obtain ⟨y, hyQ, hyW⟩ := SetLike.exists_of_lt hWQcar
  have hxSource (a : End i) :
      a.asHom ≫ x - S.projectiveEndResidue i a • x ∈ W :=
    finiteIdeal_source_action_sub_residue_mem_of_homCover
      S W Pb.1 hW Pb.2 hcovP.le (ne_of_lt hWPcar) hcoverP hxP a
  have hySource (a : End i) :
      a.asHom ≫ y - S.projectiveEndResidue i a • y ∈ W :=
    finiteIdeal_source_action_sub_residue_mem_of_homCover
      S W Qb.1 hW Qb.2 hcovQ.le (ne_of_lt hWQcar) hcoverQ hyQ a
  have hxTarget (b : End j) :
      x ≫ b.asHom - S.projectiveEndResidue j b • x ∈ W :=
    finiteIdeal_target_action_sub_residue_mem_of_homCover
      S W Pb.1 hW Pb.2 hcovP.le (ne_of_lt hWPcar) hcoverP hxP b
  have hyTarget (b : End j) :
      y ≫ b.asHom - S.projectiveEndResidue j b • y ∈ W :=
    finiteIdeal_target_action_sub_residue_mem_of_homCover
      S W Qb.1 hW Qb.2 hcovQ.le (ne_of_lt hWQcar) hcoverQ hyQ b
  have hindependent : ∀ a b : k,
      a • x + b • y ∈ W → a = 0 ∧ b = 0 :=
    finiteIdeal_fork_linear_independent_mod_inf
      S W Pb.1 Qb.1 hWinter x y hxP hxW hyQ hyW
  let F : k → FiniteIdealHomSubbimodule S i j := fun c =>
    ⟨finiteIdealPencilSubmodule S W x y c,
      finiteIdealPencil_isHomSubbimodule S W hW x y
        hxSource hySource hxTarget hyTarget c⟩
  have hFinjective : Function.Injective F := by
    intro c d hcd
    apply finiteIdealPencilSubmodule_injective S W x y hindependent
    exact congrArg Subtype.val hcd
  obtain ⟨c, d, hcd, hFcd⟩ :=
    Finite.exists_ne_map_eq_of_infinite F
  exact hcd (hFinjective hFcd)


end LargeIndecomposable.SplitBasicIdempotents.ProjectiveCategory
