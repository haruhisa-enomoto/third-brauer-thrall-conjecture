module

public import LargeIndecomposable.RayCategories.RayTables.RayBasis
public import LargeIndecomposable.RayCategories.RayTables.RayProduct

/-!
# Products outside the insertion span (BGRS 1.7 a)

If inserting `e_y + t ρ` between `f` and `h` keeps `f h` in its ray for every
scalar `t` and every radical `ρ` of `R_y`, then `f ρ h` lies in the radical
`R(f h)` of the subbimodule generated by `f h`; hence the insertion span
`M(f, h)` lies in `R(f h)` and does not contain `f h`
(`RayQuiver.mul_not_mem_insertionSpan`).
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

open LargeIndecomposable

universe u v

namespace RayQuiver

variable {k : Type u} [Field k] [IsAlgClosed k] {A : Type v} [Ring A] [Algebra k A]
  [FiniteDimensional k A] (F : PrimitiveIdempotents A)

/-- `u p w ≡ λ κ p` modulo `R(p)` for corner units `u = λ e + u'`, `w = κ e + w'`. -/
lemma unit_mul_mem_endpointRadical {x z : Fin F.m} {p : A} (hp : p ∈ F.corner (k := k) x z)
    {u w : A} (hu : F.IsCornerUnit (k := k) x u) (hw : F.IsCornerUnit (k := k) z w) :
    ∃ c : k, c ≠ 0 ∧ u * p * w - c • p ∈ F.endpointRadical (k := k) x z p := by
  obtain ⟨l, hl, hu'⟩ := F.exists_unit_decomp hu
  obtain ⟨m, hm, hw'⟩ := F.exists_unit_decomp hw
  refine ⟨l * m, mul_ne_zero hl hm, ?_⟩
  set u' := u - l • F.e x
  set w' := w - m • F.e z
  have hu_eq : u = l • F.e x + u' := by simp [u']
  have hw_eq : w = m • F.e z + w' := by simp [w']
  have hep : F.e x * p = p := F.e_mul_of_mem hp
  have hpe : p * F.e z = p := F.mul_e_of_mem hp
  have hexp : u * p * w - (l * m) • p =
      l • (F.e x * p * w') + m • (u' * p * F.e z) + u' * p * w' := by
    rw [hu_eq, hw_eq]
    simp only [add_mul, mul_add, smul_mul_assoc, mul_smul_comm, hep, hpe]
    module
  rw [hexp]
  refine Submodule.add_mem _ (Submodule.add_mem _ (Submodule.smul_mem _ _ (Submodule.subset_span
    (Or.inr ⟨F.e x, F.e_mem_corner x, w', hw', rfl⟩))) (Submodule.smul_mem _ _
    (Submodule.subset_span (Or.inl ⟨u', hu', F.e z, F.e_mem_corner z, rfl⟩))))
    (Submodule.subset_span (Or.inl ⟨u', hu', w', hw'.1, rfl⟩))

/-- **BGRS 1.7 a).** -/
theorem mul_not_mem_insertionSpan {x y z : Fin F.m} {f h : A} (hf : f ∈ F.corner (k := k) x y)
    (hh : h ∈ F.corner (k := k) y z) (hfh : f * h ≠ 0)
    (hray : ∀ (t : k) (ρ : A), ρ ∈ F.cornerRadical (k := k) y →
      ∃ u w, F.IsCornerUnit (k := k) x u ∧ F.IsCornerUnit (k := k) z w ∧
        f * (F.e y + t • ρ) * h = u * (f * h) * w) :
    f * h ∉ F.insertionSpan (k := k) x y z f h := by
  have hp := F.corner_mul_corner hf hh
  have hR := F.isEndpoint_endpointRadical hp
  have hpR := F.not_mem_endpointRadical hp hfh
  have hfe : f * F.e y = f := F.mul_e_of_mem hf
  -- `f ρ h ∈ R(f h)` for radical `ρ`
  have key : ∀ ρ : A, ρ ∈ F.cornerRadical (k := k) y →
      f * ρ * h ∈ F.endpointRadical (k := k) x z (f * h) := by
    intro ρ hρ
    have hstep : ∀ t : k, ∃ c : k, c ≠ 0 ∧
        (1 - c) • (f * h) + t • (f * ρ * h) ∈ F.endpointRadical (k := k) x z (f * h) := by
      intro t
      obtain ⟨u, w, hu, hw, heq⟩ := hray t ρ hρ
      obtain ⟨c, hc, hmem⟩ := unit_mul_mem_endpointRadical F hp hu hw
      refine ⟨c, hc, ?_⟩
      have : f * (F.e y + t • ρ) * h = f * h + t • (f * ρ * h) := by
        rw [mul_add, hfe, add_mul, mul_smul_comm, smul_mul_assoc]
      rw [← heq, this] at hmem
      convert hmem using 1
      rw [sub_smul, one_smul]; abel
    obtain ⟨c₁, hc₁, h₁⟩ := hstep 1
    rw [one_smul] at h₁
    -- `f ρ h ≡ (c₁ - 1) f h` modulo `R(f h)`
    by_cases hc : c₁ - 1 = 0
    · rwa [show (1 - c₁) = -(c₁ - 1) by ring, hc, neg_zero, zero_smul, zero_add] at h₁
    · set t : k := -(c₁ - 1)⁻¹ with ht_def
      have ht : t * (1 - c₁) = 1 := by
        rw [ht_def, show (1 - c₁) = -(c₁ - 1) by ring, neg_mul_neg, inv_mul_cancel₀ hc]
      obtain ⟨c₂, hc₂, h₂⟩ := hstep t
      exfalso
      apply hpR
      have h4 : (-c₂) • (f * h) ∈ F.endpointRadical (k := k) x z (f * h) := by
        have := Submodule.sub_mem _ h₂ (Submodule.smul_mem _ t h₁)
        convert this using 1
        match_scalars <;> first | ring1 | linear_combination ht
      have := Submodule.smul_mem _ (-c₂)⁻¹ h4
      rwa [smul_smul, inv_mul_cancel₀ (neg_ne_zero.2 hc₂), one_smul] at this
  -- hence `M(f, h) ⊆ R(f h)`
  intro hM
  apply hpR
  refine (Submodule.span_le.2 ?_) hM
  rintro _ ⟨a, ha, r, hr, b, hb, rfl⟩
  have := hR.2.2 b hb _ (hR.2.1 a ha _ (key r hr))
  rw [show a * f * r * h * b = a * (f * r * h) * b by simp only [mul_assoc]]
  exact this

end RayQuiver

end LargeIndecomposable
