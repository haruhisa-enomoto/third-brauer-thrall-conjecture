module

public import LargeIndecomposable.RepresentationType.Basic.RepresentationFiniteCorners
public import LargeIndecomposable.Modules.SplitBasic.BasicReduction
public import LargeIndecomposable.RepresentationType.Basic.RepresentationFinite

/-!
# Corners of proper quotients (BGRS 1.4)

If every proper quotient `A/J` (`J ≠ 0`) of `A` is representation-finite, then
so is every proper quotient `eAe/I` (`I ≠ 0`) of an idempotent corner: with
`J = AIA` one has `eJe = I`, and `eAe/I ≅ ē(A/J)ē`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable

universe u v

/-- **Mild algebras** (BGRS 1.4): every proper quotient is representation-finite. -/
def MildAlg (k : Type u) [Field k] (A : Type v) [Ring A] [Algebra k A] : Prop :=
  ∀ J : TwoSidedIdeal A, J ≠ ⊥ → IsRepresentationFinite k (A ⧸ J.asIdeal)

variable {k : Type u} [Field k] {A : Type v} [Ring A] [Algebra k A]
  {e : A} (he : IsIdempotentElem e)

/-- The ideal of `A` generated by an ideal of the corner `eAe`. -/
def cornerIdealSpan (I : TwoSidedIdeal he.Corner) : TwoSidedIdeal A :=
  TwoSidedIdeal.span (Subtype.val '' (I : Set he.Corner))

include he in
lemma mem_corner_of_sandwich (a : A) : e * a * e ∈ Subsemigroup.corner e :=
  (Subsemigroup.mem_corner_iff he).2
    ⟨by rw [← mul_assoc, ← mul_assoc, he.eq], by rw [mul_assoc, he.eq]⟩

/-- The sandwich `e z e` as an element of the corner. -/
def sand (z : A) : he.Corner := ⟨e * z * e, mem_corner_of_sandwich he z⟩

lemma sand_val (z : A) : (sand he z).1 = e * z * e := rfl

/-- `e (AIA) e = I`: sandwiches of elements of `AIA` lie in `I`. -/
lemma sandwich_mem_of_mem_span (I : TwoSidedIdeal he.Corner) {z : A}
    (hz : z ∈ cornerIdealSpan he I) (a b : A) : sand he (a * z * b) ∈ I := by
  induction hz using TwoSidedIdeal.span_induction generalizing a b with
  | mem x hx =>
      obtain ⟨i, hi, rfl⟩ := hx
      obtain ⟨hei, hie⟩ := (Subsemigroup.mem_corner_iff he).1 i.2
      have hi' : (i : he.Corner) ∈ I := hi
      have : sand he (a * i.1 * b) = HMul.hMul (α := he.Corner) (β := he.Corner)
          (HMul.hMul (α := he.Corner) (β := he.Corner) (sand he a) i) (sand he b) := by
        apply Subtype.ext
        change e * (a * i.1 * b) * e = e * a * e * i.1 * (e * b * e)
        calc e * (a * i.1 * b) * e = e * a * (e * i.1 * e) * b * e := by
              rw [mul_assoc e i.1 e, hie, hei]; simp only [mul_assoc]
          _ = e * a * e * i.1 * (e * b * e) := by simp only [mul_assoc]
      rw [this]
      exact I.mul_mem_right _ _ (I.mul_mem_left _ _ hi')
  | zero =>
      have : sand he (a * 0 * b) = 0 := Subtype.ext (by rw [sand_val]; simp; rfl)
      rw [this]; exact I.zero_mem
  | add x y _ _ hx hy =>
      have : sand he (a * (x + y) * b) = sand he (a * x * b) + sand he (a * y * b) := by
        apply Subtype.ext
        change e * (a * (x + y) * b) * e = e * (a * x * b) * e + e * (a * y * b) * e
        simp only [mul_add, add_mul]
      rw [this]; exact I.add_mem (hx a b) (hy a b)
  | neg x _ hx =>
      have : sand he (a * (-x) * b) = -sand he (a * x * b) := by
        apply Subtype.ext
        change e * (a * (-x) * b) * e = -(e * (a * x * b) * e)
        simp only [mul_neg, neg_mul]
      rw [this]; exact I.neg_mem (hx a b)
  | left_absorb c x _ hx =>
      have := hx (a * c) b
      simpa only [mul_assoc] using this
  | right_absorb c x _ hx =>
      have := hx a (c * b)
      simpa only [mul_assoc] using this

lemma mem_of_val_mem_span (I : TwoSidedIdeal he.Corner) (x : he.Corner)
    (hx : x.1 ∈ cornerIdealSpan he I) : x ∈ I := by
  have := sandwich_mem_of_mem_span he I hx 1 1
  obtain ⟨hex, hxe⟩ := (Subsemigroup.mem_corner_iff he).1 x.2
  have hx' : sand he (1 * x.1 * 1) = x :=
    Subtype.ext (by rw [sand_val, one_mul, mul_one, hex, hxe])
  rwa [hx'] at this

/-- **BGRS 1.4**: proper quotients of idempotent corners of a mild algebra are
representation-finite. -/
theorem isRepresentationFinite_corner_quotient [Module.Finite k A]
    (hmild : MildAlg k A) (I : TwoSidedIdeal he.Corner) (hI : I ≠ ⊥) :
    letI := IsIdempotentElem.cornerAlgebra (k := k) he
    IsRepresentationFinite k (he.Corner ⧸ I.asIdeal) := by
  letI := IsIdempotentElem.cornerAlgebra (k := k) he
  set J := cornerIdealSpan he I
  have hJ : J ≠ ⊥ := by
    intro hJ
    apply hI
    ext x
    refine ⟨fun hx ↦ ?_, fun hx ↦ ?_⟩
    · have h1 : x.1 ∈ J := TwoSidedIdeal.subset_span ⟨x, hx, rfl⟩
      rw [hJ] at h1
      have h2 : x.1 = 0 := h1
      exact (show x = 0 from Subtype.ext h2) ▸ (⊥ : TwoSidedIdeal he.Corner).zero_mem
    · have h2 : x = 0 := hx
      rw [h2]; exact I.zero_mem
  have hfin := hmild J hJ
  let q : A →ₐ[k] A ⧸ J.asIdeal := Ideal.Quotient.mkₐ k J.asIdeal
  have hē : IsIdempotentElem (q.toRingHom e) := he.map q.toRingHom
  letI := IsIdempotentElem.cornerAlgebra (k := k) hē
  have hcorner : IsRepresentationFinite k hē.Corner := hfin.of_idempotentCorner hē
  let φ : he.Corner →ₐ[k] hē.Corner :=
    { toRingHom := IsIdempotentElem.cornerRingHom q.toRingHom he
      commutes' := fun c ↦ by
        apply Subtype.ext
        change q (algebraMap k A c * e) = algebraMap k (A ⧸ J.asIdeal) c * q e
        rw [map_mul, q.commutes] }
  have hφ : Function.Surjective φ := by
    intro y
    obtain ⟨s, hs⟩ := y.2
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective s
    refine ⟨sand he a, Subtype.ext ?_⟩
    change q (e * a * e) = y.1
    rw [← hs, map_mul, map_mul]
    rfl
  have hker : RingHom.ker φ = I.asIdeal := by
    ext x
    rw [RingHom.mem_ker, TwoSidedIdeal.mem_asIdeal]
    constructor
    · intro h
      apply mem_of_val_mem_span he I x
      have h1 : q x.1 = 0 := congrArg Subtype.val h
      exact TwoSidedIdeal.mem_asIdeal.1 (Ideal.Quotient.eq_zero_iff_mem.1 h1)
    · intro h
      apply Subtype.ext
      change q x.1 = 0
      exact Ideal.Quotient.eq_zero_iff_mem.2
        (TwoSidedIdeal.mem_asIdeal.2 (TwoSidedIdeal.subset_span ⟨x, h, rfl⟩))
  let e1 := Ideal.quotientKerAlgEquivOfSurjective hφ
  let e2 := Ideal.quotientEquivAlgOfEq k hker
  exact hcorner.of_algEquiv (e1.symm.trans e2)

end LargeIndecomposable
