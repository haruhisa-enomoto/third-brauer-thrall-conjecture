module

public import LargeIndecomposable.RayCategories.Contours.ContourClinging

@[expose] public section

/-!
# Proper common-whisker interlacement of paths

Formalize the interlacement relation used in the ray-category proof.  One
elementary step replaces a related inner path by another inside a common left
and right context, with at least one nontrivial context path.  Interlacement is
the equivalence relation generated by these elementary steps.
-/

set_option autoImplicit false
noncomputable section

namespace LargeIndecomposable

universe u v w

variable {k : Type u} [Field k]
variable {Q : Type v} [Quiver.{w} Q]

/-- One elementary interlacement step: replace related inner paths inside a
common proper path context, and require that the resulting outer paths remain
related. -/
def ProperWhiskerInterlacementStep
    (R : PathContourRelation Q)
    {a b : Q} (p q : Quiver.Path a b) : Prop :=
  ∃ (i j : Q) (s : Quiver.Path a i)
      (v w : Quiver.Path i j) (t : Quiver.Path j b),
    R.related v w ∧
      R.related ((s.comp v).comp t) ((s.comp w).comp t) ∧
      0 < s.length + t.length ∧
      p = (s.comp v).comp t ∧ q = (s.comp w).comp t

/-- The equivalence closure of proper common-whisker replacements. -/
def properWhiskerInterlacementRelation
    (R : PathContourRelation Q) : PathInterlacementRelation R where
  interlaced := fun p q ↦
    Relation.EqvGen (ProperWhiskerInterlacementStep R) p q
  refl' := fun p ↦ Relation.EqvGen.refl p
  symm' := fun h ↦ Relation.EqvGen.symm _ _ h
  trans' := fun hpq hqr ↦ Relation.EqvGen.trans _ _ _ hpq hqr

/-- Every elementary proper-whisker replacement is an interlacement. -/
theorem properWhiskerInterlaced_of_step
    (R : PathContourRelation Q)
    {a b : Q} {p q : Quiver.Path a b}
    (h : ProperWhiskerInterlacementStep R p q) :
    (properWhiskerInterlacementRelation R).interlaced p q :=
  Relation.EqvGen.rel p q h

/-- The outer paths in one elementary proper-whisker step are related. -/
theorem related_of_properWhiskerInterlacementStep
    (R : PathContourRelation Q)
    {a b : Q} {p q : Quiver.Path a b}
    (hpq : ProperWhiskerInterlacementStep R p q) :
    R.related p q := by
  obtain ⟨i, j, s, v, w, t, hvw, houter, hproper,
    hp, hq⟩ := hpq
  subst p
  subst q
  exact houter

private theorem related_both_of_properWhiskerInterlaced
    (R : PathContourRelation Q)
    {a b : Q} {p q : Quiver.Path a b}
    (hpq : (properWhiskerInterlacementRelation R).interlaced p q) :
    (R.related p p → R.related p q) ∧
      (R.related q q → R.related q p) := by
  change Relation.EqvGen _ p q at hpq
  induction hpq with
  | rel p q hpq =>
      obtain ⟨i, j, s, v, w, t, hvw, houter, hproper,
        hp, hq⟩ := hpq
      subst p
      subst q
      exact ⟨fun _ => houter, fun _ => R.symm houter⟩
  | refl p => exact ⟨id, id⟩
  | symm p q hpq ih => exact ⟨ih.2, ih.1⟩
  | trans p q r hpq hqr ihpq ihqr =>
      constructor
      · intro hpp
        have hpqR := ihpq.1 hpp
        have hqq : R.related q q := R.trans (R.symm hpqR) hpqR
        exact R.trans hpqR (ihqr.1 hqq)
      · intro hrr
        have hrqR := ihqr.2 hrr
        have hqq : R.related q q := R.trans (R.symm hrqR) hrqR
        exact R.trans hrqR (ihpq.2 hqq)

/-- On the reflexive support of the contour relation, proper-whisker
interlacement stays inside one related-path class. -/
theorem related_of_properWhiskerInterlaced
    (R : PathContourRelation Q)
    {a b : Q} {p q : Quiver.Path a b}
    (hpq : (properWhiskerInterlacementRelation R).interlaced p q)
    (hpp : R.related p p) :
    R.related p q :=
  (related_both_of_properWhiskerInterlaced R hpq).1 hpp

/-- A contour function has the same value on an elementary whiskered contour
as on the shorter inner contour. -/
theorem contourScalarFunction_eq_inner_of_properWhisker
    (R : PathContourRelation Q)
    (c : contourScalarFunctionSubgroup (k := k) R)
    {a i j b : Q} (s : Quiver.Path a i)
    (p q : Quiver.Path i j) (t : Quiver.Path j b)
    (hpq : R.related p q)
    (houter : R.related ((s.comp p).comp t) ((s.comp q).comp t)) :
    contourScalarFamily R c
        (relatedContour R ((s.comp p).comp t) ((s.comp q).comp t) houter) =
      contourScalarFamily R c (relatedContour R p q hpq) :=
  c.property.2 s p q t hpq houter

/-- In a proper whisker step, the sum of the inner path lengths is strictly
smaller than the sum of the outer path lengths. -/
theorem inner_length_sum_lt_outer_length_sum_of_properWhisker
    {a i j b : Q} (s : Quiver.Path a i)
    (p q : Quiver.Path i j) (t : Quiver.Path j b)
    (hproper : 0 < s.length + t.length) :
    p.length + q.length <
      ((s.comp p).comp t).length + ((s.comp q).comp t).length := by
  simp only [Quiver.Path.length_comp]
  omega

end LargeIndecomposable
