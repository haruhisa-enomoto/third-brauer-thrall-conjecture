module

public import LargeIndecomposable.RayCategories.Contours.ProperPathInterlacement

@[expose] public section

/-!
# Rank induction for proper path interlacement

Package the depth argument at the end of Roiter's globalization.  A rank is
constant on related paths and strictly decreases when a proper common context
is removed.  Under such a rank, clinging at every source forces every contour
value to be one.
-/

set_option autoImplicit false
noncomputable section

namespace LargeIndecomposable

universe u v w

variable {k : Type u} [Field k]
variable {Q : Type v} [Quiver.{w} Q]

/-- A natural-number depth for nonzero path rays, constant on related paths
and strictly decreasing when a nontrivial common context is removed. -/
structure ProperWhiskerPathRank (R : PathContourRelation Q) where
  rank : ∀ {i j : Q}, Quiver.Path i j → ℕ
  rank_eq_of_related : ∀ {i j : Q} {p q : Quiver.Path i j},
    R.related p q → rank p = rank q
  inner_lt_outer : ∀ {a i j b : Q} (s : Quiver.Path a i)
      (p q : Quiver.Path i j) (t : Quiver.Path j b)
      (_hpq : R.related p q)
      (_houter : R.related ((s.comp p).comp t) ((s.comp q).comp t)),
    0 < s.length + t.length → rank p < rank ((s.comp p).comp t)

/-- Interlacement generated by proper related whiskers either leaves a path
unchanged or relates its two endpoints in the contour relation. -/
theorem eq_or_related_of_properWhiskerInterlaced
    (R : PathContourRelation Q)
    {i j : Q} {p q : Quiver.Path i j}
    (h : (properWhiskerInterlacementRelation R).interlaced p q) :
    p = q ∨ R.related p q := by
  change Relation.EqvGen (ProperWhiskerInterlacementStep R) p q at h
  induction h with
  | rel x y hxy =>
      right
      obtain ⟨a, b, s, v, w, t, hvw, houter, hproper, rfl, rfl⟩ := hxy
      exact houter
  | refl x => exact Or.inl rfl
  | symm x y hxy ih =>
      rcases ih with h | h
      · exact Or.inl h.symm
      · exact Or.inr (R.symm h)
  | trans x y z hxy hyz ihxy ihyz =>
      rcases ihxy with hxy | hxy
      · subst y
        exact ihyz
      · rcases ihyz with hyz | hyz
        · subst z
          exact Or.inr hxy
        · exact Or.inr (R.trans hxy hyz)

/-- A nonzero path remains in the same related ray along proper-whisker
interlacement. -/
theorem related_of_properWhiskerInterlaced_of_self
    (R : PathContourRelation Q)
    {i j : Q} {p q : Quiver.Path i j}
    (hI : (properWhiskerInterlacementRelation R).interlaced p q)
    (hpp : R.related p p) : R.related p q := by
  rcases eq_or_related_of_properWhiskerInterlaced R hI with rfl | hpq
  · exact hpp
  · exact hpq

/-- A proper-whisker rank makes everywhere clinging detect the identity
contour function. -/
theorem clingingAtEverySourceDetectsIdentity_of_properWhiskerPathRank
    (R : PathContourRelation Q)
    (D : ProperWhiskerPathRank R) :
    ClingingAtEverySourceDetectsIdentity (k := k) R
      (properWhiskerInterlacementRelation R) := by
  intro c hclings
  have hmain : ∀ {i j : Q} (p q : Quiver.Path i j),
      ∀ hpq : R.related p q,
        contourScalarFamily R c (relatedContour R p q hpq) = 1 := by
    intro i j p
    induction hn : D.rank p using Nat.strong_induction_on generalizing i j p with
    | h n ih =>
        intro q hpq
        have hinterlaced : ∀ {a b : Q} (v w : Quiver.Path a b),
            (properWhiskerInterlacementRelation R).interlaced v w →
              ∀ hvw : R.related v w,
                D.rank v = n →
                  contourScalarFamily R c
                    (relatedContour R v w hvw) = 1 := by
          intro a b v w hI
          change Relation.EqvGen
            (ProperWhiskerInterlacementStep R) v w at hI
          induction hI with
          | rel v w hstep =>
              intro hvw' hvrank
              obtain ⟨a', b', s, p', q', t, hpq', houter,
                hproper, rfl, rfl⟩ := hstep
              rw [contourScalarFunction_eq_inner_of_properWhisker
                R c s p' q' t hpq' houter]
              have hlt : D.rank p' < n :=
                (D.inner_lt_outer s p' q' t hpq' houter hproper).trans_eq
                  hvrank
              exact ih (D.rank p') hlt p' rfl q' hpq'
          | refl v =>
              intro hvv hvrank
              exact contourScalarFunction_self R c v hvv
          | symm v w hI ihI =>
              intro hwv hwrank
              have hvw : R.related v w := R.symm hwv
              have hvrank : D.rank v = n :=
                (D.rank_eq_of_related hvw).trans hwrank
              have hvalue := ihI hvw hvrank
              have hreverse : contourScalarFamily R c
                  (relatedContour R w v hwv) =
                    (contourScalarFamily R c
                      (relatedContour R v w hvw))⁻¹ := by
                simpa [contourScalarFamily] using
                  (contourScalarFunction_reverse R c v w hvw)
              rw [hreverse, hvalue]
              simp
          | trans v w z hvwI hwzI ihvw ihwz =>
              intro hvz hvrank
              have hvv : R.related v v := R.trans hvz (R.symm hvz)
              have hvw : R.related v w :=
                related_of_properWhiskerInterlaced_of_self R hvwI hvv
              have hww : R.related w w :=
                R.trans (R.symm hvw) hvw
              have hwz : R.related w z :=
                related_of_properWhiskerInterlaced_of_self R hwzI hww
              have hwrank : D.rank w = n :=
                (D.rank_eq_of_related hvw).symm.trans hvrank
              have hvw_one := ihvw hvw hvrank
              have hwz_one := ihwz hwz hwrank
              have htrans := c.property.1 v w z hvw hwz
              have htrans' : contourScalarFamily R c
                  (relatedContour R v z hvz) =
                    contourScalarFamily R c
                        (relatedContour R v w hvw) *
                      contourScalarFamily R c
                        (relatedContour R w z hwz) := by
                simpa [contourScalarFamily, relatedContour] using htrans
              rw [htrans', hvw_one, hwz_one]
              simp
        obtain ⟨p', q', hppI, hppR, hqqI, hqqR, hpq'R, hpq'⟩ :=
          hclings i p q hpq
        have hpprank : D.rank p = n := hn
        have hpp_one := hinterlaced p p' hppI hppR hpprank
        have hq'rank : D.rank q' = n :=
          (D.rank_eq_of_related hqqR).symm.trans
            ((D.rank_eq_of_related hpq).symm.trans hn)
        have hq'q_one := hinterlaced q' q
          ((properWhiskerInterlacementRelation R).symm hqqI)
          (R.symm hqqR) hq'rank
        have hpq'R' : R.related p q' := R.trans hppR hpq'R
        have hfirst := c.property.1 p p' q' hppR hpq'R
        have hsecond := c.property.1 p q' q hpq'R' (R.symm hqqR)
        have hfirst' : contourScalarFamily R c
              (relatedContour R p q' hpq'R') =
            contourScalarFamily R c (relatedContour R p p' hppR) *
              contourScalarFamily R c (relatedContour R p' q' hpq'R) := by
          simpa [contourScalarFamily, relatedContour] using hfirst
        have hsecond' : contourScalarFamily R c
              (relatedContour R p q hpq) =
            contourScalarFamily R c (relatedContour R p q' hpq'R') *
              contourScalarFamily R c
                (relatedContour R q' q (R.symm hqqR)) := by
          simpa [contourScalarFamily, relatedContour] using hsecond
        rw [hsecond', hfirst', hpp_one, hpq', hq'q_one]
        simp
  apply Subtype.ext
  funext C
  change contourScalarFamily R c C = (1 : kˣ)
  simpa [contourScalarFamily, relatedContour] using
    hmain C.1.left C.1.right C.property

end LargeIndecomposable
