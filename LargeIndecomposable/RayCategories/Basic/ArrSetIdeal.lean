module

public import LargeIndecomposable.RayCategories.Basic.QuotRay

/-!
# The zero ideal generated by a set of arrows

For a set `S` of arrows (irreducible morphisms) of a ray category, the morphisms factoring
through an arrow of `S` form a proper zero ideal (`arrSetIdeal`, `arrSetIdeal_isProper`); an
arrow lies in it exactly when it is (up to the identification of objects) an arrow of `S`
(`mem_of_irreducible`). The stages of Fischbacher's Satz 5.1 are the quotients of the universal
cover by such ideals.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable.RayCat

open CategoryTheory Limits LargeIndecomposable

universe v u

variable {C : Type u} [Category.{v} C] [HasZeroMorphisms C] [IsRayCategory C]

/-- **In a ray category, a composite is an isomorphism only if both factors are.** -/
lemma isIso_of_comp_isIso {x y z : C} (f : x ⟶ y) (g : y ⟶ z) (h : IsIso (f ≫ g)) :
    IsIso f ∧ IsIso g := by
  set r : y ⟶ x := g ≫ inv (f ≫ g) with hr
  have hfr : f ≫ r = 𝟙 x := by rw [hr, ← Category.assoc, IsIso.hom_inv_id]
  set e : y ⟶ y := r ≫ f with he
  have hee : e ≫ e = e := by
    rw [he, Category.assoc, ← Category.assoc f r f, hfr, Category.id_comp]
  have hf : IsIso f := by
    by_cases he1 : e = 𝟙 y
    · exact ⟨⟨r, hfr, he1⟩⟩
    · obtain ⟨n, hn⟩ := IsRayCategory.nil y e he1
      have hpow : ∀ m, rpow e (m + 1) = e := by
        intro m
        induction m with
        | zero => simp [rpow_succ]
        | succ m ih => rw [rpow_succ, ih, hee]
      have he0 : e = 0 := by
        rcases n with _ | n
        · exact absurd hn (IsRayCategory.id_ne_zero y)
        · rw [← hpow n, hn]
      have hf0 : f = 0 := by
        calc f = (f ≫ r) ≫ f := by rw [hfr, Category.id_comp]
          _ = f ≫ e := by rw [he, Category.assoc]
          _ = 0 := by rw [he0, comp_zero]
      have : (𝟙 x : x ⟶ x) = 0 := by rw [← hfr, hf0, zero_comp]
      exact absurd this (IsRayCategory.id_ne_zero x)
  refine ⟨hf, ?_⟩
  have : g = inv f ≫ (f ≫ g) := by simp
  rw [this]
  infer_instance

/-- The morphisms factoring through an arrow of `S`. -/
def arrSetIdeal (S : ∀ {x y : RayVert C}, (x ⟶ y) → Prop) : ZeroHomIdeal C where
  mem {X Y} f := f = 0 ∨ ∃ (x y : RayVert C) (e : x ⟶ y) (_ : S e) (a : X ⟶ x.out) (c : y.out ⟶ Y),
    f = a ≫ e.1 ≫ c
  zero_mem _ _ := Or.inl rfl
  precomp f g hg := by
    rcases hg with rfl | ⟨x, y, e, hS, a, c, rfl⟩
    · exact Or.inl comp_zero
    · exact Or.inr ⟨x, y, e, hS, f ≫ a, c, by simp [Category.assoc]⟩
  postcomp g hf := by
    rcases hf with rfl | ⟨x, y, e, hS, a, c, rfl⟩
    · exact Or.inl zero_comp
    · exact Or.inr ⟨x, y, e, hS, a, c ≫ g, by simp [Category.assoc]⟩

variable (S : ∀ {x y : RayVert C}, (x ⟶ y) → Prop)

/-- **The arrow ideal is proper.** -/
lemma arrSetIdeal_isProper : (arrSetIdeal S).IsProper := by
  intro X hX
  rcases hX with h | ⟨x, y, e, -, a, c, hac⟩
  · exact IsRayCategory.id_ne_zero X h
  · have h1 : IsIso (a ≫ e.1 ≫ c) := by rw [← hac]; infer_instance
    have h2 := (isIso_of_comp_isIso a _ h1).2
    exact e.2.2.1 (isIso_of_comp_isIso e.1 c h2).1

omit [IsRayCategory C] in
lemma isIso_rpow {X : C} (a : X ⟶ X) [IsIso a] : ∀ n, IsIso (rpow a n)
  | 0 => by rw [rpow_zero]; infer_instance
  | n + 1 => by rw [rpow_succ]; have := isIso_rpow a n; infer_instance

/-- An invertible endomorphism in a ray category is the identity. -/
lemma eq_id_of_isIso {X : C} (a : X ⟶ X) (ha : IsIso a) : a = 𝟙 X := by
  by_contra h
  obtain ⟨n, hn⟩ := IsRayCategory.nil X a h
  have := isIso_rpow a n
  rw [hn] at this
  exact IsRayCategory.id_ne_zero X (by rw [← IsIso.hom_inv_id (0 : X ⟶ X), zero_comp])

/-- **An arrow in the arrow ideal belongs to `S`.** -/
lemma mem_of_irreducible {x y : RayVert C} (e : x ⟶ y) (h : (arrSetIdeal S).mem e.1) : S e := by
  rcases h with h | ⟨x', y', α, hS, a, c, hac⟩
  · exact absurd h e.2.1
  rcases e.2.2.2 _ a (α.1 ≫ c) hac with ha | hc
  · have hx : x.out = x'.out := IsRayCategory.skeletal ⟨asIso a⟩
    change x = x' at hx
    subst hx
    rw [eq_id_of_isIso a ha, Category.id_comp] at hac
    rcases e.2.2.2 _ α.1 c hac with hα | hc
    · exact absurd hα α.2.2.1
    · have hy : y'.out = y.out := IsRayCategory.skeletal ⟨asIso c⟩
      change y' = y at hy
      subst hy
      rw [eq_id_of_isIso c hc, Category.comp_id] at hac
      rwa [show e = α from Subtype.ext hac]
  · exact absurd (isIso_of_comp_isIso α.1 c hc).1 α.2.2.1

/-- The depth measure drops at an interlacing step (general ray categories). -/
lemma below_lt_of_step' {x a c y : RayVert C} (p : Quiver.Path x a) (v : Quiver.Path a c)
    (q : Quiver.Path c y) (h0 : pathVal ((p.comp v).comp q) ≠ 0)
    (hlen : 0 < p.length ∨ 0 < q.length) :
    (IsRayCategory.below (⟨a.out, c.out, pathVal v⟩ : RayMor C)).ncard <
      (IsRayCategory.below (⟨x.out, y.out, pathVal ((p.comp v).comp q)⟩ : RayMor C)).ncard := by
  refine IsRayCategory.ncard_below_lt h0 ⟨pathVal p, pathVal q, pathVal_comp3 p v q⟩ ?_
  rintro ⟨a'', c'', he''⟩
  let a' : a.out ⟶ x.out := a''
  let c' : y.out ⟶ c.out := c''
  have hval := pathVal_comp3 p v q
  have he : pathVal v = a' ≫ (pathVal p ≫ pathVal v ≫ pathVal q) ≫ c' := he''.trans (by rw [hval])
  rw [hval] at h0
  have e : pathVal p ≫ pathVal v ≫ pathVal q =
      (pathVal p ≫ a') ≫ (pathVal p ≫ pathVal v ≫ pathVal q) ≫ (c' ≫ pathVal q) := by
    conv_lhs => rw [he]
    simp [Category.assoc]
  obtain ⟨h1, h2⟩ := IsRayCategory.eq_id_of_two_sided _ h0 _ _ e
  rcases hlen with hl | hl
  · have : IsIso (pathVal p ≫ a') := by rw [h1]; infer_instance
    have hp : IsIso (pathVal p) := (isIso_of_comp_isIso _ a' this).1
    obtain ⟨hxa, hpe⟩ := eq_eqToHom_of_isIso (pathVal p)
    change x = a at hxa
    subst hxa
    exact pathVal_ne_id_of_length p hl hpe
  · have : IsIso (c' ≫ pathVal q) := by rw [h2]; infer_instance
    have hq : IsIso (pathVal q) := (isIso_of_comp_isIso c' _ this).2
    obtain ⟨hcy, hqe⟩ := eq_eqToHom_of_isIso (pathVal q)
    change c = y at hcy
    subst hcy
    exact pathVal_ne_id_of_length q hl hqe

end LargeIndecomposable.RayCat
