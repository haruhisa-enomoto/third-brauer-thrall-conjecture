module

public import LargeIndecomposable.RayCategories.RoiterVanishing.RayResidueCategory
public import LargeIndecomposable.RayCategories.Basic.Basic
public import LargeIndecomposable.RayCategories.Quotients.ResidueQuiver
public import LargeIndecomposable.RayCategories.Basic.Exhaust
public import LargeIndecomposable.RayCategories.Opposite.Op

/-!
# Quotients of ray categories by proper zero ideals

The quotient of a (possibly infinite) ray category by a proper zero Hom ideal is again a ray
category (`isRayCategory_quotient`). This is the stage construction of Fischbacher's Satz 5.1:
quotients of the universal cover by ideals generated by arrows.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace LargeIndecomposable.RayCat

open CategoryTheory Limits LargeIndecomposable

universe v u

variable {C : Type u} [Category.{v} C] [HasZeroMorphisms C] (I : ZeroHomIdeal C)

lemma quot_map_rpow {X : C} (e : X ⟶ X) : ∀ n,
    (CategoryTheory.Quotient.functor I.rel).map (rpow e n) =
      rpow ((CategoryTheory.Quotient.functor I.rel).map e) n
  | 0 => by simp
  | n + 1 => by rw [rpow_succ, Functor.map_comp, quot_map_rpow e n, rpow_succ]

/-- **A quotient of a ray category by a proper zero ideal is a ray category.** -/
theorem isRayCategory_quotient [IsRayCategory C] (hI : I.IsProper) :
    IsRayCategory (CategoryTheory.Quotient I.rel) where
  skeletal := by
    rintro ⟨X⟩ ⟨Y⟩ ⟨e⟩
    let q := CategoryTheory.Quotient.functor I.rel
    let f : X ⟶ Y := Quot.out e.hom
    let g : Y ⟶ X := Quot.out e.inv
    have hf : q.map f = e.hom := Quot.out_eq _
    have hg : q.map g = e.inv := Quot.out_eq _
    have hfg : f ≫ g = 𝟙 X := I.functor_map_eq_id_iff hI (f ≫ g) |>.1 (by
      rw [q.map_comp, hf, hg, e.hom_inv_id]; rfl)
    have hgf : g ≫ f = 𝟙 Y := I.functor_map_eq_id_iff hI (g ≫ f) |>.1 (by
      rw [q.map_comp, hg, hf, e.inv_hom_id]; rfl)
    apply CategoryTheory.Quotient.ext
    exact IsRayCategory.skeletal ⟨⟨f, g, hfg, hgf⟩⟩
  finite_out := by
    rintro ⟨X⟩
    refine ((IsRayCategory.finite_out X).image fun y ↦ (⟨y⟩ : CategoryTheory.Quotient I.rel)).subset ?_
    rintro ⟨Y⟩ ⟨f, hf⟩
    induction f using Quot.inductionOn with
    | _ f =>
      refine ⟨Y, ⟨f, fun h ↦ hf ?_⟩, rfl⟩
      subst h
      exact (CategoryTheory.Quotient.functor I.rel).map_zero X Y
  finite_in := by
    rintro ⟨X⟩
    refine ((IsRayCategory.finite_in X).image fun y ↦ (⟨y⟩ : CategoryTheory.Quotient I.rel)).subset ?_
    rintro ⟨Y⟩ ⟨f, hf⟩
    induction f using Quot.inductionOn with
    | _ f =>
      refine ⟨Y, ⟨f, fun h ↦ hf ?_⟩, rfl⟩
      subst h
      exact (CategoryTheory.Quotient.functor I.rel).map_zero Y X
  finite_hom := by
    rintro ⟨X⟩ ⟨Y⟩
    have := IsRayCategory.finite_hom X Y
    exact Finite.of_surjective (fun f : X ⟶ Y ↦ (Quot.mk _ f : _ ⟶ _)) Quot.mk_surjective
  id_ne_zero := by
    rintro ⟨X⟩ h
    have h' : (CategoryTheory.Quotient.functor I.rel).map (𝟙 X) = 0 := by
      rw [(CategoryTheory.Quotient.functor I.rel).map_id]; exact h
    exact hI X ((I.functor_map_eq_zero_iff _).1 h')
  nil := by
    rintro ⟨X⟩ e he
    induction e using Quot.inductionOn with
    | _ e =>
      have he' : e ≠ 𝟙 X := fun h ↦ he (by subst h; rfl)
      obtain ⟨n, hn⟩ := IsRayCategory.nil X e he'
      refine ⟨n, ?_⟩
      have := quot_map_rpow I e n
      rw [hn, Functor.map_zero] at this
      exact this.symm

/-! ### Arrows and paths of the quotient -/

variable {I} (hI : I.IsProper)

/-- The quotient functor. -/
abbrev qF : C ⥤ CategoryTheory.Quotient I.rel := CategoryTheory.Quotient.functor I.rel

/-- The vertex of the quotient over a vertex. -/
abbrev qVt (x : RayVert C) : RayVert (CategoryTheory.Quotient I.rel) := RayVert.mk ((qF (I := I)).obj x.out)

include hI in
/-- The image of an arrow outside the ideal. -/
def qArrI {x y : RayVert C} (e : x ⟶ y) (he : ¬I.mem e.1) : qVt (I := I) x ⟶ qVt y :=
  ⟨(qF (I := I)).map e.1, (isIrreducible_iff_isIrreducibleRayMorphism _).2
    ((I.functor_map_isIrreducible_iff hI _).2 ⟨(isIrreducible_iff_isIrreducibleRayMorphism _).1 e.2, he⟩)⟩

variable (I) in
/-- All arrows of a path lie outside the ideal. -/
def AvoidsI {x : RayVert C} : ∀ {y : RayVert C}, Quiver.Path x y → Prop
  | _, .nil => True
  | _, .cons p e => AvoidsI p ∧ ¬I.mem e.1

/-- The image in the quotient of a path avoiding the ideal. -/
def toQI {x : RayVert C} : ∀ {y : RayVert C} (p : Quiver.Path x y), AvoidsI I p →
    Quiver.Path (qVt (I := I) x) (qVt y)
  | _, .nil, _ => .nil
  | _, .cons p e, h => .cons (toQI p h.1) (qArrI hI e h.2)

lemma pathVal_toQI {x : RayVert C} : ∀ {y : RayVert C} (p : Quiver.Path x y) (h : AvoidsI I p),
    pathVal (toQI hI p h) = (qF (I := I)).map (pathVal p)
  | _, .nil, _ => ((qF (I := I)).map_id _).symm
  | _, .cons p e, h => by
    change pathVal (toQI hI p h.1) ≫ (qF (I := I)).map e.1 = _
    rw [pathVal_toQI p h.1]
    exact ((qF (I := I)).map_comp _ _).symm

omit hI in
/-- A path whose value lies outside the ideal avoids it. -/
lemma avoidsI_of_not_mem {x : RayVert C} : ∀ {y : RayVert C} (p : Quiver.Path x y),
    ¬I.mem (pathVal p) → AvoidsI I p
  | _, .nil, _ => trivial
  | _, .cons p e, h => by
    refine ⟨avoidsI_of_not_mem p fun hp ↦ h ?_, fun he ↦ h ?_⟩
    · exact I.postcomp e.1 hp
    · exact I.precomp (pathVal p) he

include hI in
/-- The lift of an arrow of the quotient. -/
def liftArrQ {x y : RayVert (CategoryTheory.Quotient I.rel)} (e : x ⟶ y) :
    RayVert.mk x.out.as ⟶ RayVert.mk y.out.as :=
  ⟨Quot.out e.1, by
    have h := e.2
    rw [← Quot.out_eq e.1] at h
    exact (isIrreducible_iff_isIrreducibleRayMorphism _).2
      ((I.functor_map_isIrreducible_iff hI _).1 ((isIrreducible_iff_isIrreducibleRayMorphism _).1 h)).1⟩

lemma liftArrQ_not_mem {x y : RayVert (CategoryTheory.Quotient I.rel)} (e : x ⟶ y) :
    ¬I.mem (liftArrQ hI e).1 := by
  have h := e.2
  rw [← Quot.out_eq e.1] at h
  exact ((I.functor_map_isIrreducible_iff hI _).1 ((isIrreducible_iff_isIrreducibleRayMorphism _).1 h)).2

/-- The inclusion of quivers. -/
def inclQ : RayVert (CategoryTheory.Quotient I.rel) ⥤q RayVert C where
  obj x := RayVert.mk x.out.as
  map e := liftArrQ hI e

lemma pathVal_inclQ {x : RayVert (CategoryTheory.Quotient I.rel)} :
    ∀ {y : RayVert (CategoryTheory.Quotient I.rel)} (r : Quiver.Path x y),
    (qF (I := I)).map (pathVal ((inclQ hI).mapPath r)) = pathVal r
  | _, .nil => (qF (I := I)).map_id _
  | _, .cons r e => by
    rw [Prefunctor.mapPath_cons]
    change (qF (I := I)).map (pathVal ((inclQ hI).mapPath r) ≫ Quot.out e.1) = pathVal r ≫ e.1
    rw [Functor.map_comp, pathVal_inclQ r]
    exact congrArg (fun t ↦ pathVal r ≫ t) (Quot.out_eq e.1)

lemma avoidsI_inclQ {x : RayVert (CategoryTheory.Quotient I.rel)} :
    ∀ {y : RayVert (CategoryTheory.Quotient I.rel)} (r : Quiver.Path x y),
    AvoidsI I ((inclQ hI).mapPath r)
  | _, .nil => trivial
  | _, .cons r e => ⟨avoidsI_inclQ r, liftArrQ_not_mem hI e⟩

include hI in
/-- **Reachability in the quotient implies reachability before.** -/
lemma reaches_of_quot {x y : C} (h : Reaches (A := CategoryTheory.Quotient I.rel) ⟨x⟩ ⟨y⟩) :
    Reaches x y := by
  obtain ⟨r⟩ := h
  exact ⟨(inclQ hI).mapPath r⟩

/-! ### Chains and cancellation -/

omit hI in
lemma qF_out {x y : CategoryTheory.Quotient I.rel} (g : x ⟶ y) :
    (qF (I := I)).map (Quot.out g : x.as ⟶ y.as) = g := Quot.out_eq g

/-- A morphism of the quotient, lifted. -/
def liftRMI (F : RayMor (CategoryTheory.Quotient I.rel)) : RayMor C :=
  ⟨F.1.as, F.2.1.as, Quot.out F.2.2⟩

omit hI in
lemma peak_liftRMI {F G : RayMor (CategoryTheory.Quotient I.rel)} (h : Peak F G) :
    Peak (liftRMI F) (liftRMI G) := by
  obtain ⟨X, Y, φ⟩ := F
  obtain ⟨X', Y', ψ⟩ := G
  obtain ⟨hY, -⟩ := id h
  change Y = Y' at hY
  subst hY
  rw [peak_mk_iff] at h
  change Peak ⟨X.as, Y.as, Quot.out φ⟩ ⟨X'.as, Y.as, Quot.out ψ⟩
  rw [peak_mk_iff]
  refine ⟨fun ⟨k, hk⟩ ↦ h.1 ⟨(qF (I := I)).map k, ?_⟩,
    fun ⟨k, hk⟩ ↦ h.2 ⟨(qF (I := I)).map k, ?_⟩⟩
  · rw [← qF_out ψ, ← Functor.map_comp, hk, qF_out]
  · rw [← qF_out φ, ← Functor.map_comp, hk, qF_out]

omit hI in
lemma valley_liftRMI {F G : RayMor (CategoryTheory.Quotient I.rel)} (h : Valley F G) :
    Valley (liftRMI F) (liftRMI G) := by
  obtain ⟨X, Y, φ⟩ := F
  obtain ⟨X', Y', ψ⟩ := G
  obtain ⟨hX, -⟩ := id h
  change X = X' at hX
  subst hX
  rw [valley_mk_iff] at h
  change Valley ⟨X.as, Y.as, Quot.out φ⟩ ⟨X.as, Y'.as, Quot.out ψ⟩
  rw [valley_mk_iff]
  refine ⟨fun ⟨k, hk⟩ ↦ h.1 ⟨(qF (I := I)).map k, ?_⟩,
    fun ⟨k, hk⟩ ↦ h.2 ⟨(qF (I := I)).map k, ?_⟩⟩
  · rw [← qF_out φ, ← Functor.map_comp, hk, qF_out]
  · rw [← qF_out ψ, ← Functor.map_comp, hk, qF_out]

omit hI in
/-- Chains of the quotient lift to chains. -/
lemma isChain_liftRMI {o : ℕ} {L : List (RayMor (CategoryTheory.Quotient I.rel))}
    (hL : IsChain o L) : IsChain o (L.map liftRMI) := by
  refine ⟨fun f hf ↦ ?_, fun j hj ↦ ?_⟩
  · obtain ⟨F, hF, rfl⟩ := List.mem_map.1 hf
    intro h0
    have h0' : (Quot.out F.2.2 : F.1.as ⟶ F.2.1.as) = 0 := h0
    apply hL.1 F hF
    rw [← qF_out F.2.2, h0', Functor.map_zero]
  · have := hL.2 j (by simpa using hj)
    simp only [List.getElem_map]
    unfold Link at this ⊢
    split_ifs at this ⊢
    · exact peak_liftRMI this
    · exact valley_liftRMI this

omit hI in
/-- **Chain-boundedness passes to quotients.** -/
lemma chainBounded_quotI (hCB : ChainBounded C) :
    ChainBounded (CategoryTheory.Quotient I.rel) := by
  obtain ⟨N, hN⟩ := hCB
  exact ⟨N, fun L hL ↦ by simpa using hN _ (isChain_liftRMI hL)⟩

end LargeIndecomposable.RayCat
