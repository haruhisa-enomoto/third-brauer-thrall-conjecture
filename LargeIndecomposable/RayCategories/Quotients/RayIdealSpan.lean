module

public import LargeIndecomposable.RayCategories.Quotients.RayIdeal
public import LargeIndecomposable.RayCategories.Distributive.FromDistributive
public import LargeIndecomposable.RayCategories.Distributive.SplitBasicRayCategory

/-!
# The ideal generated by a representative

For split basic data of a distributive algebra and a morphism `t` of the
projective category, every nonzero morphism whose value lies in the two-sided
ideal generated by `t` has a ray that is a two-sided multiple of the ray of `t`
(`SplitBasicData.ray_factorsThrough_of_mem_span`).
-/

@[expose] public section

set_option autoImplicit false
set_option linter.unusedSectionVars false

noncomputable section

namespace LargeIndecomposable

open CategoryTheory Limits LargeIndecomposable RayCat

universe u

namespace SplitBasicData

variable {k : Type u} [Field k] {B : Type u} [Ring B] [Algebra k B] [FiniteDimensional k B]
  {ι : Type} [Fintype ι] [DecidableEq ι] (S : SplitBasicData k B ι)
  [HasBGRSDistributiveHomStructure k S.toIdempotents.ProjectiveCategory]

/-- The corner part of an element as a morphism. -/
def cornerMor (X Y : S.toIdempotents.ProjectiveCategory) (x : B) : X ⟶ Y :=
  ⟨S.e (S.toIdempotents.projectiveVertex Y) * x * S.e (S.toIdempotents.projectiveVertex X), ⟨x, rfl⟩⟩

lemma cornerMor_val (X Y : S.toIdempotents.ProjectiveCategory) (x : B) :
    (S.cornerMor X Y x).1 = S.e (S.toIdempotents.projectiveVertex Y) * x * S.e (S.toIdempotents.projectiveVertex X) :=
  rfl

lemma cornerMor_self {X Y : S.toIdempotents.ProjectiveCategory} (f : X ⟶ Y) : S.cornerMor X Y f.1 = f := by
  obtain ⟨a, ha⟩ := f.2
  change S.e (S.toIdempotents.projectiveVertex Y) * a * S.e (S.toIdempotents.projectiveVertex X) = f.1 at ha
  apply Subtype.ext
  rw [cornerMor_val, ← ha]
  simp only [← mul_assoc, S.e_mul_e]
  rw [mul_assoc _ (S.e _) (S.e _), S.e_mul_e]

variable {X₀ Y₀ : S.toIdempotents.ProjectiveCategory} (t : X₀ ⟶ Y₀)

/-- Composites through `t`. -/
def throughSet (X Y : S.toIdempotents.ProjectiveCategory) : Set (X ⟶ Y) :=
  {p | ∃ (d : X ⟶ X₀) (c : Y₀ ⟶ Y), p = d ≫ t ≫ c}

/-- Their span. -/
def throughSpan (X Y : S.toIdempotents.ProjectiveCategory) : Submodule k (X ⟶ Y) :=
  Submodule.span k (S.throughSet t X Y)

lemma comp_mem_throughSpan {X Y Z : S.toIdempotents.ProjectiveCategory} {q : X ⟶ Z}
    (hq : q ∈ S.throughSpan t X Z) (g : Z ⟶ Y) : q ≫ g ∈ S.throughSpan t X Y := by
  induction hq using Submodule.span_induction with
  | mem p hp =>
      obtain ⟨d, c, rfl⟩ := hp
      exact Submodule.subset_span ⟨d, c ≫ g, by simp⟩
  | zero => rw [zero_comp]; exact Submodule.zero_mem _
  | add p p' _ _ hp hp' => rw [Preadditive.add_comp]; exact Submodule.add_mem _ hp hp'
  | smul c p _ hp => rw [Linear.smul_comp]; exact Submodule.smul_mem _ c hp

lemma mem_throughSpan_comp {X Y Z : S.toIdempotents.ProjectiveCategory} {q : Z ⟶ Y}
    (hq : q ∈ S.throughSpan t Z Y) (g : X ⟶ Z) : g ≫ q ∈ S.throughSpan t X Y := by
  induction hq using Submodule.span_induction with
  | mem p hp =>
      obtain ⟨d, c, rfl⟩ := hp
      exact Submodule.subset_span ⟨g ≫ d, c, by simp⟩
  | zero => rw [comp_zero]; exact Submodule.zero_mem _
  | add p p' _ _ hp hp' => rw [Preadditive.comp_add]; exact Submodule.add_mem _ hp hp'
  | smul c p _ hp => rw [Linear.comp_smul]; exact Submodule.smul_mem _ c hp

lemma sum_val {X Y : S.toIdempotents.ProjectiveCategory} (f : S.toIdempotents.ProjectiveCategory → (X ⟶ Y)) :
    (∑ Z, f Z).1 = ∑ Z, (f Z).1 := by
  let v : (X ⟶ Y) →+ B := ⟨⟨Subtype.val, rfl⟩, fun _ _ ↦ rfl⟩
  exact map_sum v f Finset.univ

lemma e_sandwich (u v : B) (Z : S.toIdempotents.ProjectiveCategory) :
    u * S.e (S.toIdempotents.projectiveVertex Z) * (S.e (S.toIdempotents.projectiveVertex Z) * v) =
      u * S.e (S.toIdempotents.projectiveVertex Z) * v := by
  rw [mul_assoc u, ← mul_assoc (S.e _) (S.e _) v, S.e_mul_e, ← mul_assoc]

lemma sum_e_vertex : ∑ Z : S.toIdempotents.ProjectiveCategory, S.e (S.toIdempotents.projectiveVertex Z) = 1 := by
  rw [← S.sum_eq_one]
  exact Fintype.sum_equiv S.toIdempotents.projectiveVertexEquiv _ _ (fun _ ↦ rfl)

/-- **The corner parts of the ideal generated by `t` lie in the spans of composites
through `t`.** -/
lemma cornerMor_mem_throughSpan {x : B} (hx : x ∈ TwoSidedIdeal.span {t.1})
    (X Y : S.toIdempotents.ProjectiveCategory) : S.cornerMor X Y x ∈ S.throughSpan t X Y := by
  induction hx using TwoSidedIdeal.span_induction generalizing X Y with
  | mem x hx =>
      rw [Set.mem_singleton_iff] at hx
      subst hx
      by_cases hX : X = X₀
      · by_cases hY : Y = Y₀
        · subst hX hY
          rw [S.cornerMor_self]
          exact Submodule.subset_span ⟨𝟙 _, 𝟙 _, by simp⟩
        · have h0 : S.e (S.toIdempotents.projectiveVertex Y) * t.1 = 0 :=
            SplitBasicIdempotents.ProjectiveCategory.idempotent_mul_val_eq_zero_of_ne S.toIdempotents hY t
          have : S.cornerMor X Y t.1 = 0 := Subtype.ext (by
            rw [cornerMor_val, h0, zero_mul]
            rfl)
          rw [this]
          exact Submodule.zero_mem _
      · have h0 : t.1 * S.e (S.toIdempotents.projectiveVertex X) = 0 :=
          SplitBasicIdempotents.ProjectiveCategory.val_mul_idempotent_eq_zero_of_ne S.toIdempotents
            (Ne.symm hX) t
        have : S.cornerMor X Y t.1 = 0 := Subtype.ext (by
          rw [cornerMor_val, mul_assoc, h0, mul_zero]
          rfl)
        rw [this]
        exact Submodule.zero_mem _
  | zero =>
      have : S.cornerMor X Y 0 = 0 := Subtype.ext (by rw [cornerMor_val, mul_zero, zero_mul]; rfl)
      rw [this]
      exact Submodule.zero_mem _
  | add x y _ _ hx hy =>
      have : S.cornerMor X Y (x + y) = S.cornerMor X Y x + S.cornerMor X Y y :=
        Subtype.ext (by rw [cornerMor_val, mul_add, add_mul]; rfl)
      rw [this]
      exact Submodule.add_mem _ (hx X Y) (hy X Y)
  | neg x _ hx =>
      have : S.cornerMor X Y (-x) = -S.cornerMor X Y x :=
        Subtype.ext (by rw [cornerMor_val, mul_neg, neg_mul]; rfl)
      rw [this]
      exact Submodule.neg_mem _ (hx X Y)
  | left_absorb a x _ hx =>
      have : S.cornerMor X Y (a * x) = ∑ Z, S.cornerMor X Z x ≫ S.cornerMor Z Y a := by
        apply Subtype.ext
        rw [cornerMor_val, sum_val]
        simp only [SplitBasicIdempotents.ProjectiveCategory.comp_val, cornerMor_val]
        calc S.e (S.toIdempotents.projectiveVertex Y) * (a * x) * S.e (S.toIdempotents.projectiveVertex X)
            = ∑ Z, S.e (S.toIdempotents.projectiveVertex Y) * a * S.e (S.toIdempotents.projectiveVertex Z) *
                (x * S.e (S.toIdempotents.projectiveVertex X)) := by
              rw [← Finset.sum_mul, ← Finset.mul_sum, sum_e_vertex, mul_one]; noncomm_ring
          _ = _ := Finset.sum_congr rfl fun Z _ ↦ by
            rw [mul_assoc (S.e (S.toIdempotents.projectiveVertex Z)) x, S.e_sandwich]
      rw [this]
      exact Submodule.sum_mem _ fun Z _ ↦ S.comp_mem_throughSpan t (hx X Z) _
  | right_absorb b x _ hx =>
      have : S.cornerMor X Y (x * b) = ∑ Z, S.cornerMor X Z b ≫ S.cornerMor Z Y x := by
        apply Subtype.ext
        rw [cornerMor_val, sum_val]
        simp only [SplitBasicIdempotents.ProjectiveCategory.comp_val, cornerMor_val]
        calc S.e (S.toIdempotents.projectiveVertex Y) * (x * b) * S.e (S.toIdempotents.projectiveVertex X)
            = ∑ Z, S.e (S.toIdempotents.projectiveVertex Y) * x * S.e (S.toIdempotents.projectiveVertex Z) *
                (b * S.e (S.toIdempotents.projectiveVertex X)) := by
              rw [← Finset.sum_mul, ← Finset.mul_sum, sum_e_vertex, mul_one]; noncomm_ring
          _ = _ := Finset.sum_congr rfl fun Z _ ↦ by
            rw [mul_assoc (S.e (S.toIdempotents.projectiveVertex Z)) b, S.e_sandwich]
      rw [this]
      exact Submodule.sum_mem _ fun Z _ ↦ S.mem_throughSpan_comp t (hx Z Y) _

/-- **Every element of the span of composites through `t` lies in one principal span.** -/
lemma exists_principal_of_mem_throughSpan {X Y : S.toIdempotents.ProjectiveCategory} {q : X ⟶ Y}
    (hq : q ∈ S.throughSpan t X Y) :
    q = 0 ∨ ∃ p ∈ S.throughSet t X Y, q ∈ twoSidedEndomorphismSpan k p := by
  induction hq using Submodule.span_induction with
  | mem p hp => exact Or.inr ⟨p, hp, mem_twoSidedEndomorphismSpan k p⟩
  | zero => exact Or.inl rfl
  | add q q' _ _ hq hq' =>
      rcases hq with rfl | ⟨p, hp, hqp⟩
      · rwa [zero_add]
      rcases hq' with rfl | ⟨p', hp', hqp'⟩
      · rw [add_zero]; exact Or.inr ⟨p, hp, hqp⟩
      rcases HasBGRSDistributiveHomStructure.homSubbimodule_comparable (k := k)
          (twoSidedEndomorphismSpan k p) (twoSidedEndomorphismSpan k p')
          (isHomSubbimodule_twoSidedEndomorphismSpan p)
          (isHomSubbimodule_twoSidedEndomorphismSpan p') with h | h
      · exact Or.inr ⟨p', hp', Submodule.add_mem _ (h hqp) hqp'⟩
      · exact Or.inr ⟨p, hp, Submodule.add_mem _ hqp (h hqp')⟩
  | smul c q _ hq =>
      rcases hq with rfl | ⟨p, hp, hqp⟩
      · rw [smul_zero]; exact Or.inl rfl
      · exact Or.inr ⟨p, hp, Submodule.smul_mem _ c hqp⟩

/-- **BGRS ideal correspondence.** A nonzero morphism whose value lies in the two-sided
ideal generated by `t` has a ray that is a two-sided multiple of the ray of `t`. -/
theorem ray_factorsThrough_of_mem_span {X Y : S.toIdempotents.ProjectiveCategory} (q : X ⟶ Y)
    (hq : q ≠ 0) (hJ : q.1 ∈ TwoSidedIdeal.span {t.1}) :
    FactorsThroughMorphism
      (show BGRSRayCategory.mk X₀ ⟶ BGRSRayCategory.mk Y₀ from unitRay t)
      (show BGRSRayCategory.mk X ⟶ BGRSRayCategory.mk Y from unitRay q) := by
  have h1 := S.cornerMor_mem_throughSpan t hJ X Y
  rw [S.cornerMor_self] at h1
  rcases S.exists_principal_of_mem_throughSpan t h1 with h0 | ⟨p, ⟨d, c, rfl⟩, hqp⟩
  · exact absurd h0 hq
  have hp0 : d ≫ t ≫ c ≠ 0 := fun h0 ↦ hq (by
    rw [h0, twoSidedEndomorphismSpan_zero] at hqp
    exact (Submodule.mem_bot k).1 hqp)
  have htc : t ≫ c ≠ 0 := fun h0 ↦ hp0 (by rw [h0, comp_zero])
  obtain ⟨ρ₁, hρ₁⟩ := unitRay_comp_eq_left d (t ≫ c) hp0
  obtain ⟨ρ₂, hρ₂⟩ := unitRay_comp_eq_right t c htc
  rcases HasBGRSDistributiveHomStructure.transit_or_cotransit (k := k) (d ≫ t ≫ c) with hT | hC
  · obtain ⟨b, hb, hns⟩ := exists_nonspecial_right_factor_of_mem_span_of_allowsTransit hq hT hqp
    refine ⟨ρ₁, ρ₂ ≫ unitRay b.asHom, ?_⟩
    rw [hb, ← bgrsRayRepresentativeProduct_eq_comp_of_not_special hns,
      ← BGRSRayCategory.comp_unitRay, hρ₁, hρ₂]
    simp only [Category.assoc]
  · obtain ⟨a, ha, hns⟩ := exists_nonspecial_left_factor_of_mem_span_of_allowsCotransit hq hC hqp
    refine ⟨unitRay a.asHom ≫ ρ₁, ρ₂, ?_⟩
    rw [ha, ← bgrsRayRepresentativeProduct_eq_comp_of_not_special hns,
      ← BGRSRayCategory.comp_unitRay, hρ₁, hρ₂]
    simp only [Category.assoc]

end SplitBasicData

end LargeIndecomposable
